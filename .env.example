NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# LOCAL DEVELOPMENT: MONGO_MODE=local is deterministic and ignores inherited/system MONGO_URI values.
# Set MONGO_MODE=external only when you intentionally want to use an external development database.
# Leave MONGO_URI blank in local mode. `npm run db:local`, `npm run verify:local`, and
# `npm run dev` will start Classic Mart's own single-node MongoDB replica set on
# 127.0.0.1:27018 and save the generated local URI into your ignored .env file.
# PRODUCTION: set this explicitly to MongoDB Atlas or another managed replica set/mongos.
MONGO_MODE=local
MONGO_URI=
CLASSIC_MART_MONGO_PORT=27018

# Optional. If blank, the integration audit derives classic-mart-audit-test on
# the same MongoDB deployment as MONGO_URI.
AUDIT_MONGO_URI=

# Optional. Leave blank to use MongoDB-backed sessions.
REDIS_URL=

SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_PEPPER=replace-with-a-different-at-least-32-character-secret
DATA_ENCRYPTION_KEY=replace-with-64-random-hex-characters
TRUST_PROXY=0
MAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Classic Mart <no-reply@classicmart.local>

# Phone verification. Development may use SMS_MODE=log; production requires Twilio credentials.
SMS_MODE=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ADMIN_NAME=Classic Mart Super Admin
ADMIN_EMAIL=admin@classicmart.local
ADMIN_PHONE=+256700000001
ADMIN_PASSWORD=ChangeMe!2026Secure

# Optional second Super Admin for Stage 9 four-eyes approvals. Leave all blank to skip.
# Never use a shared/default reviewer password in production.
ADMIN_REVIEWER_NAME=Classic Mart Approval Reviewer
ADMIN_REVIEWER_EMAIL=
ADMIN_REVIEWER_PHONE=
ADMIN_REVIEWER_PASSWORD=
UPLOAD_DIR=storage/uploads

# Stage 5 payments (Flutterwave test keys recommended outside production)
FLW_BASE_URL=https://api.flutterwave.com
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=

# Required in production for uploaded seller/KYC/evidence images.
MALWARE_SCAN_MODE=off
# Recommended production mode: clamd (faster daemon scanning). clamscan is also supported.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_PATH=clamscan

# Stage 10 Classic AI. Leave AI_PROVIDER=disabled until a provider key/model is configured.
AI_PROVIDER=disabled
AI_API_KEY=
AI_BASE_URL=https://api.openai.com
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
AI_MODERATION_MODEL=omni-moderation-latest
AI_TIMEOUT_MS=12000
AI_MAX_CONTEXT_CHARS=24000
AI_DAILY_BUDGET_MICROS=5000000
AI_USER_DAILY_REQUESTS=80
AI_WORKER_BATCH=5

# Stage 11 mobile/PWA and external integrations. Push is disabled honestly when blank.
PUSH_GATEWAY_URL=
PUSH_GATEWAY_SECRET=
ANDROID_APP_PACKAGE=
ANDROID_SHA256_CERT_FINGERPRINT=
APPLE_APP_ID=

# Stage 12 defence-in-depth security. Generate SECURITY_INTEGRITY_KEY independently:
# openssl rand -hex 32
IDS_ENABLED=true
IPS_ENABLED=true
PRIVILEGED_MFA_REQUIRED=false
SECURITY_INTEGRITY_KEY=replace-with-a-different-64-random-hex-character-secret
SECURITY_EVENT_RETENTION_DAYS=180
SECURITY_HIGH_EVENT_RETENTION_DAYS=730

# SIEM: development may use off. Production requires http or trusted-internal udp.
SIEM_MODE=off
SIEM_FORMAT=json
SIEM_URL=
SIEM_TOKEN=
SIEM_UDP_HOST=127.0.0.1
SIEM_UDP_PORT=514
SIEM_TIMEOUT_MS=5000

# Optional managed-WAF/origin-secret guard. Enable only when the reverse proxy inserts
# this header and the origin firewall blocks direct public access.
ORIGIN_GUARD_MODE=off
ORIGIN_GUARD_HEADER=x-classic-origin
ORIGIN_GUARD_SECRET=

# Explicit production rollout scope, for example UG or UG,KE.
LAUNCH_COUNTRIES=
