NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# External-service-first development. Use an Atlas database whose name clearly contains
# Set an explicit database name such as classic-mart. Initial import also requires the one-time shell confirmation INITIAL_CATALOGUE_CONFIRM=SEED_REAL_CLASSIC_MART.
MONGO_MODE=external
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/classic-mart?retryWrites=true&w=majority
AUDIT_MONGO_URI=

# Local Redis is fine for development. Production uses the managed Redis URL.
REDIS_URL=redis://127.0.0.1:6379

SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_PEPPER=replace-with-a-different-at-least-32-character-secret
DATA_ENCRYPTION_KEY=replace-with-64-random-hex-characters
TRUST_PROXY=0

MAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SMS_MODE=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

ADMIN_NAME=Classic Mart Super Admin
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_REVIEWER_NAME=Classic Mart Approval Reviewer
ADMIN_REVIEWER_EMAIL=
ADMIN_REVIEWER_PHONE=
ADMIN_REVIEWER_PASSWORD=

# Cloudflare R2 is the normal media store for external-service development and production.
MEDIA_STORAGE_DRIVER=r2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=classic-mart-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_TIMEOUT_MS=10000

PESAPAL_SANDBOX=true
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_TIMEOUT_MS=10000

MALWARE_SCAN_MODE=off
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_PATH=clamscan

AI_PROVIDER=disabled
AI_API_KEY=
AI_BASE_URL=https://api.openai.com
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
AI_MODERATION_MODEL=omni-moderation-latest
AI_TIMEOUT_MS=12000
AI_MAX_CONTEXT_CHARS=24000
AI_DAILY_BUDGET_MICROS=5000000
AI_USER_DAILY_REQUESTS=80
AI_WORKER_BATCH=5

PUSH_GATEWAY_URL=
PUSH_GATEWAY_SECRET=
ANDROID_APP_PACKAGE=
ANDROID_SHA256_CERT_FINGERPRINT=
APPLE_APP_ID=

IDS_ENABLED=true
IPS_ENABLED=true
PRIVILEGED_MFA_REQUIRED=false
SECURITY_INTEGRITY_KEY=replace-with-a-different-64-random-hex-character-secret
SECURITY_EVENT_RETENTION_DAYS=180
SECURITY_HIGH_EVENT_RETENTION_DAYS=730

SIEM_MODE=off
SIEM_FORMAT=json
SIEM_URL=
SIEM_TOKEN=
SIEM_UDP_HOST=127.0.0.1
SIEM_UDP_PORT=514
SIEM_TIMEOUT_MS=5000

ORIGIN_GUARD_MODE=off
ORIGIN_GUARD_HEADER=x-classic-origin
ORIGIN_GUARD_SECRET=
LAUNCH_COUNTRIES=UG
METRICS_TOKEN=
DR_MAX_RPO_MINUTES=60
DR_MAX_RTO_MINUTES=240
DR_EVIDENCE_MAX_AGE_DAYS=90
