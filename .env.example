# Development template. Copy to .env; never commit the populated file.
# Use .env.production.example for deployment.

# Application
NODE_ENV=development
LOG_LEVEL=info
LOG_HTTP_ACCESS=false
PORT=3000
BASE_URL=http://localhost:3000
# Keep verification enabled. SIMPLE_LOGIN=true is an explicit development-only bypass.
SIMPLE_LOGIN=false
PUBLIC_REGISTRATION_TYPES=customer,seller,promoter

# Database: use an explicit name and transaction-capable MongoDB.
# One-time initial import requires INITIAL_CATALOGUE_CONFIRM=SEED_REAL_CLASSIC_MART.
MONGO_MODE=external
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/classic-mart?retryWrites=true&w=majority
AUDIT_MONGO_URI=

# Optional for development. Leave blank unless Redis is running.
# Production requires managed Redis; development can use MongoDB sessions.
REDIS_URL=

# Independent secrets. Blank development values use development-only defaults.
# First two: >=32 random characters. Last two: distinct 64-character hex keys.
SESSION_SECRET=
TOKEN_PEPPER=
DATA_ENCRYPTION_KEY=
SECURITY_INTEGRITY_KEY=
TRUST_PROXY=0

# Email: log is a development sink. Use smtp for real delivery.
# Gmail: smtp.gmail.com:587 with STARTTLS and a Google app password.
MAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Yoola SMS integration settings; see docs/production/SMS.md.
SMS_MODE=yoola
YOOLA_API_KEY=

# One-time trusted administrator bootstrap. Remove passwords after setup.
# Each operator enrolls their own authenticator at /account/security.
ADMIN_NAME=Classic Mart Super Admin
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Cloudflare R2 is the normal media store for external-service development and production.
MEDIA_STORAGE_DRIVER=r2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=classic-mart-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_TIMEOUT_MS=10000

PESAPAL_SANDBOX=true
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_TIMEOUT_MS=10000

MALWARE_SCAN_MODE=off
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_PATH=clamscan

# Optional AI. Keep disabled until configured and deliberately enabled.
AI_PROVIDER=disabled
AI_API_KEY=
AI_BASE_URL=https://api.openai.com
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
AI_MODERATION_MODEL=omni-moderation-latest
AI_TIMEOUT_MS=12000
AI_MAX_CONTEXT_CHARS=24000
AI_DAILY_BUDGET_MICROS=5000000
AI_USER_DAILY_REQUESTS=80
AI_WORKER_BATCH=5

# Optional push and native-app links
PUSH_GATEWAY_URL=
PUSH_GATEWAY_SECRET=
ANDROID_APP_PACKAGE=
ANDROID_SHA256_CERT_FINGERPRINT=
APPLE_APP_ID=

# Security and retention
IDS_ENABLED=true
IPS_ENABLED=true
PRIVILEGED_MFA_REQUIRED=true
SECURITY_EVENT_RETENTION_DAYS=180
SECURITY_HIGH_EVENT_RETENTION_DAYS=730

# Optional monitoring and origin protection; production requires a real SIEM.
SIEM_MODE=off
SIEM_FORMAT=json
SIEM_URL=
SIEM_TOKEN=
SIEM_UDP_HOST=127.0.0.1
SIEM_UDP_PORT=514
SIEM_TIMEOUT_MS=5000

ORIGIN_GUARD_MODE=off
ORIGIN_GUARD_HEADER=x-classic-origin
ORIGIN_GUARD_SECRET=
LAUNCH_COUNTRIES=UG
METRICS_TOKEN=
DR_MAX_RPO_MINUTES=60
DR_MAX_RTO_MINUTES=240
DR_EVIDENCE_MAX_AGE_DAYS=90
# Optional official social links. Leave blank until the channel is published.
SOCIAL_FACEBOOK_URL=
SOCIAL_X_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_YOUTUBE_URL=
SOCIAL_PINTEREST_URL=

