# Production template. Set values in the deployment secret manager, never Git.
# Replace every placeholder and required blank before startup.

# Application and deployed identity
NODE_ENV=production
PORT=3000
BASE_URL=https://classic-mart.com
# Point www.classic-mart.com to the same HTTPS app. Safe requests redirect to BASE_URL.
BUILD_SHA=

# Transaction-capable managed MongoDB and TLS Redis
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/classic-mart?retryWrites=true&w=majority
REDIS_URL=rediss://USERNAME:PASSWORD@YOUR_REDIS_HOST:6379

# Independent secrets. First two: >=32 random characters; last two: 64 hex characters.
SESSION_SECRET=
TOKEN_PEPPER=
DATA_ENCRYPTION_KEY=
SECURITY_INTEGRITY_KEY=
TRUST_PROXY=1
# Prefer explicit addresses of the actual reverse proxies instead of hop-count trust.
# The precise addresses depend on the hosting topology; configure before launch.
TRUST_PROXY_CIDRS=
# Peers that overwrite CF-IPCountry with verified Cloudflare/edge geolocation.
# An additional hosting proxy must strip/replace untrusted incoming headers.
GEOLOCATION_TRUSTED_PROXY_CIDRS=
# Production always requires verification and privileged MFA.
SIMPLE_LOGIN=false
PUBLIC_REGISTRATION_TYPES=customer,seller,promoter
LOG_LEVEL=info
LOG_HTTP_ACCESS=false
PRIVILEGED_MFA_REQUIRED=true
SECURITY_EVENT_RETENTION_DAYS=180
SECURITY_HIGH_EVENT_RETENTION_DAYS=730
IDS_ENABLED=true
IPS_ENABLED=true

# Durable temporary export/privacy storage outside the application tree
STORAGE_PERSISTENCE=mounted
PERSISTENT_STORAGE_ROOT=/var/data/classic-mart
# Private Cloudflare R2 media bucket
MEDIA_STORAGE_DRIVER=r2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=classic-mart-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# Per request, including response bytes; clamped to 3000–60000 ms.
# Startup retries transient probe failures up to three times; uploads are not replayed.
R2_TIMEOUT_MS=10000
# Docker includes clamscan. Keep signed definitions current.
MALWARE_SCAN_MODE=clamscan
CLAMAV_PATH=/usr/bin/clamscan

# Gmail: two-step verification and an app password are required.
# Port 587 uses STARTTLS; alternative: port 465 with SMTP_SECURE=true.
MAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Yoola SMS integration; verify the account configuration before launch.
SMS_MODE=yoola
YOOLA_API_KEY=
# Optional approved sender: 1–11 letters/numbers. Empty uses Yoola's default.
YOOLA_SENDER_ID=

# One-time trusted administrator bootstrap; remove passwords after setup.
ADMIN_NAME=Classic Mart Super Admin
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Live Pesapal API 3.0
PESAPAL_SANDBOX=false
PESAPAL_BASE_URL=https://pay.pesapal.com/v3
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Add after the first HTTPS deploy and live IPN registration. Checkout stays disabled until set.
PESAPAL_IPN_ID=
PESAPAL_TIMEOUT_MS=10000

# Optional AI; keep disabled until deliberately configured.
AI_PROVIDER=disabled
AI_API_KEY=
AI_BASE_URL=https://api.openai.com
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
AI_MODERATION_MODEL=omni-moderation-latest

# Optional push and native-app links
PUSH_GATEWAY_URL=
PUSH_GATEWAY_SECRET=
ANDROID_APP_PACKAGE=
ANDROID_SHA256_CERT_FINGERPRINT=
APPLE_APP_ID=

# Monitoring, origin protection and launch scope
SIEM_MODE=http
SIEM_FORMAT=json
SIEM_URL=https://siem.example.com/ingest
SIEM_TOKEN=
SIEM_TIMEOUT_MS=5000
# Enable only with a trusted proxy-injected header and direct-origin access blocked.
ORIGIN_GUARD_MODE=off
ORIGIN_GUARD_HEADER=x-classic-origin
ORIGIN_GUARD_SECRET=
LAUNCH_COUNTRIES=UG
METRICS_TOKEN=
DR_MAX_RPO_MINUTES=60
DR_MAX_RTO_MINUTES=240
DR_EVIDENCE_MAX_AGE_DAYS=90
# Optional official social links. Leave blank until the channel is published.
SOCIAL_FACEBOOK_URL=
SOCIAL_X_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_YOUTUBE_URL=
SOCIAL_PINTEREST_URL=
