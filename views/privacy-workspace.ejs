<!doctype html><html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true':'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Privacy & Data — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"></head><body data-operations-ui="true"><main class="catalog-workspace"><header class="catalog-topbar"><div><a class="brand" href="/dashboard"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"></a><p>Privacy &amp; data rights</p></div><div class="catalog-actions"><a class="outline-button" href="/dashboard">Dashboard</a><a class="outline-button" href="/privacy">Privacy policy</a></div></header><section class="catalog-page-head panel"><div><span class="eyebrow">Your information</span><h1>Privacy &amp; Data</h1><p>Identity-sensitive requests require your current password. Exports expire after 24 hours. Deletion remains subject to active commerce, legal and financial retention obligations.</p></div></section><div class="role-content-grid"><section class="panel"><h2>Create a verified request</h2><form method="post" action="/account/privacy/request" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Request<select name="type" required><option value="export">Download my data</option><option value="correction">Correct personal data</option><option value="restriction">Restrict processing</option><option value="consent_withdrawal">Withdraw marketing consent</option><option value="deletion">Delete / anonymize my account</option></select></label><label>Current password<input type="password" name="password" autocomplete="current-password" required></label><label>Details<textarea name="details" maxlength="2000" placeholder="Explain the correction/restriction or any context"></textarea></label><button type="submit">Submit verified request</button></form></section><section class="panel"><h2>How deletion works</h2><p>Classic Mart first checks unresolved orders, refunds, payouts and owned seller/business entities. A legal hold can pause deletion. When eligible, account identity is anonymized and all sessions are revoked; legally required transaction records remain retained under restricted access.</p></section></div><section class="panel"><h2>Your requests</h2><div class="table-wrap"><table><thead><tr><th>Request</th><th>Status</th><th>Decision / expiry</th><th>Action</th></tr></thead><tbody><% if(!requests.length){%><tr><td colspan="4">No privacy requests yet.</td></tr><%}%><% requests.forEach(r=>{%><tr><td><strong><%=r.type.replaceAll('_',' ')%></strong><br><small><%=r.publicId%> · <%=formatDate(r.createdAt)%></small></td><td><%=r.status%></td><td><%=r.decision||''%><% if(r.expiresAt){%><br><small>Available until <%=formatDate(r.expiresAt)%></small><%}%></td><td><% if(r.type==='export'&&r.status==='ready'){%><a class="outline-button" href="/account/privacy/<%=r.publicId%>/download">Download JSON</a><%}%><% if(['requested','blocked'].includes(r.status)){%><form method="post" action="/account/privacy/<%=r.publicId%>/cancel"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit">Cancel</button></form><%}%></td></tr><%})%></tbody></table></div><% if(queuePage?.hasMore){%><p><a class="server-pager" href="/account/privacy?after=<%=encodeURIComponent(queuePage.next)%>">Older privacy requests</a></p><%}%></section></main><script src="/operations-ui.js" defer></script></body></html>
