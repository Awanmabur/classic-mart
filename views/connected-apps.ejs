<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Connected Apps · Classic Mart</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/account.css"></head><body class="account-body"><%-include('partials/account-top')%><%-include('partials/account-nav',{accountSection:'apps'})%><main class="account-wrap account-main"><%if(flash){%><div class="account-flash <%=flash.type==='error'?'error':''%>"><strong><%=flash.message%></strong></div><%}%><div class="account-heading"><h1>Connected apps</h1><p>Review mobile sessions and push devices connected to your account.</p></div><div class="account-grid"><section class="account-card"><h2>Install Classic Mart</h2><p>The PWA uses the same live server data and never treats cached payment or stock state as authoritative.</p><div class="account-actions"><button class="account-button primary" data-pwa-install type="button" hidden>Install Classic Mart</button><a class="account-link" href="/app">Open app view</a></div></section><section class="account-card"><h2>Push devices</h2><div class="account-list"><%if(!pushDevices.length){%><div class="account-empty">No push devices registered.</div><%}%><%pushDevices.forEach(device=>{%><article class="account-item"><div><strong><%=device.label||device.platform%></strong><p><%=device.platform%> · <%=device.status%></p></div><%if(device.status==='active'){%><form method="post" action="/account/push-devices/<%=device.publicId%>/revoke"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="account-button" type="submit">Revoke</button></form><%}%></article><%})%></div></section><section class="account-card wide"><h2>Mobile sessions</h2><div class="account-list"><%if(!mobileSessions.length){%><div class="account-empty">No mobile API sessions are connected.</div><%}%><%mobileSessions.forEach(session=>{%><article class="account-item"><div><strong><%=session.deviceName%></strong><p><%=session.platform%> · last used <%=formatDate(session.lastUsedAt||session.createdAt)%></p></div><div><span class="account-status <%=session.revokedAt?'':'good'%>"><%=session.revokedAt?'revoked':'active'%></span><%if(!session.revokedAt){%><form method="post" action="/account/apps/<%=session.publicId%>/revoke"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="account-button" type="submit">Revoke</button></form><%}%></div></article><%})%></div><%if(mobileSessionPage?.hasMore){%><p><a class="account-link" href="/account/apps?after=<%=encodeURIComponent(mobileSessionPage.next)%>">Older sessions</a></p><%}%></section></div></main><script src="/pwa.js"></script></body></html>
