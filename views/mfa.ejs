<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Verify sign-in · Classic Mart</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/server-ui.css"></head><body><main class="auth-page"><section class="auth-card"><a class="brand" href="/"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><span class="eyebrow">Secure sign-in</span><h1>Verify it’s you</h1><p>Enter the current 6-digit authenticator code. You can also use one unused recovery code.</p><% if(pageError){%><div class="server-flash error"><strong><%=pageError%></strong></div><%}%><form method="post" action="/mfa" class="auth-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Authenticator or recovery code<input name="code" autocomplete="one-time-code" inputmode="numeric" maxlength="32" required autofocus></label><button type="submit" class="primary-button">Continue securely</button></form><p><a href="/login">Cancel and sign in again</a></p></section></main></body></html>
