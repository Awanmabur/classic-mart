<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Profile · Classic Mart</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/account.css"></head><body class="account-body"><%-include('partials/account-top')%><%-include('partials/account-nav',{accountSection:'profile'})%><main class="account-wrap account-main"><%if(flash){%><div class="account-flash <%=flash.type==='error'?'error':''%>"><strong><%=flash.message%></strong><%if(flash.details){%><div class="account-note"><%=flash.details%></div><%}%></div><%}%><div class="account-heading"><h1>Profile settings</h1><p>Manage your identity, shopping country and communication preferences.</p></div><div class="account-grid"><section class="account-card wide"><h2>Personal details</h2><form class="account-form" method="post" action="/account/profile"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><div class="row"><label>Full name<input name="name" maxlength="120" required value="<%=user.name%>"></label><label>Email<input value="<%=user.email%>" disabled></label></div><div class="row"><label>Phone<input name="phone" maxlength="30" required value="<%=user.phone%>"></label><label>Shopping country<select name="country"><%countries.forEach(item=>{%><option value="<%=item.code%>" <%=item.code===(user.shoppingCountry||user.country)?'selected':''%>><%=item.name%></option><%})%></select></label></div><div class="row"><label>Currency<select name="currency"><%[...new Set(countries.map(item=>item.currency))].forEach(item=>{%><option value="<%=item%>" <%=item===user.currency?'selected':''%>><%=item%></option><%})%></select></label><label>Language<select name="locale"><option value="en-UG" <%=user.locale==='en-UG'?'selected':''%>>English (Uganda)</option><option value="en-KE" <%=user.locale==='en-KE'?'selected':''%>>English (Kenya)</option><option value="en-US" <%=user.locale==='en-US'?'selected':''%>>English (International)</option></select></label></div><label class="account-check"><input type="checkbox" name="marketing" <%=user.consents.marketing?'checked':''%>> Receive consent-based offers</label><button class="account-button primary" type="submit">Save profile</button></form></section><section class="account-card"><h2>Data usage</h2><p>Reduce large product media on slower or expensive connections.</p><form method="post" action="/account/preferences/low-data"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="enabled" value="<%=user.preferences?.lowData?'false':'true'%>"><div class="account-actions"><span class="account-status <%=user.preferences?.lowData?'good':'warn'%>"><%=user.preferences?.lowData?'Low-data enabled':'Standard media'%></span><button class="account-button" type="submit"><%=user.preferences?.lowData?'Use standard media':'Enable low-data mode'%></button></div></form></section><section class="account-card"><h2>Account role</h2><p><strong><%=roleLabel(user.role)%></strong></p><p class="account-note">Role-specific management screens are intentionally not installed in this dashboardless baseline.</p></section></div></main><script src="/image-fallback.js"></script></body></html>
