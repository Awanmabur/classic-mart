<!doctype html><html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Ask Classic — Classic Mart</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/server-ui.css"><style>.ai-shell{max-width:1180px;margin:0 auto;padding:24px 16px 70px}.ai-head,.ai-panel,.ai-product,.ai-answer{border:1px solid #e0e5ec;border-radius:18px;background:#fff}.ai-head{padding:24px;margin-bottom:16px}.ai-grid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(280px,.8fr);gap:16px}.ai-panel{padding:18px}.ai-form{display:grid;gap:12px}.ai-form textarea,.ai-form input{width:100%;box-sizing:border-box;border:1px solid #d8dee8;border-radius:14px;padding:12px;background:#fff;font:inherit}.ai-actions{display:flex;gap:10px;flex-wrap:wrap}.ai-actions button,.ai-actions a{border:0;border-radius:999px;padding:10px 16px;background:#1165df;color:#fff;text-decoration:none;font-weight:700}.ai-actions .outline{background:#fff;color:#1d2939;border:1px solid #cfd7e3}.ai-answer{padding:18px;margin-top:16px}.ai-disclosure{font-size:13px;color:#667085}.ai-products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:14px}.ai-product{padding:12px;display:grid;grid-template-columns:82px 1fr;gap:12px;align-items:center}.ai-product img{width:82px;height:82px;object-fit:cover;border-radius:14px;background:#f7f8fa}.ai-product strong{display:block}.ai-product small{display:block;color:#667085;margin-top:3px}.ai-warning{border:1px solid #fedf89;background:#fffaeb;border-radius:14px;padding:10px 12px;margin-top:10px}.ai-feedback{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.ai-feedback button{border:1px solid #d0d5dd;background:#fff;border-radius:999px;padding:7px 11px}.ai-recs{display:grid;gap:10px}.ai-rec{border:1px solid #e0e5ec;border-radius:14px;padding:10px}.ai-rec a{text-decoration:none;color:inherit;font-weight:700}.ai-cart{border:1px solid #b2ddff;background:#eff8ff;border-radius:14px;padding:12px;margin-top:14px}@media(max-width:850px){.ai-grid{grid-template-columns:1fr}.ai-products{grid-template-columns:1fr}}</style></head><body><main class="ai-shell"><header class="ai-head"><a href="/" class="brand"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p class="eyebrow">Classic AI</p><h1>Ask Classic</h1><p>Ask for products, comparisons, budgets or marketplace help. Answers are grounded in approved catalogue and policy data; AI-generated content is labelled and cannot execute payments, refunds, enforcement or other protected actions.</p><div class="ai-actions"><a class="outline" href="/">Marketplace</a><a class="outline" href="/cart">Cart</a></div></header><div class="ai-grid"><section><article class="ai-panel"><form method="post" action="/ask-classic" class="ai-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>What are you looking for?<textarea name="question" rows="4" minlength="2" maxlength="2000" required placeholder="Example: Find me a wireless speaker under UGX 200,000 that is in stock"><%=question||''%></textarea></label><div class="ai-actions"><button type="submit">Ask Classic</button></div></form></article><article class="ai-panel" style="margin-top:16px"><h2>Visual search</h2><p class="ai-disclosure">Upload an item photo. The image is scanned, normalized in memory and used only to derive shopping search terms; it is not saved as catalogue media.</p><form method="post" action="/ask-classic/visual" enctype="multipart/form-data" class="ai-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/avif" required><div class="ai-actions"><button type="submit">Search from image</button></div></form></article><% if(result){ %><article class="ai-answer"><p class="eyebrow"><%= result.aiGenerated ? 'AI-generated, grounded response' : 'Retrieval fallback' %></p><h2>Answer</h2><p><%=result.answer%></p><% (result.warnings||[]).forEach(w=>{ %><div class="ai-warning"><%=w%></div><% }) %><% if(result.products?.length){%><div class="ai-products"><% result.products.forEach(p=>{ %><article class="ai-product"><img src="<%=p.image%>" alt="<%=p.imageAlt||p.name%>"><div><a href="/products/<%=p.id%>"><strong><%=p.name%></strong></a><small><%=p.price%> <%=p.currency%> · <%=p.stock%> available</small><small><%=p.seller?.name||''%></small></div></article><%})%></div><%}%><% if(result.cartDraft){%><div class="ai-cart"><strong>Cart draft</strong><p>Classic AI proposed <%=result.cartDraft.items.length%> item(s). Nothing has been added yet. Applying the draft revalidates live product/variant/stock on the server.</p><form method="post" action="/ask-classic/cart-drafts/<%=result.cartDraft.id%>/apply"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><div class="ai-actions"><button type="submit">Confirm &amp; add draft</button></div></form></div><%}%><% if(result.handoffRecommended){%><p><a href="/help">This request may need human support.</a></p><%}%><form class="ai-feedback" method="post" action="/ask-classic/feedback"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="usageId" value="<%=result.usageId%>"><button name="rating" value="helpful">Helpful</button><button name="rating" value="incorrect">Incorrect</button><button name="rating" value="unsafe">Report unsafe</button></form></article><%}%><% if(visualResults?.length){%><article class="ai-answer"><p class="eyebrow">Visual-search matches</p><div class="ai-products"><% visualResults.forEach(p=>{ %><article class="ai-product"><img src="<%=p.image%>" alt="<%=p.name%>"><div><a href="/products/<%=p.id%>"><strong><%=p.name%></strong></a><small><%=p.price%> <%=p.currency%> · <%=p.stock%> available</small></div></article><%})%></div></article><%}%></section><aside class="ai-panel"><h2>Recommended</h2><p class="ai-disclosure">Recommendations apply country, publication, seller and stock filters before ranking.</p><div class="ai-recs"><% (recommendations||[]).forEach(p=>{ %><article class="ai-rec"><a href="/products/<%=p.id%>"><%=p.name%></a><small><%=p.price%> <%=p.currency%></small><p class="ai-disclosure"><%=p.recommendationExplanation||'Available in your country'%></p></article><%})%></div></aside></div></main><div aria-live="polite" class="page-toast" id="pageToast" role="status"></div><%- include("partials/product-preview-modal") %><script src="/cart-store.js"></script><script src="/product-preview.js"></script></body></html>
