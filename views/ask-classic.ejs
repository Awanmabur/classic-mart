<!doctype html>
<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>Ask Classic — Classic Mart</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/storefront-pages.css">
  <link rel="stylesheet" href="/server-ui.css">
  <link rel="stylesheet" href="/classic-ai.css">
</head>
<body class="classic-ai-page">
  <a class="skip-link" href="#mainContent">Skip to Classic AI</a>
  <%- include("partials/storefront-header") %>
  <main class="classic-ai-shell" id="mainContent">

    <section class="classic-ai-hero">
      <div>
        <p class="classic-ai-kicker">Classic AI</p>
        <h1>Ask Classic</h1>
        <p>Find products, compare choices, work within a budget or get marketplace guidance using approved catalogue and policy data.</p>
      </div>
      <div class="classic-ai-guardrail">
        <strong>Grounded marketplace help</strong>
        <span>AI-generated responses are labelled. Classic AI cannot execute payments, refunds, enforcement or other protected actions.</span>
      </div>
    </section>

    <div class="classic-ai-grid">
      <section class="classic-ai-main">
        <article class="classic-ai-panel">
          <div class="classic-ai-panel-head">
            <div><h2>What do you need?</h2><p>Describe the product, budget or comparison you want.</p></div>
          </div>
          <form method="post" action="/ask-classic" class="classic-ai-form">
            <input type="hidden" name="_csrf" value="<%=csrfToken%>">
            <label>Question
              <textarea name="question" rows="4" minlength="2" maxlength="2000" required placeholder="Example: Find me a wireless speaker under UGX 200,000 that is in stock"><%=question||''%></textarea>
            </label>
            <div class="classic-ai-actions"><button type="submit">Ask Classic</button></div>
          </form>
        </article>

        <article class="classic-ai-panel">
          <div class="classic-ai-panel-head"><div><h2>Visual search</h2><p>Search the catalogue using an item photo.</p></div></div>
          <p class="classic-ai-disclosure">The image is scanned and normalized in memory to derive shopping search terms. It is not saved as catalogue media.</p>
          <form method="post" action="/ask-classic/visual" enctype="multipart/form-data" class="classic-ai-form">
            <input type="hidden" name="_csrf" value="<%=csrfToken%>">
            <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/avif" required>
            <div class="classic-ai-actions"><button type="submit">Search from image</button></div>
          </form>
        </article>

        <% if(result){ %>
        <article class="classic-ai-answer">
          <p class="classic-ai-kicker"><%= result.aiGenerated ? 'AI-generated, grounded response' : 'Retrieval fallback' %></p>
          <h2>Answer</h2>
          <p><%=result.answer%></p>
          <% (result.warnings||[]).forEach(w=>{ %><div class="classic-ai-warning"><%=w%></div><% }) %>
          <% if(result.products?.length){%>
          <div class="classic-ai-products">
            <% result.products.forEach(p=>{ %>
            <article class="classic-ai-product">
              <img src="<%=p.image%>" alt="<%=p.imageAlt||p.name%>" loading="lazy" decoding="async">
              <div><a href="/products/<%=p.id%>"><strong><%=p.name%></strong></a><small><%=p.price%> <%=p.currency%> · <%=p.stock%> available</small><small><%=p.seller?.name||''%></small></div>
            </article>
            <%})%>
          </div>
          <%}%>
          <% if(result.cartDraft){%>
          <div class="classic-ai-cart"><strong>Cart draft</strong><p>Classic AI proposed <%=result.cartDraft.items.length%> item(s). Nothing has been added yet. Applying the draft revalidates live product, variant and stock data.</p><form method="post" action="/ask-classic/cart-drafts/<%=result.cartDraft.id%>/apply"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><div class="classic-ai-actions"><button type="submit">Confirm &amp; add draft</button></div></form></div>
          <%}%>
          <% if(result.handoffRecommended){%><p><a href="/help">This request may need human support.</a></p><%}%>
          <form class="classic-ai-feedback" method="post" action="/ask-classic/feedback"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="usageId" value="<%=result.usageId%>"><button name="rating" value="helpful">Helpful</button><button name="rating" value="incorrect">Incorrect</button><button name="rating" value="unsafe">Report unsafe</button></form>
        </article>
        <%}%>

        <% if(visualResults?.length){%>
        <article class="classic-ai-answer">
          <p class="classic-ai-kicker">Visual-search matches</p>
          <div class="classic-ai-products">
            <% visualResults.forEach(p=>{ %><article class="classic-ai-product"><img src="<%=p.image%>" alt="<%=p.name%>" loading="lazy" decoding="async"><div><a href="/products/<%=p.id%>"><strong><%=p.name%></strong></a><small><%=p.price%> <%=p.currency%> · <%=p.stock%> available</small></div></article><%})%>
          </div>
        </article>
        <%}%>
      </section>

      <aside class="classic-ai-panel classic-ai-side">
        <h2>Recommended</h2>
        <p class="classic-ai-disclosure">Recommendations apply country, publication, seller and stock filters before ranking.</p>
        <div class="classic-ai-recs">
          <% (recommendations||[]).forEach(p=>{ %><article class="classic-ai-rec"><a href="/products/<%=p.id%>"><%=p.name%></a><small><%=p.price%> <%=p.currency%></small><p class="classic-ai-disclosure"><%=p.recommendationExplanation||'Available in your country'%></p></article><%})%>
        </div>
      </aside>
    </div>
  </main>
  <%- include("partials/storefront-footer") %>
  <div aria-live="polite" class="page-toast" id="pageToast" role="status"></div>
  <%- include("partials/product-preview-modal") %>
  <script src="/cart-store.js"></script>
  <script src="/product-preview.js"></script>
  <script src="/shared-shell.js"></script>
  <script src="/country-switcher.js"></script>
  <script src="/search-tools.js"></script>
</body>
</html>
