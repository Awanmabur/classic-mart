<!doctype html><html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Rewards — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"></head><body><main class="catalog-workspace"><header class="catalog-topbar"><div><a class="brand" href="/dashboard"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p>Rewards & referrals</p></div><div class="catalog-actions"><a class="outline-button" href="/dashboard">Dashboard</a><a class="outline-button" href="/">Marketplace</a></div></header><section class="catalog-page-head panel"><div><span class="eyebrow">Growth benefits</span><h1>Your rewards</h1><p>Reward points and referral rewards are calculated on the server from verified marketplace activity.</p></div></section><div class="role-content-grid"><section class="panel"><h2>Points balance</h2><p class="workspace-stat-value"><%= account?.points || 0 %></p><p>Tier: <strong><%= account?.tier || 'classic' %></strong> · Lifetime earned: <%= account?.lifetimeEarned || 0 %></p></section><section class="panel"><h2>Your referral code</h2><p><strong><%= referral.code %></strong></p><p>Share this code with a new shopper. Rewards are issued only after their first verified paid order.</p></section></div><div class="role-content-grid"><section class="panel"><h2>Redeem gift card</h2><form method="post" action="/account/rewards/gift-card" class="catalog-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Gift card code<input name="code" autocomplete="off" required maxlength="80"></label><button type="submit">Redeem</button></form></section><section class="panel"><h2>Referral activity</h2><% if(!referrals.length){ %><p>No referred shoppers have joined yet.</p><% } %><% referrals.forEach(row=>{ %><p><strong><%= row.referredUserId?.name || 'Referred shopper' %></strong><br><small><%= row.status %> · <%= row.referrerRewardPoints || 0 %> points</small></p><% }) %><% if(queuePages?.referrals){%><div class="server-pager"><small>Showing <%=queuePages.referrals.count%> of <%=queuePages.referrals.total%> referrals</small><% if(queuePages.referrals.hasMore){%><a class="outline-button" href="/account/rewards?referralsAfter=<%=encodeURIComponent(queuePages.referrals.next)%>">Older referrals</a><%}%></div><%}%></section></div><section class="panel"><h2>Reward history</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Type</th><th>Change</th><th>Balance</th><th>Reference</th></tr></thead><tbody><% if(!entries.length){ %><tr><td colspan="5">No reward activity yet.</td></tr><% } %><% entries.forEach(row=>{ %><tr><td><%= formatDate(row.createdAt) %></td><td><%= row.type.replaceAll('_',' ') %></td><td><%= row.pointsDelta>0?'+':'' %><%= row.pointsDelta %></td><td><%= row.balanceAfter %></td><td><%= row.referencePublicId || '—' %></td></tr><% }) %></tbody></table></div><% if(queuePages?.entries){%><div class="server-pager"><small>Showing <%=queuePages.entries.count%> of <%=queuePages.entries.total%> reward entries</small><% if(queuePages.entries.hasMore){%><a class="outline-button" href="/account/rewards?entriesAfter=<%=encodeURIComponent(queuePages.entries.next)%>">Older reward activity</a><%}%></div><%}%></section></main><script src="/image-fallback.js"></script></body></html>
