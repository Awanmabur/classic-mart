<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Rewards · Classic Mart</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/account.css"></head><body class="account-body"><%-include('partials/account-top')%><%-include('partials/account-nav',{accountSection:'rewards'})%><main class="account-wrap account-main"><%if(flash){%><div class="account-flash <%=flash.type==='error'?'error':''%>"><strong><%=flash.message%></strong></div><%}%><div class="account-heading"><h1>Rewards &amp; referrals</h1><p>Server-calculated points and referral rewards from verified marketplace activity.</p></div><div class="account-grid"><section class="account-card"><h2>Points balance</h2><p style="font-size:34px;margin:12px 0"><strong><%=account?.points||0%></strong></p><p>Tier: <strong><%=account?.tier||'classic'%></strong> · Lifetime earned: <%=account?.lifetimeEarned||0%></p></section><section class="account-card"><h2>Your referral code</h2><p style="font-size:24px"><strong><%=referral.code%></strong></p><p>Share this code with a new shopper. Rewards are issued only after their first verified paid order.</p></section><section class="account-card"><h2>Redeem gift card</h2><form class="account-form" method="post" action="/account/rewards/gift-card"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Gift card code<input name="code" autocomplete="off" required maxlength="80"></label><button class="account-button primary" type="submit">Redeem</button></form></section><section class="account-card"><h2>Referral activity</h2><div class="account-list"><%if(!referrals.length){%><div class="account-empty">No referred shoppers have joined yet.</div><%}%><%referrals.forEach(row=>{%><article class="account-item"><div><strong><%=row.referredUserId?.name||'Referred shopper'%></strong><p><%=row.status%> · <%=row.referrerRewardPoints||0%> points</p></div></article><%})%></div><%if(queuePages?.referrals?.hasMore){%><p><a class="account-link" href="/account/rewards?referralsAfter=<%=encodeURIComponent(queuePages.referrals.next)%>">Older referrals</a></p><%}%></section><section class="account-card wide"><h2>Reward history</h2><div style="overflow-x:auto"><table class="account-table"><thead><tr><th>Date</th><th>Type</th><th>Change</th><th>Balance</th><th>Reference</th></tr></thead><tbody><%if(!entries.length){%><tr><td colspan="5">No reward activity yet.</td></tr><%}%><%entries.forEach(row=>{%><tr><td><%=formatDate(row.createdAt)%></td><td><%=row.type.replaceAll('_',' ')%></td><td><%=row.pointsDelta>0?'+':''%><%=row.pointsDelta%></td><td><%=row.balanceAfter%></td><td><%=row.referencePublicId||'—'%></td></tr><%})%></tbody></table></div><%if(queuePages?.entries?.hasMore){%><p><a class="account-link" href="/account/rewards?entriesAfter=<%=encodeURIComponent(queuePages.entries.next)%>">Older activity</a></p><%}%></section></div></main></body></html>
