<!DOCTYPE html>

<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head>
<%- include('partials/brand-icons') %><base href="/"/><meta charset="utf-8"/><meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/><meta content="#ff6200" name="theme-color"/><%- include("partials/seo-meta") %><link href="/styles.css" rel="stylesheet"/><link href="/storefront-pages.css" rel="stylesheet"/><link href="/shared-shell.css" rel="stylesheet"/><link href="/marketplace-pages.css" rel="stylesheet"/><link href="/profile-pages.css" rel="stylesheet"/><%- include('partials/flash-assets') %>
</head><body class="profile-body"><a class="skip-link" href="#mainContent">Skip to content</a><%- include("partials/storefront-header") %>
<main class="profile-main" id="mainContent">
<section class="profile-hero" id="profileHero"><div class="container profile-hero-grid">
<div class="profile-identity"><img alt="<%= typeof initialProfile !== 'undefined' ? initialProfile.name : '' %>" src="<%= typeof initialProfile !== 'undefined' ? initialProfile.image : '/assets/image-placeholder.svg' %>" id="profileAvatar"/><div><span class="verified-pill"><img alt="" src="/assets/icons/circle-check.svg"/>Verified profile</span><h1 id="profileName"><%= typeof initialProfile !== 'undefined' ? initialProfile.name : 'Profile' %></h1><p id="profileRole"><%= typeof initialProfile !== 'undefined' ? 'Verified seller · ' + initialProfile.country : '' %></p><div class="profile-tags" id="profileTags"></div></div></div>
<div class="profile-actions"><button id="followProfile" type="button"><img alt="" src="/assets/icons/heart-regular.svg"/>Follow</button><button id="shareProfile" type="button"><img alt="" src="/assets/icons/share-nodes.svg"/>Share</button></div>
</div></section>
<div class="container profile-layout">
<section class="profile-content">
<article class="profile-card"><span class="profile-kicker">About</span><h2 id="profileAboutTitle">About this profile</h2><p id="profileBio"><%= typeof initialProfile !== 'undefined' ? initialProfile.description : '' %></p><div class="profile-metrics" id="profileMetrics"></div></article>
<article class="profile-card"><div class="profile-section-head"><div><span class="profile-kicker">Marketplace collection</span><h2 id="profileCollectionTitle">Featured collection</h2></div><a href="/products" id="profileAllProducts">View all</a></div><div class="profile-products" id="profileProducts"><%- include("partials/profile-products") %></div></article>
<article class="profile-card"><span class="profile-kicker">Customer confidence</span><h2>Why shoppers follow this profile</h2><div class="profile-benefits"><span><img alt="" src="/assets/icons/circle-check.svg"/><b>Verified marketplace identity</b><small>Profile and activity reviewed by Classic Mart.</small></span><span><img alt="" src="/assets/icons/circle-check.svg"/><b>Visible marketplace activity</b><small>Products, campaigns and results come from verified marketplace records.</small></span><span><img alt="" src="/assets/icons/lock.svg"/><b>Buyer-first recommendations</b><small>Clear listings, prices and support information.</small></span></div></article>
</section>
<aside class="profile-sidebar"><article class="profile-card"><span class="profile-kicker">Contact</span><h2>Connect with <span id="profileShortName">this profile</span></h2><form id="profileContactForm"><label>Your email<input placeholder="Sign in to contact this seller" value="<%= user?.email || '' %>" <%= user ? 'readonly' : '' %> required="" type="email"/></label><label>Message<textarea maxlength="2000" minlength="10" placeholder="Ask about products or availability..." required="" rows="5"></textarea></label><button type="submit">Send message</button></form><p id="profileContactStatus" role="status"></p></article></aside>
</div>
</main><section class="newsletter">
<div class="container newsletter-inner">
<div class="newsletter-message"><span><img alt="" src="/assets/icons/envelope.svg"/></span><div><strong>Stay in the Loop!</strong><small>Get exclusive deals, new arrivals and shopping tips.</small></div></div>
<form class="newsletter-form" data-newsletter-form id="newsletterForm" novalidate>
<label class="sr-only" for="newsletterEmail">Email address</label>
<input autocomplete="email" id="newsletterEmail" maxlength="254" name="email" placeholder="Enter your email address" required type="email"/>
<button type="submit">Subscribe</button>

</form>
<div class="newsletter-perks"><span><img alt="" src="/assets/icons/percent.svg"/><b>Exclusive Deals</b></span><span><img alt="" src="/assets/icons/gift.svg"/><b>New Arrivals</b></span><span><img alt="" src="/assets/icons/location-dot.svg"/><b>Shopping Tips</b></span></div>
</div>
</section><%- include("partials/storefront-footer") %><div aria-live="polite" class="page-toast" id="pageToast" role="status"></div><%- include("partials/product-preview-modal") %>
<script src="/cart-store.js"></script>
<script src="/product-preview.js"></script>
<script src="/profile-page.js"></script><script src="/shared-shell.js"></script><script src="/image-fallback.js"></script><script src="/country-switcher.js"></script><script src="/search-tools.js"></script><script src="/newsletter.js"></script></body></html>
