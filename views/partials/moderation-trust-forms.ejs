<%
const trust = moderationFlow;
const selected = trust.selected;
const record = selected?.record;
const review = selected?.kind === 'reviews';
const signal = selected?.kind === 'signals';
const actionPath = record ? '/moderation/' + (review ? 'reviews' : signal ? 'risk-signals' : 'risk-cases') + '/' + encodeURIComponent(record.publicId) + '/action' : '';
const savedDraft = trust.draft || {};
const statusLabel = value => String(value || '').replaceAll('_', ' ');
%>
<% if (trust.kindLinks?.length) { %><nav class="role-status-tabs moderation-record-tabs" aria-label="Trust record type"><% for (const link of trust.kindLinks) { %><a href="<%= link.href %>" class="<%= link.kind === trust.recordKind ? 'active' : '' %>" <%= link.kind === trust.recordKind ? 'aria-current=page' : '' %>><%= link.label %></a><% } %></nav><% } %>
<% if (record) { %>
<section class="panel role-form-section" id="moderation-case">
  <div class="role-panel-head compact"><div><span class="eyebrow"><%= review ? 'Verified purchase review' : signal ? 'Recorded risk signal' : 'Customer trust concern' %></span><h2><%= review ? record.title || selected.product?.title || 'Purchase review' : statusLabel(record.type) %></h2><p class="form-intro"><%= record.publicId %> · <%= record.country %> · <%= statusLabel(record.status) %></p></div><a class="plain-link" href="<%= review ? '/moderation/reviews' : '/moderation/risk-cases?kind=' + selected.kind %>">Close record</a></div>
  <dl class="role-form-grid">
    <div><dt>Assignment</dt><dd><%= record.assignment %></dd></div>
    <% if (selected.product) { %><div><dt>Product</dt><dd><%= selected.product.title %> · <%= selected.product.publicId %> · <%= statusLabel(selected.product.status) %></dd></div><% } %>
    <% if (selected.store) { %><div><dt>Store</dt><dd><%= selected.store.name %> · <%= selected.store.publicId %> · <%= statusLabel(selected.store.status) %></dd></div><% } %>
    <% if (selected.order) { %><div><dt>Original purchase</dt><dd><%= selected.order.publicId %> · <%= statusLabel(selected.order.fulfillmentState) %></dd></div><% } %>
    <% if (review) { %><div><dt>Rating</dt><dd><%= record.rating %>/5 · Verified delivered purchase</dd></div><% } %>
    <% if (signal) { %><div><dt>Subject</dt><dd><%= statusLabel(record.subjectType) %> · <%= record.subjectPublicId %></dd></div><div><dt>Recorded risk</dt><dd><%= statusLabel(record.severity) %> · <%= record.score %>/100</dd></div><% } %>
  </dl>
  <% if (record.body || record.description) { %><p class="form-intro"><%= record.body || record.description %></p><% } %>
  <% if (record.disputeReason) { %><p class="form-intro"><strong>Seller dispute:</strong> <%= record.disputeReason %></p><% } %>
  <% if (record.appealMessage) { %><p class="form-intro"><strong>Customer appeal:</strong> <%= record.appealMessage %></p><% } %>
  <% for (const entry of record.sellerResponses || []) { %><article class="role-security-row"><div><strong>Private Seller <%= entry.action %></strong><small><%= formatDate(entry.at) %></small><p><%= entry.message %></p></div></article><% } %>
  <% if (record.moderationReason || record.decision) { %><p class="form-intro"><strong>Recorded decision:</strong> <%= record.moderationReason || record.decision %></p><% } %>
  <% if (selected.sourceReview) { %><article class="role-security-row"><div><strong>Referred verified review · <%= selected.sourceReview.publicId %></strong><small><%= statusLabel(selected.sourceReview.status) %> · <%= selected.sourceReview.rating %>/5</small><p><%= selected.sourceReview.body %></p></div><a class="outline-button" href="/moderation/reviews?record=<%= encodeURIComponent(selected.sourceReview.publicId) %>&amp;country=<%= record.country %>">Open Review</a></article><% } %>
  <% if (selected.qa) { %><article class="role-security-row"><div><strong>Quality referral · <%= selected.qa.publicId %></strong><small><%= statusLabel(selected.qa.targetType) %> · <%= selected.qa.targetPublicId %></small><p><strong>Original decision:</strong> <%= statusLabel(selected.qa.decision) %> · <%= selected.qa.decisionReason %></p><p><strong>Quality finding:</strong> <%= selected.qa.note %></p></div><a class="outline-button" href="/moderation/reports?report=qa&amp;record=<%= encodeURIComponent(selected.qa.publicId) %>&amp;country=<%= record.country %>">Open Quality Review</a></article><% } %>
  <% for (const concern of selected.relatedConcerns || []) { %><p class="form-intro"><a class="plain-link" href="/moderation/risk-cases?record=<%= encodeURIComponent(concern.publicId) %>&amp;country=<%= record.country %>"><%= concern.publicId %></a> · <%= statusLabel(concern.type) %> · <%= statusLabel(concern.status) %></p><% } %>
  <% if (selected.independenceReason) { %><p class="server-flash error platform-flash" role="status"><%= selected.independenceReason %></p><% } %>
  <% if (selected.canAct) { %><form class="seller-verification-actions" method="post" action="<%= actionPath %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= record.version %>"><button class="outline-button" type="submit" name="action" value="<%= record.assignedToMe ? 'release' : 'claim' %>" <%= record.assigned && !record.assignedToMe ? 'disabled' : '' %>><%= record.assignedToMe ? 'Release Record' : 'Claim Record' %></button></form><% } %>
</section>
<% if (!review && !signal) { %><section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Attached evidence</h2><p>Private documents attached to this verified case.</p></div></div><% if (!selected.independenceReason) { for (const evidence of selected.evidence || []) { %><article class="role-security-row"><div><strong><%= evidence.description || evidence.publicId %></strong><small><%= formatDate(evidence.createdAt) %></small></div><a class="outline-button" href="/moderation/evidence/<%= encodeURIComponent(evidence.publicId) %>" target="_blank" rel="noopener noreferrer">View Evidence</a></article><% } if (!selected.evidence?.length) { %><p class="form-intro">No current evidence is attached.</p><% } } else { %><p class="form-intro">An independent reviewer must access this evidence.</p><% } %></section><% } %>
<% if (selected.canAct && record.assignedToMe) { %>
<form class="panel role-form-section" method="post" action="<%= actionPath %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= record.version %>"><div class="role-panel-head compact"><div><h2>Independent decision</h2><p>Record a clear explanation for the affected customer and seller.</p></div></div><div class="role-form-grid"><label class="wide">Decision reason<textarea name="reason" rows="4" minlength="3" maxlength="<%= review ? 500 : 1000 %>" required><%= savedDraft.reason || '' %></textarea></label>
  <% if (!review && !signal) { %><label class="wide">Enforcement<select name="enforcement"><option value="none" <%= !savedDraft.enforcement || savedDraft.enforcement === 'none' ? 'selected' : '' %>>No listing or store change</option><% if (selected.canEnforceProduct) { const action = selected.product.status === 'suspended' ? 'restore_product' : 'suspend_product'; %><option value="<%= action %>" <%= savedDraft.enforcement === action ? 'selected' : '' %>><%= selected.product.status === 'suspended' ? 'Restore recorded previous product state' : 'Suspend product in every selling country' %></option><% } if (selected.canEnforceStore && selected.store.status !== 'closed') { const action = selected.store.status === 'suspended' ? 'restore_store' : 'suspend_store'; %><option value="<%= action %>" <%= savedDraft.enforcement === action ? 'selected' : '' %>><%= selected.store.status === 'suspended' ? 'Restore recorded previous store state' : 'Suspend store in every affected country' %></option><% } %></select></label><% if (selected.product && !selected.canEnforceProduct || selected.store && !selected.canEnforceStore) { %><p class="form-intro">Global enforcement requires authority over every affected country.</p><% } %><% } %>
</div><div class="seller-verification-actions"><% if (review) { %><button class="primary-button" type="submit" name="action" value="publish">Publish Review</button><button class="outline-button" type="submit" name="action" value="reject">Reject Review</button><% } else if (signal) { %><button class="primary-button" type="submit" name="action" value="review">Mark Reviewed</button><button class="outline-button" type="submit" name="action" value="action">Record Action</button><button class="outline-button" type="submit" name="action" value="dismiss">Dismiss Signal</button><% } else { %><button class="primary-button" type="submit" name="action" value="action">Record Action</button><button class="outline-button" type="submit" name="action" value="investigate">Continue Investigation</button><button class="outline-button" type="submit" name="action" value="dismiss">Dismiss Concern</button><button class="outline-button" type="submit" name="action" value="close">Close Concern</button><% } %></div></form>
<% if (!signal) { %><form class="panel role-form-section" method="post" action="<%= actionPath %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= record.version %>"><input type="hidden" name="action" value="reply"><div class="role-panel-head compact"><div><h2>Public reply</h2><p>This message becomes visible to the customer and affected seller.</p></div></div><label>Message<textarea name="message" rows="3" minlength="3" maxlength="1000" required><%= savedDraft.message || '' %></textarea></label><div class="seller-verification-actions"><button class="outline-button" type="submit">Send Public Reply</button></div></form><% } %>
<% } %>
<% if (!signal) { %><section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Public conversation</h2><p>Saved customer, seller and Moderation messages.</p></div></div><% for (const message of record.publicMessages || []) { %><article class="role-security-row"><div><strong><%= statusLabel(message.author) %></strong><small><%= formatDate(message.at) %></small><p><%= message.message %></p></div></article><% } if (!record.publicMessages?.length) { %><p class="form-intro">No public messages are recorded.</p><% } %></section><% } %>
<section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Ownership and decision history</h2><p>Saved actions for this record.</p></div></div><% for (const entry of [...(record.assignmentHistory || []), ...(record.decisionHistory || [])].sort((a, b) => new Date(a.at) - new Date(b.at))) { %><p class="form-intro"><strong><%= statusLabel(entry.action) %></strong> · <%= entry.actor %> · <%= formatDate(entry.at) %><% if (entry.reason) { %> · <%= entry.reason %><% } %></p><% } if (!record.assignmentHistory?.length && !record.decisionHistory?.length) { %><p class="form-intro">No reviewer actions are recorded.</p><% } %></section>
<% } %>
