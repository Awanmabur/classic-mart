<%
  const flow = liveWarehouse.flow;
  const warehouseMemberName = String(typeof user !== 'undefined' ? user?.name || 'Member' : 'Member').trim().split(/\s+/)[0];
  const mode = flow.mode || 'overview';
  const filters = flow.filters || {};
  const permissions = flow.permissions || {};
  const summary = flow.summary || {};
  const warehouses = flow.warehouses || [];
  const tasks = flow.tasks || [];
  const inventory = flow.inventory || [];
  const discrepancies = flow.discrepancies || [];
  const waves = flow.waves || [];
  const movements = flow.movements || [];
  const readyParcels = flow.readyParcels || [];
  const draft = flow.draft || {};
  const path = mode === 'overview' ? '/warehouse' : '/warehouse/' + mode;
  const selectedWarehouse = warehouses.find(item => item.publicId === filters.warehousePublicId) || (warehouses.length === 1 ? warehouses[0] : null);
  const transferDestinations = flow.transferDestinations || [];
  const stockOptions = (flow.stockOptions || inventory).filter(item => item.warehousePublicId === selectedWarehouse?.publicId);
  const label = value => String(value || '').replaceAll('_', ' ').replace(/\b\w/g, character => character.toUpperCase());
  const tone = value => ['completed','approved','no_variance','good','released'].includes(value) ? 'good' : ['open','in_progress','pending_review','quarantine','active'].includes(value) ? 'warn' : ['damaged','rejected','cancelled'].includes(value) ? 'bad' : 'neutral';
  const number = value => Number(value || 0).toLocaleString('en-UG');
  let actionKeyIndex = 0;
  const actionKey = () => String(flow.actionKey || '') + ':' + (++actionKeyIndex);
  const pageHref = (changes = {}) => {
    const values = { warehousePublicId: filters.warehousePublicId, taskStatus: filters.taskStatus, scanCode: mode === 'reports' ? '' : filters.scanCode, mine: filters.mine ? '1' : '', after: filters.after, readyAfter: filters.readyAfter || '', reviewAfter: filters.reviewAfter || '', from: filters.from, to: filters.to, ...changes };
    const query = new URLSearchParams();
    for (const [key, value] of Object.entries(values)) if (value && value !== 'all') query.set(key, String(value));
    return path + (query.size ? '?' + query.toString() : '');
  };
  const exportQuery = new URLSearchParams();
  if (filters.warehousePublicId) exportQuery.set('warehousePublicId', filters.warehousePublicId);
  if (filters.from) exportQuery.set('from', filters.from);
  if (filters.to) exportQuery.set('to', filters.to);
  const exportHref = '/warehouse/reports/export.csv' + (exportQuery.size ? '?' + exportQuery.toString() : '');
  const titles = {overview:'Warehouse Overview',inventory:'Inventory Control',receiving:'Receiving',picking:'Picking Queue',packing:'Packing Station',dispatch:'Dispatch',returns:'Return Intake',reports:'Warehouse Reports',settings:'Warehouse Settings'};
  const descriptions = {overview:'Monitor receiving, inventory, picking, packing, dispatch, exceptions, and return intake.',inventory:'Track available, reserved, damaged, low-stock, and cycle-count quantities by SKU.',receiving:'Record inbound stock, purchase references, variances, damage, and put-away readiness.',picking:'Prioritize eligible orders, pick exact SKUs, confirm quantities, and surface stock exceptions.',packing:'Verify picked items, package safely, and prepare parcels for collection.',dispatch:'Prepare packed parcels for courier pickup and follow their handover status.',returns:'Receive returned items, inspect their condition, and record their stock disposition.',reports:'Review stock movement, fulfilment activity, variances, and cycle-count results.',settings:'Review warehouse locations, your access, and secure account controls.'};
  const metrics = ['inventory','receiving'].includes(mode) ? [
    ['Available units', summary.availableUnits, 'Ready to fulfil orders', 'i-box'],
    ['Reserved units', summary.reservedUnits, 'Allocated to open orders', 'i-clipboard'],
    ['Low-stock SKUs', summary.lowStockCount, 'At or below reorder point', 'i-bell'],
    ['Count reviews', summary.pendingDiscrepancies, 'Awaiting supervisor review', 'i-shield'],
  ] : [
    ['Open tasks', summary.totalOpen, 'Across selected locations', 'i-clipboard'],
    ['My open tasks', summary.mineOpen, 'Assigned to you', 'i-user'],
    ['Overdue tasks', summary.overdueOpen, 'Past their due time', 'i-clock'],
    ['Completed', summary.completed30d, 'In the last 30 days', 'i-check'],
  ];
  const taskModes = ['overview','receiving','picking','packing','dispatch','returns'];
  const reportEntries = value => Array.isArray(value) ? value.map(item => ({label:item.type || item.status || item._id || item.label, count:item.count ?? item.total ?? 0})) : Object.entries(value || {}).map(([name,value]) => ({label:name,count:typeof value === 'object' && value !== null ? value.count ?? value.total ?? 0 : value, quantity:typeof value === 'object' && value !== null ? value.quantity : undefined, tasks:typeof value === 'object' && value !== null ? value.tasks : undefined}));
%>
<section class="app-page active role-page warehouse-live-page" data-page="warehouse-<%= mode %>" data-role="warehouse">
  <div class="page-heading role-page-heading"><div><span class="eyebrow"><%= ['inventory','receiving'].includes(mode) ? 'Stock' : mode === 'returns' ? 'Reverse logistics' : mode === 'reports' ? 'Intelligence' : mode === 'settings' ? 'Configuration' : 'Fulfilment' %></span><h1><%= titles[mode] %></h1><p><%= descriptions[mode] %></p></div><a class="outline-button icon-button" href="<%= mode === 'reports' ? exportHref : '/warehouse/reports' %>"><svg aria-hidden="true"><use href="#i-download"></use></svg><%= mode === 'reports' ? 'Export Report' : 'Warehouse Reports' %></a></div>
  <% if (flow.error) { %><div class="panel dashboard-message dashboard-message-error" role="alert"><%= flow.error %></div><% } %>

  <% if (mode === 'overview') { %><section class="role-welcome panel"><div><span class="eyebrow">Warehouse workspace</span><h2>Good day, <%= warehouseMemberName %>.</h2><p><%= number(summary.totalOpen) %> open tasks across <%= number(summary.warehouseCount ?? warehouses.length) %> accessible locations. Review the queue, claim a task, and confirm its outcome.</p><div class="warehouse-live-actions"><a class="primary-button" href="/warehouse/picking">Open Picking Queue</a><a class="outline-button" href="/warehouse/receiving">Receiving</a></div></div></section><% } %>
  <% if (mode !== 'settings') { %><section class="role-metric-grid" aria-label="Warehouse summary"><% metrics.forEach(([name,value,detail,icon],index) => { %><article class="role-metric panel"><span class="role-metric-icon tone-<%= index + 1 %>"><svg aria-hidden="true"><use href="#<%= icon %>"></use></svg></span><div><small><%= name %></small><strong><%= number(value) %></strong><span><%= detail %></span></div></article><% }); %></section><% } %>

  <% if (mode !== 'settings') { %>
  <section class="panel role-form-section warehouse-live-filter-panel"><div class="role-panel-head compact"><div><h2>Find records</h2><p><%= mode === 'reports' ? 'Choose a location and movement date range. Dates include each full day in UTC.' : 'Choose a location or scan an exact SKU, product barcode, or parcel reference.' %></p></div></div>
    <form class="role-form-grid warehouse-live-filter" method="get" action="<%= path %>">
      <label>Warehouse<select name="warehousePublicId"><option value="">All accessible locations</option><% for (const warehouse of warehouses) { %><option value="<%= warehouse.publicId %>" <%= filters.warehousePublicId === warehouse.publicId ? 'selected' : '' %>><%= warehouse.name %><%= warehouse.city ? ' · ' + warehouse.city : '' %></option><% } %></select></label>
      <% if (mode === 'reports') { %><label>From date (UTC)<input type="date" name="from" value="<%= filters.from || '' %>"></label><label>To date (UTC)<input type="date" name="to" value="<%= filters.to || '' %>"></label><% } else { %><label>Scan or search<input type="search" name="scanCode" value="<%= filters.scanCode || '' %>" maxlength="100" placeholder="SKU, barcode, or parcel reference" autocomplete="off"></label><% } %>
      <% if (taskModes.includes(mode)) { %><label>Task status<select name="taskStatus"><option value="">All statuses</option><% for (const status of ['open','in_progress','completed','cancelled']) { %><option value="<%= status %>" <%= filters.taskStatus === status ? 'selected' : '' %>><%= label(status) %></option><% } %></select></label><label class="warehouse-live-checkbox"><input type="checkbox" name="mine" value="1" <%= filters.mine ? 'checked' : '' %>>Show only my tasks</label><% } %>
      <div class="wide warehouse-live-actions"><button class="outline-button" type="submit"><svg aria-hidden="true"><use href="#i-search"></use></svg>Find Records</button><% if (filters.warehousePublicId || filters.scanCode || filters.taskStatus || filters.mine || filters.from || filters.to) { %><a class="plain-link" href="<%= path %>">Clear Filters</a><% } %></div>
    </form>
    <% if ((flow.scanResults || []).length) { %><div class="warehouse-live-scan-results" role="status"><strong>Scan matches</strong><ul><% for (const match of flow.scanResults) { %><li><span><%= match.title || match.sku || match.publicId || match.parcelPublicId %></span><small><%= [match.type,match.warehouseName,match.barcode || match.parcelBarcode].filter(Boolean).join(' · ') %></small></li><% } %></ul></div><% } %>
  </section>
  <% } %>

  <% if (taskModes.includes(mode)) { %>
  <div class="role-content-grid warehouse-live-content">
    <section class="panel role-table-panel"><div class="role-panel-head"><div><h2><%= mode === 'overview' ? 'Priority tasks' : titles[mode] + ' records' %></h2><p><%= number(tasks.length) %> tasks on this page<%= Number.isFinite(flow.page?.total) ? ' · ' + number(flow.page.total) + ' matching tasks' : '' %></p></div><% if (filters.mine) { %><span class="role-status neutral">Assigned to you</span><% } %></div>
      <div class="role-table-wrap"><table class="role-table warehouse-live-task-table"><caption class="sr-only"><%= titles[mode] %> tasks</caption><thead><tr><th scope="col">Task / Item</th><th scope="col">Warehouse</th><th scope="col">Quantity</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead><tbody>
        <% for (const task of tasks) { %><tr>
          <td data-label="Task / Item"><div><strong><%= label(task.type) %></strong><span class="warehouse-live-cell-note"><%= task.title || task.sku || task.parcelBarcode || 'Parcel task' %></span><% if (task.sku) { %><small class="warehouse-live-cell-note">SKU: <%= task.sku %></small><% } %><small class="warehouse-live-cell-note"><%= task.publicId %></small><% if (task.reference) { %><small class="warehouse-live-cell-note">Reference: <%= task.reference %></small><% } %><% if (task.parcelPublicId) { %><small class="warehouse-live-cell-note">Parcel: <%= task.parcelPublicId %></small><% } %><% if (task.returnPublicId) { %><small class="warehouse-live-cell-note">Return: <%= task.returnPublicId %></small><% } %></div></td>
          <td data-label="Warehouse"><div><%= task.warehouseName %><% if (task.destinationWarehouseName) { %><small class="warehouse-live-cell-note">To <%= task.destinationWarehouseName %></small><% } %><% if (task.binCode) { %><small class="warehouse-live-cell-note">Bin: <%= task.binCode %></small><% } %></div></td>
          <td data-label="Quantity"><%= number(['pack','dispatch'].includes(task.type) ? task.parcelQuantity ?? task.quantity : task.quantity) %></td><td data-label="Status"><div><span class="role-status <%= tone(task.status) %>"><%= task.statusLabel || label(task.status) %></span><small class="warehouse-live-cell-note"><%= task.mine ? 'Assigned to you' : task.assignedName || 'Unassigned' %></small><% if (task.dueAt) { %><small class="warehouse-live-cell-note">Due <%= formatDate(task.dueAt) %></small><% } %><% if (task.completedAt) { %><small class="warehouse-live-cell-note"><%= formatDate(task.completedAt) %></small><% } %></div></td>
          <td data-label="Action"><div class="warehouse-live-actions"><% for (const action of ['claim','release']) { if (!task.actions?.[action] || action === 'claim' && task.type === 'cycle_count') continue; %><form method="post" action="/warehouse/tasks/<%= encodeURIComponent(task.publicId) %>/<%= action %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnPage" value="<%= mode %>"><input type="hidden" name="version" value="<%= task.version %>"><button class="<%= action === 'claim' ? 'primary-button' : 'outline-button' %>" type="submit"><%= action === 'claim' ? 'Claim Task' : 'Release Task' %><span class="sr-only"> <%= task.publicId %></span></button></form><% } %><% if (task.actions?.execute && task.type !== 'cycle_count') { %><span class="role-status warn">Ready to complete</span><% } %><% if (task.blockedReason) { %><p class="form-intro"><%= task.blockedReason %></p><% } %><% if (task.type === 'cycle_count' && task.status !== 'completed' && task.status !== 'cancelled') { %><a class="outline-button" href="/warehouse/inventory<%= task.warehousePublicId ? '?warehousePublicId=' + encodeURIComponent(task.warehousePublicId) : '' %>">Record a Fresh Count on Inventory</a><% } else if (!task.actions?.claim && !task.actions?.release && !task.actions?.execute && !task.blockedReason) { %><span><%= task.status === 'completed' ? 'Completed' : task.assignedName ? 'Assigned to ' + task.assignedName : 'No action available' %></span><% } %></div></td>
        </tr><% if ((task.actions?.execute && task.type !== 'cycle_count') || (task.parcelItems || []).length) { %><tr class="warehouse-live-detail-row"><td colspan="5" class="warehouse-live-details-cell">
          <details class="warehouse-live-details"><summary class="outline-button"><%= task.actions?.execute && task.type !== 'cycle_count' ? 'Complete ' + label(task.type) : 'View Parcel Items' %><span class="sr-only"> task <%= task.publicId %></span></summary>
            <% if ((task.parcelItems || []).length) { %><div class="warehouse-live-manifest"><h3><%= task.manifestIsAllocation ? 'Warehouse Pick Allocation' : 'Parcel Items' %></h3><% if (task.partialPick) { %><p class="form-intro">Item quantities show this warehouse’s original allocation. This task confirms <%= number(task.quantity) %> units remaining after earlier picks.</p><% } %><ul><% for (const item of task.parcelItems) { %><li><div><strong><%= item.title || item.sku %></strong><small><%= item.sku %><%= item.binCode ? ' · Bin: ' + item.binCode : '' %></small></div><span><%= number(item.quantity) %> units</span></li><% } %></ul></div><% } %>
            <% if (task.actions?.execute && task.type !== 'cycle_count') { %>
            <form class="role-form-grid warehouse-live-task-form" method="post" action="/warehouse/tasks/<%= encodeURIComponent(task.publicId) %>/execute"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnPage" value="<%= mode %>"><input type="hidden" name="version" value="<%= task.version %>">
              <p class="form-intro wide"><%= task.type === 'dispatch' ? 'Confirm this packed parcel is ready for collection. Carrier pickup and delivery are confirmed separately.' : task.type === 'return_inspection' ? 'Inspect the returned item and select its condition. This records stock disposition; refund eligibility remains part of the return review.' : 'Check the item, quantity, and location before confirming completion.' %></p>
              <% if (['receive','pick','transfer','cycle_count','return_inspection'].includes(task.type)) { %><label><%= task.type === 'cycle_count' ? 'Counted quantity' : 'Confirmed quantity' %><input type="number" name="quantity" value="<%= task.quantity %>" min="<%= task.type === 'cycle_count' ? '0' : '1' %>" max="2000000000" step="1" inputmode="numeric" readonly required></label><% } else { %><input type="hidden" name="quantity" value="<%= task.quantity %>"><% } %>
              <% if (task.type === 'put_away' && task.binCode) { %><label>Destination bin<input name="binCode" value="<%= task.binCode %>" maxlength="80" readonly></label><% } %>
              <% if (task.type === 'return_inspection') { %><label>Inspected condition<select name="disposition" required><option value="">Choose condition</option><option value="good">Good · available stock</option><option value="damaged">Damaged · unavailable stock</option><option value="quarantine">Quarantine · awaiting review</option></select></label><% } %>
              <% if (task.notes) { %><p class="form-intro wide">Task notes: <%= task.notes %></p><% } %><div class="wide warehouse-live-actions"><button class="primary-button" type="submit">Confirm Completion</button></div>
            </form><% } %>
          </details>
        </td></tr><% } } %>
        <% if (!tasks.length) { %><tr><td class="warehouse-live-empty" colspan="5">No tasks match these filters.<% if (filters.scanCode || filters.taskStatus || filters.mine) { %> <a class="plain-link" href="<%= pageHref({scanCode:'',taskStatus:'',mine:''}) %>">View all tasks</a><% } %></td></tr><% } %>
      </tbody></table></div><div class="role-table-footer"><span>Showing <%= number(tasks.length) %> tasks</span><% if (flow.page?.hasMore) { %><a class="outline-button" href="<%= pageHref({after:flow.page.next || flow.page.nextCursor}) %>">Next Page</a><% } %></div>
    </section>
    <aside class="role-side-stack">
      <section class="panel role-insights"><div class="role-panel-head compact"><div><span class="eyebrow">Decision support</span><h2>What needs attention</h2></div></div><div class="role-insight-list"><article><span>1</span><p><%= number(summary.overdueOpen) %> open tasks are overdue. Check the due time and claim work you can complete.</p></article><article><span>2</span><p><%= number(summary.pendingDiscrepancies) %> count differences need supervisor review.</p></article><article><span>3</span><p><%= number(summary.returnInspections) %> return inspections are open. Record the inspected condition before returning units to available stock.</p></article></div><a class="soft-button full-button" href="/warehouse/inventory">Review Inventory</a></section>
      <section class="panel role-tip-card"><span><svg aria-hidden="true"><use href="#i-shield"></use></svg></span><div><strong>Confirm each step</strong><p>Claim a task before completing it. Confirm the exact SKU and quantity, then check its recorded outcome before moving to the next step.</p></div></section>
    </aside>
  </div>
  <% } %>

  <% if (permissions.createTask && mode === 'receiving') { %>
  <section class="panel role-form-section warehouse-live-section"><div class="role-panel-head compact"><div><h2>Receive & Put Away Stock</h2><p>Record incoming units against an existing SKU, then assign its storage bin.</p></div></div>
    <% if (!selectedWarehouse) { %><p class="form-intro">Choose one warehouse in the location filter to create a receiving or put-away task.</p><% } else if (!stockOptions.length) { %><p class="form-intro">No stock records match this location or scan. Add the SKU to this warehouse through its product inventory before recording an inbound receipt.</p><% } else { %>
    <div class="warehouse-live-form-pair"><% for (const [type,title,button] of [['receive','Receive incoming stock','Create Receiving Task'],['put_away','Put stock away','Create Put-away Task']]) { %><form class="role-form-grid warehouse-live-create-form" method="post" action="/warehouse/tasks"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnPage" value="<%= mode %>"><input type="hidden" name="version" value="<%= selectedWarehouse.version %>"><input type="hidden" name="actionKey" value="<%= actionKey() %>"><input type="hidden" name="warehousePublicId" value="<%= selectedWarehouse.publicId %>"><input type="hidden" name="type" value="<%= type %>"><h3 class="wide"><%= title %> · <%= selectedWarehouse.name %></h3>
      <label class="wide">Stock item<select name="stockPublicId" required><option value="">Choose SKU</option><% for (const stock of stockOptions) { %><option value="<%= stock.publicId %>" <%= draft.type === type && draft.stockPublicId === stock.publicId ? 'selected' : '' %>><%= stock.sku %> · <%= stock.title %></option><% } %></select></label>
      <% if (type === 'receive') { %><label class="wide">Incoming quantity<input name="quantity" type="number" min="1" max="2000000000" step="1" inputmode="numeric" value="<%= draft.type === type ? draft.quantity ?? '' : '' %>" required></label><% } else { %><input type="hidden" name="quantity" value="0"><% } %>
      <% if (type === 'put_away') { %><label class="wide">Bin code<input name="binCode" maxlength="80" value="<%= draft.type === type ? draft.binCode || '' : '' %>" required></label><% } %><label class="wide">Purchase or intake reference<input name="reference" maxlength="120" value="<%= draft.type === type ? draft.reference || '' : '' %>"></label><label class="wide">Notes<textarea name="notes" rows="2" maxlength="500"><%= draft.type === type ? draft.notes || '' : '' %></textarea></label><div class="wide warehouse-live-actions"><button class="primary-button" type="submit"><%= button %></button></div>
    </form><% } %></div><p class="form-intro warehouse-live-note">Stock choices show up to 25 matching records. Use the scan field to find an exact SKU.</p><% } %>
  </section>
  <% } %>

  <% if (['picking','packing','dispatch'].includes(mode)) { const type = ({picking:'pick',packing:'pack',dispatch:'dispatch'})[mode]; %>
  <section class="panel role-form-section warehouse-live-section"><div class="role-panel-head compact"><div><h2><%= mode === 'picking' ? 'Parcels Ready to Pick' : mode === 'packing' ? 'Parcels Ready to Pack' : 'Parcels Ready for Dispatch' %></h2><p>Eligible parcels from your accessible warehouses · up to 25 matching records.</p></div></div>
    <div class="warehouse-live-record-grid"><% for (const parcel of readyParcels) { %><article class="warehouse-live-record"><h3><%= parcel.barcode || parcel.publicId %></h3><p class="warehouse-live-cell-note"><%= parcel.publicId %></p><% if (parcel.labelUrl) { %><a class="outline-button" href="/warehouse/parcels/<%= encodeURIComponent(parcel.publicId) %>/label" target="_blank" rel="noopener">Print Label<span class="sr-only"> for <%= parcel.publicId %></span></a><% } %><dl class="warehouse-live-facts"><div><dt>Status</dt><dd><%= label(parcel.status) %></dd></div><div><dt>Picked quantity</dt><dd><%= number(parcel.pickedQuantity) %> / <%= number(parcel.quantity) %></dd></div></dl>
      <% if ((parcel.parcelItems || []).length) { %><div class="warehouse-live-manifest"><h4>Parcel Items</h4><ul><% for (const item of parcel.parcelItems) { %><li><div><strong><%= item.title || item.sku %></strong><small><%= item.sku %></small></div><span><%= number(item.quantity) %> units</span></li><% } %></ul></div><% } %>
      <% if (permissions.createTask && parcel.actions?.[type]) { const groups = type === 'pick' ? (parcel.warehouseGroups || []).filter(group => group.remaining > 0) : type === 'dispatch' ? [{warehousePublicId:parcel.packWarehousePublicId}] : selectedWarehouse ? [{warehousePublicId:selectedWarehouse.publicId}] : (parcel.warehouseGroups || []).length === 1 ? parcel.warehouseGroups : []; for (const group of groups) { const warehouse = warehouses.find(item => item.publicId === group.warehousePublicId); if (!warehouse) continue; %>
      <form class="warehouse-live-actions warehouse-live-parcel-form" method="post" action="/warehouse/tasks"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnPage" value="<%= mode %>"><input type="hidden" name="version" value="<%= warehouse.version %>"><input type="hidden" name="actionKey" value="<%= actionKey() %>"><input type="hidden" name="warehousePublicId" value="<%= warehouse.publicId %>"><input type="hidden" name="type" value="<%= type %>"><input type="hidden" name="parcelPublicId" value="<%= parcel.publicId %>"><p class="form-intro"><%= warehouse.name %><%= type === 'pick' ? ' · ' + number(group.remaining) + ' units remaining' : '' %></p><button class="primary-button" type="submit">Create <%= label(type) %> Task</button></form>
      <% } if (!groups.length) { %><p class="form-intro">Choose a consolidation warehouse in the location filter before creating the packing task.</p><% } } else { %><p class="form-intro">No new task is available at this step. Check the current task queue.</p><% } %>
    </article><% } %><% if (!readyParcels.length) { %><p class="form-intro">No eligible parcels match this location or scan.</p><% } %></div>
    <% if (flow.readyPage?.hasMore) { %><div class="role-table-footer"><span>Showing <%= number(readyParcels.length) %> eligible parcels</span><a class="outline-button" href="<%= pageHref({readyAfter:flow.readyPage.next || flow.readyPage.nextCursor}) %>">Next Eligible Parcels</a></div><% } %>
  </section>
  <% } %>

  <% if (mode === 'picking') { %>
  <section class="panel role-form-section warehouse-live-section"><div class="role-panel-head compact"><div><h2>Pick Waves</h2><p>Group open picking tasks for a single location · up to 25 recent waves.</p></div><span class="role-status neutral"><%= number(summary.activeWaves) %> active</span></div>
    <% if (permissions.createTask && selectedWarehouse) { %><form class="role-form-grid warehouse-live-wave-form" method="post" action="/warehouse/pick-waves"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnPage" value="<%= mode %>"><input type="hidden" name="version" value="<%= selectedWarehouse.version %>"><input type="hidden" name="actionKey" value="<%= actionKey() %>"><input type="hidden" name="warehousePublicId" value="<%= selectedWarehouse.publicId %>"><label>Maximum tasks in wave<input type="number" name="batchSize" min="2" max="50" step="1" value="<%= draft.batchSize ?? '10' %>" inputmode="numeric" required></label><div class="warehouse-live-actions"><button class="primary-button" type="submit">Create Pick Wave</button></div></form><% } else if (permissions.createTask) { %><p class="form-intro">Choose one warehouse in the location filter to create a pick wave.</p><% } %>
    <div class="warehouse-live-record-grid"><% for (const wave of waves) { %><article class="warehouse-live-record"><h3><%= wave.publicId %></h3><dl class="warehouse-live-facts"><div><dt>Warehouse</dt><dd><%= wave.warehouseName %></dd></div><div><dt>Tasks / Units</dt><dd><%= number(wave.taskCount) %> / <%= number(wave.totalQuantity) %></dd></div><div><dt>Status</dt><dd><span class="role-status <%= tone(wave.status) %>"><%= label(wave.status) %></span></dd></div><div><dt>Assigned to</dt><dd><%= wave.mine ? 'You' : wave.assignedName || 'Unassigned' %></dd></div></dl><% if (wave.canRelease) { %><form class="warehouse-live-actions" method="post" action="/warehouse/pick-waves/<%= encodeURIComponent(wave.publicId) %>/release"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnPage" value="<%= mode %>"><input type="hidden" name="version" value="<%= wave.version %>"><button class="outline-button" type="submit">Release Wave<span class="sr-only"> <%= wave.publicId %></span></button></form><% } %></article><% } %><% if (!waves.length) { %><p class="form-intro">No pick waves have been created for these locations.</p><% } %></div>
  </section>
  <% } %>

  <% if (mode === 'inventory') { %>
  <section class="panel role-table-panel warehouse-live-section"><div class="role-panel-head"><div><h2>Stock Records</h2><p><%= number(inventory.length) %> SKUs on this page<%= Number.isFinite(flow.page?.total) ? ' · ' + number(flow.page.total) + ' matching records' : '' %></p></div><span class="role-status neutral"><%= number(summary.onHandUnits) %> on hand</span></div>
    <div class="role-table-wrap"><table class="role-table"><caption class="sr-only">Warehouse stock and available quantities</caption><thead><tr><th scope="col">Product / SKU</th><th scope="col">Warehouse / Bin</th><th scope="col">On hand</th><th scope="col">Available / Reserved</th><th scope="col">Condition</th></tr></thead><tbody>
      <% for (const stock of inventory) { %><tr><td data-label="Product / SKU"><div><strong><%= stock.title %></strong><span class="warehouse-live-cell-note"><%= stock.sku %></span><% if (stock.barcode) { %><small class="warehouse-live-cell-note"><%= stock.barcode %></small><% } %></div></td><td data-label="Warehouse / Bin"><div><%= stock.warehouseName %><small class="warehouse-live-cell-note"><%= stock.binCode || 'Bin not assigned' %></small></div></td><td data-label="On hand"><%= number(stock.onHand) %></td><td data-label="Available / Reserved"><div><strong><%= number(stock.available) %> available</strong><small class="warehouse-live-cell-note"><%= number(stock.reserved) %> reserved</small><small class="warehouse-live-cell-note">Reorder point: <%= number(stock.reorderPoint) %></small></div></td><td data-label="Condition"><div><span class="role-status <%= stock.available <= stock.reorderPoint ? 'warn' : 'good' %>"><%= stock.available <= 0 ? 'Out of stock' : stock.available <= stock.reorderPoint ? 'Low stock' : 'Available' %></span><small class="warehouse-live-cell-note"><%= number(stock.damaged) %> damaged</small><small class="warehouse-live-cell-note"><%= number(stock.quarantined) %> quarantined</small></div></td></tr>
      <tr class="warehouse-live-detail-row"><td colspan="5" class="warehouse-live-details-cell"><details class="warehouse-live-details"><summary class="outline-button">Record Cycle Count<span class="sr-only"> for <%= stock.sku %> in <%= stock.warehouseName %></span></summary><form class="role-form-grid warehouse-live-task-form" method="post" action="/warehouse/stock/<%= encodeURIComponent(stock.publicId) %>/cycle-count"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnPage" value="<%= mode %>"><input type="hidden" name="version" value="<%= stock.version %>"><input type="hidden" name="actionKey" value="<%= actionKey() %>"><label>Physically counted on-hand units<input type="number" name="countedOnHand" min="0" max="2000000000" step="1" inputmode="numeric" required></label><label>Count note<input name="notes" minlength="3" maxlength="300" required placeholder="Where and how the count was checked"></label><p class="form-intro wide">A count difference is recorded for independent supervisor review before adjusting stock.</p><div class="wide warehouse-live-actions"><button class="primary-button" type="submit">Submit Cycle Count</button></div></form></details></td></tr><% } %>
      <% if (!inventory.length) { %><tr><td class="warehouse-live-empty" colspan="5">No stock records match this location or scan.</td></tr><% } %>
    </tbody></table></div><div class="role-table-footer"><span>Showing <%= number(inventory.length) %> stock records</span><% if (flow.page?.hasMore) { %><a class="outline-button" href="<%= pageHref({after:flow.page.next || flow.page.nextCursor}) %>">Next Page</a><% } %></div>
  </section>
  <% if (permissions.createTask) { %><section class="panel role-form-section warehouse-live-section"><div class="role-panel-head compact"><div><h2>Transfer Stock</h2><p>Move available units between warehouses belonging to the same store.</p></div></div><% if (!selectedWarehouse) { %><p class="form-intro">Choose a source warehouse in the location filter to prepare a transfer.</p><% } else if (!stockOptions.length) { %><p class="form-intro">No stock records match this location or scan.</p><% } else if (!transferDestinations.length) { %><p class="form-intro">No other accessible warehouse in this store is available for a transfer.</p><% } else { %><form class="role-form-grid" method="post" action="/warehouse/tasks"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnPage" value="<%= mode %>"><input type="hidden" name="version" value="<%= selectedWarehouse.version %>"><input type="hidden" name="actionKey" value="<%= actionKey() %>"><input type="hidden" name="warehousePublicId" value="<%= selectedWarehouse.publicId %>"><input type="hidden" name="type" value="transfer"><label>Source stock item<select name="stockPublicId" required><option value="">Choose SKU</option><% for (const stock of stockOptions) { %><option value="<%= stock.publicId %>" <%= draft.type === 'transfer' && draft.stockPublicId === stock.publicId ? 'selected' : '' %>><%= stock.sku %> · <%= stock.title %></option><% } %></select></label><label>Destination warehouse<select name="destinationWarehousePublicId" required><option value="">Choose destination</option><% for (const warehouse of transferDestinations) { %><option value="<%= warehouse.publicId %>" <%= draft.type === 'transfer' && draft.destinationWarehousePublicId === warehouse.publicId ? 'selected' : '' %>><%= warehouse.name %> · <%= warehouse.city %></option><% } %></select></label><label>Transfer quantity<input type="number" name="quantity" min="1" max="2000000000" step="1" inputmode="numeric" value="<%= draft.type === 'transfer' ? draft.quantity ?? '' : '' %>" required></label><label>Reference<input name="reference" maxlength="120" value="<%= draft.type === 'transfer' ? draft.reference || '' : '' %>"></label><label class="wide">Transfer notes<textarea name="notes" rows="2" maxlength="500"><%= draft.type === 'transfer' ? draft.notes || '' : '' %></textarea></label><div class="wide warehouse-live-actions"><button class="primary-button" type="submit">Create Transfer Task</button></div></form><% } %></section><% } %>
  <% } %>

  <% if (['inventory','reports'].includes(mode)) { %>
  <section class="panel role-form-section warehouse-live-section"><div class="role-panel-head compact"><div><h2>Cycle-count Reviews</h2><p>Pending count reviews take priority. Up to 25 records per page.</p></div><span class="role-status <%= summary.pendingDiscrepancies ? 'warn' : 'neutral' %>"><%= number(summary.pendingDiscrepancies) %> pending</span></div>
    <div class="warehouse-live-record-grid"><% for (const discrepancy of discrepancies) { %><article class="warehouse-live-record"><h3><%= discrepancy.title || discrepancy.sku %></h3><p class="warehouse-live-cell-note"><%= discrepancy.sku %> · <%= discrepancy.warehouseName %></p><dl class="warehouse-live-facts"><div><dt>Recorded / Counted</dt><dd><%= number(discrepancy.expectedOnHand) %> / <%= number(discrepancy.countedOnHand) %></dd></div><div><dt>Variance</dt><dd><%= discrepancy.variance > 0 ? '+' : '' %><%= number(discrepancy.variance) %></dd></div><div><dt>Status</dt><dd><span class="role-status <%= tone(discrepancy.status) %>"><%= label(discrepancy.status) %></span></dd></div><div><dt>Counted by</dt><dd><%= discrepancy.countedByName %> · <%= formatDate(discrepancy.countedAt) %></dd></div><div><dt>Count note</dt><dd><%= discrepancy.reason %></dd></div><% if (discrepancy.reviewedAt) { %><div><dt>Reviewed by</dt><dd><%= discrepancy.reviewedByName %> · <%= formatDate(discrepancy.reviewedAt) %></dd></div><% } %><% if (discrepancy.reviewNote) { %><div><dt>Review note</dt><dd><%= discrepancy.reviewNote %></dd></div><% } %></dl>
      <% if (discrepancy.recountRequired) { %><p class="form-intro">Count must be repeated before approval.</p><% } %><% if (discrepancy.canReview && permissions.reviewDiscrepancy) { %><form class="role-form-grid warehouse-live-task-form" method="post" action="/warehouse/discrepancies/<%= encodeURIComponent(discrepancy.publicId) %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnPage" value="<%= mode %>"><input type="hidden" name="version" value="<%= discrepancy.version %>"><label class="wide">Review decision<select name="decision" required><option value="">Choose decision</option><% if (discrepancy.canApprove) { %><option value="approve">Approve stock adjustment</option><% } %><option value="reject">Reject count adjustment</option></select></label><label class="wide">Review note<textarea name="reviewNote" rows="2" minlength="3" maxlength="300" required></textarea></label><div class="wide warehouse-live-actions"><button class="primary-button" type="submit">Submit Review</button></div></form><% } %>
    </article><% } %><% if (!discrepancies.length) { %><p class="form-intro">No count reviews are recorded for these locations.</p><% } %></div>
    <% if (flow.reviewPage?.hasMore) { %><div class="role-table-footer"><span>Showing <%= number(discrepancies.length) %> count reviews</span><a class="outline-button" href="<%= pageHref({reviewAfter:flow.reviewPage.next || flow.reviewPage.nextCursor}) %>">Next Review Page</a></div><% } %>
  </section>
  <% } %>

  <% if (mode === 'reports') { %>
  <div class="role-bottom-grid warehouse-live-section"><% for (const [title,value,period] of [['Task types',flow.reports?.taskCounts,'All recorded tasks'],['Task status',flow.reports?.taskStatusCounts,'All recorded tasks'],['Stock movements',flow.reports?.movementCounts,'Last 30 days'],['Pick waves',flow.reports?.waveCounts,'All recorded waves']]) { const entries = reportEntries(value); %><section class="panel role-form-section"><div class="role-panel-head compact"><div><h2><%= title %></h2><p><%= period %> for the selected locations.</p></div></div><dl class="warehouse-live-facts"><% for (const entry of entries) { %><div><dt><%= label(entry.label) %></dt><dd><strong><%= number(entry.count) %></strong><% if (entry.quantity !== undefined) { %><small class="warehouse-live-cell-note"><%= number(entry.quantity) %> units moved</small><% } %><% if (entry.tasks !== undefined) { %><small class="warehouse-live-cell-note"><%= number(entry.tasks) %> tasks</small><% } %></dd></div><% } %><% if (!entries.length) { %><div><dt>Recorded activity</dt><dd>None yet</dd></div><% } %></dl></section><% } %></div>
  <section class="panel role-table-panel warehouse-live-section"><div class="role-panel-head"><div><h2>Stock Movement History</h2><p><%= number(movements.length) %> movements on this page</p></div><a class="outline-button role-export" href="<%= exportHref %>"><svg aria-hidden="true"><use href="#i-download"></use></svg>Export</a></div><div class="role-table-wrap"><table class="role-table"><caption class="sr-only">Recorded inventory movements</caption><thead><tr><th scope="col">SKU / Warehouse</th><th scope="col">Movement</th><th scope="col">Quantity</th><th scope="col">On hand</th><th scope="col">Recorded</th></tr></thead><tbody><% for (const movement of movements) { %><tr><td data-label="SKU / Warehouse"><div><strong><%= movement.sku %></strong><small class="warehouse-live-cell-note"><%= movement.warehouseName %></small></div></td><td data-label="Movement"><div><%= label(movement.type) %><% if (movement.reference) { %><small class="warehouse-live-cell-note"><%= movement.reference %></small><% } %><% if (movement.reason) { %><small class="warehouse-live-cell-note"><%= movement.reason %></small><% } %></div></td><td data-label="Quantity"><%= number(movement.quantity) %></td><td data-label="On hand"><%= number(movement.onHandBefore) %> → <%= number(movement.onHandAfter) %></td><td data-label="Recorded"><div><%= formatDate(movement.createdAt) %><small class="warehouse-live-cell-note"><%= movement.actorName || 'System' %></small></div></td></tr><% } %><% if (!movements.length) { %><tr><td class="warehouse-live-empty" colspan="5">No stock movements match these filters.</td></tr><% } %></tbody></table></div><div class="role-table-footer"><span>Showing <%= number(movements.length) %> stock movements</span><% if (flow.page?.hasMore) { %><a class="outline-button" href="<%= pageHref({after:flow.page.next || flow.page.nextCursor}) %>">Next Page</a><% } %></div></section>
  <% } %>

  <% if (mode === 'settings') { %>
  <div class="role-content-grid warehouse-live-content"><div class="role-side-stack"><section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Warehouse Locations</h2><p>Active locations you can access.</p></div></div><div class="warehouse-live-record-grid"><% for (const warehouse of flow.settings?.locations || warehouses) { %><article class="warehouse-live-record"><h3><%= warehouse.name %></h3><dl class="warehouse-live-facts"><div><dt>Country / City</dt><dd><%= warehouse.country %> · <%= warehouse.city %></dd></div><div><dt>Address</dt><dd><%= warehouse.address %></dd></div><div><dt>Reference</dt><dd><%= warehouse.publicId %></dd></div></dl><a class="outline-button" href="/warehouse/inventory?warehousePublicId=<%= encodeURIComponent(warehouse.publicId) %>">View Inventory</a></article><% } %></div></section><section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Workspace Access</h2><p>Permissions assigned to your current account.</p></div></div><dl class="warehouse-live-facts"><div><dt>Access level</dt><dd><%= permissions.supervisor ? 'Warehouse supervisor' : 'Warehouse operator' %></dd></div><div><dt>Create tasks</dt><dd><%= permissions.createTask ? 'Allowed' : 'Not assigned' %></dd></div><div><dt>Review count differences</dt><dd><%= permissions.reviewDiscrepancy ? 'Allowed · independent review required' : 'Supervisor review required' %></dd></div><div><dt>Locations</dt><dd><%= number(warehouses.length) %> accessible warehouses</dd></div></dl></section></div><aside class="role-side-stack"><section class="panel role-publish-card"><div class="role-panel-head compact"><div><span class="eyebrow">Account</span><h2>Password & Security</h2></div></div><p class="form-intro">Manage your password, multi-factor authentication, and active sessions from your account security page.</p><a class="primary-button full-button" href="<%= flow.settings?.securityUrl || '/account/security' %>">Open Security Settings</a><a class="outline-button full-button" href="/profile">Profile Settings</a></section><section class="panel role-tip-card"><span><svg aria-hidden="true"><use href="#i-pin"></use></svg></span><div><strong>Location changes</strong><p>Warehouse owners manage location details through their store settings. Your workspace reflects the current active locations and access permissions.</p></div></section></aside></div>
  <% } %>
</section>
