<div class="two-column-page rewards-lower">
  <section class="panel content-panel"><div class="section-heading"><h2>Refunds</h2><span class="muted-label">Verified status</span></div><div class="activity-list">
    <% if(!(pageData.refunds||[]).length){ %><div class="empty-state"><p>No refunds yet.</p></div><% } %>
    <% (pageData.refunds||[]).forEach(row=>{ %><div><div><strong><%= row.publicId %></strong><small><%= row.status %> · <%= formatDate(row.createdAt) %></small><% if(row.returnPublicId){ %><small>Return <%= row.returnPublicId %></small><% } %></div><b><%= formatMoney(row.amountMinor,row.currency) %></b></div><% }) %>
  </div><%- include('customer-history-navigation',{historyPage:pageData.pagination?.refunds,historyLabel:'refunds'}) %></section>
  <section class="panel content-panel"><div class="section-heading"><h2>Disputes</h2><a class="plain-link" href="/account/returns">Open a Dispute</a></div><div class="ticket-list">
    <% if(!(pageData.disputes||[]).length){ %><div class="empty-state"><p>No disputes yet.</p></div><% } %>
    <% (pageData.disputes||[]).forEach(row=>{ %><article class="ticket-row"><div><strong><%= row.subject %></strong><small><%= row.publicId %> · <%= row.status.replaceAll('_',' ') %></small><details class="faq-item"><summary>Messages &amp; actions</summary><p><%= row.description %></p><% (row.events||[]).forEach(event=>{ %><p><strong><%= event.author %>:</strong> <%= event.message %></p><small><%= formatDate(event.at) %></small><% }) %>
      <% if(['open','investigating','awaiting_customer','awaiting_seller','appealed'].includes(row.status)){ %><form class="dashboard-form" method="post" action="/account/disputes/<%= row.publicId %>/reply"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/returns"><input type="hidden" name="version" value="<%= row.version %>"><label>Reply<textarea name="message" minlength="10" maxlength="1000" required></textarea></label><button class="soft-button" type="submit">Send Reply</button></form><% } %>
      <% if(['resolved','rejected','closed'].includes(row.status)){ %><form class="dashboard-form" method="post" action="/account/disputes/<%= row.publicId %>/appeal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/returns"><input type="hidden" name="version" value="<%= row.version %>"><label>Appeal<textarea name="message" minlength="10" maxlength="1000" required></textarea></label><button class="outline-button" type="submit">Submit Appeal</button></form><% } %>
    </details></div></article><% }) %>
  </div><%- include('customer-history-navigation',{historyPage:pageData.pagination?.disputes,historyLabel:'disputes'}) %></section>
</div>
<section class="panel content-panel"><div class="section-heading"><h2>Trust Reports</h2><a class="plain-link" href="/account/returns">Report an Issue</a></div><div class="ticket-list">
  <% if(!(pageData.cases||[]).length){ %><div class="empty-state"><p>No trust reports yet.</p></div><% } %>
  <% (pageData.cases||[]).forEach(row=>{ %><article class="ticket-row"><div><strong><%= row.publicId %></strong><small><%= row.status %> · <%= row.type?.replaceAll('_',' ') %></small><details class="faq-item"><summary>Report &amp; messages</summary><p><%= row.description %></p><% if(row.decision){ %><p><strong>Decision:</strong> <%= row.decision %></p><% } %><% (row.publicMessages||[]).forEach(message=>{ %><p><strong><%= message.author==='moderation'?'Moderation':'You' %>:</strong> <%= message.message %></p><small><%= formatDate(message.at) %></small><% }) %>
    <% if(['open','investigating','appealed'].includes(row.status)){ %><form class="dashboard-form" method="post" action="/account/trust-cases/<%= row.publicId %>/reply"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/returns"><input type="hidden" name="version" value="<%= row.version %>"><label>Reply<textarea name="message" minlength="3" maxlength="1000" required></textarea></label><button class="soft-button" type="submit">Send Reply</button></form><% } %>
    <% if(row.canAppeal){ %><form class="dashboard-form" method="post" action="/account/trust-cases/<%= row.publicId %>/appeal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/returns"><input type="hidden" name="version" value="<%= row.version %>"><label>Appeal<textarea name="message" minlength="10" maxlength="1000" required></textarea></label><button class="outline-button" type="submit">Submit Appeal</button></form><% } %>
  </details></div></article><% }) %>
</div><%- include('customer-history-navigation',{historyPage:pageData.pagination?.cases,historyLabel:'reports'}) %></section>
