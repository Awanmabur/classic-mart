<% if(pageId==='dashboard'){ const d=pageData||{}; const firstName=String(user?.name||'Member').trim().split(/\s+/)[0]||'Member'; const loyalty=d.loyalty||{}; const wallet=d.wallet||{}; const club=d.club||{}; const wishlistProducts=d.wishlist?.products||[]; %>
<section class="app-page active" data-page="dashboard">
  <div class="dashboard-overview">
    <div class="left-column">
      <section class="welcome-card panel"><div><h1>Welcome back, <%= firstName %>! <span>👋</span></h1><p>Here’s what’s happening with your account today.</p></div><img class="bags-art" src="/approved-dashboard/assets/shopping-bags.svg" alt="Shopping bags" /></section>

      <section class="stats-grid">
        <article class="stat-card panel"><div class="stat-top"><span class="stat-icon blue"><svg><use href="#i-bag"></use></svg></span><div><small>Total Orders</small><strong><%= d.orderCount||0 %></strong></div></div><a class="inline-link" href="/dashboard/orders">View all orders <svg><use href="#i-arrow-right"></use></svg></a></article>
        <article class="stat-card panel"><div class="stat-top"><span class="stat-icon yellow"><svg class="filled"><use href="#i-star"></use></svg></span><div><small>Rewards Points</small><strong id="pointsStat"><%= loyalty.points||0 %></strong></div></div><p>Available points</p></article>
        <article class="stat-card panel"><div class="stat-top"><span class="stat-icon green"><svg><use href="#i-wallet"></use></svg></span><div><small>Wallet Balance</small><strong id="walletStat"><%= formatMoney(wallet.balanceMinor||0,wallet.currency||user.currency) %></strong></div></div><a class="inline-link" href="/dashboard/wallet">View wallet <svg><use href="#i-arrow-right"></use></svg></a></article>
        <article class="stat-card panel"><div class="stat-top"><span class="stat-icon pink"><svg class="filled"><use href="#i-tag"></use></svg></span><div><small>Savings This Month</small><strong><%= formatMoney(d.monthlySavingsMinor||0,user.currency) %></strong></div></div><p class="saved">You saved more!</p></article>
      </section>

      <section class="orders-card panel">
        <div class="section-heading"><h2>Recent Orders</h2><a class="plain-link" href="/dashboard/orders">View All Orders</a></div>
        <div class="orders-list swipe-zone">
          <% if(!(d.recentOrders||[]).length){ %><div class="empty-state"><strong>No orders yet</strong><p>Your orders will appear here after checkout.</p></div><% } %>
          <% (d.recentOrders||[]).slice(0,3).forEach((order)=>{ const item=order.items?.[0]||{}; const state=String(order.fulfillmentState||order.status||'Recorded'); %>
            <article class="order-row"><img src="/approved-dashboard/assets/shopping-bags.svg" alt="<%= item.title||'Classic Mart order' %>" /><div class="order-product"><strong><%= item.title||'Classic Mart order' %></strong><small>Order #<%= order.publicId %></small></div><div class="order-state <%= /delivered/i.test(state)?'delivered':'shipped' %>"><strong><%= state.replaceAll('_',' ') %></strong><small><%= formatDate(order.createdAt) %></small></div><strong class="price"><%= formatMoney(order.totals?.totalMinor||0,order.totals?.currency||user.currency) %></strong><a class="soft-button" href="/track-order?order=<%= encodeURIComponent(order.publicId) %>">Track</a></article>
          <% }) %>
        </div>
        <a class="outline-button view-orders-button" href="/dashboard/orders">View All Orders</a>
      </section>

      <section class="quick-actions-card panel">
        <h2>Quick Actions</h2>
        <div class="quick-actions-grid">
          <% [['orders','i-bag','blue','My Orders'],['wishlist','i-heart','pink','Wishlist'],['addresses','i-pin','green','Addresses'],['wallet','i-card','purple','Wallet'],['support','i-support','orange','Support'],['profile','i-user','cyan','Profile']].forEach((item)=>{ %>
            <a class="quick-action stat-card panel" href="/dashboard/<%= item[0] %>"><div class="stat-top"><span class="stat-icon <%= item[2] %>"><svg><use href="#<%= item[1] %>"></use></svg></span><div><small>Quick action</small><strong><%= item[3] %></strong></div></div><span class="card-link">Open <svg><use href="#i-arrow-right"></use></svg></span></a>
          <% }) %>
        </div>
      </section>
    </div>

    <div class="right-column">
      <section class="club-card"><div class="club-heading"><img src="/approved-dashboard/assets/club-crown.png" alt="Classic Club crown" /><div><h2>Classic Club</h2><span><%= club.current?.label||'Classic' %> Member</span></div></div><div class="club-progress-row"><div class="club-progress"><span style="width:<%= club.progressPercent||0 %>%"></span></div><a aria-label="View club benefits" href="/dashboard/club"><svg><use href="#i-chevron-right"></use></svg></a></div><p><%= club.next?`${formatMoney(club.remainingMinor,user.currency)} more to reach ${club.next.label}`:'Highest membership tier reached' %></p></section>

      <section class="rewards-card panel"><div class="section-heading"><h2>Rewards &amp; Benefits</h2><a class="plain-link" href="/dashboard/rewards">View All</a></div><div class="reward-content"><div><h3>🎉&nbsp; You have <span class="points-text"><%= loyalty.points||0 %></span> points</h3><p>Redeem your points and get exciting discounts.</p><a class="primary-button redeem-button" href="/dashboard/rewards">Redeem Now</a></div><img src="/approved-dashboard/assets/gift.svg" alt="Gift" /></div></section>

      <section class="wishlist-card panel"><div class="section-heading"><h2>Wishlist</h2><a class="plain-link" href="/dashboard/wishlist">View Wishlist</a></div><div class="wishlist-grid swipe-zone"><% wishlistProducts.slice(0,4).forEach((product)=>{ %><article class="wishlist-item"><div><img src="<%= product.image||'/assets/product-placeholder.svg' %>" alt="<%= product.imageAlt||product.name %>" /><a class="heart-button active" href="/dashboard/wishlist" aria-label="Open wishlist"><svg><use href="#i-heart"></use></svg></a></div><strong><%= product.currency %> <%= Number(product.price||0).toLocaleString() %></strong></article><% }) %><% if(!wishlistProducts.length){ %><div class="empty-state"><p>No wishlist items yet.</p></div><% } %></div></section>

      <section class="help-card panel"><h2>Need Help?</h2><p>Our support team is here to help you.</p><a class="support-button" href="/dashboard/support"><svg><use href="#i-support"></use></svg><span>Create Support Ticket</span></a><a href="/dashboard/support" class="phone-link"><span><svg><use href="#i-phone"></use></svg></span>Contact support</a></section>
    </div>
  </div>
</section>
<% } %>

<% if(pageId==='orders'){ const orders=pageData.orders||[]; const processing=orders.filter(o=>/processing|confirmed|pending/i.test(String(o.fulfillmentState||o.status))).length; const onWay=orders.filter(o=>/shipped|out_for_delivery|in_transit/i.test(String(o.fulfillmentState||o.status))).length; const returns=orders.filter(o=>o.returnState&&o.returnState!=='none').length; %>
<section class="app-page active" data-page="orders">
  <div class="page-heading"><div><span class="eyebrow">Shopping activity</span><h1>My Orders</h1><p>Track deliveries, payments, receipts, returns and refunds.</p></div><a class="primary-button icon-button" href="/dashboard/categories"><svg><use href="#i-grid"></use></svg>Continue Shopping</a></div>
  <div class="summary-grid four">
    <article class="summary-card panel"><span class="stat-icon blue"><svg><use href="#i-clipboard"></use></svg></span><div><small>All Orders</small><strong><%= orders.length %></strong><p>Across your account</p></div></article>
    <article class="summary-card panel"><span class="stat-icon yellow"><svg><use href="#i-clock"></use></svg></span><div><small>Processing</small><strong><%= processing %></strong><p>Preparing for dispatch</p></div></article>
    <article class="summary-card panel"><span class="stat-icon green"><svg><use href="#i-truck"></use></svg></span><div><small>On the Way</small><strong><%= onWay %></strong><p>Active deliveries</p></div></article>
    <article class="summary-card panel"><span class="stat-icon pink"><svg><use href="#i-refresh"></use></svg></span><div><small>Returns</small><strong><%= returns %></strong><p>Return activity</p></div></article>
  </div>
  <section class="panel content-panel">
    <div class="toolbar"><div class="segmented"><a class="active" href="/dashboard/orders">All</a><a href="/dashboard/returns">Returns</a></div><a class="outline-button icon-button" href="/account/orders"><svg><use href="#i-download"></use></svg>Order History</a></div>
    <div class="rich-order-list">
      <% if(!orders.length){ %><div class="empty-state"><strong>No orders yet</strong><p>Your orders will appear here after checkout.</p></div><% } %>
      <% orders.forEach((o)=>{ const item=o.items?.[0]||{}; const state=String(o.fulfillmentState||o.status||'Recorded'); %>
        <article class="rich-order" data-status="<%= state %>"><div class="order-head"><div><strong>Order #<%= o.publicId %></strong><small>Placed on <%= formatDate(o.createdAt) %> · <%= o.items?.length||0 %> item(s)</small></div><span class="status-pill <%= /delivered/i.test(state)?'delivered':/processing|confirmed|pending/i.test(state)?'processing':'shipped' %>"><%= state.replaceAll('_',' ') %></span></div><div class="order-body"><img class="single-product-img" src="/approved-dashboard/assets/shopping-bags.svg" alt="<%= item.title||'Classic Mart order' %>"><div class="order-main"><h3><%= item.title||'Classic Mart order' %></h3><p>Payment: <strong><%= String(o.paymentState||'unpaid').replaceAll('_',' ') %></strong></p><small><%= o.deliveryMethod||'Delivery' %></small></div><strong class="order-total"><%= formatMoney(o.totals?.totalMinor||0,o.totals?.currency||user.currency) %></strong><div class="row-actions"><a class="soft-button" href="/track-order?order=<%= encodeURIComponent(o.publicId) %>">Track Order</a><a class="outline-button" href="/orders/<%= encodeURIComponent(o.publicId) %>/receipt">Receipt</a></div></div></article>
      <% }) %>
    </div>
  </section>
</section>
<% } %>

<% if(pageId==='wishlist'){ const products=pageData.products||[]; %>
<section class="app-page active" data-page="wishlist">
  <div class="page-heading"><div><span class="eyebrow">Saved for later</span><h1>My Wishlist</h1><p>Revisit saved products using live catalogue availability and prices.</p></div><a class="primary-button icon-button" href="/dashboard/categories"><svg><use href="#i-plus"></use></svg>Explore Products</a></div>
  <section class="wishlist-hero panel"><div><span class="stat-icon pink"><svg class="filled"><use href="#i-heart"></use></svg></span><div><strong><span id="wishlistCount"><%= products.length %></span> saved products</strong><p>Your wishlist is synced to your Classic Mart account.</p></div></div><a class="outline-button" href="/dashboard/cart">Open Cart</a></section>
  <div class="product-grid" id="wishlistProducts">
    <% if(!products.length){ %><div class="panel content-panel empty-state"><strong>Your wishlist is empty</strong><p>Save products from the marketplace to see them here.</p></div><% } %>
    <% products.forEach((product)=>{ const oldPrice=Number(product.oldPrice||0); const price=Number(product.price||0); const discountPct=oldPrice>price&&oldPrice>0?Math.round((oldPrice-price)*100/oldPrice):0; %><article class="product-card panel"><div class="product-image"><% if(discountPct>0){ %><span class="deal-badge">-<%= discountPct %>%</span><% } %><a href="/product/<%= encodeURIComponent(product.id) %>"><img src="<%= product.image %>" alt="<%= product.imageAlt||product.name %>"></a><button class="heart-button active" data-wishlist-remove="<%= product.id %>" aria-label="Remove from wishlist"><svg><use href="#i-heart"></use></svg></button></div><div class="product-info"><small><%= product.categoryName||'Marketplace' %></small><h3><%= product.name %></h3><div class="rating">★ <%= Number(product.rating||0).toFixed(1) %> <span>(<%= Number(product.reviews||0) %>)</span></div><div class="product-price"><strong><%= product.currency %> <%= price.toLocaleString() %></strong><% if(oldPrice>price){ %><del><%= product.currency %> <%= oldPrice.toLocaleString() %></del><% } %></div><button class="primary-button full-button" data-cart-add data-product="<%= product.id %>" data-variant="<%= product.variantId %>">Add to Cart</button></div></article><% }) %>
  </div>
</section>
<% } %>

<% if(pageId==='addresses'){ const addresses=pageData.addresses||[]; %>
<section class="app-page active" data-page="addresses">
  <div class="page-heading"><div><span class="eyebrow">Delivery details</span><h1>Saved Addresses</h1><p>Manage delivery locations and choose your preferred address.</p></div><a class="primary-button icon-button" href="#addressFormPanel"><svg><use href="#i-plus"></use></svg>Add New Address</a></div>
  <div class="two-column-page address-layout">
    <div class="stack-list" id="addressList">
      <% if(!addresses.length){ %><div class="panel empty-state"><p>No saved addresses yet.</p></div><% } %>
      <% addresses.forEach((address)=>{ %><article class="address-card panel <%= address.isDefault?'selected':'' %>" data-address-id="<%= address.publicId %>" data-address-full-name="<%= address.fullName %>" data-address-phone="<%= address.phone %>" data-address-street="<%= address.address %>" data-address-city="<%= address.city %>" data-address-country="<%= address.country %>" data-address-label="<%= address.label %>" data-address-note="<%= address.note||'' %>" data-address-default="<%= address.isDefault?'1':'0' %>"><div class="address-top"><span class="address-type"><svg><use href="#<%= /office/i.test(address.label)?'i-bag':/home/i.test(address.label)?'i-home':'i-pin' %>"></use></svg><%= address.label %></span><% if(address.isDefault){ %><span class="default-badge">Default</span><% } else { %><form method="post" action="/dashboard/addresses/<%= address.publicId %>/default"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="plain-link" type="submit">Make Default</button></form><% } %></div><h3><%= address.fullName %></h3><p><%= address.address %><br><%= address.city %>, <%= address.country %></p><strong><%= address.phone %></strong><% if(address.note){ %><p><small><%= address.note %></small></p><% } %><div class="card-actions"><button class="soft-button" type="button" data-address-edit="<%= address.publicId %>"><svg><use href="#i-edit"></use></svg>Edit</button><form method="post" action="/dashboard/addresses/<%= address.publicId %>/archive"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="outline-button" type="submit"><svg><use href="#i-trash"></use></svg>Delete</button></form></div></article><% }) %>
    </div>
    <aside class="panel form-panel" id="addressFormPanel"><div class="section-heading"><h2 id="addressFormTitle">Add Delivery Address</h2><span class="form-step">Secure checkout</span></div><form class="dashboard-form" id="addressForm" method="post" action="/dashboard/addresses"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-row"><label>Full name<input name="fullName" maxlength="120" value="<%= user.name %>" required></label><label>Phone number<input name="phone" maxlength="32" value="<%= user.phone %>" required></label></div><label>Street address<input name="address" maxlength="240" required></label><div class="form-row"><label>City<input name="city" maxlength="120" required></label><label>Country<input name="country" maxlength="2" value="<%= user.shoppingCountry||user.country %>" required></label></div><div class="form-row"><label>Address type<input name="label" maxlength="80" value="Home" required></label><label>Delivery note<input name="note" maxlength="500"></label></div><label class="check-row"><input type="checkbox" name="isDefault"> Set as my default delivery address</label><button class="primary-button full-button" type="submit">Save Address</button></form></aside>
  </div>
</section>
<% } %>

<% if(pageId==='rewards'){ const loyalty=pageData.loyalty||{}; const entries=pageData.entries||[]; %>
<section class="app-page active" data-page="rewards">
  <div class="page-heading"><div><span class="eyebrow">Classic rewards</span><h1>Rewards &amp; Benefits</h1><p>Review points earned from verified Classic Mart activity.</p></div><a class="outline-button icon-button" href="/dashboard/club"><svg><use href="#i-crown"></use></svg>Membership Benefits</a></div>
  <section class="reward-hero"><div><span>Available balance</span><strong><span class="points-text"><%= loyalty.points||0 %></span> points</strong><p>Reward activity below is backed by your account ledger.</p><a class="light-button" href="#rewardHistory">View points history</a></div><img src="/approved-dashboard/assets/gift.svg" alt="Rewards gift"></section>
  <section class="panel content-panel"><div class="section-heading"><h2>Redeem a Gift Card</h2><span class="muted-label">Verified by the server</span></div><div class="reward-catalog"><article class="reward-option"><span class="reward-icon"><svg><use href="#i-card"></use></svg></span><h3>Classic Mart Gift Card</h3><p>Enter a valid gift-card code. The server verifies the code and credits its value as reward points.</p><form method="post" action="/account/rewards/gift-card"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/dashboard/rewards"><label>Gift card code<input name="code" required maxlength="120"></label><button class="soft-button" type="submit">Redeem</button></form></article></div></section>
  <div class="two-column-page rewards-lower"><section class="panel content-panel" id="rewardHistory"><div class="section-heading"><h2>Recent Points Activity</h2><span class="muted-label"><%= entries.length %> entries</span></div><div class="activity-list"><% if(!entries.length){ %><div class="empty-state"><p>No reward activity yet.</p></div><% } %><% entries.forEach((entry)=>{ %><div><span class="activity-icon <%= Number(entry.pointsDelta)>=0?'plus':'minus' %>"><%= Number(entry.pointsDelta)>=0?'+':'' %><%= entry.pointsDelta %></span><div><strong><%= String(entry.type||'reward').replaceAll('_',' ') %></strong><small><%= entry.reason||entry.referencePublicId||'Classic Mart reward' %></small></div><b><%= Number(entry.pointsDelta)>=0?'+':'' %><%= entry.pointsDelta %> pts</b></div><% }) %></div></section><section class="panel tier-card"><span class="eyebrow">Lifetime activity</span><h2><%= loyalty.points||0 %> available points</h2><p>Points earned and redeemed are recorded against your loyalty account.</p><div class="tier-progress"><span style="width:<%= Math.min(100,Number(loyalty.points||0)%100) %>%"></span></div><div class="tier-labels"><span><%= loyalty.lifetimeRedeemed||0 %> redeemed</span><strong><%= loyalty.lifetimeEarned||0 %> earned</strong></div></section></div>
</section>
<% } %>

<% if(pageId==='wallet'){ const wallet=pageData.wallet||{}; const topUps=wallet.topUps||[]; const suggestedAmounts=['UGX','RWF','JPY','KRW'].includes(user.currency)?[50000,100000,200000]:[50,100,200]; %>
<section class="app-page active" data-page="wallet">
  <div class="page-heading"><div><span class="eyebrow">Payments</span><h1>Classic Wallet</h1><p>Add funds, manage secure payments, and review every verified wallet transaction.</p></div><a class="outline-button icon-button" href="/dashboard/wallet/statement.csv"><svg><use href="#i-download"></use></svg>Download Statement</a></div>
  <div class="wallet-top-grid">
    <section class="wallet-hero"><span>Available balance</span><strong id="walletBalance"><%= formatMoney(wallet.balanceMinor||0,wallet.currency||user.currency) %></strong><p>Wallet funds are applied instantly at checkout after verified settlement.</p><div><a class="light-button" href="#walletAmount">Add Money</a><a class="ghost-light-button" href="/dashboard/support">Wallet Help</a></div></section>
    <section class="panel form-panel compact"><h2>Add Money</h2><p class="form-intro">Choose an amount or enter your own.</p><div class="amount-chips"><% suggestedAmounts.forEach((amount)=>{ %><button type="button" data-wallet-amount="<%= amount %>"><%= user.currency %> <%= amount.toLocaleString() %></button><% }) %></div><form class="dashboard-form" method="post" action="/dashboard/wallet/top-up"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= walletIdempotencyKey %>"><label>Amount<input id="walletAmount" name="amount" type="number" min="1" step="<%= ['UGX','RWF','JPY','KRW'].includes(user.currency)?'1':'0.01' %>" required></label><button class="primary-button full-button" type="submit">Continue Securely</button></form></section>
  </div>
  <div class="two-column-page wallet-lower">
    <section class="panel content-panel"><div class="section-heading"><h2>Recent Transactions</h2><a class="plain-link" href="/account/wallet">View All</a></div><div class="transaction-list"><% if(!topUps.length){ %><div class="empty-state"><p>No top-ups yet.</p></div><% } %><% topUps.forEach((topup)=>{ %><div><span class="transaction-icon credit"><svg><use href="#i-plus"></use></svg></span><div><strong>Wallet top-up</strong><small><%= topup.providerPaymentMethod||'Pesapal' %> · <%= topup.status.replaceAll('_',' ') %> · <%= formatDate(topup.createdAt) %></small></div><b class="<%= topup.status==='succeeded'?'credit-text':'' %>"><%= topup.status==='succeeded'?'+':'' %><%= formatMoney(topup.amountMinor,topup.currency) %></b></div><% }) %></div></section>
    <section class="panel content-panel"><div class="section-heading"><h2>Payment Methods</h2><a class="plain-link" href="/dashboard/support">Help</a></div><div class="payment-card"><span><svg><use href="#i-card"></use></svg></span><div><strong>Pesapal secure checkout</strong><small>Cards &amp; Mobile Money · Provider-hosted</small></div><span class="round-small"><svg><use href="#i-shield"></use></svg></span></div><div class="secure-note"><svg><use href="#i-shield"></use></svg><p><strong>Payments protected</strong><br>Your payment credentials are entered with the payment provider and are not stored directly by Classic Mart.</p></div></section>
  </div>
</section>
<% } %>

<% if(pageId==='returns'){ const returnable=pageData.returnableLines||[]; const returns=pageData.returns||[]; const refunds=pageData.refunds||[]; const active=returns.filter(item=>!/completed|rejected|cancelled/i.test(String(item.status||''))).length; const completedRefunds=refunds.filter(item=>/completed|succeeded|paid/i.test(String(item.status||''))).length; %>
<section class="app-page active" data-page="returns">
  <div class="page-heading"><div><span class="eyebrow">After-sales care</span><h1>Returns &amp; Refunds</h1><p>Start an eligible return and follow existing requests.</p></div><a class="primary-button icon-button" href="#returnForm"><svg><use href="#i-refresh"></use></svg>Start a Return</a></div>
  <div class="summary-grid three"><article class="summary-card panel"><span class="stat-icon blue"><svg><use href="#i-box"></use></svg></span><div><small>Eligible Items</small><strong><%= returnable.length %></strong><p>Within return window</p></div></article><article class="summary-card panel"><span class="stat-icon yellow"><svg><use href="#i-clock"></use></svg></span><div><small>Active Requests</small><strong><%= active %></strong><p>In progress</p></div></article><article class="summary-card panel"><span class="stat-icon green"><svg><use href="#i-check"></use></svg></span><div><small>Completed Refunds</small><strong><%= completedRefunds %></strong><p>Verified refund records</p></div></article></div>
  <div class="two-column-page return-layout"><section class="panel content-panel"><div class="section-heading"><h2>Your Returns</h2><span class="muted-label"><%= returns.length %> requests</span></div><div class="return-timeline"><% if(!returns.length){ %><div class="empty-state"><p>No return requests yet.</p></div><% } %><% returns.forEach((item)=>{ %><div class="<%= /completed/i.test(String(item.status||''))?'complete':'active' %>"><span><svg><use href="#i-refresh"></use></svg></span><div><strong><%= item.publicId %> · <%= String(item.status||'requested').replaceAll('_',' ') %></strong><small><%= String(item.reason||'return').replaceAll('_',' ') %> · <%= item.resolution %></small></div></div><% }) %></div><div class="policy-box"><svg><use href="#i-shield"></use></svg><div><strong>Protected return workflow</strong><p>Eligibility, quantities and policy windows are checked by the server.</p></div></div></section><section class="panel content-panel"><h2>Items Eligible for Return</h2><div class="eligible-list"><% if(!returnable.length){ %><div class="empty-state"><p>No delivered items are currently eligible.</p></div><% } %><% returnable.forEach((line)=>{ %><article class="return-product"><span class="stat-icon blue"><svg><use href="#i-box"></use></svg></span><div><strong><%= line.title %></strong><small>Order <%= line.orderPublicId %> · up to <%= line.remaining %></small></div><div class="card-actions"><a class="soft-button" href="#returnForm">Return Item</a></div></article><% }) %></div><% if(returnable.length){ %><form id="returnForm" class="dashboard-form" method="post" action="/account/returns"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/dashboard/returns"><label>Item<select name="returnLine" required><% returnable.forEach(line=>{ %><option value="<%= line.orderPublicId %>::<%= line.orderLineId %>"><%= line.title %> · max <%= line.remaining %></option><% }) %></select></label><div class="form-row"><label>Quantity<input type="number" name="quantity" value="1" min="1" required></label><label>Resolution<select name="resolution"><option value="refund">Refund</option><option value="exchange">Exchange</option></select></label></div><label>Reason<select name="reason"><option value="damaged">Damaged</option><option value="wrong_item">Wrong item</option><option value="not_as_described">Not as described</option><option value="counterfeit_suspected">Counterfeit suspected</option><option value="missing_parts">Missing parts</option><option value="changed_mind">Changed mind</option><option value="other">Other</option></select></label><label>Return method<select name="returnMethod"><option value="dropoff">Drop off</option><option value="pickup">Pickup</option></select></label><label>Details<textarea name="details" minlength="10" maxlength="2000" required></textarea></label><button class="primary-button full-button" type="submit">Submit Return</button></form><% } %></section></div>
</section>
<% } %>

<% if(pageId==='support'){ const tickets=pageData.tickets||[]; const knowledge=pageData.knowledge||[]; %>
<section class="app-page active" data-page="support">
  <div class="page-heading"><div><span class="eyebrow">We are here to help</span><h1>Support Centre</h1><p>Find answers, create a ticket, or follow up on an existing issue.</p></div></div>
  <div class="stats-grid support-category-grid"><article class="support-category stat-card panel"><div class="stat-top"><span class="stat-icon blue"><svg><use href="#i-truck"></use></svg></span><div><small>Support topic</small><strong>Order &amp; Delivery</strong></div></div><p>Tracking, delays and delivery questions</p></article><article class="support-category stat-card panel"><div class="stat-top"><span class="stat-icon purple"><svg><use href="#i-wallet"></use></svg></span><div><small>Support topic</small><strong>Payment &amp; Wallet</strong></div></div><p>Payments, refunds and balance</p></article><article class="support-category stat-card panel"><div class="stat-top"><span class="stat-icon green"><svg><use href="#i-refresh"></use></svg></span><div><small>Support topic</small><strong>Return &amp; Refund</strong></div></div><p>Return policy and refund status</p></article><article class="support-category stat-card panel"><div class="stat-top"><span class="stat-icon orange"><svg><use href="#i-shield"></use></svg></span><div><small>Support topic</small><strong>Account &amp; Security</strong></div></div><p>Profile and account questions</p></article></div>
  <div class="two-column-page support-layout"><section class="panel form-panel"><div class="section-heading"><h2>Create Support Ticket</h2><span class="response-time">Secure support</span></div><form class="dashboard-form" method="post" action="/account/support"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/dashboard/support"><div class="form-row"><label>Category<select name="category"><% ['order','payment','delivery','return','refund','account','product','seller','other'].forEach(value=>{ %><option value="<%= value %>"><%= value %></option><% }) %></select></label><label>Order<select name="orderId"><option value="">No order</option><% (pageData.orders||[]).forEach(order=>{ %><option value="<%= order.publicId %>"><%= order.publicId %></option><% }) %></select></label></div><label>Subject<input name="subject" minlength="4" maxlength="180" required></label><label>Priority<select name="priority"><option value="normal">Normal</option><option value="low">Low</option><option value="high">High</option><option value="urgent">Urgent</option></select></label><label>Message<textarea name="message" minlength="10" maxlength="2000" required></textarea></label><button class="primary-button full-button" type="submit">Submit Support Ticket</button></form></section><section class="panel content-panel"><div class="section-heading"><h2>My Tickets</h2><span class="muted-label"><%= tickets.length %> tickets</span></div><div class="ticket-list"><% if(!tickets.length){ %><div class="empty-state"><p>No support tickets yet.</p></div><% } %><% tickets.forEach((ticket)=>{ %><article><span class="ticket-icon"><svg><use href="#i-message"></use></svg></span><div><strong><%= ticket.subject %></strong><small><%= ticket.publicId %> · <%= ticket.category %></small><details class="faq-item"><summary>Messages &amp; actions</summary><% (ticket.notes||[]).filter(note=>note.internal===false).forEach(note=>{ %><p><%= note.message %></p><small><%= formatDate(note.at) %></small><% }) %><% if(['resolved','closed'].includes(ticket.status)){ %><form class="dashboard-form" method="post" action="/account/support/<%= ticket.publicId %>/csat"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/dashboard/support"><label>How was your support?<select name="rating"><% [5,4,3,2,1].forEach(rating=>{ %><option value="<%= rating %>"><%= rating %> / 5</option><% }) %></select></label><label>Feedback<textarea name="comment" maxlength="1000"></textarea></label><button class="soft-button" type="submit">Send Feedback</button></form><% if(!ticket.resolvedAt||Date.now()-new Date(ticket.resolvedAt).getTime()<=30*86400000){ %><form class="dashboard-form" method="post" action="/account/support/<%= ticket.publicId %>/reopen"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/dashboard/support"><label>Why do you need more help?<textarea name="message" minlength="3" maxlength="2000" required></textarea></label><button class="soft-button" type="submit">Reopen Ticket</button></form><% } %><% } %></details></div><span class="status-pill <%= /resolved|closed/i.test(String(ticket.status))?'delivered':'processing' %>"><%= ticket.status %></span></article><% }) %></div><div class="faq-block"><h3>Popular Help</h3><% knowledge.slice(0,4).forEach((item)=>{ %><details class="faq-item"><summary><%= item.title %></summary><p><%= String(item.body).slice(0,300) %><%= String(item.body).length>300?'…':'' %></p></details><% }) %></div></section></div>
</section>
<% } %>

<% if(pageId==='profile'){ const profileParts=[user.name,user.email,user.phone,user.shoppingCountry||user.country,user.locale]; const completion=Math.round(profileParts.filter(Boolean).length/profileParts.length*100); %>
<section class="app-page active" data-page="profile">
  <div class="page-heading"><div><span class="eyebrow">Account preferences</span><h1>Profile Settings</h1><p>Keep your personal details, security, and communication preferences up to date.</p></div><a class="outline-button icon-button" href="/account/profile"><svg><use href="#i-eye"></use></svg>View Account</a></div>
  <div class="profile-layout">
    <aside class="panel profile-summary"><div class="profile-avatar-wrap"><img src="/approved-dashboard/assets/avatar.svg" alt="<%= user.name %>"><a href="/account/profile" aria-label="Change profile photo"><svg><use href="#i-edit"></use></svg></a></div><h2><%= user.name %></h2><p><%= user.email %></p><span class="member-pill"><svg><use href="#i-crown"></use></svg>Classic Mart Customer</span><div class="profile-completion"><div><span>Profile completion</span><strong><%= completion %>%</strong></div><div><span style="width:<%= completion %>%"></span></div></div><nav class="settings-nav"><button class="active" type="button" data-settings-tab="personal">Personal Information</button><a href="/account/security">Password &amp; Security</a><a href="/dashboard/categories">Shopping Preferences</a><a href="/dashboard/notifications">Communication</a></nav></aside>
    <section class="panel form-panel settings-content active" data-settings-panel="personal"><div class="section-heading"><h2>Personal Information</h2><span class="verified-label"><svg><use href="#i-check"></use></svg>Verified account</span></div><form class="dashboard-form save-form" method="post" action="/account/profile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/dashboard/profile"><div class="form-row"><label>Full name<input name="name" value="<%= user.name %>" maxlength="120" required></label><label>Email address<input value="<%= user.email %>" disabled></label></div><div class="form-row"><label>Phone number<input name="phone" value="<%= user.phone %>" maxlength="30" required></label><label>Shopping country<select name="country"><% (pageData.countries||[]).forEach(country=>{ %><option value="<%= country.code %>" <%= country.code===(user.shoppingCountry||user.country)?'selected':'' %>><%= country.name %></option><% }) %></select></label></div><input type="hidden" name="currency" value="<%= user.currency %>"><div class="form-row"><label>Language<select name="locale"><option value="en-UG" <%= user.locale==='en-UG'?'selected':'' %>>English (Uganda)</option><option value="en-KE" <%= user.locale==='en-KE'?'selected':'' %>>English (Kenya)</option><option value="en-US" <%= user.locale==='en-US'?'selected':'' %>>English (International)</option></select></label><label>Currency<input value="<%= user.currency %>" disabled></label></div><label>Shopping preferences<div class="choice-grid"><label><input type="checkbox" checked disabled> Marketplace recommendations</label><label><input type="checkbox" checked disabled> Local availability</label><label><input type="checkbox" name="marketing" <%= user.consents?.marketing?'checked':'' %>> Offers &amp; promotions</label><label><input type="checkbox" checked disabled> Order updates</label></div></label><button class="primary-button" type="submit">Save Changes</button></form><div class="security-setting"><span class="transaction-icon credit"><svg><use href="#i-shield"></use></svg></span><div><strong>Password &amp; Security</strong><small>Manage password, MFA and active sessions in the Security Centre.</small></div><a class="outline-button" href="/account/security">Manage</a></div></section>
  </div>
</section>
<% } %>

<% if(pageId==='categories'){ const categories=pageData.categories||[]; const featured=pageData.featuredProducts||[]; %>
<section class="app-page active" data-page="categories">
  <div class="page-heading"><div><span class="eyebrow">Explore Classic Mart</span><h1>Shop by Category</h1><p>Browse live categories and discover products available in your marketplace.</p></div><a class="outline-button icon-button" href="/search"><svg><use href="#i-search"></use></svg>Search Products</a></div>
  <div class="category-grid"><% categories.forEach((category)=>{ %><a class="category-card" href="/categories?category=<%= encodeURIComponent(category.id) %>"><span><% if(category.image){ %><img src="<%= category.image %>" alt="<%= category.name %>"><% } else { %><svg><use href="#i-grid"></use></svg><% } %></span><strong><%= category.name %></strong><small><%= category.count||0 %> products</small></a><% }) %><% if(!categories.length){ %><div class="panel empty-state"><p>No active categories are available yet.</p></div><% } %></div>
  <section class="panel content-panel"><div class="section-heading"><h2>Recommended for You</h2><a class="plain-link" href="/categories">View More</a></div><div class="product-grid compact-products"><% featured.forEach((product)=>{ const oldPrice=Number(product.oldPrice||0); const price=Number(product.price||0); %><article class="product-card"><div class="product-image"><a href="/product/<%= encodeURIComponent(product.id) %>"><img src="<%= product.image %>" alt="<%= product.name %>"></a><a class="heart-button" href="/product/<%= encodeURIComponent(product.id) %>" aria-label="View <%= product.name %>"><svg><use href="#i-heart"></use></svg></a></div><div class="product-info"><small><%= product.categoryName||'Marketplace' %></small><h3><%= product.name %></h3><div class="rating">★ <%= Number(product.rating||0).toFixed(1) %> <span>(<%= Number(product.reviews||0) %>)</span></div><div class="product-price"><strong><%= product.currency %> <%= price.toLocaleString() %></strong><% if(oldPrice>price){ %><del><%= product.currency %> <%= oldPrice.toLocaleString() %></del><% } %></div><button class="primary-button full-button" data-cart-add data-product="<%= product.id %>" data-variant="<%= product.variantId %>">Add to Cart</button></div></article><% }) %></div></section>
</section>
<% } %>

<% if(pageId==='cart'){ const cart=pageData.cart||{items:[],totals:{}}; const items=cart.items||[]; const cartWallet=pageData.wallet||{}; %>
<section class="app-page active" data-page="cart">
  <div class="page-heading"><div><span class="eyebrow">Ready to order</span><h1>Shopping Cart</h1><p>Review quantities, delivery details, and savings before checkout.</p></div><a class="outline-button icon-button" href="/dashboard/categories"><svg><use href="#i-arrow-right"></use></svg>Continue Shopping</a></div>
  <div class="cart-layout">
    <section class="panel content-panel"><div class="section-heading"><h2>Your Items <span class="title-count"><%= items.length %></span></h2><button class="plain-link" type="button" data-cart-clear <%= items.length?'':'disabled' %>>Clear Cart</button></div><div class="cart-list" id="cartList"><% if(!items.length){ %><div class="empty-state"><p>Your cart is empty. <a href="/dashboard/categories">Start shopping</a>.</p></div><% } %><% items.forEach((item)=>{ %><article class="cart-item"><img src="<%= item.image %>" alt="<%= item.name %>"><div class="cart-item-info"><small>Product</small><h3><%= item.name %></h3><p><%= item.variant %></p><a href="/dashboard/wishlist">Move to wishlist</a></div><div class="quantity"><button data-cart-qty="<%= item.variantId %>" data-quantity="<%= Math.max(1,item.quantity-1) %>"><svg><use href="#i-minus"></use></svg></button><strong><%= item.quantity %></strong><button data-cart-qty="<%= item.variantId %>" data-quantity="<%= item.quantity+1 %>"><svg><use href="#i-plus"></use></svg></button></div><strong class="cart-price"><%= formatMoney(item.priceMinor*item.quantity,item.currency) %></strong><button class="trash-button" data-cart-remove="<%= item.variantId %>" aria-label="Remove item"><svg><use href="#i-trash"></use></svg></button></article><% }) %></div><div class="delivery-note"><svg><use href="#i-truck"></use></svg><div><strong>Delivery at checkout</strong><p>Available delivery methods, delivery fees and any free-shipping benefit are confirmed securely during checkout.</p></div></div></section>
    <aside class="panel checkout-card"><h2>Order Summary</h2><div class="coupon-row"><input id="cartPromotionCode" maxlength="40" placeholder="Promotion code" value="<%= (cart.promotionCodes||[])[0]||'' %>"><button type="button" data-cart-promo>Apply</button></div><div class="summary-lines"><div><span>Subtotal</span><strong id="cartSubtotal"><%= formatMoney(cart.totals?.subtotalMinor||0,cart.totals?.currency||user.currency) %></strong></div><div><span>Delivery</span><strong class="free-text">At checkout</strong></div><div><span>Discount</span><strong id="cartDiscount">−<%= formatMoney(cart.totals?.discountMinor||0,cart.totals?.currency||user.currency) %></strong></div></div><div class="checkout-total"><span>Total</span><strong id="cartTotal"><%= formatMoney(cart.totals?.totalMinor||0,cart.totals?.currency||user.currency) %></strong></div><a class="primary-button full-button" href="/checkout">Proceed to Checkout</a><div class="secure-checkout"><svg><use href="#i-shield"></use></svg><span>Secure checkout and buyer protection</span></div><div class="wallet-use"><div><strong>Use Classic Wallet</strong><small>Available balance: <span id="checkoutWallet"><%= formatMoney(cartWallet.balanceMinor||0,cartWallet.currency||user.currency) %></span></small></div><label class="switch" title="Choose Classic Wallet as the payment method during checkout"><input type="checkbox" disabled><span></span></label></div></aside>
  </div>
</section>
<% } %>

<% if(pageId==='notifications'){ const notifications=pageData.notifications||[]; %>
<section class="app-page active" data-page="notifications">
  <div class="page-heading"><div><span class="eyebrow">Stay updated</span><h1>Notifications</h1><p>Order, wishlist, offers and account updates in one place.</p></div><form method="post" action="/dashboard/notifications/read-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="outline-button icon-button" type="submit"><svg><use href="#i-check"></use></svg>Mark All as Read</button></form></div>
  <div class="notification-layout"><section class="panel content-panel"><div class="notification-tabs"><button class="active" type="button" data-notification-filter="all">All</button><button type="button" data-notification-filter="order">Orders</button><button type="button" data-notification-filter="offer">Offers</button><button type="button" data-notification-filter="account">Account</button></div><div class="notification-list" id="notificationList"><% if(!notifications.length){ %><div class="empty-state"><p>No notifications yet.</p></div><% } %><% notifications.forEach((notification,index)=>{ %><article data-notification-type="<%= notification.type %>" class="<%= notification.readAt?'':'unread' %>"><span class="notification-icon <%= ['blue','pink','green','orange','purple'][index%5] %>"><svg><use href="#i-bell"></use></svg></span><div><strong><%= notification.title %></strong><p><%= notification.body %></p><small><%= formatDate(notification.createdAt) %></small><% if(notification.href){ %><a href="<%= notification.href %>">Open</a><% } %></div><% if(!notification.readAt){ %><form method="post" action="/dashboard/notifications/<%= notification.publicId %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Mark read</button></form><% } %></article><% }) %></div></section><aside class="panel content-panel notification-settings"><h2>Notification Settings</h2><p>Choose the account updates you want to receive.</p><form method="post" action="/dashboard/notifications/preferences"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="preference-list"><% [['orders','Order updates'],['wishlist','Wishlist alerts'],['offers','Offers'],['club','Classic Club']].forEach(([key,label])=>{ %><label><div><strong><%= label %></strong></div><span class="switch"><input type="checkbox" name="<%= key %>" <%= pageData.preferences?.[key]?'checked':'' %>><span></span></span></label><% }) %></div><button class="primary-button full-button" type="submit">Save Settings</button></form></aside></div>
</section>
<% } %>

<% if(pageId==='club'){ const c=pageData.club; const current=c.current||c.tiers?.[0]||{}; %>
<section class="app-page active" data-page="club">
  <div class="page-heading"><div><span class="eyebrow">Classic Club</span><h1>Your Membership</h1><p>Enjoy better rewards, member-only offers, and priority shopping benefits.</p></div><a class="outline-button icon-button" href="/dashboard/rewards"><svg><use href="#i-award"></use></svg>View Rewards</a></div>
  <section class="club-page-hero"><div><span class="club-tier-icon"><svg><use href="#i-crown"></use></svg></span><div><small>Current tier</small><h2><%= current.label %> Member</h2><p><%= c.points %> available reward points</p></div></div><div class="club-goal"><div><span><%= c.next?`Progress to ${c.next.label}`:'Highest tier' %></span><strong><%= formatMoney(c.spendMinor,user.currency) %><%= c.next?` / ${formatMoney(c.next.minSpendMinor,user.currency)}`:'' %></strong></div><div class="club-goal-bar"><span style="width:<%= c.progressPercent %>%"></span></div><p><%= c.next?`Shop for ${formatMoney(c.remainingMinor,user.currency)} more to reach ${c.next.label}.`:'You have reached the highest Classic Club tier.' %></p></div></section>
  <div class="benefit-grid"><article class="benefit-card panel"><span class="quick-icon blue"><svg><use href="#i-truck"></use></svg></span><h3>Delivery Benefit</h3><p><%= current.freeDeliveryMinor===null?'No free-delivery threshold is configured.':`Free standard delivery from ${formatMoney(current.freeDeliveryMinor,user.currency)}.` %></p><strong><%= c.policyConfigured?'Country policy':'Not configured' %></strong></article><article class="benefit-card panel"><span class="quick-icon pink"><svg><use href="#i-tag"></use></svg></span><h3>Reward Rate</h3><p>Earn <%= current.pointsPerTenThousand %> point(s) per <%= formatMoney(10000,user.currency) %> of eligible spend.</p><strong><%= c.policyConfigured?'Country policy':'Not configured' %></strong></article><article class="benefit-card panel"><span class="quick-icon green"><svg><use href="#i-refresh"></use></svg></span><h3>Return Policy</h3><p><%= current.returnDays===null?'Return policy is not configured.':`Return eligible purchases within ${current.returnDays} days of verified delivery.` %></p><strong><%= c.policyConfigured?'Country policy':'Not configured' %></strong></article><article class="benefit-card panel locked"><span class="quick-icon purple"><svg><use href="#i-support"></use></svg></span><h3>Priority Support</h3><p>Submit a ticket and follow its status in your support dashboard.</p><strong>View support</strong></article></div>
  <section class="panel content-panel"><div class="section-heading"><h2>Compare Membership Tiers</h2><span class="muted-label">Current country policy</span></div><div class="tier-table"><div class="tier-row tier-head"><span>Tier</span><strong>Points / 10,000</strong><strong>Return window</strong><strong>Free delivery threshold</strong></div><% c.tiers.forEach(t=>{ %><div class="tier-row"><span><%= t.label %></span><strong><%= t.pointsPerTenThousand %></strong><strong><%= t.returnDays===null?'Not configured':`${t.returnDays} days` %></strong><strong><%= t.freeDeliveryMinor===null?'Not configured':formatMoney(t.freeDeliveryMinor,user.currency) %></strong></div><% }) %></div></section>
</section>
<% } %>
