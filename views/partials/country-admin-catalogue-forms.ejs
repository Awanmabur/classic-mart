<%
const catalogue = countryAdminFlow;
const selected = catalogue.selected;
const detail = selected?.type === 'product' ? selected.productFlow : selected?.reviewFlow;
const item = selected?.type === 'product' ? detail.product : detail?.record;
const productCase = selected?.type === 'product';
const basePath = productCase ? '/admin/products/' : '/admin/seller-approvals/';
const casePath = item ? basePath + encodeURIComponent(item.publicId) : '';
const assignee = item?.assignment === 'unassigned' ? null : item?.assignment;
const assignedToMe = item?.assignment === 'mine';
const firstReviewer = productCase && item?.firstReviewOwn;
const scopeSuffix = '?' + new URLSearchParams({ country: catalogue.country || '' });
const actionable = item && (productCase ? item.status === 'submitted' && detail.store.status === 'verified' : ['submitted','appealed'].includes(item.status) && detail.store.status === 'pending_verification');
const statusLabel = value => String(value || '').replaceAll('_',' ');
const assignmentLabelLocal = value => ({mine:'Assigned to you',other:'Assigned to another reviewer',unassigned:'Unassigned'})[value] || 'Unassigned';
%>
<% if (item) { %>
<section class="panel role-form-section moderation-catalogue-detail" id="moderation-case">
  <div class="role-panel-head compact"><div><span class="eyebrow"><%= productCase ? 'Product evidence' : 'Seller evidence' %></span><h2><%= productCase ? item.title : detail.store.name %></h2><p class="form-intro"><%= detail.store.country %> · <%= statusLabel(item.status) %> · <%= item.publicId %></p></div><a class="plain-link" href="<%= productCase ? '/admin/products' : '/admin/seller-approvals' %>">Close case</a></div>
  <div class="role-form-grid">
  <% if (productCase) { const attributes = item.attributes instanceof Map ? Object.fromEntries(item.attributes) : item.attributes || {}; %>
    <label>Seller<input readonly value="<%= detail.store.name %>"></label><label>Category<input readonly value="<%= detail.category?.name || 'Category unavailable' %>"></label>
    <label>Brand<input readonly value="<%= detail.brand?.name || 'No brand' %>"></label><label>Assignment<input readonly value="<%= assignedToMe ? 'Assigned to you' : assignee ? 'Assigned to another reviewer' : 'Unassigned' %>"></label>
    <label class="wide">Product description<textarea readonly rows="6"><%= item.description %></textarea></label><label class="wide">Tags<input readonly value="<%= (item.tags || []).join(', ') %>"></label>
    <% for (const attribute of detail.category?.attributes || []) { %><label><%= attribute.label %><input readonly value="<%= attributes[attribute.key] ?? '' %>"></label><% } %>
    <% if (item.videoUrl) { %><label class="wide">Product video URL<input readonly value="<%= item.videoUrl %>"></label><% } %>
  <% } else { %>
    <label>Legal name<input readonly value="<%= item.legalName %>"></label><label>Seller type<input readonly value="<%= item.sellerType %>"></label>

    <label class="wide">Assignment<input readonly value="<%= assignedToMe ? 'Assigned to you' : assignee ? 'Assigned to another reviewer' : 'Unassigned' %>"></label>
  <% } %>
  </div>
  <% if (item.appeal?.message) { %><p class="form-intro"><strong>Seller appeal:</strong> <%= item.appeal.message %></p><% } %>
  <% if (item.reviewReason || item.moderation?.reason) { %><p class="form-intro"><strong>Previous decision reason:</strong> <%= item.reviewReason || item.moderation.reason %></p><% } %>
  <% if (productCase && item.moderation?.secondReviewRequired) { %><p class="form-intro"><%= item.moderation.firstApprovalRecorded ? 'First approval recorded. A different independent reviewer must complete approval.' : 'This product requires two independent approvals.' %></p><% } %>
  <% if (actionable) { %><form class="seller-verification-actions" method="post" action="<%= casePath %>/<%= assignedToMe ? 'release' : 'claim' %><%= scopeSuffix %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= item.version %>"><button class="outline-button" type="submit" <%= !assignedToMe && (assignee || firstReviewer) ? 'disabled' : '' %>><%= assignedToMe ? productCase ? 'Release Product' : 'Release Case' : productCase ? 'Claim Product' : 'Claim Case' %></button></form><% } %>
</section>
<% if (productCase) { %>
<section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Variants and pricing</h2><p>Recorded SKU, selling price and fulfilment details.</p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Variant</th><th>SKU</th><th>Price</th><th>Compare-at</th><th>Weight</th><th>Status</th></tr></thead><tbody>
<% for (const variant of detail.variants || []) { %><tr><td data-label="Variant"><%= variant.title %></td><td data-label="SKU"><%= variant.sku %></td><td data-label="Price"><%= formatMoney(variant.priceMinor,variant.currency) %></td><td data-label="Compare-at"><%= variant.compareAtMinor == null ? 'Not set' : formatMoney(variant.compareAtMinor,variant.currency) %></td><td data-label="Weight"><%= variant.weightGrams %> g</td><td data-label="Status"><%= variant.active ? 'Active' : 'Inactive' %></td></tr><% } %>
<% if (!(detail.variants || []).length) { %><tr><td colspan="6">No variants are recorded.</td></tr><% } %></tbody></table></div></section>
<section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Product images</h2><p>Current listing media.</p></div></div><div class="role-form-grid seller-product-media-grid"><% for (const image of detail.media || []) { %><article class="seller-product-media-card"><a href="/media/catalogue/<%= encodeURIComponent(image.publicId) %>" target="_blank" rel="noopener noreferrer"><img class="seller-product-image" src="/media/catalogue/<%= encodeURIComponent(image.publicId) %>" alt="<%= image.altText || item.title %>" loading="lazy" decoding="async"></a><p class="form-intro"><%= image.altText || 'No image description' %> · <%= statusLabel(image.status) %></p></article><% } %><% if (!(detail.media || []).length) { %><p class="form-intro">No images are recorded.</p><% } %></div></section>
<section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Stock and fulfilment</h2><p>Available quantities exclude reserved, damaged and quarantined stock.</p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Variant</th><th>Warehouse</th><th>On hand</th><th>Reserved</th><th>Available</th></tr></thead><tbody><% for (const stock of detail.stocks || []) { %><tr><td data-label="Variant"><%= stock.sku %></td><td data-label="Warehouse"><%= stock.warehouse %></td><td data-label="On hand"><%= stock.onHand %></td><td data-label="Reserved"><%= stock.reserved %></td><td data-label="Available"><%= stock.available %></td></tr><% } %><% if (!(detail.stocks || []).length) { %><tr><td colspan="5">No stock is recorded.</td></tr><% } %></tbody></table></div><% if (detail.stockHasMore) { %><p class="form-intro">The first 200 stock records are shown. Additional records exist.</p><% } %></section>
<% } else { %>
<section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Current evidence</h2><p>Private documents for this verification. Sensitive identifiers remain in the original evidence.</p></div></div><% for (const document of detail.documents || []) { %><article class="role-security-row"><div><strong><%= document.documentType %></strong><small><%= document.status %></small></div><a class="outline-button" href="<%= casePath %>/documents/<%= encodeURIComponent(document.publicId) %><%= scopeSuffix %>" target="_blank" rel="noopener noreferrer">View Document</a></article><% } %><% if (!(detail.documents || []).length) { %><p class="form-intro">No current documents are recorded.</p><% } %></section>
<% } %>
<% if (actionable && assignedToMe) { %>
<form class="panel role-form-section" method="post" action="<%= casePath %>/decision<%= scopeSuffix %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= item.version %>"><div class="role-panel-head compact"><div><h2>Independent decision</h2><p><%= productCase ? 'Approval keeps the product private until the seller publishes it.' : 'Confirm that every required document belongs to this seller.' %> Rejection requires a clear reason of at least 10 characters.</p></div></div><div class="role-form-grid"><label class="wide">Decision reason<textarea name="reason" rows="4" maxlength="1000"><%= detail.draft?.reason || '' %></textarea></label></div><div class="seller-verification-actions"><button class="primary-button" type="submit" name="decision" value="approve"><%= productCase && item.moderation?.secondReviewRequired && !item.moderation?.firstApprovalRecorded ? 'Record First Approval' : productCase ? 'Approve Product' : 'Approve Verification' %></button><% if (productCase) { %><button class="outline-button" type="submit" name="decision" value="changes">Request Changes</button><% } %><button class="outline-button" type="submit" name="decision" value="reject"><%= productCase ? 'Reject Product' : 'Reject Verification' %></button></div></form>
<% } %>
<section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Review history</h2><p>Recorded actions for this case.</p></div></div><% const history = productCase ? item.moderation?.reviewHistory || [] : item.reviewHistory || []; for (const entry of history) { %><p class="form-intro"><strong><%= statusLabel(entry.action) %></strong> · <%= formatDate(entry.at) %><% if (entry.reason) { %> · <%= entry.reason %><% } %></p><% } %><% if (!history.length) { %><p class="form-intro">No review actions are recorded.</p><% } %></section>
<% } %>

<% if (selected && ['promoter','customer','category','brand','review'].includes(selected.type || selected.kind)) {
const kind = selected.type || selected.kind;
const record = selected.record;
const savedDraft = selected.draft || {};
const base = ({promoter:'/admin/promoter-approvals',customer:'/admin/customers',category:'/admin/categories',brand:'/admin/categories',review:'/admin/reviews'})[kind];
const suffix = '?' + new URLSearchParams({country: catalogue.country || '',...(kind === 'brand' ? {type:'brands'} : kind === 'category' ? {type:'categories'} : {})});
const actionPath = base + '/' + encodeURIComponent(record.publicId);
const assignmentState = typeof record.assignment === 'string' ? record.assignment : record.assignment?.state || selected.assignment;
const mine = assignmentState === 'mine';
const actionableRecord = kind === 'promoter' ? selected.actionable !== false && ['submitted','appealed'].includes(record.status) : selected.canAct;
const title = record.name || record.title || record.publicId;
%>
<section class="panel role-form-section" id="country-admin-record">
  <div class="role-panel-head compact"><div><span class="eyebrow"><%= statusLabel(kind) %> source</span><h2><%= title %></h2><p class="form-intro"><%= kind === 'customer' ? (typeof dashboardDisplay === 'function' ? dashboardDisplay(record.publicId, { column: 'Customer', columns: ['Name'], row: { cells: [record.name] } }) : record.name || 'Account holder') : record.publicId %> · <%= record.country || selected.affectedCountries?.join(', ') || 'Shared catalogue' %><% if (record.status) { %> · <%= statusLabel(record.status) %><% } %></p></div><a class="plain-link" href="<%= base + suffix %>">Close record</a></div>
  <% if (selected.error) { %><p class="flash error platform-flash" role="alert"><%= selected.error %></p><% } %>
  <div class="role-form-grid">
  <% if (kind === 'promoter') { %>
    <label>Programme country<input readonly value="<%= record.country %>"></label><label>Audience size<input readonly value="<%= record.audienceSize %>"></label>
    <label class="wide">Channels<textarea readonly rows="3"><%= (record.channels || []).join('\n') %></textarea></label><label class="wide">Niches<input readonly value="<%= (record.niches || []).join(', ') %>"></label>
    <label class="wide">Audience location<input readonly value="<%= record.audienceLocation || 'Not recorded' %>"></label><label>Disclosure accepted<input readonly value="<%= record.disclosureAcceptedAt ? formatDate(record.disclosureAcceptedAt) : 'Not recorded' %>"></label>
    <label>Assignment<input readonly value="<%= assignmentLabelLocal(assignmentState) %>"></label>
  <% } else if (kind === 'customer') { %>
    <label>Name<input readonly value="<%= record.name %>"></label><label>Registration country<input readonly value="<%= record.country %>"></label><label>Email verification<input readonly value="<%= record.emailVerified || record.emailVerifiedAt ? 'Verified by the account owner' : 'Pending account-owner verification' %>"></label><label>Joined<input readonly value="<%= formatDate(record.createdAt) %>"></label>
  <% } else if (kind === 'review') { %>
    <label>Delivered order<input readonly value="<%= selected.order.publicId %>"></label><label>Product<input readonly value="<%= selected.product.title %>"></label><label>Store<input readonly value="<%= selected.store.name %>"></label><label>Rating<input readonly value="<%= record.rating %> / 5"></label><label class="wide">Verified purchase review<textarea readonly rows="5"><%= record.body %></textarea></label><label class="wide">Assignment<input readonly value="<%= assignmentLabelLocal(assignmentState) %>"></label>
  <% } else { %>
    <label>Name<input readonly value="<%= record.name %>"></label><label>Slug<input readonly value="<%= record.slug %>"></label><label class="wide">Affected countries<input readonly value="<%= (selected.affectedCountries || []).join(', ') || 'Global' %>"></label>
  <% } %>
  </div>
  <% if (record.appeal?.message) { %><p class="form-intro"><strong>Promoter appeal:</strong> <%= record.appeal.message %></p><% } %>
  <% if (record.reason || record.moderationReason) { %><p class="form-intro"><strong>Recorded decision:</strong> <%= record.reason || record.moderationReason %></p><% } %>
  <% if (record.disputeReason) { %><p class="form-intro"><strong>Seller dispute:</strong> <%= record.disputeReason %></p><% } %>
  <% if (selected.independenceReason || selected.readOnlyReason) { %><p class="form-intro"><%= selected.independenceReason || selected.readOnlyReason %></p><% } %>
  <% if (['promoter','review'].includes(kind) && actionableRecord) { %>
    <form class="seller-verification-actions" method="post" action="<%= actionPath %>/<%= mine ? 'release' : 'claim' %><%= suffix %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= record.version %>"><button class="outline-button" type="submit" <%= !mine && assignmentState !== 'unassigned' ? 'disabled' : '' %>><%= mine ? 'Release Record' : 'Claim Record' %></button></form>
  <% } %>
</section>
<% if (['promoter','review'].includes(kind) && actionableRecord && mine) { %>
<form class="panel role-form-section" method="post" action="<%= actionPath %>/<%= kind === 'promoter' ? 'decision' : 'publish' %><%= suffix %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= record.version %>"><div class="role-panel-head compact"><div><h2>Independent decision</h2><p>Record a clear reason for the programme applicant or the affected customer and seller.</p></div></div><div class="role-form-grid"><label class="wide">Decision reason<textarea name="reason" rows="4" minlength="10" maxlength="500" required><%= savedDraft.reason || '' %></textarea></label></div><div class="seller-verification-actions"><% if (kind === 'promoter') { %><button class="primary-button" type="submit" name="decision" value="approve">Verify Promoter</button><button class="outline-button" type="submit" name="decision" value="reject">Reject Verification</button><% } else { %><button class="primary-button" type="submit">Publish Review</button><button class="outline-button" type="submit" formaction="<%= actionPath %>/reject<%= suffix %>">Reject Review</button><% } %></div></form>
<% if (kind === 'review') { %><form class="panel role-form-section" method="post" action="<%= actionPath %>/reply<%= suffix %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= record.version %>"><div class="role-panel-head compact"><div><h2>Public reply</h2><p>This saved message is visible to the customer and affected seller.</p></div></div><label>Message<textarea name="message" rows="3" minlength="3" maxlength="1000" required><%= savedDraft.message || '' %></textarea></label><div class="seller-verification-actions"><button class="outline-button" type="submit">Send Public Reply</button></div></form><% } %>
<% } %>
<% if (kind === 'customer' && ['active','suspended'].includes(record.status) && selected.actionable !== false) { %>
<form class="panel role-form-section" method="post" action="<%= actionPath %>/<%= record.status === 'active' ? 'suspend' : 'reactivate' %><%= suffix %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= record.version %>"><div class="role-panel-head compact"><div><h2><%= record.status === 'active' ? 'Suspend account' : 'Reactivate account' %></h2><p>Account access changes revoke existing browser and mobile sessions. The customer completes their own identity verification.</p></div></div><label>Reason<textarea name="reason" rows="4" minlength="10" maxlength="500" required><%= savedDraft.reason || '' %></textarea></label><div class="seller-verification-actions"><button class="primary-button" type="submit"><%= record.status === 'active' ? 'Suspend Customer' : 'Reactivate Customer' %></button></div></form>
<% } %>
<% if (['category','brand'].includes(kind) && selected.canEdit) { %>
<form class="panel role-form-section" method="post" action="<%= actionPath %>/update<%= suffix %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= record.version %>"><div class="role-panel-head compact"><div><h2>Update <%= kind %></h2><p>Every affected market is authorized again when this change is saved.</p></div></div><div class="role-form-grid"><label>Name<input name="name" minlength="2" maxlength="100" required value="<%= savedDraft.name ?? record.name %>"></label><label>Slug<input name="slug" minlength="2" maxlength="100" required value="<%= savedDraft.slug ?? record.slug %>"></label>
<% if (kind === 'category') { %><label class="wide">Description<textarea name="description" rows="3" maxlength="500"><%= savedDraft.description ?? record.description %></textarea></label><label>Visibility<select name="active"><option value="yes" <%= (savedDraft.active ? savedDraft.active === 'yes' : record.active) ? 'selected' : '' %>>Active</option><option value="no" <%= (savedDraft.active ? savedDraft.active !== 'yes' : !record.active) ? 'selected' : '' %>>Inactive</option></select></label><label>Restricted policy<select name="restricted"><option value="no" <%= (savedDraft.restricted ? savedDraft.restricted === 'no' : !record.restricted) ? 'selected' : '' %>>Standard</option><option value="yes" <%= (savedDraft.restricted ? savedDraft.restricted === 'yes' : record.restricted) ? 'selected' : '' %>>Restricted</option></select></label><label class="wide">Countries<input name="countries" maxlength="100" required value="<%= savedDraft.countries ?? record.countries.join(', ') %>"></label><label class="wide">Attributes<textarea name="attributes" rows="8" maxlength="2000"><%= savedDraft.attributes ?? JSON.stringify(record.attributes || [], null, 2) %></textarea><small>JSON entries with key, label, type, required and options.</small></label><% } else { %><label>Status<select name="status"><% for (const value of ['pending','approved','rejected']) { %><option value="<%= value %>" <%= (savedDraft.status || record.status) === value ? 'selected' : '' %>><%= statusLabel(value) %></option><% } %></select></label><% } %>
<label class="wide">Change reason<textarea name="reason" rows="3" minlength="3" maxlength="1000" required><%= savedDraft.reason || '' %></textarea></label></div><div class="seller-verification-actions"><button class="primary-button" type="submit">Save <%= kind === 'category' ? 'Category' : 'Brand' %></button></div></form>
<% } %>
<% if ((record.publicMessages || []).length || (record.reviewHistory || record.decisionHistory || []).length) { %><section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Recorded history</h2><p>Persisted decisions and public messages.</p></div></div><% for (const message of record.publicMessages || []) { %><p class="form-intro"><strong><%= statusLabel(message.author) %></strong> · <%= formatDate(message.at) %> · <%= message.message %></p><% } %><% for (const entry of record.reviewHistory || record.decisionHistory || []) { %><p class="form-intro"><strong><%= statusLabel(entry.action) %></strong> · <%= formatDate(entry.at) %><% if (entry.reason) { %> · <%= entry.reason %><% } %></p><% } %></section><% } %>
<% } %>
