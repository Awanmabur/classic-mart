<% if (typeof initialProfile !== 'undefined' && initialProfile) { (initialProfile.products || []).slice(0,9).forEach(product => { %><article class="profile-product"><a href="/products/<%= encodeURIComponent(product.id) %>?country=<%= country.code %>"><img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" decoding="async"/></a><div><h3><%= product.name %></h3><strong><%= new Intl.NumberFormat(country.locale || 'en', {style:'currency',currency:product.currency}).format(product.price) %></strong></div></article><% }); } %>
