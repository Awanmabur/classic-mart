<% if (typeof productMeta !== 'undefined' && productMeta) { %>
<div class="product-preview-layout"><div class="product-preview-gallery"><img src="<%= productMeta.images?.[0] || productMeta.image %>" alt="<%= productMeta.imageAlt || productMeta.name %>" decoding="async"/></div><div class="product-preview-details"><h1 id="productModalTitle"><%= productMeta.name %></h1><p id="productModalDescription"><%= productMeta.description %></p><strong><%= new Intl.NumberFormat(country.locale || 'en', {style:'currency',currency:productMeta.currency}).format(productMeta.price) %></strong><p><%= productMeta.stock > 0 ? productMeta.stock + ' in stock' : 'Out of stock' %></p><p>Sold by <a href="/sellers/<%= encodeURIComponent(productMeta.seller.slug) %>?country=<%= country.code %>"><%= productMeta.seller.name %></a></p><h2>Product options</h2><% (productMeta.variants || []).forEach(variant => { %><article class="preview-variant-detail"><h3><%= variant.title %></h3><p><%= variant.currency %> <%= variant.price %> · <%= variant.stock > 0 ? variant.stock + ' in stock' : 'Out of stock' %></p><dl><dt>SKU</dt><dd><%= variant.sku %></dd><% Object.entries(variant.options || {}).forEach(([name,value]) => { %><dt><%= name %></dt><dd><%= value %></dd><% }); %></dl></article><% }); %><% if (Object.keys(productMeta.attributes || {}).length) { %><h2>Specifications</h2><dl><% Object.entries(productMeta.attributes).forEach(([name,value]) => { %><dt><%= name %></dt><dd><%= value %></dd><% }); %></dl><% } %><a href="/products?country=<%= country.code %>">Browse marketplace products</a></div></div>
<% } %>
