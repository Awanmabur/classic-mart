<%
const flow = pageFlow;
const pageHref = flow.baseHref || sellerPage.href;
const metrics = flow.metrics || [];
const insights = flow.insights || [];
const workflow = flow.workflow || [];
const health = flow.health || {};
const healthValue = Number.isFinite(health.value) ? Math.max(0, Math.min(100, Math.round(health.value))) : null;
const filters = flow.filters || {};
const page = flow.page || {};
const statusTone = value => /^(active|healthy|published|completed|delivered|approved|resolved|fulfilled|available|paid)$/i.test(String(value)) ? 'good' : /^(rejected|failed|expired|cancelled|critical|out of stock)$/i.test(String(value)) ? 'bad' : 'warn';
const localHref = value => typeof value === 'string' && (/^\/(?:seller|account|notifications)(?:\/|\?|$)/.test(value) || /^#[a-zA-Z0-9_-]+$/.test(value)) && !/[\\\u0000-\u001f]/.test(value) ? value : pageHref;
const filterParams = Object.entries(filters.params || {}).filter(([key, value]) => /^[a-zA-Z][a-zA-Z0-9_-]{0,30}$/.test(key) && typeof value === 'string' && value.length <= 100);
const pageLink = after => { const query = new URLSearchParams(filterParams); if (filters.search) query.set('search', filters.search); if (filters.status) query.set('status', filters.status); if (after) query.set('after', after); return pageHref + (query.size ? '?' + query : ''); };
%>
<section class="app-page active role-page seller-standard-live seller-fidelity-page" data-page="<%= sellerPage.id %>" data-role="seller" data-page-kind="<%= sellerPage.kind %>">
  <div class="page-heading role-page-heading"><div><span class="eyebrow"><%= sellerPage.eyebrow %></span><h1><%= sellerPage.title %></h1><p><%= sellerPage.description %></p></div><% if (flow.create) { %><a class="primary-button icon-button" href="<%= localHref(flow.create.href) %>"><svg aria-hidden="true"><use href="#i-plus"></use></svg><%= flow.create.label %></a><% } %></div>
  <% if (flow.error) { %><p class="server-flash error platform-flash" role="alert"><%= flow.error %></p><% } %>
  <section class="role-metric-grid"><% for (const [index, metric] of metrics.entries()) { %><article class="role-metric panel"><span class="role-metric-icon tone-<%= index % 4 + 1 %>"><svg aria-hidden="true"><use href="#<%= ['i-eye','i-clipboard','i-wallet','i-award'][index % 4] %>"></use></svg></span><div><small><%= metric.label %></small><strong><%= metric.value %></strong><span><%= metric.detail || '' %></span></div></article><% } %></section>
  <div class="role-content-grid">
    <div class="role-side-stack">
      <% if (flow.trend) { const maximum = Math.max(1, ...flow.trend.map(row => Math.max(0, Number(row.value || 0)))); %><section class="panel role-chart-panel"><div class="role-panel-head"><div><h2>Performance trend</h2><p><%= flow.trendDescription || 'Recorded store results for this reporting period.' %></p></div><% if (flow.kind === 'analytics') { const periods = [['7months', 'Last 7 months'], ['30days', 'Last 30 days'], ['year', 'This year']]; %><form class="role-table-tools" method="get" action="<%= pageHref %>"><label class="sr-only" for="sellerAnalyticsPeriod">Chart period</label><select id="sellerAnalyticsPeriod" name="period" required><% for (const [value, label] of periods) { %><option value="<%= value %>" <%= value === (flow.period || '7months') ? 'selected' : '' %>><%= label %></option><% } %></select><button class="plain-link" type="submit">Apply</button></form><% } %></div><div class="role-chart" aria-label="Store performance bar chart"><% for (const bucket of flow.trend) { %><div><span style="height:<%= Math.max(0, Math.round(Math.max(0, Number(bucket.value || 0)) / maximum * 100)) %>%"><b><%= bucket.display || bucket.value %></b></span><small><%= bucket.label %></small></div><% } %></div><div class="role-chart-legend"><span><i></i> Recorded sales</span><strong><%= flow.trendSummary || '' %></strong></div></section><% } %>
      <section class="panel role-table-panel" id="<%= flow.kind === 'inventory' ? 'inventory-records' : 'seller-records' %>">
        <div class="role-panel-head"><div><h2><%= flow.tableTitle || sellerPage.title + ' records' %></h2><p><%= flow.tableDescription || 'Current records for your store.' %></p></div><div class="role-table-tools">
          <% if (flow.filters) { %><form class="seller-compact-filter" method="get" action="<%= pageHref %>"><% for (const [key, value] of filterParams) { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% } %><% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %><label class="role-mini-search"><svg aria-hidden="true"><use href="#i-search"></use></svg><input type="search" name="search" value="<%= filters.search || '' %>" maxlength="100" placeholder="Filter records" aria-label="Filter records"></label><button class="plain-link" type="submit">Search</button></form><% } %>
          <% if (flow.exportHref) { %><a class="outline-button role-export" href="<%= localHref(flow.exportHref) %>"><svg aria-hidden="true"><use href="#i-download"></use></svg>Export</a><% } %>
        </div></div>
        <% if (filters.statuses?.length) { %><nav class="role-status-tabs seller-record-tabs" aria-label="Record status"><% for (const status of filters.statuses) { const query = new URLSearchParams(filterParams); if (status.value) query.set('status', status.value); if (filters.search) query.set('search', filters.search); %><a class="<%= String(filters.status || '') === status.value ? 'active' : '' %>" href="<%= pageHref + (query.size ? '?' + query : '') %>" <%= String(filters.status || '') === status.value ? 'aria-current=page' : '' %>><%= status.label %></a><% } %></nav><% } %>
        <div class="role-table-wrap"><table class="role-table"><thead><tr><% for (const column of flow.columns || []) { %><th><%= column %></th><% } %><th>Action</th></tr></thead><tbody>
        <% for (const row of flow.rows || []) { %><tr><% for (const [index, cell] of (row.cells || []).entries()) { %><td data-label="<%= flow.columns[index] || 'Value' %>"><% if (index === row.cells.length - 1 && /status|state/i.test(flow.columns[index] || '')) { %><span class="role-status <%= statusTone(cell) %>"><%= cell %></span><% } else { %><span><%= cell %></span><% } %></td><% } %><td data-label="Action"><% if (row.href) { %><a class="role-row-menu seller-record-action" href="<%= localHref(row.href) %>" aria-label="Open <%= row.cells?.[0] || row.id %>">•••</a><% } else { %><span aria-label="No action required">—</span><% } %></td></tr><% } %>
        <% if (!(flow.rows || []).length) { %><tr><td colspan="<%= (flow.columns || []).length + 1 %>"><%= flow.emptyText || 'No records match this view yet.' %></td></tr><% } %>
        </tbody></table></div>
        <div class="role-table-footer"><span><%= (flow.rows || []).length %> records on this page<%= Number.isFinite(page.total) ? ' · ' + page.total + ' total' : '' %></span><div><% if (filters.after) { %><a class="plain-link" href="<%= pageLink('') %>">First</a><% } else { %><button disabled type="button">Previous</button><% } %><span class="seller-page-control active" aria-current="page">Current</span><% if (page.next || page.hasMore) { %><a class="plain-link" href="<%= flow.pagination?.nextHref || pageLink(page.next || page.cursor) %>">Next</a><% } else { %><button disabled type="button">Next</button><% } %></div></div>
      </section>
      <% if (flow.kind === 'specialist') { %><%- include('specialist-order-case-forms') %><% } else if (flow.kind === 'team') { %><%- include('seller-team-forms') %><% } else if (flow.kind === 'affiliate') { %><%- include('seller-affiliate-forms') %><% } else if (flow.kind === 'policy-cases') { %><%- include('seller-policy-case-forms') %><% } else if (['business-quotes','business-orders'].includes(flow.kind)) { %><%- include('seller-business-forms') %><% } else if (flow.kind === 'promoter-conversation') { %><%- include('seller-promoter-conversation') %><% } else if (flow.kind === 'inventory') { %><%- include('seller-inventory-forms') %><% } else if (flow.kind === 'relationships') { %><%- include('seller-relationship-forms') %><% } else if (flow.kind === 'finance') { %><%- include('seller-finance-forms') %><% } else if (flow.kind === 'growth') { %><%- include('seller-growth-forms') %><% } %>
    </div>
    <aside class="role-side-stack">
      <section class="panel role-insights"><div class="role-panel-head compact"><div><span class="eyebrow">Decision support</span><h2>What needs attention</h2></div></div><div class="role-insight-list"><% for (const [index, insight] of insights.entries()) { %><article><span><%= index + 1 %></span><p><%= typeof insight === 'string' ? insight : insight.text %></p></article><% } %></div><% if (insights.find(item => item.href)) { const recommendation = insights.find(item => item.href); %><a class="soft-button full-button" href="<%= localHref(recommendation.href) %>"><%= recommendation.label || 'Review recommendations' %></a><% } %></section>
      <section class="panel role-progress-card"><div class="role-panel-head compact"><div><span class="eyebrow">Performance</span><h2><%= health.label || 'Workspace health' %></h2></div><strong><%= healthValue === null ? '—' : healthValue + '%' %></strong></div><div class="role-health-ring"><span><%= healthValue === null ? '—' : healthValue %><% if (healthValue !== null) { %><small>%</small><% } %></span></div><div class="role-health-rows"><% for (const row of health.rows || []) { %><div><span><%= row.label %></span><b><%= row.value %></b></div><% } %></div></section>
    </aside>
  </div>
  <section class="panel role-activity-panel"><div class="role-panel-head"><div><h2>Workflow &amp; recent activity</h2><p>Keep the team aligned on the next operational actions.</p></div><% if (flow.activityHref) { %><a class="plain-link" href="<%= localHref(flow.activityHref) %>">View all activity</a><% } %></div><div class="role-workflow-grid"><% for (const [index, item] of workflow.entries()) { %><article><span class="role-step <%= index === 0 ? 'current' : '' %>"><%= index + 1 %></span><div><strong><%= item.title %></strong><p><%= item.text %></p></div><% if (item.href) { %><a class="plain-link" href="<%= localHref(item.href) %>"><%= item.label || 'Continue' %></a><% } %></article><% } %></div></section>
</section>
