<% const policyCase = flow.selected; if (policyCase) { %><section class="panel role-form-section" id="sellerPolicyCase"><div class="role-panel-head compact"><div><span class="eyebrow">Private policy review</span><h2><%= policyCase.publicId %></h2><p><%= policyCase.type.replaceAll('_', ' ') %> · <%= policyCase.status %></p></div></div><p class="form-intro"><strong>Policy concern:</strong> <%= policyCase.description %></p><% if (policyCase.decision) { %><p class="form-intro"><strong>Moderation decision:</strong> <%= policyCase.decision %></p><% } %><% for (const entry of policyCase.publicMessages) { %><p class="form-intro"><%= entry.message %></p><% } %>
<% if (policyCase.canRespond || policyCase.canAppeal) { %><form class="role-create-form" method="post" action="/seller/trust-cases/<%= policyCase.publicId %>/respond"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= policyCase.version %>"><div class="role-create-grid"><label class="role-create-field">Response type<select name="action"><% if (policyCase.canRespond) { %><option value="response">Case response</option><option value="correction">Correction completed</option><% } else { %><option value="appeal">Request independent appeal</option><% } %></select></label><label class="role-create-field wide">Message<textarea name="message" rows="4" minlength="10" maxlength="2000" required></textarea></label></div><div class="role-create-actions"><button class="primary-button" type="submit"><%= policyCase.canAppeal ? 'Submit independent appeal' : 'Save private response' %></button></div></form><% } %>
<% if (policyCase.canRespond) { %><form class="role-create-form" method="post" enctype="multipart/form-data" action="/seller/trust-cases/<%= policyCase.publicId %>/evidence"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= policyCase.version %>"><div class="role-create-grid"><label class="role-create-field wide">Evidence description<input name="description" minlength="3" maxlength="300" required></label><label class="role-create-field wide">Private image<input name="document" type="file" accept="image/jpeg,image/png,image/webp,image/avif" required></label></div><div class="role-create-actions"><button class="outline-button" type="submit">Attach private evidence</button></div></form><% } %>
<% for (const evidence of policyCase.evidence) { %><article class="role-security-row"><div><strong><%= evidence.description || evidence.publicId %></strong><small><%= formatDate(evidence.createdAt) %></small></div><a class="outline-button" href="/seller/trust-cases/evidence/<%= evidence.publicId %>" target="_blank" rel="noopener noreferrer">View evidence</a></article><% } %><% for (const entry of policyCase.responses) { %><article class="role-security-row"><div><strong><%= entry.action %></strong><small><%= formatDate(entry.at) %></small><p><%= entry.message %></p></div></article><% } %></section><% } %>
