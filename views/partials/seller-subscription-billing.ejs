<section class="panel role-form-section" id="sellerSubscriptionBilling"><div class="role-panel-head compact"><div><span class="eyebrow">Verified billing</span><h2>Payment and renewal</h2></div></div><p class="form-intro">An approved request fixes the price and plan limits. Pesapal must verify payment before paid benefits begin. Renewals add a separate paid period.</p>
<% for (const change of growth.reviewedRequests || []) { %><% if (['requested', 'approved'].includes(change.status)) { %><form method="post" action="/seller/subscription/requests/<%= change.publicId %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= change.version %>"><button class="outline-button" type="submit">Cancel <%= change.planName %> request</button></form><% } %><% if (change.status === 'approved' && change.terms) { %><form class="role-create-form" method="post" action="/seller/subscription/payments"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestPublicId" value="<%= change.publicId %>"><input type="hidden" name="version" value="<%= change.version %>"><input type="hidden" name="idempotencyKey" value="<%= change.paymentKey %>"><p class="form-intro"><strong><%= change.planName %></strong> · <%= formatMoney(change.terms.priceMinor, growth.currency) %> / <%= change.terms.cadence %> · <%= change.terms.entitlements.productLimit %> products · <%= change.terms.entitlements.seatLimit %> seats · <%= change.terms.entitlements.campaignLimit %> campaigns</p><div class="role-create-actions"><button class="primary-button" type="submit"><%= change.terms.priceMinor ? 'Pay or renew with Pesapal' : 'Activate approved plan' %></button></div></form><% } %><% } %>
<% for (const charge of growth.charges || []) { %><h3><%= charge.planName %> · <%= charge.status %></h3><p class="form-intro"><%= formatMoney(charge.amountMinor, charge.currency) %> · <%= charge.publicId %><% if (charge.holdReason) { %> · <%= charge.holdReason %><% } %></p><div class="role-create-actions"><% if (charge.checkoutUrl && charge.status === 'requires_action') { %><a class="primary-button" href="<%= charge.checkoutUrl %>">Continue payment</a><% } %><% if (charge.canCheck) { %><form method="post" action="/seller/subscription/payments/<%= charge.publicId %>/reconcile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="outline-button" type="submit">Check payment</button></form><% } %><% if (charge.status === 'held' && charge.canCheck && growth.canAuthorizeHeldActivation) { %><form class="role-create-form" method="post" action="/seller/subscription/payments/<%= charge.publicId %>/reconcile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= charge.version %>"><input type="hidden" name="authorizeActivation" value="true"><label class="role-create-field">Reason for authorizing this held payment<input name="reason" minlength="10" maxlength="300" required></label><button class="outline-button" type="submit">Authorize activation and verify payment</button></form><% } %><% if (!charge.canCheck && charge.status === 'held') { %><p class="form-intro">The provider tracking reference needs independent Super Admin reconciliation before another payment.</p><% } %></div><% } %><% if (growth.chargesPage?.next) { %><a class="plain-link" href="/seller/subscription?chargesAfter=<%= encodeURIComponent(growth.chargesPage.next) %>">Next payments</a><% } %></section>
<section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Paid periods</h2><p>Cancellation takes effect at the end of each paid period.</p></div></div><% for (const enrollment of growth.enrollments || []) { %><h3><%= enrollment.planName %> · <%= enrollment.status %></h3><p class="form-intro"><%= formatDate(enrollment.startsAt) %> – <%= enrollment.endsAt ? formatDate(enrollment.endsAt) : 'No expiry' %></p><% if (enrollment.status === 'active' && enrollment.endsAt && !enrollment.cancelAtPeriodEnd) { %><form method="post" action="/seller/subscription/enrollments/<%= enrollment.publicId %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= enrollment.version %>"><button class="outline-button" type="submit">Cancel at period end</button></form><% } else if (enrollment.cancelAtPeriodEnd) { %><p class="form-intro">Cancellation is scheduled for the end of this period.</p><% } %><% } %><% if (growth.enrollmentsPage?.next) { %><a class="plain-link" href="/seller/subscription?enrollmentsAfter=<%= encodeURIComponent(growth.enrollmentsPage.next) %>">Next periods</a><% } %></section>
