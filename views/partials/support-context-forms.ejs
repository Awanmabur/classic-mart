<% const contextFlow = supportFlow; const safeSupportRecord = contextFlow.selected; %>
<% if (contextFlow.pageId === 'support-customers' && safeSupportRecord) { %>
<section class="panel role-form-section" aria-labelledby="support-customer-heading">
  <div class="role-panel-head"><h2 id="support-customer-heading">Customer context</h2><span class="role-status"><%= safeSupportRecord.status.replaceAll('_', ' ') %></span></div>
  <div class="role-form-grid">
    <div><span>Customer</span><strong><%= safeSupportRecord.publicId %></strong></div><div><span>Name</span><strong><%= safeSupportRecord.name %></strong></div>
    <div><span>Email</span><strong><%= safeSupportRecord.emailMasked || 'Unavailable' %></strong></div><div><span>Phone</span><strong><%= safeSupportRecord.phoneMasked || 'Unavailable' %></strong></div>
    <div><span>Scoped orders</span><strong><%= safeSupportRecord.orderCount %></strong></div><div><span>Scoped cases</span><strong><%= safeSupportRecord.ticketCount %></strong></div>
  </div>
  <% if (contextFlow.contactDisclosure) { const disclosed = contextFlow.contactDisclosure; %>
  <div class="role-form-grid"><div><span>Case authorized email</span><strong><%= disclosed.email %></strong></div><div><span>Case authorized phone</span><strong><%= disclosed.phone %></strong></div><p class="wide form-intro">Access recorded for case <%= disclosed.ticketPublicId %>. Contact details are shown only in this response.</p></div>
  <% } %>
  <% const eligibleContactCases = safeSupportRecord.cases.filter(item => item.canRevealContact); if (eligibleContactCases.length && !contextFlow.contactDisclosure) { %>
  <form method="post" action="/support/customers/<%= encodeURIComponent(safeSupportRecord.publicId) %>/contact<%= contextFlow.country ? '?country=' + contextFlow.country : '' %>" class="role-form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label><span>Assigned case</span><select name="ticketId" required><% for (const ticket of eligibleContactCases) { %><option value="<%= ticket.publicId %>"><%= ticket.publicId %> · <%= ticket.subject %></option><% } %></select></label>
    <% for (const ticket of eligibleContactCases) { %><input type="hidden" name="version:<%= ticket.publicId %>" value="<%= ticket.version %>"><% } %>
    <label class="wide"><span>Contact access purpose</span><textarea name="reason" minlength="10" maxlength="500" required rows="2"></textarea></label>
    <div class="wide"><button class="primary-button" type="submit">Access case contact</button></div>
  </form>
  <% } %>
  <div class="role-panel-head"><h3>Recent orders in this scope</h3></div>
  <div class="role-form-grid"><% for (const order of safeSupportRecord.orders) { %><div><a class="plain-link" href="/support/orders?record=<%= encodeURIComponent(order.publicId) %>&amp;country=<%= order.country %>"><%= order.publicId %></a><p><%= order.country %> · <%= formatMoney(order.totalMinor, order.currency) %> · <%= order.fulfillmentState.replaceAll('_', ' ') %></p></div><% } %><% if (!safeSupportRecord.orders.length) { %><p class="wide form-intro">No orders recorded in this scope.</p><% } %></div>
  <div class="role-panel-head"><h3>Recent support cases</h3></div>
  <div class="role-form-grid"><% for (const ticket of safeSupportRecord.cases) { %><div><a class="plain-link" href="/support/queue?record=<%= encodeURIComponent(ticket.publicId) %>&amp;country=<%= ticket.country %>"><%= ticket.publicId %></a><p><%= ticket.subject %> · <%= ticket.status.replaceAll('_', ' ') %></p></div><% } %><% if (!safeSupportRecord.cases.length) { %><p class="wide form-intro">No cases recorded in this scope.</p><% } %></div>
</section>
<% } else if (contextFlow.pageId === 'support-orders' && safeSupportRecord) { %>
<section class="panel role-form-section" aria-labelledby="support-order-heading">
  <div class="role-panel-head"><h2 id="support-order-heading">Order context</h2><span class="role-status"><%= safeSupportRecord.status.replaceAll('_', ' ') %></span></div>
  <div class="role-form-grid">
    <div><span>Order</span><strong><%= safeSupportRecord.publicId %></strong></div><div><span>Market and total</span><strong><%= safeSupportRecord.country %> · <%= formatMoney(safeSupportRecord.totalMinor, safeSupportRecord.currency) %></strong></div>
    <div><span>Payment</span><strong><%= safeSupportRecord.paymentState.replaceAll('_', ' ') %></strong></div><div><span>Fulfilment</span><strong><%= safeSupportRecord.fulfillmentState.replaceAll('_', ' ') %></strong></div>
    <div><span>Cancellation</span><strong><%= safeSupportRecord.cancellationState.replaceAll('_', ' ') %></strong></div><div><span>Return / refund</span><strong><%= safeSupportRecord.returnState.replaceAll('_', ' ') %> / <%= safeSupportRecord.refundState.replaceAll('_', ' ') %></strong></div>
  </div>
  <div class="role-panel-head"><h3>Purchased items</h3></div><div class="role-form-grid"><% for (const item of safeSupportRecord.items) { %><div><strong><%= item.title %></strong><p><%= item.quantity %> ordered · <%= item.deliveredQuantity %> delivered · <%= item.returnedQuantity %> returned · <%= item.refundedQuantity %> refunded</p></div><% } %></div>
  <div class="role-panel-head"><h3>Recorded payment checks</h3></div><div class="role-form-grid"><% for (const payment of safeSupportRecord.payments) { %><div><strong><%= payment.publicId %></strong><p><%= payment.provider %> · <%= payment.status.replaceAll('_', ' ') %> · <%= formatMoney(payment.amountMinor, payment.currency) %></p></div><% } %><% if (!safeSupportRecord.payments.length) { %><p class="wide form-intro">No payment record is available for this order.</p><% } %></div>
  <div class="role-panel-head"><h3>Shipments</h3></div><div class="role-form-grid"><% for (const shipment of safeSupportRecord.shipments) { %><div><strong><%= shipment.publicId %></strong><p><%= shipment.kind %> · <%= shipment.status.replaceAll('_', ' ') %></p></div><% } %><% if (!safeSupportRecord.shipments.length) { %><p class="wide form-intro">No shipment has been recorded.</p><% } %></div>
  <div class="role-panel-head"><h3>Returns and refunds</h3></div><div class="role-form-grid"><% for (const item of safeSupportRecord.returns) { %><div><a class="plain-link" href="/support/returns?record=<%= encodeURIComponent(item.publicId) %>&amp;country=<%= safeSupportRecord.country %>"><%= item.publicId %></a><p><%= item.status.replaceAll('_', ' ') %> · <%= item.resolution %></p></div><% } %><% for (const refund of safeSupportRecord.refunds) { %><div><strong><%= refund.publicId %></strong><p><%= refund.status.replaceAll('_', ' ') %> · <%= formatMoney(refund.amountMinor, refund.currency) %></p></div><% } %><% if (!safeSupportRecord.returns.length && !safeSupportRecord.refunds.length) { %><p class="wide form-intro">No returns or refunds have been recorded.</p><% } %></div>
  <div class="role-panel-head"><h3>Existing cases</h3></div><div class="role-form-grid"><% for (const ticket of safeSupportRecord.cases) { %><div><a class="plain-link" href="/support/queue?record=<%= encodeURIComponent(ticket.publicId) %>&amp;country=<%= safeSupportRecord.country %>"><%= ticket.publicId %></a><p><%= ticket.subject %> · <%= ticket.status.replaceAll('_', ' ') %></p></div><% } %></div>
  <% if (safeSupportRecord.canCreateCase) { %>
  <form method="post" action="/support/orders/<%= encodeURIComponent(safeSupportRecord.publicId) %>/cases<%= contextFlow.country ? '?country=' + contextFlow.country : '' %>" class="role-form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= safeSupportRecord.version %>">
    <label><span>Subject</span><input name="subject" minlength="3" maxlength="180" required></label>
    <label><span>Category</span><select name="category" required><% for (const category of ['order','payment','delivery','return','refund','other']) { %><option value="<%= category %>"><%= category[0].toUpperCase() + category.slice(1) %></option><% } %></select></label>
    <label><span>Priority</span><select name="priority"><% for (const priority of ['low','normal','high','urgent']) { %><option value="<%= priority %>" <%= priority === 'normal' ? 'selected' : '' %>><%= priority[0].toUpperCase() + priority.slice(1) %></option><% } %></select></label>
    <label class="wide"><span>Initial internal note</span><textarea name="message" minlength="10" maxlength="2000" required rows="3"></textarea></label>
    <p class="wide form-intro">The case belongs to the recorded order owner. Use the ticket queue to communicate with them. Payment, cancellation and warehouse actions retain their existing controls.</p>
    <div class="wide"><button class="primary-button" type="submit">Open support case</button></div>
  </form>
  <% } else { %><p class="form-intro">Guest requests use the verified public support intake form.</p><% } %>
</section>
<% } else if (contextFlow.pageId === 'support-reviews' && safeSupportRecord) { %>
<section class="panel role-form-section" aria-labelledby="support-review-heading">
  <div class="role-panel-head"><h2 id="support-review-heading">Review issue</h2><span class="role-status"><%= safeSupportRecord.status %></span></div>
  <div class="role-form-grid"><div><span>Review</span><strong><%= safeSupportRecord.publicId %></strong></div><div><span>Rating</span><strong><%= safeSupportRecord.rating %>/5</strong></div><div><span>Product</span><strong><%= safeSupportRecord.productPublicId %></strong></div><div><span>Purchase</span><strong><%= safeSupportRecord.verifiedPurchase ? 'Verified purchase' : 'Unverified' %></strong></div><div class="wide"><strong><%= safeSupportRecord.title %></strong><p><%= safeSupportRecord.body %></p></div>
    <% if (safeSupportRecord.disputeReason) { %><div class="wide"><span>Reported concern</span><p><%= safeSupportRecord.disputeReason %></p></div><% } %>
    <% if (safeSupportRecord.moderationReason) { %><div class="wide"><span>Moderation decision</span><p><%= safeSupportRecord.moderationReason %></p></div><% } %>
  </div>
  <% if (safeSupportRecord.issue) { const issue = safeSupportRecord.issue; %>
    <div class="role-form-grid"><div><span>Moderation case</span><strong><%= issue.publicId %></strong></div><div><span>Case status</span><strong><%= issue.status %></strong></div><div class="wide"><span>Recorded referral</span><p><%= issue.description %></p></div><% if (issue.decision) { %><div class="wide"><span>Recorded decision</span><p><%= issue.decision %></p></div><% } %><div class="wide"><a class="soft-button" href="/support/queue?record=<%= encodeURIComponent(issue.ticketPublicId) %>&amp;country=<%= safeSupportRecord.country %>">Open linked support case</a></div></div>
  <% } else if (safeSupportRecord.cases.length) { %>
    <form method="post" action="/support/reviews/<%= encodeURIComponent(safeSupportRecord.publicId) %>/escalate<%= contextFlow.country ? '?country=' + contextFlow.country : '' %>" class="role-form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= safeSupportRecord.version %>">
      <label><span>Assigned support case</span><select name="ticketId" required><% for (const ticket of safeSupportRecord.cases) { %><option value="<%= ticket.publicId %>"><%= ticket.publicId %> · <%= ticket.subject %></option><% } %></select></label>
      <label class="wide"><span>Review concern and known facts</span><textarea name="description" minlength="10" maxlength="2000" required rows="3"></textarea></label>
      <p class="wide form-intro">The linked case evidence is referred to moderation. Review publication and rejection remain moderation decisions.</p>
      <div class="wide"><button class="primary-button" type="submit">Refer to moderation</button></div>
    </form>
  <% } else { %><p class="form-intro">Claim an active support case for this order before referring the concern to moderation.</p><a class="soft-button" href="/support/orders?record=<%= encodeURIComponent(safeSupportRecord.orderPublicId) %>&amp;country=<%= safeSupportRecord.country %>">Open order context</a><% } %>
</section>
<% } %>
