<%
const flow = liveDeliveryOperations.flow, mode = flow.mode, selected = flow.selected;
const label = value => String(value || '').replaceAll('_', ' ').replace(/\b\w/g, value => value.toUpperCase());
const tone = value => ['approved','delivered','resolved'].includes(value) ? 'good' : ['rejected','suspended','failed'].includes(value) ? 'bad' : 'warn';
const base = '/warehouse/' + mode;
const nextParams = new URLSearchParams(); if (flow.filters.status) nextParams.set('status', flow.filters.status); if (flow.page.next) nextParams.set('after', flow.page.next);
%>
<section class="app-page active role-page warehouse-live-page" data-page="warehouse-<%= mode %>" data-role="warehouse">
  <div class="page-heading role-page-heading"><div><span class="eyebrow">Delivery operations</span><h1><%= mode === 'carriers' ? 'Carrier Verification' : 'Delivery Operations' %></h1><p><%= mode === 'carriers' ? 'Review private carrier evidence and grant collection permissions independently.' : 'Offer scoped shipments, confirm physical custody and review cash receipts for Finance.' %></p></div><a class="outline-button" href="/warehouse">Warehouse Overview</a></div>
  <% if (flow.error) { %><div class="panel dashboard-message dashboard-message-error platform-flash" role="alert"><%= flow.error %></div><% } %>
  <section class="panel role-form-section warehouse-live-section"><form method="get" action="<%= base %>" class="role-form-grid"><label>Status<select name="status"><% if (mode === 'deliveries') { %><option value="">All shipments</option><% } %><% for (const status of (mode === 'carriers' ? ['submitted','approved','rejected','suspended','draft'] : ['ready','offered','assigned','picked_up','in_transit','delivered','failed','rescheduled','return_to_sender','returned'])) { %><option value="<%= status %>" <%= flow.filters.status === status ? 'selected' : '' %>><%= label(status) %></option><% } %></select></label><div class="warehouse-live-actions"><button class="outline-button" type="submit">Apply Filter</button></div></form></section>
  <% if (mode === 'carriers') { %>
  <section class="panel role-table-panel warehouse-live-section"><div class="role-panel-head"><div><h2>Delivery Partners</h2><p>Only carriers in your active warehouse markets appear here.</p></div></div><div class="role-table-wrap"><table class="role-table"><caption class="sr-only">Carrier verification queue</caption><thead><tr><th>Carrier</th><th>Transport</th><th>Status</th><th>Review</th></tr></thead><tbody><% for (const carrier of flow.carriers) { %><tr><td data-label="Carrier"><strong><%= carrier.name %></strong><small class="warehouse-live-cell-note"><%= carrier.country %> · <%= carrier.publicId %></small></td><td data-label="Transport"><%= label(carrier.transport) %><small class="warehouse-live-cell-note"><%= carrier.vehicleLabel %></small></td><td data-label="Status"><span class="role-status <%= tone(carrier.verificationStatus) %>"><%= label(carrier.verificationStatus) %></span></td><td data-label="Review"><a class="outline-button" href="<%= base %>?record=<%= encodeURIComponent(carrier.publicId) %>">Review Carrier</a></td></tr><% } %><% if (!flow.carriers.length) { %><tr><td class="warehouse-live-empty" colspan="4">No carriers match this view.</td></tr><% } %></tbody></table></div></section>
  <% if (selected) { %><section class="panel role-form-section warehouse-live-section"><div class="role-panel-head"><div><h2><%= selected.name %></h2><p><%= selected.country %> · <%= label(selected.transport) %> · <%= selected.vehicleLabel %></p></div><span class="role-status <%= tone(selected.verificationStatus) %>"><%= label(selected.verificationStatus) %></span></div><p>Service areas: <%= selected.serviceAreas.join(', ') || 'Not provided' %></p><div class="warehouse-live-actions"><% for (const item of selected.evidence) { %><a class="outline-button" href="/warehouse/evidence/<%= encodeURIComponent(item.publicId) %>" target="_blank" rel="noopener"><%= label(item.documentType) %><span class="sr-only"> (opens a new tab)</span></a><% } %></div><% if (['submitted','approved'].includes(selected.verificationStatus)) { %><form class="role-form-grid warehouse-live-task-form" method="post" action="/warehouse/carriers/<%= encodeURIComponent(selected.publicId) %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selected.version %>"><label>Decision<select name="decision"><% for (const decision of (selected.verificationStatus === 'submitted' ? ['approve','reject'] : ['suspend'])) { %><option value="<%= decision %>"><%= label(decision) %></option><% } %></select></label><label>Cash collection permission<select name="codEnabled"><option value="false">No cash collection</option><option value="true">Approve cash collection</option></select></label><label class="wide">Review reason<textarea name="reason" maxlength="500" rows="3"></textarea></label><div class="wide warehouse-live-actions"><button class="primary-button" type="submit">Record Independent Review</button></div></form><% } %></section><% } %>
  <% } else { %>
  <section class="panel role-table-panel warehouse-live-section"><div class="role-panel-head"><div><h2>Scoped Shipments</h2><p>Every shipment is bound to its committed order allocation or approved return.</p></div></div><div class="role-table-wrap"><table class="role-table"><caption class="sr-only">Warehouse delivery queue</caption><thead><tr><th>Shipment</th><th>Service</th><th>Status</th><th>Due</th><th>Action</th></tr></thead><tbody><% for (const row of flow.shipments) { %><tr><td data-label="Shipment"><strong><%= row.publicId %></strong><small class="warehouse-live-cell-note"><%= row.orderPublicId %></small></td><td data-label="Service"><%= label(row.kind) %> · <%= label(row.mode) %></td><td data-label="Status"><span class="role-status <%= tone(row.status) %>"><%= label(row.status) %></span></td><td data-label="Due"><%= row.slaDueAt ? formatDate(row.slaDueAt) : 'No recorded SLA' %></td><td data-label="Action"><a class="outline-button" href="<%= base %>?record=<%= encodeURIComponent(row.publicId) %>">View Shipment</a></td></tr><% } %><% if (!flow.shipments.length) { %><tr><td class="warehouse-live-empty" colspan="5">No shipments match your warehouse scope.</td></tr><% } %></tbody></table></div></section>
  <% if (selected) { %>
  <section class="panel role-form-section warehouse-live-section"><div class="role-panel-head"><div><h2><%= selected.publicId %></h2><p><%= selected.orderPublicId %> · <%= label(selected.kind) %> · <%= label(selected.status) %></p></div></div><p><%= selected.warehouses.map(row => row.name).join(', ') %></p>
    <% if (selected.code) { %><div class="warehouse-live-record"><h3>Physical Custody Verification</h3><p><%= selected.codePurpose %></p><strong><%= selected.code %></strong></div><% } %>
    <% if (['ready','offered'].includes(selected.status)) { %><form class="role-form-grid warehouse-live-task-form" method="post" action="/warehouse/deliveries/<%= encodeURIComponent(selected.publicId) %>/offer"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selected.version %>"><div class="wide"><h3>Offer to an Approved Carrier</h3></div><label>Available carrier<select name="carrierPublicId" required><option value="">Choose a carrier</option><% for (const carrier of (flow.availableCarriers || []).filter(row => row.userId?.status === 'active' && row.userId.role === 'delivery' && row.userId.country === selected.country)) { %><option value="<%= carrier.publicId %>"><%= carrier.userId.name %> · <%= label(carrier.transport) %></option><% } %></select></label><label>Agreed earning (minor units)<input name="earningMinor" type="number" min="0" step="1" required></label><input type="hidden" name="currency" value="<%= selected.cod.currency %>"><div class="wide warehouse-live-actions"><button class="primary-button" type="submit">Create Delivery Offer</button></div></form><% } %>
    <% if (selected.cod.required) { %><article class="warehouse-live-task-form"><h3>Cash Handover</h3><p>Collected <%= formatMoney(selected.cod.collectedMinor, selected.cod.currency) %> · Declared <%= selected.cod.handoverDeclaredMinor === undefined ? 'Not recorded' : formatMoney(selected.cod.handoverDeclaredMinor, selected.cod.currency) %></p><p><%= selected.cod.reconciledAt ? 'Finance reconciled.' : selected.cod.reviewedAt ? 'Warehouse receipt reviewed. Finance reconciliation pending.' : selected.cod.mismatchExceptionPublicId ? 'Open amount mismatch must be resolved before receipt review.' : 'Awaiting independent receipt review.' %></p></article><% if (selected.cod.handoverAt && !selected.cod.mismatchExceptionPublicId && !selected.cod.reconciledAt) { %><form class="role-form-grid" method="post" action="/warehouse/deliveries/<%= encodeURIComponent(selected.publicId) %>/review-cod"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selected.version %>"><label class="wide">Physical receipt review<textarea name="reason" minlength="3" maxlength="500" required></textarea></label><div class="wide warehouse-live-actions"><button class="primary-button" type="submit">Confirm Cash Received</button></div></form><% } %><% } %>
    <div class="warehouse-live-task-form"><h3>Private Evidence</h3><div class="warehouse-live-actions"><% for (const evidence of selected.evidence) { %><a class="plain-link" href="/warehouse/evidence/<%= encodeURIComponent(evidence.publicId) %>" target="_blank" rel="noopener"><%= label(evidence.documentType) %> · <%= formatDate(evidence.createdAt) %><span class="sr-only"> (opens a new tab)</span></a><% } %><% if (!selected.evidence.length) { %><p>No evidence has been recorded.</p><% } %></div></div>
    <% for (const exception of selected.exceptions) { %><article class="warehouse-live-task-form"><h3><%= label(exception.reasonCode) %> · <%= label(exception.status) %></h3><p><%= exception.description %></p><% if (['open','investigating'].includes(exception.status)) { %><form class="role-form-grid" method="post" action="/warehouse/delivery-exceptions/<%= encodeURIComponent(exception.publicId) %>/resolve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= exception.__v || 0 %>"><label>Decision<select name="decision"><option value="resolve">Resolve</option><option value="dismiss">Dismiss</option></select></label><label>Resolution note<input name="resolutionNote" minlength="3" maxlength="600" required></label><div class="wide warehouse-live-actions"><button class="outline-button" type="submit">Record Exception Review</button></div></form><% } %></article><% } %>
    <div class="warehouse-live-task-form"><h3>Custody History</h3><ol><% for (const event of selected.timeline) { %><li><%= event.message %> <small><%= formatDate(event.at) %></small></li><% } %></ol></div>
  </section><% } %><% } %>
  <% if (flow.page.hasMore) { %><div class="warehouse-live-actions warehouse-live-section"><a class="outline-button" href="<%= base %>?<%= nextParams.toString() %>">Next Page</a></div><% } %>
</section>
