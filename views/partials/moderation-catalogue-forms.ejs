<%
const catalogue = moderationFlow;
const selected = catalogue.selected;
const detail = selected?.type === 'product' ? selected.productFlow : selected?.reviewFlow;
const item = selected?.type === 'product' ? detail.product : detail?.record;
const productCase = selected?.type === 'product';
const basePath = productCase ? '/moderation/products/' : '/moderation/verifications/';
const casePath = item ? basePath + encodeURIComponent(item.publicId) : '';
const assignee = item ? productCase ? item.moderation?.assignedUserId : item.assignedUserId : null;
const assignedToMe = String(assignee || '') === String(user._id);
const firstReviewer = productCase && item && String(item.moderation?.firstApprovalByUserId || '') === String(user._id);
const actionable = item && (productCase ? item.status === 'submitted' && detail.store.status === 'verified' : ['submitted','appealed'].includes(item.status) && detail.store.status === 'pending_verification');
const statusLabel = value => String(value || '').replaceAll('_',' ');
%>
<% if (item) { %>
<section class="panel role-form-section moderation-catalogue-detail" id="moderation-case">
  <div class="role-panel-head compact"><div><span class="eyebrow"><%= productCase ? 'Product evidence' : 'Seller evidence' %></span><h2><%= productCase ? item.title : detail.store.name %></h2><p class="form-intro"><%= detail.store.country %> · <%= statusLabel(item.status) %> · <%= item.publicId %></p></div><a class="plain-link" href="<%= productCase ? '/moderation/products' : '/moderation/verifications' %>">Close case</a></div>
  <div class="role-form-grid">
  <% if (productCase) { const attributes = item.attributes instanceof Map ? Object.fromEntries(item.attributes) : item.attributes || {}; %>
    <label>Seller<input readonly value="<%= detail.store.name %>"></label><label>Category<input readonly value="<%= detail.category?.name || 'Category unavailable' %>"></label>
    <label>Brand<input readonly value="<%= detail.brand?.name || 'No brand' %>"></label><label>Assignment<input readonly value="<%= assignedToMe ? 'Assigned to you' : assignee ? 'Assigned to another reviewer' : 'Unassigned' %>"></label>
    <label class="wide">Product description<textarea readonly rows="6"><%= item.description %></textarea></label><label class="wide">Tags<input readonly value="<%= (item.tags || []).join(', ') %>"></label>
    <% for (const attribute of detail.category?.attributes || []) { %><label><%= attribute.label %><input readonly value="<%= attributes[attribute.key] ?? '' %>"></label><% } %>
    <% if (item.videoUrl) { %><label class="wide">Product video URL<input readonly value="<%= item.videoUrl %>"></label><% } %>
  <% } else { %>
    <label>Legal name<input readonly value="<%= item.legalName %>"></label><label>Seller type<input readonly value="<%= item.sellerType %>"></label>
    <label>Registration number<input readonly value="<%= item.registrationNumber || 'Not supplied' %>"></label><label>Tax number<input readonly value="<%= item.taxNumber || 'Not supplied' %>"></label>
    <label class="wide">Assignment<input readonly value="<%= assignedToMe ? 'Assigned to you' : assignee ? 'Assigned to another reviewer' : 'Unassigned' %>"></label>
  <% } %>
  </div>
  <% if (item.appeal?.message) { %><p class="form-intro"><strong>Seller appeal:</strong> <%= item.appeal.message %></p><% } %>
  <% if (item.reviewReason || item.moderation?.reason) { %><p class="form-intro"><strong>Previous decision reason:</strong> <%= item.reviewReason || item.moderation.reason %></p><% } %>
  <% if (productCase && item.moderation?.secondReviewRequired) { %><p class="form-intro"><%= item.moderation.firstApprovalByUserId ? 'First approval recorded. A different independent reviewer must complete approval.' : 'This product requires two independent approvals.' %></p><% } %>
  <% if (actionable) { %><form class="seller-verification-actions" method="post" action="<%= casePath %>/<%= assignedToMe ? 'release' : 'claim' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= item.__v %>"><button class="outline-button" type="submit" <%= !assignedToMe && (assignee || firstReviewer) ? 'disabled' : '' %>><%= assignedToMe ? productCase ? 'Release Product' : 'Release Case' : productCase ? 'Claim Product' : 'Claim Case' %></button></form><% } %>
</section>
<% if (productCase) { %>
<section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Variants and pricing</h2><p>Recorded SKU, selling price and fulfilment details.</p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Variant</th><th>SKU</th><th>Price</th><th>Compare-at</th><th>Weight</th><th>Status</th></tr></thead><tbody>
<% for (const variant of detail.variants || []) { %><tr><td data-label="Variant"><%= variant.title %></td><td data-label="SKU"><%= variant.sku %></td><td data-label="Price"><%= formatMoney(variant.priceMinor,variant.currency) %></td><td data-label="Compare-at"><%= variant.compareAtMinor == null ? 'Not set' : formatMoney(variant.compareAtMinor,variant.currency) %></td><td data-label="Weight"><%= variant.weightGrams %> g</td><td data-label="Status"><%= variant.active ? 'Active' : 'Inactive' %></td></tr><% } %>
<% if (!(detail.variants || []).length) { %><tr><td colspan="6">No variants are recorded.</td></tr><% } %></tbody></table></div></section>
<section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Product images</h2><p>Current listing media.</p></div></div><div class="role-form-grid seller-product-media-grid"><% for (const image of detail.media || []) { %><article class="seller-product-media-card"><a href="/media/catalogue/<%= encodeURIComponent(image.publicId) %>" target="_blank" rel="noopener noreferrer"><img class="seller-product-image" src="/media/catalogue/<%= encodeURIComponent(image.publicId) %>" alt="<%= image.altText || item.title %>" loading="lazy" decoding="async"></a><p class="form-intro"><%= image.altText || 'No image description' %> · <%= statusLabel(image.status) %></p></article><% } %><% if (!(detail.media || []).length) { %><p class="form-intro">No images are recorded.</p><% } %></div></section>
<section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Stock and fulfilment</h2><p>Available quantities exclude reserved, damaged and quarantined stock.</p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Variant</th><th>Warehouse</th><th>On hand</th><th>Reserved</th><th>Available</th></tr></thead><tbody><% for (const stock of detail.stocks || []) { %><tr><td data-label="Variant"><%= (detail.variants || []).find(row => String(row._id) === String(stock.variantId))?.sku || 'Unavailable' %></td><td data-label="Warehouse"><%= (detail.warehouses || []).find(row => String(row._id) === String(stock.warehouseId))?.name || 'Unavailable' %></td><td data-label="On hand"><%= stock.onHand %></td><td data-label="Reserved"><%= stock.reserved %></td><td data-label="Available"><%= Number(stock.onHand || 0) - Number(stock.reserved || 0) - Number(stock.damaged || 0) - Number(stock.quarantined || 0) %></td></tr><% } %><% if (!(detail.stocks || []).length) { %><tr><td colspan="5">No stock is recorded.</td></tr><% } %></tbody></table></div><% if (detail.stockHasMore) { %><p class="form-intro">The first 200 stock records are shown. Additional records exist.</p><% } %></section>
<% } else { %>
<section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Current evidence</h2><p>Private documents for this verification.</p></div></div><% for (const document of detail.documents || []) { %><article class="role-security-row"><div><strong><%= document.documentType %></strong><small><%= document.status %></small></div><a class="outline-button" href="<%= casePath %>/documents/<%= encodeURIComponent(document.publicId) %>" target="_blank" rel="noopener noreferrer">View Document</a></article><% } %><% if (!(detail.documents || []).length) { %><p class="form-intro">No current documents are recorded.</p><% } %></section>
<% } %>
<% if (actionable && assignedToMe) { %>
<form class="panel role-form-section" method="post" action="<%= casePath %>/decision"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= item.__v %>"><div class="role-panel-head compact"><div><h2>Independent decision</h2><p><%= productCase ? 'Approval keeps the product private until the seller publishes it.' : 'Confirm that every required document belongs to this seller.' %> Rejection requires a clear reason of at least 10 characters.</p></div></div><div class="role-form-grid"><label class="wide">Decision reason<textarea name="reason" rows="4" maxlength="1000"><%= detail.draft?.reason || '' %></textarea></label></div><div class="seller-verification-actions"><button class="primary-button" type="submit" name="decision" value="approve"><%= productCase && item.moderation?.secondReviewRequired && !item.moderation?.firstApprovalByUserId ? 'Record First Approval' : productCase ? 'Approve Product' : 'Approve Verification' %></button><% if (productCase) { %><button class="outline-button" type="submit" name="decision" value="changes">Request Changes</button><% } %><button class="outline-button" type="submit" name="decision" value="reject"><%= productCase ? 'Reject Product' : 'Reject Verification' %></button></div></form>
<% } %>
<section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Review history</h2><p>Recorded actions for this case.</p></div></div><% const history = productCase ? item.moderation?.reviewHistory || [] : item.reviewHistory || []; for (const entry of history) { %><p class="form-intro"><strong><%= statusLabel(entry.action) %></strong> · <%= formatDate(entry.at) %><% if (entry.reason) { %> · <%= entry.reason %><% } %></p><% } %><% if (!history.length) { %><p class="form-intro">No review actions are recorded.</p><% } %></section>
<% } %>
