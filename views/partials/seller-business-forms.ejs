<% const supplierFlow=pageFlow; const supplierMoney=value=>new Intl.NumberFormat('en-GB',{style:'currency',currency:supplierFlow.currency||liveSeller.store.currency}).format(Number(value||0)/10**new Intl.NumberFormat('en',{style:'currency',currency:supplierFlow.currency||liveSeller.store.currency}).resolvedOptions().maximumFractionDigits); for(const record of supplierFlow.records){ %>
<section class="panel role-form-section" id="<%= record.publicId %>"><div class="role-panel-head"><div><h2><%= record.poNumber||record.publicId %></h2><p><%= record.companyName %> · <%= record.status.replaceAll('_',' ') %></p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>SKU</th><th>Product</th><th>Quantity</th><th>Unit price</th></tr></thead><tbody><% for(const line of record.items){ %><tr><td data-label="SKU"><%= line.sku %></td><td data-label="Product"><%= line.title %> · <%= line.variantTitle %></td><td data-label="Quantity"><%= line.quantity %></td><td data-label="Unit price"><%= supplierMoney(line.unitMinor??line.offeredUnitMinor??line.requestedUnitMinor) %></td></tr><% } %></tbody></table></div>
<% if(supplierFlow.kind==='business-quotes'){for(const message of record.messages.slice(-5)){ %><p class="form-intro"><strong><%= message.actorType==='seller'?'Your store':'Company' %>:</strong> <%= message.message %></p><% } if(['requested','responded','negotiating'].includes(record.status)){ %><form method="post" action="/seller/business-quotes/<%= record.publicId %>/respond" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= record.__v||0 %>"><% for(const line of record.items){ %><label>Unit price for <%= line.sku %> (minor units)<input type="number" name="offeredUnitMinor" min="1" max="10000000000" step="1" value="<%= line.offeredUnitMinor||line.requestedUnitMinor %>" required></label><% } %><label>Offer expiry (UTC)<input type="datetime-local" name="validUntil" required></label><label class="wide">Message to company<textarea name="message" maxlength="2000" required></textarea></label><div class="wide"><button class="primary-button" name="action" value="offer" type="submit">Send exact quotation</button> <button class="outline-button" name="action" value="decline" type="submit" formnovalidate>Decline request</button></div></form><% }}else{ %><div class="role-health-rows"><div><span>Payment terms</span><b><%= record.paymentTerms==='credit'?'Reviewed invoice credit':'Immediate Pesapal payment' %></b></div><div><span>Total</span><b><%= supplierMoney(record.totalMinor) %></b></div></div><% if(record.status==='issued'){ %><form method="post" action="/seller/business-orders/<%= record.publicId %>/decision" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= record.__v||0 %>"><label class="wide">Decision note<input name="reason" maxlength="500"></label><div class="wide"><button class="primary-button" name="decision" value="accept" type="submit">Accept and reserve stock</button> <button class="outline-button" name="decision" value="reject" type="submit">Decline purchase order</button></div></form><% }if(record.sellerOrderPublicId){ %><a class="plain-link" href="/seller/orders/<%= record.sellerOrderPublicId %>">Open fulfilment order</a><% }} %></section><% } %>
