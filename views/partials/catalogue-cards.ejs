<% const catalogueRows = typeof initialCatalogue !== 'undefined' ? initialCatalogue : {products:[]}; (catalogueRows.products || []).slice(0,12).forEach(product => { const productHref = '/products/' + encodeURIComponent(product.id) + '?country=' + encodeURIComponent(country.code); %>
<article class="catalog-product-card" data-product-id="<%= product.id %>">
<a class="catalog-product-image" href="<%= productHref %>" aria-label="View <%= product.name %> details"><img src="<%= product.image %>" alt="<%= product.imageAlt || product.name %>" loading="lazy" decoding="async"/><span class="catalog-status-badge"><%= product.badge %></span></a>
<button class="catalog-wishlist" data-catalog-wishlist="<%= product.id %>" type="button" aria-label="Add to wishlist"><img src="/assets/icons/heart-regular.svg" alt=""/></button>
<div class="catalog-product-info"><div class="catalog-product-category"><%= product.categoryName %></div><a href="<%= productHref %>"><h3><%= product.name %></h3></a><p><%= product.subtitle %> · <%= product.brand %></p><div class="catalog-card-commerce"><div class="catalog-card-price"><strong><%= new Intl.NumberFormat(country.locale || 'en', {style:'currency',currency:product.currency}).format(product.price) %></strong></div><div class="catalog-card-rating" aria-label="<%= product.reviews ? 'Rated ' + product.rating + ' from ' + product.reviews + ' reviews' : 'No reviews yet' %>"><span aria-hidden="true">★</span><strong><%= product.reviews ? Number(product.rating).toFixed(1) : 'New' %></strong><% if (product.reviews) { %><small>(<%= product.reviews %>)</small><% } %></div></div><div class="catalog-card-meta"><span><img src="/assets/icons/truck-fast.svg" alt=""/> Delivery at checkout</span><span><%= product.stock > 0 ? product.stock + ' in stock' : 'Out of stock' %></span></div><div class="catalog-card-actions"><button data-catalog-add="<%= product.id %>" type="button" <%= product.stock < 1 ? 'disabled' : '' %>><img src="/assets/icons/cart-plus.svg" alt=""/> Add to cart</button><button data-catalog-compare="<%= product.id %>" type="button">Compare</button></div></div>
</article>
<% }); %>
