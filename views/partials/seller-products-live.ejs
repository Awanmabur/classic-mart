<%
  const flow = liveSeller.productFlow;
  const store = flow.store || liveSeller.store;
  const product = flow.product;
  const draft = flow.draft || {};
  const draftSection = flow.draftSection || '';
  const detailsDraft = (!draftSection || draftSection === 'update') && !draft.variantPublicId ? draft : {};
  const addedVariantDraft = draftSection === 'variants' && !draft.variantPublicId ? draft : {};
  const stockDraft = draftSection === 'stock' ? draft : {};
  const warehouseDraft = draftSection === 'warehouses' ? draft : {};
  const imageUploadDraft = draftSection === 'images' && !draft.mediaPublicId ? draft : {};
  const nextStockCursor = flow.stockPage?.nextCursor || flow.stockPage?.next || '';
  const categories = flow.categories || [];
  const brands = flow.brands || [];
  const variants = flow.variants || [];
  const media = flow.media || [];
  const warehouses = flow.warehouses || [];
  const stocks = flow.stocks || [];
  const editable = Boolean(product && ['draft','changes_requested','rejected'].includes(product.status));
  const canFulfil = Boolean(flow.capabilities?.fulfilment ?? flow.options?.capabilities?.fulfilment);
  const currency = store.currency;
  const digits = new Intl.NumberFormat('en', { style: 'currency', currency }).resolvedOptions().maximumFractionDigits;
  const priceValue = value => value == null ? '' : (Number(value) / (10 ** digits)).toFixed(digits);
  const currencyStep = digits ? (1 / (10 ** digits)).toFixed(digits) : '1';
  const statusLabel = value => String(value || '').replaceAll('_', ' ');
  const statusTone = value => ['approved','published'].includes(value) ? 'good' : ['rejected','suspended'].includes(value) ? 'bad' : ['draft','submitted','changes_requested'].includes(value) ? 'warn' : 'neutral';
  const attributes = product?.attributes instanceof Map ? Object.fromEntries(product.attributes) : product?.attributes || {};
  const productPath = product ? `/seller/products/${encodeURIComponent(product.publicId)}` : '/seller/products';
%>
<section class="app-page active role-page seller-product-page" data-page="<%= flow.mode === 'create' ? 'seller-add-product' : 'seller-products' %>" data-role="seller">
  <div class="page-heading role-page-heading"><div><span class="eyebrow">Catalogue</span><h1><%= flow.mode === 'list' ? 'My Products' : flow.mode === 'create' ? 'Add a Product' : product.title %></h1><p><%= flow.mode === 'list' ? 'Manage product information, publishing status, prices, images, and marketplace visibility.' : 'Keep your listing accurate, complete its images and stock, then submit it for independent review.' %></p></div><a class="<%= flow.mode === 'list' ? 'primary-button' : 'outline-button' %> icon-button" href="<%= flow.mode === 'list' ? '/seller/products/new' : '/seller/products' %>"><svg aria-hidden="true"><use href="#<%= flow.mode === 'list' ? 'i-plus' : 'i-box' %>"></use></svg><%= flow.mode === 'list' ? 'Add Product' : 'View Products' %></a></div>
  <% if (flow.error) { %><div class="panel dashboard-message dashboard-message-error" role="alert"><%= flow.error %></div><% } %>
  <% if (flow.mode === 'list') { const filters = flow.filters || {}; %>
    <section class="panel role-table-panel">
      <div class="role-panel-head"><div><h2>Product records</h2><p><%= (flow.items || []).length %> products on this page</p></div></div>
      <form class="role-form-grid seller-product-filter" method="get" action="/seller/products"><label>Search products<input type="search" name="search" value="<%= filters.search || '' %>" maxlength="100" placeholder="Product name"></label><label>Publishing status<select name="status"><option value="">All statuses</option><% for (const status of ['draft','submitted','changes_requested','approved','published','rejected','suspended','archived']) { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= statusLabel(status) %></option><% } %></select></label><div class="seller-verification-actions"><button class="outline-button" type="submit">Filter Products</button><a class="plain-link" href="/seller/products">Clear Filters</a></div></form>
      <div class="role-table-wrap"><table class="role-table"><thead><tr><th>Product</th><th>Status</th><th>Price</th><th>Updated</th><th>Action</th></tr></thead><tbody>
        <% for (const item of flow.items || []) { %><tr><td data-label="Product"><span><%= item.title %></span></td><td data-label="Status"><span class="role-status <%= statusTone(item.status) %>"><%= statusLabel(item.status) %></span></td><td data-label="Price"><%= item.priceMinor == null ? 'No active variant' : formatMoney(item.priceMinor, item.currency || currency) %></td><td data-label="Updated"><%= formatDate(item.updatedAt) %></td><td data-label="Action"><a class="outline-button" href="/seller/products/<%= encodeURIComponent(item.publicId) %>">Manage Product</a></td></tr><% } %>
        <% if (!(flow.items || []).length) { %><tr><td colspan="5">No products match these filters. Create a product to start your catalogue.</td></tr><% } %>
      </tbody></table></div>
      <% if (flow.page?.hasMore) { %><div class="role-table-footer"><a class="outline-button" href="/seller/products?after=<%= encodeURIComponent(flow.page.next) %>&amp;status=<%= encodeURIComponent(filters.status || '') %>&amp;search=<%= encodeURIComponent(filters.search || '') %>">Next Page</a></div><% } %>
    </section>
  <% } else if (flow.mode === 'create') { %>
    <form class="role-editor" method="post" action="/seller/products"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="role-editor-main">
        <section class="panel role-form-section"><div class="role-panel-head compact"><div><span class="role-section-number">1</span><h2>Basic product information</h2></div><span class="role-required">Required</span></div><div class="role-form-grid">
          <label class="wide">Product name<input name="title" value="<%= draft.title || '' %>" required minlength="3" maxlength="180" placeholder="Enter your product name"></label>
          <label>Category<select name="categoryPublicId" required><option value="">Choose category</option><% for (const category of categories) { %><option value="<%= category.publicId %>" <%= draft.categoryPublicId === category.publicId ? 'selected' : '' %>><%= category.name %><%= category.restricted ? ' · restricted' : '' %></option><% } %></select></label>
          <label>Brand<select name="brandPublicId"><option value="">No brand</option><% for (const brand of brands) { %><option value="<%= brand.publicId %>" <%= draft.brandPublicId === brand.publicId ? 'selected' : '' %>><%= brand.name %></option><% } %></select></label>
          <label class="wide">Product description<textarea name="description" required minlength="20" maxlength="5000" rows="5" placeholder="Describe materials, features, benefits, and what is included."><%= draft.description || '' %></textarea></label>
          <label class="wide">Tags<input name="tags" value="<%= draft.tags || '' %>" maxlength="500" placeholder="Separate tags with commas"></label>
          <label class="wide">Product video URL (YouTube or Vimeo)<input name="videoUrl" type="url" value="<%= draft.videoUrl || '' %>" maxlength="800" placeholder="https://www.youtube.com/..."></label>
          <label>Selling country<input value="<%= store.country %>" readonly></label><label>Currency<input value="<%= currency %>" readonly></label>
        </div></section>
        <section class="panel role-form-section"><div class="role-panel-head compact"><div><span class="role-section-number">2</span><h2>Pricing and first variant</h2></div></div><div class="role-form-grid">
          <label>Variant name<input name="variantTitle" value="<%= draft.variantTitle || '' %>" required minlength="2" maxlength="120" placeholder="For example, Standard or Black / Medium"></label>
          <label>SKU<input name="sku" value="<%= draft.sku || '' %>" required minlength="2" maxlength="64" placeholder="Your unique stock code"></label>
          <label>Selling price (<%= currency %>)<input name="price" value="<%= draft.price ?? '' %>" type="number" required min="<%= currencyStep %>" step="<%= currencyStep %>" inputmode="decimal"></label>
          <label>Compare-at price (<%= currency %>)<input name="compareAt" value="<%= draft.compareAt ?? '' %>" type="number" min="0" step="<%= currencyStep %>" inputmode="decimal"></label>
          <label>Barcode<input name="barcode" value="<%= draft.barcode || '' %>" maxlength="64"></label><label>Package weight (grams)<input name="weightGrams" value="<%= draft.weightGrams ?? '0' %>" type="number" required min="0" max="2000000" step="1" inputmode="numeric"></label>
        </div><p class="form-intro">Save the draft first, then add its category attributes, product images, variants, and warehouse stock.</p></section>
      </div>
      <aside class="role-editor-side"><section class="panel role-publish-card"><span class="eyebrow">Publishing</span><h2>Create your draft</h2><p class="form-intro">New products stay private until review is complete and you publish them.</p><button class="primary-button full-button" type="submit">Save Product</button><a class="outline-button full-button" href="/seller/products">Cancel</a></section><section class="panel role-tip-card"><span><svg aria-hidden="true"><use href="#i-award"></use></svg></span><div><strong>Build a complete listing</strong><p>Add at least three clear images and stock for an active variant before submitting for review.</p></div></section></aside>
    </form>
  <% } else { %>
    <div class="role-editor">
      <div class="role-editor-main">
        <form class="panel role-form-section" method="post" action="<%= productPath %>/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= product.__v %>"><div class="role-panel-head compact"><div><span class="role-section-number">1</span><h2>Basic product information</h2></div><span class="role-status <%= statusTone(product.status) %>"><%= statusLabel(product.status) %></span></div>
          <fieldset class="seller-settings-fields" <%= editable ? '' : 'disabled' %>><div class="role-form-grid">
            <label class="wide">Product name<input name="title" value="<%= detailsDraft.title ?? product.title %>" required minlength="3" maxlength="180"></label>
            <label>Category<select name="categoryPublicId" required><% if (flow.category && !categories.some(item => item.publicId === flow.category.publicId)) { %><option value="<%= flow.category.publicId %>" selected><%= flow.category.name %> · unavailable</option><% } %><% for (const category of categories) { %><option value="<%= category.publicId %>" <%= (detailsDraft.categoryPublicId ?? flow.category?.publicId) === category.publicId ? 'selected' : '' %>><%= category.name %><%= category.restricted ? ' · restricted' : '' %></option><% } %></select></label>
            <label>Brand<select name="brandPublicId"><option value="">No brand</option><% for (const brand of brands) { %><option value="<%= brand.publicId %>" <%= (detailsDraft.brandPublicId ?? flow.brand?.publicId) === brand.publicId ? 'selected' : '' %>><%= brand.name %></option><% } %></select></label>
            <label class="wide">Product description<textarea name="description" required minlength="20" maxlength="5000" rows="5"><%= detailsDraft.description ?? product.description %></textarea></label>
            <label class="wide">Tags<input name="tags" value="<%= detailsDraft.tags ?? (product.tags || []).join(', ') %>" maxlength="500" placeholder="Separate tags with commas"></label>
            <label class="wide">Product video URL (YouTube or Vimeo)<input name="videoUrl" type="url" value="<%= detailsDraft.videoUrl ?? product.videoUrl ?? '' %>" maxlength="800" placeholder="https://www.youtube.com/..."></label>
            <label>Selling country<input value="<%= (product.countries || []).join(', ') %>" readonly></label><label>Currency<input value="<%= currency %>" readonly></label>
            <% for (const attribute of flow.category?.attributes || []) { const key = `attribute[${attribute.key}]`; const value = detailsDraft[key] ?? attributes[attribute.key] ?? ''; %><label><%= attribute.label %><%= attribute.required ? ' · required before review' : '' %><% if (attribute.type === 'select' || attribute.type === 'boolean') { %><select name="<%= key %>"><option value="">Choose <%= attribute.label.toLowerCase() %></option><% for (const choice of attribute.type === 'boolean' ? ['true','false'] : attribute.options || []) { %><option value="<%= choice %>" <%= String(value) === choice ? 'selected' : '' %>><%= attribute.type === 'boolean' ? choice === 'true' ? 'Yes' : 'No' : choice %></option><% } %></select><% } else { %><input name="<%= key %>" value="<%= value %>" type="<%= attribute.type === 'number' ? 'number' : 'text' %>" step="<%= attribute.type === 'number' ? 'any' : '1' %>" maxlength="500"><% } %></label><% } %>
          </div><% if (editable) { %><button class="primary-button seller-product-action-form" type="submit">Save Product Details</button><% } %></fieldset>
        </form>
        <section class="panel role-form-section"><div class="role-panel-head compact"><div><span class="role-section-number">2</span><h2>Variants and pricing</h2></div><span class="role-required"><%= variants.length %> variants</span></div>
          <% for (const variant of variants) { const variantDraft = draftSection === 'variants' && draft.variantPublicId === variant.publicId ? draft : {}; const variantOptions = variant.options instanceof Map ? Object.fromEntries(variant.options) : variant.options || {}; const firstOption = Object.entries(variantOptions)[0] || ['', '']; %>
          <form class="seller-product-variant-form" method="post" action="<%= productPath %>/variants/<%= encodeURIComponent(variant.publicId) %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= product.__v %>"><h3><%= variant.title %></h3><fieldset class="seller-settings-fields" <%= editable ? '' : 'disabled' %>><div class="role-form-grid">
            <label>Variant name<input name="title" value="<%= variantDraft.title ?? variant.title %>" required minlength="2" maxlength="120"></label><label>SKU<input name="sku" value="<%= variantDraft.sku ?? variant.sku %>" required minlength="2" maxlength="64"></label>
            <label>Selling price (<%= currency %>)<input name="price" value="<%= variantDraft.price ?? priceValue(variant.priceMinor) %>" type="number" required min="<%= currencyStep %>" step="<%= currencyStep %>" inputmode="decimal"></label><label>Compare-at price (<%= currency %>)<input name="compareAt" value="<%= variantDraft.compareAt ?? priceValue(variant.compareAtMinor) %>" type="number" min="0" step="<%= currencyStep %>" inputmode="decimal"></label>
            <label>Barcode<input name="barcode" value="<%= variantDraft.barcode ?? variant.barcode ?? '' %>" maxlength="64"></label><label>Package weight (grams)<input name="weightGrams" value="<%= variantDraft.weightGrams ?? variant.weightGrams ?? 0 %>" type="number" required min="0" max="2000000" step="1" inputmode="numeric"></label>
            <label>Option name<input name="optionName" value="<%= variantDraft.optionName ?? firstOption[0] %>" maxlength="60" placeholder="For example, Colour"></label><label>Option value<input name="optionValue" value="<%= variantDraft.optionValue ?? firstOption[1] %>" maxlength="80" placeholder="For example, Black"></label>
            <label>Status<select name="active"><option value="yes" <%= (variantDraft.active ?? (variant.active ? 'yes' : 'no')) === 'yes' ? 'selected' : '' %>>Active</option><option value="no" <%= (variantDraft.active ?? (variant.active ? 'yes' : 'no')) === 'no' ? 'selected' : '' %>>Inactive</option></select></label>
          </div><% if (Object.entries(variantOptions).length > 1) { %><p class="form-intro">Options: <%= Object.entries(variantOptions).map(([key,value]) => `${key}: ${value}`).join(' · ') %></p><% } %><% if (variant.minimumPriceMinor > 0) { %><p class="form-intro">Minimum selling price: <%= formatMoney(variant.minimumPriceMinor,currency) %></p><% } %><% if (editable) { %><button class="outline-button seller-product-action-form" type="submit">Save Variant</button><% } %></fieldset></form>
          <% } %>
          <% if (editable && variants.length < 50) { %><details class="faq-item seller-product-action-form" <%= draftSection === 'variants' && !draft.variantPublicId ? 'open' : '' %>><summary>Add another variant</summary><form method="post" action="<%= productPath %>/variants"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= product.__v %>"><div class="role-form-grid">
            <label>Variant name<input name="title" value="<%= addedVariantDraft.title ?? '' %>" required minlength="1" maxlength="120"></label><label>SKU<input name="sku" value="<%= addedVariantDraft.sku ?? '' %>" required minlength="2" maxlength="64"></label><label>Selling price (<%= currency %>)<input name="price" value="<%= addedVariantDraft.price ?? '' %>" type="number" required min="<%= currencyStep %>" step="<%= currencyStep %>" inputmode="decimal"></label><label>Compare-at price (<%= currency %>)<input name="compareAt" value="<%= addedVariantDraft.compareAt ?? '' %>" type="number" min="0" step="<%= currencyStep %>" inputmode="decimal"></label><label>Barcode<input name="barcode" value="<%= addedVariantDraft.barcode ?? '' %>" maxlength="64"></label><label>Package weight (grams)<input name="weightGrams" type="number" required min="0" max="2000000" step="1" value="<%= addedVariantDraft.weightGrams ?? '0' %>" inputmode="numeric"></label><label>Option name<input name="optionName" value="<%= addedVariantDraft.optionName ?? '' %>" maxlength="60"></label><label>Option value<input name="optionValue" value="<%= addedVariantDraft.optionValue ?? '' %>" maxlength="80"></label><label>Status<select name="active"><option value="yes" <%= addedVariantDraft.active !== 'no' ? 'selected' : '' %>>Active</option><option value="no" <%= addedVariantDraft.active === 'no' ? 'selected' : '' %>>Inactive</option></select></label>
          </div><button class="outline-button seller-product-action-form" type="submit">Add Variant</button></form></details><% } %>
        </section>
        <section class="panel role-form-section"><div class="role-panel-head compact"><div><span class="role-section-number">3</span><h2>Product images</h2></div><span class="role-required"><%= media.length %> / 10 images</span></div>
          <% if (!media.length) { %><p class="form-intro">No images yet. Add at least three accurate product images before review.</p><% } %>
          <div class="role-form-grid seller-product-media-grid"><% for (const image of media) { const imageDraft = draftSection === 'images' && draft.mediaPublicId === image.publicId ? draft : {}; %><article class="seller-product-media-card"><img class="seller-product-image" src="/media/catalogue/<%= encodeURIComponent(image.publicId) %>" alt="<%= image.altText || product.title %>" loading="lazy" decoding="async"><p class="form-intro"><%= media[0]?.publicId === image.publicId ? 'Cover image · ' : '' %><%= image.width %> × <%= image.height %> · <%= statusLabel(image.status) %></p>
            <form method="post" action="<%= productPath %>/images/<%= encodeURIComponent(image.publicId) %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= product.__v %>"><fieldset class="seller-settings-fields" <%= editable ? '' : 'disabled' %>><div class="role-form-grid"><label class="wide">Image description<input name="altText" value="<%= imageDraft.altText ?? image.altText ?? '' %>" required minlength="3" maxlength="180"></label><label>Image order<input name="position" type="number" value="<%= imageDraft.position ?? image.position %>" required min="0" max="9" step="1"></label></div><% if (editable) { %><div class="seller-verification-actions seller-product-action-form"><button class="outline-button" type="submit" name="action" value="update">Save Image</button><button class="outline-button" type="submit" name="action" value="remove" formnovalidate>Remove Image</button></div><% } %></fieldset></form>
            <% if (editable) { %><details class="faq-item seller-product-action-form" <%= imageDraft.draftImageAction === 'replace' ? 'open' : '' %>><summary>Replace Image</summary><form method="post" action="<%= productPath %>/images/<%= encodeURIComponent(image.publicId) %>/replace" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= product.__v %>"><div class="role-form-grid"><label class="wide">Replacement image<input type="file" name="image" required accept="image/jpeg,image/png,image/webp,image/avif"></label><label class="wide">Image description<input name="altText" value="<%= imageDraft.altText ?? image.altText ?? '' %>" required minlength="3" maxlength="180"></label><label>Image order<input name="position" type="number" value="<%= imageDraft.position ?? image.position %>" required min="0" max="9" step="1"></label></div><p class="form-intro">Choose an image again if the upload fails. The current image remains until its replacement is saved.</p><button class="outline-button seller-product-action-form" type="submit">Replace Image</button></form></details><% } %>
          </article><% } %></div>
          <% if (editable && media.length < 10) { %><form class="seller-verification-upload" method="post" action="<%= productPath %>/images" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= product.__v %>"><div class="role-upload-box"><span><svg aria-hidden="true"><use href="#i-plus"></use></svg></span><strong>Add a clear product image</strong><p>JPG, PNG, WebP, or AVIF. Maximum 8 MB per image; at least 320 × 320 pixels.</p><div class="role-form-grid"><label class="wide">Choose image<input type="file" name="image" required accept="image/jpeg,image/png,image/webp,image/avif"></label><label class="wide">Image description<input name="altText" value="<%= imageUploadDraft.altText || '' %>" required minlength="3" maxlength="180" placeholder="Describe the product shown"></label><label>Image order<input name="position" type="number" min="0" max="9" step="1" value="<%= imageUploadDraft.position ?? Math.min(media.length,9) %>" required></label></div><button class="outline-button seller-product-action-form" type="submit">Upload Image</button></div></form><% } %>
        </section>
        <section class="panel role-form-section"><div class="role-panel-head compact"><div><span class="role-section-number">4</span><h2>Stock and fulfilment</h2></div></div>
          <div class="role-table-wrap"><table class="role-table"><thead><tr><th>Variant</th><th>Warehouse</th><th>On hand</th><th>Reserved</th><th>Unavailable</th><th>Available</th></tr></thead><tbody><% for (const stock of stocks) { const variant = variants.find(item => item.publicId === stock.variantPublicId || String(item._id) === String(stock.variantId)); const warehouse = warehouses.find(item => item.publicId === stock.warehousePublicId || String(item._id) === String(stock.warehouseId)); %><tr><td data-label="Variant"><%= stock.variant?.sku || variant?.sku || 'Variant unavailable' %></td><td data-label="Warehouse"><%= stock.warehouseName || stock.warehouse?.name || warehouse?.name || 'Warehouse unavailable' %></td><td data-label="On hand"><%= stock.onHand %></td><td data-label="Reserved"><%= stock.reserved %></td><td data-label="Unavailable"><%= Number(stock.damaged || 0) + Number(stock.quarantined || 0) %></td><td data-label="Available"><%= Number(stock.onHand || 0) - Number(stock.reserved || 0) - Number(stock.damaged || 0) - Number(stock.quarantined || 0) %></td></tr><% } %><% if (!stocks.length) { %><tr><td colspan="6">No stock recorded for this product.</td></tr><% } %></tbody></table></div>
          <% if (flow.stockPage) { %><div class="role-table-footer"><span><%= stocks.length %> stock records on this page</span><% if (flow.stockPage.next) { %><a class="outline-button" href="<%= productPath %>?stockAfter=<%= encodeURIComponent(flow.stockPage.next) %>">Next Stock Page</a><% } %></div><% } %>
          <% if (canFulfil) { %><p class="form-intro">Stock adjustments record the quantity received or removed. Reserved stock remains protected.</p>
          <% if (warehouses.length && variants.length && !['archived','suspended'].includes(product.status)) { %><form class="seller-product-action-form" method="post" action="<%= productPath %>/stock"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= product.__v %>"><div class="role-form-grid"><label>Variant<select name="variantPublicId" required><% for (const variant of variants) { %><option value="<%= variant.publicId %>" <%= stockDraft.variantPublicId === variant.publicId ? 'selected' : '' %>><%= variant.sku %> · <%= variant.title %></option><% } %></select></label><label>Warehouse<select name="warehousePublicId" required><% for (const warehouse of warehouses) { %><option value="<%= warehouse.publicId %>" <%= stockDraft.warehousePublicId === warehouse.publicId ? 'selected' : '' %>><%= warehouse.name %> · <%= warehouse.city %></option><% } %></select></label><label>Quantity adjustment<input name="quantity" type="number" min="-1000000" max="1000000" required step="1" inputmode="numeric" value="<%= stockDraft.quantity ?? '' %>" placeholder="For example, 10 or -2"></label><label>Reorder point<input name="reorderPoint" type="number" min="0" max="2000000000" step="1" inputmode="numeric" value="<%= stockDraft.reorderPoint ?? '' %>" placeholder="Leave unchanged"></label><label class="wide">Adjustment reason<input name="reason" value="<%= stockDraft.reason || '' %>" required minlength="3" maxlength="300" placeholder="For example, New shipment received"></label></div><button class="outline-button seller-product-action-form" type="submit">Record Stock Adjustment</button></form><% } %>
          <% if (!['archived','suspended'].includes(product.status)) { %><details class="faq-item seller-product-action-form" <%= draftSection === 'warehouses' ? 'open' : '' %>><summary><%= warehouses.length ? 'Add a warehouse' : 'Create a warehouse to record stock' %></summary><form method="post" action="<%= productPath %>/warehouses"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= product.__v %>"><div class="role-form-grid"><label>Warehouse name<input name="name" value="<%= warehouseDraft.name || '' %>" required minlength="2" maxlength="120" autocomplete="organization"></label><label>City<input name="city" value="<%= warehouseDraft.city || '' %>" required minlength="2" maxlength="100" autocomplete="address-level2"></label><label class="wide">Warehouse address<input name="address" value="<%= warehouseDraft.address || '' %>" required minlength="5" maxlength="300" autocomplete="street-address"></label><label>Country<input value="<%= store.country %>" readonly></label></div><button class="outline-button seller-product-action-form" type="submit">Create Warehouse</button></form></details><% } %>
          <% } else { %><p class="form-intro">Your store role can view stock. A member with fulfilment access must record stock adjustments.</p><% } %>
        </section>
      </div>
      <aside class="role-editor-side"><section class="panel role-publish-card"><span class="eyebrow">Publishing</span><h2>Listing status</h2><span class="role-status <%= statusTone(product.status) %>"><%= statusLabel(product.status) %></span><p class="form-intro"><%= variants.filter(item => item.active).length %> active variants · <%= media.length %> images</p><% if (product.moderation?.reason) { %><p class="form-intro"><strong>Reviewer feedback:</strong> <%= product.moderation.reason %></p><% } %><% if (product.moderation?.secondReviewRequired && product.status === 'submitted') { %><p class="form-intro"><%= product.moderation.firstApprovalByUserId ? 'First review complete. Waiting for an independent second reviewer.' : 'This listing requires two independent approvals.' %></p><% } %>
        <div class="seller-product-lifecycle">
        <% if (editable) { %><form method="post" action="<%= productPath %>/submit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= product.__v %>"><button class="primary-button full-button" type="submit">Submit for Review</button></form><p class="form-intro">Include required category attributes, at least three images, an active priced variant, and available stock.</p><% } %>
        <% if (flow.canPublish) { %><form method="post" action="<%= productPath %>/publish"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= product.__v %>"><button class="primary-button full-button" type="submit">Publish Product</button></form><% } %>
        <% if (flow.canReopen) { %><form method="post" action="<%= productPath %>/reopen"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= product.__v %>"><button class="outline-button full-button" type="submit">Reopen as Draft</button></form><p class="form-intro">Reopening removes the listing from sale and requires a new review before publication.</p><% } %>
        <% if (flow.canArchive) { %><form method="post" action="<%= productPath %>/archive"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= product.__v %>"><button class="outline-button full-button" type="submit">Archive Product</button></form><% } %>
        <% if (flow.publicHref && product.status === 'published') { %><a class="outline-button full-button" href="<%= flow.publicHref %>">View Published Product</a><% } %>
        </div>
      </section><section class="panel role-tip-card"><span><svg aria-hidden="true"><use href="#i-award"></use></svg></span><div><strong>Keep your listing accurate</strong><p>Changes to product details, variants, or images require a new review. Stock adjustments do not change approved content.</p></div></section></aside>
    </div>
  <% } %>
</section>
