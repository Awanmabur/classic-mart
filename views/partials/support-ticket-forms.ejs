<% const ticketFlow=supportFlow; const selectedTicket=ticketFlow.selected; const ticketActions='/support/queue/'+encodeURIComponent(selectedTicket?.publicId||'')+'/action'; %>
<% if(selectedTicket){ %>
<section class="panel role-form-section" aria-labelledby="support-ticket-heading">
  <div class="role-panel-head"><h2 id="support-ticket-heading"><%= selectedTicket.subject %></h2><span class="role-status"><%= selectedTicket.status.replaceAll('_',' ') %></span></div>
  <div class="role-form-grid">
    <div><span>Ticket</span><strong><%= selectedTicket.publicId %></strong></div><div><span>Requester</span><strong><%= selectedTicket.requester.name %></strong><small><%= selectedTicket.requester.emailMasked %></small></div>
    <div><span>Owner</span><strong><%= selectedTicket.owner?.name||'Unassigned' %></strong></div><div><span>Market and queue</span><strong><%= selectedTicket.country %> · <%= selectedTicket.queue %> · <%= selectedTicket.priority %></strong></div>
    <div><span>SLA due</span><strong><%= formatDate(selectedTicket.slaDueAt) %></strong></div>
    <% if(selectedTicket.order){ %><div><span>Linked order</span><a href="/support/orders?country=<%= selectedTicket.country %>&amp;record=<%= encodeURIComponent(selectedTicket.order.publicId) %>"><%= selectedTicket.order.publicId %></a><small><%= selectedTicket.order.fulfillmentState.replaceAll('_',' ') %> · <%= selectedTicket.order.paymentState %></small></div><% } %>
  </div>
  <% if(selectedTicket.canClaim){ %><form method="post" action="<%= ticketActions %>" class="role-inline-action"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedTicket.version %>"><input type="hidden" name="action" value="claim"><button class="primary-button" type="submit">Claim ticket</button></form><% } %>
  <% if(selectedTicket.mergedIntoPublicId){ %><a class="soft-button" href="/support/queue?record=<%= encodeURIComponent(selectedTicket.mergedIntoPublicId) %>&amp;country=<%= selectedTicket.country %>">Open merged conversation</a><% } %>
  <div class="role-stack-list" aria-label="Saved ticket conversation"><% selectedTicket.notes.forEach(note=>{ %><article><div><strong><%= note.internal?'Internal note':note.author+' message' %></strong><p><%= note.message %></p><small><%= formatDate(note.at) %></small></div></article><% }); %></div>
  <% if(selectedTicket.delivery.length){ %><details><summary>Requester email delivery</summary><% selectedTicket.delivery.forEach(delivery=>{ %><p>Reply <%= delivery.noteIndex %>: <%= delivery.status.replaceAll('_',' ') %><%= delivery.status==='development_sink'?' — no external email sent':'' %><%= ['pending','processing','failed'].includes(delivery.status)?' — '+delivery.attempts+' delivery attempt(s)':'' %></p><% }); %></details><% } %>
</section>
<% if(selectedTicket.ownedByActor&&!selectedTicket.mergedIntoPublicId){ const activeTicket=['open','in_progress','waiting_customer','escalated'].includes(selectedTicket.status); %>
<% if(activeTicket){ %>
<section class="panel role-form-section" aria-labelledby="support-reply-heading">
  <div class="role-panel-head"><h2 id="support-reply-heading">Reply to the conversation</h2></div>
  <% if(ticketFlow.macros.length){ %><form method="get" action="/support/queue" class="role-form-grid"><input type="hidden" name="record" value="<%= selectedTicket.publicId %>"><input type="hidden" name="country" value="<%= selectedTicket.country %>"><label><span>Saved reply macro</span><select name="macro"><% ticketFlow.macros.forEach(macro=>{ %><option value="<%= macro.publicId %>" <%= ticketFlow.macroPreview?.publicId===macro.publicId?'selected':'' %>><%= macro.title %></option><% }); %></select></label><div><button class="soft-button" type="submit">Preview reply</button></div></form><% } %>
  <form method="post" action="<%= ticketActions %>" class="role-form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedTicket.version %>"><input type="hidden" name="action" value="reply">
    <% if(ticketFlow.macroPreview){ %><input type="hidden" name="macroId" value="<%= ticketFlow.macroPreview.publicId %>"><input type="hidden" name="macroVersion" value="<%= ticketFlow.macroPreview.version %>"><% } %>
    <label class="wide"><span><%= ticketFlow.macroPreview?'Previewed factual reply':'Message' %></span><textarea name="message" minlength="3" maxlength="2000" rows="4" required <%= ticketFlow.macroPreview?'readonly':'' %>><%= ticketFlow.macroPreview?.message||'' %></textarea></label>
    <label><span>Visibility</span><select name="internal"><option value="false">Visible to requester</option><option value="true">Internal staff note</option></select></label>
    <label><span>After a visible reply</span><select name="status"><option value="in_progress">Keep in progress</option><option value="waiting_customer">Wait for requester</option></select></label>
    <div class="wide"><button class="primary-button" type="submit">Save reply</button><% if(ticketFlow.macroPreview){ %> <a class="soft-button" href="/support/queue?record=<%= encodeURIComponent(selectedTicket.publicId) %>&amp;country=<%= selectedTicket.country %>">Write another reply</a><% } %></div>
  </form>
</section>
<section class="panel role-form-section" aria-labelledby="support-owner-heading"><div class="role-panel-head"><h2 id="support-owner-heading">Ownership and priority</h2></div>
  <form method="post" action="<%= ticketActions %>" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedTicket.version %>"><input type="hidden" name="action" value="update"><label><span>Queue</span><select name="queue"><% ticketFlow.filters.queues.filter(row=>row.value!=='all').forEach(row=>{ %><option value="<%= row.value %>" <%= selectedTicket.queue===row.value?'selected':'' %>><%= row.label %></option><% }); %></select></label><label><span>Priority</span><select name="priority"><% ticketFlow.filters.priorities.filter(row=>row.value!=='all').forEach(row=>{ %><option value="<%= row.value %>" <%= selectedTicket.priority===row.value?'selected':'' %>><%= row.label %></option><% }); %></select></label><div class="wide"><button class="soft-button" type="submit">Update queue and priority</button></div></form>
  <% const recipients=ticketFlow.transferCandidates.filter(row=>row.publicId!==user.publicId); if(recipients.length){ %><form method="post" action="<%= ticketActions %>" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedTicket.version %>"><input type="hidden" name="action" value="transfer"><label><span>Transfer to authorized operator</span><select name="recipient" required><% recipients.forEach(row=>{ %><option value="<%= row.publicId %>"><%= row.name %></option><% }); %></select></label><div><button class="soft-button" type="submit">Transfer ticket</button></div></form><% } %>
  <form method="post" action="<%= ticketActions %>" class="role-inline-action"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedTicket.version %>"><input type="hidden" name="action" value="release"><button class="soft-button" type="submit">Release ownership</button></form>
</section>
<% } %>
<section class="panel role-form-section" aria-labelledby="support-status-heading"><div class="role-panel-head"><h2 id="support-status-heading">Record the next step</h2></div>
  <% const nextStatuses={open:['in_progress','escalated','resolved'],in_progress:['waiting_customer','escalated','resolved'],waiting_customer:['in_progress','escalated','resolved'],escalated:['in_progress','waiting_customer','resolved'],resolved:['closed','open'],closed:['open']}[selectedTicket.status]||[]; %>
  <form method="post" action="<%= ticketActions %>" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedTicket.version %>"><input type="hidden" name="action" value="status"><label><span>Next status</span><select name="status" required><% nextStatuses.forEach(status=>{ %><option value="<%= status %>"><%= status.replaceAll('_',' ') %></option><% }); %></select></label><label class="wide"><span>Visible explanation</span><textarea name="message" minlength="3" maxlength="2000" rows="3" <%= nextStatuses.every(status=>['waiting_customer','resolved','open'].includes(status))?'required':'' %>></textarea></label><p class="wide form-intro">Waiting for a requester, resolving or reopening needs a visible explanation. The saved conversation stays available to its requester.</p><div class="wide"><button class="primary-button" type="submit">Save next step</button></div></form>
</section>
<% } %>
<% } %>
<section class="panel role-form-section" id="support-macros" aria-labelledby="support-macros-heading"><div class="role-panel-head"><h2 id="support-macros-heading">Reply macros</h2><span><%= ticketFlow.macroPagination.total %> saved</span></div>
  <% if(ticketFlow.macroManagement.length){ %><form method="get" action="/support/queue" class="role-form-grid"><input type="hidden" name="country" value="<%= ticketFlow.country %>"><% if(selectedTicket){ %><input type="hidden" name="record" value="<%= selectedTicket.publicId %>"><% } %><label><span>Manage saved macro</span><select name="macroEdit"><% ticketFlow.macroManagement.forEach(macro=>{ %><option value="<%= macro.publicId %>" <%= ticketFlow.editingMacro?.publicId===macro.publicId?'selected':'' %>><%= macro.title %> · <%= macro.country %><%= macro.active?'':' · inactive' %></option><% }); %></select></label><div><button class="soft-button" type="submit">Edit macro</button></div></form><% if(ticketFlow.macroPagination.nextHref){ %><a class="soft-button" href="<%= ticketFlow.macroPagination.nextHref %>">More saved macros</a><% } %><% } %>
  <% const editing=ticketFlow.editingMacro; %><form method="post" action="/support/queue/macros<%= editing?'/'+encodeURIComponent(editing.publicId):'' %>" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(editing){ %><input type="hidden" name="version" value="<%= editing.version %>"><input type="hidden" name="country" value="<%= editing.country %>"><% }else{ %><label><span>Macro market</span><select name="country" required><% ticketFlow.context.countries.forEach(country=>{ %><option value="<%= country.code %>" <%= country.code===(selectedTicket?.country||ticketFlow.country)?'selected':'' %>><%= country.name %></option><% }); %></select></label><% } %><label><span>Title</span><input name="title" minlength="3" maxlength="120" value="<%= editing?.title||'' %>" required></label><label><span>Ticket category</span><select name="category"><% ['','order','payment','delivery','return','refund','account','product','seller','other'].forEach(category=>{ %><option value="<%= category %>" <%= category===(editing?.category||'')?'selected':'' %>><%= category||'All categories' %></option><% }); %></select></label><label><span>Availability</span><select name="active"><option value="true" <%= editing?.active===false?'':'selected' %>>Active</option><option value="false" <%= editing?.active===false?'selected':'' %>>Inactive</option></select></label><label class="wide"><span>Reply template</span><textarea name="body" minlength="3" maxlength="1800" rows="4" required><%= editing?.body||'' %></textarea></label><p class="wide form-intro">Supported factual placeholders: {{ customer_name }}, {{ ticket_id }}, {{ order_id }}, {{ subject }} and {{ status }}. Preview the reply in its saved ticket before sending.</p><div class="wide"><button class="primary-button" type="submit"><%= editing?'Update macro':'Create macro' %></button><% if(editing){ %> <a class="soft-button" href="/support/queue?country=<%= ticketFlow.country %>#support-macros">Create another macro</a><% } %></div></form>
</section>
