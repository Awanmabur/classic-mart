<% const displayDashboardCell = (value, row, column, columns) => typeof dashboardDisplay === 'function' ? dashboardDisplay(value, { row, column, columns }) : value; %>
<%
const flow = promoterFlow;
const metrics = flow.metrics || [];
const insights = flow.insights || [];
const workflow = flow.workflow || [];
const health = flow.health || {};
const healthValue = Number.isFinite(health.value) ? Math.max(0, Math.min(100, Math.round(health.value))) : null;
const filters = flow.filters || {};
const page = flow.page || {};
const rows = flow.rows || [];
const columns = flow.columns || [];
const analyticsPage = ['analytics', 'traffic'].includes(promoterPage.kind);
const trend = flow.trend || [];
const chartValue = bucket => Number.isFinite(Number(bucket.value)) ? Number(bucket.value) : 0;
const chartMaximum = Math.max(1, ...trend.map(bucket => Math.abs(chartValue(bucket))));
const statusTone = value => /^(active|healthy|published|completed|delivered|approved|resolved|fulfilled|available|paid|verified|preferred|valid)$/i.test(String(value)) ? 'good' : /^(rejected|failed|expired|cancelled|critical|blocked|reversed|revoked)$/i.test(String(value)) ? 'bad' : 'warn';
const localHref = value => typeof value === 'string' && (/^\/(?!\/)/.test(value) || /^#[a-zA-Z0-9_-]+$/.test(value)) && !/[\\\u0000-\u001f\u007f]/.test(value) ? value : null;
const filterParams = Object.entries(filters.params || {}).filter(([key, value]) => /^[a-zA-Z][a-zA-Z0-9_-]{0,30}$/.test(key) && !['search', 'status', 'after'].includes(key) && typeof value === 'string' && value.length <= 200);
const cursorKey = /^[a-zA-Z][a-zA-Z0-9_-]{0,30}$/.test(filters.cursorKey || '') ? filters.cursorKey : 'after';
const pageLink = after => { const query = new URLSearchParams(filterParams); if (filters.search) query.set('search', filters.search); if (filters.status) query.set('status', filters.status); if (after) query.set(cursorKey, after); return promoterPage.href + (query.size ? '?' + query : ''); };
const recommendation = insights.find(item => localHref(item?.href));
const nextHref = localHref(flow.pagination?.nextHref) || (page.next ? pageLink(page.next) : null);
const createHref = localHref(flow.create?.href);
const exportHref = localHref(flow.exportHref);
%>
<section class="app-page active role-page promoter-standard-live promoter-fidelity-page" data-page="<%= promoterPage.id %>" data-role="promoter" data-page-kind="<%= promoterPage.kind %>">
  <div class="page-heading role-page-heading"><div><span class="eyebrow"><%= promoterPage.eyebrow %></span><h1><%= promoterPage.title %></h1><p><%= promoterPage.description %></p></div><% if (createHref) { %><a class="primary-button icon-button" href="<%= createHref %>"><svg aria-hidden="true"><use href="#i-plus"></use></svg><%= flow.create.label %></a><% } %></div>
  <% if (flow.error) { %><p class="server-flash error platform-flash" role="alert"><%= flow.error %></p><% } %>
  <section class="role-metric-grid"><% for (const [index, metric] of metrics.entries()) { %><article class="role-metric panel"><span class="role-metric-icon tone-<%= index % 4 + 1 %>"><svg aria-hidden="true"><use href="#<%= ['i-eye','i-clipboard','i-wallet','i-award'][index % 4] %>"></use></svg></span><div><small><%= metric.label %></small><strong title="<%= metric.value ?? '—' %>"><%= metric.value ?? '—' %></strong><span><%= metric.detail || '' %></span></div></article><% } %></section>
  <div class="<%= analyticsPage ? 'role-analytics-top' : 'role-content-grid' %>">
    <div class="role-side-stack">
      <% if (analyticsPage || flow.trend) { %>
      <section class="panel role-chart-panel"><div class="role-panel-head"><div><h2>Performance trend</h2><p><%= flow.trendDescription || 'Recorded promoter results for this reporting period.' %></p></div><% if (flow.periodOptions?.length) { %><form class="promoter-period-filter" method="get" action="<%= promoterPage.href %>"><% for (const [key, value] of filterParams.filter(([key]) => key !== 'period')) { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% } %><label class="sr-only" for="promoterChartPeriod">Chart period</label><select id="promoterChartPeriod" name="period"><% for (const option of flow.periodOptions) { %><option value="<%= option.value %>" <%= option.value === flow.period ? 'selected' : '' %>><%= option.label %></option><% } %></select><button class="plain-link" type="submit">Apply</button></form><% } %></div>
        <% if (trend.length) { %><div class="role-chart" role="img" aria-label="<%= (flow.trendLabel || 'Promoter performance') + '. ' + trend.map(bucket => `${bucket.label}: ${bucket.display ?? chartValue(bucket)}`).join('; ') %>"><% for (const bucket of trend) { const value = chartValue(bucket); %><div><span style="height:<%= Math.abs(value) / chartMaximum * 80 %>%" data-zero="<%= value === 0 %>" data-negative="<%= value < 0 %>" title="<%= `${bucket.label}: ${bucket.display ?? value}` %>"><b><%= bucket.display ?? value %></b></span><small><%= bucket.label %></small></div><% } %></div><% } else { %><div class="role-chart promoter-empty-chart"><p class="form-intro"><%= flow.trendEmptyText || 'No recorded performance in this period.' %></p></div><% } %>
        <div class="role-chart-legend"><span><i></i><%= flow.trendLabel || 'Recorded performance' %></span><% if (flow.trendSummary) { %><strong><%= flow.trendSummary %></strong><% } %></div>
      </section>
      <% } %>
      <% if (!analyticsPage) { %>
      <section class="panel role-table-panel" id="promoter-records">
        <div class="role-panel-head"><div><h2><%= flow.tableTitle || promoterPage.title + ' records' %></h2><p><%= flow.tableDescription || 'Current records for your promoter account.' %></p></div><div class="role-table-tools">
          <% if (flow.filters) { %><form class="promoter-compact-filter" method="get" action="<%= promoterPage.href %>"><% for (const [key, value] of filterParams) { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% } %><% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %><label class="role-mini-search"><svg aria-hidden="true"><use href="#i-search"></use></svg><input type="search" name="search" value="<%= filters.search || '' %>" maxlength="100" placeholder="Filter records" aria-label="Filter records"></label><button class="plain-link" type="submit">Search</button></form><% } %>
          <% if (exportHref) { %><a class="outline-button role-export" href="<%= exportHref %>"><svg aria-hidden="true"><use href="#i-download"></use></svg>Export</a><% } %>
        </div></div>
        <% if (filters.statuses?.length) { %><nav class="role-status-tabs promoter-record-tabs" aria-label="Record status"><% for (const status of filters.statuses) { const query = new URLSearchParams(filterParams); if (status.value) query.set('status', status.value); if (filters.search) query.set('search', filters.search); %><a class="<%= String(filters.status || '') === status.value ? 'active' : '' %>" href="<%= promoterPage.href + (query.size ? '?' + query : '') %>" <%= String(filters.status || '') === status.value ? 'aria-current=page' : '' %>><%= status.label %></a><% } %></nav><% } %>
        <div class="role-table-wrap"><table class="role-table"><thead><tr><% for (const column of columns) { %><th><%= column %></th><% } %><th>Action</th></tr></thead><tbody>
        <% for (const row of rows) { const rowHref = localHref(row.href); %><tr><% for (const [index, cell] of (row.cells || []).entries()) { %><td data-label="<%= columns[index] || 'Value' %>"><% if (index === row.cells.length - 1 && /status|state|relationship/i.test(columns[index] || '')) { %><span class="role-status <%= statusTone(cell) %>"><%= displayDashboardCell(cell, row, columns[index], columns) %></span><% } else { %><span><%= displayDashboardCell(cell, row, columns[index], columns) %></span><% } %></td><% } %><td data-label="Action"><% if (rowHref) { %><a class="role-row-menu promoter-record-action" href="<%= rowHref %>" aria-label="Open <%= displayDashboardCell(row.cells?.[0] || row.id, row, columns[0], columns) %>"><%- include('record-eye-icon') %></a><% } else { %><span aria-label="No action required">—</span><% } %></td></tr><% } %>
        <% if (!rows.length) { %><tr><td colspan="<%= columns.length + 1 %>"><%= flow.emptyText || 'No records match this view yet.' %></td></tr><% } %>
        </tbody></table></div>
        <div class="role-table-footer"><span><%= rows.length %> records on this page<%= Number.isFinite(page.total) ? ' · ' + page.total + ' total' : '' %></span><div><% if (filters.after) { %><a class="plain-link" href="<%= pageLink('') %>">First</a><% } else { %><span class="promoter-page-control" aria-disabled="true">Previous</span><% } %><span class="promoter-page-control active" aria-current="page">Current</span><% if (nextHref) { %><a class="plain-link" href="<%= nextHref %>">Next</a><% } else { %><span class="promoter-page-control" aria-disabled="true">Next</span><% } %></div></div>
      </section>
      <% if (flow.kind === 'campaigns') { %><%- include('promoter-campaign-forms') %><% } else if (flow.kind === 'finance') { %><%- include('promoter-finance-forms') %><% } else if (flow.kind === 'relationships') { %><%- include('promoter-relationship-forms') %><% } %>
      <% } %>
    </div>
    <aside class="role-side-stack">
      <section class="panel role-insights"><div class="role-panel-head compact"><div><span class="eyebrow">Decision support</span><h2>What needs attention</h2></div></div><div class="role-insight-list"><% for (const [index, insight] of insights.entries()) { %><article><span><%= index + 1 %></span><p><%= typeof insight === 'string' ? insight : insight.text %></p></article><% } %><% if (!insights.length) { %><p class="form-intro">No actions need attention in this view.</p><% } %></div><% if (recommendation) { %><a class="soft-button full-button" href="<%= localHref(recommendation.href) %>"><%= recommendation.label || 'Review recommendations' %></a><% } %></section>
      <section class="panel role-progress-card"><div class="role-panel-head compact"><div><span class="eyebrow">Performance</span><h2><%= health.label || 'Workspace health' %></h2></div><strong><%= healthValue === null ? '—' : healthValue + '%' %></strong></div><div class="role-health-ring"><span><%= healthValue === null ? '—' : healthValue %><% if (healthValue !== null) { %><small>%</small><% } %></span></div><div class="role-health-rows"><% for (const row of health.rows || []) { %><div><span><%= row.label %></span><b><%= row.value ?? '—' %></b></div><% } %></div><% if (health.note) { %><p class="form-intro"><%= health.note %></p><% } %></section>
    </aside>
  </div>
  <% if (analyticsPage && columns.length) { %>
  <section class="panel role-table-panel promoter-performance-records" id="promoter-records"><div class="role-panel-head"><div><h2><%= flow.tableTitle || promoterPage.title + ' records' %></h2><p><%= flow.tableDescription || 'Recorded results for your promoter account.' %></p></div><div class="role-table-tools"><% if (flow.filters) { %><form class="promoter-compact-filter" method="get" action="<%= promoterPage.href %>"><% for (const [key, value] of filterParams) { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% } %><% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %><label class="role-mini-search"><svg aria-hidden="true"><use href="#i-search"></use></svg><input type="search" name="search" value="<%= filters.search || '' %>" maxlength="100" placeholder="Filter records" aria-label="Filter records"></label><button class="plain-link" type="submit">Search</button></form><% } %><% if (exportHref) { %><a class="outline-button role-export" href="<%= exportHref %>"><svg aria-hidden="true"><use href="#i-download"></use></svg>Export</a><% } %></div></div>
    <% if (filters.statuses?.length) { %><nav class="role-status-tabs promoter-record-tabs" aria-label="Record status"><% for (const status of filters.statuses) { const query = new URLSearchParams(filterParams); if (status.value) query.set('status', status.value); if (filters.search) query.set('search', filters.search); %><a class="<%= String(filters.status || '') === status.value ? 'active' : '' %>" href="<%= promoterPage.href + (query.size ? '?' + query : '') %>" <%= String(filters.status || '') === status.value ? 'aria-current=page' : '' %>><%= status.label %></a><% } %></nav><% } %>
    <div class="role-table-wrap"><table class="role-table"><thead><tr><% for (const column of columns) { %><th><%= column %></th><% } %><th>Action</th></tr></thead><tbody><% for (const row of rows) { const rowHref = localHref(row.href); %><tr><% for (const [index, cell] of (row.cells || []).entries()) { %><td data-label="<%= columns[index] || 'Value' %>"><% if (index === row.cells.length - 1 && /status|state|relationship/i.test(columns[index] || '')) { %><span class="role-status <%= statusTone(cell) %>"><%= displayDashboardCell(cell, row, columns[index], columns) %></span><% } else { %><span><%= displayDashboardCell(cell, row, columns[index], columns) %></span><% } %></td><% } %><td data-label="Action"><% if (rowHref) { %><a class="role-row-menu promoter-record-action" href="<%= rowHref %>" aria-label="Open <%= displayDashboardCell(row.cells?.[0] || row.id, row, columns[0], columns) %>"><%- include('record-eye-icon') %></a><% } else { %><span aria-label="No action required">—</span><% } %></td></tr><% } %><% if (!rows.length) { %><tr><td colspan="<%= columns.length + 1 %>"><%= flow.emptyText || 'No records match this view yet.' %></td></tr><% } %></tbody></table></div>
    <div class="role-table-footer"><span><%= rows.length %> records on this page<%= Number.isFinite(page.total) ? ' · ' + page.total + ' total' : '' %></span><div><% if (filters.after) { %><a class="plain-link" href="<%= pageLink('') %>">First</a><% } else { %><span class="promoter-page-control" aria-disabled="true">Previous</span><% } %><span class="promoter-page-control active" aria-current="page">Current</span><% if (nextHref) { %><a class="plain-link" href="<%= nextHref %>">Next</a><% } else { %><span class="promoter-page-control" aria-disabled="true">Next</span><% } %></div></div>
  </section>
  <% } %>
  <section class="panel role-activity-panel"><div class="role-panel-head"><div><h2>Workflow &amp; recent activity</h2><p>Keep your next operational actions in view.</p></div><% if (localHref(flow.activityHref)) { %><a class="plain-link" href="<%= localHref(flow.activityHref) %>">View all activity</a><% } %></div><div class="role-workflow-grid"><% for (const [index, item] of workflow.entries()) { %><article><span class="role-step <%= index === 0 ? 'current' : '' %>"><%= index + 1 %></span><div><strong><%= item.title %></strong><p><%= item.text %></p></div><% if (localHref(item.href)) { %><a class="plain-link" href="<%= localHref(item.href) %>"><%= item.label || 'Continue' %></a><% } %></article><% } %></div><% if (!workflow.length) { %><p class="form-intro">No workflow activity recorded yet.</p><% } %></section>
</section>
