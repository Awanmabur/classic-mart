<section class="app-page active account-service-page"><%if(flash){%><div class="dashboard-message <%=flash.type==='error'?'error':''%>"><strong><%=flash.message%></strong></div><%}%><div class="page-heading"><div><h1>Connected apps</h1><p>Review mobile sessions and push devices connected to your account.</p></div></div><div class="settings-layout"><section class="panel form-panel"><h2>Install Classic Mart</h2><p>The PWA uses the same live server data and never treats cached payment or stock state as authoritative.</p><div class="account-actions"><button class="primary-button" data-pwa-install type="button" hidden>Install Classic Mart</button><a class="plain-link" href="/app">Open app view</a></div></section><section class="panel form-panel"><h2>Push devices</h2><div class="ticket-list"><%if(!pushDevices.length){%><div class="empty-state">No push devices registered.</div><%}%><%pushDevices.forEach(device=>{%><article class="ticket-row"><div><strong><%=device.label||device.platform%></strong><p><%=device.platform%> · <%=device.status%></p></div><%if(device.status==='active'){%><form method="post" action="/account/push-devices/<%=device.publicId%>/revoke"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit">Revoke</button></form><%}%></article><%})%></div></section><section class="panel form-panel wide"><h2>Mobile sessions</h2><div class="ticket-list"><%if(!mobileSessions.length){%><div class="empty-state">No mobile API sessions are connected.</div><%}%><%mobileSessions.forEach(session=>{%><article class="ticket-row"><div><strong><%=session.deviceName%></strong><p><%=session.platform%> · last used <%=formatDate(session.lastUsedAt||session.createdAt)%></p></div><div><span class="status-pill <%=session.revokedAt?'':'good'%>"><%=session.revokedAt?'revoked':'active'%></span><%if(!session.revokedAt){%><form method="post" action="/account/apps/<%=session.publicId%>/revoke"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit">Revoke</button></form><%}%></div></article><%})%></div><%if(mobileSessionPage?.hasMore){%><p><a class="plain-link" href="/account/apps?after=<%=encodeURIComponent(mobileSessionPage.next)%>">Older sessions</a></p><%}%></section></div></section>