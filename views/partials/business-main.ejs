<%
const flow=liveBusiness.flow;
const base=businessPage.href;
const money=value=>formatMoney(Number(value||0),flow.currency);
const statusTone=value=>/^(active|approved|accepted|fulfilled|delivered|paid|completed)$/.test(value)?'good':/^(rejected|cancelled|expired|failed|revoked|void)$/.test(value)?'bad':'warn';
const link=(key,value)=>{const params=new URLSearchParams();for(const[name,current]of Object.entries(flow.filters||{}))if(current&&name!==key)params.set(name,current);if(value)params.set(key,value);return base+(params.size?'?'+params:'');};
%>
<section class="app-page active role-page business-live" data-page="<%= businessPage.id %>" data-role="business" data-page-kind="<%= businessPage.kind %>">
  <div class="page-heading role-page-heading"><div><span class="eyebrow"><%= businessPage.eyebrow %></span><h1><%= businessPage.title %></h1><p><%= businessPage.description %></p></div><% if(!flow.needsSetup&&flow.can.buy&&flow.kind!=='orders'){ %><a class="primary-button icon-button" href="/business/orders#business-procurement"><svg aria-hidden="true"><use href="#i-plus"></use></svg>New purchase request</a><% } %></div>
  <% if(flow.needsSetup){ %>
  <section class="panel role-form-section"><div class="role-panel-head"><div><h2>Set up your company</h2><p>Create your company workspace or accept an invitation from its administrator.</p></div></div><form method="post" action="/business/organizations" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Company name<input name="companyName" minlength="2" maxlength="180" autocomplete="organization" required></label><label>Billing email<input name="billingEmail" type="email" maxlength="254" autocomplete="email" required></label><div class="wide"><button class="primary-button" type="submit">Create company workspace</button></div></form></section>
  <% for(const invite of flow.invitations||[]){ %><section class="panel role-form-section"><div class="role-panel-head"><div><h2><%= invite.companyName %></h2><p>Invitation to join as <%= invite.role %>.</p></div></div><form method="post" action="/business/invitations/<%= invite.publicId %>/accept"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= invite.version %>"><button class="primary-button" type="submit">Accept invitation</button></form></section><% } %>
  <% }else{ %>
  <% if(flow.organizations.length>1){ %><form method="post" action="/business/workspace" class="role-table-tools"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Company<select name="organizationPublicId"><% for(const org of flow.organizations){ %><option value="<%= org.publicId %>" <%= org.publicId===flow.organization.publicId?'selected':'' %>><%= org.companyName %></option><% } %></select></label><button class="outline-button" type="submit">Open company</button></form><% } %>
  <% if(flow.metrics.length){ %><section class="role-metric-grid"><% for(const[index,metric]of flow.metrics.entries()){ %><article class="role-metric panel"><span class="role-metric-icon tone-<%= index%4+1 %>"><svg aria-hidden="true"><use href="#<%= ['i-clipboard','i-bag','i-wallet','i-check'][index%4] %>"></use></svg></span><div><small><%= metric.label %></small><strong><%= metric.amountMinor!==undefined?money(metric.amountMinor):metric.value %></strong><span><%= metric.detail||'' %></span></div></article><% } %></section><% } %>
  <div class="role-content-grid"><div class="role-side-stack">
    <section class="panel role-table-panel"><div class="role-panel-head"><div><h2><%= flow.kind==='overview'?'Recent purchase orders':businessPage.label %></h2><p><%= flow.organization.companyName %> · <%= flow.currency %></p></div><div class="role-table-tools"><% if(flow.exportHref){ %><a class="outline-button role-export" href="<%= flow.exportHref %>"><svg aria-hidden="true"><use href="#i-download"></use></svg>Export statement</a><% } %><% if(flow.kind==='orders'){ %><form method="get" action="<%= base %>" class="seller-compact-filter"><label class="role-mini-search"><svg aria-hidden="true"><use href="#i-search"></use></svg><input type="search" name="search" value="<%= flow.filters.search %>" maxlength="100" aria-label="Search purchase orders" placeholder="Purchase-order reference"></label><button class="plain-link" type="submit">Search</button></form><% } %></div></div>
      <% if(flow.statuses){ %><nav class="role-status-tabs seller-record-tabs" aria-label="Purchase order status"><% for(const status of flow.statuses){ %><a class="<%= flow.filters.status===status?'active':'' %>" href="<%= link('status',status) %>"><%= status?status.replaceAll('_',' '):'All' %></a><% } %></nav><% } %>
      <div class="role-table-wrap"><table class="role-table"><thead><tr><% for(const column of flow.columns){ %><th><%= column %></th><% } %><th>Action</th></tr></thead><tbody><% for(const row of flow.rows){ %><tr><% for(const[index,cell]of row.cells.entries()){ %><td data-label="<%= flow.columns[index] %>"><% if(index===row.cells.length-1){ %><span class="role-status <%= statusTone(String(cell)) %>"><%= cell %></span><% }else{ %><%= typeof cell==='object'?money(cell.amountMinor):cell %><% } %></td><% } %><td data-label="Action"><a class="plain-link" href="<%= row.href %>">View</a></td></tr><% } %><% if(!flow.rows.length){ %><tr><td colspan="<%= flow.columns.length+1 %>">No records yet.</td></tr><% } %></tbody></table></div>
      <div class="role-table-footer"><span><%= flow.rows.length %> shown · <%= flow.page.total||0 %> total</span><div><% if(flow.filters.after){ %><a class="plain-link" href="<%= link('after','') %>">First</a><% } %><% if(flow.page.next){ %><a class="plain-link" href="<%= link('after',flow.page.next) %>">Next</a><% } %></div></div>
    </section>
    <% if(flow.kind==='orders'||flow.kind==='templates'){ %><%- include('business-procurement-forms',{flow,money,link,statusTone}) %><% } %>
    <% if(flow.kind==='quotes'){ %><%- include('business-quote-forms',{flow,money,link,statusTone}) %><% } %>
    <% if(flow.kind==='invoices'){ %><%- include('business-invoice-forms',{flow,money,link,statusTone}) %><% } %>
    <% if(flow.kind==='settings'){ %><%- include('business-settings-forms',{flow,money,link,statusTone}) %><% } %>
    <% if(flow.kind==='orders'){for(const po of flow.records){ %><section class="panel role-form-section" id="<%= po.publicId %>"><div class="role-panel-head"><div><h2><%= po.poNumber %></h2><p><%= po.status.replaceAll('_',' ') %> · <%= money(po.totalMinor) %></p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>SKU</th><th>Item</th><th>Quantity</th><th>Unit price</th></tr></thead><tbody><% for(const item of po.items){ %><tr><td data-label="SKU"><%= item.sku %></td><td data-label="Item"><%= item.title %> · <%= item.variantTitle %></td><td data-label="Quantity"><%= item.quantity %></td><td data-label="Unit price"><%= money(item.unitMinor) %></td></tr><% } %></tbody></table></div><% if(po.invoicePublicId){ %><a class="plain-link" href="/business/invoices#<%= po.invoicePublicId %>">Open invoice</a><% } %><% if(po.timeline?.length){ %><div class="role-health-rows"><% for(const entry of po.timeline.slice(-5)){ %><div><span><%= entry.message %></span><b><%= new Date(entry.at).toLocaleDateString('en-GB',{timeZone:flow.timeZone}) %></b></div><% } %></div><% } %></section><% }} %>
  </div><aside class="role-side-stack"><section class="panel role-insights"><div class="role-panel-head compact"><div><span class="eyebrow">Purchasing controls</span><h2>Company workspace</h2></div></div><div class="role-insight-list"><article><span>1</span><p><%= flow.organization.companyName %></p></article><article><span>2</span><p>Your membership: <%= flow.membership.role %>.</p></article><article><span>3</span><p>Purchase requests require an independent authorized approver. Supplier quotations are reviewed before purchase orders are issued.</p></article></div><a class="soft-button full-button" href="/business/settings">Company settings</a></section><section class="panel role-progress-card"><div class="role-panel-head compact"><div><span class="eyebrow">Payment terms</span><h2><%= flow.organization.invoiceTermsApproved?'Approved credit terms':'Immediate payment' %></h2></div></div><div class="role-health-rows"><div><span>Country</span><b><%= flow.country %></b></div><div><span>Currency</span><b><%= flow.currency %></b></div><% if(flow.organization.invoiceTermsApproved){ %><div><span>Credit limit</span><b><%= money(flow.organization.creditLimitMinor) %></b></div><div><span>Terms</span><b><%= flow.organization.invoiceTermsDays %> days</b></div><% } %></div></section></aside></div>
  <section class="panel role-activity-panel"><div class="role-panel-head"><div><h2>Company purchasing workflow</h2><p>Follow every purchase through approval, payment and verified delivery.</p></div></div><div class="role-workflow-grid"><article><span class="role-step current">1</span><div><strong>Request and approve</strong><p>Choose published SKUs and a budget. Another authorized member reviews the request.</p></div><a class="plain-link" href="/business/orders">Orders</a></article><article><span class="role-step">2</span><div><strong>Review supplier offer</strong><p>Check exact prices, quantities and validity before issuing the purchase order.</p></div><a class="plain-link" href="/business/quotes">Quotations</a></article><article><span class="role-step">3</span><div><strong>Pay and track delivery</strong><p>Supplier acceptance reserves real stock. Private documents follow verified fulfilment.</p></div><a class="plain-link" href="/business/invoices">Invoices</a></article></div></section>
  <% } %>
</section>
