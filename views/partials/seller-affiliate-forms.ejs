<% const flow = pageFlow; %>
<section class="panel role-form-section" id="sellerAffiliateEditor"><div class="role-panel-head compact"><div><span class="eyebrow">Affiliate marketing</span><h2>Create campaign</h2></div></div><form class="role-create-form" method="post" action="/seller/affiliate/campaigns"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><%- include('seller-affiliate-editor-fields', { draft: {} }) %>
<details class="faq-item"><summary>Approved store products</summary><% for (const product of flow.products) { %><p class="form-intro"><%= product.title %> · <%= product.publicId %></p><% } %></details><div class="role-create-actions"><button class="primary-button" type="submit">Save draft</button></div></form></section>
<% for (const campaign of flow.campaigns) { %><section class="panel role-form-section" id="campaign-<%= campaign.publicId %>"><div class="role-panel-head compact"><div><h2><%= campaign.name %></h2><p><%= campaign.status %> · <%= campaign.commissionBps / 100 %>% commission</p></div></div><p class="form-intro"><%= campaign.disclosureText %></p><% if (campaign.reviewReason) { %><p class="form-intro">Review: <%= campaign.reviewReason %></p><% } %><% if (['draft', 'rejected'].includes(campaign.status)) { %><details class="faq-item"><summary>Edit campaign draft</summary><form class="role-create-form" method="post" action="/seller/affiliate/campaigns/<%= campaign.publicId %>/edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= campaign.version %>"><%- include('seller-affiliate-editor-fields', { draft: campaign }) %><div class="role-create-actions"><button class="primary-button" type="submit">Save changes</button></div></form></details><% } %><form class="role-create-form" method="post" action="/seller/affiliate/campaigns/<%= campaign.publicId %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= campaign.version %>"><div class="role-create-actions"><% if (['draft', 'rejected'].includes(campaign.status)) { %><button class="primary-button" type="submit" name="action" value="submit">Submit for review</button><% } %><% if (campaign.canResume) { %><button class="primary-button" name="action" value="resume" type="submit">Resume campaign</button><% } %><% if (campaign.status === 'active') { %><button class="outline-button" type="submit" name="action" value="pause">Pause campaign</button><% } %><% if (campaign.status !== 'ended') { %><button class="outline-button" type="submit" name="action" value="end">End campaign</button><% } %></div></form></section><% } %>
<section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Promoter applications</h2><p>Review each verified promoter independently.</p></div></div><% for (const application of flow.applications) { %><h3><%= application.campaignPublicId %> · <%= application.status %></h3><p class="form-intro"><%= application.note %></p><% if (['pending', 'approved'].includes(application.status)) { %><form class="role-create-form" method="post" action="/seller/affiliate/applications/<%= application.publicId %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= application.version %>"><div class="role-create-grid"><label class="role-create-field wide">Decision reason<input name="reason" minlength="3" maxlength="500" required></label></div><div class="role-create-actions"><% if (application.status === 'pending') { %><button class="primary-button" name="decision" value="approve" type="submit">Approve</button><button class="outline-button" name="decision" value="reject" type="submit">Reject</button><% } else { %><button class="outline-button" name="decision" value="revoke" type="submit">Revoke</button><% } %></div></form><% } %><% } %><div class="role-table-footer"><span><%= flow.applicationsPage.total %> applications</span><% if (flow.applicationsPage.next) { %><a class="plain-link" href="/seller/affiliate?applicationsAfter=<%= encodeURIComponent(flow.applicationsPage.next) %>">Next applications</a><% } %></div></section>
