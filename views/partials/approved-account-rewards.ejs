<section class="app-page active account-service-page"><%if(flash){%><div class="dashboard-message <%=flash.type==='error'?'error':''%>"><strong><%=flash.message%></strong></div><%}%><div class="page-heading"><div><h1>Rewards &amp; referrals</h1><p>Server-calculated points and referral rewards from verified marketplace activity.</p></div></div><div class="settings-layout"><section class="panel form-panel"><h2>Points balance</h2><p style="font-size:34px;margin:12px 0"><strong><%=account?.points||0%></strong></p><p>Tier: <strong><%=account?.tier||'classic'%></strong> · Lifetime earned: <%=account?.lifetimeEarned||0%></p></section><section class="panel form-panel"><h2>Your referral code</h2><p style="font-size:24px"><strong><%=referral.code%></strong></p><p>Share this code with a new shopper. Rewards are issued only after their first verified paid order.</p></section><section class="panel form-panel"><h2>Redeem gift card</h2><form class="dashboard-form" method="post" action="/account/rewards/gift-card"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Gift card code<input name="code" autocomplete="off" required maxlength="80"></label><button class="primary-button" type="submit">Redeem</button></form></section><section class="panel form-panel"><h2>Referral activity</h2><div class="ticket-list"><%if(!referrals.length){%><div class="empty-state">No referred shoppers have joined yet.</div><%}%><%referrals.forEach(row=>{%><article class="ticket-row"><div><strong><%=row.referredUserId?.name||'Referred shopper'%></strong><p><%=row.status%> · <%=row.referrerRewardPoints||0%> points</p></div></article><%})%></div><%if(queuePages?.referrals?.hasMore){%><p><a class="plain-link" href="/account/rewards?referralsAfter=<%=encodeURIComponent(queuePages.referrals.next)%>">Older referrals</a></p><%}%></section><section class="panel form-panel wide"><h2>Reward history</h2><div style="overflow-x:auto"><table class="account-table"><thead><tr><th>Date</th><th>Type</th><th>Change</th><th>Balance</th><th>Reference</th></tr></thead><tbody><%if(!entries.length){%><tr><td colspan="5">No reward activity yet.</td></tr><%}%><%entries.forEach(row=>{%><tr><td><%=formatDate(row.createdAt)%></td><td><%=row.type.replaceAll('_',' ')%></td><td><%=row.pointsDelta>0?'+':''%><%=row.pointsDelta%></td><td><%=row.balanceAfter%></td><td><%=row.referencePublicId||'—'%></td></tr><%})%></tbody></table></div><%if(queuePages?.entries?.hasMore){%><p><a class="plain-link" href="/account/rewards?entriesAfter=<%=encodeURIComponent(queuePages.entries.next)%>">Older activity</a></p><%}%></section></div></section>