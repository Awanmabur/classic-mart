<section class="panel role-form-section" id="invite-team"><div class="role-panel-head"><div><h2>Invite a team member</h2><p>The recipient verifies their email and accepts before access begins.</p></div></div>
<form class="role-create-form" method="post" action="/seller/team/invitations"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="role-create-field">Email address<input name="email" type="email" maxlength="254" autocomplete="email" required></label><label class="role-create-field">Store role<select name="role" required><% for (const role of flow.roleOptions) { %><option value="<%= role %>"><%= role %></option><% } %></select></label><div class="role-create-actions"><button class="primary-button" type="submit">Send invitation</button></div></form></section>
<% for (const member of flow.members.filter(row => row.canManage)) { %><section class="panel role-form-section" id="member-<%= member.publicId %>"><div class="role-panel-head"><div><h2><%= member.name %></h2><p>Current role: <%= member.role %></p></div></div><form class="role-create-form" method="post" action="/seller/team/members/<%= member.publicId %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= member.version %>"><label class="role-create-field">Store role<select name="role" required><% for (const role of flow.roleOptions) { %><option value="<%= role %>" <%= member.role === role ? 'selected' : '' %>><%= role %></option><% } %></select></label><div class="role-create-actions"><button class="primary-button" name="action" value="role" type="submit">Update role</button><button class="outline-button" name="action" value="revoke" type="submit">Revoke access</button></div></form></section><% } %>
<section class="panel role-form-section"><div class="role-panel-head"><div><h2>Invitations</h2><p>Only pending invitations reserve seats.</p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Recipient</th><th>Role</th><th>Status</th><th>Action</th></tr></thead><tbody><% for (const invitation of flow.invitations) { %><tr><td><%= invitation.emailMasked %></td><td><%= invitation.role %></td><td><%= invitation.status %></td><td><% if (invitation.status === 'pending' && flow.roleOptions.includes(invitation.role)) { %><form method="post" action="/seller/team/invitations/<%= invitation.publicId %>/revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= invitation.version %>"><button class="plain-link" type="submit">Revoke</button></form><% } %></td></tr><% } %></tbody></table></div><div class="role-table-footer"><span><%= flow.invitationsPage.total %> invitations</span><% if (flow.invitationsPage.next) { %><a class="plain-link" href="/seller/team?invitationsAfter=<%= encodeURIComponent(flow.invitationsPage.next) %>">Next invitations</a><% } %></div></section>
