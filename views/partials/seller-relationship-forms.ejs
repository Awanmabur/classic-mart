<%
const relationshipFlow = typeof pageFlow !== 'undefined' ? pageFlow : liveSeller.pageFlow;
const relationshipRecord = relationshipFlow.selected;
const relationshipDraft = relationshipFlow.draft || {};
const relationshipKind = relationshipFlow.relationshipKind;
const relationshipStatus = value => String(value || '').replaceAll('_', ' ').replace(/\b\w/g, value => value.toUpperCase());
%>
<% if (relationshipKind === 'messages') { %>
  <div class="seller-verification-actions"><a class="outline-button" href="/seller/messages">Customer Conversations</a><a class="outline-button" href="/seller/messages?tab=questions">Product Questions</a><% if (user.role === 'seller' && liveSeller.store?.status === 'verified' && String(liveSeller.store.ownerUserId) === String(user._id)) { %><a class="outline-button" href="/seller/promoter-messages">Promoter Conversations</a><% } %></div>
<% } %>
<% if (!relationshipFlow.editable) { %><p class="form-intro">Complete store verification before sending messages or updating support records.</p><% } %>
<% if (relationshipRecord) { %>
  <section class="panel form-panel" aria-label="Selected <%= relationshipKind === 'messages' ? 'conversation or question' : relationshipKind.slice(0, -1) %>">
    <% if (relationshipKind === 'returns') { const returnPath = '/seller/returns/' + encodeURIComponent(relationshipRecord.publicId); %>
      <div class="role-panel-head"><div><h2>Return <%= relationshipRecord.publicId %></h2><p class="form-intro"><%= relationshipRecord.returnPublicId %> · <%= relationshipRecord.orderPublicId %></p></div><span class="status-pill"><%= relationshipStatus(relationshipRecord.status) %></span></div>
      <p class="form-intro">Marketplace return: <%= relationshipStatus(relationshipRecord.returnStatus) %> · <%= relationshipStatus(relationshipRecord.reason) %> · Requested <%= relationshipRecord.resolution || 'resolution unavailable' %></p>
      <% for (const item of relationshipRecord.items) { %><p><strong><%= item.title %></strong> · <%= item.sku %> · Quantity <%= item.quantity %><br><small>Inspection: <%= relationshipStatus(item.inspectionStatus) %><%= item.stockDisposition ? ' · ' + relationshipStatus(item.stockDisposition) : '' %> · Inspected quantity <%= item.inspectedQuantity %></small></p><% } %>
      <% if (relationshipRecord.responseMessage) { %><p><strong>Saved seller response:</strong> <%= relationshipRecord.responseMessage %></p><% } %>
      <% if (relationshipRecord.sellerOrderPublicId && relationshipFlow.canViewOrders) { %><a class="plain-link" href="/seller/orders/<%= encodeURIComponent(relationshipRecord.sellerOrderPublicId) %>">View Seller Order</a><% } %>
      <% if (relationshipRecord.status !== 'resolved' && relationshipFlow.editable) { %>
        <form class="role-form-section" method="post" action="<%= returnPath %>/respond"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= relationshipRecord.version %>">
          <div class="role-form-grid"><label>Return response<select name="action" required><% for (const action of ['acknowledged','contested','escalated']) { %><option value="<%= action %>" <%= relationshipDraft.action === action ? 'selected' : '' %>><%= relationshipStatus(action) %></option><% } %></select></label><label class="wide">Explanation<textarea name="message" rows="4" maxlength="2000"><%= relationshipDraft.message || '' %></textarea><small>Contested and escalated responses require at least 10 characters.</small></label></div><button class="primary-button" type="submit">Record Return Response</button>
        </form>
        <form class="role-form-section" method="post" action="<%= returnPath %>/evidence" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= relationshipRecord.version %>"><h3>Add private evidence</h3><div class="role-form-grid"><label>Evidence image<input type="file" name="document" accept="image/jpeg,image/png,image/webp,image/avif" required><small>Maximum 8 MB. At least 320 × 320 pixels.</small></label><label>Description<input name="description" maxlength="300" value="<%= relationshipDraft.description || '' %>"></label></div><button class="outline-button" type="submit">Upload Return Evidence</button></form>
      <% } %>
      <% for (const evidence of relationshipRecord.evidence || []) { %><p><a class="plain-link" href="/evidence/<%= encodeURIComponent(evidence.publicId) %>" target="_blank" rel="noopener">View <%= evidence.description || 'private seller evidence' %></a></p><% } %>
      <p class="form-intro">Marketplace support decides refunds and exchanges. Your response and evidence are recorded on this case.</p>
    <% } else if (relationshipKind === 'customers') { %>
      <div class="role-panel-head"><div><h2><%= relationshipRecord.name %></h2><p class="form-intro"><%= relationshipRecord.orderCount %> store orders · <%= relationshipRecord.registered ? 'Registered buyer' : 'Guest buyer' %></p></div></div>
      <p><%= relationshipRecord.email %> · <%= relationshipRecord.phone %></p><h3>Recent store orders</h3>
      <% for (const order of relationshipRecord.orders) { %><p><% if (relationshipFlow.canViewOrders) { %><a class="plain-link" href="/seller/orders/<%= encodeURIComponent(order.publicId) %>"><%= order.publicId %></a><% } else { %><strong><%= order.publicId %></strong><% } %> · <%= order.value %> · <%= relationshipStatus(order.status) %></p><% } %>
      <% if (relationshipFlow.editable) { %><form class="role-form-section" method="post" action="/seller/customers/<%= encodeURIComponent(relationshipRecord.contactOrderId) %>/contact"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h3>Send order support message</h3><p class="form-intro">Recipient: <%= relationshipRecord.contactEmail %>, recorded on order <%= relationshipRecord.contactOrderId %>. Messages are queued for email delivery.</p><div class="role-form-grid"><label class="wide">Subject<input name="subject" value="<%= relationshipDraft.subject || '' %>" minlength="2" maxlength="160" required></label><label class="wide">Message<textarea name="message" rows="4" minlength="10" maxlength="2000" required><%= relationshipDraft.message || '' %></textarea></label></div><button class="primary-button" type="submit">Send Order Message</button></form><% } %>
    <% } else if (relationshipKind === 'reviews') { %>
      <div class="role-panel-head"><div><h2><%= relationshipRecord.productTitle %></h2><p class="form-intro"><%= relationshipRecord.rating %> / 5 · <%= relationshipRecord.verifiedPurchase ? 'Verified purchase' : 'Purchase verification unavailable' %></p></div><span class="status-pill"><%= relationshipStatus(relationshipRecord.status) %></span></div>
      <% if (relationshipRecord.title) { %><h3><%= relationshipRecord.title %></h3><% } %><p><%= relationshipRecord.body %></p>
      <% if (relationshipRecord.disputeReason) { %><p><strong>Dispute reason:</strong> <%= relationshipRecord.disputeReason %></p><% } %><% if (relationshipRecord.moderationReason) { %><p><strong>Moderation note:</strong> <%= relationshipRecord.moderationReason %></p><% } %>
      <% if (relationshipRecord.status === 'published' && relationshipFlow.editable) { %><form class="role-form-section" method="post" action="/seller/reviews/<%= encodeURIComponent(relationshipRecord.publicId) %>/dispute"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= relationshipRecord.version %>"><div class="role-form-grid"><label class="wide">Reason for dispute<textarea name="reason" rows="4" minlength="10" maxlength="1000" required><%= relationshipDraft.reason || '' %></textarea></label></div><button class="outline-button" type="submit">Submit Review Dispute</button></form><% } %>
    <% } else if (relationshipKind === 'messages' && relationshipFlow.tab === 'questions') { %>
      <div class="role-panel-head"><div><h2>Product question</h2><p class="form-intro"><%= relationshipRecord.productPublicId %></p></div><span class="status-pill"><%= relationshipStatus(relationshipRecord.status) %></span></div><p><%= relationshipRecord.question %></p>
      <% if (relationshipRecord.answer) { %><p><strong>Published answer:</strong> <%= relationshipRecord.answer %></p><% } %>
      <% if (relationshipRecord.status === 'open' && relationshipFlow.editable) { %><form method="post" action="/seller/messages/questions/<%= encodeURIComponent(relationshipRecord.publicId) %>/answer"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= relationshipRecord.version %>"><div class="role-form-grid"><label class="wide">Your answer<textarea name="answer" rows="4" minlength="2" maxlength="2000" required><%= relationshipDraft.answer || '' %></textarea></label></div><button class="primary-button" type="submit">Publish Answer</button></form><% } %>
    <% } else if (relationshipKind === 'messages') { const threadPath = '/seller/messages/' + encodeURIComponent(relationshipRecord.publicId); %>
      <div class="role-panel-head"><div><h2><%= relationshipRecord.subject %></h2><p class="form-intro"><%= relationshipRecord.publicId %></p></div><span class="status-pill"><%= relationshipStatus(relationshipRecord.status) %></span></div><p><strong>Customer:</strong> <%= relationshipRecord.message %></p>
      <% for (const reply of relationshipRecord.replies) { %><p><strong><%= reply.sender === 'seller' ? 'Seller' : 'Customer' %>:</strong> <%= reply.body %></p><% } %>
      <% if (relationshipRecord.status !== 'resolved' && relationshipFlow.editable) { %><form method="post" action="<%= threadPath %>/reply"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= relationshipRecord.version %>"><div class="role-form-grid"><label class="wide">Reply to customer<textarea name="message" rows="4" minlength="2" maxlength="2000" required><%= relationshipDraft.message || '' %></textarea></label></div><button class="primary-button" type="submit">Send Reply</button></form><form class="role-form-section" method="post" action="<%= threadPath %>/resolve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= relationshipRecord.version %>"><button class="outline-button" type="submit">Resolve Conversation</button></form><% } %>
    <% } %>
  </section>
<% } else if (relationshipFlow.records.length) { %><p class="form-intro">Select a row to view details and available actions.</p><% } %>
