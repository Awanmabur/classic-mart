<% if(flow.can.quotes){ %><section class="panel role-form-section"><div class="role-panel-head"><div><h2>Request a supplier quotation</h2><p>Choose a supplier from an independently approved procurement request.</p></div></div><% for(const target of flow.quoteTargets){ %><form method="post" action="/business/quotes" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="procurementRequestId" value="<%= target.requestPublicId %>"><input type="hidden" name="version" value="<%= target.requestVersion %>"><input type="hidden" name="storeId" value="<%= target.storePublicId %>"><p class="wide form-intro"><strong><%= target.requestTitle %></strong> · <%= target.storePublicId %></p><label class="wide">Message to supplier<input name="message" maxlength="2000" value="Please quote the approved items and quantities."></label><div class="wide"><button class="primary-button" type="submit">Request quotation</button></div></form><% } %><% if(!flow.quoteTargets.length){ %><p class="form-intro">Approve a purchase request before requesting a supplier quotation.</p><% } %><% if(flow.requestPage.next){ %><a class="plain-link" href="<%= link('requestsAfter',flow.requestPage.next) %>">More approved requests</a><% } %></section><% } %>
<% for(const quote of flow.records){ %><section class="panel role-form-section" id="<%= quote.publicId %>"><div class="role-panel-head"><div><h2><%= quote.publicId %></h2><p><%= quote.status %> · Offer <%= money(quote.offeredTotalMinor) %> · Approved maximum <%= money(quote.approvedAmountMinor) %><% if(quote.validUntil){ %> · Valid until <%= new Date(quote.validUntil).toLocaleString('en-GB',{timeZone:flow.timeZone}) %><% } %></p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>SKU</th><th>Item</th><th>Quantity</th><th>Offered unit price</th></tr></thead><tbody><% for(const line of quote.items){ %><tr><td data-label="SKU"><%= line.sku %></td><td data-label="Item"><%= line.title %> · <%= line.variantTitle %></td><td data-label="Quantity"><%= line.quantity %></td><td data-label="Offered unit price"><%= quote.revision?money(line.offeredUnitMinor):'Awaiting supplier offer' %></td></tr><% } %></tbody></table></div><% for(const message of quote.messages.slice(-5)){ %><p class="form-intro"><strong><%= message.actorType==='seller'?'Supplier':'Company' %>:</strong> <%= message.message %></p><% } %><% if(flow.can.quotes&&['requested','responded','negotiating'].includes(quote.status)){ %><form method="post" action="/business/quotes/<%= quote.publicId %>/reply" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= quote.version %>"><label class="wide">Reply to supplier<textarea name="message" maxlength="2000" required></textarea></label><div class="wide"><button class="outline-button" type="submit">Send reply</button></div></form><% } %><% if(flow.can.po&&quote.status==='responded'&&new Date(quote.validUntil)>new Date()){ %><form method="post" action="/business/quotes/<%= quote.publicId %>/accept" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= quote.version %>"><label>Payment terms<select name="paymentTerms"><option value="immediate">Immediate Pesapal payment</option><% if(flow.organization.invoiceTermsApproved){ %><option value="credit">Approved <%= flow.organization.invoiceTermsDays %>-day credit</option><% } %></select></label><div><button class="primary-button" type="submit">Review and issue purchase order</button></div></form><% } %></section><% } %>
