<% const payoutFlow=financeFlow; const selectedPayout=payoutFlow.selected; const payoutCountry=payoutFlow.context?.country||''; const scopedAction=(path)=>path+(payoutCountry?'?country='+encodeURIComponent(payoutCountry):''); %>
<nav class="role-tabs finance-payout-tabs" aria-label="Payout operations">
  <% for(const tab of payoutFlow.tabs||[]) { %><a href="<%= tab.href %>" class="role-tab <%= tab.active?'active':'' %>" aria-current="<%= tab.active?'page':'false' %>"><%= tab.label %><% if(tab.id==='destinations'&&payoutFlow.destinationPending) { %> (<%= payoutFlow.destinationPending %>)<% } %><% if(tab.id==='appeals'&&payoutFlow.appealPending) { %> (<%= payoutFlow.appealPending %>)<% } %></a><% } %>
</nav>
<% if(selectedPayout) { %>
<section class="panel role-form-section" id="finance-payout-review">
  <div class="role-panel-head"><div><h2><%= selectedPayout.type==='payout'?'Payout review':selectedPayout.type==='destination'?'Destination review':'Commission appeal review' %></h2><p><%= selectedPayout.publicId %> · <%= selectedPayout.country %> · <%= selectedPayout.currency %></p></div></div>
  <% if(selectedPayout.type==='payout') { const payout=selectedPayout; %>
  <dl class="finance-record-details"><div><dt>Status</dt><dd><%= payout.status %></dd></div><div><dt>Reserved amount</dt><dd><%= formatMoney(payout.amountMinor,payout.currency) %></dd></div><div><dt>Destination</dt><dd><%= payout.destination.label %> · <%= payout.destination.method.replaceAll('_',' ') %></dd></div><% if(payout.submissionAttemptId) { %><div><dt>Transfer attempt</dt><dd><%= payout.submissionAttemptId %></dd></div><% } %><% if(payout.providerReference) { %><div><dt>External reference</dt><dd><%= payout.providerReference %></dd></div><% } %></dl>
  <% if(payout.ambiguityReason) { %><p class="form-intro">Uncertain outcome: <%= payout.ambiguityReason %></p><% } %><% if(payout.failureMessage) { %><p class="form-intro"><%= payout.failureMessage %></p><% } %>
  <% for(const action of ['approve','reject']) { if(payout.actions[action]) { %><form method="post" action="<%= scopedAction('/finance/payouts/'+payout.publicId+'/'+action) %>" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= payout.version %>"><label class="wide"><%= action==='approve'?'Approval evidence':'Rejection reason' %><textarea name="reason" minlength="3" maxlength="300" required></textarea></label><div class="wide"><button class="<%= action==='approve'?'primary-button':'outline-button' %>" type="submit"><%= action==='approve'?'Approve reserved payout':'Reject and release funds' %></button></div></form><% } } %>
  <% if(payout.actions.submit) { %><form method="post" action="<%= scopedAction('/finance/payouts/'+payout.publicId+'/submit') %>" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= payout.version %>"><p class="wide form-intro">Claim the transfer before sending money. This records one external transfer attempt; it does not send money automatically. Another operator must reconcile the final outcome.</p><div class="wide"><button class="primary-button" type="submit">Claim external transfer</button></div></form><% } %>
  <% if(payout.actions.reveal) { %><form method="post" action="<%= scopedAction('/finance/payouts/'+payout.publicId+'/destination') %>" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><p class="wide form-intro">Open the verified destination only when you are ready to perform this recorded transfer. Access is audited.</p><div class="wide"><button class="outline-button" type="submit">Open transfer destination</button></div></form><% } %>
  <% if(payoutFlow.revealedDestination) { const destination=payoutFlow.revealedDestination; %><dl class="finance-record-details"><% for(const [key,label] of [['beneficiaryName','Beneficiary name'],['bank','Bank'],['accountNumber','Account number'],['network','Mobile-money network'],['phone','Mobile-money number']]) { if(destination[key]) { %><div><dt><%= label %></dt><dd><%= destination[key] %></dd></div><% } } %></dl><% } %>
  <% if(payout.actions.confirm) { %><form method="post" action="<%= scopedAction('/finance/payouts/'+payout.publicId+'/submission-confirm') %>" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= payout.version %>"><input type="hidden" name="submissionAttemptId" value="<%= payout.submissionAttemptId %>"><label class="wide">Actual external transfer reference<input name="reference" minlength="4" maxlength="180" required autocomplete="off"></label><p class="wide form-intro">Record the reference from the transfer you performed. It stays attached to this attempt.</p><div class="wide"><button class="primary-button" type="submit">Record transfer submission</button></div></form><% } %>
  <% if(payout.actions.unknown) { %><form method="post" action="<%= scopedAction('/finance/payouts/'+payout.publicId+'/unknown') %>" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= payout.version %>"><input type="hidden" name="submissionAttemptId" value="<%= payout.submissionAttemptId %>"><label class="wide">Why is the transfer outcome uncertain?<textarea name="reason" minlength="8" maxlength="400" required></textarea></label><p class="wide form-intro">Funds remain reserved. Check this same attempt; do not submit a second transfer.</p><div class="wide"><button class="outline-button" type="submit">Record uncertain outcome</button></div></form><% } %>
  <% if(payout.actions.reconcile) { %><form method="post" action="<%= scopedAction('/finance/payouts/'+payout.publicId+'/reconcile') %>" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= payout.version %>"><input type="hidden" name="submissionAttemptId" value="<%= payout.submissionAttemptId %>"><label>Verified final outcome<select name="outcome" required><option value="paid">Paid to beneficiary</option><option value="failed">Failed — no funds disbursed</option></select></label><label>External reference<input name="reference" minlength="4" maxlength="180" value="<%= payout.providerReference %>" <%= payout.providerReference?'readonly':'' %> required autocomplete="off"></label><label class="wide">Independent external evidence<textarea name="message" minlength="8" maxlength="400" required></textarea></label><p class="wide form-intro">Confirm the actual external outcome independently. Paid settles the reserved liability; failed restores the owner’s available funds.</p><div class="wide"><button class="primary-button" type="submit">Reconcile verified outcome</button></div></form><% } %>
  <% } else if(selectedPayout.type==='destination') { const account=selectedPayout; %>
  <dl class="finance-record-details"><div><dt>Destination label</dt><dd><%= account.label %></dd></div><div><dt>Method</dt><dd><%= account.method.replaceAll('_',' ') %></dd></div><div><dt>Owner type</dt><dd><%= account.ownerType %></dd></div><div><dt>Status</dt><dd><%= account.status %></dd></div></dl>
  <% if(account.canReview) { %><form method="post" action="<%= scopedAction('/finance/payouts/destinations/'+account.publicId+'/review') %>" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= account.version %>"><label>Decision<select name="decision" required><option value="verify">Verify destination</option><option value="reject">Reject destination</option></select></label><label class="wide">Verification evidence or rejection reason<textarea name="reason" minlength="3" maxlength="400" required></textarea></label><p class="wide form-intro">Record your independent verification evidence. Reject incomplete or unsupported destinations; verified destinations become eligible for payout requests.</p><div class="wide"><button class="primary-button" type="submit">Record destination review</button></div></form><% } %>
  <% } else { const appeal=selectedPayout; %>
  <dl class="finance-record-details"><div><dt>Order</dt><dd><%= appeal.orderPublicId %></dd></div><div><dt>Campaign</dt><dd><%= appeal.campaignName %></dd></div><div><dt>Reversed commission</dt><dd><%= formatMoney(appeal.reversedAmountMinor,appeal.currency) %></dd></div><div><dt>Appeal status</dt><dd><%= appeal.appeal.status %></dd></div></dl><p class="form-intro"><%= appeal.appeal.message %></p><% if(appeal.appeal.decision) { %><p class="form-intro">Review decision: <%= appeal.appeal.decision %></p><% } %>
  <% if(appeal.canReview) { %><form method="post" action="<%= scopedAction('/finance/payouts/appeals/'+appeal.publicId+'/review') %>" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= appeal.version %>"><label>Decision<select name="decision" required><option value="accept">Accept appeal</option><option value="reject">Reject appeal</option></select></label><label class="wide">Review reason<textarea name="reason" minlength="3" maxlength="1200" required></textarea></label><p class="wide form-intro"><%= appeal.payablePosted?'An accepted appeal restores the reversed posted commission to the promoter ledger.':'This commission has not entered the ledger. An accepted appeal restores its estimate without creating withdrawable funds.' %></p><div class="wide"><button class="primary-button" type="submit">Record appeal decision</button></div></form><% } %>
  <% } %>
  <% if(selectedPayout.history?.length) { %><div class="role-panel-head"><h3>Recorded decisions</h3></div><ul class="finance-decision-history"><% for(const event of selectedPayout.history) { %><li><span><%= event.action %></span><small><%= event.operator %> · <%= formatDate(event.at) %></small></li><% } %></ul><% } %>
</section>
<% } else { %><p class="form-intro">Open a reference in the table to review its recorded details and available actions.</p><% } %>
