<% const reconciliationFlow=typeof financeFlow!=='undefined'?financeFlow:flow; const selectedRecord=reconciliationFlow.selected; %>
<% if (reconciliationFlow.tabs?.length) { %><nav class="role-tabs finance-payout-tabs" aria-label="Reconciliation reports"><% for(const tab of reconciliationFlow.tabs){ %><a href="<%= tab.href %>" class="role-tab <%= tab.active?'active':'' %>" aria-current="<%= tab.active?'page':'false' %>"><%= tab.label %></a><% } %></nav><% } %>
<% if(reconciliationFlow.pageId==='finance-reconciliation'&&reconciliationFlow.view==='runs'){ %>
  <section class="panel role-form-section"><div class="role-panel-head compact"><div><span class="eyebrow">Provider truth</span><h2>Run Payment Reconciliation</h2></div></div>
    <p class="form-intro">Compare saved payments with Pesapal. Each country uses its configured currency; provider credentials must be available.</p>
    <form class="role-create-form" method="post" action="/finance/reconciliation/runs"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="role-create-grid"><label class="role-create-field">Country *<select name="country" required><option value="">Select country</option><% for(const country of reconciliationFlow.context?.countries||reconciliationFlow.countries||[]){ %><option value="<%= country.code %>" <%= reconciliationFlow.country===country.code?'selected':'' %>><%= country.name %> · <%= country.currency %></option><% } %></select></label><label class="role-create-field">Look-back hours *<input name="hours" type="number" min="1" max="168" step="1" value="24" required></label></div>
      <div class="role-create-actions"><button class="primary-button" type="submit">Run Reconciliation</button></div>
    </form>
  </section>
<% } %>
<% if(selectedRecord){ %>
  <section class="panel role-form-section" id="financeRecord"><div class="role-panel-head compact"><div><span class="eyebrow"><%= selectedRecord.publicId %></span><h2><%= reconciliationFlow.pageId==='finance-disputes'?'Dispute Review':reconciliationFlow.view==='cod'?'Cash Handover':reconciliationFlow.view==='events'?'Provider Event':'Reconciliation Run' %></h2></div><span class="role-status"><%= selectedRecord.status %></span></div>
    <p class="form-intro">Country: <%= selectedRecord.country %><% if(selectedRecord.orderPublicId){ %> · Order: <%= selectedRecord.orderPublicId %><% } %><% if(selectedRecord.currency){ %> · Currency: <%= selectedRecord.currency %><% } %></p>
    <% if(reconciliationFlow.pageId==='finance-disputes'){ %>
      <% if(selectedRecord.reviewNote){ %><p class="form-intro"><strong>Review note:</strong> <%= selectedRecord.reviewNote %></p><% } %><% if(selectedRecord.resolutionNote){ %><p class="form-intro"><strong>Resolution note:</strong> <%= selectedRecord.resolutionNote %></p><% } %>
      <% if(selectedRecord.status==='open'){ %><form class="role-create-form" method="post" action="/finance/disputes/<%= encodeURIComponent(selectedRecord.publicId) %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="role-create-field wide">Review note *<textarea name="note" minlength="5" maxlength="500" rows="3" required></textarea></label><div class="role-create-actions"><button class="primary-button" type="submit">Start Review</button></div></form><% } %>
      <% if(selectedRecord.status==='reviewing'&&selectedRecord.canResolve){ %><form class="role-create-form" method="post" action="/finance/disputes/<%= encodeURIComponent(selectedRecord.publicId) %>/resolve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><p class="form-intro">A fresh Pesapal check must confirm completed payment for a win or reversed payment for a loss. Funds stay protected if verification fails.</p><div class="role-create-grid"><label class="role-create-field">Verified outcome *<select name="outcome" required><option value="">Select outcome</option><option value="won">Won · provider confirms completed payment</option><option value="lost">Lost · provider confirms reversal</option></select></label><label class="role-create-field wide">Resolution note *<textarea name="note" minlength="5" maxlength="500" rows="3" required></textarea></label></div><div class="role-create-actions"><button class="primary-button" type="submit">Verify &amp; Resolve</button></div></form><% }else if(selectedRecord.status==='reviewing'){ %><p class="form-intro">Another Finance operator must resolve this review.</p><% } %>
    <% }else if(reconciliationFlow.view==='events'&&['failed','dead','ignored'].includes(selectedRecord.status)){ %>
      <form class="role-create-form" method="post" action="/finance/reconciliation/events/<%= encodeURIComponent(selectedRecord.publicId) %>/replay"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><p class="form-intro">Replay requires a matched payment, tracking reference and order country. The worker checks Pesapal before changing payment state.</p><label class="role-create-field wide">Replay reason *<textarea name="reason" minlength="5" maxlength="300" rows="3" required></textarea></label><div class="role-create-actions"><button class="primary-button" type="submit">Queue Verification</button></div></form>
    <% }else if(reconciliationFlow.view==='cod'){ %>
      <p class="form-intro">Handover receipt: <%= selectedRecord.hasHandoverReceipt?'Recorded':'Missing' %> · Amount mismatch: <%= selectedRecord.hasMismatch?'Open exception':'None recorded' %></p>
      <% if(selectedRecord.canReconcile){ %><form method="post" action="/finance/reconciliation/cod/<%= encodeURIComponent(selectedRecord.publicId) %>/reconcile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="role-create-actions"><button class="primary-button" type="submit">Verify &amp; Reconcile Cash</button></div></form><% }else{ %><p class="form-intro"><%= selectedRecord.status==='reconciled'?'The cash has already been posted to the ledger.':'Complete the handover evidence and resolve any amount mismatch before a different Finance operator reconciles the cash.' %></p><% } %>
    <% }else if(reconciliationFlow.view==='runs'){ %><p class="form-intro">Checked: <%= selectedRecord.checked %> · Matched: <%= selectedRecord.matched %> · Updated: <%= selectedRecord.updated %> · Exceptions: <%= selectedRecord.failed %></p><% } %>
  </section>
<% } %>
