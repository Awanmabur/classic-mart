<% const displayDashboardCell = (value, row, column, columns) => typeof dashboardDisplay === 'function' ? dashboardDisplay(value, { row, column, columns }) : value; %>
<%
const flow = supportFlow;
const metrics = flow.metrics || [];
const insights = flow.insights || [];
const workflow = flow.workflow || [];
const health = flow.health || {};
const healthValue = Number.isFinite(health.value) ? Math.max(0, Math.min(100, Math.round(health.value))) : null;
const filters = flow.filters || {};
const page = flow.page || {};
const rows = flow.rows || [];
const columns = flow.columns || [];
const countries = flow.context?.countries || flow.countries || [];
const selectedCountry = flow.country ?? flow.context?.country ?? filters.params?.country ?? filters.country ?? '';
const statusTone = value => /^(active|healthy|published|completed|delivered|approved|resolved|fulfilled|available|paid|verified|preferred|valid|succeeded|matched|closed|won)$/i.test(String(value)) ? 'good' : /^(rejected|failed|expired|cancelled|critical|blocked|reversed|revoked|mismatch|overdue|escalated)$/i.test(String(value)) ? 'bad' : 'warn';
const localHref = value => typeof value === 'string' && (/^\/(?!\/)/.test(value) || /^#[a-zA-Z0-9_-]+$/.test(value)) && !/[\\\u0000-\u001f\u007f]/.test(value) ? value : null;
const rawParams = { ...(filters.params || {}) };
for (const key of ['country', 'period', 'report', 'view', 'tab', 'queue', 'priority', 'assignment', 'overdue']) { if (typeof filters[key] === 'string') rawParams[key] = filters[key]; }
rawParams.country = selectedCountry;
if (typeof flow.period === 'string') rawParams.period = flow.period;
const filterParams = Object.entries(rawParams).filter(([key, value]) => /^[a-zA-Z][a-zA-Z0-9_-]{0,30}$/.test(key) && !['search', 'status', 'after', 'before', 'cursor', 'record', 'selected'].includes(key) && typeof value === 'string' && value.length <= 200);
const countryParams = filterParams.filter(([key]) => !['country', 'selected', 'record', 'after'].includes(key));
const cursorKey = /^[a-zA-Z][a-zA-Z0-9_-]{0,30}$/.test(filters.cursorKey || '') ? filters.cursorKey : 'after';
const pageLink = after => { const query = new URLSearchParams(filterParams); if (filters.search) query.set('search', filters.search); if (filters.status) query.set('status', filters.status); if (after) query.set(cursorKey, after); return supportPage.href + (query.size ? '?' + query : ''); };
const recommendation = insights.find(item => localHref(item?.href));
const nextHref = localHref(flow.pagination?.nextHref) || (page.next ? pageLink(page.next) : null);
const createHref = localHref(flow.create?.href);
const exportHref = localHref(flow.exportHref);
%>
<section class="app-page active role-page support-standard-live support-fidelity-page" data-page="<%= supportPage.id %>" data-role="support" data-page-kind="<%= supportPage.kind %>">
  <div class="page-heading role-page-heading"><div><span class="eyebrow"><%= supportPage.eyebrow %></span><h1><%= supportPage.title %></h1><p><%= supportPage.description %></p></div><div class="support-heading-actions">
    <% if (countries.length) { %><form class="support-country-filter" method="get" action="<%= supportPage.href %>"><% for (const [key, value] of countryParams) { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% } %><% if (filters.search) { %><input type="hidden" name="search" value="<%= filters.search %>"><% } %><% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %><label class="sr-only" for="supportCountry">Country scope</label><select id="supportCountry" name="country"><option value="" <%= selectedCountry === '' ? 'selected' : '' %>>All assigned countries</option><% for (const country of countries) { %><option value="<%= country.code %>" <%= country.code === selectedCountry ? 'selected' : '' %>><%= country.name || country.code %></option><% } %></select><button class="plain-link" type="submit">Apply</button></form><% } %>
    <% if (createHref) { %><a class="primary-button icon-button" href="<%= createHref %>"><svg aria-hidden="true"><use href="#i-plus"></use></svg><%= flow.create.label %></a><% } %>
  </div></div>
  <% if (flow.error) { %><p class="server-flash error platform-flash" role="alert"><%= flow.error %></p><% } %>
  <section class="role-metric-grid"><% for (const [index, metric] of metrics.entries()) { %><article class="role-metric panel"><span class="role-metric-icon tone-<%= index % 4 + 1 %>"><svg aria-hidden="true"><use href="#<%= ['i-eye','i-clipboard','i-wallet','i-award'][index % 4] %>"></use></svg></span><div><small><%= metric.label %></small><strong title="<%= metric.value ?? '—' %>"><%= metric.value ?? '—' %></strong><span><%= metric.detail || '' %></span></div></article><% } %></section>
  <div class="role-content-grid">
    <div class="role-side-stack">
      <section class="panel role-table-panel" id="support-records">
        <div class="role-panel-head"><div><h2><%= flow.tableTitle || supportPage.title + ' records' %></h2><p><%= flow.tableDescription || 'Current records within your authorized Support scope.' %></p></div><div class="role-table-tools">
          <% if (flow.filters) { %><form class="support-compact-filter" method="get" action="<%= supportPage.href %>"><% for (const [key, value] of filterParams) { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% } %><% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %><label class="role-mini-search"><svg aria-hidden="true"><use href="#i-search"></use></svg><input type="search" name="search" value="<%= filters.search || '' %>" maxlength="100" placeholder="Filter records" aria-label="Filter records"></label><button class="plain-link" type="submit">Search</button></form><% } %>
          <% if (exportHref) { %><a class="outline-button role-export" href="<%= exportHref %>"><svg aria-hidden="true"><use href="#i-download"></use></svg>Export</a><% } %>
        </div></div>
        <% if (flow.kind === 'tickets' && (filters.queues?.length || filters.priorities?.length || filters.assignments?.length)) { %>
        <form class="support-compact-filter support-queue-filter" method="get" action="<%= supportPage.href %>">
          <% for (const [key, value] of filterParams.filter(([key]) => !['queue','priority','assignment','overdue'].includes(key))) { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% } %>
          <% if (filters.search) { %><input type="hidden" name="search" value="<%= filters.search %>"><% } %><% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %>
          <% for (const field of [{name:'queue',label:'Queue',options:filters.queues},{name:'priority',label:'Priority',options:filters.priorities},{name:'assignment',label:'Ownership',options:filters.assignments}]) { if (!field.options?.length) continue; %><label><%= field.label %><select name="<%= field.name %>"><% for (const option of field.options) { %><option value="<%= option.value %>" <%= option.value === (filters[field.name] || 'all') ? 'selected' : '' %>><%= option.label %></option><% } %></select></label><% } %>
          <label class="support-overdue-label"><input type="checkbox" name="overdue" value="1" <%= filters.overdue === '1' ? 'checked' : '' %>>Overdue only</label><button class="plain-link" type="submit">Apply filters</button>
        </form>
        <% } %>
        <% if (filters.views?.length) { %><nav class="role-status-tabs support-record-tabs" aria-label="Record type"><% for (const view of filters.views) { const query = new URLSearchParams(filterParams); if (view.value) query.set('view', view.value); if (filters.search) query.set('search', filters.search); if (filters.status) query.set('status', filters.status); %><a class="<%= String(filters.view || '') === view.value ? 'active' : '' %>" href="<%= supportPage.href + (query.size ? '?' + query : '') %>" <%= String(filters.view || '') === view.value ? 'aria-current=page' : '' %>><%= view.label %></a><% } %></nav><% } %>
        <% if (filters.statuses?.length) { %><nav class="role-status-tabs support-record-tabs" aria-label="Record status"><% for (const status of filters.statuses) { const query = new URLSearchParams(filterParams); if (status.value) query.set('status', status.value); if (filters.search) query.set('search', filters.search); %><a class="<%= String(filters.status || '') === status.value ? 'active' : '' %>" href="<%= supportPage.href + (query.size ? '?' + query : '') %>" <%= String(filters.status || '') === status.value ? 'aria-current=page' : '' %>><%= status.label %></a><% } %></nav><% } %>
        <div class="role-table-wrap"><table class="role-table"><thead><tr><% for (const column of columns) { %><th><%= column %></th><% } %><th>Action</th></tr></thead><tbody>
        <% for (const row of rows) { const rowHref = localHref(row.href); %><tr><% for (const [index, cell] of (row.cells || []).entries()) { %><td data-label="<%= columns[index] || 'Value' %>"><% if (index === row.cells.length - 1 && /status|state|relationship/i.test(columns[index] || '')) { %><span class="role-status <%= statusTone(cell) %>"><%= displayDashboardCell(cell, row, columns[index], columns) %></span><% } else { %><span><%= displayDashboardCell(cell, row, columns[index], columns) %></span><% } %></td><% } %><td data-label="Action"><% if (rowHref) { %><a class="role-row-menu support-record-action" href="<%= rowHref %>" aria-label="Open <%= displayDashboardCell(row.cells?.[0] || row.id, row, columns[0], columns) %>">•••</a><% } else { %><span aria-label="No action required">—</span><% } %></td></tr><% } %>
        <% if (!rows.length) { %><tr><td colspan="<%= columns.length + 1 %>"><%= flow.emptyText || 'No records match this view yet.' %></td></tr><% } %>
        </tbody></table></div>
        <div class="role-table-footer"><span><%= rows.length %> records on this page<%= Number.isFinite(page.total) ? ' · ' + page.total + ' total' : '' %></span><div><% if (filters.after) { %><a class="plain-link" href="<%= pageLink('') %>">First</a><% } else { %><span class="support-page-control" aria-disabled="true">Previous</span><% } %><span class="support-page-control active" aria-current="page">Current</span><% if (nextHref) { %><a class="plain-link" href="<%= nextHref %>">Next</a><% } else { %><span class="support-page-control" aria-disabled="true">Next</span><% } %></div></div>
      </section>
      <% if (flow.kind === 'tickets') { %><%- include('support-ticket-forms') %><% } else if (flow.kind === 'cases') { %><%- include('support-case-forms') %><% } else if (flow.kind === 'context') { %><%- include('support-context-forms') %><% } else if (flow.kind === 'reports') { %><%- include('support-report-forms') %><% } %>
    </div>
    <aside class="role-side-stack">
      <section class="panel role-insights"><div class="role-panel-head compact"><div><span class="eyebrow">Decision support</span><h2>What needs attention</h2></div></div><div class="role-insight-list"><% for (const [index, insight] of insights.entries()) { %><article><span><%= index + 1 %></span><p><%= typeof insight === 'string' ? insight : insight.text %></p></article><% } %><% if (!insights.length) { %><p class="form-intro">No actions need attention in this view.</p><% } %></div><% if (recommendation) { %><a class="soft-button full-button" href="<%= localHref(recommendation.href) %>"><%= recommendation.label || 'Review recommendations' %></a><% } %></section>
      <section class="panel role-progress-card"><div class="role-panel-head compact"><div><span class="eyebrow">Performance</span><h2><%= health.label || 'Workspace health' %></h2></div><strong><%= healthValue === null ? '—' : healthValue + '%' %></strong></div><div class="role-health-ring" data-health-known="<%= healthValue !== null %>"><span><%= healthValue === null ? '—' : healthValue %><% if (healthValue !== null) { %><small>%</small><% } %></span></div><div class="role-health-rows"><% for (const row of health.rows || []) { %><div><span><%= row.label %></span><b><%= row.value ?? '—' %></b></div><% } %></div><% if (health.note) { %><p class="form-intro"><%= health.note %></p><% } %></section>
    </aside>
  </div>
  <section class="panel role-activity-panel"><div class="role-panel-head"><div><h2>Workflow &amp; recent activity</h2><p>Keep the team aligned on the next operational actions.</p></div><% if (localHref(flow.activityHref)) { %><a class="plain-link" href="<%= localHref(flow.activityHref) %>">View all activity</a><% } %></div><div class="role-workflow-grid"><% for (const [index, item] of workflow.entries()) { %><article><span class="role-step <%= index === 0 ? 'current' : '' %>"><%= index + 1 %></span><div><strong><%= item.title %></strong><p><%= item.text || item.detail || '' %></p></div><% if (localHref(item.href)) { %><a class="plain-link" href="<%= localHref(item.href) %>"><%= item.label || 'Continue' %></a><% } %></article><% } %></div><% if (!workflow.length) { %><p class="form-intro">No workflow activity recorded yet.</p><% } %></section>
</section>
