<% const paymentFlow = financeFlow; const selectedFinanceRecord = paymentFlow.selected; %>
<% if (selectedFinanceRecord) { %>
<section class="panel role-form-section" aria-labelledby="finance-selected-heading">
  <div class="role-panel-head"><h2 id="finance-selected-heading"><%= paymentFlow.pageId === 'finance-payments' ? 'Payment details' : 'Refund details' %></h2><span class="role-status"><%= selectedFinanceRecord.status.replaceAll('_', ' ') %></span></div>
  <div class="role-form-grid">
    <div><span>Record</span><strong><%= selectedFinanceRecord.publicId %></strong></div>
    <div><span>Order</span><strong><%= selectedFinanceRecord.orderPublicId %></strong></div>
    <div><span>Amount</span><strong><%= formatMoney(selectedFinanceRecord.amountMinor, selectedFinanceRecord.currency) %></strong></div>
    <div><span>Market</span><strong><%= selectedFinanceRecord.country %> · <%= selectedFinanceRecord.currency %></strong></div>
    <div><span>Provider</span><strong><%= selectedFinanceRecord.provider.replaceAll('_', ' ') %></strong></div>
    <% if (selectedFinanceRecord.reason) { %><div><span>Reason</span><strong><%= selectedFinanceRecord.reason %></strong></div><% } %>
    <% if (selectedFinanceRecord.returnPublicId) { %><div><span>Inspected return</span><a class="text-link" href="/finance/refunds?return=<%= encodeURIComponent(selectedFinanceRecord.returnPublicId) %>"><%= selectedFinanceRecord.returnPublicId %></a></div><% } %>
  </div>
  <% if (paymentFlow.pageId === 'finance-payments') { %>
    <% if (selectedFinanceRecord.canVerify) { %>
      <form method="post" action="/finance/payments/<%= encodeURIComponent(selectedFinanceRecord.publicId) %>/verify" class="role-inline-action">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedFinanceRecord.version %>">
        <button class="primary-button" type="submit">Verify with Pesapal</button>
      </form>
    <% } %>
    <% if (['succeeded','partially_refunded'].includes(selectedFinanceRecord.status) && selectedFinanceRecord.remainingRefundMinor > 0) { %>
      <a class="soft-button" href="/finance/refunds?order=<%= encodeURIComponent(selectedFinanceRecord.orderPublicId) %>&amp;country=<%= selectedFinanceRecord.country %>">Record refund</a>
    <% } %>
  <% } else if (selectedFinanceRecord.canComplete) { %>
    <form method="post" action="/finance/refunds/<%= encodeURIComponent(selectedFinanceRecord.publicId) %>/complete" class="role-form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedFinanceRecord.version %>">
      <label ><span>Verified disbursement reference</span><input name="reference" minlength="4" maxlength="180" required autocomplete="off"></label>
      <p class="wide form-intro">Confirm the merchant portal or disbursement record first. A different operator must confirm the refund.</p>
      <div class="wide"><button class="primary-button" type="submit">Confirm refund completion</button></div>
    </form>
  <% } else if (paymentFlow.pageId === 'finance-refunds' && selectedFinanceRecord.status === 'processing') { %>
    <p class="wide form-intro">A different finance operator must confirm this refund after verifying its disbursement.</p>
  <% } %>
  <% if (paymentFlow.pageId === 'finance-refunds' && selectedFinanceRecord.nonDisbursementReview) { const review = selectedFinanceRecord.nonDisbursementReview; %>
    <div class="role-form-grid">
      <div><span>No-payment review recorded</span><strong><%= formatDate(review.recordedAt) %></strong></div>
      <div><span>External verification reference</span><strong><%= review.reference %></strong></div>
      <p class="wide form-intro"><%= review.reason %></p>
      <% if (selectedFinanceRecord.status === 'processing') { %><p class="wide form-intro">This independent review has been recorded. The full refund amount remains reserved; it cannot be released or resubmitted through this review. Confirm completion only after verifying actual payment.</p><% } %>
    </div>
  <% } else if (paymentFlow.pageId === 'finance-refunds' && selectedFinanceRecord.canReviewNonDisbursement) { %>
    <form method="post" action="/finance/refunds/<%= encodeURIComponent(selectedFinanceRecord.publicId) %>/review-no-payment" class="role-form-grid dashboard-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedFinanceRecord.version %>">
      <label><span>External verification reference</span><input name="reference" minlength="4" maxlength="180" required autocomplete="off"></label>
      <label class="wide"><span>Independent evidence that no refund was paid</span><textarea name="reason" minlength="16" maxlength="400" required rows="3"></textarea></label>
      <p class="wide form-intro">Check final provider evidence confirming no payment and no pending refund. A missing portal record or timeout is not proof. This review keeps the full refund amount reserved until actual payment is independently confirmed; it does not release funds or submit another refund.</p>
      <label class="wide seller-verification-declaration"><input type="checkbox" name="terminalOutcomeConfirmed" value="true" required><span>I independently verified final provider evidence showing no payment and no pending refund.</span></label>
      <div class="wide"><button class="primary-button" type="submit">Record no-payment review</button></div>
    </form>
  <% } %>
</section>
<% } %>
<% for (const referredCase of paymentFlow.referredDisputes || []) { %>
<section class="panel role-form-section" aria-labelledby="finance-case-<%= referredCase.publicId %>">
  <div class="role-panel-head"><h2 id="finance-case-<%= referredCase.publicId %>">Referred order case</h2><span class="role-status"><%= referredCase.status.replaceAll('_', ' ') %></span></div>
  <div class="role-form-grid"><div><span>Case</span><strong><%= referredCase.publicId %></strong></div><div><span>Topic</span><strong><%= referredCase.category.replaceAll('_', ' ') %></strong></div><div class="wide"><span>Customer subject</span><strong><%= referredCase.subject %></strong></div><p class="wide form-intro"><%= referredCase.description %></p></div>
  <% for (const update of referredCase.updates) { %><p class="form-intro"><%= formatDate(update.at) %> · <%= update.message %></p><% } %>
  <p class="form-intro">Review the original payment and confirmed financial records before taking action.</p>
</section>
<% } %>
<% if (paymentFlow.returnContext) { const returnContext = paymentFlow.returnContext; %>
<section class="panel role-form-section" aria-labelledby="finance-return-heading">
  <div class="role-panel-head"><h2 id="finance-return-heading">Inspected return referral</h2><span class="role-status"><%= returnContext.status.replaceAll('_', ' ') %></span></div>
  <div class="role-form-grid"><div><span>Return</span><strong><%= returnContext.publicId %></strong></div><div><span>Order</span><strong><%= returnContext.orderPublicId %></strong></div><div><span>Inspected refund</span><strong><%= formatMoney(returnContext.amountMinor, returnContext.currency) %></strong></div><div><span>Referred on</span><strong><%= formatDate(returnContext.referredAt) %></strong></div>
    <% for (const item of returnContext.items) { %><div><span><%= item.title %> · <%= item.quantity %> returned</span><strong><%= formatMoney(item.grossMinor, returnContext.currency) %></strong></div><% } %>
  </div>
  <% if (returnContext.status === 'refunded') { %><p class="form-intro">The linked refund is confirmed and posted to the ledger.</p><% } else if (selectedFinanceRecord && ['failed','cancelled'].includes(selectedFinanceRecord.status)) { %><p class="form-intro">The linked refund did not complete. Review its recorded provider outcome and reconcile this case before taking further financial action.</p><a class="soft-button" href="/finance/reconciliation">Review reconciliation</a><% } else if (returnContext.status === 'refund_processing') { %><p class="form-intro">The linked refund has been recorded. Confirm the actual disbursement before completing it.</p><% } else { %><p class="form-intro">The amount and order lines come from the received goods and completed Warehouse inspection.</p><% } %>
</section>
<% } %>
<% if (paymentFlow.pageId === 'finance-refunds' && (!paymentFlow.returnContext || paymentFlow.refundOrder)) { const refundOrder = paymentFlow.refundOrder; %>
<section class="panel role-form-section" id="finance-refund-request" aria-labelledby="finance-refund-heading">
  <div class="role-panel-head"><h2 id="finance-refund-heading">Record refund</h2></div>
  <% if (!refundOrder) { %>
    <form method="get" action="/finance/refunds" class="role-form-grid">
      <label ><span>Order ID</span><input name="order" minlength="4" maxlength="100" required autocomplete="off" placeholder="Enter the original order ID"></label>
      <input type="hidden" name="country" value="<%= paymentFlow.country %>">
      <div class="wide"><button class="primary-button" type="submit">Find paid order</button></div>
    </form>
  <% } else { %>
    <form method="post" action="/finance/refunds" class="role-form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= paymentFlow.idempotencyKey %>">
      <input type="hidden" name="orderId" value="<%= refundOrder.publicId %>"><input type="hidden" name="version" value="<%= refundOrder.payment.version %>">
      <% if (refundOrder.returnPublicId) { %><input type="hidden" name="returnPublicId" value="<%= refundOrder.returnPublicId %>"><input type="hidden" name="returnVersion" value="<%= refundOrder.returnVersion %>"><% } %>
      <div ><span>Order</span><strong><%= refundOrder.publicId %> · <%= refundOrder.country %> · <%= refundOrder.currency %></strong></div>
      <div ><span>Remaining refundable balance</span><strong><%= formatMoney(refundOrder.payment.remainingRefundMinor, refundOrder.currency) %></strong></div>
      <% if (refundOrder.returnPublicId) { %><div><span>Inspected refund amount</span><strong><%= formatMoney(refundOrder.returnAmountMinor, refundOrder.currency) %></strong><input type="hidden" name="amountMinor" value="<%= refundOrder.returnAmountMinor %>"></div><% } else { %><label ><span>Amount in minor units (<%= refundOrder.currency %>)</span><input name="amountMinor" type="number" min="1" max="<%= refundOrder.payment.remainingRefundMinor %>" step="1" placeholder="Leave blank for the remaining balance"></label><% } %>
      <label class="wide"><span>Refund reason</span><textarea name="reason" minlength="3" maxlength="300" required rows="3"></textarea></label>
      <% for (const item of refundOrder.items) { %>
        <% if (refundOrder.returnPublicId) { %><div><span><%= item.title %> · inspected line amount</span><strong><%= formatMoney(item.refundMinor, refundOrder.currency) %></strong><input type="hidden" name="line:<%= item.orderLineId %>" value="<%= item.refundMinor %>"></div><% } else { %><label ><span><%= item.title %> · line amount in minor units</span><input name="line:<%= item.orderLineId %>" type="number" min="0" max="<%= item.lineTotalMinor %>" step="1" value="0"></label><% } %>
      <% } %>
      <% if (refundOrder.returnPublicId) { %><p class="wide form-intro">This refund is bound to the inspected return. Its amount and order lines must match the authoritative goods receipt.</p><% } else { %><p class="wide form-intro">For partial or follow-up refunds, assign the refund amount to the purchased lines. Line amounts must total the refund amount. A full untouched payment can be refunded without line amounts.</p><% } %>
      <div class="wide"><button class="primary-button" type="submit">Record refund</button></div>
    </form>
  <% } %>
</section>
<% } %>
