<% if(flow.catalogue&&(flow.kind==='orders'?flow.can.buy:flow.can.templates)){ %>
<section class="panel role-form-section" id="business-procurement"><div class="role-panel-head"><div><h2><%= flow.kind==='templates'?'Create a procurement template':'New purchase request' %></h2><p>Choose a current marketplace SKU. Use CSV import for a request containing several items.</p></div></div>
<form method="get" action="<%= businessPage.href %>" class="role-table-tools"><label class="role-mini-search"><input type="search" name="catalogueSearch" value="<%= flow.catalogue.search %>" maxlength="100" placeholder="Search SKU, product or supplier" aria-label="Search supplier catalogue"></label><button class="outline-button" type="submit">Find items</button></form>
<form method="post" action="<%= flow.kind==='templates'?'/business/templates':'/business/requests' %>" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= flow.idempotencyKey %>"><label class="wide"><%= flow.kind==='templates'?'Template name':'Request title' %><input name="<%= flow.kind==='templates'?'name':'title' %>" maxlength="140" required></label><label class="wide">Marketplace item<select name="variantPublicId" required><option value="">Select an available SKU</option><% for(const item of flow.catalogue.items){ %><option value="<%= item.publicId %>"><%= item.sku %> · <%= item.productTitle %> · <%= item.title %> · <%= item.storeName %> · <%= money(item.priceMinor) %></option><% } %></select></label><label>Quantity<input name="quantity" type="number" min="1" max="9999" step="1" required value="1"></label><label>Budget<select name="budgetId"><option value="">No budget</option><% for(const budget of flow.budgets){ %><option value="<%= budget.publicId %>"><%= budget.name %> · <%= money(Math.max(0,budget.limitMinor-budget.committedMinor-budget.spentMinor)) %> available</option><% } %></select></label><% if(flow.kind==='templates'){ %><label>Recurrence<select name="recurrence" required><option value="none">Manual only</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option></select></label><% }else{ %><label class="wide">Purchasing note<input name="note" maxlength="300"></label><% } %><div class="wide"><button class="primary-button" type="submit"><%= flow.kind==='templates'?'Create template':'Submit for approval' %></button></div></form><% if(flow.catalogue.page.next){ %><a class="plain-link" href="<%= businessPage.href %>?catalogueSearch=<%= encodeURIComponent(flow.catalogue.search) %>&amp;catalogueAfter=<%= encodeURIComponent(flow.catalogue.page.next) %>">More marketplace items</a><% } %>
</section>
<% if(flow.kind==='orders'){ %><section class="panel role-form-section"><div class="role-panel-head"><div><h2>Import a purchasing list</h2><p><a class="plain-link" href="/business/requests/import/template.csv">Download the CSV template</a>. Each row must contain an available SKU reference and a whole quantity.</p></div></div><form method="post" action="/business/requests/import" enctype="multipart/form-data" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Request title<input name="title" maxlength="160" required></label><label>CSV file<input name="csv" type="file" accept=".csv,text/csv" required></label><label>Budget<select name="budgetId"><option value="">No budget</option><% for(const budget of flow.budgets){ %><option value="<%= budget.publicId %>"><%= budget.name %></option><% } %></select></label><div class="wide"><button class="primary-button" type="submit">Import for approval</button></div></form></section><% } %>
<% } %>
<% if(flow.kind==='orders'){ %><section class="panel role-form-section"><div class="role-panel-head"><div><h2>Procurement requests</h2><p>Approvals reserve the approved budget. Only remaining commitments are released when a request closes.</p></div></div><% for(const request of flow.requests){ %><article id="<%= request.publicId %>"><div class="role-panel-head"><div><h3><%= request.title %></h3><p><%= money(request.estimatedTotalMinor) %> · <%= request.status.replaceAll('_',' ') %></p></div><% if(request.status==='approved'||request.status==='partially_ordered'){ %><a class="plain-link" href="/business/quotes">Request supplier quotation</a><% } %></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>SKU</th><th>Item</th><th>Quantity</th><th>Reviewed price</th></tr></thead><tbody><% for(const item of request.items){ %><tr><td data-label="SKU"><%= item.sku %></td><td data-label="Item"><%= item.title %> · <%= item.variantTitle %></td><td data-label="Quantity"><%= item.quantity %></td><td data-label="Reviewed price"><%= money(item.estimatedUnitMinor) %></td></tr><% } %></tbody></table></div><% if(flow.can.approve&&request.status==='submitted'&&!request.requestedByCurrentUser){ %><form method="post" action="/business/requests/<%= request.publicId %>/decision" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= request.version %>"><label class="wide">Decision note<input name="reason" maxlength="500"></label><div class="wide"><button class="primary-button" name="decision" value="approve" type="submit">Approve request</button> <button class="outline-button" name="decision" value="reject" type="submit">Reject request</button></div></form><% }else if(request.status==='submitted'&&request.requestedByCurrentUser){ %><p class="form-intro">Another authorized company approver must review this request.</p><% } %><% if(flow.can.buy&&!request.closedAt&&['submitted','approved','partially_ordered','ordered'].includes(request.status)&&(request.requestedByCurrentUser||['owner','admin'].includes(flow.membership.role))){ %><form method="post" action="/business/requests/<%= request.publicId %>/cancel" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= request.version %>"><label>Reason for closing<input name="reason" maxlength="500" required></label><div><button class="outline-button" type="submit">Close remaining request</button></div></form><% } %></article><% } %><% if(!flow.requests.length){ %><p class="form-intro">No purchase requests yet.</p><% } %><% if(flow.requestPage.next){ %><a class="plain-link" href="<%= link('requestsAfter',flow.requestPage.next) %>">More requests</a><% } %></section><% } %>
<% if(flow.kind==='templates'){for(const template of flow.records){ %><section class="panel role-form-section" id="<%= template.publicId %>"><div class="role-panel-head"><div><h2><%= template.name %></h2><p><%= template.recurrence %> · <%= template.active?'Active':'Paused' %><% if(template.nextDueAt){ %> · Next run <%= new Date(template.nextDueAt).toLocaleDateString('en-GB',{timeZone:flow.timeZone}) %><% } %></p></div></div><% if(flow.can.templates&&(template.createdByCurrentUser||['owner','admin'].includes(flow.membership.role))){ %><form method="post" action="/business/templates/<%= template.publicId %>/actions" class="role-table-tools"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= template.version %>"><% if(template.createdByCurrentUser&&flow.can.buy){ %><button class="primary-button" name="action" value="run" type="submit">Create approval request</button><% } %><button class="outline-button" name="action" value="<%= template.active?'pause':'resume' %>" type="submit"><%= template.active?'Pause':'Resume' %></button></form><% } %></section><% } %><section class="panel role-form-section"><div class="role-panel-head"><div><h2>Recurring request history</h2><p>Every scheduled run creates a separate request for independent approval.</p></div></div><div class="role-health-rows"><% for(const run of flow.runs){ %><div><span><%= run.templatePublicId %> · <%= new Date(run.scheduledFor).toLocaleDateString('en-GB',{timeZone:flow.timeZone}) %></span><b><%= run.status %></b></div><% } %></div><% if(!flow.runs.length){ %><p class="form-intro">No scheduled runs yet.</p><% } %><% if(flow.runPage.next){ %><a class="plain-link" href="<%= link('runsAfter',flow.runPage.next) %>">More runs</a><% } %></section><% } %>
