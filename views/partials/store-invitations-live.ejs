<section class="app-page active role-page seller-fidelity-page"><div class="page-heading role-page-heading"><div><span class="eyebrow">Account access</span><h1>Store invitations</h1><p>Accept only invitations from stores you recognise.</p></div></div><section class="panel role-table-panel"><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Store</th><th>Role</th><th>Status</th><th>Action</th></tr></thead><tbody><% for (const invitation of storeInvitationFlow.invitations) { %><tr><td><%= invitation.storeName %></td><td><%= invitation.role %></td><td><%= invitation.status %></td><td><% if (invitation.status === 'pending') { %><div class="role-create-actions"><% if (storeInvitationFlow.requiresMfa) { %><a class="primary-button" href="/account/security?next=%2Faccount%2Fstore-invitations">Set up authenticator</a><% } %><% for (const decision of (storeInvitationFlow.requiresMfa ? ['reject'] : ['accept', 'reject'])) { %><form method="post" action="/account/store-invitations/<%= invitation.publicId %>/<%= decision %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= invitation.version %>"><button class="<%= decision === 'accept' ? 'primary-button' : 'outline-button' %>" type="submit"><%= decision === 'accept' ? 'Accept invitation' : 'Decline' %></button></form><% } %></div><% } else if (invitation.status === 'accepted' && storeInvitationFlow.requiresMfa) { %><a class="primary-button" href="/account/security?next=%2Faccount%2Fstore-invitations">Set up authenticator</a><% } else if (invitation.status === 'accepted') { %><form method="post" action="/seller/workspace"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="storePublicId" value="<%= invitation.storePublicId %>"><button class="primary-button" type="submit">Open store</button></form><% } %></td></tr><% } %><% if (!storeInvitationFlow.invitations.length) { %><tr><td colspan="4">No store invitations are available for your verified email.</td></tr><% } %></tbody></table></div><div class="role-table-footer"><span><%= storeInvitationFlow.page.total %> invitations</span><% if (storeInvitationFlow.page.next) { %><a class="plain-link" href="/account/store-invitations?after=<%= encodeURIComponent(storeInvitationFlow.page.next) %>">Next</a><% } %></div></section></section>
