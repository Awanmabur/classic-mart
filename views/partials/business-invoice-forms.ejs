<% for(const invoice of flow.records){ %><section class="panel role-form-section" id="<%= invoice.publicId %>"><div class="role-panel-head"><div><h2><%= invoice.invoiceNumber %></h2><p><%= invoice.status.replaceAll('_',' ') %> · Total <%= money(invoice.totalMinor) %> · Paid <%= money(invoice.paidMinor) %></p></div></div><div class="role-health-rows"><div><span>Payment terms</span><b><%= invoice.paymentTerms==='credit'?invoice.termsDays+' days':'Immediate payment' %></b></div><% if(invoice.dueAt){ %><div><span>Due date</span><b><%= new Date(invoice.dueAt).toLocaleDateString('en-GB',{timeZone:flow.timeZone}) %></b></div><% } %><div><span>Delivery</span><b><%= invoice.deliveredAt?'Delivered':'Awaiting verified delivery' %></b></div></div><% if(flow.can.po&&invoice.paidMinor===0&&['awaiting_payment','open','overdue'].includes(invoice.status)){ %><form method="post" action="/business/invoices/<%= invoice.publicId %>/pay"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= invoice.version %>"><input type="hidden" name="idempotencyKey" value="<%= flow.idempotencyKey %>"><button class="primary-button" type="submit">Pay <%= money(invoice.totalMinor) %> with Pesapal</button></form><% } %></section><% } %>
<section class="panel role-form-section"><div class="role-panel-head"><div><h2>Commercial documents</h2><p>Private quotation, purchase-order, invoice and delivery snapshots.</p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Document</th><th>Type</th><th>Amount</th><th>Download</th></tr></thead><tbody><% for(const document of flow.documents.business){ %><tr><td data-label="Document"><a class="plain-link" href="/business/documents/<%= document.publicId %>"><%= document.documentNumber %></a></td><td data-label="Type"><%= document.type.replaceAll('_',' ') %></td><td data-label="Amount"><%= money(document.amountMinor) %></td><td data-label="Download"><a class="plain-link" href="/business/documents/<%= document.publicId %>/pdf">PDF</a></td></tr><% } %><% if(!flow.documents.business.length){ %><tr><td colspan="4">Documents appear as the purchase progresses.</td></tr><% } %></tbody></table></div><% if(flow.documents.pages.business.next){ %><a class="plain-link" href="<%= link('documentsAfter',flow.documents.pages.business.next) %>">More commercial documents</a><% } %></section>
<section class="panel role-form-section"><div class="role-panel-head"><div><h2>Receipts and credit notes</h2><p>Documents from verified payments and completed refunds.</p></div></div><div class="role-health-rows"><% for(const document of flow.documents.financial){ %><div><a class="plain-link" href="/business/financial-documents/<%= document.publicId %>"><%= document.documentNumber %></a><b><%= money(document.amountMinor) %></b></div><% } %></div><% if(!flow.documents.financial.length){ %><p class="form-intro">No payment receipts or credit notes yet.</p><% } %><% if(flow.documents.pages.financial.next){ %><a class="plain-link" href="<%= link('financialAfter',flow.documents.pages.financial.next) %>">More financial documents</a><% } %></section>
