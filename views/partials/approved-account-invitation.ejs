<section class="app-page active"><div class="page-heading"><div><h1>Staff invitation</h1><p>Privileged access requires verified identity, MFA and a different administrator's approval.</p></div></div><section class="panel form-panel"><h2><%=invitation.role.replaceAll('_',' ')%></h2><div class="account-list"><article class="account-item"><div><strong>Account</strong><p><%=invitation.emailMasked%></p></div></article><article class="account-item"><div><strong>Operational countries</strong><p><%=invitation.operationalCountries.join(', ')%></p></div></article><%if(invitation.warehouseScopes?.length){%><article class="account-item"><div><strong>Warehouse scope</strong><p><%=invitation.warehouseScopes.join(', ')%></p></div></article><%}%><article class="account-item"><div><strong>Security checks</strong><p>Email: <%=invitation.emailVerified?'complete':'required'%> · Phone: <%=invitation.phoneVerified?'complete':'required'%> · MFA: <%=invitation.mfaEnabled?'complete':'required'%></p></div></article></div><p class="muted-label">Invitation expires <%=formatDate(invitation.expiresAt)%>. Approved access lasts <%=invitation.grantDurationDays||180%> day(s).</p><%if(invitation.ready){%><form method="post" action="/staff/invitations/<%=encodeURIComponent(token)%>/accept"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="primary-button" type="submit">Accept and send for approval</button></form><%}else{%><div class="account-actions"><a class="account-link primary" href="/account/security">Complete account security</a><a class="account-link" href="/">Marketplace</a></div><%}%></section></section>