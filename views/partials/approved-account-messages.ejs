<section class="app-page active account-service-page"><%if(flash){%><div class="dashboard-message <%=flash.type==='error'?'error':''%>"><strong><%=flash.message%></strong></div><%}%><div class="page-heading"><h1>Marketplace messages</h1><p>Your direct conversations with sellers and promoters.</p></div><section class="panel form-panel"><div class="ticket-list"><%if(!sellerContacts.length&&!(promoterContacts||[]).length){%><div class="empty-state">No marketplace conversations yet.</div><%}%><%sellerContacts.forEach(thread=>{%><article class="ticket-row"><div><strong><a href="/sellers/<%=thread.storeId?.slug||''%>"><%=thread.storeId?.name||'Seller'%></a> · <%=thread.subject%></strong><p><strong>You:</strong> <%=thread.message%></p><%(thread.replies||[]).forEach(reply=>{%><p><strong><%=reply.sender==='seller'?'Seller':'You'%>:</strong> <%=reply.body%> <small>· <%=formatDate(reply.at)%></small></p><%})%><small>Status: <%=thread.status%> · Last activity <%=formatDate(thread.lastMessageAt||thread.updatedAt)%></small><%if(thread.status!=='resolved'){%><form class="dashboard-form" method="post" action="/account/messages/<%=thread.publicId%>/reply"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><textarea name="message" minlength="2" maxlength="2000" required rows="3" placeholder="Reply to the seller"></textarea><button class="primary-button" type="submit">Send reply</button></form><%}%></div></article><%})%><%(promoterContacts||[]).forEach(thread=>{const promoterName=thread.promoterUserId?.roleProfile?.publicName||thread.promoterUserId?.name||'Promoter';%><article class="ticket-row"><div><strong><%=promoterName%> · <%=thread.subject%></strong><p><strong>You:</strong> <%=thread.message%></p><%(thread.replies||[]).forEach(reply=>{%><p><strong><%=reply.sender==='promoter'?'Promoter':'You'%>:</strong> <%=reply.body%> <small>· <%=formatDate(reply.at)%></small></p><%})%><small>Status: <%=thread.status%> · Last activity <%=formatDate(thread.lastMessageAt||thread.updatedAt)%></small><%if(thread.status!=='resolved'){%><form class="dashboard-form" method="post" action="/account/promoter-messages/<%=thread.publicId%>/reply"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><textarea name="message" minlength="2" maxlength="2000" required rows="3" placeholder="Reply to the promoter"></textarea><button class="primary-button" type="submit">Send reply</button></form><%}%></div></article><%})%></div><%if(queuePages?.sellerContacts?.hasMore){%><p><a class="plain-link" href="/account/messages?sellerContactsAfter=<%=encodeURIComponent(queuePages.sellerContacts.next)%>">Older seller conversations</a></p><%}%><%if(queuePages?.promoterContacts?.hasMore){%><p><a class="plain-link" href="/account/messages?promoterContactsAfter=<%=encodeURIComponent(queuePages.promoterContacts.next)%>">Older promoter conversations</a></p><%}%></section></section>