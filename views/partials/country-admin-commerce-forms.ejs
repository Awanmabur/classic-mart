<% const commerce = typeof countryAdminFlow !== 'undefined' ? countryAdminFlow : pageFlow; const selectedCommerce = commerce.selected; const commerceMoney = (amount,currency) => formatMoney(amount,currency); %>
<% if (commerce.pageId === 'admin-payments') { %>
<div class="role-inline-action" aria-label="Payment records">
  <% for (const [view,label] of [['payments','Payments'],['refunds','Refunds'],['events','Provider events']]) { %><a class="soft-button" href="/admin/payments?view=<%= view %>&amp;country=<%= commerce.country || '' %>"><%= label %></a><% } %>
</div>
<% } %>
<% if (selectedCommerce) { %>
<section class="panel role-form-section" aria-labelledby="admin-commerce-detail-heading">
  <div class="role-panel-head"><h2 id="admin-commerce-detail-heading"><%= commerce.commerceKind === 'orders' ? 'Order details' : commerce.commerceKind === 'returns' ? 'Return details' : commerce.commerceKind === 'refunds' ? 'Refund details' : commerce.commerceKind === 'events' ? 'Provider event details' : 'Payment details' %></h2><span class="role-status"><%= selectedCommerce.status.replaceAll('_',' ') %></span></div>
  <div class="role-form-grid">
    <div><span>Record</span><strong><%= selectedCommerce.publicId %></strong></div>
    <% if (selectedCommerce.orderPublicId) { %><div><span>Original order</span><a href="/admin/orders?country=<%= selectedCommerce.country %>&amp;record=<%= encodeURIComponent(selectedCommerce.orderPublicId) %>"><%= selectedCommerce.orderPublicId %></a></div><% } %>
    <div><span>Market</span><strong><%= selectedCommerce.country %> · <%= selectedCommerce.currency %></strong></div>
    <% if (selectedCommerce.amountMinor !== undefined) { %><div><span>Recorded value</span><strong><%= commerceMoney(selectedCommerce.amountMinor,selectedCommerce.currency) %></strong></div><% } %>
  </div>
  <% if (commerce.commerceKind === 'orders') { %>
    <p class="form-intro">Payment: <%= selectedCommerce.paymentState.replaceAll('_',' ') %> · Fulfilment: <%= selectedCommerce.fulfillmentState.replaceAll('_',' ') %> · Return: <%= selectedCommerce.returnState.replaceAll('_',' ') %>.</p>
    <p class="form-intro"><%= selectedCommerce.buyer.name %> · <%= selectedCommerce.buyer.phone %> · <%= selectedCommerce.buyer.email %></p>
    <div class="role-form-grid"><% for (const line of selectedCommerce.items) { %><div><span><%= line.title %></span><strong><%= line.quantity %> unit(s) · <%= line.sku %></strong><p class="form-intro"><%= line.deliveredQuantity %> delivered · <%= line.returnedQuantity %> returned · <%= line.refundedQuantity %> refunded.</p></div><% } %></div>
    <% for (const sellerOrder of selectedCommerce.sellerOrders || []) { %><p class="form-intro">Seller order <%= sellerOrder.publicId %> · <%= sellerOrder.storePublicId %> · <%= sellerOrder.status.replaceAll('_',' ') %> · <%= sellerOrder.lines.reduce((sum,line)=>sum+line.quantity,0) %> unit(s).</p><% } %>
    <% for (const shipment of selectedCommerce.shipments || []) { %><p class="form-intro">Shipment <%= shipment.publicId %> · <%= shipment.kind %> · <%= shipment.status.replaceAll('_',' ') %><%= shipment.verifiedDelivery ? ' · delivery proof verified' : '' %>.</p><% } %>
    <div class="role-inline-action"><% for (const payment of selectedCommerce.payments || []) { %><a class="soft-button" href="/admin/payments?country=<%= payment.country %>&amp;record=<%= encodeURIComponent(payment.publicId) %>"><%= payment.publicId %> · <%= payment.status.replaceAll('_',' ') %></a><% } %><% for (const returned of selectedCommerce.returns || []) { %><a class="soft-button" href="<%= returned.href %>"><%= returned.publicId %> · <%= returned.status.replaceAll('_',' ') %></a><% } %></div>
  <% } %>
  <% if (selectedCommerce.evidence && selectedCommerce.evidence.length) { %><div class="role-inline-action"><% for (const evidence of selectedCommerce.evidence) { %><a class="soft-button" href="<%= evidence.href %>" target="_blank" rel="noopener"><%= evidence.description || 'Open accepted private evidence' %></a><% } %></div><% } %>
  <% if (commerce.commerceKind === 'returns') { %>
    <p class="form-intro"><%= selectedCommerce.details %></p>
    <div class="role-form-grid"><% for (const line of selectedCommerce.items) { %><div><span><%= line.title %> · <%= line.quantity %> unit(s)</span><strong><%= line.orderLineId %></strong><p class="form-intro">Receipt: <%= line.intakeReceivedAt ? 'recorded' : 'awaiting verified receiving evidence' %>. Warehouse inspection: <%= line.warehouseInspectionStatus || 'awaiting receipt' %><%= line.stockDisposition ? ' · ' + line.stockDisposition : '' %>.</p></div><% } %></div>
    <% for (const sellerCase of selectedCommerce.sellerCases || []) { %><p class="form-intro">Seller response · <%= sellerCase.storePublicId %> · <%= sellerCase.responseMessage || 'Awaiting seller response' %></p><div class="role-inline-action"><% for (const evidence of sellerCase.evidence || []) { %><a class="soft-button" href="<%= evidence.href %>" target="_blank" rel="noopener">View seller evidence</a><% } %></div><% } %>
    <% if (selectedCommerce.status === 'requested') { %>
    <form method="post" action="/admin/returns/<%= encodeURIComponent(selectedCommerce.publicId) %>/decision" class="role-form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedCommerce.version %>">
      <label><span>Decision</span><select name="decision" required><option value="approve">Approve eligible return</option><option value="reject">Reject return</option></select></label>
      <label class="wide"><span>Reason shared with buyer</span><textarea name="note" minlength="10" maxlength="300" rows="3" required></textarea></label><div class="wide"><button class="primary-button" type="submit">Save return decision</button></div>
    </form><% } %>
    <% if (selectedCommerce.canReceive) { %>
    <form method="post" action="/admin/returns/<%= encodeURIComponent(selectedCommerce.publicId) %>/receive" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedCommerce.version %>"><label class="wide"><span>Receipt note</span><textarea name="note" maxlength="300" rows="2"></textarea></label><div class="wide"><button class="primary-button" type="submit">Confirm verified receipt</button></div></form>
    <% } else if (['approved','awaiting_return'].includes(selectedCommerce.status)) { %><p class="form-intro">The receiving warehouse or carrier must record actual receipt before this return can advance.</p><% } %>
    <% if (selectedCommerce.canInspect) { %>
    <form method="post" action="/admin/returns/<%= encodeURIComponent(selectedCommerce.publicId) %>/inspect" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedCommerce.version %>">
      <label><span>Final inspected condition</span><select name="condition" required><option value="good">Good</option><option value="unopened">Unopened</option><option value="damaged">Damaged</option><option value="wrong_item">Wrong item</option><option value="missing_parts">Missing parts</option><option value="counterfeit_suspected">Suspected counterfeit</option></select></label><label class="wide"><span>Outcome supported by warehouse inspection</span><textarea name="notes" minlength="10" maxlength="1000" rows="3" required></textarea></label><div class="wide"><button class="primary-button" type="submit">Save inspected outcome</button></div>
    </form><% } else if (selectedCommerce.status === 'received') { %><p class="form-intro">Every exact returned line must complete its warehouse inspection and stock disposition.</p><% } %>
    <% if (selectedCommerce.status === 'refund_pending' && !selectedCommerce.financeReferral) { %>
    <form method="post" action="/admin/returns/<%= encodeURIComponent(selectedCommerce.publicId) %>/refer-finance" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedCommerce.version %>"><label class="wide"><span>Independent payment review note</span><textarea name="note" minlength="10" maxlength="500" rows="3" required></textarea></label><div class="wide"><button class="primary-button" type="submit">Refer inspected refund</button></div></form>
    <% } %>
    <% if (selectedCommerce.canReserveRefund) { %><a class="primary-button" href="/admin/payments?view=refunds&amp;country=<%= selectedCommerce.country %>&amp;return=<%= encodeURIComponent(selectedCommerce.publicId) %>">Review inspected refund</a><% } else if (selectedCommerce.status === 'refund_pending' && selectedCommerce.financeReferral) { %><p class="form-intro">A different operator must review the inspected return and reserve its refund.</p><% } %>
    <% if (selectedCommerce.refundPublicId) { %><a class="soft-button" href="/admin/payments?view=refunds&amp;country=<%= selectedCommerce.country %>&amp;record=<%= encodeURIComponent(selectedCommerce.refundPublicId) %>">Open refund <%= selectedCommerce.refundPublicId %></a><% } %>
    <% if (selectedCommerce.status === 'exchange_pending') { %><form method="post" action="/admin/returns/<%= encodeURIComponent(selectedCommerce.publicId) %>/exchange" class="role-inline-action"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedCommerce.version %>"><button class="primary-button" type="submit">Reserve exchange against available stock</button></form><% } %>
    <% if (selectedCommerce.replacementOrderPublicId) { %><a class="soft-button" href="/admin/orders?country=<%= selectedCommerce.country %>&amp;record=<%= encodeURIComponent(selectedCommerce.replacementOrderPublicId) %>">Review replacement order</a><% } %>
  <% } %>
  <% if (commerce.commerceKind === 'payments') { %><p class="form-intro">Provider: <%= selectedCommerce.provider %> · Refunded: <%= commerceMoney(selectedCommerce.refundedMinor,selectedCommerce.currency) %> · Reserved: <%= commerceMoney(selectedCommerce.refundReservedMinor,selectedCommerce.currency) %>.</p>
    <% if (selectedCommerce.canVerify) { %><form method="post" action="/admin/payments/<%= encodeURIComponent(selectedCommerce.publicId) %>/verify" class="role-inline-action"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedCommerce.version %>"><button class="primary-button" type="submit">Verify current provider outcome</button></form><% } %>
  <% } %>
  <% if (commerce.commerceKind === 'refunds') { %>
    <p class="form-intro"><%= selectedCommerce.reason %></p>
    <% if (selectedCommerce.canComplete) { %>
    <form method="post" enctype="multipart/form-data" action="/admin/payments/refunds/<%= encodeURIComponent(selectedCommerce.publicId) %>/evidence" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedCommerce.version %>"><label><span>Verified disbursement receipt image</span><input type="file" name="document" accept="image/jpeg,image/png,image/webp" required></label><label class="wide"><span>Evidence description</span><textarea name="description" minlength="10" maxlength="300" rows="2" required></textarea></label><div class="wide"><button class="soft-button" type="submit">Attach private disbursement evidence</button></div></form>
    <% if (selectedCommerce.evidence && selectedCommerce.evidence.some(evidence=>evidence.canConfirm)) { %><form method="post" action="/admin/payments/refunds/<%= encodeURIComponent(selectedCommerce.publicId) %>/complete" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedCommerce.version %>"><label><span>Your attached disbursement evidence</span><select name="evidencePublicId" required><% for (const evidence of selectedCommerce.evidence.filter(item=>item.canConfirm)) { %><option value="<%= evidence.publicId %>"><%= evidence.description || evidence.publicId %></option><% } %></select></label><label><span>Verified refund reference</span><input name="reference" minlength="4" maxlength="180" required autocomplete="off"></label><p class="wide form-intro">Confirm the actual disbursement using your attached evidence. The operator who reserved or inspected this refund cannot confirm it.</p><div class="wide"><button class="primary-button" type="submit">Confirm refund completion</button></div></form><% } %>
    <% } else if (selectedCommerce.status === 'processing') { %><p class="form-intro">A different operator must attach actual disbursement evidence and confirm this refund.</p><% } %>
  <% } %>
  <% if (commerce.commerceKind === 'events') { %><p class="form-intro">Matched payment: <%= selectedCommerce.paymentPublicId %> · Attempts: <%= selectedCommerce.attempts %>.</p>
    <% if (selectedCommerce.canReplay) { %><form method="post" action="/admin/payments/events/<%= encodeURIComponent(selectedCommerce.publicId) %>/replay" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selectedCommerce.version %>"><label class="wide"><span>Replay reason</span><textarea name="reason" minlength="5" maxlength="300" rows="3" required></textarea></label><div class="wide"><button class="primary-button" type="submit">Queue independent provider verification</button></div></form><% } %>
  <% } %>
  <% for (const event of selectedCommerce.timeline || []) { %><p class="form-intro"><%= event.message %></p><% } %>
</section>
<% } %>
<% if (commerce.refundOrder) { const refundOrder=commerce.refundOrder; %>
<section class="panel role-form-section" aria-labelledby="admin-refund-review-heading"><div class="role-panel-head"><h2 id="admin-refund-review-heading">Inspected return refund</h2><span class="role-status"><%= refundOrder.returnPublicId %></span></div>
  <p class="form-intro">The inspected received goods determine the refund amount and original order lines.</p><div class="role-form-grid"><% for (const line of refundOrder.items) { %><div><span><%= line.title %> · <%= line.quantity %> unit(s)</span><strong><%= commerceMoney(line.grossMinor,refundOrder.currency) %></strong></div><% } %></div>
  <form method="post" action="/admin/payments/refunds" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="orderId" value="<%= refundOrder.publicId %>"><input type="hidden" name="returnPublicId" value="<%= refundOrder.returnPublicId %>"><input type="hidden" name="returnVersion" value="<%= refundOrder.returnVersion %>"><input type="hidden" name="version" value="<%= refundOrder.payment.version %>"><input type="hidden" name="idempotencyKey" value="<%= commerce.idempotencyKey %>"><input type="hidden" name="amountMinor" value="<%= refundOrder.amountMinor %>"><label class="wide"><span>Independent refund review reason</span><textarea name="reason" minlength="3" maxlength="300" rows="3" required></textarea></label><div class="wide"><button class="primary-button" type="submit">Reserve exact inspected refund · <%= commerceMoney(refundOrder.amountMinor,refundOrder.currency) %></button></div></form>
</section><% } %>
<% if (commerce.pageId === 'admin-payments' && commerce.country) { %>
<section class="panel role-form-section" aria-labelledby="admin-payment-reconcile-heading"><div class="role-panel-head"><h2 id="admin-payment-reconcile-heading">Reconcile provider payments</h2></div><form method="post" action="/admin/payments/reconciliation" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="country" value="<%= commerce.country %>"><label><span>Window</span><select name="hours" required><option value="24">Last 24 hours</option><option value="72">Last 72 hours</option><option value="168">Last 7 days</option></select></label><p class="wide form-intro">Each matched payment is checked with the provider. The saved run records actual results and exceptions.</p><div class="wide"><button class="soft-button" type="submit">Run scoped reconciliation</button></div></form></section>
<% } %>
