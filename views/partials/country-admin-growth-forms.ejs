<% const growth = typeof countryAdminFlow !== 'undefined' ? countryAdminFlow : pageFlow; const growthDraft = growth.draft || {}; const growthSelected = growth.selected; const countryChoices = growth.context.countries; const growthCountry = growthDraft.country || growthSelected?.country || growth.country || countryChoices[0]?.code; const growthValue = (key, fallback = '') => growthDraft[key] ?? growthSelected?.[key] ?? fallback; const growthDate = value => value ? new Date(value).toISOString().slice(0,16) : ''; %>
<% if (growth.error) { %><div class="panel dashboard-message platform-flash" role="alert"><%= growth.error %></div><% } %>
<% if (growth.pageId === 'admin-campaigns') { %><div class="seller-verification-actions"><a class="outline-button" href="/admin/campaigns?tab=messaging<%= growth.country ? '&country=' + growth.country : '' %>" <%= growth.tab === 'messaging' ? 'aria-current=page' : '' %>>Consent Messages</a><a class="outline-button" href="/admin/campaigns?tab=affiliate<%= growth.country ? '&country=' + growth.country : '' %>" <%= growth.tab === 'affiliate' ? 'aria-current=page' : '' %>>Seller Affiliate Campaigns</a></div><% } %>
<% if (growth.pageId === 'admin-coupons') { const couponEditing = growthSelected && ['draft','paused'].includes(growthSelected.status); %>
<section class="panel form-panel" id="countryGrowthEditor"><div class="role-panel-head"><div><h2><%= couponEditing ? 'Edit Coupon' : 'Create Country Coupon' %></h2><p>Checkout applies country, currency, store, category, audience and usage restrictions.</p></div></div>
<form method="post" action="<%= couponEditing ? '/admin/coupons/' + encodeURIComponent(growthSelected.publicId) + '/update' : '/admin/coupons' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(couponEditing) { %><input type="hidden" name="version" value="<%= growthSelected.version %>"><% } %>
<div class="role-form-grid"><label>Country<select name="country" required><% for (const market of countryChoices) { %><option value="<%= market.code %>" <%= market.code === growthCountry ? 'selected' : '' %>><%= market.name %> · <%= market.currency %></option><% } %></select></label><label>Code<input name="code" minlength="3" maxlength="32" pattern="[A-Za-z0-9_-]+" required value="<%= couponEditing ? growthValue('code') : growthDraft.code || '' %>" <%= couponEditing ? 'readonly' : '' %>></label><label>Name<input name="name" minlength="2" maxlength="140" required value="<%= couponEditing ? growthValue('name') : growthDraft.name || '' %>"></label><label>Owner scope<select name="scope"><% for (const value of ['platform','seller']) { %><option value="<%= value %>" <%= growthValue('scope','platform') === value ? 'selected' : '' %>><%= value %></option><% } %></select></label><label>Seller store reference<input name="storePublicId" maxlength="100" value="<%= growthValue('storePublicId') %>"></label><label>Discount type<select name="discountType"><% for (const value of ['percent','fixed','free_shipping']) { %><option value="<%= value %>" <%= growthValue('discountType','percent') === value ? 'selected' : '' %>><%= value.replaceAll('_',' ') %></option><% } %></select></label>
<% for (const [key,title,max] of [['discountBps','Percentage in basis points',9000],['discountMinor','Fixed discount in minor units',2000000000],['minimumSubtotalMinor','Minimum subtotal in minor units',2000000000],['maximumDiscountMinor','Maximum discount in minor units',2000000000],['usageLimit','Total usage limit (0 = unlimited)',1000000],['perUserLimit','Per account limit (0 = unlimited)',1000]]) { %><label><%= title %><input type="number" name="<%= key %>" min="0" max="<%= max %>" step="1" value="<%= growthValue(key,key === 'perUserLimit' ? 1 : 0) %>" required></label><% } %>
<label>Starts at (UTC)<input type="datetime-local" name="startsAt" value="<%= growthDraft.startsAt || (couponEditing ? growthDate(growthSelected.startsAt) : '') %>"></label><label>Ends at (UTC)<input type="datetime-local" name="endsAt" value="<%= growthDraft.endsAt || (couponEditing ? growthDate(growthSelected.endsAt) : '') %>"></label><label>Eligible marketplace roles<input name="eligibleRoles" maxlength="200" value="<%= Array.isArray(growthValue('eligibleRoles')) ? growthValue('eligibleRoles').join(',') : growthValue('eligibleRoles') %>" placeholder="customer,business"></label><label>Eligible category references<input name="eligibleCategoryPublicIds" maxlength="10000" value="<%= Array.isArray(growthValue('eligibleCategoryPublicIds')) ? growthValue('eligibleCategoryPublicIds').join(',') : growthValue('eligibleCategoryPublicIds') %>"></label><label>Eligible store references<input name="eligibleStorePublicIds" maxlength="10000" value="<%= Array.isArray(growthValue('eligibleStorePublicIds')) ? growthValue('eligibleStorePublicIds').join(',') : growthValue('eligibleStorePublicIds') %>"></label><label class="wide">Description<textarea name="description" maxlength="500" rows="3"><%= growthValue('description') %></textarea></label><label><input type="checkbox" name="firstOrderOnly" <%= growthValue('firstOrderOnly',false) ? 'checked' : '' %>> First order only</label><input type="hidden" name="status" value="draft"></div><button class="primary-button" type="submit"><%= couponEditing ? 'Save Coupon' : 'Create Draft Coupon' %></button></form></section>
<% if (growthSelected) { %><section class="panel form-panel" id="countryGrowthRecords"><h2><%= growthSelected.code %> · <%= growthSelected.name %></h2><p><%= growthSelected.country %> · <%= growthSelected.status %> · <%= growthSelected.usageCount %> recorded uses</p><% for (const status of ['active','paused','archived'].filter(status => ['draft','active','paused'].includes(growthSelected.status) && status !== growthSelected.status && (status !== 'paused' || growthSelected.status === 'active'))) { %><form method="post" action="/admin/coupons/<%= encodeURIComponent(growthSelected.publicId) %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="country" value="<%= growthSelected.country %>"><input type="hidden" name="version" value="<%= growthSelected.version %>"><input type="hidden" name="status" value="<%= status %>"><button class="outline-button" type="submit"><%= status === 'active' ? 'Activate' : status === 'paused' ? 'Pause' : 'Archive' %> Coupon</button></form><% } %></section><% } %>
<% } else if (growth.pageId === 'admin-campaigns' && growth.tab === 'messaging') { const campaignEditing = growthSelected && ['draft','scheduled'].includes(growthSelected.status); %>
<section class="panel form-panel" id="countryGrowthEditor"><div class="role-panel-head"><div><h2><%= campaignEditing ? 'Edit Consent Campaign' : 'Create Consent Campaign' %></h2><p>Only active, verified accounts with current marketing consent qualify. Queued work remains subject to current consent and country authority.</p></div></div><form method="post" action="<%= campaignEditing ? '/admin/campaigns/messaging/' + encodeURIComponent(growthSelected.publicId) + '/update' : '/admin/campaigns/messaging' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(campaignEditing) { %><input type="hidden" name="version" value="<%= growthSelected.version %>"><% } %><div class="role-form-grid"><label>Country<select name="country" required><% for(const market of countryChoices) { %><option value="<%= market.code %>" <%= market.code === growthCountry ? 'selected' : '' %>><%= market.name %></option><% } %></select></label><label>Name<input name="name" minlength="2" maxlength="160" required value="<%= campaignEditing ? growthValue('name') : growthDraft.name || '' %>"></label><label class="wide">Subject<input name="subject" minlength="2" maxlength="180" required value="<%= campaignEditing ? growthValue('subject') : growthDraft.subject || '' %>"></label><label>Audience roles<input name="roles" maxlength="200" placeholder="customer,business,promoter" value="<%= campaignEditing ? (growthSelected.roles || []).join(',') : growthDraft.roles || '' %>"></label><label>Schedule at (UTC)<input type="datetime-local" name="scheduledAt" value="<%= growthDraft.scheduledAt || (campaignEditing ? growthDate(growthSelected.scheduledAt) : '') %>"></label><label class="wide">Plain text message<textarea name="body" rows="6" minlength="3" maxlength="10000" required><%= campaignEditing ? growthValue('body') : growthDraft.body || '' %></textarea></label></div><button type="submit" class="primary-button"><%= campaignEditing ? 'Save Campaign' : 'Create Campaign' %></button></form></section>
<% if(growthSelected) { %><section class="panel form-panel" id="countryGrowthRecords"><h2><%= growthSelected.name %></h2><p><%= growthSelected.country %> · <%= growthSelected.status %> · <%= growthSelected.queuedCount %> queued recipients</p><p><%= growthSelected.subject %></p><p><%= growthSelected.body %></p><% for(const action of (['draft','scheduled'].includes(growthSelected.status) ? ['queue','cancel'] : growthSelected.status === 'running' ? ['cancel'] : [])) { %><form method="post" action="/admin/campaigns/messaging/<%= encodeURIComponent(growthSelected.publicId) %>/<%= action %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="country" value="<%= growthSelected.country %>"><input type="hidden" name="version" value="<%= growthSelected.version %>"><button type="submit" class="outline-button"><%= action === 'queue' ? 'Queue Due Campaign' : 'Cancel Campaign' %></button></form><% } %></section><% } %>
<% } else if(growth.pageId === 'admin-campaigns') { %><section class="panel form-panel" id="countryGrowthRecords"><h2>Seller Affiliate Campaign Review</h2><% if(growthSelected) { const decisions = {submitted:['active','rejected'],active:['paused','ended'],paused:['active','ended']}; %><h3><%= growthSelected.name %></h3><p><%= growthSelected.country %> · <%= growthSelected.status %></p><p><%= growthSelected.disclosureText %></p><% for(const fact of growthSelected.facts || []) { %><p><%= fact %></p><% } %><% for(const status of decisions[growthSelected.status] || []) { %><form method="post" action="/admin/campaigns/affiliate/<%= encodeURIComponent(growthSelected.publicId) %>/decision"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="country" value="<%= growthSelected.country %>"><input type="hidden" name="version" value="<%= growthSelected.version %>"><input type="hidden" name="status" value="<%= status %>"><div class="role-form-grid"><label class="wide">Decision reason<textarea name="reason" minlength="3" maxlength="500" rows="3" required></textarea></label></div><button type="submit" class="outline-button"><%= status === 'active' ? 'Approve / Resume' : status === 'rejected' ? 'Reject' : status === 'paused' ? 'Pause' : 'End' %> Campaign</button></form><% } %><% } else { %><p>Open a seller campaign from the table to review its stored brief and products.</p><% } %></section>
<% } else if(growth.pageId === 'admin-content') { const latestRevision = growthSelected?.revisions?.at(-1); %>
<section class="panel form-panel" id="countryGrowthEditor"><div class="role-panel-head"><div><h2><%= growthSelected ? 'Create New Revision' : 'Create Country Content' %></h2><p>Plain text homepage slides, press articles and help content use immutable revisions. Another administrator approves publication.</p></div></div><form method="post" action="/admin/content/revisions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(growthSelected) { %><input type="hidden" name="version" value="<%= growthSelected.version %>"><% } %><div class="role-form-grid"><label>Country<select name="country" required><% for(const market of countryChoices) { %><option value="<%= market.code %>" <%= market.code === growthCountry ? 'selected' : '' %>><%= market.name %></option><% } %></select></label><label>Content key<input name="key" maxlength="120" required value="<%= growthDraft.key || growthSelected?.key || '' %>" placeholder="home.hero.welcome" <%= growthSelected ? 'readonly' : '' %>></label><label>Type<select name="type"><% for(const type of ['hero','press','help']) { %><option value="<%= type %>" <%= (growthDraft.type || growthSelected?.type || 'hero') === type ? 'selected' : '' %>><%= type %></option><% } %></select></label><label>Title<input name="title" minlength="2" maxlength="180" required value="<%= growthDraft.title || latestRevision?.title || '' %>"></label><label class="wide">Plain text body<textarea name="body" rows="6" minlength="3" maxlength="20000" required><%= growthDraft.body || latestRevision?.body || '' %></textarea></label><% for(const [key,title] of [['image','Marketplace image path'],['eyebrow','Eyebrow'],['category','Category label'],['action','Action label'],['readTime','Read time']]) { %><label><%= title %><input name="<%= key %>" maxlength="<%= key === 'image' ? 800 : 100 %>" value="<%= growthDraft[key] || latestRevision?.data?.[key] || '' %>"></label><% } %><label class="wide">Revision reason<textarea name="reason" minlength="3" maxlength="1000" rows="3" required><%= growthDraft.reason || '' %></textarea></label></div><button class="primary-button" type="submit">Save Draft Revision</button></form></section>
<% if(growthSelected) { %><section class="panel form-panel" id="countryGrowthRecords"><h2><%= growthSelected.key %></h2><p><%= growthSelected.country %> · <%= growthSelected.status %> · public version <%= growthSelected.activeVersion || 'none' %></p><% if(growthSelected.scheduledVersion) { %><form method="post" action="/admin/content/<%= encodeURIComponent(growthSelected.publicId) %>/cancel-schedule"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="country" value="<%= growthSelected.country %>"><input type="hidden" name="version" value="<%= growthSelected.version %>"><div class="role-form-grid"><label class="wide">Cancellation reason<textarea name="reason" minlength="3" maxlength="1000" rows="3" required></textarea></label></div><button class="outline-button" type="submit">Cancel Scheduled Publication</button></form><% } %><% for(const revision of growthSelected.revisions) { %><details class="faq-item"><summary>Version <%= revision.version %> · <%= revision.title %><%= revision.publishedAt ? ' · previously published' : '' %></summary><p><%= revision.body %></p><p><%= revision.reason %></p><% if(!growthSelected.scheduledVersion && revision.version !== growthSelected.activeVersion) { %><form method="post" action="/admin/content/<%= encodeURIComponent(growthSelected.publicId) %>/publication"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="country" value="<%= growthSelected.country %>"><input type="hidden" name="version" value="<%= growthSelected.version %>"><input type="hidden" name="revisionVersion" value="<%= revision.version %>"><div class="role-form-grid"><label>Action<select name="action"><option value="publish">Publish</option><% if(revision.publishedAt) { %><option value="rollback">Rollback</option><% } %></select></label><label>Publication schedule (UTC, optional)<input type="datetime-local" name="scheduledFor"></label><label class="wide">Publication reason<textarea name="reason" rows="3" minlength="3" maxlength="1000" required></textarea></label></div><button class="outline-button" type="submit">Request Independent Approval</button></form><% } %></details><% } %></section><% } %>
<section class="panel form-panel" id="countryPublicationDecisions"><h2>Pending Publication Decisions</h2><% if(!growth.approvals.length) { %><p>No pending country publication requests.</p><% } %><% for(const approval of growth.approvals) { %><details class="faq-item"><summary><%= approval.country %> · <%= approval.type.replaceAll('_',' ') %> · revision <%= approval.revisionVersion %></summary><p><%= approval.reason %></p><a class="plain-link" href="/admin/content?country=<%= approval.country %>&amp;id=<%= encodeURIComponent(approval.targetPublicId) %>">Review Content</a><% if(!approval.requestedByMe) { %><form method="post" action="/admin/content/approvals/<%= encodeURIComponent(approval.publicId) %>/decision"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="country" value="<%= approval.country %>"><input type="hidden" name="version" value="<%= approval.version %>"><div class="role-form-grid"><label>Decision<select name="decision"><option value="approve">Approve and apply</option><option value="reject">Reject</option></select></label><label class="wide">Decision reason<textarea name="reason" rows="3" minlength="3" maxlength="1000" required></textarea></label></div><button class="outline-button" type="submit">Record Decision</button></form><% } else { %><p>Another administrator must decide your request.</p><% } %></details><% } %><% const publicationPage=growth.approvalsPage||{}; const publicationLink=cursor=>{const params=new URLSearchParams();for(const key of ['country','search','status','after','id'])if(growth.filters?.[key])params.set(key,growth.filters[key]);if(cursor)params.set('approvalsAfter',cursor);return '/admin/content'+(params.size?'?'+params:'')+'#countryPublicationDecisions';}; %><nav class="role-table-footer" aria-label="Publication decision pages"><span><%= growth.approvals.length %> decisions on this page<%= Number.isFinite(publicationPage.total)?' · '+publicationPage.total+' total':'' %></span><div><% if(growth.filters?.approvalsAfter) { %><a class="plain-link" href="<%= publicationLink('') %>">First decisions</a><% } %><% if(publicationPage.hasMore) { %><a class="plain-link" href="<%= publicationLink(publicationPage.next) %>">Next decisions</a><% } %></div></nav></section>
<% } %>
