<% const directoryPeople = typeof initialPeople !== 'undefined' ? initialPeople : []; directoryPeople.forEach(person => { const sellerDirectory = typeof directoryKind !== 'undefined' && directoryKind === 'sellers'; const profilePath = '/' + (sellerDirectory ? 'sellers/' + encodeURIComponent(person.slug) : 'promoters/' + encodeURIComponent(person.id)) + '?country=' + encodeURIComponent(country.code); %>
<article class="person-card"><div class="person-cover"></div><div class="person-content"><img class="person-avatar" src="<%= person.image %>" alt="<%= person.name %>" loading="lazy" decoding="async"/><span class="person-verified"><img src="/assets/icons/circle-check.svg" alt=""/>Verified</span><h2><%= person.name %></h2><p class="person-role"><%= person.country %> marketplace <%= sellerDirectory ? 'seller' : 'promoter' %></p><p class="person-bio"><%= person.description %></p><div class="person-metrics"><span><strong><%= sellerDirectory ? (person.rating ? Number(person.rating).toFixed(1) : 'New') : person.campaignCount || 0 %></strong><small><%= sellerDirectory ? 'Rating' : 'Campaigns' %></small></span><span><strong><%= sellerDirectory ? person.productCount || 0 : person.clicks || 0 %></strong><small><%= sellerDirectory ? 'Products' : 'Clicks' %></small></span><span><strong><%= sellerDirectory ? person.categories?.length || 0 : person.conversions || 0 %></strong><small><%= sellerDirectory ? 'Categories' : 'Conversions' %></small></span></div><div class="person-tags"><% (sellerDirectory ? person.categories || [] : [...(person.niches || []), ...(person.channels || [])]).slice(0,4).forEach(tag => { %><span><%= tag %></span><% }); %></div><div class="person-actions"><a href="<%= profilePath %>">View profile</a><a class="person-products-link" href="<%= sellerDirectory ? '/products?seller=' + encodeURIComponent(person.slug) + '&country=' + encodeURIComponent(country.code) : profilePath + '#profileProducts' %>"><%= sellerDirectory ? 'Products' : 'Campaign picks' %></a><button type="button" data-follow="<%= sellerDirectory ? person.slug : person.id %>" aria-label="Follow <%= person.name %>"><img src="/assets/icons/heart-regular.svg" alt=""/></button></div></div></article>
<% }); %>
