<% if (measured) {
  const measurement = measured.summary, measureFilters = measured.filters;
  const params = new URLSearchParams(); if (measureFilters.warehousePublicId) params.set('warehousePublicId', measureFilters.warehousePublicId); if (measureFilters.from) params.set('from', measureFilters.from); if (measureFilters.to) params.set('to', measureFilters.to); params.set('measure', measureFilters.kind);
  const csv = '/warehouse/reports/measured.csv?' + params.toString(); if (measured.page.next) params.set('measureAfter', measured.page.next);
  const decimal = value => value === null || value === undefined ? 'Not measured' : Number(value).toLocaleString('en-UG', {maximumFractionDigits:1});
%>
<section class="role-metric-grid warehouse-live-section" aria-label="Measured warehouse performance">
  <% for (const [name,value,detail] of [['Average task time',measurement.averageTaskMinutes === null ? 'Not measured' : decimal(measurement.averageTaskMinutes) + ' min',measurement.durationSamples + ' valid claim-to-completion samples'],['Completed on time',measurement.onTimePercent === null ? 'Not measured' : decimal(measurement.onTimePercent) + '%',measurement.onTime + ' of ' + measurement.slaSamples + ' completions with a recorded due time'],['Carrier handover',measurement.averageHandoverMinutes === null ? 'Not measured' : decimal(measurement.averageHandoverMinutes) + ' min',measurement.custodySamples + ' dispatch-to-carrier custody samples'],['Exact count accuracy',measurement.countAccuracyPercent === null ? 'Not measured' : decimal(measurement.countAccuracyPercent) + '%',measurement.exactCounts + ' exact of ' + measurement.measuredCounts + ' physical stock snapshots']]) { %>
  <article class="role-metric panel"><span class="role-metric-icon tone-1"><svg aria-hidden="true"><use href="#i-clipboard"></use></svg></span><div><small><%= name %></small><strong><%= value %></strong><span><%= detail %></span></div></article>
  <% } %>
</section>
<section class="panel role-form-section warehouse-live-section"><div class="role-panel-head"><div><h2>Measured Performance</h2><p>The selected warehouse and UTC date range apply to the full population. Missing timestamps and legacy count snapshots are excluded from their measurement denominators.</p></div><a class="outline-button" href="<%= csv %>">Export Measured Report</a></div><p class="form-intro"><%= measurement.unmeasuredDurations %> completed tasks lack valid duration evidence. <%= measurement.excludedCounts %> count records lack an authoritative stock snapshot. Absolute physical variance: <%= measurement.absoluteVarianceUnits %> units across <%= measurement.expectedUnits %> expected counted units.</p>
  <form class="role-form-grid" method="get" action="/warehouse/reports"><input type="hidden" name="warehousePublicId" value="<%= measureFilters.warehousePublicId %>"><input type="hidden" name="from" value="<%= measureFilters.from %>"><input type="hidden" name="to" value="<%= measureFilters.to %>"><label>Measured records<select name="measure"><option value="tasks" <%= measureFilters.kind === 'tasks' ? 'selected' : '' %>>Task completions</option><option value="handover" <%= measureFilters.kind === 'handover' ? 'selected' : '' %>>Carrier handovers</option><option value="counts" <%= measureFilters.kind === 'counts' ? 'selected' : '' %>>Physical stock counts</option></select></label><div class="warehouse-live-actions"><button class="outline-button" type="submit">Show Records</button></div></form>
</section>
<section class="panel role-table-panel warehouse-live-section"><div class="role-panel-head"><div><h2><%= measureFilters.kind === 'counts' ? 'Physical Count Evidence' : measureFilters.kind === 'handover' ? 'Carrier Custody Evidence' : 'Completed Task Evidence' %></h2></div></div><div class="role-table-wrap"><table class="role-table"><caption class="sr-only">Measured warehouse records</caption><thead><tr><th scope="col">Reference / Warehouse</th><th scope="col">Recorded</th><th scope="col"><%= measureFilters.kind === 'counts' ? 'Expected / Counted' : measureFilters.kind === 'handover' ? 'Carrier custody' : 'Task duration' %></th><th scope="col"><%= measureFilters.kind === 'counts' ? 'Variance / Snapshot' : measureFilters.kind === 'handover' ? 'Handover delay' : 'Recorded SLA' %></th></tr></thead><tbody>
  <% for (const row of measured.rows) { %><tr><td data-label="Reference / Warehouse"><strong><%= row.publicId %></strong><small class="warehouse-live-cell-note"><%= row.warehouseName %></small></td><td data-label="Recorded"><%= formatDate(row.recordedAt) %></td><td data-label="Measurement"><% if (measureFilters.kind === 'counts') { %><%= row.expectedOnHand %> / <%= row.countedOnHand %><% } else if (measureFilters.kind === 'handover') { %><%= row.handoverAt ? formatDate(row.handoverAt) : 'Awaiting carrier collection' %><small class="warehouse-live-cell-note"><%= row.parcelPublicId %></small><% } else { %><%= decimal(row.durationMinutes) %><%= row.durationMinutes === null ? '' : ' min' %><% } %></td><td data-label="Outcome"><% if (measureFilters.kind === 'counts') { %><%= row.variance %> units · <%= row.measuredCount ? 'Measured snapshot' : 'Legacy snapshot unavailable' %><% } else if (measureFilters.kind === 'handover') { %><%= decimal(row.handoverMinutes) %><%= row.handoverMinutes === null ? '' : ' min' %><% } else { %><%= row.onTime === null ? 'No recorded due time' : row.onTime ? 'Completed on time' : 'Completed late' %><% if (row.dueAt) { %><small class="warehouse-live-cell-note">Due <%= formatDate(row.dueAt) %></small><% } %><% } %></td></tr><% } %>
  <% if (!measured.rows.length) { %><tr><td class="warehouse-live-empty" colspan="4">No measured records match the selected range.</td></tr><% } %>
</tbody></table></div><% if (measured.page.hasMore) { %><div class="role-table-footer"><a class="outline-button" href="/warehouse/reports?<%= params.toString() %>">Next Measured Page</a></div><% } %></section>
<% } %>
