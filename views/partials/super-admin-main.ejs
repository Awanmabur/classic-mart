<%
const flow=superAdminFlow, filters=flow.filters||{}, selected=flow.selected, page=flow.page||{};
const countries=flow.context.countries||[], parameters=flow.parameters||{};
const href=patch=>{const params=new URLSearchParams(parameters);for(const[key,value]of Object.entries(patch)){if(value==null||value==='')params.delete(key);else params.set(key,String(value));}return superAdminPage.href+(params.size?'?'+params:'');};
const statusTone=value=>/^(active|approved|paid|completed|published|ready|applied|resolved|verified|passed|succeeded|remediated)$/i.test(String(value))?'good':/^(failed|rejected|expired|cancelled|suspended|revoked|blocked|critical|error)$/i.test(String(value))?'bad':'warn';
const eventDate=value=>value?new Date(value).toISOString():'—';
%>
<section class="app-page active role-page country-admin-standard-live country-admin-fidelity-page" data-page="<%= superAdminPage.id %>" data-role="superadmin" data-page-kind="<%= superAdminPage.kind %>">
  <div class="page-heading role-page-heading"><div><span class="eyebrow"><%= superAdminPage.eyebrow %></span><h1><%= superAdminPage.title %></h1><p><%= superAdminPage.description %></p></div><div class="country-admin-heading-actions">
    <form class="country-admin-country-filter" method="get" action="<%= superAdminPage.href %>"><% for(const[key,value]of Object.entries(parameters)){if(key==='country')continue; %><input type="hidden" name="<%= key %>" value="<%= value %>"><% } %><label class="sr-only" for="superAdminCountry">Market scope</label><select id="superAdminCountry" name="country"><option value="" <%= flow.country===''?'selected':'' %>>All platform markets</option><% for(const country of countries){ %><option value="<%= country.code %>" <%= flow.country===country.code?'selected':'' %>><%= country.name %></option><% } %></select><button class="plain-link" type="submit">Apply</button></form>
  </div></div>
  <section class="role-metric-grid"><% for(const[index,metric]of (flow.metrics||[]).entries()){ %><article class="role-metric panel"><span class="role-metric-icon tone-<%= index%4+1 %>"><svg aria-hidden="true"><use href="#<%= ['i-user','i-clipboard','i-bag','i-shield'][index%4] %>"></use></svg></span><div><small><%= metric.label %></small><strong><%= metric.value??'—' %></strong><span><%= metric.detail||'Current source records' %></span></div></article><% } %></section>
  <div class="role-content-grid"><div class="role-side-stack">
    <section class="panel role-table-panel" id="super-admin-records"><div class="role-panel-head"><div><h2><%= (flow.tabs||[]).find(tab=>tab.value===filters.tab)?.label||superAdminPage.label %></h2><p>Current platform records<%= flow.country?' for '+flow.country:'' %>.</p></div><div class="role-table-tools"><form class="country-admin-compact-filter" method="get" action="<%= superAdminPage.href %>"><% for(const[key,value]of Object.entries(parameters)){if(key==='search')continue; %><input type="hidden" name="<%= key %>" value="<%= value %>"><% } %><label class="role-mini-search"><svg aria-hidden="true"><use href="#i-search"></use></svg><input name="search" type="search" maxlength="100" value="<%= filters.search||'' %>" aria-label="Search current records" placeholder="Filter records"></label><button class="plain-link" type="submit">Search</button></form><a class="outline-button role-export" href="<%= flow.exportHref %>"><svg aria-hidden="true"><use href="#i-download"></use></svg>Export</a></div></div>
    <% if(flow.tabs.length){ %><nav class="role-status-tabs country-admin-record-tabs" aria-label="Record type"><% for(const tab of flow.tabs){ %><a href="<%= href({tab:tab.value,status:'',search:''}) %>" class="<%= tab.value===filters.tab?'active':'' %>" <%= tab.value===filters.tab?'aria-current=page':'' %>><%= tab.label %></a><% } %></nav><% } %>
    <% if(flow.statusOptions.length){ %><nav class="role-status-tabs country-admin-record-tabs" aria-label="Record status"><% for(const status of flow.statusOptions){ %><a href="<%= href({status:status.value}) %>" class="<%= status.value===filters.status?'active':'' %>" <%= status.value===filters.status?'aria-current=page':'' %>><%= status.label %></a><% } %></nav><% } %>
    <div class="role-table-wrap"><table class="role-table"><thead><tr><% for(const column of flow.columns){ %><th><%= column %></th><% } %><th>Action</th></tr></thead><tbody><% for(const row of flow.rows){ %><tr><% for(const[index,cell]of row.cells.entries()){ %><td data-label="<%= flow.columns[index] %>"><% if(/status|state|visibility|availability/i.test(flow.columns[index])){ %><span class="role-status <%= statusTone(cell) %>"><%= cell %></span><% }else{ %><span><%= cell??'—' %></span><% } %></td><% } %><td data-label="Action"><a class="role-row-menu country-admin-record-action" href="<%= row.href %>" aria-label="Open <%= row.cells[0] %>">•••</a></td></tr><% } %><% if(!flow.rows.length){ %><tr><td colspan="<%= flow.columns.length+1 %>">No records match this view.</td></tr><% } %></tbody></table></div>
    <div class="role-table-footer"><span><%= flow.rows.length %> on this page · <%= page.total??0 %> total</span><div><% if(filters.after){ %><a class="plain-link" href="<%= href({after:''}) %>">First</a><% }else{ %><span class="country-admin-page-control" aria-disabled="true">Previous</span><% } %><span class="country-admin-page-control active" aria-current="page">Current</span><% if(page.next){ %><a class="plain-link" href="<%= href({after:page.next}) %>">Next</a><% }else{ %><span class="country-admin-page-control" aria-disabled="true">Next</span><% } %></div></div></section>
    <% if(selected){ %><section class="panel form-panel"><div class="role-panel-head compact"><div><span class="eyebrow">Source record</span><h2><%= selected.publicId||selected.code||selected.key||selected.workerId %></h2></div><a class="plain-link" href="<%= href({id:''}) %>">Close</a></div><div class="role-health-rows"><% for(const row of flow.detailRows||[]){ %><div><span><%= row.label %></span><b><%= row.value??'—' %></b></div><% } %></div></section><% } %>
    <%- include('super-admin-forms') %>
  </div><aside class="role-side-stack">
    <section class="panel role-insights"><div class="role-panel-head compact"><div><span class="eyebrow">Platform control</span><h2>Review &amp; accountability</h2></div></div><div class="role-insight-list"><article><span>1</span><p>Confirm the source record and its market before changing access or commercial terms.</p></article><article><span>2</span><p>Staff access, account state, market policy, publication and feature changes require another administrator’s decision.</p></article><article><span>3</span><p>High risk changes require a password and authenticator confirmation within the last 15 minutes.</p></article></div><a class="soft-button full-button" href="/account/security">Password &amp; Security</a></section>
    <section class="panel role-progress-card"><div class="role-panel-head compact"><div><span class="eyebrow">Operating scope</span><h2><%= flow.country||'Global platform' %></h2></div></div><div class="role-health-rows"><div><span>Active markets</span><b><%= countries.length %></b></div><div><span>Reporting timezone</span><b><%= flow.context.timeZone %></b></div><% if(Number.isFinite(flow.approvalCount)){ %><div><span>Pending decisions</span><b><%= flow.approvalCount %></b></div><% } %><% for(const group of flow.orderGroups||[]){ %><div><span>Orders: <%= group.label %></span><b><%= group.count %></b></div><% } %></div><p class="form-intro">Money remains in each record’s currency and minor units.</p></section>
  </aside></div>
  <section class="panel role-activity-panel"><div class="role-panel-head"><div><h2>Operational review</h2><p>Follow source records through a recorded decision.</p></div><a class="plain-link" href="/super/audit">Audit history</a></div><div class="role-workflow-grid"><% for(const[index,item]of [{title:'Access decisions',text:'Review dedicated staff assignments and current scopes.',href:'/super/roles?tab=approvals'},{title:'Platform changes',text:'Independently decide policy and publication requests.',href:'/super/settings?tab=approvals'},{title:'System health',text:'Review findings, incidents and recorded controls.',href:'/super/security'}].entries()){ %><article><span class="role-step <%= index===0?'current':'' %>"><%= index+1 %></span><div><strong><%= item.title %></strong><p><%= item.text %></p></div><a class="plain-link" href="<%= item.href %>">Review</a></article><% } %></div></section>
</section>
