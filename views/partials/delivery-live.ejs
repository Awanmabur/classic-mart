<%
const flow = liveDelivery.flow, mode = flow.mode, profile = flow.profile, selected = flow.selected;
const label = value => String(value || '').replaceAll('_', ' ').replace(/\b\w/g, value => value.toUpperCase());
const money = value => formatMoney(Number(value || 0), flow.currency);
const paths = {overview:'/delivery',profile:'/delivery/profile',offers:'/delivery/offers',jobs:'/delivery/jobs',tracking:'/delivery/tracking',earnings:'/delivery/earnings'};
const titles = {overview:'Delivery Overview',profile:'Delivery Profile',offers:'Job Offers',jobs:'My Deliveries',tracking:'Delivery Tracking',earnings:'Delivery Earnings'};
const descriptions = {overview:'Manage your availability, review offers and follow your active deliveries.',profile:'Keep your transport and service areas current. Verification images are private.',offers:'Accept an explicit offer with its agreed earning and collection requirements.',jobs:'Record physical collection, delivery evidence, verification and cash handover.',tracking:'Follow delivery custody, attempts, exceptions and recorded outcomes.',earnings:'Review your available earnings and request a payout to a verified destination.'};
const statusTone = value => ['approved','delivered','paid'].includes(value) ? 'good' : ['rejected','suspended','failed'].includes(value) ? 'bad' : 'warn';
const nextParams = new URLSearchParams(); if (flow.filters.status) nextParams.set('status', flow.filters.status); if (flow.page.next) nextParams.set('after', flow.page.next);
%>
<section class="app-page active role-page warehouse-live-page delivery-live-page" data-page="delivery-<%= mode %>" data-role="delivery">
  <div class="page-heading role-page-heading"><div><span class="eyebrow"><%= mode === 'earnings' ? 'Finance' : mode === 'profile' ? 'Account' : 'Delivery' %></span><h1><%= titles[mode] %></h1><p><%= descriptions[mode] %></p></div><a class="outline-button" href="/account/security">Account Security</a></div>
  <% if (flow.error) { %><div class="panel dashboard-message dashboard-message-error platform-flash" role="alert"><%= flow.error %></div><% } %>
  <% if (mode === 'overview') { %>
  <section class="role-welcome panel"><div><span class="eyebrow">Delivery workspace</span><h2>Ready for your next delivery?</h2><p>Your profile is <%= label(profile.verificationStatus).toLowerCase() %>. <%= profile.available ? 'You are available for new offers.' : 'You are unavailable for new offers.' %></p><div class="warehouse-live-actions"><% if (profile.verificationStatus === 'approved') { %><form method="post" action="/delivery/availability"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= profile.version %>"><input type="hidden" name="available" value="<%= profile.available ? 'false' : 'true' %>"><button class="primary-button" type="submit"><%= profile.available ? 'Go Unavailable' : 'Go Available' %></button></form><% } else { %><a class="primary-button" href="/delivery/profile">Complete Delivery Profile</a><% } %><a class="outline-button" href="/delivery/offers">View Job Offers</a></div></div></section>
  <section class="role-metric-grid" aria-label="Delivery summary"><% for (const [title, value, icon] of [['Active deliveries',flow.summary.active,'i-truck'],['Available offers',flow.summary.offers,'i-bell'],['Delivered',flow.summary.delivered,'i-check'],['Open exceptions',flow.summary.exceptions,'i-shield']]) { %><article class="role-metric panel"><span class="role-metric-icon tone-1"><svg aria-hidden="true"><use href="#<%= icon %>"></use></svg></span><div><small><%= title %></small><strong><%= Number(value || 0).toLocaleString() %></strong><span>Your delivery account</span></div></article><% } %></section>
  <% } %>
  <% if (mode === 'profile') { %>
  <section class="panel role-form-section warehouse-live-section"><div class="role-panel-head"><div><h2>Transport and Service Areas</h2><p>Editing your profile or verification images requires a new independent review.</p></div><span class="role-status <%= statusTone(profile.verificationStatus) %>"><%= label(profile.verificationStatus) %></span></div>
    <% if (profile.reviewReason) { %><p class="form-intro"><%= profile.reviewReason %></p><% } %>
    <form class="role-form-grid" method="post" action="/delivery/profile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= profile.version %>"><label>Transport<select name="transport" required><% for (const transport of flow.transports) { %><option value="<%= transport %>" <%= transport === profile.transport ? 'selected' : '' %>><%= label(transport) %></option><% } %></select></label><label>Vehicle description<input name="vehicleLabel" value="<%= profile.vehicleLabel %>" maxlength="120" autocomplete="off"></label><label class="wide">Service areas<input name="serviceAreas" value="<%= profile.serviceAreas.join(', ') %>" maxlength="1800" placeholder="Areas separated by commas" required></label><div class="wide warehouse-live-actions"><button class="outline-button" name="action" value="save" type="submit">Save Profile</button><button class="primary-button" name="action" value="submit" type="submit">Submit for Verification</button></div></form>
  </section>
  <section class="panel role-form-section warehouse-live-section"><div class="role-panel-head"><div><h2>Private Verification Images</h2><p>Identity is required. Motor vehicles also require vehicle or permit evidence.</p></div></div>
    <% if (profile.publicId) { %><form class="role-form-grid" method="post" action="/delivery/profile/evidence" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= profile.version %>"><label>Document type<select name="documentType" required><option value="identity">Identity</option><option value="vehicle">Vehicle</option><option value="permit">Permit</option></select></label><label>Image<input type="file" name="document" accept="image/jpeg,image/png,image/webp" required></label><label class="wide">Description<input name="description" maxlength="300"></label><div class="wide warehouse-live-actions"><button class="primary-button" type="submit">Upload Private Image</button></div></form><% } else { %><p class="form-intro">Save your transport and service areas before uploading your verification images.</p><% } %>
    <div class="warehouse-live-actions"><% for (const item of flow.evidence) { %><a class="plain-link" href="/delivery/evidence/<%= encodeURIComponent(item.publicId) %>" target="_blank" rel="noopener"><%= label(item.documentType) %> · <%= formatDate(item.createdAt) %><span class="sr-only"> (opens a new tab)</span></a><% } %></div>
  </section>
  <% } %>
  <% if (mode === 'offers' || mode === 'overview') { %>
  <section class="panel role-table-panel warehouse-live-section"><div class="role-panel-head"><div><h2>Available Offers</h2><p>Only offers explicitly assigned to your account appear here.</p></div></div><div class="role-table-wrap"><table class="role-table"><caption class="sr-only">Your delivery offers</caption><thead><tr><th>Shipment</th><th>Service</th><th>Earning</th><th>Expires</th><th>Action</th></tr></thead><tbody><% for (const offer of flow.offers) { %><tr><td data-label="Shipment"><strong><%= offer.shipmentPublicId %></strong><small class="warehouse-live-cell-note"><%= offer.orderPublicId %></small></td><td data-label="Service"><%= label(offer.kind) %> · <%= label(offer.mode) %><small class="warehouse-live-cell-note"><%= offer.parcelCount %> parcel(s)<%= offer.codRequired ? ' · Cash collection' : '' %></small></td><td data-label="Earning"><%= money(offer.earningMinor) %></td><td data-label="Expires"><%= formatDate(offer.expiresAt) %></td><td data-label="Action"><div class="warehouse-live-actions"><% for (const decision of ['accept','decline']) { %><form method="post" action="/delivery/offers/<%= encodeURIComponent(offer.publicId) %>/<%= decision %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= offer.version %>"><button type="submit" class="<%= decision === 'accept' ? 'primary-button' : 'outline-button' %>" <%= !offer.canAccept ? 'disabled' : '' %>><%= label(decision) %><span class="sr-only"> <%= offer.shipmentPublicId %></span></button></form><% } %></div></td></tr><% } %><% if (!flow.offers.length) { %><tr><td class="warehouse-live-empty" colspan="5">No available delivery offers.</td></tr><% } %></tbody></table></div></section>
  <% } %>
  <% if (['jobs','tracking','overview'].includes(mode)) { %>
  <% if (mode !== 'overview') { %><section class="panel role-form-section warehouse-live-section"><form class="role-form-grid" method="get" action="<%= paths[mode] %>"><label>Delivery status<select name="status"><option value="">All deliveries</option><% for (const status of ['assigned','picked_up','in_transit','failed','rescheduled','return_to_sender','delivered','returned']) { %><option value="<%= status %>" <%= flow.filters.status === status ? 'selected' : '' %>><%= label(status) %></option><% } %></select></label><div class="warehouse-live-actions"><button class="outline-button" type="submit">Apply Filter</button></div></form></section><% } %>
  <section class="panel role-table-panel warehouse-live-section"><div class="role-panel-head"><div><h2><%= mode === 'overview' ? 'Active Deliveries' : 'Delivery History' %></h2><p>Collection and delivery require the recipient’s verification code.</p></div></div><div class="role-table-wrap"><table class="role-table"><caption class="sr-only">Assigned deliveries</caption><thead><tr><th>Shipment</th><th>Service</th><th>Status</th><th>Delivery due</th><th>Action</th></tr></thead><tbody><% for (const job of flow.jobs) { %><tr><td data-label="Shipment"><strong><%= job.publicId %></strong><small class="warehouse-live-cell-note"><%= job.orderPublicId %></small></td><td data-label="Service"><%= label(job.kind) %> · <%= job.parcelCount %> parcel(s)</td><td data-label="Status"><span class="role-status <%= statusTone(job.status) %>"><%= label(job.status) %></span></td><td data-label="Delivery due"><%= job.slaDueAt ? formatDate(job.slaDueAt) : 'No recorded SLA' %></td><td data-label="Action"><a class="outline-button" href="<%= paths[mode === 'overview' ? 'jobs' : mode] %>?record=<%= encodeURIComponent(job.publicId) %>">View Delivery</a></td></tr><% } %><% if (!flow.jobs.length) { %><tr><td class="warehouse-live-empty" colspan="5">No deliveries match this view.</td></tr><% } %></tbody></table></div></section>
  <% if (selected) { %>
  <section class="panel role-form-section warehouse-live-section"><div class="role-panel-head"><div><h2><%= selected.publicId %></h2><p><%= selected.orderPublicId %> · <%= label(selected.kind) %> · <%= label(selected.status) %></p></div></div>
    <div class="warehouse-live-record-grid"><article><h3><%= selected.kind === 'return' ? 'Collect From Buyer' : 'Deliver To Buyer' %></h3><p><%= selected.contact.fullName %><br><%= selected.contact.address %><br><%= selected.contact.city %><br><a class="plain-link" href="tel:<%= selected.contact.phone %>"><%= selected.contact.phone %></a></p><% if (selected.contact.note) { %><p><%= selected.contact.note %></p><% } %></article><article><h3><%= selected.kind === 'return' ? 'Receiving Locations' : 'Collection Locations' %></h3><% for (const location of selected.pickupLocations) { %><p><strong><%= location.name %></strong><br><%= location.address %><br><%= location.city %></p><% } %></article></div>
    <ul class="warehouse-live-manifest"><% for (const item of selected.items) { %><li><span><%= item.title %> · <%= item.sku %></span><strong>× <%= item.quantity %></strong></li><% } %></ul>
    <% for (const status of selected.actions) { %><form class="role-form-grid warehouse-live-task-form" method="post" action="/delivery/jobs/<%= encodeURIComponent(selected.publicId) %>/<%= status %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selected.version %>"><div class="wide"><h3><%= label(status === 'picked_up' ? 'Confirm Collection' : status === 'delivered' ? 'Confirm Delivery' : status) %></h3></div><% if (['picked_up','delivered','returned'].includes(status)) { %><label>Recipient verification code<input name="proofCode" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" autocomplete="one-time-code" required></label><% } %><% if (status === 'failed') { %><label>Attempt outcome<select name="reasonCode" required><% for (const reason of ['recipient_unavailable','address_not_found','address_incorrect','recipient_refused','unsafe_location','parcel_damaged','vehicle_issue','other']) { %><option value="<%= reason %>"><%= label(reason) %></option><% } %></select></label><% } %><% if (['failed','return_to_sender','returned'].includes(status)) { %><label>Reason<input name="reason" maxlength="240" required></label><% } %><% if (status === 'rescheduled') { %><label>New attempt time (UTC)<input type="datetime-local" name="rescheduledFor" required></label><% } %><div class="wide warehouse-live-actions"><button class="primary-button" type="submit"><%= label(status === 'picked_up' ? 'Confirm Collection' : status === 'delivered' ? 'Confirm Delivery' : status) %></button></div></form><% } %>
    <% if (!['returned','cancelled'].includes(selected.status)) { %><form class="role-form-grid warehouse-live-task-form" method="post" enctype="multipart/form-data" action="/delivery/jobs/<%= encodeURIComponent(selected.publicId) %>/evidence"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selected.version %>"><div class="wide"><h3>Private Delivery Evidence</h3><p class="form-intro">Save a photo of the actual handover before confirming delivery. Upload each attempt’s evidence separately.</p></div><label>Evidence type<select name="documentType"><option value="delivery_photo">Delivery photo</option><option value="delivery_signature">Recipient signature</option><option value="failed_attempt">Failed attempt</option><option value="address_exception">Address exception</option></select></label><label>Image<input type="file" name="document" accept="image/jpeg,image/png,image/webp" required></label><label class="wide">Description<input name="description" maxlength="300"></label><div class="wide warehouse-live-actions"><button class="outline-button" type="submit">Upload Evidence</button></div></form><% } %>
    <% if (selected.cod.required) { %><article class="warehouse-live-task-form"><h3>Cash on Delivery</h3><p>Expected <%= money(selected.cod.amountMinor) %> · Collected <%= money(selected.cod.collectedMinor) %></p><p><%= selected.cod.reconciledAt ? 'Finance reconciled this handover.' : selected.cod.reviewedAt ? 'Warehouse reviewed this receipt. Finance reconciliation is pending.' : selected.cod.handoverAt ? 'Cash receipt awaits independent Warehouse review.' : 'Record a receipt after actual delivery and cash collection.' %></p></article><% if (selected.status === 'delivered' && !selected.cod.reconciledAt) { %><form class="role-form-grid" method="post" enctype="multipart/form-data" action="/delivery/jobs/<%= encodeURIComponent(selected.publicId) %>/cod-handover"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selected.version %>"><label>Cash handed over (minor units)<input name="declaredAmountMinor" type="number" min="0" step="1" required></label><label>Handover receipt<input type="file" name="document" accept="image/jpeg,image/png,image/webp" required></label><div class="wide warehouse-live-actions"><button class="primary-button" type="submit">Record Cash Receipt</button></div></form><% } %><% } %>
    <div class="warehouse-live-task-form"><h3>Saved Evidence</h3><div class="warehouse-live-actions"><% for (const item of selected.evidence) { %><a class="plain-link" href="/delivery/evidence/<%= encodeURIComponent(item.publicId) %>" target="_blank" rel="noopener"><%= label(item.documentType) %> · <%= formatDate(item.createdAt) %><span class="sr-only"> (opens a new tab)</span></a><% } %><% if (!selected.evidence.length) { %><p>No evidence has been saved.</p><% } %></div></div>
    <% if (selected.exceptions.length) { %><div class="warehouse-live-task-form"><h3>Delivery Exceptions</h3><% for (const item of selected.exceptions) { %><p><strong><%= label(item.reasonCode) %></strong> · <%= label(item.status) %><br><%= item.description %><% if (item.resolutionNote) { %><br><%= item.resolutionNote %><% } %></p><% } %></div><% } %>
    <div class="warehouse-live-task-form"><h3>Custody History</h3><ol><% for (const event of selected.timeline) { %><li><%= event.message %> <small><%= formatDate(event.at) %></small></li><% } %></ol></div>
  </section>
  <% } %><% } %>
  <% if (mode === 'earnings') { const earnings = flow.earnings; %>
  <section class="role-metric-grid"><article class="role-metric panel"><span class="role-metric-icon tone-1"><svg aria-hidden="true"><use href="#i-wallet"></use></svg></span><div><small>Available earnings</small><strong><%= money(earnings.availableMinor) %></strong><span>After existing payout reservations</span></div></article></section>
  <section class="panel role-form-section warehouse-live-section"><div class="role-panel-head"><div><h2>Payout Destinations</h2><p>Finance independently verifies every destination before a payout can be requested.</p></div></div><% for (const account of earnings.accounts) { %><p><strong><%= account.label %></strong> · <%= label(account.method) %> · <span class="role-status <%= statusTone(account.status) %>"><%= label(account.status) %></span></p><% } %>
  <form class="role-form-grid" method="post" action="/delivery/earnings/accounts"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Method<select name="method"><option value="mobile_money">Mobile money</option><option value="bank">Bank account</option></select></label><label>Destination label<input name="label" minlength="2" maxlength="100" required></label><label>Beneficiary name<input name="beneficiaryName" minlength="2" maxlength="120" required></label><label>Bank or mobile network<input name="institution" minlength="2" maxlength="40" required></label><label>Account number or international phone<input name="account" minlength="4" maxlength="80" required autocomplete="off"></label><div class="wide warehouse-live-actions"><button class="outline-button" type="submit">Submit Payout Destination</button></div></form></section>
  <section class="panel role-form-section warehouse-live-section"><div class="role-panel-head"><div><h2>Request Payout</h2><p>A request reserves available earned money until Finance completes or rejects it.</p></div></div><form class="role-form-grid" method="post" action="/delivery/earnings/payouts"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="delivery-payout:<%= flow.actionKey %>"><label>Verified destination<select name="payoutAccountId" required><option value="">Choose a verified destination</option><% for (const account of earnings.accounts.filter(row => row.status === 'verified')) { %><option value="<%= account.publicId %>"><%= account.label %></option><% } %></select></label><label>Amount (minor units)<input name="amountMinor" type="number" min="1" max="<%= earnings.availableMinor %>" step="1" required></label><div class="wide warehouse-live-actions"><button class="primary-button" type="submit" <%= !earnings.accounts.some(row => row.status === 'verified') || earnings.availableMinor < 1 ? 'disabled' : '' %>>Request Payout</button></div></form></section>
  <section class="panel role-table-panel warehouse-live-section"><div class="role-panel-head"><div><h2>Payout History</h2></div></div><div class="role-table-wrap"><table class="role-table"><caption class="sr-only">Requested delivery payouts</caption><thead><tr><th>Reference</th><th>Amount</th><th>Status</th><th>Requested</th></tr></thead><tbody><% for (const payout of earnings.payouts) { %><tr><td data-label="Reference"><%= payout.publicId %></td><td data-label="Amount"><%= money(payout.amountMinor) %></td><td data-label="Status"><span class="role-status <%= statusTone(payout.status) %>"><%= label(payout.status) %></span></td><td data-label="Requested"><%= formatDate(payout.requestedAt) %></td></tr><% } %><% if (!earnings.payouts.length) { %><tr><td colspan="4" class="warehouse-live-empty">No payout requests yet.</td></tr><% } %></tbody></table></div></section>
  <% } %>
  <% if (flow.page.hasMore && mode !== 'overview') { %><div class="warehouse-live-actions warehouse-live-section"><a class="outline-button" href="<%= paths[mode] %>?<%= nextParams.toString() %>">Next Page</a></div><% } %>
</section>
