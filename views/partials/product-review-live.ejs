<%
  const flow = liveSeller.productReviewFlow;
  const product = flow.product;
  const statusLabel = value => String(value || '').replaceAll('_', ' ');
  const canAct = Boolean(product && product.status === 'submitted' && flow.store?.status === 'verified');
  const assigned = Boolean(product && String(product.moderation?.assignedUserId || '') === String(user._id));
  const completedFirstReview = Boolean(product && String(product.moderation?.firstApprovalByUserId || '') === String(user._id));
  const reviewerPath = product ? `/moderation/products/${encodeURIComponent(product.publicId)}` : '/moderation/products';
  const attrs = product?.attributes instanceof Map ? Object.fromEntries(product.attributes) : product?.attributes || {};
%>
<section class="app-page active role-page seller-product-page" data-page="moderator-products" data-role="moderator">
  <div class="page-heading role-page-heading"><div><span class="eyebrow">Marketplace trust</span><h1>Product Review</h1><p>Check listing details, images, pricing, and stock before making an independent decision.</p></div><a class="outline-button icon-button" href="/moderation/products"><svg aria-hidden="true"><use href="#i-box"></use></svg>Review Queue</a></div>
  <% if (flow.error) { %><div class="panel dashboard-message dashboard-message-error" role="alert"><%= flow.error %></div><% } %>
  <% if (!product) { %>
    <section class="panel role-table-panel"><div class="role-panel-head"><div><h2>Awaiting product review</h2><p><%= (flow.items || []).length %> products on this page</p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Product</th><th>Store</th><th>Country</th><th>Risk</th><th>Submitted</th><th>Action</th></tr></thead><tbody>
      <% for (const item of flow.items || []) { %><tr><td data-label="Product"><%= item.title %></td><td data-label="Store"><%= item.store?.name || item.storeName %></td><td data-label="Country"><%= item.store?.country || (item.countries || []).join(', ') %></td><td data-label="Risk"><span class="role-status <%= item.moderation?.secondReviewRequired ? 'warn' : 'neutral' %>"><%= item.moderation?.secondReviewRequired ? 'Two reviews required' : 'Standard review' %></span></td><td data-label="Submitted"><%= formatDate(item.moderation?.submittedAt) %></td><td data-label="Action"><a class="outline-button" href="/moderation/products/<%= encodeURIComponent(item.publicId) %>">Review Product</a></td></tr><% } %>
      <% if (!(flow.items || []).length) { %><tr><td colspan="6">No products are awaiting review in your assigned countries.</td></tr><% } %>
    </tbody></table></div><% if (flow.page?.hasMore) { %><div class="role-table-footer"><a class="outline-button" href="/moderation/products?after=<%= encodeURIComponent(flow.page.next) %>">Next Page</a></div><% } %></section>
  <% } else { %>
    <div class="role-editor"><div class="role-editor-main">
      <section class="panel role-form-section"><div class="role-panel-head compact"><div><h2><%= product.title %></h2><p class="form-intro"><%= flow.store.name %> · <%= (product.countries || []).join(', ') %> · <%= statusLabel(product.status) %></p></div></div>
        <div class="role-form-grid"><label>Category<input readonly value="<%= flow.category?.name || 'Category unavailable' %>"></label><label>Brand<input readonly value="<%= flow.brand?.name || 'No brand' %>"></label><label class="wide">Product description<textarea readonly rows="6"><%= product.description %></textarea></label><label class="wide">Tags<input readonly value="<%= (product.tags || []).join(', ') %>"></label><% if (product.videoUrl) { %><label class="wide">Product video URL<input readonly value="<%= product.videoUrl %>"></label><% } %><% for (const attribute of flow.category?.attributes || []) { %><label><%= attribute.label %><%= attribute.required ? ' · required' : '' %><input readonly value="<%= attrs[attribute.key] ?? '' %>"></label><% } %></div>
        <% if (product.moderation?.reason) { %><p class="form-intro"><strong>Previous decision reason:</strong> <%= product.moderation.reason %></p><% } %>
      </section>
      <section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Variants and pricing</h2><p>Check the selling price, SKU, weight, and variant options.</p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Variant</th><th>SKU</th><th>Price</th><th>Compare-at</th><th>Weight</th><th>Status</th></tr></thead><tbody><% for (const variant of flow.variants || []) { %><tr><td data-label="Variant"><%= variant.title %></td><td data-label="SKU"><%= variant.sku %></td><td data-label="Price"><%= formatMoney(variant.priceMinor,variant.currency) %></td><td data-label="Compare-at"><%= variant.compareAtMinor == null ? 'Not set' : formatMoney(variant.compareAtMinor,variant.currency) %></td><td data-label="Weight"><%= variant.weightGrams %> g</td><td data-label="Status"><%= variant.active ? 'Active' : 'Inactive' %></td></tr><% } %><% if (!(flow.variants || []).length) { %><tr><td colspan="6">This product has no variants.</td></tr><% } %></tbody></table></div><% for (const variant of flow.variants || []) { const options = variant.options instanceof Map ? Object.fromEntries(variant.options) : variant.options || {}; %><article class="role-security-row"><div><strong><%= variant.sku %></strong><small><%= variant.barcode ? `Barcode: ${variant.barcode}` : 'No barcode' %><% if (Object.keys(options).length) { %> · <%= Object.entries(options).map(([key,value]) => `${key}: ${value}`).join(' · ') %><% } %></small></div></article><% } %></section>
      <section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Product images</h2><p>Confirm that every image accurately represents the listing.</p></div></div><div class="role-form-grid seller-product-media-grid"><% for (const image of flow.media || []) { %><article class="seller-product-media-card"><a href="/media/catalogue/<%= encodeURIComponent(image.publicId) %>" target="_blank" rel="noopener noreferrer"><img class="seller-product-image" src="/media/catalogue/<%= encodeURIComponent(image.publicId) %>" alt="<%= image.altText || product.title %>" loading="lazy" decoding="async"></a><p class="form-intro"><%= image.altText || 'No image description' %> · Order <%= image.position %> · <%= statusLabel(image.status) %></p></article><% } %><% if (!(flow.media || []).length) { %><p class="form-intro">This product has no images.</p><% } %></div></section>
      <% if (flow.stocks) { %><section class="panel role-form-section"><div class="role-panel-head compact"><div><h2>Stock and fulfilment</h2><p>Available quantities exclude reserved, damaged, and quarantined stock. This review shows up to 200 stock records.</p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Variant</th><th>Warehouse</th><th>On hand</th><th>Reserved</th><th>Available</th></tr></thead><tbody><% for (const stock of flow.stocks) { %><tr><td data-label="Variant"><%= stock.variant?.sku || (flow.variants || []).find(item => String(item._id) === String(stock.variantId))?.sku || 'Variant unavailable' %></td><td data-label="Warehouse"><%= stock.warehouse?.name || (flow.warehouses || []).find(item => String(item._id) === String(stock.warehouseId))?.name || 'Warehouse unavailable' %></td><td data-label="On hand"><%= stock.onHand %></td><td data-label="Reserved"><%= stock.reserved %></td><td data-label="Available"><%= Number(stock.onHand || 0) - Number(stock.reserved || 0) - Number(stock.damaged || 0) - Number(stock.quarantined || 0) %></td></tr><% } %><% if (!flow.stocks.length) { %><tr><td colspan="5">No warehouse stock is recorded.</td></tr><% } %></tbody></table></div><% if (flow.stockHasMore) { %><p class="form-intro">Additional stock records exist. The first 200 records are shown here.</p><% } %></section><% } %>
      <section class="panel role-form-section"><h2>Review history</h2><% for (const entry of product.moderation?.reviewHistory || []) { %><p><strong><%= statusLabel(entry.action) %></strong> · <%= formatDate(entry.at) %><% if (entry.reason) { %> · <%= entry.reason %><% } %></p><% } %><% if (!(product.moderation?.reviewHistory || []).length) { %><p class="form-intro">No review activity yet.</p><% } %></section>
    </div><aside class="role-editor-side"><section class="panel role-publish-card"><span class="eyebrow">Independent review</span><h2>Case assignment</h2><p class="form-intro"><%= assigned ? 'Assigned to you' : product.moderation?.assignedUserId ? 'Assigned to another reviewer' : 'Unassigned' %></p>
      <% if (product.moderation?.secondReviewRequired) { %><p class="form-intro"><%= product.moderation.firstApprovalByUserId ? 'First approval recorded. A different reviewer must complete the second decision.' : 'This category requires two approvals by different reviewers.' %></p><% } %>
      <% if (completedFirstReview && canAct) { %><p class="form-intro">You recorded the first approval. Another reviewer must claim this product for its second review.</p><% } %>
      <% if (canAct) { %><form method="post" action="<%= reviewerPath %>/<%= assigned ? 'release' : 'claim' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= product.__v %>"><button class="outline-button full-button" type="submit" <%= !assigned && (product.moderation?.assignedUserId || completedFirstReview) ? 'disabled' : '' %>><%= assigned ? 'Release Product' : 'Claim Product' %></button></form><% } %>
    </section>
    <% if (canAct && assigned) { %><form class="panel role-publish-card" method="post" action="<%= reviewerPath %>/decision"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= product.__v %>"><span class="eyebrow">Decision</span><h2>Review outcome</h2><p class="form-intro">Request changes or reject with a clear reason of at least 10 characters. Approval keeps the listing private until the seller publishes it.</p><div class="role-form-grid"><label class="wide">Decision reason<textarea name="reason" rows="5" maxlength="1000"><%= flow.draft?.reason || '' %></textarea></label></div><div class="seller-product-lifecycle seller-product-action-form"><button class="primary-button full-button" type="submit" name="decision" value="approve"><%= product.moderation?.secondReviewRequired && !product.moderation?.firstApprovalByUserId ? 'Record First Approval' : 'Approve Product' %></button><button class="outline-button full-button" type="submit" name="decision" value="changes">Request Changes</button><button class="outline-button full-button" type="submit" name="decision" value="reject">Reject Product</button></div></form><% } %>
    </aside></div>
  <% } %>
</section>
