<%
const overview = moderationFlow;
const metrics = overview.metrics || [];
const trend = overview.trend || [];
const priorities = overview.priorities || [];
const activity = overview.activity || [];
const coverage = overview.coverage || {};
const score = overview.score || overview.verification || overview.health || {};
const countries = overview.context?.countries || overview.countries || [];
const selectedCountry = overview.country ?? overview.context?.country ?? overview.filters?.params?.country ?? '';
const filterParams = Object.entries({ ...(overview.filters?.params || {}), country: selectedCountry, ...(overview.period ? { period: overview.period } : {}) }).filter(([key, value]) => /^[a-zA-Z][a-zA-Z0-9_-]{0,30}$/.test(key) && !['after', 'before', 'cursor', 'record', 'selected'].includes(key) && typeof value === 'string' && value.length <= 200);
const localHref = value => typeof value === 'string' && (/^\/(?!\/)/.test(value) || /^#[a-zA-Z0-9_-]+$/.test(value)) && !/[\\\u0000-\u001f\u007f]/.test(value) ? value : null;
const chartValue = bucket => Number.isFinite(Number(bucket.value)) ? Number(bucket.value) : 0;
const chartMaximum = Math.max(1, ...trend.map(bucket => Math.abs(chartValue(bucket))));
const member = String(user?.name || 'Member').trim().split(/\s+/)[0];
const timeZone = overview.timeZone || overview.context?.market?.timeZone || 'UTC';
const eventDate = value => { const date = new Date(value); if (!value || !Number.isFinite(date.getTime())) return ''; try { return new Intl.DateTimeFormat(user?.locale || 'en-UG', { timeZone, dateStyle: 'medium', timeStyle: 'short' }).format(date); } catch { return new Intl.DateTimeFormat('en', { timeZone: 'UTC', dateStyle: 'medium', timeStyle: 'short' }).format(date); } };
const priorityHref = localHref(overview.priorityHref) || localHref(priorities.find(item => localHref(item.href))?.href);
const createHref = localHref(overview.create?.href);
const exportHref = localHref(overview.exportHref);
%>
<section class="app-page role-page active moderation-overview-live moderation-fidelity-page" data-page="<%= moderationPage.id %>" data-role="moderator" data-page-kind="overview">
  <div class="page-heading role-page-heading"><div><span class="eyebrow"><%= moderationPage.eyebrow %></span><h1><%= moderationPage.title %></h1><p><%= moderationPage.description %></p></div><div class="moderation-heading-actions"><% if (countries.length) { %><form class="moderation-country-filter" method="get" action="<%= moderationPage.href %>"><% for (const [key, value] of filterParams.filter(([key]) => key !== 'country')) { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% } %><label class="sr-only" for="moderationOverviewCountry">Country scope</label><select id="moderationOverviewCountry" name="country"><option value="" <%= selectedCountry === '' ? 'selected' : '' %>>All assigned countries</option><% for (const country of countries) { %><option value="<%= country.code %>" <%= selectedCountry === country.code ? 'selected' : '' %>><%= country.name || country.code %></option><% } %></select><button class="plain-link" type="submit">Apply</button></form><% } %><% if (createHref) { %><a class="primary-button icon-button" href="<%= createHref %>"><svg aria-hidden="true"><use href="#i-plus"></use></svg><%= overview.create.label %></a><% } %></div></div>
  <% if (overview.error) { %><p class="server-flash error platform-flash" role="alert"><%= overview.error %></p><% } %>
  <section class="role-welcome panel"><div><span class="eyebrow">Moderation workspace</span><h2>Good day, <%= member %>.</h2><p>Your most important marketplace numbers and actions are ready.</p><div><% if (priorityHref) { %><a class="primary-button" href="<%= priorityHref %>"><%= overview.priorityLabel || 'Open priority queue' %></a><% } %><% if (exportHref) { %><a class="outline-button" href="<%= exportHref %>">Download summary</a><% } %></div></div><div class="role-welcome-score"><small><%= score.label || 'Workspace score' %></small><strong><%= score.value ?? '—' %></strong><span><%= score.detail || '' %></span></div></section>
  <section class="role-metric-grid"><% for (const [index, metric] of metrics.entries()) { %><article class="role-metric panel"><span class="role-metric-icon tone-<%= index % 4 + 1 %>"><svg aria-hidden="true"><use href="#<%= ['i-eye','i-clipboard','i-wallet','i-award'][index % 4] %>"></use></svg></span><div><small><%= metric.label %></small><strong title="<%= metric.value ?? '—' %>"><%= metric.value ?? '—' %></strong><span><%= metric.detail || metric.note || '' %></span></div></article><% } %></section>
  <div class="role-overview-grid">
    <section class="panel role-chart-panel"><div class="role-panel-head"><div><h2>Performance trend</h2><p><%= overview.trendDescription || 'Recorded moderation results for this reporting period.' %></p></div><% if (overview.periodOptions?.length) { %><form method="get" action="<%= moderationPage.href %>" class="moderation-period-filter"><% for (const [key, value] of filterParams.filter(([key]) => key !== 'period')) { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% } %><label class="sr-only" for="moderationOverviewPeriod">Chart period</label><select id="moderationOverviewPeriod" name="period"><% for (const option of overview.periodOptions) { %><option value="<%= option.value %>" <%= option.value === overview.period ? 'selected' : '' %>><%= option.label %></option><% } %></select><button class="plain-link" type="submit">Apply</button></form><% } %></div>
      <% if (trend.length) { %><div class="role-chart" role="img" aria-label="<%= (overview.trendLabel || 'Moderation performance') + '. ' + trend.map(bucket => `${bucket.label}: ${bucket.display ?? chartValue(bucket)}`).join('; ') %>"><% for (const bucket of trend) { const value = chartValue(bucket); %><div><span style="height:<%= Math.abs(value) / chartMaximum * 80 %>%" data-zero="<%= value === 0 %>" data-negative="<%= value < 0 %>" title="<%= `${bucket.label}: ${bucket.display ?? value}` %>"><b><%= bucket.display ?? value %></b></span><small><%= bucket.label %></small></div><% } %></div><% } else { %><div class="role-chart moderation-empty-chart"><p class="form-intro"><%= overview.trendEmptyText || 'No recorded performance in this period.' %></p></div><% } %>
      <div class="role-chart-legend"><span><i></i><%= overview.trendLabel || 'Recorded performance' %></span><% if (overview.trendSummary) { %><strong><%= overview.trendSummary %></strong><% } %></div>
    </section>
    <section class="panel role-focus-panel"><div class="role-panel-head compact"><div><span class="eyebrow">Today</span><h2>Priority actions</h2></div><strong><%= priorities.length %></strong></div><div class="role-focus-list"><% for (const [index, item] of priorities.entries()) { %><% if (localHref(item.href)) { %><a href="<%= localHref(item.href) %>"><span><%= index + 1 %></span><p><%= item.text %></p><svg aria-hidden="true"><use href="#i-chevron-right"></use></svg></a><% } else { %><div class="moderation-priority-note"><span><%= index + 1 %></span><p><%= item.text %></p></div><% } %><% } %><% if (!priorities.length) { %><p class="form-intro">No priority actions need attention.</p><% } %></div></section>
  </div>
  <div class="role-bottom-grid">
    <section class="panel role-activity-feed"><div class="role-panel-head"><div><h2>Marketplace activity</h2><p>Important changes in your workspace.</p></div><% if (localHref(overview.activityHref)) { %><a class="plain-link" href="<%= localHref(overview.activityHref) %>"><%= overview.activityLabel || 'View all' %></a><% } %></div><% for (const [index, item] of activity.entries()) { const date = eventDate(item.at); %><article><span class="tone-<%= index % 4 + 1 %>"><svg aria-hidden="true"><use href="#<%= /^i-[a-z0-9-]+$/.test(item.icon || '') ? item.icon : ['i-award','i-wallet','i-bell'][index % 3] %>"></use></svg></span><div><strong><% if (localHref(item.href)) { %><a href="<%= localHref(item.href) %>"><%= item.text %></a><% } else { %><%= item.text %><% } %></strong><% if (date) { %><small><time datetime="<%= new Date(item.at).toISOString() %>"><%= date %></time></small><% } %></div></article><% } %><% if (!activity.length) { %><p class="form-intro">No moderation activity recorded yet.</p><% } %></section>
    <section class="panel role-team-panel"><div class="role-panel-head"><div><h2><%= coverage.title || 'Team coverage' %></h2><p><%= coverage.description || 'Recorded participation in this workspace.' %></p></div><% if (coverage.status) { %><span class="role-live"><i></i><%= coverage.status %></span><% } %></div><div class="role-avatar-stack"><% for (const person of coverage.people || []) { const name = String(person.name || 'Member'); %><span title="<%= name %>"><%= name.split(/\s+/).filter(Boolean).slice(0, 2).map(part => part[0]).join('').toUpperCase() %></span><% } %><% if (Number.isFinite(coverage.total) && coverage.total > (coverage.people || []).length) { %><b>+<%= coverage.total - (coverage.people || []).length %></b><% } %></div><div class="role-team-stats"><% for (const stat of coverage.stats || []) { %><div><small><%= stat.label %></small><strong><%= stat.value ?? '—' %></strong></div><% } %></div><% if (coverage.note) { %><p class="form-intro"><%= coverage.note %></p><% } %><% if (localHref(coverage.href)) { %><a class="soft-button full-button" href="<%= localHref(coverage.href) %>"><%= coverage.label || 'Open workspace' %></a><% } %></section>
  </div>
</section>
