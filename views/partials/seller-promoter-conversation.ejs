<% const promoterConversation = pageFlow.selected; const promoterConversationDraft = pageFlow.draft || {}; %>
<div class="seller-verification-actions"><a class="outline-button" href="/seller/messages">Customer Conversations</a><a class="outline-button" href="/seller/messages?tab=questions">Product Questions</a><a class="outline-button" href="/seller/promoter-messages" aria-current="page">Promoter Conversations</a></div>
<p class="form-intro">Campaign conversations are shared between the verified store owner and an approved promoter.</p>
<% if (promoterConversation) { const promoterConversationPath = '/seller/promoter-messages/' + encodeURIComponent(promoterConversation.publicId); %>
  <section class="panel form-panel" aria-label="Selected promoter conversation"><div class="role-panel-head"><div><h2><%= promoterConversation.subject %></h2><p><%= promoterConversation.publicId %> · <%= promoterConversation.counterpart %> · <%= promoterConversation.status %></p></div></div><p>Campaign: <%= promoterConversation.campaignName %></p>
    <% for (const message of promoterConversation.messages || []) { %><p><strong><%= message.sender %>:</strong> <%= message.body %><br><small><%= message.read ? 'Read' : 'Sent' %></small></p><% } %>
    <% if (promoterConversation.status === 'open') { %><form method="post" action="<%= promoterConversationPath %>/reply"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= promoterConversation.version %>"><div class="role-form-grid"><label class="wide">Your reply<textarea name="message" rows="4" minlength="2" maxlength="4000" required><%= promoterConversationDraft.message || '' %></textarea></label></div><button class="primary-button" type="submit">Send Reply</button></form>
      <div class="seller-verification-actions"><form method="post" action="<%= promoterConversationPath %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= promoterConversation.version %>"><button class="outline-button" type="submit">Mark Read</button></form><form method="post" action="<%= promoterConversationPath %>/resolve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= promoterConversation.version %>"><button class="outline-button" type="submit">Resolve Conversation</button></form></div>
    <% } %>
  </section>
<% } %>
