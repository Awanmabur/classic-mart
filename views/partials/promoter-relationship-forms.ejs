<%
const relationshipFlow = typeof pageFlow !== 'undefined' ? pageFlow : promoterFlow;
const relationshipSelected = relationshipFlow.selected;
const relationshipDraft = relationshipFlow.draft || {};
const relationshipKind = relationshipFlow.relationshipKind;
%>
<% if (relationshipKind === 'referrals') { %>
  <section class="panel form-panel" id="referral-invite" aria-label="Referral invitation"><div class="role-panel-head"><div><h2>Your referral invitation</h2><p>Invite people in your market. Rewards qualify through their first paid purchase.</p></div></div>
    <% if (relationshipFlow.invite) { %><div class="role-form-grid"><label>Reusable referral code<input value="<%= relationshipFlow.invite.code %>" readonly></label><label>Signup link<input value="<%= relationshipFlow.invite.signupHref %>" readonly></label></div><a class="outline-button" href="<%= relationshipFlow.invite.signupHref %>">Open Referral Signup</a>
    <% } else if (relationshipFlow.editable) { %><form method="post" action="/promoter/referrals/generate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="primary-button" type="submit">Generate Referral Code</button></form>
    <% } else { %><p>Complete promoter verification to generate your referral invitation.</p><% } %><p class="form-intro">A signup records a pending referral. Qualification awards loyalty points under the marketplace policy.</p>
  </section>
  <% if (relationshipSelected) { %><section class="panel form-panel" aria-label="Selected referral"><div class="role-panel-head"><div><h2>Referral <%= relationshipSelected.publicId %></h2><p><%= relationshipSelected.status.replaceAll('_', ' ') %></p></div></div><p>Recorded reward: <strong><%= relationshipSelected.referrerRewardPoints %> loyalty points</strong></p><% if (relationshipSelected.qualifiedOrderPublicId) { %><p>Qualification reference: <%= relationshipSelected.qualifiedOrderPublicId %></p><% } %></section><% } %>
<% } else if (relationshipKind === 'brands' && relationshipSelected) { %>
  <section class="panel form-panel" aria-label="Selected seller relationship"><div class="role-panel-head"><div><h2><%= relationshipSelected.name %></h2><p><%= relationshipSelected.publicId %> · <%= relationshipSelected.status %></p></div></div><p><%= relationshipSelected.description %></p>
    <div class="seller-verification-actions"><a class="outline-button" href="<%= relationshipSelected.storeHref %>">View Seller Profile</a><a class="outline-button" href="<%= relationshipSelected.marketplaceHref %>">View Campaigns</a></div>
    <% if (relationshipFlow.editable) { %><form method="post" action="/promoter/brands/<%= encodeURIComponent(relationshipSelected.publicId) %>/<%= relationshipSelected.status === 'followed' ? 'unfollow' : 'follow' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= relationshipSelected.version %>"><button class="primary-button" type="submit"><%= relationshipSelected.status === 'followed' ? 'Unfollow Seller' : 'Follow Seller' %></button></form><% } %>
    <h3>Current campaigns</h3><% for (const campaign of relationshipSelected.campaigns || []) { %><p><a class="plain-link" href="<%= campaign.href %>"><%= campaign.name %></a> · <%= campaign.applicationStatus.replaceAll('_', ' ') %></p><% } %>
  </section>
<% } else if (relationshipKind === 'messages') { %>
  <div class="seller-verification-actions"><a class="outline-button" href="/promoter/messages?tab=customers" <%= relationshipFlow.tab === 'customers' ? 'aria-current=page' : '' %>>Customer Requests</a><a class="outline-button" href="/promoter/messages?tab=campaigns" <%= relationshipFlow.tab === 'campaigns' ? 'aria-current=page' : '' %>>Campaign Conversations</a></div>
  <% if (relationshipSelected) { const threadPath = '/promoter/messages/' + relationshipFlow.tab + '/' + encodeURIComponent(relationshipSelected.publicId); const threadOpen = !['resolved','closed','archived'].includes(relationshipSelected.status); %>
    <section class="panel form-panel" aria-label="Selected conversation"><div class="role-panel-head"><div><h2><%= relationshipSelected.subject %></h2><p><%= relationshipSelected.publicId %> · <%= relationshipSelected.counterpart %> · <%= relationshipSelected.status %></p></div></div>
      <% if (relationshipFlow.tab === 'customers') { %><p><strong>Customer:</strong> <%= relationshipSelected.message %></p><% for (const reply of relationshipSelected.replies || []) { %><p><strong><%= reply.sender === 'promoter' ? 'You' : 'Customer' %>:</strong> <%= reply.body %></p><% } %>
      <% } else { %><p>Campaign: <%= relationshipSelected.campaignName %></p><% for (const message of relationshipSelected.messages || []) { %><p><strong><%= message.sender %>:</strong> <%= message.body %><br><small><%= message.read ? 'Read' : 'Sent' %></small></p><% } %><% } %>
      <% if (relationshipFlow.editable && threadOpen) { %><form method="post" action="<%= threadPath %>/reply"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= relationshipSelected.version %>"><div class="role-form-grid"><label class="wide">Your reply<textarea name="message" rows="4" minlength="2" maxlength="<%= relationshipFlow.tab === 'campaigns' ? 4000 : 2000 %>" required><%= relationshipDraft.message || '' %></textarea></label></div><button class="primary-button" type="submit">Send Reply</button></form>
        <div class="seller-verification-actions"><form method="post" action="<%= threadPath %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= relationshipSelected.version %>"><button class="outline-button" type="submit">Mark Read</button></form><form method="post" action="<%= threadPath %>/resolve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= relationshipSelected.version %>"><button class="outline-button" type="submit">Resolve Conversation</button></form></div>
      <% } %>
    </section>
  <% } %>
  <section class="panel form-panel" id="campaign-message" aria-label="New campaign conversation"><div class="role-panel-head"><div><h2>Contact a campaign seller</h2><p>Available after a verified seller approves your campaign application.</p></div></div>
    <% if (relationshipFlow.editable && relationshipFlow.campaignChoices?.length) { %><form method="post" action="/promoter/messages/campaigns/create"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="role-form-grid"><label class="wide">Approved campaign<select name="campaignId" required><% for (const campaign of relationshipFlow.campaignChoices) { %><option value="<%= campaign.publicId %>" <%= relationshipDraft.campaignId === campaign.publicId ? 'selected' : '' %>><%= campaign.storeName %> · <%= campaign.name %></option><% } %></select></label><label class="wide">Subject<input name="subject" minlength="2" maxlength="180" required value="<%= relationshipDraft.subject || '' %>"></label><label class="wide">Message<textarea name="message" rows="4" minlength="2" maxlength="4000" required><%= relationshipDraft.message || '' %></textarea></label></div><button class="primary-button" type="submit">Start Conversation</button></form>
    <% } else { %><p>No approved active seller campaigns are available for messaging.</p><a class="plain-link" href="/promoter/marketplace">Browse Campaigns</a><% } %>
  </section>
<% } %>
