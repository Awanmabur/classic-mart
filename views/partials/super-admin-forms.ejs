<%
const flow=superAdminFlow, selected=flow.selected, filters=flow.filters||{}, pageId=superAdminPage.id;
const human=value=>String(value??'').replace(/([a-z])([A-Z])/g,'$1 $2').replaceAll('_',' ').replace(/^./,letter=>letter.toUpperCase());
const format=(value,key='')=>Array.isArray(value)?value.map(item=>format(item,key)).join('; '):value&&typeof value==='object'?Object.entries(value).map(([field,val])=>human(field)+': '+format(val,field)).join(' · '):String(typeof dashboardDisplay==='function'?dashboardDisplay(value,{column:/user|actor|requester|owner|member/i.test(key)?'Account':''}):value??'—');
const dates=value=>value?new Date(value).toISOString():'—';
const numeric=(name,label,min,max,value)=>({name,label,min,max,value});
const person=['super-users','super-admins','super-customers'].includes(pageId)&&selected;
%>
<% if(selected&&((pageId==='super-roles'&&filters.tab==='approvals')||(pageId==='super-settings'&&filters.tab==='approvals'))){ %>
<section class="panel form-panel"><h2>Independent change review</h2><p class="form-intro"><%= selected.reason %></p><p class="form-intro">Requested by <%= selected.requester?.name||'Account holder' %>.</p><% if(selected.sourceHref){ %><a class="plain-link" href="<%= selected.sourceHref %>">Open current source record</a><% } %><div class="role-health-rows"><% for(const[key,value]of Object.entries(selected.payload||{})){if(['sourceVersion','sourceDigest','tokenVersion','targetTokenVersion','termsDigest','digest','acceptedByUserId'].includes(key))continue; %><div><span><%= human(key) %></span><b><%= format(value) %></b></div><% } %><% for(const[key,value]of Object.entries(selected.planTerms||{})){if(key==='_id')continue; %><div><span>Plan <%= human(key) %></span><b><%= format(value) %></b></div><% } %></div><% if(selected.decisionReason){ %><p class="form-intro">Decision: <%= selected.decisionReason %></p><% } %>
<% if(selected.status==='requested'){ %><form method="post" action="/super/approvals/<%= selected.publicId %>/decision"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selected.version %>"><div class="role-form-grid"><label>Decision<select name="decision"><option value="approve">Approve and apply reviewed change</option><option value="reject">Reject change</option></select></label><label>Review reason<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label></div><p class="form-intro">The requester and source author cannot approve their own changes. Changed authority or source terms stop the decision.</p><button type="submit" class="primary-button">Record independent decision</button></form><% } %></section>
<% } %>
<% if(person&&selected.role!=='super_admin'){ %>
<% if(!selected.platformAccessManagedAt&&selected.role==='customer'){ %><section class="panel form-panel"><h2>Personal account state review</h2><form method="post" action="/super/customers/<%= selected.publicId %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selected.version %>"><div class="role-form-grid"><label>Requested state<select name="status"><option value="suspended">Suspend</option><option value="active">Restore active account</option></select></label><label>Reason<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label></div><p class="form-intro">Dedicated staff and merchant identities use their own review workflows. Another Super Admin decides eligible personal account changes.</p><button type="submit" class="primary-button">Request account review</button></form></section><% } %>
<section class="panel form-panel"><h2>Staff assignment review</h2><p class="form-intro">Activate a dedicated verified staff identity, or request suspension or revocation of its current assignment.</p><form method="post" action="/super/roles/requests"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="targetUserPublicId" value="<%= selected.publicId %>"><input type="hidden" name="version" value="<%= selected.version %>"><div class="role-form-grid"><label>Requested change<select name="action"><option value="grant">Grant / replace assignment</option><option value="suspend">Suspend current assignment</option><option value="revoke">Revoke current assignment</option></select></label><label>Staff role<select name="role"><% for(const role of ['warehouse','support','moderator','finance','country_admin']){ %><option value="<%= role %>" <%= selected.role===role?'selected':'' %>><%= human(role) %></option><% } %></select></label><label>Operational market codes<input name="operationalCountries" maxlength="100" placeholder="UG, KE"></label><label>Warehouse references<input name="warehouseScopes" maxlength="1000" placeholder="Required for warehouse staff"></label><label>Grant duration in days<input name="grantDurationDays" type="number" min="1" max="365" value="180" required></label><label>Reason<textarea name="reason" minlength="10" maxlength="1000" required></textarea></label></div><button type="submit" class="primary-button">Request staff access review</button></form></section>
<% } %>
<% if(pageId==='super-roles'&&filters.tab==='invitations'){ %>
<% if(selected?.status==='pending'){ %><section class="panel form-panel"><h2>Pending invitation</h2><form method="post" action="/super/roles/invitations/<%= selected.publicId %>/revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selected.version %>"><button type="submit" class="outline-button">Revoke pending invitation</button></form></section><% } %>
<section class="panel form-panel"><h2>Invite a dedicated staff account</h2><p class="form-intro">The recipient must verify their identity, enroll an authenticator and accept. Access starts after another administrator approves the assignment.</p><form method="post" action="/super/roles/invitations"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="role-form-grid"><label>Staff email<input name="email" type="email" maxlength="254" required autocomplete="off"></label><label>Role<select name="role"><% for(const role of ['warehouse','support','moderator','finance','country_admin']){ %><option value="<%= role %>"><%= human(role) %></option><% } %></select></label><label>Operational market codes<input name="operationalCountries" placeholder="UG, KE" maxlength="100" required></label><label>Warehouse references<input name="warehouseScopes" maxlength="1000" placeholder="Required for warehouse staff"></label><label>Grant duration in days<input name="grantDurationDays" type="number" min="1" max="365" value="180" required></label><label>Reason<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label></div><button class="primary-button" type="submit">Record staff invitation</button></form></section>
<% } %>
<% if(pageId==='super-settings'&&filters.tab==='countries'&&selected){ const market=selected; %>
<section class="panel form-panel"><h2>Market policy · <%= market.name %></h2><p class="form-intro">The current policy remains in force until an independent administrator approves this complete proposal. Amounts use <%= market.currency %> minor units; 100 basis points equal 1%.</p><form method="post" action="/super/settings/countries/<%= market.code %>/market"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= market.version %>"><input type="hidden" name="sourceDigest" value="<%= market.sourceDigest %>"><div class="role-form-grid"><label>Policy version<input name="policyVersion" maxlength="40" value="<%= market.policyVersion %>" required></label><% for(const field of [numeric('taxBps','Tax in basis points',0,10000,market.taxBps),numeric('platformFeeBps','Platform fee in basis points',0,5000,market.platformFeeBps),numeric('freeStandardShippingThresholdMinor','Free standard shipping threshold',0,10000000000,market.freeStandardShippingThresholdMinor),numeric('returnWindowDays','Return window in days',0,365,market.returnWindowDays),numeric('defaultStandardSlaHours','Standard delivery SLA hours',1,720,market.delivery?.defaultStandardSlaHours),numeric('defaultExpressSlaHours','Express delivery SLA hours',1,720,market.delivery?.defaultExpressSlaHours),numeric('loyaltyPointsPer1000Minor','Points per 1000 minor units',0,10000,market.growth?.loyaltyPointsPer1000Minor),numeric('referralRewardPoints','Referral points',0,1000000,market.growth?.referralRewardPoints),numeric('promoterCommissionBps','Promoter commission in basis points',0,5000,market.growth?.promoterCommissionBps)]){ %><label><%= field.label %><input type="number" name="<%= field.name %>" min="<%= field.min %>" max="<%= field.max %>" step="1" required value="<%= field.value %>"></label><% } %></div><div class="role-toggle-list"><% for(const[field,label,value]of [['active','Market active',market.active],...['card','mobile','cod'].map(key=>[key,human(key)+' payments',market.payments?.[key]]),...['standardEnabled','expressEnabled','pickupEnabled','requirePhotoForCod','requireSignatureForDelivery','requirePhotoForFailedAttempt'].map(key=>[key,human(key),market.delivery?.[key]]),...['loyaltyEnabled','referralEnabled','giftCardsEnabled'].map(key=>[key,human(key),market.growth?.[key]])]){ %><label><div><strong><%= label %></strong></div><span class="switch"><input type="checkbox" name="<%= field %>" value="on" <%= value?'checked':'' %>><span></span></span></label><% } %></div><label>Review reason<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label><button type="submit" class="primary-button">Request market policy approval</button></form></section>
<% for(const reward of [...(market.growth?.rewardCatalogue||[]),null]){ const entry=reward||{}; %><section class="panel form-panel"><h2><%= reward?'Reward: '+reward.label:'Author a reward' %></h2><form method="post" action="/super/settings/countries/<%= market.code %>/reward"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= market.version %>"><input type="hidden" name="sourceDigest" value="<%= market.sourceDigest %>"><div class="role-form-grid"><label>Reward key<input name="key" pattern="[a-z0-9][a-z0-9_-]{0,79}" value="<%= entry.key||'' %>" maxlength="80" <%= reward?'readonly':'' %> required></label><label>Label<input name="label" maxlength="120" value="<%= entry.label||'' %>" required></label><label>Benefit kind<select name="kind"><% for(const kind of ['voucher','shipping','gold_trial']){ %><option value="<%= kind %>" <%= entry.kind===kind?'selected':'' %>><%= human(kind) %></option><% } %></select></label><% for(const field of [numeric('pointsCost','Points cost',1,1000000000,entry.pointsCost??''),numeric('validDays','Validity in days',1,365,entry.validDays??30),numeric('valueMinor','Benefit value in minor units',0,1000000000,entry.valueMinor??0),numeric('minimumSpendMinor','Minimum spend in minor units',0,1000000000,entry.minimumSpendMinor??0),numeric('maximumDiscountMinor','Maximum discount in minor units',0,1000000000,entry.maximumDiscountMinor??0),numeric('multiplierBps','Trial points multiplier in basis points',10000,50000,entry.multiplierBps??10000),numeric('trialShippingDiscountBps','Trial shipping discount in basis points',0,10000,entry.trialShippingDiscountBps??0)]){ %><label><%= field.label %><input name="<%= field.name %>" type="number" min="<%= field.min %>" max="<%= field.max %>" step="1" value="<%= field.value %>" required></label><% } %><label>Availability<select name="enabled"><option value="true" <%= entry.enabled!==false?'selected':'' %>>Enabled after approval</option><option value="false" <%= entry.enabled===false?'selected':'' %>>Disabled after approval</option></select></label><label>Review reason<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label></div><p class="form-intro">Voucher and shipping rewards require a positive benefit value or maximum discount. Existing issued benefits retain their original terms.</p><button type="submit" class="primary-button">Request reward policy approval</button></form></section><% } %>
<% for(const tier of ['classic','silver','gold']){ const benefit=(market.growth?.clubBenefits||[]).find(item=>item.tier===tier)||{}; %><section class="panel form-panel"><h2><%= human(tier) %> Club benefits</h2><form method="post" action="/super/settings/countries/<%= market.code %>/club"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= market.version %>"><input type="hidden" name="sourceDigest" value="<%= market.sourceDigest %>"><input type="hidden" name="tier" value="<%= tier %>"><div class="role-form-grid"><% for(const field of [numeric('multiplierBps','Points multiplier in basis points',10000,50000,benefit.multiplierBps??10000),numeric('standardShippingDiscountBps','Standard shipping discount in basis points',0,10000,benefit.standardShippingDiscountBps??0),numeric('minimumSpendMinor','Minimum spend in minor units',0,1000000000,benefit.minimumSpendMinor??0)]){ %><label><%= field.label %><input name="<%= field.name %>" type="number" min="<%= field.min %>" max="<%= field.max %>" step="1" value="<%= field.value %>" required></label><% } %><label>Review reason<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label></div><button type="submit" class="primary-button">Request Club policy approval</button></form></section><% } %>
<% } %>
<% if(pageId==='super-subscriptions'&&filters.tab==='plans'){ const plan=selected||{}, editable=!selected||plan.status==='draft'; %>
<% if(editable){ %><section class="panel form-panel"><h2><%= selected?'Edit seller plan draft':'Author a seller plan' %></h2><form method="post" action="/super/subscriptions/plans<%= selected?'/'+plan.publicId:'' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(selected){ %><input type="hidden" name="version" value="<%= plan.version %>"><% } %><div class="role-form-grid"><label>Plan key<input name="key" pattern="[a-z0-9][a-z0-9_-]{1,79}" maxlength="80" required value="<%= plan.key||'' %>"></label><label>Name<input name="name" maxlength="140" required value="<%= plan.name||'' %>"></label><label>Market<select name="country"><% for(const country of flow.context.countries){ %><option value="<%= country.code %>" <%= plan.country===country.code?'selected':'' %>><%= country.name %> · <%= country.currency %></option><% } %></select></label><label>Price in minor units<input name="priceMinor" type="number" min="0" max="10000000000" step="1" value="<%= plan.priceMinor??0 %>" required></label><label>Cadence<select name="cadence"><% for(const cadence of ['monthly','quarterly','yearly','one_time']){ %><option value="<%= cadence %>" <%= plan.cadence===cadence?'selected':'' %>><%= human(cadence) %></option><% } %></select></label><% for(const field of [numeric('productLimit','Product limit',0,1000000,plan.entitlements?.productLimit??''),numeric('seatLimit','Team seat limit',1,1000000,plan.entitlements?.seatLimit??''),numeric('campaignLimit','Campaign limit',0,1000000,plan.entitlements?.campaignLimit??''),numeric('analyticsDays','Analytics days',1,3660,plan.entitlements?.analyticsDays??'')]){ %><label><%= field.label %><input name="<%= field.name %>" type="number" min="<%= field.min %>" max="<%= field.max %>" step="1" required value="<%= field.value %>"></label><% } %><label>Analytics export<select name="analyticsExport"><option value="false" <%= !plan.entitlements?.analyticsExport?'selected':'' %>>Disabled</option><option value="true" <%= plan.entitlements?.analyticsExport?'selected':'' %>>Enabled</option></select></label><label>Description<textarea name="description" maxlength="1000"><%= plan.description||'' %></textarea></label><label>Authoring reason<textarea name="reason" minlength="10" maxlength="1000" required></textarea></label></div><button class="primary-button" type="submit">Save plan draft</button></form></section><% } %>
<% if(selected&&['draft','active'].includes(plan.status)){ %><section class="panel form-panel"><h2>Independent plan publication</h2><p class="form-intro">Plan terms: <%= format(plan.entitlements) %>. Published terms stay fixed. Create a new draft to change commercial terms.</p><form method="post" action="/super/subscriptions/plans/<%= plan.publicId %>/publication"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= plan.version %>"><input type="hidden" name="status" value="<%= plan.status==='draft'?'active':'retired' %>"><label>Review reason<textarea name="reason" minlength="10" maxlength="1000" required></textarea></label><button type="submit" class="primary-button">Request <%= plan.status==='draft'?'publication':'retirement' %></button></form></section><% } %>
<% } %>
<% if(pageId==='super-subscriptions'&&filters.tab==='requests'&&selected){ %><section class="panel form-panel"><h2>Seller plan request</h2><p class="form-intro"><%= selected.note||'No additional seller note.' %></p><div class="role-health-rows"><% for(const[key,value]of Object.entries(selected.terms||{})){if(['planVersion','planPublicId'].includes(key))continue; %><div><span><%= human(key) %></span><b><%= format(value) %></b></div><% } %></div><% if(selected.status==='requested'){ %><form method="post" action="/super/subscriptions/requests/<%= selected.publicId %>/decision"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selected.version %>"><div class="role-form-grid"><label>Decision<select name="decision"><option value="approve">Approve unchanged requested terms</option><option value="reject">Reject request</option></select></label><label>Review reason<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label></div><p class="form-intro">Approval alone does not activate entitlements. The seller’s verified payment activates the paid period.</p><button type="submit" class="primary-button">Record plan decision</button></form><% } %></section><% } %>
<% if(pageId==='super-subscriptions'&&filters.tab==='charges'&&selected){ %><section class="panel form-panel"><h2>Reconcile original payment</h2><p class="form-intro"><%= selected.holdReason||selected.failureCode||'Verification uses the original provider reference and exact recorded currency and amount.' %></p><form method="post" action="/super/subscriptions/charges/<%= selected.publicId %>/reconcile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selected.version %>"><div class="role-form-grid"><label>Original provider tracking reference<input name="trackingId" value="<%= selected.providerTrackingId||'' %>" maxlength="160" required></label><label>Review reason<textarea name="reason" minlength="10" maxlength="1000" required></textarea></label></div><button type="submit" class="primary-button">Verify original provider payment</button></form></section><% } %>
<% if(pageId==='super-settings'&&filters.tab==='privacy'&&selected){
const record=selected, actions=[], hold=record.legalHold?.active;
if(!hold&&['requested','blocked'].includes(record.status)&&['correction','deletion','restriction'].includes(record.type))actions.push(['approve','Approve verified request']);
if(!hold&&!record.restrictionActive&&['requested','blocked','failed'].includes(record.status))actions.push(['reject','Reject request']);
if(!hold&&['failed','blocked'].includes(record.status)&&['export','deletion','restriction'].includes(record.type))actions.push(['retry','Retry after resolving the blocker']);
if(!hold&&record.restrictionActive)actions.push(['release_restriction','Release optional processing restriction']);
if(!['completed','cancelled','rejected','expired'].includes(record.status))actions.push([hold?'release_hold':'hold',hold?'Release legal hold; leave blocked for reviewed retry':'Apply legal hold']);
%>
<section class="panel form-panel"><h2>Privacy request review</h2><p class="form-intro"><%= record.details||'Identity-verified privacy request.' %></p><p class="form-intro">Identity verified: <%= dates(record.identityVerifiedAt) %> · Attempts: <%= record.attempts||0 %> · Legal hold: <%= hold?'Active':'Inactive' %> · Optional processing restriction: <%= record.restrictionActive?'Active':'Inactive' %></p><% if(record.decision||record.lastError){ %><p class="form-intro"><%= record.decision||record.lastError %></p><% } %>
<% if(actions.length){ %><form method="post" action="/super/settings/privacy/<%= record.publicId %>/actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= record.version %>"><div class="role-form-grid"><label>Reviewed action<select name="action"><% for(const[value,label]of actions){ %><option value="<%= value %>"><%= label %></option><% } %></select></label><label>Decision reason<textarea name="reason" minlength="10" maxlength="1000" required></textarea></label></div>
<% if(record.type==='correction'&&['requested','blocked'].includes(record.status)&&!hold){ %><p class="form-intro">Select and enter each verified correction. At least one correction must be applied before completion. Email and phone use verified account flows.</p><div class="role-form-grid"><% for(const field of ['name','publicName','location','bio']){ %><label><span><input name="apply_<%= field %>" type="checkbox" value="on"> Apply <%= human(field) %></span><textarea name="correction_<%= field %>" maxlength="<%= field==='bio'?1000:field==='name'?120:field==='publicName'?100:180 %>"></textarea></label><% } %></div><% } %>
<p class="form-intro">An account holder cannot review their own request. Releasing a restriction does not restore marketing consent.</p><button class="primary-button" type="submit">Record privacy review</button></form><% }else{ %><p class="form-intro">No further review action is available for this request.</p><% } %></section><% } %>
<% if(pageId==='super-settings'&&filters.tab==='business-credit'&&selected){ %><section class="panel form-panel"><h2>Independent business credit review</h2><p class="form-intro"><%= selected.companyName %> requested <%= selected.currency %> <%= selected.creditRequestedLimitMinor %> minor units for <%= selected.creditRequestedTermsDays %> days. Current approved limit: <%= selected.creditLimitMinor||0 %>.</p><% if(selected.creditReviewReason){ %><p class="form-intro">Previous review: <%= selected.creditReviewReason %></p><% } %><form method="post" action="/super/settings/business-credit/<%= selected.publicId %>/decision"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selected.version %>"><div class="role-form-grid"><label>Decision<select name="decision"><option value="approve">Approve within requested terms</option><option value="reject">Reject current request</option><option value="revoke">Revoke approved credit</option></select></label><label>Approved limit in minor units<input name="limitMinor" type="number" min="1" max="<%= selected.creditRequestedLimitMinor %>" step="1" value="<%= selected.creditRequestedLimitMinor %>" required></label><label>Approved terms in days<input name="termsDays" type="number" min="1" max="<%= selected.creditRequestedTermsDays %>" value="<%= selected.creditRequestedTermsDays %>" required></label><label>Review reason<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label></div><p class="form-intro">The company owner and requesting member cannot approve their own credit. Current exposure and the requesting membership are rechecked.</p><button type="submit" class="primary-button">Record business credit decision</button></form></section><% } %>
<% if(pageId==='super-settings'&&filters.tab==='features'){ const feature=selected||{}; %><section class="panel form-panel"><h2>Feature rollout proposal</h2><form method="post" action="/super/settings/features/requests"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(selected){ %><input type="hidden" name="version" value="<%= feature.version %>"><% } %><div class="role-form-grid"><label>Feature key<input name="key" pattern="[a-z0-9][a-z0-9._-]{1,79}" maxlength="80" value="<%= feature.key||'' %>" <%= selected?'readonly':'' %> required></label><label>Rollout percentage<input name="rolloutPercentage" type="number" min="0" max="100" step="1" value="<%= feature.rolloutPercentage??0 %>" required></label><label>Market codes · blank for global<input name="countries" maxlength="100" value="<%= (feature.countries||[]).join(', ') %>"></label><label>Roles · blank for all<input name="roles" maxlength="200" value="<%= (feature.roles||[]).join(', ') %>" placeholder="customer, seller"></label><label>Availability<select name="enabled"><option value="false" <%= !feature.enabled?'selected':'' %>>Disabled</option><option value="true" <%= feature.enabled?'selected':'' %>>Enabled</option></select></label><label>Description<textarea name="description" maxlength="500"><%= feature.description||'' %></textarea></label><label>Review reason<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label></div><button type="submit" class="primary-button">Request rollout approval</button></form></section><% } %>
<% if(pageId==='super-settings'&&filters.tab==='cms'){ const content=selected, latest=content?.revisions?.[0]; %>
<% if(content){ %><section class="panel form-panel"><h2>Content revisions</h2><p class="form-intro"><%= content.revisionCount||0 %> total · Public revision <%= content.activeVersion||'none' %> · Scheduled revision <%= content.scheduledVersion||'none' %></p><% for(const revision of content.revisions||[]){ %><article class="role-activity-panel"><h3>Revision <%= revision.version %> · <%= revision.title %></h3><p class="form-intro"><%= revision.reason %> · <%= dates(revision.createdAt) %></p><p><%= revision.body %></p><% if(revision.version!==content.activeVersion&&!content.scheduledVersion){ %><form method="post" action="/super/settings/cms/<%= content.publicId %>/publication"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= content.version %>"><input type="hidden" name="revisionVersion" value="<%= revision.version %>"><div class="role-form-grid"><label>Publication action<select name="action"><option value="publish">Publish revision</option><% if(revision.publishedAt){ %><option value="rollback">Roll back to previously published revision</option><% } %></select></label><label>Schedule in UTC · blank for immediate after approval<input name="scheduledFor" type="datetime-local"></label><label>Review reason<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label></div><button type="submit" class="outline-button">Request independent publication</button></form><% } %></article><% } %><div class="role-table-footer"><% if(filters.revisionBefore){ %><a class="plain-link" href="<%= superAdminPage.href+'?'+new URLSearchParams({...flow.parameters,id:content.publicId}) %>">Latest revisions</a><% } %><% if(content.revisionPage?.hasMore){ %><a class="plain-link" href="<%= superAdminPage.href+'?'+new URLSearchParams({...flow.parameters,id:content.publicId,revisionBefore:String(content.revisionPage.next)}) %>">Older revisions</a><% } %></div><% if(content.scheduledVersion){ %><form method="post" action="/super/settings/cms/<%= content.publicId %>/cancel-schedule"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= content.version %>"><label>Cancellation reason<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label><button type="submit" class="outline-button">Cancel outstanding schedule</button></form><% } %></section><% } %>
<% if(!content?.scheduledVersion){ %><section class="panel form-panel"><h2><%= content?'Author the next content revision':'Author platform content' %></h2><form method="post" action="/super/settings/cms/revisions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(content){ %><input type="hidden" name="version" value="<%= content.version %>"><% } %><div class="role-form-grid"><label>Content key<input name="key" pattern="[a-z0-9][a-z0-9._-]{1,119}" maxlength="120" value="<%= content?.key||'' %>" <%= content?'readonly':'' %> required></label><label>Content type<select name="type"><% for(const type of ['home_module','banner','collection','hero','press','help','legal']){if(content&&content.type!==type)continue; %><option value="<%= type %>"><%= human(type) %></option><% } %></select></label><label>Market<select name="country"><% if(!content||!content.country){ %><option value="">Global</option><% } %><% for(const market of flow.context.countries){if(content&&content.country!==market.code)continue; %><option value="<%= market.code %>" <%= content?.country===market.code?'selected':'' %>><%= market.name %></option><% } %></select></label><label>Title<input name="title" maxlength="180" value="<%= latest?.title||'' %>" required></label><label>Body<textarea name="body" minlength="3" maxlength="20000" required><%= latest?.body||'' %></textarea></label><label>Authoring reason<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label><% for(const field of ['eyebrow','category','action','readTime','image']){ %><label><%= human(field) %><input name="<%= field %>" maxlength="<%= field==='image'?1000:100 %>" value="<%= latest?.data?.[field]||'' %>"></label><% } %></div><button type="submit" class="primary-button">Save content revision</button></form></section><% } %>
<% } %>
<% if(pageId==='super-security'&&selected&&['alerts','incidents','findings'].includes(filters.tab)){ const statuses=filters.tab==='alerts'?['acknowledged','investigating','resolved','suppressed']:filters.tab==='incidents'?['investigating','monitoring','resolved']:['remediated']; %><section class="panel form-panel"><h2>Record verified security response</h2><p class="form-intro"><%= selected.details||selected.summary||selected.message||selected.title %></p><form method="post" action="/super/security/<%= filters.tab %>/<%= selected.publicId %>/actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= selected.version %>"><div class="role-form-grid"><label>Response state<select name="status"><% for(const status of statuses){ %><option value="<%= status %>"><%= human(status) %></option><% } %></select></label><label>Verified response and reason<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label></div><p class="form-intro">This records a verified operational response. Evidence and the original finding remain retained.</p><button type="submit" class="primary-button">Record security response</button></form></section><% } %>
