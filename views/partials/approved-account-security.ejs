<section class="app-page active account-service-page"><%if(flash){%><div class="dashboard-message <%=flash.type==='error'?'error':''%>"><strong><%=flash.message%></strong><%if(flash.details){%><div class="muted-label"><%=flash.details%></div><%}%></div><%}%><div class="page-heading"><h1>Password &amp; security</h1><p>Manage your password, MFA and signed-in devices.</p></div><div class="settings-layout"><section class="panel form-panel"><h2>Change password</h2><form class="dashboard-form" method="post" action="/account/password"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Current password<input type="password" name="currentPassword" autocomplete="current-password" required></label><label>New password<input type="password" name="password" minlength="12" maxlength="128" autocomplete="new-password" required></label><label>Confirm password<input type="password" name="confirmPassword" minlength="12" maxlength="128" autocomplete="new-password" required></label><button class="primary-button" type="submit">Update password</button></form></section><section class="panel form-panel"><h2>Authenticator MFA</h2><p><%=user.security?.mfaEnabled?'Enabled for this account.':(mfaRequired?'Required for privileged operations.':'Optional additional protection.')%></p><span class="status-pill <%=user.security?.mfaEnabled?'good':(mfaRequired?'warn':'')%>"><%=user.security?.mfaEnabled?'Enabled':(mfaRequired?'Required':'Optional')%></span><%if(mfaRecoveryCodes?.length){%><div class="choice-grid"><%mfaRecoveryCodes.forEach(item=>{%><code><%=item%></code><%})%></div><%}%><%if(!user.security?.mfaEnabled){%><%if(!mfaEnrollment){%><form class="dashboard-form" method="post" action="/account/mfa/begin"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Current password<input type="password" name="currentPassword" required></label><button class="primary-button" type="submit">Start MFA setup</button></form><%}else{%><div class="ticket-row"><div><strong>Authenticator secret</strong><p><code><%=mfaEnrollment.secret%></code></p><small><%=mfaEnrollment.uri%></small></div></div><form class="dashboard-form" method="post" action="/account/mfa/confirm"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Authenticator code<input type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required></label><button class="primary-button" type="submit">Enable MFA</button></form><%}%><%}else{%><form class="dashboard-form" method="post" action="/account/mfa/recovery-codes"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Current password<input type="password" name="currentPassword" required></label><label>Authenticator or recovery code<input type="text" name="code" maxlength="32" required></label><button class="outline-button" type="submit">Generate new recovery codes</button></form><%if(!mfaRequired){%><form class="dashboard-form" method="post" action="/account/mfa/disable"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Current password<input type="password" name="currentPassword" required></label><label>Authenticator or recovery code<input type="text" name="code" maxlength="32" required></label><button class="outline-button" type="submit">Disable MFA</button></form><%}%><%}%></section><section class="panel form-panel wide"><h2>Signed-in devices</h2><div class="ticket-list"><%if(!devices.length){%><div class="empty-state">No device history.</div><%}%><%devices.forEach(device=>{%><article class="ticket-row"><div><strong><%=device.label%><%=device.publicId===currentDeviceId?' · This device':''%></strong><p>Last active <%=formatDate(device.lastSeenAt)%><%=device.revokedAt?` · Revoked ${formatDate(device.revokedAt)}`:''%></p></div><%if(!device.revokedAt){%><form method="post" action="/account/devices/<%=device.publicId%>/revoke"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit"><%=device.publicId===currentDeviceId?'Sign out':'Revoke'%></button></form><%}%></article><%})%></div><%if(queuePages?.devices?.hasMore){%><p><a class="plain-link" href="/account/security?devicesAfter=<%=encodeURIComponent(queuePages.devices.next)%>">Older devices</a></p><%}%></section></div></section>