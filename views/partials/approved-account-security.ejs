<% const securityContinuation = typeof mfaContinuation !== 'undefined' && mfaContinuation ? mfaContinuation : null; %>
<section class="app-page active account-service-page">
  <div class="page-heading"><div><h1>Password &amp; security</h1><p>Manage your password, MFA and signed-in devices.</p></div></div>
  <div class="settings-layout">
    <section class="panel form-panel">
      <h2>Change password</h2>
      <form class="dashboard-form" method="post" action="/account/password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Current password<input type="password" name="currentPassword" autocomplete="current-password" required></label>
        <label>New password<input type="password" name="password" minlength="12" maxlength="128" autocomplete="new-password" required></label>
        <label>Confirm password<input type="password" name="confirmPassword" minlength="12" maxlength="128" autocomplete="new-password" required></label>
        <button class="primary-button" type="submit">Update password</button>
      </form>
    </section>
    <section class="panel form-panel mfa-security-panel">
      <h2>Authenticator MFA</h2>
      <% if (securityContinuation?.next && !user.security?.mfaEnabled) { %><p>Enable your authenticator to continue to your workspace.</p><% } %>
      <p><%= user.security?.mfaEnabled ? 'Enabled for this account.' : (mfaRequired ? 'Required for privileged operations.' : 'Optional additional protection.') %></p>
      <span class="status-pill <%= user.security?.mfaEnabled ? 'good' : (mfaRequired ? 'warn' : '') %>"><%= user.security?.mfaEnabled ? 'Enabled' : (mfaRequired ? 'Required' : 'Optional') %></span>
      <% if (mfaRecoveryCodes?.length) { %>
        <p class="mfa-recovery-note">Save these recovery codes offline before continuing. Each code works once and these codes are shown only now. Anyone with a code can use it to complete sign-in.</p>
        <div class="choice-grid mfa-recovery-codes" aria-label="One-time recovery codes"><% mfaRecoveryCodes.forEach(item => { %><code><%= item %></code><% }) %></div>
      <% } %>
      <% if (!user.security?.mfaEnabled) { %>
        <% if (!mfaEnrollment) { %>
          <p>Use an authenticator app such as Google Authenticator, Microsoft Authenticator or Aegis. You will scan a QR code, then confirm a code from the app.</p>
          <form class="dashboard-form" method="post" action="/account/mfa/begin">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (securityContinuation?.next) { %><input type="hidden" name="next" value="<%= securityContinuation.next %>"><% } %>
            <label>Current password<input type="password" name="currentPassword" autocomplete="current-password" required></label>
            <button class="primary-button" type="submit">Start MFA setup</button>
          </form>
        <% } else { %>
          <ol class="mfa-setup-steps">
            <li>Open your authenticator app and choose to add an account.</li>
            <li>Scan the QR code below. If you are using the same phone, use the manual setup key instead.</li>
            <li>Enter the current 6-digit code from the app and select Enable MFA. Save the recovery codes shown afterwards.</li>
          </ol>
          <figure class="mfa-qr-figure">
            <img class="mfa-qr-image" src="/account/mfa/qr-code.png" width="256" height="256" alt="QR code for adding your Classic Mart account to an authenticator app" referrerpolicy="no-referrer">
            <figcaption>Scan with your authenticator app. Keep this QR code and your setup key private.</figcaption>
          </figure>
          <details class="mfa-manual-setup">
            <summary>Can’t scan the QR code?</summary>
            <p>Choose Enter a setup key in your app. Use your email as the account name, Classic Mart as the issuer, and select a time-based, 6-digit code with a 30-second interval.</p>
            <label class="dashboard-form">Setup key<input class="mfa-manual-key" type="text" value="<%= mfaEnrollment.secret %>" readonly autocomplete="off" spellcheck="false" aria-label="Authenticator setup key"></label>
            <p>Never send this key or the QR code to anyone, including support.</p>
          </details>
          <form class="dashboard-form" method="post" action="/account/mfa/confirm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (securityContinuation?.next) { %><input type="hidden" name="next" value="<%= securityContinuation.next %>"><% } %>
            <label>Authenticator code<input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required></label>
            <button class="primary-button" type="submit">Enable MFA</button>
          </form>
        <% } %>
      <% } else { %>
        <form class="dashboard-form" method="post" action="/account/mfa/recovery-codes">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (securityContinuation?.next) { %><input type="hidden" name="next" value="<%= securityContinuation.next %>"><% } %>
          <label>Current password<input type="password" name="currentPassword" autocomplete="current-password" required></label>
          <label>Authenticator or recovery code<input type="text" name="code" autocomplete="one-time-code" maxlength="32" required></label>
          <button class="outline-button" type="submit">Generate new recovery codes</button>
        </form>
        <% if (!mfaRequired) { %>
          <form class="dashboard-form" method="post" action="/account/mfa/disable">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (securityContinuation?.next) { %><input type="hidden" name="next" value="<%= securityContinuation.next %>"><% } %>
            <label>Current password<input type="password" name="currentPassword" autocomplete="current-password" required></label>
            <label>Authenticator or recovery code<input type="text" name="code" autocomplete="one-time-code" maxlength="32" required></label>
            <button class="outline-button" type="submit">Disable MFA</button>
          </form>
        <% } %>
      <% } %>
      <% if (user.security?.mfaEnabled && securityContinuation?.url && securityContinuation.url !== '/account/security') { %>
        <p class="account-actions"><a class="primary-button" href="<%= securityContinuation.url %>"><%= securityContinuation.label %></a></p>
      <% } %>
    </section>
    <% if (user.security?.mfaEnabled) { %>
      <section class="panel form-panel">
        <h2>Confirm your identity</h2>
        <p>Use a current authenticator or recovery code before a sensitive administrative action.</p>
        <form class="dashboard-form" method="post" action="/account/mfa/step-up">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (securityContinuation?.next) { %><input type="hidden" name="next" value="<%= securityContinuation.next %>"><% } %>
          <label>Current password<input type="password" name="currentPassword" autocomplete="current-password" maxlength="256" required></label>
          <label>Authenticator or recovery code<input type="text" name="code" autocomplete="one-time-code" minlength="6" maxlength="32" required></label>
          <button class="primary-button" type="submit">Confirm identity</button>
        </form>
      </section>
    <% } %>
    <section class="panel form-panel wide">
      <h2>Signed-in devices</h2>
      <div class="ticket-list">
        <% if (!devices.length) { %><div class="empty-state">No device history.</div><% } %>
        <% devices.forEach(device => { %>
          <article class="ticket-row">
            <div><strong><%= device.label %><%= device.publicId === currentDeviceId ? ' · This device' : '' %></strong><p>Last active <%= formatDate(device.lastSeenAt) %><%= device.revokedAt ? ` · Revoked ${formatDate(device.revokedAt)}` : '' %></p></div>
            <% if (!device.revokedAt) { %>
              <form method="post" action="/account/devices/<%= device.publicId %>/revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="outline-button" type="submit"><%= device.publicId === currentDeviceId ? 'Sign out' : 'Revoke' %></button></form>
            <% } %>
          </article>
        <% }) %>
      </div>
      <% if (queuePages?.devices?.hasMore) { %><p><a class="plain-link" href="/account/security?devicesAfter=<%= encodeURIComponent(queuePages.devices.next) %><%= securityContinuation?.next ? '&next=' + encodeURIComponent(securityContinuation.next) : '' %>">Older devices</a></p><% } %>
    </section>
  </div>
</section>
