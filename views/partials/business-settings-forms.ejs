<% if(flow.can.members){ %>
<section class="panel role-form-section"><div class="role-panel-head"><div><h2>Company contact details</h2><p>Billing and delivery contacts are captured on each accepted purchase order.</p></div></div>
<form method="post" action="/business/profile" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= flow.organization.version %>">
<label>Company name<input name="companyName" value="<%= flow.organization.companyName %>" maxlength="180" required></label><label>Billing email<input name="billingEmail" type="email" value="<%= flow.organization.billingEmail %>" maxlength="254" required></label>
<label>Tax identification<input name="taxId" maxlength="120" placeholder="Leave blank to keep the current tax ID" autocomplete="off"></label><label class="role-check"><input name="clearTaxId" type="checkbox" value="true">Clear the current tax ID</label><label>Billing contact<input name="billingContactName" value="<%= flow.organization.billingContactName||'' %>" maxlength="120" required></label><label>Billing phone<input name="billingPhone" type="tel" value="<%= flow.organization.billingPhone||'' %>" maxlength="32" required></label><label>Billing city<input name="billingCity" value="<%= flow.organization.billingCity||'' %>" maxlength="120" required></label><label class="wide">Billing address<input name="billingAddress" value="<%= flow.organization.billingAddress||'' %>" maxlength="240" required></label>
<label>Delivery contact<input name="deliveryContactName" value="<%= flow.organization.deliveryContactName||'' %>" maxlength="120" required></label><label>Delivery phone<input name="deliveryPhone" type="tel" value="<%= flow.organization.deliveryPhone||'' %>" maxlength="32" required></label><label>Delivery city<input name="deliveryCity" value="<%= flow.organization.deliveryCity||'' %>" maxlength="120" required></label><label class="wide">Delivery address<input name="deliveryAddress" value="<%= flow.organization.deliveryAddress||'' %>" maxlength="240" required></label><div class="wide"><button class="primary-button" type="submit">Save company details</button></div></form></section>
<section class="panel role-form-section"><div class="role-panel-head"><div><h2>Invite a company member</h2><p>The verified recipient must explicitly accept. Only the owner can appoint administrators.</p></div></div><form method="post" action="/business/members" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Email<input name="email" type="email" maxlength="254" required></label><label>Membership role<select name="role"><% for(const role of ['buyer','approver','viewer',...(flow.membership.role==='owner'?['admin']:[])]){ %><option value="<%= role %>"><%= role.charAt(0).toUpperCase()+role.slice(1) %></option><% } %></select></label><label>Spending limit (minor units)<input name="spendingLimitMinor" type="number" min="0" max="10000000000" step="1" value="0" required></label><label class="role-check"><input type="checkbox" name="canApprove" value="true">Permit independent approvals</label><div class="wide"><button class="primary-button" type="submit">Send invitation</button></div></form></section>
<% for(const member of flow.members){if(member.role==='owner'||member.person?.publicId===user.publicId)continue;const ownerRequired=member.role==='admin';if(ownerRequired&&flow.membership.role!=='owner')continue; %><section class="panel role-form-section" id="<%= member.publicId %>"><div class="role-panel-head"><div><h2><%= member.person?.name||member.person?.email||'Company member' %></h2><p><%= member.role %> · <%= member.status %></p></div></div><% if(member.status!=='revoked'){ %><form method="post" action="/business/members/<%= member.publicId %>" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= member.version %>"><label>Role<select name="role"><% for(const role of ['buyer','approver','viewer',...(flow.membership.role==='owner'?['admin']:[])]){ %><option value="<%= role %>" <%= role===member.role?'selected':'' %>><%= role %></option><% } %></select></label><label>Spending limit (minor units)<input name="spendingLimitMinor" type="number" min="0" max="10000000000" step="1" value="<%= member.spendingLimitMinor %>" required></label><label>Independent approvals<select name="canApprove"><option value="false" <%= !member.canApprove?'selected':'' %>>Not permitted</option><option value="true" <%= member.canApprove?'selected':'' %>>Permitted</option></select></label><div class="wide"><button class="primary-button" name="action" value="update" type="submit">Save membership</button> <button class="outline-button" name="action" value="revoke" type="submit">Revoke access</button></div></form><% } %></section><% } %>
<section class="panel role-form-section"><div class="role-panel-head"><div><h2>Request invoice credit</h2><p>Country operations independently review the limit and term. A request does not enable credit.</p></div></div><form method="post" action="/business/credit-terms" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= flow.organization.version %>"><label>Requested limit (minor units)<input name="limitMinor" type="number" min="1" max="10000000000" step="1" required></label><label>Payment term (days)<input name="termsDays" type="number" min="1" max="120" step="1" required></label><div class="wide"><button class="primary-button" type="submit">Request independent review</button></div></form><% if(flow.organization.creditRequestedAt){ %><p class="form-intro">Latest request: <%= money(flow.organization.creditRequestedLimitMinor) %> for <%= flow.organization.creditRequestedTermsDays %> days. <%= flow.organization.creditReviewedAt&&new Date(flow.organization.creditReviewedAt)>=new Date(flow.organization.creditRequestedAt)?'Reviewed: '+flow.organization.creditReviewDecision:'Awaiting independent review' %>.</p><% } %></section>
<% } %>
<% if(flow.can.budgets){ %><section class="panel role-form-section"><div class="role-panel-head"><div><h2>Create a purchasing budget</h2><p>Approvals commit funds within the active period. Verified delivery records actual spend.</p></div></div><form method="post" action="/business/budgets" class="role-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= flow.idempotencyKey %>"><label>Budget name<input name="name" maxlength="120" required></label><label>Limit (minor units)<input name="limitMinor" type="number" min="1" max="10000000000" step="1" required></label><label>Period start<input name="periodStart" type="date" required></label><label>Period end<input name="periodEnd" type="date" required></label><div class="wide"><button class="primary-button" type="submit">Create budget</button></div></form></section><% } %>
<section class="panel role-form-section"><div class="role-panel-head"><div><h2>Company budgets</h2><p>Budgets and invoice credit are separate controls.</p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Budget</th><th>Limit</th><th>Committed</th><th>Spent</th><th>Period</th></tr></thead><tbody><% for(const budget of flow.budgets){ %><tr><td data-label="Budget"><%= budget.name %></td><td data-label="Limit"><%= money(budget.limitMinor) %></td><td data-label="Committed"><%= money(budget.committedMinor) %></td><td data-label="Spent"><%= money(budget.spentMinor) %></td><td data-label="Period"><%= new Date(budget.periodStart).toLocaleDateString('en-GB',{timeZone:flow.timeZone}) %> – <%= new Date(budget.periodEnd).toLocaleDateString('en-GB',{timeZone:flow.timeZone}) %></td></tr><% } %><% if(!flow.budgets.length){ %><tr><td colspan="5">No company budgets yet.</td></tr><% } %></tbody></table></div><% if(flow.budgetPage.next){ %><a class="plain-link" href="<%= link('budgetsAfter',flow.budgetPage.next) %>">More budgets</a><% } %></section>
