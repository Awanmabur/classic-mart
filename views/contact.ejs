<!DOCTYPE html>

<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"/><meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/><meta content="Send a marketplace, seller, partnership or general question." name="description"/><meta content="#ff6200" name="theme-color"/><title>Contact Us — Classic Mart</title><link href="/styles.css" rel="stylesheet"/><link href="/storefront-pages.css" rel="stylesheet"/><link href="/shared-shell.css" rel="stylesheet"/><link href="/marketplace-pages.css" rel="stylesheet"/><link href="/info-pages.css" rel="stylesheet"/></head><body class="info-body"><a class="skip-link" href="#mainContent">Skip to content</a><%- include("partials/storefront-header") %><main class="info-main" id="mainContent"><section class="info-hero"><div class="container"><nav aria-label="Breadcrumb" class="catalog-breadcrumb"><a href="/">Home</a><span>›</span><strong>Contact Us</strong></nav><span class="info-kicker">Talk to the Classic Mart team</span><h1>Contact Us</h1><p>Send a marketplace, seller, partnership or general question.</p></div></section><div class="container info-content"><div class="contact-layout"><section class="info-section"><h2>Contact channels</h2><p><strong>Customer support:</strong> Use the Help &amp; Support page for order and return issues.</p><p><strong>Seller questions:</strong> Create a seller account or browse the Seller Center.</p><p><strong>Press:</strong> Use this form and select Press &amp; partnerships.</p></section><form action="/support/request" class="info-form" id="contactForm" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><input name="context" type="hidden" value="contact"/><label>Full name<input maxlength="120" minlength="2" name="name" required value="<%= user?.name || '' %>"/></label><label>Email<input maxlength="254" name="email" required type="email" value="<%= user?.email || '' %>"/></label><label>Topic<select name="topic" required><option value="">Choose a topic</option><option value="General question">General question</option><option value="Seller support">Seller support</option><option value="Press and partnerships">Press &amp; partnerships</option><option value="Privacy request">Privacy request</option></select></label><label>Message<textarea maxlength="3000" minlength="10" name="message" required rows="6"></textarea></label><button type="submit">Send message</button><p class="form-status" role="status"><%= flash?.message || '' %></p></form></div></div></main><section class="newsletter">
<div class="container newsletter-inner">
<div class="newsletter-message"><span><img alt="" src="/assets/icons/envelope.svg"/></span><div><strong>Stay in the Loop!</strong><small>Get exclusive deals, new arrivals and shopping tips.</small></div></div>
<form class="newsletter-form" data-newsletter-form id="newsletterForm" novalidate>
<label class="sr-only" for="newsletterEmail">Email address</label>
<input autocomplete="email" id="newsletterEmail" maxlength="254" name="email" placeholder="Enter your email address" required type="email"/>
<button type="submit">Subscribe</button>
<p aria-live="polite" class="newsletter-status" data-newsletter-status></p>
</form>
<div class="newsletter-perks"><span><img alt="" src="/assets/icons/percent.svg"/><b>Exclusive Deals</b></span><span><img alt="" src="/assets/icons/gift.svg"/><b>New Arrivals</b></span><span><img alt="" src="/assets/icons/location-dot.svg"/><b>Shopping Tips</b></span></div>
</div>
</section><%- include("partials/storefront-footer") %><div aria-live="polite" class="page-toast" id="pageToast" role="status"></div><script src="/cart-store.js"></script>
<script src="/info-pages.js"></script><script src="/shared-shell.js"></script><script src="/image-fallback.js"></script><script src="/country-switcher.js"></script><script src="/search-tools.js"></script><script src="/newsletter.js"></script></body></html>