<!DOCTYPE html>

<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<meta content="Browse, search and filter products across Classic Mart categories." name="description"/>
<meta content="#ff6200" name="theme-color"/>
<title>All Categories — Classic Mart</title>
<link href="/styles.css" rel="stylesheet"/>
<link href="/storefront-pages.css" rel="stylesheet"/>
<link href="/marketplace-pages.css" rel="stylesheet"/>
</head>
<body class="catalog-body" data-page-mode="categories">
<a class="skip-link" href="#catalogMain">Skip to products</a><%- include("partials/storefront-header") %>
<main class="catalog-main" id="catalogMain">
<section class="catalog-hero">
<div class="container catalog-hero-inner">
<nav aria-label="Breadcrumb" class="catalog-breadcrumb"><a href="/">Home</a><span>›</span><strong id="catalogBreadcrumb">All categories</strong></nav>
<div class="catalog-hero-copy">
<div><span id="catalogEyebrow">Classic Mart marketplace</span><h1 id="catalogTitle">All categories</h1><p id="catalogDescription">Explore every department and continue to complete product listings with useful filters and sorting.</p></div>
<div class="catalog-hero-benefits"><span><img alt="" src="/assets/icons/circle-check.svg"/> Verified listings</span><span><img alt="" src="/assets/icons/rotate-left.svg"/> Easy returns</span><span><img alt="" src="/assets/icons/lock.svg"/> Secure checkout</span></div>
</div>
</div>
</section>
<section class="container category-directory" hidden="" id="categoryDirectory">
<div class="catalog-section-heading"><div><span>Explore departments</span><h2>Shop all categories</h2></div><p>Choose a department to see products, deals and popular brands in one place.</p></div>
<div class="category-directory-grid" id="categoryDirectoryGrid"></div>
<div class="category-feature-strip">
<article><img alt="" src="/assets/icons/truck-fast.svg"/><div><strong>Tracked delivery</strong><small>See delivery information before checkout</small></div></article>
<article><img alt="" src="/assets/icons/rotate-left.svg"/><div><strong>Simple returns</strong><small>Manage eligible return requests from your account</small></div></article>
<article><img alt="" src="/assets/icons/headset.svg"/><div><strong>Responsive support</strong><small>Get help before and after your order</small></div></article>
</div>
</section>
<section class="container catalog-workspace" id="catalogWorkspace">
<aside class="catalog-filter-panel" id="catalogFilterPanel">
<div class="filter-panel-head"><div><span>Refine results</span><h2>Filters</h2></div><button aria-label="Close filters" id="closeCatalogFilters" type="button"><img alt="" src="/assets/icons/xmark.svg"/></button></div>
<form id="catalogFilterForm">
<label class="catalog-field">Search within results<input id="catalogQuery" placeholder="Product or brand" type="search"/></label>
<fieldset><legend>Category</legend><div class="filter-category-list" id="filterCategoryList"></div></fieldset>
<fieldset><legend>Price range</legend><div class="price-input-grid"><label>Minimum<input id="minPrice" min="0" placeholder="0" step="1" type="number"/></label><label>Maximum<input id="maxPrice" min="0" placeholder="No maximum" step="1" type="number"/></label></div></fieldset>
<fieldset><legend>Minimum rating</legend><div class="rating-filter-list"><label><input checked="" name="rating" type="radio" value="0"/><span>Any rating</span></label><label><input name="rating" type="radio" value="4"/><span>★★★★☆ &amp; up</span></label><label><input name="rating" type="radio" value="4.5"/><span>★★★★★ 4.5+</span></label></div></fieldset>
<fieldset><legend>Availability</legend><label class="filter-check"><input id="inStockOnly" type="checkbox"/><span>In-stock products only</span></label><label class="filter-check"><input id="discountOnly" type="checkbox"/><span>Discounted products</span></label></fieldset>
<div class="filter-panel-actions"><button class="catalog-primary-button" type="submit">Apply filters</button><button class="catalog-secondary-button" id="clearCatalogFilters" type="button">Clear all</button></div>
</form>
</aside>
<div class="catalog-results-area">
<div class="catalog-toolbar">
<div><button class="mobile-filter-trigger" id="openCatalogFilters" type="button"><img alt="" src="/assets/icons/filter.svg"/> Filters</button><p id="catalogResultCount">Loading products…</p></div>
<div class="catalog-view-controls"><label>Sort by<select id="catalogSort"><option value="featured">Featured</option><option value="rating">Top rated</option><option value="popular">Most popular</option><option value="price-low">Price: low to high</option><option value="price-high">Price: high to low</option><option value="discount">Biggest discount</option></select></label><button aria-label="Grid view" class="view-mode-button active" data-view-mode="grid" type="button"><img alt="" src="/assets/icons/table-cells-large.svg"/></button><button aria-label="List view" class="view-mode-button" data-view-mode="list" type="button"><img alt="" src="/assets/icons/bars.svg"/></button></div>
</div>
<div class="active-filter-row" id="activeFilterRow"></div>
<div aria-live="polite" class="catalog-product-grid" id="catalogProductGrid"></div>
<div class="catalog-empty" hidden="" id="catalogEmpty"><span><img alt="" src="/assets/icons/magnifying-glass.svg"/></span><h2>No matching products</h2><p>Try a different search term, category, price range or rating.</p><button class="catalog-primary-button" id="emptyClearButton" type="button">Clear filters</button></div>
<nav aria-label="Product pages" class="catalog-pagination" id="catalogPagination"></nav>
</div>
</section>
</main>
<div class="catalog-filter-backdrop" hidden="" id="catalogFilterBackdrop"></div>
<div aria-live="polite" class="page-toast" id="catalogToast" role="status"></div>
<%- include("partials/product-preview-modal") %>
<section class="newsletter">
<div class="container newsletter-inner">
<div class="newsletter-message"><span><img alt="" src="/assets/icons/envelope.svg"/></span><div><strong>Stay in the Loop!</strong><small>Get exclusive deals, new arrivals and shopping tips.</small></div></div>
<form class="newsletter-form" data-newsletter-form id="newsletterForm" novalidate>
<label class="sr-only" for="newsletterEmail">Email address</label>
<input autocomplete="email" id="newsletterEmail" maxlength="254" name="email" placeholder="Enter your email address" required type="email"/>
<button type="submit">Subscribe</button>
<p aria-live="polite" class="newsletter-status" data-newsletter-status></p>
</form>
<div class="newsletter-perks"><span><img alt="" src="/assets/icons/percent.svg"/><b>Exclusive Deals</b></span><span><img alt="" src="/assets/icons/gift.svg"/><b>New Arrivals</b></span><span><img alt="" src="/assets/icons/location-dot.svg"/><b>Shopping Tips</b></span></div>
</div>
</section><%- include("partials/storefront-footer") %><script src="/cart-store.js"></script>
<script src="/catalog-page.js"></script>
<script src="/product-preview.js"></script>
<script src="/shared-shell.js"></script><script src="/image-fallback.js"></script><script src="/country-switcher.js"></script><script src="/search-tools.js"></script><script src="/newsletter.js"></script></body>
</html>
