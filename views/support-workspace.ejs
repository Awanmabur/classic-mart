<!doctype html>
<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Support & Trust — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"></head>
<body><main class="catalog-workspace"><header class="catalog-topbar"><div><a class="brand" href="/dashboard"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p>Support &amp; trust operations</p></div><div class="catalog-actions"><a class="outline-button" href="/finance">Finance</a><a class="outline-button" href="/operations/support/ai">Support AI</a><a class="outline-button" href="/dashboard">Dashboard</a></div></header>
<section class="catalog-page-head panel"><div><span class="eyebrow">Buyer protection operations</span><h1>Returns, disputes, support &amp; trust</h1><p>Investigate real marketplace cases without bypassing country scope, evidence access, finance controls or audit history.</p></div></section>

<section class="panel"><div class="role-panel-head"><div><h2>Return queue</h2><p>Approve eligibility, receive the returned goods, inspect them, then hand refunds to finance or create a real replacement order.</p></div></div><% if(!returns.length){%><p>No return requests.</p><%}%>
<% returns.forEach(r=>{%><article class="catalog-row"><div><strong><%=r.publicId%> · <%=r.orderPublicId%></strong><small><%=r.reason%> · <%=r.resolution%> · <%=r.returnMethod%> · <%=r.status%></small><% if(r.returnShipmentPublicId){ %><small>Return shipment: <%=r.returnShipmentPublicId%></small><% } %><% if(r.replacementOrderPublicId){ %><small>Replacement: <%=r.replacementOrderPublicId%></small><% } %><% if(r.evidenceDocumentIds?.length){ %><small>Evidence: <% r.evidenceDocumentIds.forEach((e,idx)=>{ %><%=idx?' · ':''%><a href="/evidence/<%=e.publicId%>"><%=e.description||e.publicId%></a><% }) %></small><% } %></div><div class="catalog-actions">
<% if(r.status==='requested'){%><form method="post" action="/operations/support/returns/<%=r.publicId%>/decision"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="decision" value="approve"><input name="note" placeholder="Approval note"><button type="submit">Approve</button></form><form method="post" action="/operations/support/returns/<%=r.publicId%>/decision"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="decision" value="reject"><input name="note" required placeholder="Rejection reason"><button class="outline-button" type="submit">Reject</button></form><%}%>
<% if(['approved','awaiting_return'].includes(r.status)){%><form method="post" action="/operations/support/returns/<%=r.publicId%>/received"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="note" placeholder="Receipt / condition note"><button type="submit">Mark received</button></form><%}%>
<% if(r.status==='received'){%><form method="post" action="/operations/support/returns/<%=r.publicId%>/inspect"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="condition"><option value="unopened">Unopened</option><option value="good">Good</option><option value="damaged">Damaged</option><option value="wrong_item">Wrong item</option><option value="counterfeit_suspected">Counterfeit suspected</option><option value="missing_parts">Missing parts</option><option value="not_received">Not received</option></select><input name="notes" placeholder="Inspection notes"><button type="submit">Record inspection</button></form><%}%>
<% if(r.status==='refund_pending'){ %><span class="status-chip">Finance refund required</span><% } %>
<% if(r.status==='exchange_pending'){%><form method="post" action="/operations/support/returns/<%=r.publicId%>/exchange-complete"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Create replacement order</button></form><%}%>
</div></article><%})%></section>

<div class="role-content-grid"><section class="panel"><div class="role-panel-head"><div><h2>Disputes</h2><p>Every update becomes part of the customer-visible dispute timeline.</p></div></div><% if(!disputes.length){%><p>No disputes.</p><%}%><% disputes.forEach(d=>{%><article class="catalog-row"><div><strong><%=d.subject%></strong><small><%=d.publicId%> · <%=d.category%> · <%=d.status%></small><% if(d.evidenceDocumentIds?.length){%><small>Evidence: <% d.evidenceDocumentIds.forEach((e,idx)=>{%><%=idx?' · ':''%><a href="/evidence/<%=e.publicId%>"><%=e.description||e.publicId%></a><%})%></small><%}%></div><form method="post" action="/operations/support/disputes/<%=d.publicId%>/status"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="status"><option value="investigating">Investigating</option><option value="awaiting_customer">Awaiting customer</option><option value="awaiting_seller">Awaiting seller</option><option value="resolved">Resolved</option><option value="rejected">Rejected</option><option value="closed">Closed</option></select><input name="message" required placeholder="Timeline update"><button type="submit">Update</button></form></article><%})%></section>
<section class="panel"><div class="role-panel-head"><div><h2>Trust cases</h2><p>Counterfeit, prohibited-product, unsafe-product and manipulation investigations.</p></div></div><% if(!cases.length){%><p>No trust cases.</p><%}%><% cases.forEach(c=>{%><article class="catalog-row"><div><strong><%=c.type%></strong><small><%=c.publicId%> · <%=c.status%> · <%=c.productPublicId||c.storePublicId||''%></small><% if(c.evidenceDocumentIds?.length){%><small>Evidence: <% c.evidenceDocumentIds.forEach((e,idx)=>{%><%=idx?' · ':''%><a href="/evidence/<%=e.publicId%>"><%=e.description||e.publicId%></a><%})%></small><%}%></div><form method="post" action="/operations/support/trust/<%=c.publicId%>/status"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="status"><option value="investigating">Investigating</option><option value="actioned">Actioned</option><option value="dismissed">Dismissed</option><option value="closed">Closed</option></select><select name="enforcement"><option value="none">No enforcement</option><option value="suspend_product">Suspend product</option><option value="restore_product">Restore product</option><option value="suspend_store">Suspend store</option><option value="restore_store">Restore store</option></select><input name="decision" required placeholder="Decision, evidence and enforcement reason"><button type="submit">Update</button></form></article><%})%></section></div>

<section class="panel"><div class="role-panel-head"><div><h2>Support SLA queue</h2><p>Urgent and overdue work remains visible and requires an auditable update.</p></div></div><% if(!tickets.length){%><p>No support tickets.</p><%}%><% tickets.forEach(t=>{%><article class="catalog-row"><div><strong><%=t.publicId%> · <%=t.subject%></strong><small><%=t.priority%> · <%=t.status%> · SLA <%=formatDate(t.slaDueAt)%></small><% const requester=ticketRequesters?.[t.publicId]; if(requester?.name||requester?.email){ %><small>Requester: <%=requester.name||'Guest'%><% if(requester.email){ %> · <%=requester.email%><% } %></small><% } %><% if(t.evidenceDocumentIds?.length){%><small>Evidence: <% t.evidenceDocumentIds.forEach((e,idx)=>{%><%=idx?' · ':''%><a href="/evidence/<%=e.publicId%>"><%=e.description||e.publicId%></a><%})%></small><%}%></div><form method="post" action="/operations/support/tickets/<%=t.publicId%>/status"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="status"><option value="in_progress">In progress</option><option value="waiting_customer">Waiting customer</option><option value="escalated">Escalated</option><option value="resolved">Resolved</option><option value="closed">Closed</option></select><input name="message" required placeholder="Support update"><label><input type="checkbox" name="internal" value="true"> Internal note</label><button type="submit">Save</button></form></article><%})%></section>

<div class="role-content-grid"><section class="panel"><div class="role-panel-head"><div><h2>Verified-purchase review moderation</h2><p>Pending and seller-disputed reviews remain subject to evidence-based moderation.</p></div></div><% if(!reviews.length){%><p>No reviews in moderation.</p><%}%><% reviews.forEach(r=>{%><article class="catalog-row"><div><strong><%=r.productPublicId%> · <%=r.rating%>/5</strong><small><%=r.publicId%> · <%=r.status%> · verified purchase<% if(r.disputeReason){%> · seller dispute: <%=r.disputeReason%><%}%></small></div><% if(['pending','disputed'].includes(r.status)){%><form method="post" action="/operations/support/reviews/<%=r.publicId%>/moderate"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="decision"><option value="publish">Publish / uphold</option><option value="reject">Reject / remove</option></select><input name="reason" placeholder="Moderation reason"><button type="submit">Apply</button></form><%}%></article><%})%></section>
<section class="panel"><div class="role-panel-head"><div><h2>Risk signals</h2><p>Signals assist triage; operators still record the human decision.</p></div></div><% if(!risks.length){%><p>No risk signals.</p><%}%><% risks.forEach(r=>{%><article class="catalog-row"><div><strong><%=r.type%> · <%=r.severity%></strong><small><%=r.publicId%> · <%=r.subjectType%> <%=r.subjectPublicId%> · score <%=r.score%> · <%=r.status%></small></div><% if(r.status==='open'){%><form method="post" action="/operations/support/risks/<%=r.publicId%>/review"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="status"><option value="reviewed">Reviewed</option><option value="actioned">Actioned</option><option value="dismissed">Dismissed</option></select><input name="decision" required placeholder="Decision"><button type="submit">Record review</button></form><%}%></article><%})%></section></div>

<div class="role-content-grid"><section class="panel"><div class="role-panel-head"><div><h2>Knowledge base</h2><p>Published country-scoped articles feed customer help endpoints.</p></div></div><form method="post" action="/operations/support/knowledge" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Country (Super Admin only)<input name="country" maxlength="2"></label><label>Title<input name="title" minlength="4" maxlength="180" required></label><label>Slug<input name="slug" minlength="3" maxlength="180" required></label><label>Category<input name="category" minlength="2" maxlength="80" required></label><label>Body<textarea name="body" minlength="20" maxlength="12000" required></textarea></label><label>Status<select name="status"><option value="draft">Draft</option><option value="published">Published</option></select></label><button type="submit">Save article</button></form><div class="table-wrap"><table><thead><tr><th>Article</th><th>Country</th><th>Status</th></tr></thead><tbody><% if(!knowledge.length){%><tr><td colspan="3">No articles.</td></tr><%}%><% knowledge.forEach(k=>{%><tr><td><%=k.title%><br><small><%=k.slug%></small></td><td><%=k.country%></td><td><%=k.status%></td></tr><%})%></tbody></table></div></section>
<section class="panel"><div class="role-panel-head"><div><h2>Support satisfaction</h2><p>Customer ratings measure support quality after resolution.</p></div></div><% if(!surveys.length){%><p>No CSAT responses yet.</p><%}%><% surveys.forEach(s=>{%><article class="catalog-row"><div><strong><%=s.rating%>/5</strong><small>Ticket <%=s.ticketPublicId%> · <%=s.comment||'No comment'%></small></div></article><%})%></section></div>
</main><script src="/image-fallback.js"></script></body></html>
