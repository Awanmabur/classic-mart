<!doctype html>
<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Support & Trust — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"></head>
<body data-operations-ui="true"><main class="catalog-workspace"><header class="catalog-topbar"><div><a class="brand" href="/dashboard"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p>Support &amp; trust operations</p></div><div class="catalog-actions"><% if(canSupport){ %><a class="outline-button" href="/finance">Finance</a><a class="outline-button" href="/operations/support/ai">Support AI</a><% } %><a class="outline-button" href="/dashboard">Dashboard</a></div></header>
<section class="catalog-page-head panel"><div><span class="eyebrow">Buyer protection operations</span><h1><%= canSupport&&canTrust?'Support & trust':canSupport?'Support operations':'Trust & moderation' %></h1><p>Every queue shown here is capability- and country-scoped. Support operators cannot perform moderation actions, and moderators cannot operate customer returns or tickets.</p></div></section>

<% if(canSupport){ %>
<section class="panel"><div class="role-panel-head"><div><h2>Return queue</h2><p>Approve eligibility, receive returned goods, inspect them, then hand refunds to finance or create a real replacement order.</p></div></div><% if(!returns.length){%><p>No return requests.</p><%}%>
<% returns.forEach(r=>{%><article class="catalog-row"><div><strong><%=r.publicId%> · <%=r.orderPublicId%></strong><small><%=r.reason%> · <%=r.resolution%> · <%=r.returnMethod%> · <%=r.status%></small><% if(r.returnShipmentPublicId){ %><small>Return shipment: <%=r.returnShipmentPublicId%></small><% } %><% if(r.replacementOrderPublicId){ %><small>Replacement: <%=r.replacementOrderPublicId%></small><% } %><% if(r.evidenceDocumentIds?.length){ %><small>Customer evidence: <% r.evidenceDocumentIds.forEach((e,idx)=>{ %><%=idx?' · ':''%><a href="/evidence/<%=e.publicId%>"><%=e.description||e.publicId%></a><% }) %></small><% } %><% const sellerCases=(sellerCasesByReturn||{})[r.publicId]||[]; if(sellerCases.length){%><div class="server-detail-list"><strong>Seller responses</strong><% sellerCases.forEach(sc=>{%><p><span><%=sc.storePublicId%> · <%=sc.status%></span><strong><%=sc.responseMessage||'No seller note yet'%></strong></p><% if(sc.evidenceDocumentIds?.length){%><small>Private seller evidence: <% sc.evidenceDocumentIds.forEach((e,idx)=>{%><%=idx?' · ':''%><a href="/evidence/<%=e.publicId%>"><%=e.description||e.publicId%></a><%})%></small><%}%><%})%></div><%}%></div><div class="catalog-actions">
<% if(r.status==='requested'){%><form method="post" action="/operations/support/returns/<%=r.publicId%>/decision"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="decision" value="approve"><input name="note" placeholder="Approval note"><button type="submit">Approve</button></form><form method="post" action="/operations/support/returns/<%=r.publicId%>/decision"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="decision" value="reject"><input name="note" required placeholder="Rejection reason"><button class="outline-button" type="submit">Reject</button></form><%}%>
<% if(['approved','awaiting_return'].includes(r.status)){%><form method="post" action="/operations/support/returns/<%=r.publicId%>/received"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="note" placeholder="Receipt / condition note"><button type="submit">Mark received</button></form><%}%>
<% if(r.status==='received'){%><form method="post" action="/operations/support/returns/<%=r.publicId%>/inspect"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="condition"><option value="unopened">Unopened</option><option value="good">Good</option><option value="damaged">Damaged</option><option value="wrong_item">Wrong item</option><option value="counterfeit_suspected">Counterfeit suspected</option><option value="missing_parts">Missing parts</option></select><input name="notes" placeholder="Inspection notes"><button type="submit">Record inspection</button></form><%}%>
<% if(r.status==='refund_pending'){ %><span class="status-chip">Finance refund required</span><% } %>
<% if(r.status==='exchange_pending'){%><form method="post" action="/operations/support/returns/<%=r.publicId%>/exchange-complete"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Create replacement order</button></form><%}%>
</div></article><%})%><% if(queuePages?.returns){%><div class="server-pager"><small>Showing <%=queuePages.returns.count%> of <%=queuePages.returns.total%> returns</small><% if(queuePages.returns.hasMore){%><a class="outline-button" href="/operations/support?returnsAfter=<%=encodeURIComponent(queuePages.returns.next)%>">Older returns</a><%}%></div><%}%></section>

<section class="panel"><div class="role-panel-head"><div><h2>Disputes</h2><p>Every update becomes part of the customer-visible dispute timeline.</p></div></div><% if(!disputes.length){%><p>No disputes.</p><%}%><% disputes.forEach(d=>{%><article class="catalog-row"><div><strong><%=d.subject%></strong><small><%=d.publicId%> · <%=d.category%> · <%=d.status%></small><% if(d.evidenceDocumentIds?.length){%><small>Evidence: <% d.evidenceDocumentIds.forEach((e,idx)=>{%><%=idx?' · ':''%><a href="/evidence/<%=e.publicId%>"><%=e.description||e.publicId%></a><%})%></small><%}%></div><form method="post" action="/operations/support/disputes/<%=d.publicId%>/status"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="status"><option value="investigating">Investigating</option><option value="awaiting_customer">Awaiting customer</option><option value="awaiting_seller">Awaiting seller</option><option value="resolved">Resolved</option><option value="rejected">Rejected</option><option value="closed">Closed</option></select><input name="message" required placeholder="Timeline update"><button type="submit">Update</button></form></article><%})%><% if(queuePages?.disputes){%><div class="server-pager"><small>Showing <%=queuePages.disputes.count%> of <%=queuePages.disputes.total%> disputes</small><% if(queuePages.disputes.hasMore){%><a class="outline-button" href="/operations/support?disputesAfter=<%=encodeURIComponent(queuePages.disputes.next)%>">Older disputes</a><%}%></div><%}%></section>

<section class="panel"><div class="role-panel-head"><div><h2>Support SLA queue</h2><p>Tickets have explicit ownership, country-safe queues and searchable SLA controls. Open the ticket workspace for transfer, collision warnings, macros, merge and full order/payment/shipment context.</p></div></div>
<form class="catalog-form" method="get" action="/operations/support"><label>Search<input name="ticketSearch" maxlength="80" value="<%=ticketFilters?.search||''%>" placeholder="Ticket, subject, order or requester"></label><label>Status<select name="ticketStatus"><option value="">All statuses</option><% ['open','in_progress','waiting_customer','escalated','resolved','closed'].forEach(v=>{%><option value="<%=v%>" <%=ticketFilters?.status===v?'selected':''%>><%=v.replaceAll('_',' ')%></option><%})%></select></label><label>Priority<select name="ticketPriority"><option value="">All priorities</option><% ['urgent','high','normal','low'].forEach(v=>{%><option value="<%=v%>" <%=ticketFilters?.priority===v?'selected':''%>><%=v%></option><%})%></select></label><label>Queue<select name="ticketQueue"><option value="">All queues</option><% ['general','orders','payments','delivery','returns','accounts','seller'].forEach(v=>{%><option value="<%=v%>" <%=ticketFilters?.queue===v?'selected':''%>><%=v%></option><%})%></select></label><label>Assignment<select name="ticketAssignment"><option value="">Anyone</option><option value="mine" <%=ticketFilters?.assignment==='mine'?'selected':''%>>Mine</option><option value="unassigned" <%=ticketFilters?.assignment==='unassigned'?'selected':''%>>Unassigned</option></select></label><label><input type="checkbox" name="ticketOverdue" value="1" <%=ticketFilters?.overdue?'checked':''%>> Overdue only</label><div class="catalog-actions"><button type="submit">Filter tickets</button><a class="outline-button" href="/operations/support">Clear</a></div></form>
<% if(!tickets.length){%><p>No support tickets match this view.</p><%}%><% tickets.forEach(t=>{ const overdue=!['resolved','closed'].includes(t.status)&&new Date(t.slaDueAt)<new Date(); %><article class="catalog-row"><div><strong><%=t.publicId%> · <%=t.subject%></strong><small><%=t.queue||'general'%> · <%=t.priority%> · <%=t.status%> · <%=overdue?'SLA OVERDUE':'SLA'%> <%=formatDate(t.slaDueAt)%></small><small>Assigned: <%=t.assignedUserId?.name||'Unassigned'%><% if(t.assignedAt){%> · <%=formatDate(t.assignedAt)%><%}%></small><% const requester=ticketRequesters?.[t.publicId]; if(requester?.name||requester?.email){ %><small>Requester: <%=requester.name||'Guest'%><% if(requester.email){ %> · <%=requester.email%><% } %></small><% } %><% if(t.mergedIntoPublicId){%><small>Merged into <%=t.mergedIntoPublicId%></small><%}%><% if(t.evidenceDocumentIds?.length){%><small>Evidence: <% t.evidenceDocumentIds.forEach((e,idx)=>{%><%=idx?' · ':''%><a href="/evidence/<%=e.publicId%>"><%=e.description||e.publicId%></a><%})%></small><%}%></div><div class="catalog-actions"><a class="outline-button" href="/operations/support/tickets/<%=t.publicId%>">Open workspace</a><% const assignedId=String(t.assignedUserId?._id||t.assignedUserId||''); const actorId=String(user?._id||''); const ticketSupervisor=['country_admin','super_admin'].includes(user?.role); %><% if(!t.assignedUserId&&!['resolved','closed'].includes(t.status)){%><form method="post" action="/operations/support/tickets/<%=t.publicId%>/claim"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Claim</button></form><%}else if(t.assignedUserId&&!['resolved','closed'].includes(t.status)&&(assignedId===actorId||ticketSupervisor)){%><form method="post" action="/operations/support/tickets/<%=t.publicId%>/release"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit">Release</button></form><%}%></div></article><%})%><% if(queuePages?.tickets){%><div class="server-pager"><small>Showing <%=queuePages.tickets.count%> of <%=queuePages.tickets.total%> tickets by SLA deadline</small><% if(queuePages.tickets.hasMore){ const q=ticketFilters||{}; %><a class="outline-button" href="/operations/support?ticketsAfter=<%=encodeURIComponent(queuePages.tickets.next)%>&ticketSearch=<%=encodeURIComponent(q.search||'')%>&ticketStatus=<%=encodeURIComponent(q.status||'')%>&ticketPriority=<%=encodeURIComponent(q.priority||'')%>&ticketQueue=<%=encodeURIComponent(q.queue||'')%>&ticketAssignment=<%=encodeURIComponent(q.assignment||'')%><%=q.overdue?'&ticketOverdue=1':''%>">Next SLA page</a><%}%></div><%}%></section>

<section class="panel"><div class="role-panel-head"><div><h2>Saved support replies</h2><p>Country-scoped macros are reusable from the ticket workspace and remain auditable when applied.</p></div></div><form method="post" action="/operations/support/macros" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Country<input name="country" minlength="2" maxlength="2" required placeholder="UG"></label><label>Title<input name="title" minlength="2" maxlength="120" required></label><label>Category<select name="category"><option value="">All categories</option><% ['order','payment','delivery','return','refund','account','product','seller','other'].forEach(v=>{%><option value="<%=v%>"><%=v%></option><%})%></select></label><label>Reply<textarea name="body" minlength="3" maxlength="4000" required></textarea></label><button type="submit">Save reply</button></form><div class="catalogue-stack"><% (macros||[]).forEach(m=>{%><article class="catalog-row"><div><strong><%=m.title%></strong><small><%=m.country%> · <%=m.category||'all categories'%></small><p><%=m.body%></p></div><form method="post" action="/operations/support/macros/<%=m.publicId%>/archive"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit">Archive</button></form></article><%})%><% if(!(macros||[]).length){%><p>No saved replies in scope.</p><%}%></div><% if(queuePages?.macros){%><div class="server-pager"><small>Showing <%=queuePages.macros.count%> of <%=queuePages.macros.total%> macros</small><% if(queuePages.macros.hasMore){%><a class="outline-button" href="/operations/support?macrosAfter=<%=encodeURIComponent(queuePages.macros.next)%>">Older macros</a><%}%></div><%}%></section>

<div class="role-content-grid"><section class="panel"><div class="role-panel-head"><div><h2>Knowledge base</h2><p>Published country-scoped articles feed customer help endpoints.</p></div></div><form method="post" action="/operations/support/knowledge" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Country (Super Admin only)<input name="country" maxlength="2"></label><label>Title<input name="title" minlength="4" maxlength="180" required></label><label>Slug<input name="slug" minlength="3" maxlength="180" required></label><label>Category<input name="category" minlength="2" maxlength="80" required></label><label>Body<textarea name="body" minlength="20" maxlength="12000" required></textarea></label><label>Status<select name="status"><option value="draft">Draft</option><option value="published">Published</option></select></label><button type="submit">Save article</button></form><div class="table-wrap"><table><thead><tr><th>Article</th><th>Country</th><th>Status</th></tr></thead><tbody><% if(!knowledge.length){%><tr><td colspan="3">No articles.</td></tr><%}%><% knowledge.forEach(k=>{%><tr><td><%=k.title%><br><small><%=k.slug%></small></td><td><%=k.country%></td><td><%=k.status%></td></tr><%})%></tbody></table></div><% if(queuePages?.knowledge){%><div class="server-pager"><small>Showing <%=queuePages.knowledge.count%> of <%=queuePages.knowledge.total%> articles</small><% if(queuePages.knowledge.hasMore){%><a class="outline-button" href="/operations/support?knowledgeAfter=<%=encodeURIComponent(queuePages.knowledge.next)%>">Older articles</a><%}%></div><%}%></section>
<section class="panel"><div class="role-panel-head"><div><h2>Support satisfaction</h2><p>Customer ratings measure support quality after resolution.</p></div></div><% if(!surveys.length){%><p>No CSAT responses yet.</p><%}%><% surveys.forEach(s=>{%><article class="catalog-row"><div><strong><%=s.rating%>/5</strong><small>Ticket <%=s.ticketPublicId%> · <%=s.comment||'No comment'%></small></div></article><%})%><% if(queuePages?.surveys){%><div class="server-pager"><small>Showing <%=queuePages.surveys.count%> of <%=queuePages.surveys.total%> responses</small><% if(queuePages.surveys.hasMore){%><a class="outline-button" href="/operations/support?surveysAfter=<%=encodeURIComponent(queuePages.surveys.next)%>">Older responses</a><%}%></div><%}%></section></div>
<% } %>

<% if(canTrust){ %>
<section class="panel"><div class="role-panel-head"><div><h2>Trust cases</h2><p>Counterfeit, prohibited-product, unsafe-product and manipulation investigations.</p></div></div><% if(!cases.length){%><p>No trust cases.</p><%}%><% cases.forEach(c=>{%><article class="catalog-row"><div><strong><%=c.type%></strong><small><%=c.publicId%> · <%=c.status%> · <%=c.productPublicId||c.storePublicId||''%></small><% if(c.evidenceDocumentIds?.length){%><small>Evidence: <% c.evidenceDocumentIds.forEach((e,idx)=>{%><%=idx?' · ':''%><a href="/evidence/<%=e.publicId%>"><%=e.description||e.publicId%></a><%})%></small><%}%></div><form method="post" action="/operations/support/trust/<%=c.publicId%>/status"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="status"><option value="investigating">Investigating</option><option value="actioned">Actioned</option><option value="dismissed">Dismissed</option><option value="closed">Closed</option></select><select name="enforcement"><option value="none">No enforcement</option><option value="suspend_product">Suspend product</option><option value="restore_product">Restore product</option><option value="suspend_store">Suspend store</option><option value="restore_store">Restore store</option></select><input name="decision" required placeholder="Decision, evidence and enforcement reason"><button type="submit">Update</button></form></article><%})%><% if(queuePages?.cases){%><div class="server-pager"><small>Showing <%=queuePages.cases.count%> of <%=queuePages.cases.total%> trust cases</small><% if(queuePages.cases.hasMore){%><a class="outline-button" href="/operations/support?casesAfter=<%=encodeURIComponent(queuePages.cases.next)%>">Older cases</a><%}%></div><%}%></section>
<div class="role-content-grid"><section class="panel"><div class="role-panel-head"><div><h2>Verified-delivery review moderation</h2><p>Pending and seller-disputed reviews remain subject to evidence-based moderation.</p></div></div><% if(!reviews.length){%><p>No reviews in moderation.</p><%}%><% reviews.forEach(r=>{%><article class="catalog-row"><div><strong><%=r.productPublicId%> · <%=r.rating%>/5</strong><small><%=r.publicId%> · <%=r.status%> · verified delivery<% if(r.disputeReason){%> · seller dispute: <%=r.disputeReason%><%}%></small></div><% if(['pending','disputed'].includes(r.status)){%><form method="post" action="/operations/support/reviews/<%=r.publicId%>/moderate"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="decision"><option value="publish">Publish / uphold</option><option value="reject">Reject / remove</option></select><input name="reason" placeholder="Moderation reason"><button type="submit">Apply</button></form><%}%></article><%})%><% if(queuePages?.reviews){%><div class="server-pager"><small>Showing <%=queuePages.reviews.count%> of <%=queuePages.reviews.total%> reviews</small><% if(queuePages.reviews.hasMore){%><a class="outline-button" href="/operations/support?reviewsAfter=<%=encodeURIComponent(queuePages.reviews.next)%>">Older reviews</a><%}%></div><%}%></section>
<section class="panel"><div class="role-panel-head"><div><h2>Risk signals</h2><p>Signals assist triage; human operators record the final decision.</p></div></div><% if(!risks.length){%><p>No risk signals.</p><%}%><% risks.forEach(r=>{%><article class="catalog-row"><div><strong><%=r.type%> · <%=r.severity%></strong><small><%=r.publicId%> · <%=r.subjectType%> <%=r.subjectPublicId%> · score <%=r.score%> · <%=r.status%></small></div><% if(r.status==='open'){%><form method="post" action="/operations/support/risks/<%=r.publicId%>/review"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="status"><option value="reviewed">Reviewed</option><option value="actioned">Actioned</option><option value="dismissed">Dismissed</option></select><input name="decision" required placeholder="Decision"><button type="submit">Record review</button></form><%}%></article><%})%><% if(queuePages?.risks){%><div class="server-pager"><small>Showing <%=queuePages.risks.count%> of <%=queuePages.risks.total%> risk signals</small><% if(queuePages.risks.hasMore){%><a class="outline-button" href="/operations/support?risksAfter=<%=encodeURIComponent(queuePages.risks.next)%>">Older signals</a><%}%></div><%}%></section></div>
<% } %>
</main><script src="/image-fallback.js"></script><script src="/operations-ui.js" defer></script></body></html>
