<!doctype html>
<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="robots" content="noindex,nofollow">
  <% const snap=document.snapshot||{}, body=snap.quotation||snap.purchaseOrder||snap.invoice||snap.delivery||{}, titles={quotation:'Quotation',purchase_order:'Purchase order',tax_invoice:'Tax invoice',delivery_note:'Delivery note'}; const title=titles[document.type]||'Business document'; %>
  <title><%=title%> <%=document.documentNumber%> — Classic Mart</title>
  <link rel="stylesheet" href="/dashboard.css">
  <link rel="stylesheet" href="/dashboard-workspaces.css">
  <style>
    .doc-page{max-width:980px;margin:30px auto;padding:0 16px}.doc-card{background:#fff;border:1px solid #e1e6ee;border-radius:22px;padding:24px}.doc-head,.doc-row{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}.doc-meta{color:#667085}.doc-number{font-family:ui-monospace,monospace}.doc-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:20px 0}.doc-party{border:1px solid #e5e7eb;border-radius:14px;padding:14px}.doc-table{width:100%;border-collapse:collapse;margin:20px 0}.doc-table th,.doc-table td{text-align:left;padding:11px 8px;border-bottom:1px solid #eceff3;vertical-align:top}.doc-table th:last-child,.doc-table td:last-child{text-align:right}.doc-totals{max-width:420px;margin-left:auto}.doc-row{padding:6px 0}.doc-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.doc-actions a,.doc-actions button{border-radius:999px}.integrity{word-break:break-all;font-family:ui-monospace,monospace;font-size:.82rem}.legacy{padding:11px 13px;border:1px solid #e5c36c;border-radius:12px;background:#fffaf0}@media(max-width:680px){.doc-head{display:block}.doc-grid{grid-template-columns:1fr}.doc-card{padding:16px}.doc-table{font-size:.9rem}.doc-table th:nth-child(2),.doc-table td:nth-child(2){display:none}}@media print{.doc-actions{display:none}.doc-page{margin:0;max-width:none}.doc-card{border:0;padding:0}}
  </style>
</head>
<body><main class="doc-page"><article class="doc-card" aria-labelledby="docTitle">
  <header class="doc-head"><div><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"><h1 id="docTitle"><%=title%></h1><p class="doc-number"><%=document.documentNumber%></p></div><div class="doc-meta"><p>Issued <strong><%=formatDate(document.issuedAt)%></strong></p><p><%=document.country%> · <%=document.currency%></p><%if(document.type==='quotation'){%><p>Revision <strong><%=document.revision%></strong></p><%}%></div></header>
  <%if(document.legacySnapshot){%><p class="legacy"><strong>Legacy snapshot.</strong> This document was reconstructed only from the latest verifiable historical state retained before immutable document issuance was introduced. Earlier quotation revisions were not invented.</p><%}%>
  <section class="doc-grid" aria-label="Buyer and seller"><div class="doc-party"><strong>Buyer</strong><p><%=snap.buyer?.companyName||''%></p><small><%=snap.buyer?.billingContactName||''%><%if(snap.buyer?.billingEmail){%> · <%=snap.buyer.billingEmail%><%}%><br><%=snap.buyer?.billingAddress||''%> <%=snap.buyer?.billingCity||''%> <%=snap.buyer?.country||''%></small></div><div class="doc-party"><strong>Seller</strong><p><%=snap.seller?.name||''%></p><small>Store <%=snap.seller?.publicId||''%> · <%=snap.seller?.country||''%></small></div></section>
  <div class="doc-meta"><%if(body.poNumber){%>PO <strong><%=body.poNumber%></strong> · <%}%><%if(body.invoiceNumber){%>Invoice <strong><%=body.invoiceNumber%></strong> · <%}%><%if(body.orderPublicId){%>Order <strong><%=body.orderPublicId%></strong> · <%}%><%if(body.shipmentPublicId){%>Shipment <strong><%=body.shipmentPublicId%></strong><%}%><%if(body.validUntil){%><p>Valid until <%=formatDate(body.validUntil)%></p><%}%><%if(body.paymentTerms){%><p>Payment terms: <%=body.paymentTerms%><%if(body.termsDays){%> · <%=body.termsDays%> days<%}%></p><%}%></div>
  <table class="doc-table"><thead><tr><th>Item</th><th>SKU</th><th>Qty</th><th>Total</th></tr></thead><tbody><%(body.items||[]).forEach(item=>{%><tr><td><strong><%=item.title%></strong><br><small><%=item.variantTitle||''%></small></td><td><%=item.sku%></td><td><%=item.deliveredQuantity??item.quantity%></td><td><%=formatMoney(item.lineMinor||0,document.currency)%></td></tr><%})%></tbody></table>
  <section class="doc-totals" aria-label="Document totals"><%if(body.subtotalMinor!==undefined){%><div class="doc-row"><span>Subtotal</span><span><%=formatMoney(body.subtotalMinor,document.currency)%></span></div><%}%><%if(body.taxMinor!==undefined){%><div class="doc-row"><span>Tax (<%=body.taxBps||0%> bps)</span><span><%=formatMoney(body.taxMinor,document.currency)%></span></div><%}%><%if(body.shippingMinor!==undefined){%><div class="doc-row"><span>Shipping</span><span><%=formatMoney(body.shippingMinor,document.currency)%></span></div><%}%><div class="doc-row"><strong>Total</strong><strong><%=formatMoney(body.totalMinor??body.offeredTotalMinor??document.amountMinor,document.currency)%></strong></div></section>
  <%if(body.deliveredAt){%><p class="doc-meta">Verified delivery: <%=formatDate(body.deliveredAt)%><%if(body.proofType){%> · proof <%=body.proofType%><%}%></p><%}%>
  <p class="doc-meta">Immutable snapshot SHA-256</p><p class="integrity"><%=document.snapshotDigest%></p>
  <div class="doc-actions"><a class="primary" href="/business/documents/<%=encodeURIComponent(document.publicId)%>.pdf">Download PDF</a><button type="button" onclick="window.print()">Print</button><a class="outline-button" href="/business#documents">Back to company documents</a></div>
</article></main></body></html>
