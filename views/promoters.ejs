<!DOCTYPE html>

<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<meta content="Browse, search and filter products across Classic Mart categories." name="description"/>
<meta content="#ff6200" name="theme-color"/>
<title>Promoters Center — Classic Mart</title>
<link href="/styles.css" rel="stylesheet"/>
<link href="/storefront-pages.css" rel="stylesheet"/>
<link href="/marketplace-pages.css" rel="stylesheet"/>
<link href="/people-pages.css" rel="stylesheet"/>
</head>
<body class="people-body" data-directory-type="promoters">
<a class="skip-link" href="#catalogMain">Skip to directory</a><%- include("partials/storefront-header") %>
<main class="people-main" id="catalogMain">
<section class="people-hero"><div class="container"><nav aria-label="Breadcrumb" class="catalog-breadcrumb"><a href="/">Home</a><span>›</span><strong>Promoters Center</strong></nav><div class="people-hero-grid"><div class="people-hero-copy"><span>Creator marketplace</span><h1>Promoters Center</h1><p>Discover trusted creators, shopping experts and curated product recommendations across Classic Mart.</p></div><div class="people-hero-stats"><span><strong id="directoryStatCount">—</strong><small>Verified profiles</small></span><span><strong id="directoryStatPrimary">—</strong><small>Active campaigns</small></span><span><strong id="directoryStatSecondary">—</strong><small>Conversions</small></span></div></div></div></section>
<section class="container people-workspace"><form class="people-toolbar" id="peopleSearchForm"><label><img alt="" src="/assets/icons/magnifying-glass.svg"/><input id="peopleQuery" placeholder="Search promoters, specialties or categories" type="search"/></label><label><select id="peopleSort"><option value="featured">Featured</option><option value="rating">Highest rated</option><option value="name">Name A–Z</option></select></label><button type="submit">Search</button></form><p class="people-count" id="peopleCount">Loading promoters…</p><div class="people-grid" id="peopleGrid"></div><button class="outline-button" id="peopleLoadMore" type="button" hidden>Load more</button><div class="people-empty" hidden="" id="peopleEmpty"><h2>No matching promoters</h2><p>Try another name, category or specialty.</p></div></section>
</main>
<div class="catalog-filter-backdrop" hidden="" id="catalogFilterBackdrop"></div>
<div aria-live="polite" class="page-toast" id="catalogToast" role="status"></div>
<section class="newsletter">
<div class="container newsletter-inner">
<div class="newsletter-message"><span><img alt="" src="/assets/icons/envelope.svg"/></span><div><strong>Stay in the Loop!</strong><small>Get exclusive deals, new arrivals and shopping tips.</small></div></div>
<form class="newsletter-form" data-newsletter-form id="newsletterForm" novalidate>
<label class="sr-only" for="newsletterEmail">Email address</label>
<input autocomplete="email" id="newsletterEmail" maxlength="254" name="email" placeholder="Enter your email address" required type="email"/>
<button type="submit">Subscribe</button>
<p aria-live="polite" class="newsletter-status" data-newsletter-status></p>
</form>
<div class="newsletter-perks"><span><img alt="" src="/assets/icons/percent.svg"/><b>Exclusive Deals</b></span><span><img alt="" src="/assets/icons/gift.svg"/><b>New Arrivals</b></span><span><img alt="" src="/assets/icons/location-dot.svg"/><b>Shopping Tips</b></span></div>
</div>
</section><%- include("partials/storefront-footer") %><script src="/cart-store.js"></script>
<script src="/people-page.js"></script>
<script src="/shared-shell.js"></script><script src="/image-fallback.js"></script><script src="/country-switcher.js"></script><script src="/search-tools.js"></script><script src="/newsletter.js"></script></body>
</html>
