<!doctype html><html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Admin Operations — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"><style>.admin-nav{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 18px}.admin-nav a{border:1px solid #d9e0e8;border-radius:999px;padding:8px 12px;text-decoration:none;color:inherit;background:#fff}.admin-nav a.active{background:#1165df;color:#fff;border-color:#1165df}.admin-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.admin-stat{padding:18px}.admin-stat strong{display:block;font-size:28px;margin-top:5px}.admin-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.admin-stack{display:grid;gap:12px}.admin-form{display:grid;gap:12px}.admin-form label{display:grid;gap:6px}.admin-form input,.admin-form textarea,.admin-form select{width:100%;box-sizing:border-box;border:1px solid #d8dee8;border-radius:12px;padding:10px 12px;background:#fff}.admin-checks{display:flex;gap:12px;flex-wrap:wrap}.admin-checks label{display:flex;gap:6px;align-items:center}.admin-checks input{width:auto}.admin-card{border:1px solid #e0e5ec;border-radius:16px;padding:14px;background:#fff}.admin-meta{color:#667085;font-size:13px}.admin-badge{display:inline-flex;border:1px solid #d9e0e8;border-radius:999px;padding:4px 8px;font-size:12px}.admin-badge.good{background:#ecfdf3;color:#067647}.admin-badge.warn{background:#fffaeb;color:#b54708}.admin-badge.bad{background:#fef3f2;color:#b42318}.admin-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:end}.admin-actions form{margin:0}.admin-danger{border-color:#fda29b!important;color:#b42318!important}.admin-code{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;word-break:break-all}@media(max-width:900px){.admin-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-two{grid-template-columns:1fr}}@media(max-width:560px){.admin-grid{grid-template-columns:1fr}}</style></head><body><main class="catalog-workspace"><header class="catalog-topbar"><div><a class="brand" href="/dashboard"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p><%= user.role==='super_admin'?'Super Admin':'Country Admin' %> operations</p></div><div class="catalog-actions"><a class="outline-button" href="/dashboard">Dashboard</a><a class="outline-button" href="/">Marketplace</a></div></header><section class="catalog-page-head panel"><div><span class="eyebrow">Platform control plane</span><h1>Admin, CMS, analytics &amp; growth</h1><p><%= user.role==='country_admin' ? `All operations are restricted to ${user.country}.` : 'Global operations with explicit country scoping and four-eyes controls.' %></p></div></section><nav class="admin-nav"><a class="<%=section==='attention'?'active':''%>" href="/admin">Attention</a><a class="<%=section==='countries'?'active':''%>" href="/admin/countries">Countries</a><a class="<%=section==='business'?'active':''%>" href="/admin/business">Business buyers</a><a class="<%=section==='features'?'active':''%>" href="/admin/features">Feature flags</a><a class="<%=section==='cms'?'active':''%>" href="/admin/cms">CMS</a><a class="<%=section==='approvals'?'active':''%>" href="/admin/approvals">Approvals</a><a class="<%= ['growth','gift-card-detail'].includes(section)?'active':'' %>" href="/admin/growth">Growth</a><a class="<%=section==='reports'?'active':''%>" href="/admin/reports">Reports</a><a class="<%=section==='exports'?'active':''%>" href="/admin/exports">Exports</a><a class="<%=section==='incidents'?'active':''%>" href="/admin/incidents">Incidents</a><a class="<%=section==='security'?'active':''%>" href="/admin/security">Security &amp; Launch</a><a class="<%=section==='health'?'active':''%>" href="/admin/health">Platform health</a><a class="<%=section==='impersonation'?'active':''%>" href="/admin/impersonation">Impersonation</a><a href="/admin/ai">Classic AI</a></nav><% if(flash){%><div class="server-flash <%=flash.type%>"><strong><%=flash.message%></strong></div><%}%>

<% if(section==='attention'){%><div class="admin-grid"><% Object.entries(counts).forEach(([key,value])=>{%><section class="panel admin-stat"><span class="eyebrow"><%=key.replaceAll('_',' ')%></span><strong><%=value%></strong></section><%})%></div><section class="panel"><div class="role-panel-head"><div><h2>Recent high-risk requests</h2><p>Country settings, feature rollout, content publication, exports, gift cards and impersonation all flow through approval.</p></div><a class="outline-button" href="/admin/approvals">Open approval centre</a></div><div class="table-wrap"><table><thead><tr><th>Request</th><th>Type</th><th>Country</th><th>Requester</th><th>Status</th></tr></thead><tbody><% if(!recentApprovals.length){%><tr><td colspan="5">No approval requests.</td></tr><%}%><% recentApprovals.forEach(a=>{%><tr><td><%=a.publicId%><br><small><%=formatDate(a.createdAt)%></small></td><td><%=a.type.replaceAll('_',' ')%></td><td><%=a.country||'Global'%></td><td><%=a.requestedByUserId?.name||'—'%></td><td><span class="admin-badge <%=a.status==='applied'?'good':a.status==='requested'?'warn':a.status==='rejected'?'bad':''%>"><%=a.status%></span></td></tr><%})%></tbody></table></div></section><%}%>


<% if(section==='business'){%><section class="panel"><div class="role-panel-head"><div><h2>Business buyer risk & invoice terms</h2><p>Invoice terms and credit limits require a reason and four-eyes approval before purchase orders can be issued.</p></div></div><div class="admin-stack"><% if(!organizations.length){%><p>No business organizations yet.</p><%}%><% organizations.forEach(o=>{%><article class="admin-card"><strong><%=o.companyName%></strong><p><%=o.country%> · owner <%=o.ownerUserId?.name||'—'%> · <%=o.status%></p><small>Invoice terms: <%=o.invoiceTermsApproved?`${o.invoiceTermsDays} days · credit ${o.creditLimitMinor}`:'not approved'%></small><form class="admin-form" method="post" action="/admin/business/<%=o.publicId%>/request-terms"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><div class="admin-checks"><label><input type="checkbox" name="approved" <%=o.invoiceTermsApproved?'checked':''%>> Approve invoice terms</label></div><label>Invoice terms days<input type="number" min="0" max="120" name="invoiceTermsDays" value="<%=o.invoiceTermsDays||30%>"></label><label>Credit limit (minor units)<input type="number" min="0" name="creditLimitMinor" value="<%=o.creditLimitMinor||0%>"></label><label>Risk reason<textarea name="reason" minlength="3" required></textarea></label><button type="submit">Send for approval</button></form></article><%})%></div></section><%}%>

<% if(section==='countries'){%><div class="admin-stack"><% countries.forEach(c=>{%><section class="panel"><div class="role-panel-head"><div><h2><%=c.name%> (<%=c.code%>)</h2><p><%=c.currency%> · <%=c.locale%> · <%=c.timeZone%></p></div><span class="admin-badge <%=c.active?'good':'bad'%>"><%=c.active?'active':'inactive'%></span></div><form method="post" action="/admin/countries/<%=c.code%>/request-update" class="admin-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><div class="admin-two"><label>Tax (basis points)<input type="number" name="taxBps" min="0" max="10000" value="<%=c.taxBps%>"></label><label>Platform fee (basis points)<input type="number" name="platformFeeBps" min="0" max="5000" value="<%=c.platformFeeBps%>"></label><label>Free standard shipping threshold (minor units)<input type="number" min="0" name="freeStandardShippingThresholdMinor" value="<%=c.freeStandardShippingThresholdMinor%>"></label><label>Return window days<input type="number" min="0" max="365" name="returnWindowDays" value="<%=c.returnWindowDays%>"></label><label>Standard SLA hours<input type="number" min="1" max="720" name="defaultStandardSlaHours" value="<%=c.delivery?.defaultStandardSlaHours||72%>"></label><label>Express SLA hours<input type="number" min="1" max="720" name="defaultExpressSlaHours" value="<%=c.delivery?.defaultExpressSlaHours||24%>"></label><label>Loyalty points per 1,000 minor units<input type="number" min="0" name="loyaltyPointsPer1000Minor" value="<%=c.growth?.loyaltyPointsPer1000Minor??1%>"></label><label>Referral reward points<input type="number" min="0" name="referralRewardPoints" value="<%=c.growth?.referralRewardPoints??100%>"></label></div><div class="admin-checks"><label><input type="checkbox" name="active" <%=c.active?'checked':''%>>Country active</label><label><input type="checkbox" name="card" <%=c.payments?.card?'checked':''%>>Cards</label><label><input type="checkbox" name="mobile" <%=c.payments?.mobile?'checked':''%>>Mobile money</label><label><input type="checkbox" name="cod" <%=c.payments?.cod?'checked':''%>>COD</label><label><input type="checkbox" name="standardEnabled" <%=c.delivery?.standardEnabled!==false?'checked':''%>>Standard delivery</label><label><input type="checkbox" name="expressEnabled" <%=c.delivery?.expressEnabled!==false?'checked':''%>>Express</label><label><input type="checkbox" name="pickupEnabled" <%=c.delivery?.pickupEnabled!==false?'checked':''%>>Pickup</label><label><input type="checkbox" name="loyaltyEnabled" <%=c.growth?.loyaltyEnabled!==false?'checked':''%>>Loyalty</label><label><input type="checkbox" name="referralEnabled" <%=c.growth?.referralEnabled!==false?'checked':''%>>Referrals</label><label><input type="checkbox" name="giftCardsEnabled" <%=c.growth?.giftCardsEnabled!==false?'checked':''%>>Gift cards</label></div><label>Reason for change<textarea name="reason" required minlength="3" maxlength="1000"></textarea></label><button type="submit">Send for approval</button></form></section><%})%></div><%}%>

<% if(section==='features'){%><div class="admin-two"><section class="panel"><h2>Request feature rollout</h2><form class="admin-form" method="post" action="/admin/features/request"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Key<input name="key" required placeholder="checkout.new_flow"></label><label>Description<textarea name="description" maxlength="500"></textarea></label><label>Countries (comma separated)<input name="countries" value="<%=user.role==='country_admin'?user.country:''%>" <%=user.role==='country_admin'?'readonly':''%>></label><label>Roles (comma separated)<input name="roles" placeholder="customer,business"></label><label>Rollout percentage<input type="number" min="0" max="100" name="rolloutPercentage" value="100"></label><div class="admin-two"><label>Starts<input type="datetime-local" name="startsAt"></label><label>Ends<input type="datetime-local" name="endsAt"></label></div><label class="admin-checks"><input type="checkbox" name="enabled"> Enabled</label><label>Reason<textarea name="reason" required minlength="3"></textarea></label><button type="submit">Send for approval</button></form></section><section class="panel"><h2>Current flags</h2><div class="admin-stack"><% if(!flags.length){%><p>No feature flags yet.</p><%}%><% flags.forEach(f=>{%><article class="admin-card"><div class="admin-actions"><strong><%=f.key%></strong><span class="admin-badge <%=f.enabled?'good':'bad'%>"><%=f.enabled?'enabled':'disabled'%></span></div><p><%=f.description||'No description'%></p><small><%=f.rolloutPercentage%>% · <%=f.countries?.length?f.countries.join(', '):'all countries'%> · <%=f.roles?.length?f.roles.join(', '):'all roles'%> · v<%=f.version%></small></article><%})%></div></section></div><%}%>

<% if(section==='cms'){%><div class="admin-two"><section class="panel"><h2>Create content revision</h2><form class="admin-form" method="post" action="/admin/cms/revision"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Key<input name="key" required placeholder="home.hero.primary"></label><label>Type<select name="type"><option value="home_module">Home module</option><option value="banner">Banner</option><option value="collection">Collection</option><option value="hero">Home hero</option><option value="press">Press article</option><option value="help">Help content</option><option value="legal">Legal content</option></select></label><label>Country<input name="country" maxlength="2" value="<%=user.role==='country_admin'?user.country:''%>" <%=user.role==='country_admin'?'readonly':''%> placeholder="Blank = global"></label><label>Placement<input name="placement" maxlength="100" placeholder="hero / help / terms"></label><label>Title<input name="title" maxlength="180"></label><label>Body<textarea name="body" maxlength="20000" rows="8"></textarea></label><label>Revision reason<textarea name="reason" required minlength="3"></textarea></label><button type="submit">Save revision</button></form></section><section class="panel"><h2>Versioned content</h2><div class="admin-stack"><% if(!content.length){%><p>No CMS content yet.</p><%}%><% content.forEach(c=>{%><article class="admin-card"><div class="admin-actions"><strong><%=c.key%></strong><span class="admin-badge <%=c.status==='published'?'good':c.status==='scheduled'?'warn':''%>"><%=c.status%></span></div><p><%=c.type%> · <%=c.country||'Global'%> · active v<%=c.activeVersion||'—'%></p><% c.revisions.slice().reverse().slice(0,4).forEach(r=>{%><div class="admin-card"><strong>v<%=r.version%> · <%=r.title||'Untitled'%></strong><small class="admin-meta"><%=formatDate(r.createdAt)%> · <%=r.reason%></small><div class="admin-actions"><form method="post" action="/admin/cms/<%=c.publicId%>/publish-request"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="version" value="<%=r.version%>"><input type="datetime-local" name="scheduledFor"><input name="reason" required minlength="3" placeholder="Publication reason"><button type="submit">Publish / schedule</button></form><% if(c.activeVersion&&c.activeVersion!==r.version){%><form method="post" action="/admin/cms/<%=c.publicId%>/rollback-request"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="version" value="<%=r.version%>"><input name="reason" required minlength="3" placeholder="Rollback reason"><button class="outline-button" type="submit">Rollback to v<%=r.version%></button></form><%}%></div></div><%})%></article><%})%></div></section></div><%}%>

<% if(section==='approvals'){%><section class="panel"><h2>Approval centre</h2><p>Requesters cannot approve or reject their own high-risk changes.</p><div class="table-wrap"><table><thead><tr><th>Request</th><th>Scope</th><th>Reason</th><th>Requester</th><th>Status / action</th></tr></thead><tbody><% if(!approvals.length){%><tr><td colspan="5">No approval requests.</td></tr><%}%><% approvals.forEach(a=>{%><tr><td><strong><%=a.type.replaceAll('_',' ')%></strong><br><small><%=a.publicId%> · <%=formatDate(a.createdAt)%></small></td><td><%=a.country||'Global'%><br><small><%=a.targetPublicId||a.targetType||'—'%></small></td><td><%=a.reason%></td><td><%=a.requestedByUserId?.name||'—'%></td><td><span class="admin-badge <%=a.status==='applied'?'good':a.status==='requested'?'warn':a.status==='rejected'?'bad':''%>"><%=a.status%></span><% if(a.status==='requested'){%><div class="admin-actions"><form method="post" action="/admin/approvals/<%=a.publicId%>/approve"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Approve & apply</button></form><form method="post" action="/admin/approvals/<%=a.publicId%>/reject"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="reason" minlength="3" required placeholder="Rejection reason"><button class="outline-button admin-danger" type="submit">Reject</button></form></div><%}%></td></tr><%})%></tbody></table></div></section><%}%>

<% if(section==='growth'){%><div class="admin-two"><section class="panel"><h2>Reward gift card issuance</h2><p>Reward gift cards require four-eyes approval and convert their country-currency value into loyalty points at the configured country reward rate. They are not represented as a card-payment tender.</p><form class="admin-form" method="post" action="/admin/growth/gift-cards/request"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Country<input name="country" maxlength="2" value="<%=user.country%>" <%=user.role==='country_admin'?'readonly':''%> required></label><label>Value (minor units)<input type="number" min="1" name="valueMinor" required></label><label>Expires<input type="date" name="expiresAt"></label><label>Note<input name="note" maxlength="500"></label><label>Reason<textarea name="reason" minlength="3" required></textarea></label><button type="submit">Request issuance</button></form></section><section class="panel"><h2>Consent-aware campaign</h2><form class="admin-form" method="post" action="/admin/growth/campaigns"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Name<input name="name" required maxlength="160"></label><label>Country<input name="country" maxlength="2" value="<%=user.role==='country_admin'?user.country:''%>" <%=user.role==='country_admin'?'readonly':''%>></label><label>Roles (comma separated)<input name="roles" placeholder="customer,business"></label><label>Subject<input name="subject" required maxlength="180"></label><label>Message<textarea name="body" required maxlength="10000" rows="6"></textarea></label><label>Scheduled time<input type="datetime-local" name="scheduledAt"></label><button type="submit">Save campaign</button></form></section></div><section class="panel"><h2>Gift cards</h2><div class="table-wrap"><table><thead><tr><th>Card</th><th>Country</th><th>Value</th><th>Status</th><th></th></tr></thead><tbody><% if(!cards.length){%><tr><td colspan="5">No approved gift cards yet.</td></tr><%}%><% cards.forEach(c=>{%><tr><td><%=c.publicId%> · ••••<%=c.codeLast4%></td><td><%=c.country%></td><td><%=c.initialValueMinor%> <%=c.currency%></td><td><%=c.status%></td><td><a class="outline-button" href="/admin/growth/gift-cards/<%=c.publicId%>">Reveal securely</a></td></tr><%})%></tbody></table></div></section><section class="panel"><h2>Campaigns</h2><div class="table-wrap"><table><thead><tr><th>Name</th><th>Scope</th><th>Status</th><th>Eligible / queued</th><th>Action</th></tr></thead><tbody><% if(!campaigns.length){%><tr><td colspan="5">No campaigns yet.</td></tr><%}%><% campaigns.forEach(c=>{%><tr><td><%=c.name%><br><small><%=c.subject%></small></td><td><%=c.country||'Global'%> · <%=c.roles?.length?c.roles.join(', '):'all roles'%></td><td><%=c.status%></td><td><%=c.eligibleCount%> / <%=c.queuedCount%></td><td><% if(['draft','scheduled'].includes(c.status)){%><form method="post" action="/admin/growth/campaigns/<%=c.publicId%>/queue"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Queue consented users</button></form><%}%></td></tr><%})%></tbody></table></div></section><div class="admin-two"><section class="panel"><h2>Top loyalty balances</h2><% if(!loyalty.length){%><p>No loyalty activity yet.</p><%}%><% loyalty.forEach(a=>{%><p><strong><%=a.userId?.name||a.publicId%></strong><br><small><%=a.points%> points · <%=a.tier%></small></p><%})%></section><section class="panel"><h2>Recent referrals</h2><% if(!referrals.length){%><p>No referrals yet.</p><%}%><% referrals.forEach(r=>{%><p><strong><%=r.referrerUserId?.name||'Member'%> → <%=r.referredUserId?.name||'Waiting'%></strong><br><small><%=r.code%> · <%=r.status%></small></p><%})%></section></div><%}%>

<% if(section==='gift-card-detail'){%><section class="panel"><span class="eyebrow">Sensitive reward gift card</span><h1>Gift card <%=card.publicId%></h1><p>Country <%=card.country%> · <%=card.initialValueMinor%> <%=card.currency%> · <%=card.status%></p><div class="admin-card"><span class="admin-meta">Full code</span><p class="admin-code"><strong><%=card.code%></strong></p></div><p>Only authorized administrators can reveal this encrypted code. The reveal route is no-store and audited.</p><a class="outline-button" href="/admin/growth">Back to growth</a></section><%}%>

<% if(section==='reports'){%><div class="admin-grid"><section class="panel admin-stat"><span>Orders</span><strong><%=report.orders.total%></strong></section><section class="panel admin-stat"><span>GMV</span><strong><%=report.orders.gmv%></strong><small><%=report.currency%></small></section><section class="panel admin-stat"><span>Verified stores</span><strong><%=report.stores.verified%>/<%=report.stores.total%></strong></section><section class="panel admin-stat"><span>Open support</span><strong><%=report.support.open%></strong><small><%=report.support.overdue%> overdue</small></section><section class="panel admin-stat"><span>Verified payments</span><strong><%=report.finance.succeededPayments%></strong><small><%=report.finance.payments%> payment records</small></section><section class="panel admin-stat"><span>Completed refunds</span><strong><%=report.finance.completedRefunds%></strong><small><%=report.finance.refunds%> refund records</small></section><section class="panel admin-stat"><span>Pending payouts</span><strong><%=report.finance.pendingPayouts%></strong><small><%=report.finance.payouts%> payout records</small></section><section class="panel admin-stat"><span>Ledger transactions</span><strong><%=report.finance.ledgerTransactions%></strong></section></div><div class="admin-two"><section class="panel"><h2>Orders by status</h2><% Object.entries(report.orders.byStatus).forEach(([k,v])=>{%><p><strong><%=k.replaceAll('_',' ')%></strong> <%=v%></p><%})%></section><section class="panel"><h2>Users by role</h2><% Object.entries(report.users.byRole).forEach(([k,v])=>{%><p><strong><%=k.replaceAll('_',' ')%></strong> <%=v%></p><%})%></section><section class="panel"><h2>Search demand</h2><% if(!report.topSearches.length){%><p>No search events yet.</p><%}%><% report.topSearches.forEach(x=>{%><p><strong><%=x.query%></strong> <%=x.count%></p><%})%></section><section class="panel"><h2>Platform health</h2><p><strong>Open incidents:</strong> <%=report.incidents.filter(i=>i.status!=='resolved').length%></p><p><strong>Approved promoters:</strong> <%=report.promoters.approved%>/<%=report.promoters.total%></p></section></div><%}%>

<% if(section==='exports'){%><div class="admin-two"><section class="panel"><h2>Request privacy-safe export</h2><form class="admin-form" method="post" action="/admin/exports/request"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Dataset<select name="type"><option value="orders">Orders (no contact data)</option><option value="sellers">Sellers</option><option value="promoters">Promoters</option><option value="support">Support metadata</option><option value="audit">Audit trail</option></select></label><label>Country<input maxlength="2" name="country" value="<%=user.role==='country_admin'?user.country:''%>" <%=user.role==='country_admin'?'readonly':''%>></label><label>Business/privacy reason<textarea name="reason" required minlength="3"></textarea></label><button type="submit">Send for approval</button></form></section><section class="panel"><h2>Retention policy</h2><p>Exports contain an allow-listed field set, expire after 24 hours and are removed by maintenance. Downloads are audited.</p></section></div><section class="panel"><h2>Export requests</h2><div class="table-wrap"><table><thead><tr><th>Export</th><th>Scope</th><th>Status</th><th>Rows</th><th></th></tr></thead><tbody><% if(!exports.length){%><tr><td colspan="5">No export requests.</td></tr><%}%><% exports.forEach(e=>{%><tr><td><%=e.type%><br><small><%=e.publicId%> · <%=formatDate(e.createdAt)%></small></td><td><%=e.country||'Global'%></td><td><%=e.status%></td><td><%=e.rowCount%></td><td><% if(e.status==='ready'){%><a class="outline-button" href="/admin/exports/<%=e.publicId%>/download">Download CSV</a><%}%></td></tr><%})%></tbody></table></div></section><%}%>

<% if(section==='incidents'){%><div class="admin-two"><section class="panel"><h2>Open incident</h2><form class="admin-form" method="post" action="/admin/incidents"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Country<input maxlength="2" name="country" value="<%=user.role==='country_admin'?user.country:''%>" <%=user.role==='country_admin'?'readonly':''%>></label><label>Severity<select name="severity"><option value="sev1">SEV1</option><option value="sev2">SEV2</option><option value="sev3">SEV3</option><option value="sev4">SEV4</option></select></label><label>Title<input name="title" required maxlength="180"></label><label>Summary<textarea name="summary" required maxlength="4000"></textarea></label><button type="submit">Open incident</button></form></section><section class="panel"><h2>Platform-health principle</h2><p>Incidents have severity, owner, country scope, state and an append-only operational timeline. Resolutions remain visible for post-incident review.</p></section></div><section class="panel"><h2>Incident register</h2><div class="admin-stack"><% if(!incidents.length){%><p>No incidents recorded.</p><%}%><% incidents.forEach(i=>{%><article class="admin-card"><div class="admin-actions"><strong><%=i.severity.toUpperCase()%> · <%=i.title%></strong><span class="admin-badge <%=i.status==='resolved'?'good':i.severity==='sev1'?'bad':'warn'%>"><%=i.status%></span></div><p><%=i.summary%></p><small><%=i.country||'Global'%> · <%=formatDate(i.startedAt)%></small><form class="admin-form" method="post" action="/admin/incidents/<%=i.publicId%>/update"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Status<select name="status"><% ['open','investigating','monitoring','resolved'].forEach(s=>{%><option value="<%=s%>" <%=i.status===s?'selected':''%>><%=s%></option><%})%></select></label><label>Timeline update<input name="message" minlength="3" maxlength="2000" required></label><button type="submit">Add update</button></form><% i.timeline.slice().reverse().slice(0,5).forEach(t=>{%><p class="admin-meta"><strong><%=t.type%></strong> · <%=formatDate(t.at)%><br><%=t.message%></p><%})%></article><%})%></div></section><%}%>


<% if(section==='security'){%>
<div class="admin-grid">
  <section class="panel admin-stat"><span>Application IDS</span><strong><%=securityConfig.ids?'On':'Off'%></strong><small>Probe and abuse detection</small></section>
  <section class="panel admin-stat"><span>Application IPS</span><strong><%=securityConfig.ips?'On':'Off'%></strong><small><%=blocks.length%> active global block(s)</small></section>
  <section class="panel admin-stat"><span>SIEM</span><strong><%=securityConfig.siemMode%></strong><small><%=securityConfig.siemFormat%> · <%=siemCounts.sent||0%> sent · <%=siemCounts.retry||0%> retry</small></section>
  <section class="panel admin-stat"><span>Privileged MFA</span><strong><%=securityConfig.mfaRequired?'Required':'Optional'%></strong><small>Launch scope: <%=securityConfig.launchCountries.join(', ')||'not set'%></small></section>
</div>
<div class="admin-two">
<section class="panel"><div class="role-panel-head"><div><h2>Security findings</h2><p>High and critical findings must be remediated or formally risk-accepted by a different administrator.</p></div></div>
<form class="admin-form" method="post" action="/admin/security/findings"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Country<input maxlength="2" name="country" value="<%=user.role==='country_admin'?user.country:''%>" <%=user.role==='country_admin'?'readonly':''%>></label><label>Severity<select name="severity"><option>low</option><option>medium</option><option selected>high</option><option>critical</option></select></label><label>Title<input name="title" maxlength="180" required></label><label>Details<textarea name="details" maxlength="4000" required></textarea></label><button type="submit">Record finding</button></form>
<div class="admin-stack"><% findings.forEach(f=>{%><article class="admin-card"><div class="admin-actions"><strong><%=f.severity.toUpperCase()%> · <%=f.title%></strong><span class="admin-badge <%=f.status==='remediated'||f.status==='risk_accepted'?'good':f.severity==='critical'?'bad':'warn'%>"><%=f.status%></span></div><p><%=f.details%></p><small><%=f.country||'Global'%> · <%=formatDate(f.createdAt)%></small><% if(['open','acceptance_requested'].includes(f.status)){%><form class="admin-form" method="post" action="/admin/security/findings/<%=f.publicId%>/remediate"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Remediation evidence<input name="remediation" minlength="3" required></label><button type="submit">Mark remediated</button></form><%}%><% if(['high','critical'].includes(f.severity)&&f.status==='open'){%><form class="admin-form" method="post" action="/admin/security/findings/<%=f.publicId%>/request-risk"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Risk acceptance reason<textarea name="reason" minlength="10" required></textarea></label><button class="outline-button" type="submit">Request risk acceptance</button></form><%}%><% if(f.status==='acceptance_requested'&&String(f.riskRequestedByUserId?._id||f.riskRequestedByUserId)!==String(user._id)){%><form method="post" action="/admin/security/findings/<%=f.publicId%>/approve-risk"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit">Approve risk acceptance</button></form><%}%></article><%})%><% if(!findings.length){%><p>No security findings recorded.</p><%}%></div>
</section>
<section class="panel"><div class="role-panel-head"><div><h2>Privileged MFA recovery</h2><p>Administrative reset uses a short-lived four-eyes request. The requester and target cannot approve it.</p></div></div>
<form class="admin-form" method="post" action="/admin/security/mfa-recovery"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Protected account<select name="targetPublicId" required><option value="">Choose account</option><% privilegedUsers.filter(u=>u.security?.mfaEnabled).forEach(u=>{%><option value="<%=u.publicId%>"><%=u.name%> · <%=u.role%> · <%=u.country%></option><%})%></select></label><label>Verified recovery reason<textarea name="reason" minlength="10" required></textarea></label><button type="submit">Request MFA recovery</button></form>
<div class="admin-stack"><% recoveryRequests.forEach(r=>{%><article class="admin-card"><strong><%=r.targetUserId?.name||r.targetPublicId%> · <%=r.status%></strong><p><%=r.reason%></p><small>Requested by <%=r.requestedByUserId?.name||'—'%> · expires <%=formatDate(r.expiresAt)%></small><% if(r.status==='requested'&&String(r.requestedByUserId?._id||r.requestedByUserId)!==String(user._id)&&String(r.targetUserId?._id||r.targetUserId)!==String(user._id)){%><div class="admin-actions"><form method="post" action="/admin/security/mfa-recovery/<%=r.publicId%>/approve"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="decisionReason" value="Identity and recovery evidence independently verified" type="hidden"><button type="submit">Approve &amp; reset</button></form><form method="post" action="/admin/security/mfa-recovery/<%=r.publicId%>/reject"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="decisionReason" value="Recovery evidence not approved" type="hidden"><button class="outline-button" type="submit">Reject</button></form></div><%}%></article><%})%><% if(!recoveryRequests.length){%><p>No MFA recovery requests.</p><%}%></div>
</section>
</div>
<section class="panel"><div class="role-panel-head"><div><h2>Launch evidence gate</h2><p>Production launch is blocked until required operational, security, recovery, policy and provider evidence is recorded.</p></div></div><div class="table-wrap"><table><thead><tr><th>Gate</th><th>Status</th><th>Evidence</th><th>Action</th></tr></thead><tbody><% evidence.forEach(e=>{%><tr><td><strong><%=e.label%></strong><br><small><%=e.key%></small></td><td><span class="admin-badge <%=e.status==='passed'||e.status==='not_applicable'?'good':e.status==='failed'?'bad':'warn'%>"><%=e.status%></span></td><td><%=e.evidence||'—'%></td><td><% if(user.role==='super_admin'){%><form class="admin-form" method="post" action="/admin/security/evidence/<%=e.key%>"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="status"><% ['missing','passed','failed','not_applicable'].forEach(x=>{%><option value="<%=x%>" <%=e.status===x?'selected':''%>><%=x%></option><%})%></select><input name="evidence" value="<%=e.evidence%>" placeholder="Evidence, ticket, report or justification"><button type="submit">Save</button></form><%}else{%>Super Admin only<%}%></td></tr><%})%></tbody></table></div></section>
<% if(user.role==='super_admin'){%><section class="panel"><div class="role-panel-head"><div><h2>Active IPS blocks</h2><p>Only keyed IP hashes are stored. Raw IP addresses are not persisted in the block database.</p></div></div><div class="admin-stack"><% blocks.forEach(b=>{%><article class="admin-card"><strong><%=String(b.ipHash||'').slice(0,16)%>…</strong><p><%=b.reason%></p><small>Expires <%=formatDate(b.expiresAt)%> · <%=b.hitCount%> hit(s)</small><form method="post" action="/admin/security/blocks/<%=b.publicId%>/revoke"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit">Revoke block</button></form></article><%})%><% if(!blocks.length){%><p>No active IPS blocks.</p><%}%></div></section><%}%>
<section class="panel"><div class="role-panel-head"><div><h2>Recent security events</h2><p>Events are HMAC-protected before SIEM export. Modified events fail integrity verification and are refused export.</p></div></div><div class="table-wrap"><table><thead><tr><th>Time</th><th>Event</th><th>Severity</th><th>Result</th><th>Integrity</th><th>SIEM</th></tr></thead><tbody><% events.forEach(e=>{%><tr><td><%=formatDate(e.occurredAt)%></td><td><strong><%=e.type%></strong><br><small><%=e.method%> <%=e.path%> · request <%=e.requestId||'—'%></small></td><td><span class="admin-badge <%=e.severity==='critical'?'bad':e.severity==='high'?'warn':'good'%>"><%=e.severity%></span></td><td><%=e.result%></td><td><span class="admin-badge <%=e.integrityOk?'good':'bad'%>"><%=e.integrityOk?'valid':'FAILED'%></span></td><td><%=e.siemStatus%> · <%=e.siemAttempts||0%></td></tr><%})%><% if(!events.length){%><tr><td colspan="6">No security events yet.</td></tr><%}%></tbody></table></div></section>
<%}%>

<% if(section==='health'){%><div class="admin-grid"><section class="panel admin-stat"><span>MongoDB</span><strong><%=health.mongo.readyState===1?'Ready':'Not ready'%></strong><small><%=health.mongo.database%></small></section><section class="panel admin-stat"><span>Outbox pending/failed</span><strong><%=health.queues.restricted?'Restricted':health.queues.outboxPending%></strong><small><%=health.queues.restricted?'Global system queue is Super Admin only.':'Global notification/event queue'%></small></section><section class="panel admin-stat"><span>Provider failures</span><strong><%=health.providers.restricted?'Restricted':health.providers.providerFailed%></strong><small><%=health.providers.paymentsFailed%> country-scoped payment failures</small></section><section class="panel admin-stat"><span>Failed reconciliations</span><strong><%=health.reconciliation.failed%></strong></section></div><section class="panel"><h2>Health snapshot</h2><p>Checked <%=formatDate(health.checkedAt)%>. This view reads live database/queue/provider-operational state and does not mutate platform data.</p><p><strong>Mongo host:</strong> <%=health.mongo.host||'managed deployment'%></p></section><%}%>
<% if(section==='impersonation'){%><div class="admin-two"><section class="panel"><h2>Request read-only impersonation</h2><p>Impersonation requires a reason and four-eyes approval. An approved grant is single-use, expires after 30 minutes, and the read-only session also expires after 30 minutes. Every start/stop is audited.</p><form class="admin-form" method="post" action="/admin/impersonation/request"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Account<select name="targetUserPublicId" required><option value="">Choose account</option><% users.forEach(u=>{%><option value="<%=u.publicId%>"><%=u.name%> · <%=u.role%> · <%=u.country%></option><%})%></select></label><label>Reason<textarea name="reason" minlength="3" required></textarea></label><button type="submit">Send for approval</button></form></section><section class="panel"><h2>Approved sessions</h2><% const usableApprovals=approvals.filter(a=>a.status==='applied'&&!a.consumedAt&&a.appliedAt&&(Date.now()-new Date(a.appliedAt).getTime()<=30*60*1000)); %><% usableApprovals.forEach(a=>{%><article class="admin-card"><strong><%=a.targetPublicId%></strong><p><%=a.reason%></p><small>Single-use · expires 30 minutes after approval</small><% if(String(a.requestedByUserId?._id||a.requestedByUserId)===String(user._id)||user.role==='super_admin'){%><form method="post" action="/admin/impersonation/start"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="approvalId" value="<%=a.publicId%>"><button type="submit">Start read-only view</button></form><%}%></article><%})%><% if(!usableApprovals.length){%><p>No unused, unexpired impersonation approvals.</p><%}%></section></div><%}%>
</main><script src="/image-fallback.js"></script></body></html>
