<!DOCTYPE html>

<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<meta content="Create a Classic Mart account for faster checkout, saved products and order tracking." name="description"/>
<meta content="#ff6500" name="theme-color"/>
<title>Create Account — Classic Mart</title>
<link href="/styles.css" rel="stylesheet"/>
<link href="/storefront-pages.css" rel="stylesheet"/>
</head>
<body class="storefront-page auth-standalone-page">
<a class="skip-link" href="#authContent">Skip to account creation</a>
<main class="auth-main page-shell" id="authContent">
<section aria-label="Create a Classic Mart account" class="auth-grid">
<article class="auth-card auth-showcase">
<div>
<span class="auth-showcase-badge"><img alt="" src="/assets/icons/circle-check.svg"/>Membership is free</span>
<div class="auth-showcase-copy">
<h1>Your shopping, <span>made simpler.</span></h1>
<p>Create one account for saved items, faster checkout, delivery updates and a cleaner buying experience across Classic Mart.</p>
<div class="auth-benefits">
<div class="auth-benefit"><span><img alt="" src="/assets/icons/cart-shopping.svg"/></span><div><strong>Faster checkout</strong><small>Reuse your delivery information securely.</small></div></div>
<div class="auth-benefit"><span><img alt="" src="/assets/icons/tags.svg"/></span><div><strong>Relevant offers</strong><small>See useful deals without losing control.</small></div></div>
<div class="auth-benefit"><span><img alt="" src="/assets/icons/headset.svg"/></span><div><strong>Account support</strong><small>Get help with orders, returns and sellers.</small></div></div>
</div>
</div>
</div>
<div class="auth-social-proof">
<div aria-hidden="true" class="auth-avatars"><span>CM</span><span>BUY</span><span>+</span></div>
<div><strong>One account, more convenience</strong><small>Your password is securely hashed and never stored in the browser.</small></div>
</div>
</article>
<article class="auth-card auth-form-card">
<div class="auth-form-head">
<span class="auth-kicker">Free customer account</span>
<h2>Create your Classic Mart account.</h2>
<p>Enter your details below. You will verify your email before choosing a workspace.</p>
</div>
<form action="/signup" class="auth-form" id="signUpForm" method="post">
<input name="_csrf" type="hidden" value="<%= csrfToken %>"/>
<label class="auth-field">
<span>Full name</span>
<span class="auth-input-wrap"><img alt="" src="/assets/icons/user.svg"/><input autocomplete="name" id="signUpName" minlength="2" name="name" placeholder="Your full name" required="" type="text" value="<%= values.name || '' %>"/></span>
</label>
<label class="auth-field">
<span>Email address</span>
<span class="auth-input-wrap"><img alt="" src="/assets/icons/envelope.svg"/><input autocomplete="email" id="signUpEmail" name="email" placeholder="you@example.com" required="" type="email" value="<%= values.email || '' %>"/></span>
</label>
<label class="auth-field">
<span>Phone number</span>
<span class="auth-input-wrap"><img alt="" src="/assets/icons/mobile-screen-button.svg"/><input autocomplete="tel" id="signUpPhone" name="phone" placeholder="e.g. +256 700 000 000" required="" type="tel" value="<%= values.phone || '' %>"/></span>
</label>
<label class="auth-field">
<span>Referral code <small>(optional)</small></span>
<span class="auth-input-wrap"><img alt="" src="/assets/icons/gift.svg"/><input autocomplete="off" maxlength="24" name="referralCode" placeholder="e.g. CM12AB34CD" type="text" value="<%= values.referralCode || '' %>"/></span>
</label>
<label class="auth-field">
<span>Create password</span>
<span class="auth-input-wrap"><img alt="" src="/assets/icons/lock.svg"/><input autocomplete="new-password" id="signUpPassword" maxlength="128" minlength="12" name="password" placeholder="12+ characters, mixed case and a number" required="" type="password"/><button aria-label="Show password" class="password-toggle" data-password-toggle="signUpPassword" type="button"><img alt="" src="/assets/icons/eye.svg"/></button></span>
</label>
<label class="auth-field">
<span>Confirm password</span>
<span class="auth-input-wrap"><img alt="" src="/assets/icons/lock.svg"/><input autocomplete="new-password" id="signUpConfirmPassword" maxlength="128" minlength="12" name="confirmPassword" placeholder="Repeat your password" required="" type="password"/><button aria-label="Show password" class="password-toggle" data-password-toggle="signUpConfirmPassword" type="button"><img alt="" src="/assets/icons/eye.svg"/></button></span>
</label>
<label class="auth-check"><input id="acceptTerms" name="acceptTerms" required="" type="checkbox"/>I agree to the Terms of Service and Privacy Policy.</label>
<label class="auth-check"><input name="marketing" type="checkbox"/>Send me useful offers (optional).</label>
<p aria-live="polite" class="auth-message<%= pageError ? ' error' : '' %>" id="authMessage" role="status"><%= pageError || '' %></p>
<button class="auth-submit" type="submit">Create My Account</button>
</form>
<p class="auth-switch">Already have an account? <a href="/login">Sign in here</a></p>
<p class="auth-legal">Classic Mart never sells your account information. Read our <a href="/privacy">Privacy Policy</a>.</p>
</article>
</section>
</main>
<div aria-live="polite" class="page-toast" id="pageToast" role="status"></div>
<script src="/identity.js"></script>
<script src="/image-fallback.js"></script></body>
</html>
