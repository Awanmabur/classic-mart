<!DOCTYPE html>

<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<meta content="Review and manage products saved to your Classic Mart wishlist." name="description"/>
<meta content="#ff6500" name="theme-color"/>
<title>My Wishlist — Classic Mart</title>
<link href="/styles.css" rel="stylesheet"/>
<link href="/storefront-pages.css" rel="stylesheet"/>
<link href="/wishlist.css" rel="stylesheet"/>
</head>
<body class="storefront-page wishlist-page">
<a class="skip-link" href="#wishlistMain">Skip to wishlist</a>
<%- include("partials/storefront-header") %>
<main class="wishlist-main" id="wishlistMain">
<section class="wishlist-hero">
<div class="container wishlist-hero-inner">
<nav aria-label="Breadcrumb" class="wishlist-breadcrumb"><a href="/">Home</a><span>›</span><strong>Wishlist</strong></nav>
<div class="wishlist-hero-copy">
<div><span>Saved for later</span><h1>My Wishlist</h1><p>Keep useful products together, compare prices and move anything to your cart when you are ready.</p></div>
<div class="wishlist-hero-actions"><button id="addAllWishlist" type="button"><img alt="" src="/assets/icons/cart-plus.svg"/>Add all to cart</button><button id="clearWishlist" type="button"><img alt="" src="/assets/icons/trash-can.svg"/>Clear wishlist</button></div>
</div>
</div>
</section>
<section aria-label="Wishlist overview" class="container wishlist-overview">
<article><img alt="" src="/assets/icons/heart.svg"/><div><strong id="wishlistTotal">0</strong><span>Saved products</span></div></article>
<article><img alt="" src="/assets/icons/tags.svg"/><div><strong id="wishlistSavings">$0.00</strong><span>Potential savings</span></div></article>
<article><img alt="" src="/assets/icons/circle-check.svg"/><div><strong id="wishlistAvailable">0</strong><span>Available now</span></div></article>
</section>
<section class="container wishlist-workspace">
<div class="wishlist-toolbar"><div><span>Your collection</span><h2>Products you saved</h2></div><label>Sort by<select id="wishlistSort"><option value="recent">Recently saved</option><option value="price-low">Price: low to high</option><option value="price-high">Price: high to low</option><option value="rating">Highest rated</option><option value="saving">Biggest saving</option></select></label></div>
<div class="wishlist-grid" id="wishlistGrid"></div>
<div class="wishlist-empty" hidden="" id="wishlistEmpty">
<span><img alt="" src="/assets/icons/heart-regular.svg"/></span><h2>Your wishlist is waiting for something special.</h2><p>Select the heart icon on any product to save it here for later.</p><a href="/products">Explore products</a>
</div>
</section>
<section class="container wishlist-recommendations">
<div class="wishlist-section-head"><div><span>Continue discovering</span><h2>You may also like</h2></div><a href="/products">View all products</a></div>
<div class="wishlist-grid compact" id="wishlistRecommendations"></div>
</section>
</main>
<section class="newsletter">
<div class="container newsletter-inner">
<div class="newsletter-message"><span><img alt="" src="/assets/icons/envelope.svg"/></span><div><strong>Stay in the Loop!</strong><small>Get exclusive deals, new arrivals and shopping tips.</small></div></div>
<form class="newsletter-form" data-newsletter-form id="newsletterForm" novalidate>
<label class="sr-only" for="newsletterEmail">Email address</label>
<input autocomplete="email" id="newsletterEmail" maxlength="254" name="email" placeholder="Enter your email address" required type="email"/>
<button type="submit">Subscribe</button>
<p aria-live="polite" class="newsletter-status" data-newsletter-status></p>
</form>
<div class="newsletter-perks"><span><img alt="" src="/assets/icons/percent.svg"/><b>Exclusive Deals</b></span><span><img alt="" src="/assets/icons/gift.svg"/><b>New Arrivals</b></span><span><img alt="" src="/assets/icons/location-dot.svg"/><b>Shopping Tips</b></span></div>
</div>
</section>
<%- include("partials/storefront-footer") %>
<div aria-live="polite" class="page-toast" id="pageToast" role="status"></div>
<%- include("partials/product-preview-modal") %>
<script src="/cart-store.js"></script>
<script src="/product-preview.js"></script>
<script src="/wishlist.js"></script>
<script src="/shared-shell.js"></script>
<script src="/image-fallback.js"></script><script src="/country-switcher.js"></script><script src="/search-tools.js"></script><script src="/newsletter.js"></script></body>
</html>