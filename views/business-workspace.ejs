<!doctype html><html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Business Buying — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"></head><body data-operations-ui="true"><main class="catalog-workspace"><header class="catalog-topbar"><div><a class="brand" href="/dashboard"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p>Business Buyer</p></div><% if(view.availableOrganizations?.length>1){%><form class="workspace-switcher" method="post" action="/business/workspace" aria-label="Switch business workspace"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label><span>Company</span><select name="organizationPublicId" onchange="this.form.submit()"><%view.availableOrganizations.forEach(item=>{%><option value="<%=item.publicId%>" <%=item.publicId===view.organization.publicId?'selected':''%>><%=item.companyName%> · <%=item.role%> · <%=item.country%></option><%})%></select></label></form><%}%><div class="catalog-actions"><a class="outline-button" href="/dashboard">Dashboard</a><a class="outline-button" href="/">Marketplace</a></div></header><section class="catalog-page-head panel"><div><span class="eyebrow">Company procurement</span><h1><%= view.organization.companyName %></h1><p>Team purchasing, budgets, approvals, quotations, purchase orders and recurring procurement are server-controlled and auditable.</p></div><a class="outline-button" href="/business/statement.csv">Download statement</a></section><nav class="bb-nav"><a href="#profile">Company</a><a href="#team">Team</a><a href="#budgets">Budgets</a><a href="#requests">Approvals</a><a href="#quotes">Quotes</a><a href="#purchase-orders">POs</a><a href="#invoices">Invoices</a><a href="#documents">Documents</a><a href="#templates">Repeat lists</a><a href="#audit">Audit</a></nav>
<div class="bb-grid"><section class="panel" id="profile"><h2>Company profile</h2><form method="post" action="/business/profile" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Company name<input name="companyName" required value="<%=view.organization.companyName%>"></label><label>Billing email<input type="email" name="billingEmail" required value="<%=view.organization.billingEmail%>"></label><label>Tax ID<input name="taxId" value="<%=view.taxId%>" autocomplete="off"></label><label>Billing contact<input name="billingContactName" value="<%=view.organization.billingContactName||''%>"></label><label>Billing phone<input name="billingPhone" value="<%=view.organization.billingPhone||''%>"></label><label>Billing address<input name="billingAddress" value="<%=view.organization.billingAddress||''%>"></label><label>Billing city<input name="billingCity" value="<%=view.organization.billingCity||''%>"></label><label>Delivery contact<input name="deliveryContactName" value="<%=view.organization.deliveryContactName||''%>"></label><label>Delivery phone<input name="deliveryPhone" value="<%=view.organization.deliveryPhone||''%>"></label><label>Delivery address<input name="deliveryAddress" value="<%=view.organization.deliveryAddress||''%>"></label><label>Delivery city<input name="deliveryCity" value="<%=view.organization.deliveryCity||''%>"></label><button type="submit">Save company</button></form><p><small>Invoice terms: <%=view.organization.invoiceTermsApproved?`${view.organization.invoiceTermsDays} days approved`:'Awaiting risk approval'%></small></p></section><section class="panel" id="team"><h2>Team & spending permissions</h2><form method="post" action="/business/members" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Member email<input type="email" name="email" required></label><label>Role<select name="role"><option>buyer</option><option>approver</option><option>admin</option><option>viewer</option></select></label><label>Spending limit (minor units)<input type="number" min="0" name="spendingLimitMinor" value="0"></label><label><input type="checkbox" name="canApprove"> Can approve purchase requests</label><button type="submit">Invite member</button></form><div class="bb-stack"><%view.members.forEach(m=>{%><article class="bb-card"><strong><%=m.userId?.name||'Member'%></strong><br><small><%=m.role%> · <%=m.status%> · limit <span class="workspace-money"><%=formatMoney(m.spendingLimitMinor,view.organization.currency||user.currency)%></span></small></article><%})%></div></section></div>
<div class="bb-grid"><section class="panel" id="budgets"><h2>Budgets</h2><form method="post" action="/business/budgets" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Name<input name="name" required></label><label>Limit (minor units)<input type="number" min="1" name="limitMinor" required></label><label>From<input type="date" name="periodStart" required></label><label>To<input type="date" name="periodEnd" required></label><button type="submit">Create budget</button></form><%view.budgets.forEach(b=>{%><p><strong><%=b.name%></strong> · spent <span class="workspace-money"><%=formatMoney(b.spentMinor||0,b.currency)%></span> · committed <span class="workspace-money"><%=formatMoney(b.committedMinor,b.currency)%></span> / limit <span class="workspace-money"><%=formatMoney(b.limitMinor,b.currency)%></span></p><%})%></section><section class="panel" id="requests"><h2>Purchase approval request</h2><form method="get" action="/business" class="bb-form" aria-label="Search procurement catalogue"><label>Find exact SKU / product / seller<input type="search" name="catalogQ" value="<%=view.catalogueSearch||''%>" maxlength="120" placeholder="SKU, variant, product or seller"></label><button type="submit">Search catalogue</button></form><p><small>Showing <%=view.productOptions.length%> of <%=view.queuePages?.catalogue?.total||0%> matching verified SKU variants in <%=view.organization.country%>.</small></p><% if(view.queuePages?.catalogue?.hasMore){%><p><a class="server-pager" href="/business?catalogQ=<%=encodeURIComponent(view.catalogueSearch||'')%>&catalogAfter=<%=encodeURIComponent(view.queuePages.catalogue.next)%>#requests">More catalogue SKUs</a></p><%}%><form method="post" action="/business/requests" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Title<input name="title" required></label><label>Budget<select name="budgetId"><option value="">No budget</option><%view.budgets.filter(b=>b.active).forEach(b=>{%><option value="<%=b.publicId%>"><%=b.name%></option><%})%></select></label><label>Exact variant / SKU<select name="variantPublicId" required><option value="">Select from the catalogue below</option><% view.productOptions.forEach(product=>{ %><option value="<%=product.variantPublicId%>"><%=product.title%> · <%=product.variantTitle%> · <%=product.sku%> · <%=formatMoney(product.priceMinor,product.currency)%> · <%=product.storeName%></option><% }) %></select></label><label>Quantity<input type="number" name="quantity" min="1" value="1"></label><button type="submit">Submit for approval</button></form><details class="bb-card"><summary><strong>Bulk CSV procurement</strong></summary><p><a href="/business/requests/import/template.csv">Download CSV template</a></p><form method="post" action="/business/requests/import" enctype="multipart/form-data" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Title<input name="title" required></label><label>Budget<select name="budgetId"><option value="">No budget</option><%view.budgets.filter(b=>b.active).forEach(b=>{%><option value="<%=b.publicId%>"><%=b.name%></option><%})%></select></label><label>CSV file<input type="file" name="csv" accept=".csv,text/csv" required></label><button type="submit">Import & submit for approval</button></form></details><%view.requests.forEach(r=>{%><article class="bb-card"><strong><%=r.title%></strong><p><span class="workspace-money"><%=formatMoney(r.estimatedTotalMinor,r.currency)%></span> · <%=r.status%></p><small>Subtotal <%=formatMoney(r.estimatedSubtotalMinor||r.estimatedTotalMinor,r.currency)%> · tax <%=formatMoney(r.estimatedTaxMinor||0,r.currency)%> (<%=r.taxBps||0%> bps)</small><%if(r.status==='submitted'&&String(r.requesterUserId?._id||r.requesterUserId)!==String(user._id)){%><form method="post" action="/business/requests/<%=r.publicId%>/decision"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button name="decision" value="approve">Approve</button><button name="decision" value="reject">Reject</button></form><%}%><%if(['submitted','approved'].includes(r.status)){%><form method="post" action="/business/requests/<%=r.publicId%>/cancel"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="reason" value="Buyer cancelled from Business Buyer workspace"><button type="submit">Cancel request</button></form><%}%></article><%})%><% if(view.queuePages?.requests?.hasMore){%><p><a class="server-pager" href="/business?requestsAfter=<%=encodeURIComponent(view.queuePages.requests.next)%>#requests">Older requests</a></p><%}%></section></div>
<div class="bb-grid"><section class="panel" id="quotes"><h2>Quotation & negotiation</h2><form method="post" action="/business/quotes" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Approved SKU group / seller<select name="quoteTarget" required><option value="">Select an approved seller-owned SKU group</option><% view.quoteTargets.forEach(target=>{ %><option value="<%=target.procurementRequestId%>|<%=target.storePublicId%>"><%=target.requestTitle%> · <%=target.storeName%> · <%=target.lineCount%> SKU line<%=target.lineCount===1?'':'s'%> / <%=target.quantity%> unit<%=target.quantity===1?'':'s'%></option><% }) %></select></label><label>Message<textarea name="message">Please provide a quotation for the approved items.</textarea></label><button type="submit">Request quote</button></form><% if(view.queuePages?.quoteTargets?.hasMore){%><p><a class="server-pager" href="/business?quoteTargetsAfter=<%=encodeURIComponent(view.queuePages.quoteTargets.next)%>#quotes">More approved SKU groups</a></p><%}%><%view.quotes.forEach(q=>{%><article class="bb-card"><strong><%=q.storeId?.name||q.storePublicId%></strong><p><%=q.status%> · offer <span class="workspace-money"><%=formatMoney(q.offeredTotalMinor||0,q.currency)%></span> / approved <span class="workspace-money"><%=formatMoney(q.approvedAmountMinor||0,q.currency)%></span></p><%q.messages.slice(-3).forEach(m=>{%><small><strong><%=m.actorType%>:</strong> <%=m.message%></small><br><%})%><%if(['responded','negotiating'].includes(q.status)){%><form method="post" action="/business/quotes/<%=q.publicId%>/accept" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Payment terms<select name="paymentTerms"><option value="immediate">Immediate Pesapal payment</option><% if(view.organization.invoiceTermsApproved&&view.organization.invoiceTermsDays>0){ %><option value="credit"><%=view.organization.invoiceTermsDays%>-day approved credit</option><% } %></select></label><button type="submit">Accept & issue PO</button></form><%}%></article><%})%><% if(view.queuePages?.quotes?.hasMore){%><p><a class="server-pager" href="/business?quotesAfter=<%=encodeURIComponent(view.queuePages.quotes.next)%>#quotes">Older quotations</a></p><%}%></section><section class="panel" id="purchase-orders"><h2>Purchase orders</h2><%if(!view.purchaseOrders.length){%><p>No purchase orders yet.</p><%}%><%view.purchaseOrders.forEach(p=>{%><article class="bb-card"><strong><%=p.poNumber%></strong><p><%=p.storeId?.name||p.storePublicId%> · <span class="workspace-money"><%=formatMoney(p.totalMinor,p.currency)%></span> · <%=p.status%></p><small>Subtotal <%=formatMoney(p.subtotalMinor||p.totalMinor,p.currency)%> · tax <%=formatMoney(p.taxMinor||0,p.currency)%> (<%=p.taxBps||0%> bps) · invoice terms <%=p.invoiceTermsDays%> days</small></article><%})%><% if(view.queuePages?.purchaseOrders?.hasMore){%><p><a class="server-pager" href="/business?purchaseOrdersAfter=<%=encodeURIComponent(view.queuePages.purchaseOrders.next)%>#purchase-orders">Older purchase orders</a></p><%}%></section></div>
<section class="panel" id="invoices"><h2>Invoices & payment</h2><p>Immediate invoices are paid through Pesapal. Approved-credit invoices become payable after verified delivery and show their due date here.</p><%if(!view.invoices.length){%><p>No invoices yet.</p><%}%><div class="bb-stack"><%view.invoices.forEach(inv=>{%><article class="bb-card"><strong><%=inv.invoiceNumber%></strong><p><%=inv.storeId?.name||inv.storePublicId%> · <span class="workspace-money"><%=formatMoney(inv.totalMinor,inv.currency)%></span> · <%=inv.status%></p><small>Subtotal <%=formatMoney(inv.subtotalMinor,inv.currency)%> · tax <%=formatMoney(inv.taxMinor||0,inv.currency)%> (<%=inv.taxBps||0%> bps) · <%=inv.paymentTerms==='credit'?`${inv.termsDays}-day credit`:'Immediate Pesapal'%><%if(inv.dueAt){%> · due <%=formatDate(inv.dueAt)%><%}%><%if(inv.orderPublicId){%> · order <%=inv.orderPublicId%><%}%></small><%if(['awaiting_payment','open','overdue'].includes(inv.status)){%><form method="post" action="/business/invoices/<%=inv.publicId%>/pay" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit"><%=inv.status==='awaiting_payment'?'Pay with Pesapal':'Settle invoice with Pesapal'%></button></form><%}%><%if(inv.status==='paid'&&inv.paidAt){%><p><small>Paid <%=formatDate(inv.paidAt)%></small></p><%}%></article><%})%></div><% if(view.queuePages?.invoices?.hasMore){%><p><a class="server-pager" href="/business?invoicesAfter=<%=encodeURIComponent(view.queuePages.invoices.next)%>#invoices">Older invoices</a></p><%}%></section>
<section class="panel" id="documents"><h2>Company documents</h2><p>Issued quotations, purchase orders, tax invoices and delivery notes are immutable snapshots. Payment receipts and refund credit notes remain linked to the same company orders.</p><%const businessDocNames={quotation:'Quotation',purchase_order:'Purchase order',tax_invoice:'Tax invoice',delivery_note:'Delivery note'};const financialDocNames={payment_receipt:'Payment receipt',cod_receipt:'COD receipt',refund_credit_note:'Refund credit note',chargeback_notice:'Chargeback notice'};%><div class="bb-stack"><%(view.documents?.business||[]).forEach(doc=>{%><article class="bb-card"><strong><%=businessDocNames[doc.type]||doc.type%> · <%=doc.documentNumber%></strong><p><%=formatMoney(doc.amountMinor,doc.currency)%> · <%=formatDate(doc.issuedAt)%><%if(doc.type==='quotation'){%> · revision <%=doc.revision%><%}%><%if(doc.legacySnapshot){%> · legacy snapshot<%}%></p><a class="outline-button" href="/business/documents/<%=encodeURIComponent(doc.publicId)%>">Open</a> <a class="outline-button" href="/business/documents/<%=encodeURIComponent(doc.publicId)%>.pdf">PDF</a></article><%})%><%(view.documents?.financial||[]).forEach(doc=>{%><article class="bb-card"><strong><%=financialDocNames[doc.type]||doc.type%> · <%=doc.documentNumber%></strong><p><%=formatMoney(doc.amountMinor,doc.currency)%> · <%=formatDate(doc.issuedAt)%></p><a class="outline-button" href="/business/financial-documents/<%=encodeURIComponent(doc.publicId)%>">Open</a></article><%})%><%if(!(view.documents?.business||[]).length&&!(view.documents?.financial||[]).length){%><p>No issued business documents yet.</p><%}%></div><% if(view.queuePages?.businessDocuments){%><div class="server-pager"><small>Business documents: showing <%=view.queuePages.businessDocuments.count%> of <%=view.queuePages.businessDocuments.total%></small><% if(view.queuePages.businessDocuments.hasMore){%><a class="outline-button" href="/business?businessDocumentsAfter=<%=encodeURIComponent(view.queuePages.businessDocuments.next)%>#documents">Older business documents</a><%}%></div><%}%><% if(view.queuePages?.financialDocuments){%><div class="server-pager"><small>Financial documents: showing <%=view.queuePages.financialDocuments.count%> of <%=view.queuePages.financialDocuments.total%></small><% if(view.queuePages.financialDocuments.hasMore){%><a class="outline-button" href="/business?financialDocumentsAfter=<%=encodeURIComponent(view.queuePages.financialDocuments.next)%>#documents">Older receipts / credit notes</a><%}%></div><%}%></section><section class="panel" id="templates"><h2>Repeat lists & recurring procurement</h2><form method="post" action="/business/templates" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Name<input name="name" required></label><label>Exact variant / SKU<select name="variantPublicId" required><option value="">Select from the catalogue below</option><% view.productOptions.forEach(product=>{ %><option value="<%=product.variantPublicId%>"><%=product.title%> · <%=product.variantTitle%> · <%=product.sku%> · <%=formatMoney(product.priceMinor,product.currency)%> · <%=product.storeName%></option><% }) %></select></label><label>Quantity<input type="number" name="quantity" min="1" value="1"></label><label>Recurrence<select name="recurrence"><option value="none">Manual repeat list</option><option value="weekly">Weekly due reminder</option><option value="monthly">Monthly due reminder</option></select></label><button type="submit">Save procurement template</button></form><%view.templates.forEach(t=>{%><p><strong><%=t.name%></strong> · <%=t.recurrence%><%if(t.nextDueAt){%> · next <%=formatDate(t.nextDueAt)%><%}%></p><%})%></section><section class="panel" id="audit"><h2>Business audit history</h2><%if(!view.auditHistory.length){%><p>No business audit events yet.</p><%}%><div class="bb-stack"><%view.auditHistory.forEach(a=>{%><article class="bb-card"><strong><%=a.action%></strong><p><%=a.targetType%> · <%=a.targetPublicId%></p><small><%=a.actorUserId?.name||'System'%> · <%=formatDate(a.createdAt)%></small></article><%})%></div><% if(view.queuePages?.audit?.hasMore){%><p><a class="server-pager" href="/business?auditAfter=<%=encodeURIComponent(view.queuePages.audit.next)%>#audit">Older audit events</a></p><%}%></section></main><script src="/image-fallback.js"></script><script src="/operations-ui.js" defer></script></body></html>
