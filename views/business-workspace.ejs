<!doctype html><html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Business Buying — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"><style>.bb-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.bb-stack{display:grid;gap:12px}.bb-form{display:grid;gap:10px}.bb-form label{display:grid;gap:6px}.bb-form input,.bb-form select,.bb-form textarea{border:1px solid #d8dee8;border-radius:12px;padding:10px 12px;width:100%;box-sizing:border-box}.bb-card{border:1px solid #e0e5ec;border-radius:16px;padding:14px}.bb-nav{display:flex;gap:8px;flex-wrap:wrap}.bb-nav a{border:1px solid #d8dee8;border-radius:999px;padding:8px 12px;text-decoration:none;color:inherit;background:#fff}@media(max-width:800px){.bb-grid{grid-template-columns:1fr}}</style></head><body><main class="catalog-workspace"><header class="catalog-topbar"><div><a class="brand" href="/dashboard"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p>Business Buyer</p></div><div class="catalog-actions"><a class="outline-button" href="/dashboard">Dashboard</a><a class="outline-button" href="/">Marketplace</a></div></header><section class="catalog-page-head panel"><div><span class="eyebrow">Company procurement</span><h1><%= view.organization.companyName %></h1><p>Team purchasing, budgets, approvals, quotations, purchase orders and recurring procurement are server-controlled and auditable.</p></div><a class="outline-button" href="/business/statement.csv">Download statement</a></section><nav class="bb-nav"><a href="#profile">Company</a><a href="#team">Team</a><a href="#budgets">Budgets</a><a href="#requests">Approvals</a><a href="#quotes">Quotes</a><a href="#purchase-orders">POs</a><a href="#templates">Repeat lists</a><a href="#audit">Audit</a></nav>
<div class="bb-grid"><section class="panel" id="profile"><h2>Company profile</h2><form method="post" action="/business/profile" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Company name<input name="companyName" required value="<%=view.organization.companyName%>"></label><label>Billing email<input type="email" name="billingEmail" required value="<%=view.organization.billingEmail%>"></label><label>Tax ID<input name="taxId" value="<%=view.taxId%>" autocomplete="off"></label><button type="submit">Save company</button></form><p><small>Invoice terms: <%=view.organization.invoiceTermsApproved?`${view.organization.invoiceTermsDays} days approved`:'Awaiting risk approval'%></small></p></section><section class="panel" id="team"><h2>Team & spending permissions</h2><form method="post" action="/business/members" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Member email<input type="email" name="email" required></label><label>Role<select name="role"><option>buyer</option><option>approver</option><option>admin</option><option>viewer</option></select></label><label>Spending limit (minor units)<input type="number" min="0" name="spendingLimitMinor" value="0"></label><label><input type="checkbox" name="canApprove"> Can approve purchase requests</label><button type="submit">Invite member</button></form><div class="bb-stack"><%view.members.forEach(m=>{%><article class="bb-card"><strong><%=m.userId?.name||'Member'%></strong><br><small><%=m.role%> · <%=m.status%> · limit <span class="workspace-money"><%=formatMoney(m.spendingLimitMinor,view.organization.currency||user.currency)%></span></small></article><%})%></div></section></div>
<div class="bb-grid"><section class="panel" id="budgets"><h2>Budgets</h2><form method="post" action="/business/budgets" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Name<input name="name" required></label><label>Limit (minor units)<input type="number" min="1" name="limitMinor" required></label><label>From<input type="date" name="periodStart" required></label><label>To<input type="date" name="periodEnd" required></label><button type="submit">Create budget</button></form><%view.budgets.forEach(b=>{%><p><strong><%=b.name%></strong> · spent <span class="workspace-money"><%=formatMoney(b.spentMinor||0,b.currency)%></span> · committed <span class="workspace-money"><%=formatMoney(b.committedMinor,b.currency)%></span> / limit <span class="workspace-money"><%=formatMoney(b.limitMinor,b.currency)%></span></p><%})%></section><section class="panel" id="requests"><h2>Purchase approval request</h2><form method="post" action="/business/requests" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Title<input name="title" required></label><label>Budget<select name="budgetId"><option value="">No budget</option><%view.budgets.filter(b=>b.active).forEach(b=>{%><option value="<%=b.publicId%>"><%=b.name%></option><%})%></select></label><label>Product<select name="productPublicId" required><option value="">Select a published product</option><% view.productOptions.forEach(product=>{ %><option value="<%=product.publicId%>"><%=product.title%> · <%=product.storeName%></option><% }) %></select></label><label>Quantity<input type="number" name="quantity" min="1" value="1"></label><button type="submit">Submit for approval</button></form><details class="bb-card"><summary><strong>Bulk CSV procurement</strong></summary><p><a href="/business/requests/import/template.csv">Download CSV template</a></p><form method="post" action="/business/requests/import" enctype="multipart/form-data" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Title<input name="title" required></label><label>Budget<select name="budgetId"><option value="">No budget</option><%view.budgets.filter(b=>b.active).forEach(b=>{%><option value="<%=b.publicId%>"><%=b.name%></option><%})%></select></label><label>CSV file<input type="file" name="csv" accept=".csv,text/csv" required></label><button type="submit">Import & submit for approval</button></form></details><%view.requests.forEach(r=>{%><article class="bb-card"><strong><%=r.title%></strong><p><span class="workspace-money"><%=formatMoney(r.estimatedTotalMinor,r.currency)%></span> · <%=r.status%></p><%if(r.status==='submitted'&&String(r.requesterUserId?._id||r.requesterUserId)!==String(user._id)){%><form method="post" action="/business/requests/<%=r.publicId%>/decision"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button name="decision" value="approve">Approve</button><button name="decision" value="reject">Reject</button></form><%}%><%if(['submitted','approved'].includes(r.status)){%><form method="post" action="/business/requests/<%=r.publicId%>/cancel"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="reason" value="Buyer cancelled from Business Buyer workspace"><button type="submit">Cancel request</button></form><%}%></article><%})%></section></div>
<div class="bb-grid"><section class="panel" id="quotes"><h2>Quotation & negotiation</h2><form method="post" action="/business/quotes" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Approved procurement request<select name="procurementRequestId" required><option value="">Select approved request</option><%view.requests.filter(r=>r.status==='approved').forEach(r=>{%><option value="<%=r.publicId%>"><%=r.title%> · <%=formatMoney(r.estimatedTotalMinor,r.currency)%></option><%})%></select></label><label>Seller store<select name="storeId" required><option value="">Select verified seller</option><% view.sellerStores.forEach(store=>{ %><option value="<%=store.publicId%>"><%=store.name%></option><% }) %></select></label><label>Message<textarea name="message">Please provide a quotation for the approved items.</textarea></label><button type="submit">Request quote</button></form><%view.quotes.forEach(q=>{%><article class="bb-card"><strong><%=q.storeId?.name||q.storePublicId%></strong><p><%=q.status%> · offer <span class="workspace-money"><%=formatMoney(q.offeredTotalMinor||0,q.currency)%></span> / approved <span class="workspace-money"><%=formatMoney(q.approvedAmountMinor||0,q.currency)%></span></p><%q.messages.slice(-3).forEach(m=>{%><small><strong><%=m.actorType%>:</strong> <%=m.message%></small><br><%})%><%if(['responded','negotiating'].includes(q.status)){%><form method="post" action="/business/quotes/<%=q.publicId%>/accept"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Accept & issue PO</button></form><%}%></article><%})%></section><section class="panel" id="purchase-orders"><h2>Purchase orders</h2><%if(!view.purchaseOrders.length){%><p>No purchase orders yet.</p><%}%><%view.purchaseOrders.forEach(p=>{%><article class="bb-card"><strong><%=p.poNumber%></strong><p><%=p.storeId?.name||p.storePublicId%> · <span class="workspace-money"><%=formatMoney(p.totalMinor,p.currency)%></span> · <%=p.status%></p><small>Invoice terms: <%=p.invoiceTermsDays%> days</small></article><%})%></section></div>
<section class="panel" id="templates"><h2>Repeat lists & recurring procurement</h2><form method="post" action="/business/templates" class="bb-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Name<input name="name" required></label><label>Product<select name="productPublicId" required><option value="">Select a published product</option><% view.productOptions.forEach(product=>{ %><option value="<%=product.publicId%>"><%=product.title%> · <%=product.storeName%></option><% }) %></select></label><label>Quantity<input type="number" name="quantity" min="1" value="1"></label><label>Recurrence<select name="recurrence"><option value="none">Manual repeat list</option><option value="weekly">Weekly due reminder</option><option value="monthly">Monthly due reminder</option></select></label><button type="submit">Save procurement template</button></form><%view.templates.forEach(t=>{%><p><strong><%=t.name%></strong> · <%=t.recurrence%><%if(t.nextDueAt){%> · next <%=formatDate(t.nextDueAt)%><%}%></p><%})%></section><section class="panel" id="audit"><h2>Business audit history</h2><%if(!view.auditHistory.length){%><p>No business audit events yet.</p><%}%><div class="bb-stack"><%view.auditHistory.forEach(a=>{%><article class="bb-card"><strong><%=a.action%></strong><p><%=a.targetType%> · <%=a.targetPublicId%></p><small><%=a.actorUserId?.name||'System'%> · <%=formatDate(a.createdAt)%></small></article><%})%></div></section></main><script src="/image-fallback.js"></script></body></html>
