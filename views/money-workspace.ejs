<!doctype html><html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Finance — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"></head><body data-operations-ui="true"><main class="catalog-workspace"><header class="catalog-topbar"><div><a class="brand" href="/dashboard"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p>Finance workspace</p></div><div class="catalog-actions"><a class="outline-button" href="/dashboard">Dashboard</a><a class="outline-button" href="/">Marketplace</a></div></header><section class="catalog-page-head panel"><div><span class="eyebrow">Money operations</span><h1>Payments, ledger, refunds &amp; payouts</h1><p>Provider-verified money events, reconciliations and immutable double-entry records. Balances are never edited directly.</p></div></section>
<section class="panel"><div class="role-panel-head"><div><h2>Finance queue filters</h2><p>Filter operational money queues without leaving the authorized country scope.</p></div></div><form method="get" action="/finance" class="catalog-form"><label>Country<select name="country"><option value="">All authorized countries</option><% (availableCountries||[]).forEach(c=>{%><option value="<%=c.code%>" <%=financeFilters?.country===c.code?'selected':''%>><%=c.name%> (<%=c.code%>)</option><%})%></select></label><label>Refund status<select name="refundStatus"><option value="">All refunds</option><% ['pending','processing','completed','failed','cancelled'].forEach(v=>{%><option value="<%=v%>" <%=financeFilters?.refundStatus===v?'selected':''%>><%=v%></option><%})%></select></label><label>Refund reference<input name="refundSearch" maxlength="180" value="<%=financeFilters?.refundSearch||''%>" placeholder="Refund/provider/manual reference"></label><label>Payout status<select name="payoutStatus"><option value="">All payouts</option><% ['requested','approved','submitting','submitted','unknown','paid','failed','rejected'].forEach(v=>{%><option value="<%=v%>" <%=financeFilters?.payoutStatus===v?'selected':''%>><%=v%></option><%})%></select></label><label>Payout reference<input name="payoutSearch" maxlength="180" value="<%=financeFilters?.payoutSearch||''%>" placeholder="Payout/provider/store reference"></label><label>Chargeback status<select name="chargebackStatus"><option value="">All chargebacks</option><% ['open','reviewing','won','lost'].forEach(v=>{%><option value="<%=v%>" <%=financeFilters?.chargebackStatus===v?'selected':''%>><%=v%></option><%})%></select></label><label>Chargeback reference<input name="chargebackSearch" maxlength="180" value="<%=financeFilters?.chargebackSearch||''%>" placeholder="Case/order/payment/provider reference"></label><label>Provider-event status<select name="providerEventStatus"><option value="">All provider events</option><% ['received','processing','processed','ignored','failed','dead'].forEach(v=>{%><option value="<%=v%>" <%=financeFilters?.providerEventStatus===v?'selected':''%>><%=v%></option><%})%></select></label><label>Provider-event reference<input name="providerEventSearch" maxlength="180" value="<%=financeFilters?.providerEventSearch||''%>" placeholder="Event/order/payment/provider or trace ID"></label><label>Reconciliation status<select name="reconciliationStatus"><option value="">All runs</option><% ['running','completed','failed'].forEach(v=>{%><option value="<%=v%>" <%=financeFilters?.reconciliationStatus===v?'selected':''%>><%=v%></option><%})%></select></label><% if(paymentFilters?.status){%><input type="hidden" name="paymentStatus" value="<%=paymentFilters.status%>"><%}%><% if(paymentFilters?.provider){%><input type="hidden" name="paymentProvider" value="<%=paymentFilters.provider%>"><%}%><% if(paymentFilters?.search){%><input type="hidden" name="paymentSearch" value="<%=paymentFilters.search%>"><%}%><div class="catalog-actions"><button type="submit">Apply queue filters</button><a class="outline-button" href="/finance">Clear all</a></div></form></section>
<section class="panel"><div class="role-panel-head"><div><h2>Finance exception control</h2><p>Open finance exceptions and reconciliation work that require operator attention before money can be considered settled.</p></div><strong><%=financeExceptions?.total||0%> open</strong></div><div class="role-content-grid"><article class="catalog-row"><div><strong><%=financeExceptions?.providerEvents||0%></strong><small>failed, dead-letter or unmatched provider events</small></div></article><article class="catalog-row"><div><strong><%=financeExceptions?.payoutUnknown||0%></strong><small>payouts in UNKNOWN state — never resubmit before reconciliation</small></div></article><article class="catalog-row"><div><strong><%=financeExceptions?.reconciliation||0%></strong><small>failed or partially failed reconciliation runs</small></div></article><article class="catalog-row"><div><strong><%=financeExceptions?.staleRefunds||0%></strong><small>refunds still processing after two hours</small></div></article><article class="catalog-row"><div><strong><%=financeExceptions?.openChargebacks||0%></strong><small>open or reviewing chargeback cases</small></div></article><article class="catalog-row"><div><strong><%=financeExceptions?.codPending||0%></strong><small>delivered COD shipments awaiting ledger reconciliation</small></div></article></div></section>
<section class="panel"><div class="role-panel-head"><div><h2>Payment intent control</h2><p>Country-scoped payment attempts, including provider references and verification status. One order may have history, but only the active payable obligation can collect money.</p></div></div><form method="get" action="/finance" class="catalog-form"><% if(financeFilters?.country){%><input type="hidden" name="country" value="<%=financeFilters.country%>"><%}%><label>Exact payment/order/provider reference<input name="paymentSearch" value="<%=paymentFilters?.search||''%>" maxlength="180" placeholder="PAY…, order, provider or 32-char trace ID"></label><label>Status<select name="paymentStatus"><option value="">All statuses</option><% ['created','requires_action','pending','succeeded','failed','cancelled','pending_collection','refunded','partially_refunded','reversed'].forEach(s=>{%><option value="<%=s%>" <%=paymentFilters?.status===s?'selected':''%>><%=s%></option><%})%></select></label><label>Provider<select name="paymentProvider"><option value="">All providers</option><% ['pesapal','cod','sandbox'].forEach(p=>{%><option value="<%=p%>" <%=paymentFilters?.provider===p?'selected':''%>><%=p%></option><%})%></select></label><div class="catalog-actions"><button type="submit">Filter payments</button><a class="outline-button" href="/finance">Clear</a></div></form><div class="table-wrap"><table><thead><tr><th>Payment / trace</th><th>Order / country</th><th>Provider</th><th>Status</th><th>Amount</th><th>Provider truth</th></tr></thead><tbody><% if(!(payments||[]).length){%><tr><td colspan="6">No payment intents in this scope.</td></tr><%}%><% (payments||[]).forEach(p=>{%><tr><td><strong><%=p.publicId%></strong><br><small>trace <%=p.traceId||'legacy unavailable'%></small><br><small><%=formatDate(p.createdAt)%></small></td><td><%=p.orderPublicId%><br><small><%=p.country%></small></td><td><%=p.provider%><br><small><%=p.method%></small></td><td><%=p.status%></td><td class="workspace-money"><%=formatMoney(p.amountMinor,p.currency)%></td><td><%=p.providerTrackingId||p.providerTransactionId||p.providerConfirmationCode||p.providerReference||'—'%><% if(p.lastVerifiedAt){%><br><small>verified <%=formatDate(p.lastVerifiedAt)%></small><%}%></td></tr><%})%></tbody></table></div><% if(queuePages?.payments){%><div class="server-pager"><small>Showing <%=queuePages.payments.count%> of <%=queuePages.payments.total%> payment intents</small><% if(queuePages.payments.hasMore){%><a class="outline-button" href="/finance?paymentsAfter=<%=encodeURIComponent(queuePages.payments.next)%><%=financeSuffix%>">Older payments</a><%}%></div><%}%></section>
<div class="role-content-grid"><section class="panel"><h2>Run payment reconciliation</h2><form method="post" action="/finance/reconciliation" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Look back hours<input type="number" name="hours" min="1" max="168" value="24" required></label><button type="submit">Reconcile provider status</button></form></section><section class="panel"><h2>Issue provider refund</h2><p>Only verified paid orders can be refunded; retries require the same idempotency key.</p><form method="post" action="/finance/refunds" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Verified paid order<select name="orderId" required><option value="">Select a refundable order</option><% (eligibleRefundOrders||[]).forEach(order=>{%><option value="<%=order.publicId%>"><%=order.publicId%> · <%=order.contact?.fullName||'Customer'%> · remaining <%=formatMoney(order.remainingMinor,order.totals.currency)%></option><%})%></select></label><% if(queuePages?.orders?.hasMore){%><a class="outline-button" href="/finance?ordersAfter=<%=encodeURIComponent(queuePages.orders.next)%><%=financeSuffix%>">More refundable orders</a><%}%><label>Amount in minor units (blank = remaining)<input type="number" name="amountMinor" min="1"></label><label>Reason<input name="reason" minlength="3" maxlength="300" required></label><label>Idempotency key<input name="idempotencyKey" minlength="12" maxlength="120" required value="refund-<%=Date.now()%>"></label><button type="submit">Create refund</button></form></section></div>
<section class="panel"><div class="role-panel-head"><div><h2>Payout account verification</h2><p>Encrypted destinations are owned by sellers, promoters or delivery partners; finance controls verification status.</p></div></div><div class="table-wrap"><table><thead><tr><th>Account</th><th>Owner type</th><th>Country</th><th>Status</th><th>Action</th></tr></thead><tbody><% if(!payoutAccounts.length){%><tr><td colspan="5">No payout accounts.</td></tr><%}%><% payoutAccounts.forEach(a=>{%><tr><td><%=a.label%><br><small><%=a.publicId%> · <%=a.method%></small></td><td><%=a.ownerType%></td><td><%=a.country%></td><td><%=a.status%></td><td><%if(a.status==='pending'){%><form method="post" action="/finance/payout-accounts/<%=a.publicId%>/verify"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Verify</button></form><%}else{%>—<%}%></td></tr><%})%></tbody></table></div><% if(queuePages?.payoutAccounts){%><div class="server-pager"><small>Showing <%=queuePages.payoutAccounts.count%> of <%=queuePages.payoutAccounts.total%> payout accounts</small><% if(queuePages.payoutAccounts.hasMore){%><a class="outline-button" href="/finance?payoutAccountsAfter=<%=encodeURIComponent(queuePages.payoutAccounts.next)%><%=financeSuffix%>">Older accounts</a><%}%></div><%}%></section>
<section class="panel">
  <div class="role-panel-head"><div><h2>Payout requests</h2><p>The balance is reserved at request time. Approval, external-transfer submission and reconciliation are separate finance actions. Never repeat an external transfer when a payout is <strong>submitting</strong> or <strong>unknown</strong>; reconcile the existing attempt.</p></div></div>
  <div class="table-wrap"><table><thead><tr><th>Payout</th><th>Amount</th><th>Status</th><th>Action</th></tr></thead><tbody>
  <% if(!payouts.length){%><tr><td colspan="4">No payout requests.</td></tr><%}%>
  <% payouts.forEach(p=>{%><tr>
    <td><strong><%=p.publicId%></strong><%if(p.submissionAttemptId){%><br><small>attempt <%=p.submissionAttemptId%></small><%}%><%if(p.providerReference){%><br><small>external ref <%=p.providerReference%></small><%}%></td>
    <td class="workspace-money"><%=formatMoney(p.amountMinor,p.currency)%></td>
    <td><%=p.status%><%if(p.submissionStartedAt){%><br><small>started <%=formatDate(p.submissionStartedAt)%></small><%}%><%if(p.ambiguityReason){%><br><small><%=p.ambiguityReason%></small><%}%><%if(p.failureMessage){%><br><small><%=p.failureMessage%></small><%}%></td>
    <td><div class="catalog-actions">
      <%if(p.status==='requested'){%>
        <form method="post" action="/finance/payouts/<%=p.publicId%>/approve"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Approve</button></form>
        <form method="post" action="/finance/payouts/<%=p.publicId%>/reject"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="reason" required placeholder="Rejection reason"><button class="outline-button" type="submit">Reject</button></form>
      <%}%>
      <%if(p.status==='approved'){%>
        <form method="post" action="/finance/payouts/<%=p.publicId%>/submit"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Begin transfer</button></form>
        <form method="post" action="/finance/payouts/<%=p.publicId%>/reject"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="reason" required placeholder="Cancellation reason"><button class="outline-button" type="submit">Reject</button></form>
      <%}%>
      <%if(p.status==='submitting'){%>
        <form method="post" action="/finance/payouts/<%=p.publicId%>/submission-confirm" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="reference" required minlength="4" maxlength="180" placeholder="External transfer reference"><button type="submit">Confirm submitted</button></form>
        <form method="post" action="/finance/payouts/<%=p.publicId%>/unknown" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="reason" required minlength="8" maxlength="400" placeholder="Why the transfer outcome is uncertain"><button class="outline-button" type="submit">Mark UNKNOWN</button></form>
      <%}%>
      <%if(p.status==='submitted'){%>
        <form method="post" action="/finance/payouts/<%=p.publicId%>/unknown" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="reason" required minlength="8" maxlength="400" placeholder="Only if provider outcome is uncertain"><button class="outline-button" type="submit">Mark UNKNOWN</button></form>
      <%}%>
      <%if(['submitted','unknown'].includes(p.status)){%>
        <form method="post" action="/finance/payouts/<%=p.publicId%>/reconcile" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="reference" required minlength="4" maxlength="180" value="<%=p.providerReference||''%>" placeholder="External transfer reference"><select name="outcome" required><option value="paid">Paid</option><option value="failed">Failed</option></select><input name="message" maxlength="400" placeholder="Optional note"><button type="submit">Reconcile</button></form>
      <%}%>
    </div></td>
  </tr><%})%>
  </tbody></table></div>
  <% if(queuePages?.payouts){%><div class="server-pager"><small>Showing <%=queuePages.payouts.count%> of <%=queuePages.payouts.total%> payouts</small><% if(queuePages.payouts.hasMore){%><a class="outline-button" href="/finance?payoutsAfter=<%=encodeURIComponent(queuePages.payouts.next)%><%=financeSuffix%>">Older payouts</a><%}%></div><%}%>
</section>
<section class="panel"><div class="role-panel-head"><div><h2>Pesapal chargebacks</h2><p>A provider reversal freezes the remaining payment exposure automatically. One finance operator reviews the case and a different operator records the final won/lost outcome.</p></div></div><div class="table-wrap"><table><thead><tr><th>Case</th><th>Order</th><th>Exposure</th><th>Status</th><th>Control</th></tr></thead><tbody><% if(!(chargebacks||[]).length){%><tr><td colspan="5">No chargebacks.</td></tr><%}%><% (chargebacks||[]).forEach(c=>{%><tr><td><strong><%=c.publicId%></strong><br><small><%=formatDate(c.openedAt)%></small></td><td><%=c.orderPublicId%><br><small><%=c.paymentIntentPublicId%></small></td><td class="workspace-money"><%=formatMoney(c.amountMinor,c.currency)%></td><td><%=c.status%><% if(c.reviewNote){%><br><small><%=c.reviewNote%></small><%}%><% if(c.resolutionNote){%><br><small><%=c.resolutionNote%></small><%}%></td><td><% if(c.status==='open'){%><form method="post" action="/finance/chargebacks/<%=c.publicId%>/review" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="note" maxlength="500" placeholder="Review note"><button type="submit">Start review</button></form><%}else if(c.status==='reviewing'){%><form method="post" action="/finance/chargebacks/<%=c.publicId%>/resolve" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="outcome" required><option value="won">Won / funds recovered</option><option value="lost">Lost / reversal final</option></select><input name="note" maxlength="500" placeholder="Provider evidence/reference"><button type="submit">Record final outcome</button></form><%}else{%>Closed<%}%></td></tr><%})%></tbody></table></div><% if(queuePages?.chargebacks){%><div class="server-pager"><small>Showing <%=queuePages.chargebacks.count%> of <%=queuePages.chargebacks.total%> chargebacks</small><% if(queuePages.chargebacks.hasMore){%><a class="outline-button" href="/finance?chargebacksAfter=<%=encodeURIComponent(queuePages.chargebacks.next)%><%=financeSuffix%>">Older chargebacks</a><%}%></div><%}%></section>
<section class="panel"><div class="role-panel-head"><div><h2>Pesapal provider-event inbox</h2><p>Durably accepted IPN events are country-scoped, lease-claimed, retried with backoff and dead-lettered after repeated failures. Replay never resubmits money; it re-runs local verification against the stable provider reference.</p></div></div><div class="table-wrap"><table><thead><tr><th>Event</th><th>Order / country</th><th>Status</th><th>Attempts</th><th>Processing detail</th><th>Control</th></tr></thead><tbody><% if(!(providerEvents||[]).length){%><tr><td colspan="6">No Pesapal provider events in this scope.</td></tr><%}%><% (providerEvents||[]).forEach(e=>{%><tr><td><strong><%=e.publicId%></strong><br><small>trace <%=e.traceId||'legacy unavailable'%></small><br><small><%=e.eventType%> · <%=formatDate(e.createdAt)%></small></td><td><%=e.orderPublicId||'Unmatched'%><br><small><%=e.country||'Unknown scope'%> · <%=e.paymentIntentPublicId||e.merchantReference||'—'%></small></td><td><%=e.status%><%if(e.manualReplayCount){%><br><small>manual replays <%=e.manualReplayCount%></small><%}%></td><td><%=e.attempts||0%><br><small>next <%=e.nextAttemptAt?formatDate(e.nextAttemptAt):'—'%></small></td><td><%=e.error||'—'%><%if(e.lastManualReplayAt){%><br><small>last replay <%=formatDate(e.lastManualReplayAt)%></small><%}%></td><td><%if(['failed','dead','ignored'].includes(e.status)){%><form method="post" action="/finance/provider-events/<%=e.publicId%>/replay" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="reason" minlength="5" maxlength="300" required placeholder="Why this event is safe to replay"><button type="submit">Queue replay</button></form><%}else{%>—<%}%></td></tr><%})%></tbody></table></div><%if(queuePages?.providerEvents){%><div class="server-pager"><small>Showing <%=queuePages.providerEvents.count%> of <%=queuePages.providerEvents.total%> provider events</small><%if(queuePages.providerEvents.hasMore){%><a class="outline-button" href="/finance?providerEventsAfter=<%=encodeURIComponent(queuePages.providerEvents.next)%><%=financeSuffix%>">Older provider events</a><%}%></div><%}%></section>
<section class="panel"><div class="role-panel-head"><div><h2>COD reconciliation queue</h2><p>Delivered cash-on-delivery shipments remain unsettled until finance reconciles the collected amount into the ledger.</p></div><span class="role-status <%= (codShipments||[]).length ? 'warn' : 'good' %>"><%=queuePages?.cod?.total||0%> pending</span></div><div class="table-wrap"><table><thead><tr><th>Shipment</th><th>Order</th><th>Country</th><th>Collected</th><th>Delivered</th><th>Control</th></tr></thead><tbody><% if(!(codShipments||[]).length){%><tr><td colspan="6">No delivered COD shipments await reconciliation.</td></tr><%}%><% (codShipments||[]).forEach(shipment=>{%><tr><td><strong><%=shipment.publicId%></strong></td><td><%=shipment.orderPublicId%></td><td><%=shipment.country%></td><td class="workspace-money"><%=formatMoney(shipment.cod?.collectedMinor||shipment.cod?.amountMinor||0,shipment.cod?.currency||'UGX')%></td><td><%=formatDate(shipment.deliveredAt)%></td><td><form method="post" action="/finance/cod/<%=shipment.publicId%>/reconcile"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Reconcile COD</button></form></td></tr><%})%></tbody></table></div><% if(queuePages?.cod){%><div class="server-pager"><small>Showing <%=queuePages.cod.count%> of <%=queuePages.cod.total%> pending COD shipments</small><% if(queuePages.cod.hasMore){%><a class="outline-button" href="/finance?codAfter=<%=encodeURIComponent(queuePages.cod.next)%><%=financeSuffix%>">Older COD</a><%}%></div><%}%></section>
<div class="role-content-grid"><section class="panel"><div class="role-panel-head"><div><h2>Refunds</h2></div></div><% if(!refunds.length){%><p>No refunds yet.</p><%}%><% refunds.forEach(r=>{%><article class="catalog-row"><div><strong><%=r.publicId%></strong><small><%=r.status%> · <span class="workspace-money"><%=formatMoney(r.amountMinor,r.currency)%></span> · <%=r.reason%><% if(r.provider==='cod_manual'){%> · COD manual disbursement<%}%></small></div><% if(r.provider==='cod_manual'&&r.status==='processing'){%><form method="post" action="/finance/refunds/<%=r.publicId%>/manual-complete" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Disbursement reference<input name="reference" minlength="4" maxlength="180" required placeholder="Cash receipt or Mobile Money reference"></label><button type="submit">Confirm refund paid</button></form><%}%></article><%})%><% if(queuePages?.refunds){%><div class="server-pager"><small>Showing <%=queuePages.refunds.count%> of <%=queuePages.refunds.total%> refunds</small><% if(queuePages.refunds.hasMore){%><a class="outline-button" href="/finance?refundsAfter=<%=encodeURIComponent(queuePages.refunds.next)%><%=financeSuffix%>">Older refunds</a><%}%></div><%}%></section><section class="panel"><div class="role-panel-head"><div><h2>Reconciliation runs</h2></div></div><% if(!reconciliations.length){%><p>No reconciliation runs yet.</p><%}%><% reconciliations.forEach(r=>{%><article class="catalog-row"><div><strong><%=r.publicId%> · <%=r.status%></strong><small>checked <%=r.checked%> · matched <%=r.matched%> · updated <%=r.updated%> · failed <%=r.failed%></small></div></article><%})%><% if(queuePages?.reconciliations){%><div class="server-pager"><small>Showing <%=queuePages.reconciliations.count%> of <%=queuePages.reconciliations.total%> reconciliation runs</small><% if(queuePages.reconciliations.hasMore){%><a class="outline-button" href="/finance?reconciliationAfter=<%=encodeURIComponent(queuePages.reconciliations.next)%><%=financeSuffix%>">Older runs</a><%}%></div><%}%></section></div>
<section class="panel"><div class="role-panel-head"><div><h2>Ledger accounts</h2><p>Country-scoped financial accounts. Balances are calculated from posted double-entry transactions, never edited directly.</p></div><a class="outline-button" href="/finance/ledger.csv">Export ledger CSV</a></div><form method="get" action="/finance/ledger.csv" class="catalog-form"><label>From<input type="date" name="from"></label><label>To<input type="date" name="to"></label><label>Owner type<select name="ownerType"><option value="">All owners</option><% ['platform','store','promoter','delivery','provider','customer'].forEach(t=>{%><option value="<%=t%>"><%=t%></option><%})%></select></label><button type="submit">Export filtered ledger</button></form><div class="table-wrap"><table><thead><tr><th>Code</th><th>Owner</th><th>Currency</th><th>Type</th><th>Debits</th><th>Credits</th><th>Balance</th></tr></thead><tbody><% if(!accounts.length){%><tr><td colspan="7">No ledger accounts yet.</td></tr><%}%><% accounts.forEach(a=>{%><tr><td><%=a.code%></td><td><%=a.ownerType%> · <%=a.ownerPublicId||'platform'%></td><td><%=a.currency%></td><td><%=a.type%></td><td class="workspace-money"><%=formatMoney(a.debitsMinor||0,a.currency)%></td><td class="workspace-money"><%=formatMoney(a.creditsMinor||0,a.currency)%></td><td class="workspace-money"><strong><%=formatMoney(a.balanceMinor||0,a.currency)%></strong></td></tr><%})%></tbody></table></div><% if(queuePages?.accounts){%><div class="server-pager"><small>Showing <%=queuePages.accounts.count%> of <%=queuePages.accounts.total%> ledger accounts</small><% if(queuePages.accounts.hasMore){%><a class="outline-button" href="/finance?accountsAfter=<%=encodeURIComponent(queuePages.accounts.next)%><%=financeSuffix%>">Older accounts</a><%}%></div><%}%></section>
<section class="panel"><div class="role-panel-head"><div><h2>Recent ledger transactions</h2></div></div><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Description</th><th>Currency</th><th>Posted</th></tr></thead><tbody><% if(!transactions.length){%><tr><td colspan="4">No posted transactions yet.</td></tr><%}%><% transactions.forEach(t=>{%><tr><td><%=t.referenceType%> · <%=t.referencePublicId%></td><td><%=t.description%></td><td><%=t.currency%></td><td><%=formatDate(t.postedAt)%></td></tr><%})%></tbody></table></div><% if(queuePages?.transactions){%><div class="server-pager"><small>Showing <%=queuePages.transactions.count%> of <%=queuePages.transactions.total%> transactions</small><% if(queuePages.transactions.hasMore){%><a class="outline-button" href="/finance?transactionsAfter=<%=encodeURIComponent(queuePages.transactions.next)%><%=financeSuffix%>">Older transactions</a><%}%></div><%}%></section>
</main><script src="/image-fallback.js"></script><script src="/operations-ui.js" defer></script></body></html>
