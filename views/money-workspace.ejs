<!doctype html><html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Finance — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"></head><body><main class="catalog-workspace"><header class="catalog-topbar"><div><a class="brand" href="/dashboard"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p>Finance workspace</p></div><div class="catalog-actions"><a class="outline-button" href="/dashboard">Dashboard</a><a class="outline-button" href="/">Marketplace</a></div></header><section class="catalog-page-head panel"><div><span class="eyebrow">Money operations</span><h1>Payments, ledger, refunds &amp; payouts</h1><p>Provider-verified money events, reconciliations and immutable double-entry records. Balances are never edited directly.</p></div></section>
<div class="role-content-grid"><section class="panel"><h2>Run payment reconciliation</h2><form method="post" action="/finance/reconciliation" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Look back hours<input type="number" name="hours" min="1" max="168" value="24" required></label><button type="submit">Reconcile provider status</button></form></section><section class="panel"><h2>Issue provider refund</h2><p>Only verified paid orders can be refunded; retries require the same idempotency key.</p><form method="post" action="/finance/refunds" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Verified paid order<select name="orderId" required><option value="">Select a refundable order</option><% (eligibleRefundOrders||[]).forEach(order=>{%><option value="<%=order.publicId%>"><%=order.publicId%> · <%=order.contact?.fullName||'Customer'%> · remaining <%=formatMoney(order.remainingMinor,order.totals.currency)%></option><%})%></select></label><label>Amount in minor units (blank = remaining)<input type="number" name="amountMinor" min="1"></label><label>Reason<input name="reason" minlength="3" maxlength="300" required></label><label>Idempotency key<input name="idempotencyKey" minlength="12" maxlength="120" required value="refund-<%=Date.now()%>"></label><button type="submit">Create refund</button></form></section></div>
<section class="panel"><div class="role-panel-head"><div><h2>Payout account verification</h2><p>Encrypted destinations are owned by sellers, promoters or delivery partners; finance controls verification status.</p></div></div><div class="table-wrap"><table><thead><tr><th>Account</th><th>Owner type</th><th>Country</th><th>Status</th><th>Action</th></tr></thead><tbody><% if(!payoutAccounts.length){%><tr><td colspan="5">No payout accounts.</td></tr><%}%><% payoutAccounts.forEach(a=>{%><tr><td><%=a.label%><br><small><%=a.publicId%> · <%=a.method%></small></td><td><%=a.ownerType%></td><td><%=a.country%></td><td><%=a.status%></td><td><%if(a.status==='pending'){%><form method="post" action="/finance/payout-accounts/<%=a.publicId%>/verify"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Verify</button></form><%}else{%>—<%}%></td></tr><%})%></tbody></table></div></section>
<section class="panel"><div class="role-panel-head"><div><h2>Payout requests</h2><p>The balance was reserved when the user requested the payout. Approval and submission must be separate finance actions.</p></div></div><div class="table-wrap"><table><thead><tr><th>Payout</th><th>Amount</th><th>Status</th><th>Action</th></tr></thead><tbody><% if(!payouts.length){%><tr><td colspan="4">No payout requests.</td></tr><%}%><% payouts.forEach(p=>{%><tr><td><%=p.publicId%></td><td class="workspace-money"><%=formatMoney(p.amountMinor,p.currency)%></td><td><%=p.status%><%if(p.failureMessage){%><br><small><%=p.failureMessage%></small><%}%></td><td><div class="catalog-actions"><%if(p.status==='requested'){%><form method="post" action="/finance/payouts/<%=p.publicId%>/approve"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Approve</button></form><form method="post" action="/finance/payouts/<%=p.publicId%>/reject"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="reason" required placeholder="Rejection reason"><button class="outline-button" type="submit">Reject</button></form><%}%><%if(p.status==='approved'){%><form method="post" action="/finance/payouts/<%=p.publicId%>/submit"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Submit transfer</button></form><form method="post" action="/finance/payouts/<%=p.publicId%>/reject"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="reason" required placeholder="Cancellation reason"><button class="outline-button" type="submit">Reject</button></form><%}%></div></td></tr><%})%></tbody></table></div></section>
<div class="role-content-grid"><section class="panel"><div class="role-panel-head"><div><h2>Refunds</h2></div></div><% if(!refunds.length){%><p>No refunds yet.</p><%}%><% refunds.forEach(r=>{%><article class="catalog-row"><div><strong><%=r.publicId%></strong><small><%=r.status%> · <span class="workspace-money"><%=formatMoney(r.amountMinor,r.currency)%></span> · <%=r.reason%><% if(r.provider==='cod_manual'){%> · COD manual disbursement<%}%></small></div><% if(r.provider==='cod_manual'&&r.status==='processing'){%><form method="post" action="/finance/refunds/<%=r.publicId%>/manual-complete" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Disbursement reference<input name="reference" minlength="4" maxlength="180" required placeholder="Cash receipt or Mobile Money reference"></label><button type="submit">Confirm refund paid</button></form><%}%></article><%})%></section><section class="panel"><div class="role-panel-head"><div><h2>Reconciliation runs</h2></div></div><% if(!reconciliations.length){%><p>No reconciliation runs yet.</p><%}%><% reconciliations.forEach(r=>{%><article class="catalog-row"><div><strong><%=r.publicId%> · <%=r.status%></strong><small>checked <%=r.checked%> · matched <%=r.matched%> · updated <%=r.updated%> · failed <%=r.failed%></small></div></article><%})%></section></div>
<section class="panel"><div class="role-panel-head"><div><h2>Ledger accounts</h2><p>Country-scoped financial accounts.</p></div></div><div class="table-wrap"><table><thead><tr><th>Code</th><th>Owner</th><th>Currency</th><th>Type</th></tr></thead><tbody><% if(!accounts.length){%><tr><td colspan="4">No ledger accounts yet.</td></tr><%}%><% accounts.forEach(a=>{%><tr><td><%=a.code%></td><td><%=a.ownerType%> · <%=a.ownerPublicId||'platform'%></td><td><%=a.currency%></td><td><%=a.type%></td></tr><%})%></tbody></table></div></section>
<section class="panel"><div class="role-panel-head"><div><h2>Recent ledger transactions</h2></div></div><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Description</th><th>Currency</th><th>Posted</th></tr></thead><tbody><% if(!transactions.length){%><tr><td colspan="4">No posted transactions yet.</td></tr><%}%><% transactions.forEach(t=>{%><tr><td><%=t.referenceType%> · <%=t.referencePublicId%></td><td><%=t.description%></td><td><%=t.currency%></td><td><%=formatDate(t.postedAt)%></td></tr><%})%></tbody></table></div></section>
</main><script src="/image-fallback.js"></script></body></html>
