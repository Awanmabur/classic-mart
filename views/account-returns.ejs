<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Returns &amp; Support · Classic Mart</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/account.css"></head><body class="account-body"><%-include('partials/account-top')%><%-include('partials/account-nav',{accountSection:'returns'})%><main class="account-wrap account-main"><%if(flash){%><div class="account-flash <%=flash.type==='error'?'error':''%>"><strong><%=flash.message%></strong><%if(flash.details){%><div class="account-note"><%=flash.details%></div><%}%></div><%}%><div class="account-heading"><h1>Returns &amp; support</h1><p>Manage your own returns, disputes, support tickets, reviews and trust reports.</p></div><div class="account-grid">
<section class="account-card"><h2>Request a return</h2><%if(!returnableLines.length){%><div class="account-empty">No delivered order lines are currently returnable.</div><%}else{%><form class="account-form" method="post" action="/account/returns"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Item<select name="returnLine" required><%returnableLines.forEach(line=>{%><option value="<%=line.orderPublicId%>::<%=line.orderLineId%>"><%=line.title%><%=line.variantTitle?` · ${line.variantTitle}`:''%> · max <%=line.remaining%></option><%})%></select></label><label>Quantity<input type="number" name="quantity" value="1" min="1" required></label><label>Reason<select name="reason"><option value="damaged">Damaged</option><option value="wrong_item">Wrong item</option><option value="not_as_described">Not as described</option><option value="counterfeit_suspected">Counterfeit suspected</option><option value="missing_parts">Missing parts</option><option value="changed_mind">Changed mind</option><option value="other">Other</option></select></label><label>Resolution<select name="resolution"><option value="refund">Refund</option><option value="exchange">Exchange</option></select></label><label>Return method<select name="returnMethod"><option value="dropoff">Drop off</option><option value="pickup">Pickup</option></select></label><label>Drop-off point (optional)<input name="dropoffPointId" maxlength="100"></label><label>Details<textarea name="details" minlength="10" maxlength="2000" rows="4" required></textarea></label><button class="account-button primary" type="submit">Submit return</button></form><%}%></section>
<section class="account-card"><h2>Open a support ticket</h2><form class="account-form" method="post" action="/account/support"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Order (optional)<select name="orderId"><option value="">No order</option><%orders.forEach(order=>{%><option value="<%=order.publicId%>"><%=order.publicId%></option><%})%></select></label><label>Category<select name="category"><%['order','payment','delivery','return','refund','account','product','seller','other'].forEach(x=>{%><option value="<%=x%>"><%=x.replaceAll('_',' ')%></option><%})%></select></label><label>Subject<input name="subject" minlength="4" maxlength="180" required></label><label>Priority<select name="priority"><option value="normal">Normal</option><option value="low">Low</option><option value="high">High</option><option value="urgent">Urgent</option></select></label><label>Message<textarea name="message" minlength="10" maxlength="2000" rows="4" required></textarea></label><button class="account-button primary" type="submit">Create ticket</button></form></section>
<section class="account-card"><h2>Open a dispute</h2><form class="account-form" method="post" action="/account/disputes"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Order<select name="orderId" required><%orders.forEach(order=>{%><option value="<%=order.publicId%>"><%=order.publicId%></option><%})%></select></label><label>Category<select name="category"><%['payment','delivery','item_missing','wrong_item','damaged','counterfeit','refund','seller_conduct','other'].forEach(x=>{%><option value="<%=x%>"><%=x.replaceAll('_',' ')%></option><%})%></select></label><label>Subject<input name="subject" minlength="4" maxlength="180" required></label><label>Description<textarea name="description" minlength="10" maxlength="3000" rows="4" required></textarea></label><button class="account-button primary" type="submit">Open dispute</button></form></section>
<section class="account-card"><h2>Review a purchased product</h2><%if(!reviewableLines.length){%><div class="account-empty">No delivered products are ready for review.</div><%}else{%><form class="account-form" method="post" action="/account/reviews"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Product<select name="reviewLine"><%reviewableLines.forEach(line=>{%><option value="<%=line.orderPublicId%>::<%=line.productPublicId%>"><%=line.title%><%=line.variantTitle?` · ${line.variantTitle}`:''%></option><%})%></select></label><label>Rating<select name="rating"><option value="5">5</option><option value="4">4</option><option value="3">3</option><option value="2">2</option><option value="1">1</option></select></label><label>Title<input name="title" maxlength="140"></label><label>Review<textarea name="body" minlength="10" maxlength="2500" rows="4" required></textarea></label><button class="account-button primary" type="submit">Submit review</button></form><%}%></section>
<section class="account-card wide"><h2>Report a trust or safety issue</h2><form class="account-form" method="post" action="/account/trust-report"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><div class="row"><label>Issue<select name="type"><option value="counterfeit">Counterfeit</option><option value="prohibited_product">Prohibited product</option><option value="unsafe_product">Unsafe product</option><option value="review_manipulation">Review manipulation</option><option value="seller_conduct">Seller conduct</option></select></label><label>Product ID<input name="productId" maxlength="100" placeholder="Product public ID"></label></div><label>Store ID (use when reporting seller conduct)<input name="storeId" maxlength="100"></label><label>Description<textarea name="description" minlength="10" maxlength="2500" rows="4" required></textarea></label><button class="account-button primary" type="submit">Submit report</button></form></section>
<section class="account-card wide"><h2>Your return requests</h2><div class="account-list"><%if(!returns.length){%><div class="account-empty">No returns yet.</div><%}%><%returns.forEach(row=>{%><article class="account-item"><div><strong><%=row.publicId%> · <%=row.status%></strong><p><%=row.reason?.replaceAll('_',' ')%> · <%=row.resolution%></p><%if(returnPickupCodes[row.publicId]){%><p><strong>Pickup code:</strong> <%=returnPickupCodes[row.publicId].pickupCode%></p><%}%><%if(row.evidenceDocumentIds?.length){%><p><%row.evidenceDocumentIds.forEach(doc=>{%><a class="account-link" href="/evidence/<%=doc.publicId%>"><%=doc.description||'Evidence'%></a> <%})%></p><%}%></div><%if(!['refunded','rejected','closed'].includes(row.status)){%><form class="account-form" method="post" enctype="multipart/form-data" action="/account/returns/<%=row.publicId%>/evidence"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="file" name="document" accept="image/jpeg,image/png,image/webp,image/avif" required><input name="description" maxlength="300" value="Return evidence"><button class="account-button" type="submit">Upload evidence</button></form><%}%></article><%})%></div></section>
<section class="account-card wide"><h2>Disputes</h2><div class="account-list"><%if(!disputes.length){%><div class="account-empty">No disputes yet.</div><%}%><%disputes.forEach(row=>{%><article class="account-item"><div><strong><%=row.publicId%> · <%=row.status%></strong><p><%=row.subject%></p></div><%if(['resolved','rejected','closed'].includes(row.status)){%><form class="account-form" method="post" action="/account/disputes/<%=row.publicId%>/appeal"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><textarea name="message" minlength="10" maxlength="1500" required placeholder="Explain the appeal"></textarea><button class="account-button" type="submit">Appeal</button></form><%}%></article><%})%></div></section>
<section class="account-card wide"><h2>Support tickets</h2><div class="account-list"><%if(!tickets.length){%><div class="account-empty">No support tickets yet.</div><%}%><%tickets.forEach(row=>{%><article class="account-item"><div><strong><%=row.publicId%> · <%=row.status%></strong><p><%=row.subject%></p><%if(['resolved','closed'].includes(row.status)){%><form class="account-form" method="post" action="/account/support/<%=row.publicId%>/reopen"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><textarea name="message" minlength="3" maxlength="2000" required placeholder="What still needs help?"></textarea><button class="account-button" type="submit">Reopen ticket</button></form><%}%><%if(!surveyByTicket[row.publicId]&&['resolved','closed'].includes(row.status)){%><form class="account-form" method="post" action="/account/support/<%=row.publicId%>/csat"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="rating"><option value="5">5 - Excellent</option><option value="4">4</option><option value="3">3</option><option value="2">2</option><option value="1">1 - Poor</option></select><input name="comment" maxlength="1000" placeholder="Optional feedback"><button class="account-button" type="submit">Rate support</button></form><%}%></div></article><%})%></div></section>
<section class="account-card wide"><h2>Trust reports</h2><div class="account-list"><%if(!cases.length){%><div class="account-empty">No trust reports yet.</div><%}%><%cases.forEach(row=>{%><article class="account-item"><div><strong><%=row.publicId%> · <%=row.status%></strong><p><%=row.type?.replaceAll('_',' ')%> · <%=row.description%></p><%if(row.decision){%><p><strong>Decision:</strong> <%=row.decision%></p><%}%></div><%if(['actioned','dismissed','closed'].includes(row.status)){%><form class="account-form" method="post" action="/account/trust-cases/<%=row.publicId%>/appeal"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><textarea name="message" minlength="10" maxlength="1500" required placeholder="Explain the appeal"></textarea><button class="account-button" type="submit">Appeal</button></form><%}%></article><%})%></div></section>
</div></main></body></html>
