<!doctype html>
<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>Returns & Support — Classic Mart</title>
  <link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css">
</head>
<body data-operations-ui="true"><main class="catalog-workspace">
<header class="catalog-topbar"><div><a class="brand" href="/"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p>Buyer protection</p></div><div class="catalog-actions"><a class="outline-button" href="/track-order">Track order</a><a class="outline-button" href="/dashboard">Dashboard</a></div></header>
<section class="catalog-page-head panel"><div><span class="eyebrow">Returns, disputes &amp; support</span><h1>Buyer protection centre</h1><p>Returns, evidence, exchanges, disputes, reviews and support are tied to your real server-side order history.</p></div></section>

<div class="role-content-grid">
<section class="panel"><div class="role-panel-head"><div><h2>Open a return</h2><p>The purchase-time policy snapshot controls eligibility and return window.</p></div></div>
<form method="post" action="/account/returns" class="catalog-form">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Delivered item<select name="returnLine" required><option value="">Select a delivered item</option><% returnableLines.forEach(line=>{ %><option value="<%= line.orderPublicId %>::<%= line.orderLineId %>"><%= line.orderPublicId %> · <%= line.title %><%= line.variantTitle ? ` — ${line.variantTitle}` : `` %> · SKU <%= line.sku %> · returnable <%= line.remaining %></option><% }) %></select></label>
<label>Quantity<input name="quantity" type="number" min="1" max="99" value="1" required></label>
<label>Reason<select name="reason"><option value="damaged">Damaged</option><option value="wrong_item">Wrong item</option><option value="not_as_described">Not as described</option><option value="counterfeit_suspected">Counterfeit suspected</option><option value="missing_parts">Missing parts</option><option value="changed_mind">Changed mind</option><option value="other">Other</option></select></label>
<label>Resolution<select name="resolution"><option value="refund">Refund</option><option value="exchange">Exchange</option></select></label>
<label>Return method<select name="returnMethod"><option value="dropoff">Drop off</option><option value="pickup">Pickup</option></select></label>
<label>Drop-off point ID (when applicable)<input name="dropoffPointId" maxlength="100" placeholder="Pickup/drop-off point public ID"></label>
<label>What happened<textarea name="details" minlength="10" maxlength="2000" required></textarea></label>
<button type="submit">Submit return</button></form></section>

<section class="panel"><div class="role-panel-head"><div><h2>Contact support</h2><p>Creates a real ticket with priority and SLA tracking.</p></div></div>
<form method="post" action="/account/support" class="catalog-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Order ID (optional)<input name="orderId"></label><label>Category<select name="category"><option value="order">Order</option><option value="payment">Payment</option><option value="delivery">Delivery</option><option value="return">Return</option><option value="refund">Refund</option><option value="account">Account</option><option value="product">Product</option><option value="seller">Seller</option><option value="other">Other</option></select></label><label>Priority<select name="priority"><option value="normal">Normal</option><option value="high">High</option><option value="urgent">Urgent</option><option value="low">Low</option></select></label><label>Subject<input name="subject" minlength="4" maxlength="180" required></label><label>Message<textarea name="message" minlength="10" maxlength="2000" required></textarea></label><button type="submit">Open ticket</button></form></section>
</div>

<div class="role-content-grid">
<section class="panel"><div class="role-panel-head"><div><h2>Raise a dispute</h2><p>Use the dispute timeline when an order issue needs formal resolution.</p></div></div><form method="post" action="/account/disputes" class="catalog-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Order ID<input name="orderId" required></label><label>Category<select name="category"><option value="payment">Payment</option><option value="delivery">Delivery</option><option value="item_missing">Item missing</option><option value="wrong_item">Wrong item</option><option value="damaged">Damaged</option><option value="counterfeit">Counterfeit</option><option value="refund">Refund</option><option value="seller_conduct">Seller conduct</option><option value="other">Other</option></select></label><label>Subject<input name="subject" minlength="4" required></label><label>Description<textarea name="description" minlength="10" maxlength="3000" required></textarea></label><button type="submit">Open dispute</button></form></section>
<section class="panel"><div class="role-panel-head"><div><h2>Verified purchase review</h2><p>Only items with verified delivery are selectable. Seller self-reviews remain blocked.</p></div></div><form method="post" action="/account/reviews" class="catalog-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Delivered item<select name="reviewLine" required><option value="">Select a delivered item</option><% reviewableLines.forEach(line=>{ %><option value="<%= line.orderPublicId %>::<%= line.productPublicId %>"><%= line.orderPublicId %> · <%= line.title %><%= line.variantTitle ? ` — ${line.variantTitle}` : `` %> · SKU <%= line.sku %></option><% }) %></select></label><label>Rating<select name="rating"><option value="5">5</option><option value="4">4</option><option value="3">3</option><option value="2">2</option><option value="1">1</option></select></label><label>Title<input name="title" maxlength="140"></label><label>Review<textarea name="body" minlength="10" maxlength="2500" required></textarea></label><button type="submit">Submit review</button></form></section>
</div>

<section class="panel"><div class="role-panel-head"><div><h2>Your returns</h2><p>Upload evidence privately after opening a case. Pickup codes only appear while a return pickup is active.</p></div></div>
<% if(!returns.length){ %><p>No return requests yet.</p><% } %>
<% returns.forEach(r=>{ %><article class="catalog-row"><div><strong><%= r.publicId %> · Order <%= r.orderPublicId %></strong><small><%= r.reason %> · <%= r.resolution %> · <%= r.returnMethod %> · <%= r.status %> · eligible until <%= formatDate(r.eligibleUntil) %></small>
<% if(r.replacementOrderPublicId){ %><small>Replacement order: <%= r.replacementOrderPublicId %></small><% } %>
<% if(returnPickupCodes[r.publicId]){ %><small>Return pickup shipment <%= returnPickupCodes[r.publicId].shipmentId %> · pickup code <strong><%= returnPickupCodes[r.publicId].pickupCode %></strong></small><% } %>
<% if(r.evidenceDocumentIds?.length){ %><small>Evidence: <% r.evidenceDocumentIds.forEach((e,idx)=>{ %><%= idx ? ' · ' : '' %><a href="/evidence/<%=e.publicId%>"><%= e.description || e.publicId %></a><% }) %></small><% } %></div>
<% if(!['rejected','refunded','exchanged','closed'].includes(r.status)){ %><form method="post" action="/account/returns/<%=r.publicId%>/evidence" enctype="multipart/form-data" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Evidence image<input type="file" name="document" accept="image/jpeg,image/png,image/webp" required></label><label>Description<input name="description" maxlength="300" required></label><button type="submit">Upload evidence</button></form><% } %></article><% }) %>
<% if(queuePages?.returns){%><div class="server-pager"><small>Showing <%=queuePages.returns.count%> of <%=queuePages.returns.total%> return requests</small><% if(queuePages.returns.hasMore){%><a class="outline-button" href="/account/returns?returnsAfter=<%=encodeURIComponent(queuePages.returns.next)%>">Older returns</a><%}%></div><%}%></section>

<div class="role-content-grid">
<section class="panel"><div class="role-panel-head"><div><h2>Disputes</h2><p>Evidence remains private to you and authorized support/trust operators.</p></div></div><% if(!disputes.length){%><p>No disputes open.</p><%}%><% disputes.forEach(d=>{%><article class="catalog-row"><div><strong><%=d.subject%></strong><small><%=d.publicId%> · Order <%=d.orderPublicId%> · <%=d.status%></small><% if(d.evidenceDocumentIds?.length){%><small>Evidence: <% d.evidenceDocumentIds.forEach((e,idx)=>{%><%=idx?' · ':''%><a href="/evidence/<%=e.publicId%>"><%=e.description||e.publicId%></a><%})%></small><%}%></div><form method="post" action="/account/evidence/dispute/<%=d.publicId%>" enctype="multipart/form-data" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Add evidence<input type="file" name="document" accept="image/jpeg,image/png,image/webp" required></label><input name="description" maxlength="300" required placeholder="What does this show?"><button type="submit">Upload</button></form><% if(['resolved','rejected','closed'].includes(d.status)){ %><form method="post" action="/account/disputes/<%=d.publicId%>/appeal"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="message" minlength="10" maxlength="1500" required placeholder="Why should this decision be reviewed?"><button type="submit">Appeal</button></form><% } %></article><%})%><% if(queuePages?.disputes){%><div class="server-pager"><small>Showing <%=queuePages.disputes.count%> of <%=queuePages.disputes.total%> disputes</small><% if(queuePages.disputes.hasMore){%><a class="outline-button" href="/account/returns?disputesAfter=<%=encodeURIComponent(queuePages.disputes.next)%>">Older disputes</a><%}%></div><%}%></section>
<section class="panel"><div class="role-panel-head"><div><h2>Support tickets</h2><p>Attach screenshots or photos to the real support timeline instead of sending them outside the platform.</p></div></div><% if(!tickets.length){%><p>No support tickets.</p><%}%><% tickets.forEach(t=>{%><article class="catalog-row"><div><strong><%=t.subject%></strong><small><%=t.publicId%> · <%=t.status%> · SLA <%=formatDate(t.slaDueAt)%></small><% if(t.evidenceDocumentIds?.length){%><small>Evidence: <% t.evidenceDocumentIds.forEach((e,idx)=>{%><%=idx?' · ':''%><a href="/evidence/<%=e.publicId%>"><%=e.description||e.publicId%></a><%})%></small><%}%></div><% if(!['closed'].includes(t.status)){%><form method="post" action="/account/evidence/support/<%=t.publicId%>" enctype="multipart/form-data" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Add evidence<input type="file" name="document" accept="image/jpeg,image/png,image/webp" required></label><input name="description" maxlength="300" required placeholder="What does this show?"><button type="submit">Upload</button></form><%}%><% if(['resolved','closed'].includes(t.status)){ %><form method="post" action="/account/support/<%=t.publicId%>/reopen" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="message" minlength="3" maxlength="2000" required placeholder="What still needs help?"><button type="submit">Reopen ticket</button></form><% } %><% if(['resolved','closed'].includes(t.status) && !surveyByTicket[t.publicId]){ %><form method="post" action="/account/support/<%=t.publicId%>/csat"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="rating"><option value="5">5 — Excellent</option><option value="4">4 — Good</option><option value="3">3 — Okay</option><option value="2">2 — Poor</option><option value="1">1 — Very poor</option></select><input name="comment" maxlength="1000" placeholder="Optional feedback"><button type="submit">Rate support</button></form><% } else if(surveyByTicket[t.publicId]) { %><span class="status-chip">Rated <%=surveyByTicket[t.publicId].rating%>/5</span><% } %></article><%})%><% if(queuePages?.tickets){%><div class="server-pager"><small>Showing <%=queuePages.tickets.count%> of <%=queuePages.tickets.total%> support tickets</small><% if(queuePages.tickets.hasMore){%><a class="outline-button" href="/account/returns?ticketsAfter=<%=encodeURIComponent(queuePages.tickets.next)%>">Older tickets</a><%}%></div><%}%></section>
</div>

<section class="panel"><div class="role-panel-head"><div><h2>Report a marketplace trust issue</h2><p>Counterfeit, unsafe, prohibited, manipulated-review and seller-conduct reports create auditable trust/risk cases.</p></div></div><form method="post" action="/account/trust-report" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Issue type<select name="type"><option value="counterfeit">Counterfeit</option><option value="prohibited_product">Prohibited product</option><option value="unsafe_product">Unsafe product</option><option value="review_manipulation">Review manipulation</option><option value="seller_conduct">Seller conduct</option></select></label><label>Product ID<input name="productId"></label><label>Store ID<input name="storeId"></label><label>Description<textarea name="description" minlength="10" maxlength="2500" required></textarea></label><button type="submit">Submit report</button></form></section>
<section class="panel"><div class="role-panel-head"><div><h2>Your trust reports</h2><p>Add private evidence, follow the investigation decision and appeal a closed decision when needed.</p></div></div><% if(!cases?.length){%><p>No trust reports yet.</p><%}%><% (cases||[]).forEach(c=>{%><article class="catalog-row"><div><strong><%=c.type.replaceAll('_',' ')%></strong><small><%=c.publicId%> · <%=c.status%> · <%=c.productPublicId||c.storePublicId||''%></small><% if(c.decision){%><small>Decision: <%=c.decision%></small><%}%><% if(c.evidenceDocumentIds?.length){%><small>Evidence: <% c.evidenceDocumentIds.forEach((e,idx)=>{%><%=idx?' · ':''%><a href="/evidence/<%=e.publicId%>"><%=e.description||e.publicId%></a><%})%></small><%}%></div><% if(!['closed'].includes(c.status)){%><form method="post" action="/account/evidence/trust_case/<%=c.publicId%>" enctype="multipart/form-data" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Add evidence<input type="file" name="document" accept="image/jpeg,image/png,image/webp" required></label><input name="description" maxlength="300" required placeholder="What does this show?"><button type="submit">Upload</button></form><%}%><% if(['actioned','dismissed','closed'].includes(c.status)){%><form method="post" action="/account/trust-cases/<%=c.publicId%>/appeal" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Appeal this decision<textarea name="message" minlength="10" maxlength="1500" required placeholder="Explain what should be reviewed and why."></textarea></label><button type="submit">Submit appeal</button></form><%}%></article><%})%><% if(queuePages?.cases){%><div class="server-pager"><small>Showing <%=queuePages.cases.count%> of <%=queuePages.cases.total%> trust reports</small><% if(queuePages.cases.hasMore){%><a class="outline-button" href="/account/returns?casesAfter=<%=encodeURIComponent(queuePages.cases.next)%>">Older reports</a><%}%></div><%}%></section>

<section class="panel"><div class="role-panel-head"><div><h2>Eligible order references</h2><p>Use these server-issued IDs above.</p></div></div><div class="table-wrap"><table><thead><tr><th>Order</th><th>Status</th><th>Products</th><th>Total</th></tr></thead><tbody><% if(!orders.length){%><tr><td colspan="4">No orders available.</td></tr><%}%><% orders.forEach(o=>{%><tr><td><%=o.publicId%></td><td><%=o.status%></td><td><% o.items.forEach((i,idx)=>{ %><%= idx?', ':'' %><%= i.title %> (<%= i.productPublicId %>)<% }) %></td><td class="workspace-money"><%=formatMoney(o.totals.totalMinor,o.totals.currency)%></td></tr><%})%></tbody></table></div><% if(queuePages?.orders){%><div class="server-pager"><small>Showing <%=queuePages.orders.count%> of <%=queuePages.orders.total%> orders</small><% if(queuePages.orders.hasMore){%><a class="outline-button" href="/account/returns?ordersAfter=<%=encodeURIComponent(queuePages.orders.next)%>">Older orders / delivered items</a><%}%></div><%}%></section>
</main><script src="/image-fallback.js"></script><script src="/operations-ui.js" defer></script></body></html>
