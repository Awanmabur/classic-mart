<!doctype html><html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Wallet & Payouts — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"></head><body><main class="catalog-workspace"><header class="catalog-topbar"><div><a class="brand" href="/dashboard"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p>Wallet &amp; payouts</p></div><a class="outline-button" href="/dashboard">Dashboard</a></header><section class="catalog-page-head panel"><div><span class="eyebrow">Ledger-backed money</span><h1>Balances &amp; payout requests</h1><p>Available balances are derived from immutable ledger entries. A payout request immediately reserves the amount so it cannot be requested twice.</p></div></section>
<div class="stats-grid"><% if(!accounts.length){%><article class="stat-card"><span>Available</span><strong>0</strong></article><%}%><% accounts.forEach(a=>{%><article class="stat-card"><span><%=a.code%> · <%=a.currency%></span><strong class="workspace-money"><%=formatMoney(a.balanceMinor,a.currency)%></strong></article><%})%></div>
<div class="role-content-grid"><section class="panel"><div class="role-panel-head"><div><h2>Add payout destination</h2><p>The destination is encrypted at application level and remains pending until finance verification.</p></div></div><form method="post" action="/money/payout-accounts" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Method<select name="method"><option value="mobile_money">Mobile Money</option><option value="bank">Bank</option></select></label><label>Label<input name="label" minlength="2" maxlength="100" required placeholder="Primary payout account"></label><label>Bank code (bank only)<input name="account_bank" maxlength="40"></label><label>Network (mobile money only)<input name="network" maxlength="40" placeholder="MTN / Airtel"></label><label>Account number (bank only)<input name="account_number" maxlength="80"></label><label>Phone (mobile money only)<input name="phone" maxlength="32"></label><label>Beneficiary name<input name="beneficiary_name" minlength="2" maxlength="120" required></label><button type="submit">Save destination</button></form></section>
<section class="panel"><div class="role-panel-head"><div><h2>Request payout</h2><p>Only finance-verified destinations can receive a request.</p></div></div><form method="post" action="/money/payouts" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Verified destination<select name="payoutAccountId" required><option value="">Select destination</option><% payoutAccounts.filter(a=>a.status==='verified').forEach(a=>{%><option value="<%=a.publicId%>"><%=a.label%> · <%=a.method%></option><%})%></select></label><label>Amount in minor units<input type="number" name="amountMinor" min="1" required></label><label>Idempotency key<input name="idempotencyKey" minlength="12" maxlength="120" required value="payout-<%=Date.now()%>"></label><button type="submit">Request payout</button></form></section></div>
<section class="panel"><h2>Payout destinations</h2><div class="table-wrap"><table><thead><tr><th>Destination</th><th>Method</th><th>Status</th><th>Currency</th></tr></thead><tbody><% if(!payoutAccounts.length){%><tr><td colspan="4">No payout destinations.</td></tr><%}%><% payoutAccounts.forEach(a=>{%><tr><td><%=a.label%><br><small><%=a.publicId%></small></td><td><%=a.method%></td><td><%=a.status%></td><td><%=a.currency%></td></tr><%})%></tbody></table></div></section>
<section class="panel"><h2>Payout history</h2><div class="table-wrap"><table><thead><tr><th>Payout</th><th>Amount</th><th>Status</th><th>Requested</th></tr></thead><tbody><% if(!payouts.length){%><tr><td colspan="4">No payout requests.</td></tr><%}%><% payouts.forEach(p=>{%><tr><td><%=p.publicId%></td><td class="workspace-money"><%=formatMoney(p.amountMinor,p.currency)%></td><td><%=p.status%><%if(p.failureMessage){%><br><small><%=p.failureMessage%></small><%}%></td><td><%=formatDate(p.requestedAt)%></td></tr><%})%></tbody></table></div></section>
</main></body></html>
