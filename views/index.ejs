<!DOCTYPE html>

<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<% if (typeof productMeta !== "undefined" && productMeta) { %><base href="/"/><% } %>
<meta content="<%= typeof productMeta !== 'undefined' && productMeta ? productMeta.description : 'Classic Mart multi-vendor ecommerce marketplace with verified sellers, real inventory and buyer protection.' %>" name="description"/>
<meta content="#ff6200" name="theme-color"/>
<link href="/manifest.webmanifest" rel="manifest"/>
<title><%= typeof productMeta !== 'undefined' && productMeta ? `${productMeta.name} — Classic Mart` : 'Classic Mart — Everything, for everyone' %></title>
<% if (typeof productMeta !== "undefined" && productMeta) { %><link rel="canonical" href="<%= productMeta.canonical %>"/><meta property="og:type" content="product"/><meta property="og:title" content="<%= productMeta.name %> — Classic Mart"/><meta property="og:description" content="<%= productMeta.description %>"/><meta property="og:image" content="<%= productMeta.image %>"/><script type="application/ld+json" nonce="<%= cspNonce %>"><%- productMeta.jsonLd %></script><% } %>
<link href="/styles.css" rel="stylesheet"/>
<link href="/storefront-pages.css" rel="stylesheet"/>
</head>
<body class="home-page">
<a class="skip-link" href="#mainContent">Skip to content</a>
<div class="utility-bar">
<div class="container utility-inner">
<button class="utility-location text-button" data-open="locationModal" type="button">
<img alt="" aria-hidden="true" src="/assets/icons/location-dot.svg"/>
        Deliver to <strong id="deliveryLocation"><%= deliveryLocation || country?.name || "Uganda" %></strong>
</button>
<div class="shipping-note">
<img alt="" aria-hidden="true" src="/assets/icons/truck-fast.svg"/>
<strong>Delivery pricing</strong> calculated for your country at checkout
      </div>
<nav aria-label="Utility navigation" class="utility-links">
<a class="text-button" href="/signup?role=seller">Sell on Classic Mart</a>
<a class="text-button utility-text-link" href="/sellers">Seller Center</a><a class="text-button utility-text-link" href="/promoters">Promoters Center</a>
<a class="text-button" href="/track-order">Track Order</a>
<a class="text-button" href="/help">Help &amp; Support</a>
<button aria-expanded="false" class="language-button" id="languageButton" type="button">
<img alt="" aria-hidden="true" src="/assets/icons/globe.svg"/> <%= country?.locale?.split("-")[0].toUpperCase() || "EN" %> | <%= currency || country?.currency || "UGX" %>
          <img alt="" aria-hidden="true" class="tiny-icon" src="/assets/icons/chevron-down.svg"/>
</button>
</nav>
</div>
</div>
<header class="site-header" id="top">
<div class="container header-main">
<a aria-label="Classic Mart home" class="brand" href="#top">
<img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/>
<small>Everything, for everyone</small>
</a>
<form class="search-bar" id="searchForm" role="search">
<label class="sr-only" for="searchCategory">Product category</label>
<select aria-label="Product category" class="category-select" id="searchCategory">
<option value="all">Loading categories…</option>
</select>
<label class="sr-only" for="searchInput">Search products</label>
<input autocomplete="off" id="searchInput" placeholder="Search for products, brands and more..." type="search"/>
<div class="search-tool-actions" aria-label="Alternative search options">
<button aria-label="Search by image" class="search-tool-button" data-image-search type="button" title="Search by image"><img alt="" aria-hidden="true" src="/assets/icons/camera.svg"/></button>
<button aria-label="Search by voice" class="search-tool-button" data-voice-search type="button" title="Search by voice"><img alt="" aria-hidden="true" src="/assets/icons/microphone.svg"/></button>
<input accept="image/jpeg,image/png,image/webp,image/avif" class="sr-only" data-image-search-input type="file"/>
</div>
<button class="search-button" type="submit">
<img alt="" aria-hidden="true" src="/assets/icons/magnifying-glass.svg"/><span>Search</span>
</button>
<div aria-label="Search suggestions" class="search-suggestions" id="searchSuggestions" role="listbox"></div>
</form>
<div class="header-actions">
<a aria-label="Open your Classic Mart profile" class="header-action header-action-link" href="/dashboard">
<span class="header-action-icon"><img alt="" aria-hidden="true" src="/assets/icons/user.svg"/></span>
<span class="header-action-copy"><small>Your account</small><strong>Profile</strong></span>
<img alt="" aria-hidden="true" class="header-chevron" src="/assets/icons/chevron-right.svg"/>
</a>
<a aria-label="Open your wishlist" class="header-action wishlist-trigger" href="/wishlist"><span class="header-action-icon"><img alt="" aria-hidden="true" src="/assets/icons/heart-regular.svg"/></span><span class="header-action-copy"><small>Saved items</small><strong>Wishlist</strong></span><b class="count-badge wishlist-count-badge" data-wishlist-count="">0</b></a><a aria-label="Open your full cart and checkout" class="header-action cart-trigger" href="/cart" id="cartTrigger">
<span class="header-action-icon"><img alt="" aria-hidden="true" src="/assets/icons/cart-shopping.svg"/></span>
<span class="header-action-copy"><small>Your basket</small><strong>Cart</strong></span>
<b class="count-badge" id="cartCount">0</b>
</a>
</div>
</div>
<div class="nav-shell">
<div class="container nav-inner">
<button aria-controls="categoryPanel" aria-expanded="false" class="browse-button" id="menuToggle" type="button">
<img alt="" aria-hidden="true" src="/assets/icons/bars.svg"/>
<span>Browse Categories</span>
<img alt="" aria-hidden="true" class="browse-chevron" src="/assets/icons/chevron-down.svg"/>
</button>
<nav aria-label="Primary navigation" class="primary-nav" id="primaryNav">
<span class="primary-nav-main">
<a class="active" href="#top">Home</a>
<a href="#categories">Categories <span class="tiny-badge" id="categoryCountBadge"><%= initialStorefront?.categories?.length || 0 %></span></a>
<a href="#daily-deals">Flash Deals <span class="hot-badge">HOT</span></a>
<a href="#new-arrivals">New Arrivals</a>
<a href="#brands">Top Brands</a>
<a href="#features">Features <img alt="" aria-hidden="true" src="/assets/icons/chevron-down.svg"/></a>
<a href="/ask-classic">Ask Classic</a><a href="/wishlist">Wishlist</a><a href="/compare">Compare</a></span>
<span aria-label="Featured marketplace links" class="primary-nav-end">
<a href="#daily-deals">Best Deals</a>
<a class="classic-live-link" href="#fresh-finds"><span aria-hidden="true" class="live-dot"></span>Classic Live</a>
</span>
</nav>

</div>
</div>
</header>
<main id="mainContent">
<div class="container">
<section aria-label="Featured shopping deals" class="hero-grid">
<aside aria-label="Product categories" class="category-panel" id="categoryPanel" data-dynamic-categories>
<button data-category="electronics" type="button"><img alt="" aria-hidden="true" src="/assets/icons/mobile-screen-button.svg"/><span>Electronics</span></button>
<button data-category="fashion" type="button"><img alt="" aria-hidden="true" src="/assets/icons/shirt.svg"/><span>Fashion</span></button>
<button data-category="home-living" type="button"><img alt="" aria-hidden="true" src="/assets/icons/house.svg"/><span>Home &amp; Kitchen</span></button>
<button data-category="beauty" type="button"><img alt="" aria-hidden="true" src="/assets/icons/wand-magic-sparkles.svg"/><span>Beauty &amp; Health</span></button>
<button data-category="sports-fitness" type="button"><img alt="" aria-hidden="true" src="/assets/icons/football.svg"/><span>Sports &amp; Outdoors</span></button>
<button data-category="toys" type="button"><img alt="" aria-hidden="true" src="/assets/icons/puzzle-piece.svg"/><span>Toys &amp; Games</span></button>
<button data-category="automotive" type="button"><img alt="" aria-hidden="true" src="/assets/icons/car.svg"/><span>Automotive</span></button>
<button data-category="books" type="button"><img alt="" aria-hidden="true" src="/assets/icons/book.svg"/><span>Books &amp; Stationery</span></button>
<button data-category="pets" type="button"><img alt="" aria-hidden="true" src="/assets/icons/paw.svg"/><span>Pet Supplies</span></button>
<button data-category="groceries" type="button"><img alt="" aria-hidden="true" src="/assets/icons/basket-shopping.svg"/><span>Groceries</span></button>
<a class="view-all" href="#categories"><img alt="" aria-hidden="true" src="/assets/icons/table-cells-large.svg"/><span>View All Categories</span><img alt="" aria-hidden="true" src="/assets/icons/chevron-right.svg"/></a>
</aside>
<div class="hero-slider" id="heroSlider">
<div class="hero-track" id="heroTrack">
<% const heroRows = (typeof homeHeroSlides !== 'undefined' && homeHeroSlides?.length) ? homeHeroSlides : []; %>
<% if (heroRows.length) { heroRows.forEach((slide, index) => { %>
<article class="hero-slide hero-slide-<%= ['a','b','c'][index % 3] %> <%= index===0?'is-active':'' %>">
<div class="hero-copy"><span class="eyebrow"><%= slide.data?.eyebrow || 'Classic Mart' %></span><<%= index===0?'h1':'h2' %>><%= slide.title %></<%= index===0?'h1':'h2' %>><p><%= slide.body %></p><button class="button button-light" data-category-jump="<%= slide.data?.category || 'all' %>" type="button"><%= slide.data?.action || 'Browse products' %></button></div>
<div aria-hidden="true" class="hero-products"><img alt="" class="hero-product hero-headphones" src="<%= slide.data?.image || '/assets/product-placeholder.svg' %>"/></div>
</article>
<% }); } else { %>
<article class="hero-slide hero-slide-a is-active"><div class="hero-copy"><span class="eyebrow">Classic Mart</span><h1>Live marketplace catalogue</h1><p>Products, prices and availability will appear here when the marketplace database is connected.</p><a class="button button-light" href="/products">Browse products</a></div></article>
<% } %>
</div>
<% if (heroRows.length > 1) { %><button aria-label="Previous slide" class="hero-arrow hero-prev" id="heroPrev" type="button"><img alt="" src="/assets/icons/chevron-left.svg"/></button><button aria-label="Next slide" class="hero-arrow hero-next" id="heroNext" type="button"><img alt="" src="/assets/icons/chevron-right.svg"/></button><div aria-label="Hero slides" class="hero-dots" id="heroDots"><% heroRows.forEach((_, index) => { %><button aria-label="Slide <%= index+1 %>" class="<%= index===0?'active':'' %>" data-slide="<%= index %>" type="button"></button><% }); %></div><% } %>
</div>
<div class="promo-stack"><% (initialStorefront?.categories || []).slice(0,3).forEach((category,index) => { %><button class="promo-card <%= ['promo-tech','promo-home','promo-beauty'][index] %>" data-category-jump="<%= category.id %>" type="button"><span><strong><%= category.name %></strong><small><%= category.count %> available product<%= category.count===1?'':'s' %></small><b>Browse</b></span><img alt="<%= category.name %>" src="<%= category.image || '/assets/product-placeholder.svg' %>"/></button><% }); %></div>
</section>
<section aria-label="Shopping benefits" class="benefits" id="features">
<article><span class="benefit-icon"><img alt="" src="/assets/icons/truck-fast.svg"/></span><div><strong>Delivery options</strong><small>Country-specific rates shown at checkout</small></div></article>
<article><span class="benefit-icon"><img alt="" src="/assets/icons/rotate-left.svg"/></span><div><strong>Returns workflow</strong><small>Eligibility is checked from each order policy</small></div></article>
<article><span class="benefit-icon"><img alt="" src="/assets/icons/lock.svg"/></span><div><strong>Secure Payments</strong><small>Protected checkout</small></div></article>
<article><span class="benefit-icon"><img alt="" src="/assets/icons/headset.svg"/></span><div><strong>Tracked support</strong><small>Requests enter the country SLA queue</small></div></article>
<article><span class="benefit-icon"><img alt="" src="/assets/icons/tags.svg"/></span><div><strong>Server-checked totals</strong><small>Price, stock and fees are revalidated</small></div></article>
</section>
<section class="store-section" id="categories">
<div class="section-heading">
<h2>Shop by Category</h2>
<div class="section-heading-actions">
<button aria-label="Jump to more categories" class="section-link category-more-button" data-category-more type="button"><span data-category-more-label>More</span> <img alt="" aria-hidden="true" src="/assets/icons/chevron-right.svg"/></button>
<button aria-label="Show more categories" class="section-next-button" data-scroll-next="categoryRow" type="button"><img alt="" aria-hidden="true" src="/assets/icons/chevron-right.svg"/></button>
<a class="section-link category-view-all" href="/categories">View All <img alt="" src="/assets/icons/chevron-right.svg"/></a>
</div>
</div>
<% const homepagePrimaryCategoryIds = ['electronics','fashion','home-living','beauty','sports-fitness','automotive','books','groceries','baby','office']; const homepagePrimaryCategories = homepagePrimaryCategoryIds.map(id => (initialStorefront?.categories || []).find(category => category.id === id)).filter(Boolean); const homepageExtraCategories = (initialStorefront?.categories || []).filter(category => !homepagePrimaryCategoryIds.includes(category.id)); const homepageOrderedCategories = [...homepagePrimaryCategories, ...homepageExtraCategories]; %>
<div class="category-row horizontal-scroll" id="categoryRow"><% homepageOrderedCategories.forEach(category => { %><button class="category-card" data-category-jump="<%= category.id %>" type="button"><span class="category-image"><img alt="<%= category.name %>" loading="lazy" decoding="async" src="<%= category.image || '/assets/product-placeholder.svg' %>"/></span><span><%= category.name %></span></button><% }); %></div>
</section>
<section class="store-section" id="trending">
<div class="section-heading">
<h2>Trending Products</h2>
<div class="section-heading-actions">
<button class="filter-button" id="filterButton" type="button"><img alt="" src="/assets/icons/filter.svg"/> Filter</button>
<button class="section-link" data-view-products="trending" type="button">View All <img alt="" src="/assets/icons/chevron-right.svg"/></button>
<button aria-label="Show more trending products" class="section-next-button" data-scroll-next="trendingGrid" type="button"><img alt="" src="/assets/icons/chevron-right.svg"/></button>
</div>
</div>
<div class="slider-shell">
<button aria-label="Previous products" class="slider-arrow prev" data-target="trendingGrid" type="button"><img alt="" src="/assets/icons/chevron-left.svg"/></button>
<div class="product-grid horizontal-scroll mobile-one-half" id="trendingGrid"><% if (typeof initialStorefront !== 'undefined' && initialStorefront?.products?.length) { initialStorefront.products.slice(0,12).forEach(product => { %><article class="product-card" data-product-preview="<%= product.id %>" data-product-id="<%= product.id %>" data-category="<%= product.category %>" data-brand="<%= product.brand %>" data-price="<%= product.price %>" data-rating="<%= product.rating || 0 %>" tabindex="0" role="button" aria-label="Open <%= product.name %> preview"><div class="product-image"><span class="product-badge badge-orange"><%= product.badge || 'Available' %></span><img alt="<%= product.name %>" loading="lazy" decoding="async" src="<%= product.image || '/assets/product-placeholder.svg' %>"/><span class="category-badge"><%= product.categoryName || product.category %></span><% if (Number(product.promoterCommissionBps || 0) > 0) { const promAmount = Number(product.price || 0) * Number(product.promoterCommissionBps || 0) / 10000; %><span class="promoter-badge" title="<%= product.sponsoredDisclosure || 'Promoters may earn this amount on qualifying purchases.' %>">Prom <%= product.currency %> <%= promAmount.toLocaleString(initialStorefront.country?.locale || 'en-UG', { maximumFractionDigits: ['UGX','RWF'].includes(product.currency) ? 0 : 2 }) %></span><% } else if (product.sponsored) { %><span class="promoter-badge" title="<%= product.sponsoredDisclosure || 'Sponsored placement.' %>">Sponsored</span><% } %></div><div class="product-info"><h3><%= product.name %></h3><div class="product-meta-row"><div class="price"><strong><%= product.currency %> <%= Number(product.price || 0).toLocaleString(initialStorefront.country?.locale || 'en-UG') %></strong></div><div class="rating"><span class="rating-star" aria-hidden="true">★</span><strong><%= product.reviews ? Number(product.rating || 0).toFixed(1) : 'New' %></strong><span>(<%= product.reviews || 0 %>)</span></div></div><button class="add-cart" data-add-cart="<%= product.id %>" type="button">Add to cart</button></div></article><% }); } %></div>
<button aria-label="Next products" class="slider-arrow next" data-target="trendingGrid" type="button"><img alt="" src="/assets/icons/chevron-right.svg"/></button>
</div>
</section>
<section class="daily-deals" id="daily-deals">
<div class="deal-intro">
<div>
<h2><img alt="" src="/assets/icons/bolt.svg"/> Daily Deals</h2>
<p>Limited time offers</p>
</div>
<div aria-label="Deal countdown" class="countdown">
<span><strong id="dealHours">00</strong><small>Hours</small></span>
<b>:</b>
<span><strong id="dealMinutes">00</strong><small>Mins</small></span>
<b>:</b>
<span><strong id="dealSeconds">00</strong><small>Secs</small></span>
</div>
<div class="deal-actions">
<button class="button button-outline-light" data-view-products="deals" type="button">View All Deals</button>
<button aria-label="Show more daily deals" class="section-next-button section-next-button-light" data-scroll-next="dealGrid" type="button"><img alt="" src="/assets/icons/chevron-right.svg"/></button>
</div>
</div>
<div class="deal-products horizontal-scroll mobile-two-half" id="dealGrid"></div>
</section>
<section class="store-section" id="brands">
<div class="section-heading"><h2>Top Brands</h2><div class="section-heading-actions"><button class="section-link" data-open="brandModal" type="button">View All Brands <img alt="" src="/assets/icons/chevron-right.svg"/></button><button aria-label="Show more brands" class="section-next-button" data-scroll-next="brandRow" type="button"><img alt="" src="/assets/icons/chevron-right.svg"/></button></div></div>
<div class="brand-row horizontal-scroll" id="brandRow"><% if (typeof initialStorefront !== 'undefined' && initialStorefront?.brands?.length) { initialStorefront.brands.forEach(brand => { %><button class="brand-card" data-brand="<%= brand.name %>" type="button"><span class="brand-wordmark"><%= brand.name %></span></button><% }); } %></div>
</section>
<section class="store-section" id="new-arrivals">
<div class="section-heading">
<div class="heading-with-note"><h2>Recommended for You</h2><span>Ranked from live catalogue ratings and reviews</span></div>
<div class="section-heading-actions"><button class="section-link" data-view-products="recommended" type="button">View All <img alt="" src="/assets/icons/chevron-right.svg"/></button><button aria-label="Show more recommended products" class="section-next-button" data-scroll-next="recommendGrid" type="button"><img alt="" src="/assets/icons/chevron-right.svg"/></button></div>
</div>
<div class="recommend-grid horizontal-scroll mobile-two-row-one-half" id="recommendGrid"></div>
</section>
<section class="store-section curated-section" id="best-sellers">
<div class="section-heading">
<div class="heading-with-note"><h2>Best Sellers</h2><span>Ranked from recorded order-item activity</span></div>
<div class="section-heading-actions"><button class="section-link" data-view-products="best-sellers" type="button">View All <img alt="" src="/assets/icons/chevron-right.svg"/></button><button aria-label="Show more best sellers" class="section-next-button" data-scroll-next="bestSellerGrid" type="button"><img alt="" src="/assets/icons/chevron-right.svg"/></button></div>
</div>
<div class="product-grid horizontal-scroll mobile-one-half" id="bestSellerGrid"></div>
</section>
<section class="store-section curated-section" id="budget-picks">
<div class="section-heading">
<div class="heading-with-note"><h2>Affordable Picks</h2><span>Lower-priced available products in your marketplace currency</span></div>
<div class="section-heading-actions"><button class="section-link" data-view-products="budget" type="button">View All <img alt="" src="/assets/icons/chevron-right.svg"/></button><button aria-label="Show more budget products" class="section-next-button" data-scroll-next="budgetGrid" type="button"><img alt="" src="/assets/icons/chevron-right.svg"/></button></div>
</div>
<div class="product-grid horizontal-scroll mobile-two-half" id="budgetGrid"></div>
</section>
<section class="store-section fresh-finds-section" id="fresh-finds">
<div class="section-heading">
<div class="heading-with-note"><h2>Fresh Finds</h2><span>New and noteworthy products</span></div>
<div class="section-heading-actions"><button class="section-link" data-view-products="fresh" type="button"><span>View All</span><img alt="" src="/assets/icons/chevron-right.svg"/></button><button aria-label="Show more fresh finds" class="section-next-button" data-scroll-next="freshFindsGrid" type="button"><img alt="" src="/assets/icons/chevron-right.svg"/></button></div>
</div>
<div class="mini-product-grid" id="freshFindsGrid"></div>
</section>
<section class="store-section" hidden="" id="recentlyViewedSection">
<div class="section-heading">
<div class="heading-with-note"><h2>Recently Viewed</h2><span>Continue where you left off</span></div>
<div class="section-heading-actions"><a class="section-link" href="/products">View All <img alt="" src="/assets/icons/chevron-right.svg"/></a><button aria-label="Show more recently viewed products" class="section-next-button" data-scroll-next="recentGrid" type="button"><img alt="" src="/assets/icons/chevron-right.svg"/></button></div>
</div>
<div class="product-grid horizontal-scroll mobile-one-half" id="recentGrid"></div>
</section>
<section class="store-section" id="collections"><div class="section-heading"><h2>Shop by Collection</h2></div><div class="collection-grid"><% (initialStorefront?.categories || []).slice(0,4).forEach(category => { %><button class="collection-card" data-category-jump="<%= category.id %>" type="button"><img alt="<%= category.name %>" src="<%= category.image || '/assets/product-placeholder.svg' %>"/><span><strong><%= category.name %></strong><small><%= category.note || ('Browse '+category.name) %></small><b>Shop Now</b></span></button><% }); %></div></section>
<% if (typeof homeTestimonials !== 'undefined' && homeTestimonials?.length) { %><section class="store-section testimonials-section"><div class="section-heading"><h2>Verified Customer Reviews</h2></div><div class="testimonial-grid"><% homeTestimonials.forEach(review => { %><article class="testimonial-card"><img alt="<%= review.name %>" src="<%= review.image %>"/><blockquote>“<%= review.body %>”</blockquote><footer><strong><%= review.name %></strong><span aria-label="<%= review.rating %> out of 5 stars" class="stars"><%= '★'.repeat(Math.max(0,Math.min(5,review.rating))) %><%= '☆'.repeat(Math.max(0,5-Math.min(5,review.rating))) %></span></footer></article><% }); %></div></section><% } %>
<section class="store-section blog-section"><div class="section-heading"><h2>Latest from Classic Mart</h2><a class="section-link" href="/press">View All Articles <img alt="" src="/assets/icons/chevron-right.svg"/></a></div><div class="blog-grid"><% if (typeof pressArticles !== 'undefined' && pressArticles?.length) { pressArticles.slice(0,3).forEach(article => { %><article class="blog-card" id="<%= article.key.replaceAll('.','-') %>"><img alt="<%= article.title %>" src="<%= article.data?.image || '/assets/image-placeholder.svg' %>"/><div><span><%= article.data?.category || 'Marketplace' %></span><h3><%= article.title %></h3><p><%= article.data?.publishedOn || '' %><%= article.data?.readTime ? ' · '+article.data.readTime : '' %></p><a href="/press#<%= article.key.replaceAll('.','-') %>">Read More</a></div></article><% }); } else { %><article class="blog-card"><div><span>Classic Mart Journal</span><h3>No published articles yet</h3><p>Administrators can publish marketplace updates from the CMS workspace.</p><a href="/press">Open journal</a></div></article><% } %></div></section>
</div>
<% if (typeof cmsHomeModule !== 'undefined' && cmsHomeModule) { %><section class="container" style="padding:8px 0 22px"><article style="border:1px solid #dbe4ef;border-radius:18px;padding:18px;background:#fff"><h2><%= cmsHomeModule.title %></h2><p><%= cmsHomeModule.body %></p></article></section><% } %><% if (typeof cmsCollection !== 'undefined' && cmsCollection) { %><section class="container" style="padding:0 0 22px"><article style="border:1px solid #dbe4ef;border-radius:18px;padding:18px;background:#fff"><h2><%= cmsCollection.title %></h2><p><%= cmsCollection.body %></p></article></section><% } %>
</main>
<section class="newsletter">
<div class="container newsletter-inner">
<div class="newsletter-message"><span><img alt="" src="/assets/icons/envelope.svg"/></span><div><strong>Stay in the Loop!</strong><small>Get exclusive deals, new arrivals and shopping tips.</small></div></div>
<form class="newsletter-form" data-newsletter-form id="newsletterForm" novalidate>
<label class="sr-only" for="newsletterEmail">Email address</label>
<input autocomplete="email" id="newsletterEmail" maxlength="254" name="email" placeholder="Enter your email address" required type="email"/>
<button type="submit">Subscribe</button>
<p aria-live="polite" class="newsletter-status" data-newsletter-status></p>
</form>
