<!doctype html>
<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#ff6500">
  <link rel="manifest" href="/manifest.webmanifest">
  <title>Classic Mart App</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/storefront-pages.css">
  <link rel="stylesheet" href="/server-ui.css">
</head>
<body class="storefront-page">
  <a class="skip-link" href="#mainContent">Skip to app information</a>
  <%- include("partials/storefront-header") %>
  <main class="page-shell" id="mainContent">
    <section class="panel" style="max-width:760px;margin:24px auto;border-radius:22px;padding:20px">
      <div style="display:flex;gap:14px;align-items:center;margin-bottom:24px">
        <img src="/assets/pwa-icon.svg" width="64" height="64" alt="Classic Mart">
        <div><span class="eyebrow">Installable app</span><h1 style="margin:4px 0">Classic Mart</h1><p style="margin:0">The same secure marketplace, optimized for an installed mobile experience.</p></div>
      </div>
      <h2>Connected to the live platform</h2>
      <p>Prices, stock, carts, orders and payment state are always read from the server. Offline mode never invents a successful payment or trusted stock level.</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap"><a class="primary-button" href="/">Shop now</a><a class="outline-button" href="/account/profile">My account</a><button class="outline-button" data-pwa-install type="button" hidden>Install app</button></div>
    </section>
    <section class="panel" style="max-width:760px;margin:0 auto 24px;border-radius:22px;padding:20px">
      <h2>Mobile API</h2>
      <p>Approved native or cross-platform clients can authenticate against <code>/api/v1/mobile</code> using rotating opaque access/refresh tokens. Browser sessions remain cookie-based.</p>
      <a class="outline-button" href="/openapi-v1.json">API contract</a>
    </section>
  </main>
  <%- include("partials/storefront-footer") %>
  <script src="/cart-store.js"></script>
  <script src="/shared-shell.js"></script>
  <script src="/country-switcher.js"></script>
  <script src="/search-tools.js"></script>
  <script src="/pwa.js"></script>
</body>
</html>
