<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Privacy &amp; Data · Classic Mart</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/account.css"></head><body class="account-body"><%-include('partials/account-top')%><%-include('partials/account-nav',{accountSection:'privacy'})%><main class="account-wrap account-main"><%if(flash){%><div class="account-flash <%=flash.type==='error'?'error':''%>"><strong><%=flash.message%></strong></div><%}%><div class="account-heading"><h1>Privacy &amp; data</h1><p>Request exports, corrections, restrictions, consent withdrawal or account deletion.</p></div><div class="account-grid"><section class="account-card"><h2>Create a verified request</h2><form class="account-form" method="post" action="/account/privacy/request"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Request<select name="type" required><option value="export">Download my data</option><option value="correction">Correct personal data</option><option value="restriction">Restrict processing</option><option value="consent_withdrawal">Withdraw marketing consent</option><option value="deletion">Delete / anonymize my account</option></select></label><label>Current password<input type="password" name="password" autocomplete="current-password" required></label><label>Details<textarea name="details" maxlength="2000" rows="5" placeholder="Add context when needed"></textarea></label><button class="account-button primary" type="submit">Submit request</button></form></section><section class="account-card"><h2>How deletion works</h2><p>Classic Mart checks unresolved orders, refunds, payouts and legally required retention first. Eligible account identity is anonymized and sessions are revoked while transaction records that must be retained remain restricted.</p><p><a class="account-link" href="/privacy">Read privacy policy</a></p></section><section class="account-card wide"><h2>Your requests</h2><div style="overflow-x:auto"><table class="account-table"><thead><tr><th>Request</th><th>Status</th><th>Decision / expiry</th><th>Action</th></tr></thead><tbody><%if(!requests.length){%><tr><td colspan="4">No privacy requests yet.</td></tr><%}%><%requests.forEach(r=>{%><tr><td><strong><%=r.type.replaceAll('_',' ')%></strong><br><small><%=r.publicId%> · <%=formatDate(r.createdAt)%></small></td><td><%=r.status%></td><td><%=r.decision||''%><%if(r.expiresAt){%><br><small>Available until <%=formatDate(r.expiresAt)%></small><%}%></td><td><div class="account-actions"><%if(r.type==='export'&&r.status==='ready'){%><a class="account-link" href="/account/privacy/<%=r.publicId%>/download">Download JSON</a><%}%><%if(['requested','blocked'].includes(r.status)){%><form method="post" action="/account/privacy/<%=r.publicId%>/cancel"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="account-button" type="submit">Cancel</button></form><%}%></div></td></tr><%})%></tbody></table></div><%if(queuePage?.hasMore){%><p><a class="account-link" href="/account/privacy?after=<%=encodeURIComponent(queuePage.next)%>">Older requests</a></p><%}%></section></div></main></body></html>
