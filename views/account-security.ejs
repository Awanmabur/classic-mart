<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Security · Classic Mart</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/account.css"></head><body class="account-body"><%-include('partials/account-top')%><%-include('partials/account-nav',{accountSection:'security'})%><main class="account-wrap account-main"><%if(flash){%><div class="account-flash <%=flash.type==='error'?'error':''%>"><strong><%=flash.message%></strong><%if(flash.details){%><div class="account-note"><%=flash.details%></div><%}%></div><%}%><div class="account-heading"><h1>Password &amp; security</h1><p>Manage your password, MFA and signed-in devices.</p></div><div class="account-grid"><section class="account-card"><h2>Change password</h2><form class="account-form" method="post" action="/account/password"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Current password<input type="password" name="currentPassword" autocomplete="current-password" required></label><label>New password<input type="password" name="password" minlength="12" maxlength="128" autocomplete="new-password" required></label><label>Confirm password<input type="password" name="confirmPassword" minlength="12" maxlength="128" autocomplete="new-password" required></label><button class="account-button primary" type="submit">Update password</button></form></section><section class="account-card"><h2>Authenticator MFA</h2><p><%=user.security?.mfaEnabled?'Enabled for this account.':(mfaRequired?'Required for privileged operations.':'Optional additional protection.')%></p><span class="account-status <%=user.security?.mfaEnabled?'good':(mfaRequired?'warn':'')%>"><%=user.security?.mfaEnabled?'Enabled':(mfaRequired?'Required':'Optional')%></span><%if(mfaRecoveryCodes?.length){%><div class="account-code-grid"><%mfaRecoveryCodes.forEach(item=>{%><code><%=item%></code><%})%></div><%}%><%if(!user.security?.mfaEnabled){%><%if(!mfaEnrollment){%><form class="account-form" method="post" action="/account/mfa/begin"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Current password<input type="password" name="currentPassword" required></label><button class="account-button primary" type="submit">Start MFA setup</button></form><%}else{%><div class="account-item"><div><strong>Authenticator secret</strong><p><code><%=mfaEnrollment.secret%></code></p><small><%=mfaEnrollment.uri%></small></div></div><form class="account-form" method="post" action="/account/mfa/confirm"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Authenticator code<input type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required></label><button class="account-button primary" type="submit">Enable MFA</button></form><%}%><%}else{%><form class="account-form" method="post" action="/account/mfa/recovery-codes"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Current password<input type="password" name="currentPassword" required></label><label>Authenticator or recovery code<input type="text" name="code" maxlength="32" required></label><button class="account-button" type="submit">Generate new recovery codes</button></form><%if(!mfaRequired){%><form class="account-form" method="post" action="/account/mfa/disable"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Current password<input type="password" name="currentPassword" required></label><label>Authenticator or recovery code<input type="text" name="code" maxlength="32" required></label><button class="account-button" type="submit">Disable MFA</button></form><%}%><%}%></section><section class="account-card wide"><h2>Signed-in devices</h2><div class="account-list"><%if(!devices.length){%><div class="account-empty">No device history.</div><%}%><%devices.forEach(device=>{%><article class="account-item"><div><strong><%=device.label%><%=device.publicId===currentDeviceId?' · This device':''%></strong><p>Last active <%=formatDate(device.lastSeenAt)%><%=device.revokedAt?` · Revoked ${formatDate(device.revokedAt)}`:''%></p></div><%if(!device.revokedAt){%><form method="post" action="/account/devices/<%=device.publicId%>/revoke"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="account-button" type="submit"><%=device.publicId===currentDeviceId?'Sign out':'Revoke'%></button></form><%}%></article><%})%></div><%if(queuePages?.devices?.hasMore){%><p><a class="account-link" href="/account/security?devicesAfter=<%=encodeURIComponent(queuePages.devices.next)%>">Older devices</a></p><%}%></section></div></main></body></html>
