<!doctype html><html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Seller Growth — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"><style>.sg-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.sg-form{display:grid;gap:10px}.sg-form label{display:grid;gap:6px}.sg-form input,.sg-form select,.sg-form textarea{border:1px solid #d8dee8;border-radius:12px;padding:10px 12px;width:100%;box-sizing:border-box}.sg-card{border:1px solid #e0e5ec;border-radius:16px;padding:14px;margin:10px 0}@media(max-width:800px){.sg-grid{grid-template-columns:1fr}}</style></head><body><main class="catalog-workspace"><header class="catalog-topbar"><div><a class="brand" href="/seller"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p>Seller Growth</p></div><div class="catalog-actions"><a class="outline-button" href="/seller/products">Products</a><a class="outline-button" href="/seller/ai">Classic AI</a></div></header><section class="catalog-page-head panel"><div><span class="eyebrow">Server-controlled merchandising</span><h1>Growth & pricing</h1><p>Vouchers, bundles, quantity breaks, free shipping, sponsored labels, minimum-price schedules, followers and consent-based broadcasts.</p></div></section>
<div class="sg-grid"><section class="panel" id="promotions"><h2>Promotion</h2><form method="post" action="/seller/growth/promotions" class="sg-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Type<select name="type"><option value="voucher">Voucher</option><option value="bundle">Bundle</option><option value="quantity_break">Quantity break</option><option value="free_shipping">Free shipping</option><option value="sponsored">Sponsored placement</option></select></label><label>Name<input name="name" required></label><label>Code (voucher only)<input name="code"></label><fieldset class="campaign-product-picker"><legend>Eligible products</legend><p class="workspace-help">Choose approved or published products owned by this store. Leave all unchecked to apply the promotion store-wide where the promotion type allows it.</p><div class="campaign-product-options"><% if(!view.products?.length){%><p>No approved products are available.</p><%}%><% (view.products||[]).forEach(product=>{%><label><input type="checkbox" name="productPublicIds" value="<%=product.publicId%>"> <span><strong><%=product.title%></strong><small><%=product.status%></small></span></label><%})%></div><% if(view.queuePages?.products?.hasMore){ %><p><a class="server-pager" href="/seller/growth?productsAfter=<%=encodeURIComponent(view.queuePages.products.nextCursor)%>#promotions">Older products</a></p><% } %></fieldset><label>Discount basis points<input type="number" min="0" max="9000" name="discountBps" value="0"></label><label>Fixed discount minor units<input type="number" min="0" name="fixedDiscountMinor" value="0"></label><label>Minimum quantity<input type="number" min="1" name="minQuantity" value="1"></label><label>Minimum subtotal<input type="number" min="0" name="minSubtotalMinor" value="0"></label><label>Disclosure<input name="disclosureText" value="Sponsored placement."></label><label>Starts<input type="datetime-local" name="startsAt"></label><label>Ends<input type="datetime-local" name="endsAt"></label><label>Status<select name="status"><option value="draft">Draft</option><option value="active">Active</option></select></label><div class="catalog-actions"><button type="submit" formaction="/seller/growth/promotions/preview">Preview margin</button><button type="submit">Create promotion</button></div></form><%if(view.promotionPreview?.length){%><div class="sg-card"><strong>Server margin preview</strong><div class="table-wrap"><table><thead><tr><th>Variant</th><th>Price</th><th>Floor</th><th>Discount</th><th>Net</th><th>Cost</th><th>Margin</th></tr></thead><tbody><%view.promotionPreview.forEach(r=>{%><tr><td><%=r.sku%></td><td><%=formatMoney(r.priceMinor,view.currency||user.currency)%></td><td><%=formatMoney(r.minimumPriceMinor,view.currency||user.currency)%></td><td><%=formatMoney(r.discountMinor,view.currency||user.currency)%></td><td><%=formatMoney(r.netPriceMinor,view.currency||user.currency)%></td><td><%=formatMoney(r.costMinor,view.currency||user.currency)%></td><td><%=formatMoney(r.marginMinor,view.currency||user.currency)%> (<%=r.marginBps%> bps)</td></tr><%})%></tbody></table></div></div><%}%></section><section class="panel"><h2>Promotion register</h2><%if(!view.promotions.length){%><p>No promotions yet.</p><%}%><%view.promotions.forEach(p=>{%><article class="sg-card"><strong><%=p.name%></strong><p><%=p.type.replaceAll('_',' ')%> · <%=p.status%><%if(p.code){%> · <code><%=p.code%></code><%}%></p><small><%=p.discountBps%> bps · fixed <%=p.fixedDiscountMinor%></small><form method="post" action="/seller/growth/promotions/<%=p.publicId%>/status"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="status"><option>active</option><option>paused</option><option>expired</option></select><button type="submit">Update</button></form></article><%})%><% if(view.queuePages?.promotions?.hasMore){ %><p><a class="server-pager" href="/seller/growth?promotionsAfter=<%=encodeURIComponent(view.queuePages.promotions.nextCursor)%>#promotions">Older promotions</a></p><% } %></section></div>
<div class="sg-grid"><section class="panel" id="pricing"><h2>Minimum & scheduled pricing</h2><form method="post" action="/seller/growth/prices" class="sg-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Variant<select name="variantId"><%view.variants.forEach(v=>{%><option value="<%=v.publicId%>"><%=v.sku%> · current <%=formatMoney(v.priceMinor,v.currency||view.currency||user.currency)%></option><%})%></select></label><label>Cost (minor units)<input type="number" name="costMinor" min="0"></label><label>Minimum price<input type="number" name="minimumPriceMinor" min="0" value="0"></label><label>New scheduled price<input type="number" name="newPriceMinor" min="0" required></label><label>Starts<input type="datetime-local" name="startsAt" required></label><button type="submit">Schedule price</button></form><% if(view.queuePages?.variants?.hasMore){ %><p><a class="server-pager" href="/seller/growth?variantsAfter=<%=encodeURIComponent(view.queuePages.variants.nextCursor)%>#pricing">More variants</a></p><% } %><%view.schedules.forEach(s=>{%><p><strong><%=s.variantPublicId%></strong> · <%=formatMoney(s.previousPriceMinor,s.currency||view.currency||user.currency)%> → <%=formatMoney(s.newPriceMinor,s.currency||view.currency||user.currency)%> · <%=s.status%></p><%})%><% if(view.queuePages?.schedules?.hasMore){ %><p><a class="server-pager" href="/seller/growth?schedulesAfter=<%=encodeURIComponent(view.queuePages.schedules.nextCursor)%>#pricing">Older price schedules</a></p><% } %></section><section class="panel" id="broadcasts"><h2>Follower broadcasts</h2><p>Only signed-in followers who explicitly consented to marketing are queued.</p><form method="post" action="/seller/growth/broadcasts" class="sg-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Subject<input name="subject" required></label><label>Message<textarea name="body" required></textarea></label><button type="submit">Save draft</button></form><%view.broadcasts.forEach(b=>{%><article class="sg-card"><strong><%=b.subject%></strong><p><%=b.status%> · <%=b.recipientCount%> recipients</p><%if(b.status==='draft'){%><form method="post" action="/seller/growth/broadcasts/<%=b.publicId%>/queue"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Queue to consenting followers</button></form><%}%></article><%})%><% if(view.queuePages?.broadcasts?.hasMore){ %><p><a class="server-pager" href="/seller/growth?broadcastsAfter=<%=encodeURIComponent(view.queuePages.broadcasts.nextCursor)%>#broadcasts">Older broadcasts</a></p><% } %></section></div>
<section class="panel" id="quotes"><h2>Business quotation requests</h2><%if(!view.quotes.length){%><p>No business quote requests.</p><%}%><%view.quotes.forEach(q=>{%><article class="sg-card"><strong><%=q.organizationId?.companyName||q.publicId%></strong><p><%=q.status%> · <%=q.items.length%> line(s)</p><%q.messages.slice(-3).forEach(m=>{%><small><strong><%=m.actorType%>:</strong> <%=m.message%></small><br><%})%><form method="post" action="/seller/growth/quotes/<%=q.publicId%>/respond" class="sg-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><div class="sg-form"><strong>Price each approved SKU</strong><% q.items.forEach(line=>{ %><label><%=line.title%> · <%=line.variantTitle%> · <%=line.sku%> × <%=line.quantity%><input name="offeredUnitMinor" type="number" min="0" required value="<%=line.offeredUnitMinor||line.requestedUnitMinor||0%>"></label><% }) %></div><label>Valid until<input type="date" name="validUntil"></label><label>Reply<textarea name="message" required>Quotation prepared for your review.</textarea></label><button type="submit">Send quotation</button></form></article><%})%><% if(view.queuePages?.quotes?.hasMore){ %><p><a class="server-pager" href="/seller/growth?quotesAfter=<%=encodeURIComponent(view.queuePages.quotes.nextCursor)%>#quotes">Older quote requests</a></p><% } %></section>
<section class="panel" id="purchase-orders"><h2>Business purchase orders</h2><%if(!view.purchaseOrders.length){%><p>No purchase orders yet.</p><%}%><%view.purchaseOrders.forEach(p=>{%><article class="sg-card"><strong><%=p.poNumber%> · <%=p.organizationId?.companyName||p.publicId%></strong><p><span class="workspace-money"><%=formatMoney(p.totalMinor,p.currency)%></span> · tax <%=formatMoney(p.taxMinor||0,p.currency)%> · invoice terms <%=p.invoiceTermsDays%> days · <%=p.status%></p><%if(p.status==='issued'){%><form method="post" action="/seller/growth/purchase-orders/<%=p.publicId%>/decision"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button name="status" value="accepted">Accept PO</button><button name="status" value="rejected">Reject PO</button></form><%}%><%if(['accepted','payment_pending','processing'].includes(p.status)){%><small>Fulfilment is controlled by inventory, payment and shipment state; it cannot be manually marked complete.</small><%}%></article><%})%><% if(view.queuePages?.purchaseOrders?.hasMore){ %><p><a class="server-pager" href="/seller/growth?purchaseOrdersAfter=<%=encodeURIComponent(view.queuePages.purchaseOrders.nextCursor)%>#purchase-orders">Older purchase orders</a></p><% } %></section>
</main><script src="/image-fallback.js"></script></body></html>
