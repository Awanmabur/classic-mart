<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Developer Portal · Classic Mart</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/role-dashboard.css"></head><body><main class="role-main"><div class="role-shell"><section class="role-content"><div class="page-heading role-page-heading"><div><span class="eyebrow">Seller integrations</span><h1>Developer Portal</h1><p>Scoped API keys, signed webhooks, quotas, rotation and delivery history for <%= store.name %>.</p></div><a class="outline-button" href="/seller">Seller Center</a></div><% if(revealedKey){%><section class="panel" style="border-radius:20px;padding:18px"><strong>Copy this API key now. It will not be shown again.</strong><pre style="overflow:auto"><%=revealedKey%></pre></section><%}%><% if(revealedSecret){%><section class="panel" style="border-radius:20px;padding:18px"><strong>Copy this webhook signing secret now. It will not be shown again.</strong><pre style="overflow:auto"><%=revealedSecret%></pre></section><%}%><div class="role-content-grid catalogue-two-column"><section class="panel role-form-section"><h2>Create API client</h2><form method="post" action="/seller/developers/clients" class="dashboard-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Name<input name="name" maxlength="120" required></label><label>Requests/minute<input name="requestsPerMinute" type="number" min="10" max="1200" value="120"></label><label>Optional expiry<input name="expiresAt" type="datetime-local"></label><fieldset><legend>Scopes</legend><% scopes.forEach(scope=>{%><label style="display:flex;gap:8px;align-items:center"><input type="checkbox" name="scopes" value="<%=scope%>"><%=scope%></label><%})%></fieldset><button class="primary-button" type="submit">Create key</button></form></section><section class="panel role-form-section"><h2>Create webhook</h2><form method="post" action="/seller/developers/webhooks" class="dashboard-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>HTTPS endpoint<input name="url" type="url" placeholder="https://example.com/classic-mart" required></label><fieldset><legend>Events</legend><% events.forEach(event=>{%><label style="display:flex;gap:8px;align-items:center"><input type="checkbox" name="events" value="<%=event%>"><%=event%></label><%})%></fieldset><button class="primary-button" type="submit">Create webhook</button></form></section></div><section class="panel role-form-section"><h2>API clients</h2><div class="catalogue-stack"><% clients.forEach(client=>{%><article class="catalog-row"><div><strong><%=client.name%></strong><small><%=client.keyPrefix%> · <%=client.scopes.join(', ')%> · <%=client.requestsPerMinute%>/min<% if(client.expiresAt){ %> · expires <%=formatDate(client.expiresAt)%><% } %></small></div><div><span class="role-status <%=client.status==='active'?'good':'neutral'%>"><%=client.status%></span><% if(client.status==='active'){%><form method="post" action="/seller/developers/clients/<%=client.publicId%>/rotate"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit">Rotate</button></form><form method="post" action="/seller/developers/clients/<%=client.publicId%>/revoke"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit">Revoke</button></form><%}%></div></article><%})%><% if(!clients.length){%><p class="catalogue-empty">No API clients yet.</p><%}%></div></section><section class="panel role-form-section"><h2>Webhooks</h2><div class="catalogue-stack"><% webhooks.forEach(hook=>{%><article class="catalog-row"><div><strong><%=hook.url%></strong><small><%=hook.events.join(', ')%> · secret ending <%=hook.secretLast4%></small></div><div><span class="role-status <%=hook.status==='active'?'good':'neutral'%>"><%=hook.status%></span><% if(hook.status==='active'){%><form method="post" action="/seller/developers/webhooks/<%=hook.publicId%>/test"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit">Test</button></form><form method="post" action="/seller/developers/webhooks/<%=hook.publicId%>/rotate"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit">Rotate</button></form><form method="post" action="/seller/developers/webhooks/<%=hook.publicId%>/revoke"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit">Revoke</button></form><%}%></div></article><%})%><% if(!webhooks.length){%><p class="catalogue-empty">No webhook endpoints yet.</p><%}%></div></section><section class="panel role-form-section"><div class="role-panel-head"><div><h2>Recent deliveries</h2><p>Payloads are signed with HMAC SHA-256 using the secret shown only at creation/rotation.</p></div><a class="outline-button" href="/openapi-v1.json">OpenAPI contract</a></div><div class="catalogue-stack"><% deliveries.forEach(row=>{%><article class="catalog-row"><div><strong><%=row.eventType%></strong><small><%=row.eventId%> · attempt <%=row.attempt%></small></div><span class="role-status <%=row.status==='delivered'?'good':row.status==='dead'?'bad':'warn'%>"><%=row.status%></span></article><%})%><% if(!deliveries.length){%><p class="catalogue-empty">No webhook deliveries yet.</p><%}%></div></section></section></div></main></body></html>
