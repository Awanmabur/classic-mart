<!DOCTYPE html>

<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"/><meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/><meta content="Marketplace announcements, buying guides and stories from sellers, promoters and shoppers." name="description"/><meta content="#ff6200" name="theme-color"/><title>Press &amp; News — Classic Mart</title><link href="/styles.css" rel="stylesheet"/><link href="/storefront-pages.css" rel="stylesheet"/><link href="/shared-shell.css" rel="stylesheet"/><link href="/marketplace-pages.css" rel="stylesheet"/><link href="/info-pages.css" rel="stylesheet"/></head><body class="info-body"><a class="skip-link" href="#mainContent">Skip to content</a><%- include("partials/storefront-header") %><main class="info-main" id="mainContent"><section class="info-hero"><div class="container"><nav aria-label="Breadcrumb" class="catalog-breadcrumb"><a href="/">Home</a><span>›</span><strong>Press &amp; News</strong></nav><span class="info-kicker">Classic Mart Journal</span><h1>Press &amp; News</h1><p>Published marketplace announcements and buying guides managed through the Classic Mart CMS.</p></div></section><div class="container info-content"><div class="news-grid"><% if (typeof pressArticles !== 'undefined' && pressArticles?.length) { pressArticles.forEach(article => { %><article id="<%= article.key.replaceAll('.','-') %>"><img alt="<%= article.title %>" src="<%= article.data?.image || '/assets/image-placeholder.svg' %>"/><span><%= article.data?.category || 'Marketplace' %></span><h2><%= article.title %></h2><p><%= article.body %></p><small><%= article.data?.publishedOn || '' %><%= article.data?.readTime ? ' · '+article.data.readTime : '' %></small></article><% }); } else { %><article><span>Classic Mart Journal</span><h2>No published articles yet</h2><p>Authorized administrators can publish articles through the CMS workspace.</p></article><% } %></div></div></main><section class="newsletter">
<div class="container newsletter-inner">
<div class="newsletter-message"><span><img alt="" src="/assets/icons/envelope.svg"/></span><div><strong>Stay in the Loop!</strong><small>Get exclusive deals, new arrivals and shopping tips.</small></div></div>
<form class="newsletter-form" data-newsletter-form id="newsletterForm" novalidate>
<label class="sr-only" for="newsletterEmail">Email address</label>
<input autocomplete="email" id="newsletterEmail" maxlength="254" name="email" placeholder="Enter your email address" required type="email"/>
<button type="submit">Subscribe</button>
<p aria-live="polite" class="newsletter-status" data-newsletter-status></p>
</form>
<div class="newsletter-perks"><span><img alt="" src="/assets/icons/percent.svg"/><b>Exclusive Deals</b></span><span><img alt="" src="/assets/icons/gift.svg"/><b>New Arrivals</b></span><span><img alt="" src="/assets/icons/location-dot.svg"/><b>Shopping Tips</b></span></div>
</div>
</section><%- include("partials/storefront-footer") %><div aria-live="polite" class="page-toast" id="pageToast" role="status"></div><script src="/cart-store.js"></script>
<script src="/info-pages.js"></script><script src="/shared-shell.js"></script><script src="/image-fallback.js"></script><script src="/country-switcher.js"></script><script src="/search-tools.js"></script><script src="/newsletter.js"></script></body></html>