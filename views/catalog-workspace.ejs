<!DOCTYPE html>
<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
  <meta content="#1165df" name="theme-color"/>
  <meta content="<%= csrfToken %>" name="csrf-token"/>
  <title>Seller Workspace — Classic Mart</title>
  <link href="/dashboard.css" rel="stylesheet"/>
  <link href="/dashboard-workspaces.css" rel="stylesheet"/>
  <link href="/server-ui.css" rel="stylesheet"/>
  <link href="/catalog-workspace.css" rel="stylesheet"/>
</head>
<body data-operations-ui="true" data-workspace="seller">
  <% const membership = (typeof storeMembership !== 'undefined' && storeMembership) ? storeMembership : { role: '' }; %>
  <svg aria-hidden="true" class="svg-sprite">
    <symbol id="i-cart" viewBox="0 0 24 24"><path d="M3 4h2l2.1 10.2a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 1.9-1.4L21 8H7"/><circle cx="10" cy="20" r="1.35"/><circle cx="18" cy="20" r="1.35"/></symbol>
    <symbol id="i-grid" viewBox="0 0 24 24"><rect x="4" y="4" width="5" height="5" rx="1"/><rect x="15" y="4" width="5" height="5" rx="1"/><rect x="4" y="15" width="5" height="5" rx="1"/><rect x="15" y="15" width="5" height="5" rx="1"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></symbol>
    <symbol id="i-box" viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4-8-4Z"/><path d="M4 7v10l8 4 8-4V7M12 11v10"/></symbol>
    <symbol id="i-warehouse" viewBox="0 0 24 24"><path d="M3 10 12 4l9 6v10H3V10Z"/><path d="M7 20v-6h10v6M8 10h8"/></symbol>
    <symbol id="i-upload" viewBox="0 0 24 24"><path d="M12 16V4m0 0L7 9m5-5 5 5"/><path d="M4 15v5h16v-5"/></symbol>
    <symbol id="i-home" viewBox="0 0 24 24"><path d="m3 11 9-8 9 8"/><path d="M5 10v11h14V10M9 21v-7h6v7"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
    <symbol id="i-logout" viewBox="0 0 24 24"><path d="M10 4H5v16h5M14 8l4 4-4 4M8 12h10"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
  </svg>
  <div class="app-shell">
    <header class="topbar">
      <div class="brand-area">
        <button aria-label="Open navigation" class="round-icon mobile-menu" id="mobileMenuBtn" type="button"><svg><use href="#i-menu"></use></svg></button>
        <a class="brand" href="/dashboard"><svg class="brand-cart"><use href="#i-cart"></use></svg><span class="brand-copy"><strong>Classic Mart</strong><small>Everything, for everyone</small></span></a>
      </div>
      <div class="server-workspace-title"><span>Seller workspace</span><strong><%= store.name %></strong></div>
      <% if (typeof availableStores !== 'undefined' && availableStores?.length > 1) { %>
        <form class="workspace-switcher" method="post" action="/seller/workspace" aria-label="Switch seller workspace">
          <input type="hidden" name="_csrf" value="<%=csrfToken%>"/>
          <label><span>Store</span><select name="storePublicId" onchange="this.form.submit()"><% availableStores.forEach(item=>{ %><option value="<%=item.publicId%>" <%=item.publicId===store.publicId?'selected':''%>><%=item.name%> · <%=item.role%> · <%=item.country%></option><% }) %></select></label>
        </form>
      <% } %>
      <div class="top-spacer"></div>
      <div class="top-actions">
        <a class="categories-button" href="/"><svg><use href="#i-home"></use></svg><span>Marketplace</span></a>
        <a class="profile-button" href="/account/profile"><span class="server-avatar"><%= user.name.split(/\s+/).slice(0,2).map(part => part[0]).join('').toUpperCase() %></span><span><strong>Hi, <%= user.name.split(' ')[0] %></strong><small><%= roleLabel(user.role) %></small></span></a>
      </div>
    </header>
    <aside class="sidebar" id="sidebar">
      <nav class="side-navigation">
        <p class="nav-section-label">Account</p>
        <a class="side-link" href="/dashboard"><svg><use href="#i-grid"></use></svg><span>Overview</span></a>
        <p class="nav-section-label">Store</p><a class="side-link" href="/seller/developers"><svg><use href="#i-shield"></use></svg><span>Developer API</span></a>
        <% if (['owner','admin'].includes(membership.role)) { %><a class="side-link <%= view.section === 'verification' ? 'active' : '' %>" href="/seller/onboarding"><svg><use href="#i-shield"></use></svg><span>Seller Verification</span></a><a class="side-link <%= view.section === 'staff' ? 'active' : '' %>" href="/seller/staff"><svg><use href="#i-user"></use></svg><span>Store Staff</span></a><% } %>
        <% if (['owner','admin','catalogue'].includes(membership.role)) { %><a class="side-link <%= ['products','product-new','product-edit'].includes(view.section) ? 'active' : '' %>" href="/seller/products"><svg><use href="#i-box"></use></svg><span>Products</span></a><a class="side-link" href="/seller/ai"><svg><use href="#i-grid"></use></svg><span>Classic AI</span></a><a class="side-link" href="/seller/growth"><svg><use href="#i-grid"></use></svg><span>Growth & Pricing</span></a><a class="side-link <%= view.section === 'bulk-import' ? 'active' : '' %>" href="/seller/products/import"><svg><use href="#i-upload"></use></svg><span>Bulk Import</span></a><% } %>
        <% if (['owner','admin','fulfilment'].includes(membership.role)) { %><a class="side-link <%= view.section === 'orders' ? 'active' : '' %>" href="/seller/orders"><svg><use href="#i-cart"></use></svg><span>Orders</span></a><a class="side-link <%= view.section === 'inventory' ? 'active' : '' %>" href="/seller/inventory"><svg><use href="#i-warehouse"></use></svg><span>Inventory</span></a><% } %>
        <% if (['owner','admin','support'].includes(membership.role)) { %><a class="side-link <%= view.section === 'questions' ? 'active' : '' %>" href="/seller/questions"><svg><use href="#i-check"></use></svg><span>Product Q&amp;A</span></a><a class="side-link <%= view.section === 'messages' ? 'active' : '' %>" href="/seller/messages"><svg><use href="#i-user"></use></svg><span>Customer Messages</span></a><a class="side-link <%= view.section === 'returns' ? 'active' : '' %>" href="/seller/returns"><svg><use href="#i-cart"></use></svg><span>Returns</span></a><% } %>
        <% if (['owner','admin'].includes(membership.role)) { %><a class="side-link" href="/seller/campaigns"><svg><use href="#i-grid"></use></svg><span>Campaigns</span></a><% } %>
        <% if (['owner','admin','finance'].includes(membership.role)) { %><a class="side-link" href="/money"><svg><use href="#i-cart"></use></svg><span>Money &amp; Payouts</span></a><% } %>
      </nav>
      <section class="sidebar-club-card">
        <span class="sidebar-crown"><svg><use href="#i-shield"></use></svg></span>
        <h3><%= store.status === 'verified' ? 'Verified Seller' : 'Verification Required' %></h3>
        <p class="member-copy"><%= store.country %> · <%= store.currency %></p>
        <p>Products, media, variants and inventory are database-backed and ownership scoped.</p>
      </section>
      <form action="/logout" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><button class="logout-button" type="submit"><svg><use href="#i-logout"></use></svg><span>Log Out</span></button></form>
    </aside>
    <button aria-label="Close navigation" class="sidebar-overlay" id="sidebarOverlay" type="button"></button>
    <main class="dashboard page-host">
      <% if (flash) { %><div class="server-flash <%= flash.type %>" role="status"><strong><%= flash.message %></strong></div><% } %>

      <% if (view.section === 'messages') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow">Customer communication</span><h1>Customer Messages</h1><p>Real customer-to-store enquiries scoped to <%= store.name %>.</p></div><span class="role-status good"><%= view.queuePage?.total ?? view.contacts.length %> conversations</span></div>
        <section class="panel role-form-section"><div class="role-panel-head"><div><h2>Inbox</h2><p>Reply here; the customer sees the response in their account message centre.</p></div></div>
          <% if (!view.contacts.length) { %><p class="catalogue-empty">No customer messages yet.</p><% } %>
          <div class="catalogue-stack"><% view.contacts.forEach(thread => { %><article class="panel catalogue-state-card"><div style="width:100%"><div class="role-panel-head compact"><div><h3><%= thread.subject %></h3><p><%= thread.customerUserId?.name || 'Customer' %> · <%= thread.publicId %></p></div><span class="role-status <%= thread.status === 'resolved' ? 'good' : 'warn' %>"><%= thread.status %></span></div><p><strong>Customer:</strong> <%= thread.message %></p>
            <% (thread.replies || []).forEach(reply => { %><p><strong><%= reply.sender === 'seller' ? 'You' : 'Customer' %>:</strong> <%= reply.body %> <small>· <%= formatDate(reply.at) %></small></p><% }) %>
            <% if (thread.status !== 'resolved') { %><form method="post" action="/seller/messages/<%=thread.publicId%>/reply" class="dashboard-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Reply<textarea name="message" minlength="2" maxlength="2000" required rows="3"></textarea></label><button class="primary-button" type="submit">Send reply</button></form><form method="post" action="/seller/messages/<%=thread.publicId%>/resolve"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit">Mark resolved</button></form><% } %></div></article><% }) %></div>
        </section>
      <% if(view.queuePage?.hasMore){%><div class="server-pager"><small>Showing <%=view.queuePage.count%> of <%=view.queuePage.total%> conversations</small><a class="outline-button" href="/seller/messages?after=<%=encodeURIComponent(view.queuePage.next)%>">Older messages</a></div><%}%>
      <% } else if (view.section === 'questions') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow">Product trust</span><h1>Product Q&amp;A</h1><p>Answer real customer questions for products owned by this store.</p></div><span class="role-status good"><%= view.queuePage?.total ?? view.questions.length %> <%=view.questionStatus==='open'?'unanswered':'answered'%></span></div>
        <section class="panel role-form-section"><div class="role-panel-head"><div><h2>Questions</h2><p>Answers are published to the matching product page.</p></div><nav class="role-status-tabs"><a class="<%=view.questionStatus==='open'?'active':''%>" href="/seller/questions?status=open">Open</a><a class="<%=view.questionStatus==='answered'?'active':''%>" href="/seller/questions?status=answered">Answered</a></nav></div><% if(!view.questions.length){%><p class="catalogue-empty">No product questions yet.</p><%}%><div class="catalogue-stack"><% view.questions.forEach(q=>{ %><article class="catalog-row"><div><strong><%= q.productPublicId %></strong><p><%= q.question %></p><% if(q.answer?.body){%><small>Answer: <%= q.answer.body %></small><%}%></div><% if(q.status==='open'){%><form method="post" action="/seller/questions/<%=q.publicId%>/answer" class="dashboard-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><textarea name="answer" minlength="2" maxlength="2000" required rows="3" placeholder="Give a factual answer about this product"></textarea><button class="primary-button" type="submit">Publish answer</button></form><%}else{%><span class="role-status good">answered</span><%}%></article><% }) %></div><% if(view.queuePage?.hasMore){%><div class="server-pager"><small>Showing <%=view.queuePage.count%> of <%=view.queuePage.total%> questions</small><a class="outline-button" href="/seller/questions?status=<%=view.questionStatus%>&after=<%=encodeURIComponent(view.queuePage.next)%>">Older questions</a></div><%}%></section>
      <% } else if (view.section === 'staff') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow">Store access</span><h1>Store Staff</h1><p>Invite verified Classic Mart accounts and give each person only the store permissions they need.</p></div><span class="role-status good"><%= view.members.filter(item => item.status === 'active').length %> active</span></div>
        <section class="panel role-form-section"><div class="role-panel-head"><div><h2>Invite staff</h2><p>Invitations must be accepted from the invited user’s account before access becomes active.</p></div></div>
          <form action="/seller/staff" class="role-form-grid" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><label class="wide">Verified account email<input type="email" name="email" maxlength="254" required/></label><label>Store role<select name="role" required><option value="admin">Admin</option><option value="catalogue">Catalogue</option><option value="fulfilment">Fulfilment</option><option value="finance">Finance</option><option value="support">Support</option></select></label><button class="primary-button catalogue-form-action" type="submit">Send invitation</button></form>
        </section>
        <section class="panel role-table-panel"><div class="role-panel-head"><div><h2>Access list</h2><p>Owner access cannot be removed here. Revoked staff are denied immediately on the server.</p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Person</th><th>Role</th><th>Status</th><th>Accepted</th><th></th></tr></thead><tbody>
          <% view.members.forEach(member => { %><tr><td><strong><%= member.userId?.name || 'Account unavailable' %></strong><small class="catalogue-table-id"><%= member.userId?.email || member.publicId %></small></td><td><%= member.role %></td><td><span class="role-status <%= member.status === 'active' ? 'good' : member.status === 'revoked' ? 'bad' : 'warn' %>"><%= member.status %></span></td><td><%= formatDate(member.acceptedAt) %></td><td><% if(member.role !== 'owner' && member.status !== 'revoked'){ %><form action="/seller/staff/<%=member.publicId%>/revoke" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"/><button class="outline-button table-action" type="submit">Revoke</button></form><% } %></td></tr><% }) %>
          <% if(!view.members.length){ %><tr><td colspan="5"><div class="catalogue-empty">No staff memberships yet.</div></td></tr><% } %>
        </tbody></table></div></section>
      <% } else if (view.section === 'returns') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow">Returns &amp; buyer protection</span><h1>Seller Returns</h1><p>Only order lines sold by <%= store.name %> are visible. Customer contact data and private customer evidence remain controlled by marketplace Support.</p></div><span class="role-status good"><%= view.queuePage?.total ?? view.returnCases.length %> cases</span></div>
        <section class="panel role-form-section">
          <div class="role-panel-head"><div><h2>Return queue</h2><p>Search, monitor seller-response SLA, inspect warehouse disposition and understand the exact potential financial reversal. Support/Finance/Warehouse remain authoritative for eligibility, refunds and stock.</p></div></div>
          <form class="role-form-grid" method="get" action="/seller/returns">
            <label class="wide">Search<input name="q" maxlength="80" value="<%= view.returnFilters?.search || '' %>" placeholder="Return, order, case, SKU or product"></label>
            <label>Status<select name="status"><option value="">All statuses</option><% ['pending','acknowledged','contested','escalated','resolved'].forEach(status=>{ %><option value="<%=status%>" <%=view.returnFilters?.status===status?'selected':''%>><%=status.replaceAll('_',' ')%></option><% }) %></select></label>
            <label>Seller SLA<select name="overdue"><option value="">All</option><option value="1" <%=view.returnFilters?.overdue?'selected':''%>>Overdue response only</option></select></label>
            <button class="primary-button catalogue-form-action" type="submit">Filter returns</button>
          </form>
        </section>
        <section class="panel role-form-section"><div class="role-panel-head"><div><h2>Return cases</h2><p>Acknowledge, contest with facts, or escalate. A seller response never directly refunds money or changes warehouse stock.</p></div></div>
        <% if(!view.returnCases.length){%><p class="catalogue-empty">No return cases match these filters.</p><%}%>
        <div class="catalogue-stack"><% view.returnCases.forEach(row=>{ const ret=row.returnRequest; %><article class="panel catalogue-state-card"><div style="width:100%"><div class="role-panel-head compact"><div><h3><%=row.returnPublicId%> · Order <%=row.orderPublicId%></h3><p>Store case <%=row.publicId%><% if(row.sellerOrderPublicId){%> · Seller order <%=row.sellerOrderPublicId%><%}%></p></div><div class="catalogue-table-actions"><span class="role-status <%=row.status==='resolved'?'good':row.status==='contested'||row.status==='escalated'?'warn':'neutral'%>"><%=row.status.replaceAll('_',' ')%></span><% if(row.slaOverdue){%><span class="role-status bad">seller SLA overdue</span><%}else if(!row.respondedAt&&row.status!=='resolved'){%><span class="role-status warn">response due <%=formatDate(row.slaDueAt)%></span><%}else if(row.respondedAt){%><span class="role-status good">responded <%=formatDate(row.respondedAt)%></span><%}%></div></div>
        <% if(ret){%><div class="catalogue-grid-summary"><div><small>Customer reason</small><strong><%=String(ret.reason||'').replaceAll('_',' ')%></strong></div><div><small>Requested resolution</small><strong><%=String(ret.resolution||'').replaceAll('_',' ')%></strong></div><div><small>Marketplace state</small><strong><%=String(ret.status||'').replaceAll('_',' ')%></strong></div><div><small>Return shipment</small><strong><%=ret.shipment?`${ret.shipment.publicId} · ${ret.shipment.status.replaceAll('_',' ')}`:'Not created'%></strong></div></div>
        <p><strong>Customer description:</strong> <%=ret.details||'No additional details supplied.'%></p>
        <p class="catalogue-helper"><strong>Customer evidence:</strong> <%=ret.customerEvidenceCount%> file(s) held by Support for privacy-controlled review.<% if(ret.refundPublicId){%> · Refund <%=ret.refundPublicId%><%}%><% if(ret.replacementOrderPublicId){%> · Replacement <%=ret.replacementOrderPublicId%><%}%></p><%}%>
        <div class="table-wrap"><table><thead><tr><th>Product</th><th>Variant / SKU</th><th>Qty</th><th>Customer amount</th><th>Seller receivable reversal</th><th>Platform-fee reversal</th><th>Warehouse</th></tr></thead><tbody><% row.items.forEach(item=>{%><tr><td><%=item.title%></td><td><%=item.variantTitle||'Default'%><br><small><%=item.sku||item.variantPublicId%></small></td><td><%=item.quantity%></td><td><%=formatMoney(item.requestedRefundMinor,row.currency)%></td><td><% if(item.financialSnapshotReady){%><%=formatMoney(item.sellerReceivableReversalMinor,row.currency)%><%}else{%><span class="role-status bad">migration required</span><%}%></td><td><% if(item.financialSnapshotReady){%><%=formatMoney(item.platformFeeReversalMinor,row.currency)%><%}else{%>—<%}%></td><td><% if(item.warehouseInspectionStatus){%><strong><%=item.warehouseInspectionStatus.replaceAll('_',' ')%></strong><br><small><%=item.stockDisposition?`Disposition: ${item.stockDisposition.replaceAll('_',' ')}`:'Disposition pending'%><% if(item.inspectedQuantity){%> · <%=item.inspectedQuantity%> inspected<%}%></small><%}else{%><span class="role-status neutral">Awaiting warehouse</span><%}%></td></tr><%})%></tbody></table></div>
        <% if(row.responseMessage){%><p><strong>Latest seller response:</strong> <%=row.responseMessage%></p><%}%>
        <% if(row.evidenceDocumentIds?.length){%><p><strong>Private seller evidence:</strong> <% row.evidenceDocumentIds.forEach((e,idx)=>{%><%=idx?' · ':''%><a href="/evidence/<%=e.publicId%>" target="_blank" rel="noopener"><%=e.description||e.publicId%></a><%})%></p><%}%>
        <% if(row.status!=='resolved'){%><form method="post" action="/seller/returns/<%=row.publicId%>/respond" class="dashboard-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Response<select name="action"><option value="acknowledged">Acknowledge</option><option value="contested">Contest with evidence</option><option value="escalated">Escalate to support</option></select></label><label>Message<textarea name="message" maxlength="2000" rows="3" placeholder="Facts for Support review"></textarea></label><button class="primary-button" type="submit">Record response</button></form>
        <form method="post" action="/seller/returns/<%=row.publicId%>/evidence" enctype="multipart/form-data" class="dashboard-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Private evidence image<input type="file" name="document" accept="image/jpeg,image/png,image/webp,image/avif" required></label><label>Description<input name="description" maxlength="300" value="Seller return evidence"></label><button class="outline-button" type="submit">Upload evidence</button></form><%}%>
        </div></article><%})%></div><% if(view.queuePage?.hasMore){%><div class="server-pager"><small>Showing <%=view.queuePage.count%> of <%=view.queuePage.total%> return cases</small><a class="outline-button" href="/seller/returns?after=<%=encodeURIComponent(view.queuePage.next)%><%=view.returnFilterQuery?'&amp;'+view.returnFilterQuery:''%>">Older returns</a></div><%}%></section>
      <% } else if (view.section === 'orders') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow">Fulfilment</span><h1>Orders</h1><p>Real customer orders containing items from <%= store.name %>.</p></div><span class="role-status good"><%= view.queuePage?.total ?? view.orders.length %> orders</span></div>
        <section class="panel role-form-section">
          <div class="role-panel-head"><div><h2>Order queue</h2><p>Payment status is server-authoritative; pending payment is not treated as paid.</p></div></div>
          <div class="catalogue-table-wrap"><table class="catalogue-table"><thead><tr><th>Seller order</th><th>Items</th><th>Seller status</th><th>Seller shipment / parcel</th><th>Fulfilment action</th><th>Created</th></tr></thead><tbody>
          <% view.orders.forEach(order => { const parcel = order.parcel; const sellerShipment=order.sellerShipment; %><tr><td><strong><%= order.publicId %></strong><small class="table-subcopy">Marketplace <%= order.orderPublicId %></small></td><td><%= order.items.reduce((sum,item) => sum + item.quantity, 0) %></td><td><span class="role-status <%= ['ready','fulfilled'].includes(order.status) ? 'good' : ['cancelled','refunded'].includes(order.status) ? 'bad' : 'warn' %>"><%= order.status.replaceAll('_',' ') %></span></td><td><% if(sellerShipment && parcel){ %><strong><%= sellerShipment.publicId %></strong><small class="table-subcopy"><%= sellerShipment.status.replaceAll('_',' ') %> · parcel <%= parcel.publicId %></small><small class="table-subcopy">Root delivery <%= sellerShipment.rootShipmentPublicId %> · <%= order.shipment?.status?.replaceAll('_',' ') || 'pending' %></small><% } else if(parcel){ %><span class="role-status bad">Seller shipment reconciliation required</span><small class="table-subcopy">Parcel <%=parcel.publicId%> exists but no seller-shipment aggregate is linked.</small><% } else { %><span class="role-status warn">Shipment pending</span><% } %></td><td><div class="catalogue-table-actions"><% if(order.status === 'confirmed'){ %><form action="/seller/orders/<%=order.publicId%>/processing" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"/><button class="secondary-button" type="submit">Start processing</button></form><% } %><% if(sellerShipment && parcel && ['created','picking'].includes(parcel.status)){ %><form action="/seller/orders/<%=order.publicId%>/parcel/pick" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"/><button class="secondary-button" type="submit">Pick remaining</button></form><% } %><% if(sellerShipment && parcel?.status === 'picked'){ %><form action="/seller/orders/<%=order.publicId%>/parcel/pack" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"/><button class="secondary-button" type="submit">Verify packing</button></form><% } %><% if(sellerShipment && parcel?.status === 'packed'){ %><form action="/seller/orders/<%=order.publicId%>/parcel/dispatch" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"/><button class="primary-button" type="submit">Dispatch parcel</button></form><% } %><% if(sellerShipment && parcel?.status === 'handed_over'){ %><span class="role-status good">Ready for carrier</span><% } %></div></td><td><%= formatDate(order.createdAt) %></td></tr><% }); %>
          <% if (!view.orders.length) { %><tr><td colspan="6"><div class="catalogue-empty">No seller orders yet.</div></td></tr><% } %>
          </tbody></table></div>
          <% if(view.queuePage?.hasMore){%><div class="server-pager"><small>Showing <%=view.queuePage.count%> of <%=view.queuePage.total%> seller orders</small><a class="outline-button" href="/seller/orders?after=<%=encodeURIComponent(view.queuePage.next)%>">Older orders</a></div><%}%><p class="catalogue-helper">Every seller order has an explicit seller-shipment aggregate and parcel inside the root customer delivery. Fulfilment is blocked if that seller-shipment link is missing; payment and root delivery ownership remain server-authoritative.</p>
        </section>
      <% } else if (view.section === 'verification') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow">Trust and safety</span><h1>Seller Verification</h1><p>Submit real store and identity details before products enter moderation.</p></div><span class="role-status <%= view.verification.status === 'approved' ? 'good' : view.verification.status === 'rejected' ? 'bad' : 'warn' %>"><%= view.verification.status.replaceAll('_',' ') %></span></div>
        <div class="role-content-grid catalogue-two-column">
          <div class="catalogue-stack">
            <section class="panel role-form-section">
              <div class="role-panel-head"><div><h2>Store identity</h2><p>Shown to customers after verification.</p></div></div>
              <form action="/seller/store" class="role-form-grid" method="post">
                <input name="_csrf" type="hidden" value="<%= csrfToken %>"/>
                <label class="wide">Store name<input maxlength="140" name="name" required value="<%= store.name %>"/></label>
                <label class="wide">Store description<textarea maxlength="1500" name="description" rows="5"><%= store.description %></textarea></label>
                <button class="primary-button catalogue-form-action" type="submit">Save Store</button>
              </form>
            </section>
            <% if (['draft','rejected'].includes(view.verification.status)) { %>
              <section class="panel role-form-section">
                <div class="role-panel-head"><div><h2>Verification documents</h2><p>Private, access-controlled, sanitized image copies only.</p></div></div>
                <form action="/seller/onboarding/document" class="js-async-upload role-form-grid" enctype="multipart/form-data" method="post">
                  <input name="_csrf" type="hidden" value="<%= csrfToken %>"/>
                  <label>Document type<select name="documentType"><option value="identity">Government identity</option><option value="registration">Business registration</option><option value="tax">Tax document</option><option value="address">Proof of address</option></select></label>
                  <label>Image file<input accept="image/jpeg,image/png,image/webp,image/avif" name="document" required type="file"/></label>
                  <button class="primary-button catalogue-form-action" type="submit">Upload Securely</button>
                  <p class="upload-result wide" role="status"></p>
                </form>
                <div class="catalogue-document-list">
                  <% view.documents.forEach(document => { %><a href="/media/verification/<%= document.publicId %>" rel="noopener" target="_blank"><span><%= document.documentType.replaceAll('_',' ') %></span><strong><%= document.status %></strong></a><% }); %>
                  <% if (!view.documents.length) { %><p class="catalogue-empty">No documents uploaded yet.</p><% } %>
                </div>
              </section>
              <section class="panel role-form-section">
                <div class="role-panel-head"><div><h2>Legal declaration</h2><p>Business sellers need identity and registration documents.</p></div></div>
                <% if (view.verification.status === 'rejected' && view.verification.reviewReason) { %><div class="catalogue-review-note bad"><strong>Previous decision</strong><p><%= view.verification.reviewReason %></p></div><% } %>
                <form action="/seller/onboarding" class="role-form-grid" method="post">
                  <input name="_csrf" type="hidden" value="<%= csrfToken %>"/>
                  <label>Seller type<select name="sellerType"><option <%= view.verification.sellerType === 'individual' ? 'selected' : '' %> value="individual">Individual</option><option <%= view.verification.sellerType === 'business' ? 'selected' : '' %> value="business">Registered business</option></select></label>
                  <label>Legal name<input maxlength="180" name="legalName" required value="<%= view.verification.legalName %>"/></label>
                  <label>Registration number<input maxlength="80" name="registrationNumber" value=""/></label>
                  <label>Tax number<input maxlength="80" name="taxNumber" value=""/></label>
                  <label class="wide catalogue-check"><input name="declaration" required type="checkbox" value="yes"/><span>I confirm these details are accurate and I am authorized to operate this store.</span></label>
                  <button class="primary-button catalogue-form-action" type="submit">Submit for Review</button>
                </form>
              </section>
            <% } else { %>
              <section class="panel catalogue-state-card"><span class="role-metric-icon tone-3"><svg><use href="#i-shield"></use></svg></span><div><h2><%= view.verification.status === 'approved' ? 'Verification complete' : 'Review in progress' %></h2><p><%= view.verification.status === 'approved' ? 'Your store may submit products for catalogue moderation.' : 'Your details are locked while a moderator reviews them.' %></p></div></section>
            <% } %>
          </div>
          <aside class="panel role-focus-panel">
            <div class="role-panel-head compact"><div><h2>Review trail</h2></div></div>
            <div class="server-detail-list"><p><span>Verification ID</span><strong><%= view.verification.publicId %></strong></p><p><span>Submitted</span><strong><%= formatDate(view.verification.submittedAt) %></strong></p><p><span>Reviewed</span><strong><%= formatDate(view.verification.reviewedAt) %></strong></p><p><span>Store status</span><strong><%= store.status.replaceAll('_',' ') %></strong></p></div>
            <% if (view.verification.status === 'rejected') { %><form action="/seller/onboarding/appeal" class="dashboard-form catalogue-appeal" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><label>Appeal decision<textarea maxlength="1000" minlength="20" name="message" required rows="5"></textarea></label><button class="outline-button" type="submit">Submit Appeal</button></form><% } %>
          </aside>
        </div>
      <% } %>

      <% if (view.section === 'products') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow">Database catalogue</span><h1>Products</h1><p>Create drafts, submit for review and publish only after approval.</p></div><div class="catalogue-heading-actions"><a class="outline-button" href="/seller/products/export.csv">Export CSV</a><a class="primary-button" href="/seller/products/new"><svg><use href="#i-plus"></use></svg> New Product</a></div></div>
        <section class="role-metric-grid">
          <% [['draft','Drafts'],['submitted','In review'],['approved','Approved'],['published','Published']].forEach(item => { %><article class="role-metric panel"><span class="role-metric-icon tone-1"><svg><use href="#i-box"></use></svg></span><div><small><%= item[1] %></small><strong><%= view.counts[item[0]] || 0 %></strong><span>Database records</span></div></article><% }); %>
        </section>
        <section class="panel role-table-panel">
          <div class="role-panel-head"><div><h2>Store catalogue</h2><p>Cursor-paginated catalogue ordered by most recently changed.</p></div><a class="outline-button" href="/seller/products/import">Bulk Import</a></div>
          <nav aria-label="Product status" class="role-status-tabs"><a class="<%= !view.status ? 'active' : '' %>" href="/seller/products">All</a><% ['draft','submitted','changes_requested','approved','published','archived'].forEach(status => { %><a class="<%= view.status === status ? 'active' : '' %>" href="/seller/products?status=<%= status %>"><%= status.replaceAll('_',' ') %></a><% }); %></nav>
          <div class="role-table-wrap"><table class="role-table"><thead><tr><th>Product</th><th>Category</th><th>Status</th><th>Quality</th><th>Updated</th><th></th></tr></thead><tbody>
            <% view.products.forEach(product => { %><tr><td><span><%= product.title %></span><small class="catalogue-table-id"><%= product.publicId %></small></td><td><%= product.categoryId?.name || 'Unavailable' %></td><td><span class="role-status <%= ['approved','published'].includes(product.status) ? 'good' : product.status === 'changes_requested' ? 'bad' : 'warn' %>"><%= product.status.replaceAll('_',' ') %></span></td><td><%= product.qualityScore %>%</td><td><%= formatDate(product.updatedAt) %></td><td><a class="outline-button table-action" href="/seller/products/<%= product.publicId %>">Open</a></td></tr><% }); %>
            <% if (!view.products.length) { %><tr><td colspan="6"><div class="catalogue-empty">No products match this view.</div></td></tr><% } %>
          </tbody></table></div><% if(view.queuePage?.hasMore){%><div class="server-pager"><small>Showing <%=view.queuePage.count%> of <%=view.queuePage.total%> products</small><a class="outline-button" href="/seller/products?<% if(view.status){%>status=<%=view.status%>&<%}%>after=<%=encodeURIComponent(view.queuePage.next)%>">Older products</a></div><%}%>
        </section>
      <% } %>

      <% if (view.section === 'product-new') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow">Catalogue</span><h1>Create Product</h1><p>Start with accurate searchable details. Variants and media come next.</p></div><a class="outline-button" href="/seller/products">Back to Products</a></div>
        <section class="panel role-form-section catalogue-editor-card">
          <form action="/seller/products" class="role-form-grid" method="post">
            <input name="_csrf" type="hidden" value="<%= csrfToken %>"/>
            <label class="wide">Product title<input maxlength="180" minlength="3" name="title" required/></label>
            <label>Category<select name="categoryPublicId" required><option value="">Choose category</option><% view.categories.forEach(category => { %><option value="<%= category.publicId %>"><%= category.name %><%= category.restricted ? ' · restricted' : '' %></option><% }); %></select></label>
            <label>Brand<select name="brandPublicId"><option value="">Unbranded</option><% view.brands.forEach(brand => { %><option value="<%= brand.publicId %>"><%= brand.name %></option><% }); %></select></label>
            <label class="wide">Description<textarea maxlength="5000" minlength="20" name="description" required rows="9"></textarea></label><label class="wide">Product video (optional)<input maxlength="800" name="videoUrl" placeholder="https://www.youtube.com/watch?v=... or https://vimeo.com/..." type="url"/></label>
            <fieldset class="wide catalogue-country-field"><legend>Selling countries</legend><div><% view.countries.forEach(item => { %><label><input <%= item.code === store.country ? 'checked' : '' %> name="countries" type="checkbox" value="<%= item.code %>"/><span><%= item.name %></span></label><% }); %></div></fieldset>
            <label class="wide">Search tags<input maxlength="500" name="tags" placeholder="wireless, audio, travel"/></label>
            <button class="primary-button catalogue-form-action" type="submit">Create Draft</button>
          </form>
          <form action="/seller/brands" class="catalogue-brand-request" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><label>Brand missing?<input maxlength="100" minlength="2" name="name" placeholder="Request the exact brand name" required/></label><button class="outline-button" type="submit">Request Brand Review</button></form>
        </section>
      <% } %>

      <% if (view.section === 'product-edit') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow"><%= view.product.publicId %></span><h1><%= view.product.title %></h1><p>Quality <%= view.product.qualityScore %>% · <%= view.product.status.replaceAll('_',' ') %></p></div><a class="outline-button" href="/seller/products">Back to Products</a></div>
        <% if (view.product.moderation?.reason) { %><div class="catalogue-review-note <%= view.product.status === 'changes_requested' ? 'bad' : '' %>"><strong>Moderation note</strong><p><%= view.product.moderation.reason %></p></div><% } %>
        <div class="role-editor">
          <div class="role-editor-main">
            <section class="panel role-form-section">
              <div class="role-panel-head compact"><div><span class="role-section-number">1</span><h2>Product details</h2></div></div>
              <form action="/seller/products/<%= view.product.publicId %>" class="role-form-grid" method="post">
                <input name="_csrf" type="hidden" value="<%= csrfToken %>"/>
                <label class="wide">Product title<input <%= ['draft','changes_requested'].includes(view.product.status) ? '' : 'disabled' %> maxlength="180" name="title" required value="<%= view.product.title %>"/></label>
                <label>Category<select <%= ['draft','changes_requested'].includes(view.product.status) ? '' : 'disabled' %> name="categoryPublicId"><% view.categories.forEach(category => { %><option <%= String(category._id) === String(view.product.categoryId) ? 'selected' : '' %> value="<%= category.publicId %>"><%= category.name %></option><% }); %></select></label>
                <label>Brand<select <%= ['draft','changes_requested'].includes(view.product.status) ? '' : 'disabled' %> name="brandPublicId"><option value="">Unbranded</option><% view.brands.forEach(brand => { %><option <%= String(brand._id) === String(view.product.brandId) ? 'selected' : '' %> value="<%= brand.publicId %>"><%= brand.name %></option><% }); %></select></label>
                <label class="wide">Description<textarea <%= ['draft','changes_requested'].includes(view.product.status) ? '' : 'disabled' %> maxlength="5000" minlength="20" name="description" rows="9"><%= view.product.description %></textarea></label><label class="wide">Product video (optional)<input <%= ['draft','changes_requested'].includes(view.product.status) ? '' : 'disabled' %> maxlength="800" name="videoUrl" placeholder="https://www.youtube.com/watch?v=... or https://vimeo.com/..." type="url" value="<%= view.product.videoUrl || '' %>"/></label>
                <fieldset class="wide catalogue-country-field" <%= ['draft','changes_requested'].includes(view.product.status) ? '' : 'disabled' %>><legend>Selling countries</legend><div><% view.countries.forEach(item => { %><label><input <%= view.product.countries.includes(item.code) ? 'checked' : '' %> name="countries" type="checkbox" value="<%= item.code %>"/><span><%= item.name %></span></label><% }); %></div></fieldset>
                <label class="wide">Search tags<input <%= ['draft','changes_requested'].includes(view.product.status) ? '' : 'disabled' %> maxlength="500" name="tags" value="<%= view.product.tags.join(', ') %>"/></label>
                <% if (['draft','changes_requested'].includes(view.product.status)) { %><button class="primary-button catalogue-form-action" type="submit">Save Details</button><% } %>
              </form>
            </section>
            <section class="panel role-form-section">
              <div class="role-panel-head compact"><div><span class="role-section-number">2</span><h2>Variants and pricing</h2></div></div>
              <div class="catalogue-variant-list"><% view.variants.forEach(variant => { const option = firstOption(variant.options); %><article><div><strong><%= variant.title %></strong><small><%= variant.sku %></small></div><span><%= formatMoney(variant.priceMinor, variant.currency) %></span><span class="role-status <%= variant.active ? 'good' : 'neutral' %>"><%= variant.active ? 'active' : 'inactive' %></span><% if (['draft','changes_requested'].includes(view.product.status)) { %><details class="catalogue-inline-editor"><summary>Edit variant</summary><form action="/seller/products/<%= view.product.publicId %>/variants/<%= variant.publicId %>" class="role-form-grid" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><label>SKU<input maxlength="64" name="sku" required value="<%= variant.sku %>"/></label><label>Barcode<input maxlength="64" name="barcode" value="<%= variant.barcode || '' %>"/></label><label>Name<input maxlength="120" name="title" required value="<%= variant.title %>"/></label><label>Price<input min="0" name="price" required step="<%= ['UGX','RWF'].includes(store.currency) ? '1' : '0.01' %>" type="number" value="<%= moneyInput(variant.priceMinor, variant.currency) %>"/></label><label>Compare at<input min="0" name="compareAt" step="<%= ['UGX','RWF'].includes(store.currency) ? '1' : '0.01' %>" type="number" value="<%= variant.compareAtMinor == null ? '' : moneyInput(variant.compareAtMinor, variant.currency) %>"/></label><label>Option name<input maxlength="60" name="optionName" value="<%= option[0] %>"/></label><label>Option value<input maxlength="80" name="optionValue" value="<%= option[1] %>"/></label><label>Weight grams<input min="0" name="weightGrams" type="number" value="<%= variant.weightGrams %>"/></label><label>Status<select name="active"><option <%= variant.active ? 'selected' : '' %> value="yes">Active</option><option <%= !variant.active ? 'selected' : '' %> value="no">Inactive</option></select></label><button class="outline-button catalogue-form-action" type="submit">Save Variant</button></form></details><% } %></article><% }); %><% if (!view.variants.length) { %><p class="catalogue-empty">Add at least one purchasable variant.</p><% } %></div>
              <% if (['draft','changes_requested'].includes(view.product.status)) { %><form action="/seller/products/<%= view.product.publicId %>/variants" class="role-form-grid catalogue-subform" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><label>SKU<input maxlength="64" name="sku" required/></label><label>Barcode<input maxlength="64" name="barcode" placeholder="EAN / UPC / internal barcode"/></label><label>Variant name<input maxlength="120" name="title" placeholder="Default or Blue / Large" required/></label><label>Price (<%= store.currency %>)<input min="0" name="price" required step="<%= ['UGX','RWF'].includes(store.currency) ? '1' : '0.01' %>" type="number"/></label><label>Compare-at price<input min="0" name="compareAt" step="<%= ['UGX','RWF'].includes(store.currency) ? '1' : '0.01' %>" type="number"/></label><label>Option name<input maxlength="60" name="optionName" placeholder="Color"/></label><label>Option value<input maxlength="80" name="optionValue" placeholder="Blue"/></label><label>Weight in grams<input min="0" name="weightGrams" type="number" value="0"/></label><label>Status<select name="active"><option value="yes">Active</option><option value="no">Inactive</option></select></label><button class="outline-button catalogue-form-action" type="submit">Add Variant</button></form><% } %>
            </section>
            <section class="panel role-form-section">
              <div class="role-panel-head compact"><div><span class="role-section-number">3</span><h2>Product media</h2><small>Required: 3–5 images. Optional: one YouTube or Vimeo video in Product details.</small></div></div>
              <div class="catalogue-media-grid"><% view.media.forEach(media => { %><figure><img alt="<%= media.altText %>" loading="lazy" src="/media/catalogue/<%= media.publicId %>?size=thumb"/><figcaption><span><%= media.altText %></span><strong class="role-status <%= media.status === 'approved' ? 'good' : 'warn' %>"><%= media.status %></strong><% if (media.status === 'ready' && ['draft','changes_requested'].includes(view.product.status)) { %><details class="catalogue-media-editor"><summary>Edit image</summary><form action="/seller/products/<%= view.product.publicId %>/media/<%= media.publicId %>" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><label>Alt text<input maxlength="180" minlength="3" name="altText" required value="<%= media.altText %>"/></label><label>Position<input max="30" min="0" name="position" type="number" value="<%= media.position %>"/></label><button class="outline-button" type="submit">Save</button></form><form action="/seller/products/<%= view.product.publicId %>/media/<%= media.publicId %>/remove" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><button class="catalogue-danger-button" type="submit">Remove</button></form></details><% } %></figcaption></figure><% }); %><% if (!view.media.length) { %><p class="catalogue-empty">Add 3–5 clear product images from different useful angles.</p><% } %></div>
              <% if (['draft','changes_requested'].includes(view.product.status)) { %><form action="/seller/products/<%= view.product.publicId %>/media" class="js-async-upload role-form-grid catalogue-subform" enctype="multipart/form-data" method="post"><label>Image file<input accept="image/jpeg,image/png,image/webp,image/avif" name="image" required type="file"/></label><label>Accessible image description<input maxlength="180" minlength="3" name="altText" required/></label><button class="outline-button catalogue-form-action" type="submit">Sanitize &amp; Upload</button><p class="upload-result wide" role="status"></p></form><% } %>
            </section>
          </div>
          <aside class="role-editor-side">
            <section class="panel role-publish-card"><span class="role-status <%= ['approved','published'].includes(view.product.status) ? 'good' : view.product.status === 'changes_requested' ? 'bad' : 'warn' %>"><%= view.product.status.replaceAll('_',' ') %></span><h2>Publishing workflow</h2><p>Draft → moderation → approval → seller publication.</p>
              <% if (['draft','changes_requested'].includes(view.product.status)) { %><form action="/seller/products/<%= view.product.publicId %>/submit" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><button class="primary-button" type="submit">Submit for Review</button></form><% } %>
              <% if (view.product.status === 'approved') { %><form action="/seller/products/<%= view.product.publicId %>/publish" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><button class="primary-button" type="submit">Publish Product</button></form><% } %>
              <% if (view.product.status !== 'archived') { %><form action="/seller/products/<%= view.product.publicId %>/archive" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><button class="outline-button" type="submit">Archive Product</button></form><% } %>
            </section>
            <section class="panel role-tip-card"><h3>Quality score: <%= view.product.qualityScore %>%</h3><p>Clear titles, detailed descriptions, search tags, variants and several useful images improve product quality.</p></section>
          </aside>
        </div>
      <% } %>

      <% if (view.section === 'inventory') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow">Warehouses and movements</span><h1>Inventory</h1><p>On-hand, reserved, damaged and quarantined stock stay mathematically consistent, with bin and lot traceability.</p></div></div>
        <section class="role-metric-grid">
          <article class="role-metric panel"><span class="role-metric-icon tone-1"><svg><use href="#i-warehouse"></use></svg></span><div><small>Warehouses</small><strong><%= view.warehouses.length %></strong><span>Active locations</span></div></article>
          <article class="role-metric panel"><span class="role-metric-icon tone-2"><svg><use href="#i-box"></use></svg></span><div><small>On hand</small><strong><%= view.stockSummary?.onHand || 0 %></strong><span>All locations</span></div></article>
          <article class="role-metric panel"><span class="role-metric-icon tone-3"><svg><use href="#i-check"></use></svg></span><div><small>Available</small><strong><%= view.stockSummary?.available || 0 %></strong><span>After reservations</span></div></article>
          <article class="role-metric panel"><span class="role-metric-icon tone-4"><svg><use href="#i-upload"></use></svg></span><div><small>Low / out</small><strong><%= view.stockSummary?.lowStock || 0 %></strong><span><%= view.stockSummary?.outOfStock || 0 %> out of stock</span></div></article>
        </section>
        <section class="panel role-table-panel catalogue-warehouse-list"><div class="role-panel-head"><div><h2>Warehouses</h2><p>Archive is allowed only after all stock is cleared.</p></div></div><div><% view.warehouses.forEach(item => { %><article><span><strong><%= item.name %></strong><small><%= item.city %>, <%= item.country %></small></span><details><summary>Edit</summary><form action="/seller/warehouses/<%= item.publicId %>" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><input aria-label="Warehouse name" maxlength="120" name="name" required value="<%= item.name %>"/><input aria-label="Country" maxlength="2" name="country" required value="<%= item.country %>"/><input aria-label="City" maxlength="100" name="city" required value="<%= item.city %>"/><input aria-label="Address" maxlength="300" name="address" required value="<%= item.address %>"/><button class="outline-button" type="submit">Save</button></form></details><form action="/seller/warehouses/<%= item.publicId %>/archive" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><button class="outline-button" type="submit">Archive</button></form></article><% }); %><% if (!view.warehouses.length) { %><p class="catalogue-empty">Create your first warehouse below.</p><% } %></div></section>
        <div class="role-content-grid catalogue-inventory-forms">
          <section class="panel role-form-section"><div class="role-panel-head"><div><h2>Create warehouse</h2><p>One real fulfillment location.</p></div></div><form action="/seller/warehouses" class="role-form-grid" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><label>Warehouse name<input maxlength="120" name="name" required/></label><label>Country<input maxlength="2" name="country" required value="<%= store.country %>"/></label><label>City<input maxlength="100" name="city" required/></label><label>Address<input maxlength="300" name="address" required/></label><button class="primary-button catalogue-form-action" type="submit">Create Warehouse</button></form></section>
          <section class="panel role-form-section"><div class="role-panel-head"><div><h2>Adjust stock</h2><p>Every change creates an immutable movement.</p></div></div><form action="/seller/inventory/adjust" class="role-form-grid" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><label>Warehouse<select name="warehousePublicId" required><option value="">Choose warehouse</option><% view.warehouses.forEach(item => { %><option value="<%= item.publicId %>"><%= item.name %></option><% }); %></select></label><label>Variant<select name="variantPublicId" required><option value="">Choose SKU</option><% view.variants.forEach(item => { %><option value="<%= item.publicId %>"><%= item.sku %> · <%= item.productId?.title || item.title %></option><% }); %></select></label><label>Quantity change<input max="1000000" min="-1000000" name="quantity" required type="number"/></label><label>Reorder point<input min="0" name="reorderPoint" required type="number" value="0"/></label><label class="wide">Reason<input maxlength="300" minlength="3" name="reason" required/></label><button class="primary-button catalogue-form-action" type="submit">Record Adjustment</button></form></section>
          <section class="panel role-form-section"><div class="role-panel-head"><div><h2>Condition &amp; bin</h2><p>Damaged and quarantined units are excluded from sellable stock.</p></div></div><form action="/seller/inventory/condition" class="role-form-grid" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"><label class="wide">Stock item<select name="stockPublicId" required><option value="">Choose stock</option><% view.stock.forEach(item=>{ %><option value="<%=item.publicId%>"><%=item.variantId?.sku||item.publicId%> · <%=item.warehouseId?.name||''%></option><% }) %></select></label><label>Damaged<input type="number" name="damaged" min="0" value="0" required></label><label>Quarantined<input type="number" name="quarantined" min="0" value="0" required></label><label>Bin code<input name="binCode" maxlength="80" placeholder="A-03-12"></label><label class="wide">Reason<input name="reason" minlength="3" maxlength="300" required></label><button class="primary-button catalogue-form-action" type="submit">Update condition</button></form></section>
          <section class="panel role-form-section"><div class="role-panel-head"><div><h2>Batch / serial / expiry lot</h2><p>Optional traceability for products that require lots, serials or expiry control.</p></div></div><form action="/seller/inventory/lots" class="role-form-grid" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"><label class="wide">Stock item<select name="stockPublicId" required><option value="">Choose stock</option><% view.stock.forEach(item=>{ %><option value="<%=item.publicId%>"><%=item.variantId?.sku||item.publicId%> · <%=item.warehouseId?.name||''%></option><% }) %></select></label><label>Quantity<input type="number" name="quantity" min="1" required></label><label>Batch number<input name="batchNumber" maxlength="120"></label><label>Expiry<input type="date" name="expiresAt"></label><label class="wide">Serial numbers<textarea name="serialNumbers" placeholder="One serial per line when serialized"></textarea></label><label class="wide">Notes<input name="notes" maxlength="500"></label><button class="primary-button catalogue-form-action" type="submit">Record lot</button></form></section>
        </div>
        <section class="panel role-table-panel" id="current-stock"><div class="role-panel-head"><div><h2>Current stock &amp; replenishment</h2><p>Available = on hand − reserved − damaged − quarantined. Age is the oldest recorded active lot or first recorded movement; it is operational aging, not FIFO accounting.</p></div></div>
          <form method="get" action="/seller/inventory" class="role-form-grid"><label>SKU / product<input name="stockQ" maxlength="120" value="<%= view.stockFilters?.stockQ || '' %>" placeholder="Search SKU or product"></label><label>Stock state<select name="stockState"><option value="all" <%= (view.stockFilters?.stockState||'all')==='all'?'selected':'' %>>All</option><option value="out" <%= view.stockFilters?.stockState==='out'?'selected':'' %>>Out of stock</option><option value="low" <%= view.stockFilters?.stockState==='low'?'selected':'' %>>Low stock</option><option value="healthy" <%= view.stockFilters?.stockState==='healthy'?'selected':'' %>>Healthy</option></select></label><label>Inactive for<select name="idleDays"><option value="0">Any activity</option><option value="30" <%= Number(view.stockFilters?.idleDays)===30?'selected':'' %>>30+ days</option><option value="60" <%= Number(view.stockFilters?.idleDays)===60?'selected':'' %>>60+ days</option><option value="90" <%= Number(view.stockFilters?.idleDays)===90?'selected':'' %>>90+ days</option><option value="180" <%= Number(view.stockFilters?.idleDays)===180?'selected':'' %>>180+ days</option></select></label><button class="outline-button" type="submit">Filter stock</button></form>
          <div class="role-table-wrap"><table class="role-table"><thead><tr><th>SKU</th><th>Warehouse / bin</th><th>On hand</th><th>Reserved</th><th>Available</th><th>Reorder</th><th>Replenishment</th><th>Recorded age</th><th>Last activity</th></tr></thead><tbody><% view.stock.forEach(item => { %><tr><td><%= item.variantId?.sku || 'Unavailable' %></td><td><%= item.warehouseId?.name || 'Unavailable' %><br><small><%=item.binCode||'No bin'%></small></td><td><%= item.onHand %><br><small><%=item.damaged||0%> damaged · <%=item.quarantined||0%> quarantine</small></td><td><%= item.reserved %></td><td><span class="role-status <%= item.replenishmentState === 'healthy' ? 'good' : 'warn' %>"><%= item.available %></span></td><td><%= item.reorderPoint %></td><td><span class="role-status <%= item.replenishmentState === 'healthy' ? 'good' : 'warn' %>"><%= item.replenishmentState %></span></td><td><%= item.recordedAgeDays == null ? '—' : `${item.recordedAgeDays} days` %><% if(item.oldestActiveLotAt){ %><br><small>oldest active lot</small><% } else if(item.firstRecordedAt){ %><br><small>first movement</small><% } %></td><td><%= item.idleDays == null ? '—' : `${item.idleDays} days ago` %><% if(item.lastSaleAt){ %><br><small>last sale <%= formatDate(item.lastSaleAt) %></small><% } %></td></tr><% }); %><% if (!view.stock.length) { %><tr><td colspan="9"><div class="catalogue-empty">No stock items match this view.</div></td></tr><% } %></tbody></table></div>
          <% if(view.queuePages?.stock){ const stockParams=`stockQ=${encodeURIComponent(view.stockFilters?.stockQ||'')}&stockState=${encodeURIComponent(view.stockFilters?.stockState||'all')}&idleDays=${encodeURIComponent(view.stockFilters?.idleDays||0)}`; %><div class="server-pager"><small>Showing <%=view.queuePages.stock.count%> of <%=view.queuePages.stock.total%> stock item(s)</small><% if(view.queuePages.stock.hasMore){%><a class="outline-button" href="/seller/inventory?<%=stockParams%>&stockAfter=<%=encodeURIComponent(view.queuePages.stock.next)%>#current-stock">More stock</a><%}%></div><% } %>
        </section>
        <section class="panel role-table-panel"><div class="role-panel-head"><div><h2>Traceable lots</h2><p>Batch, serial and expiry metadata stays tied to its warehouse stock item.</p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Lot</th><th>SKU</th><th>Warehouse</th><th>Qty</th><th>Batch / serials</th><th>Expiry</th><th>Status</th><th>Action</th></tr></thead><tbody><% view.lots.forEach(lot=>{ %><tr><td><%=lot.publicId%></td><td><%=lot.variantId?.sku||'—'%></td><td><%=lot.warehouseId?.name||'—'%></td><td><%=lot.quantity%></td><td><%=lot.batchNumber||'—'%><br><small><%=lot.serialNumbers?.length?`${lot.serialNumbers.length} serials`:'No serials'%></small></td><td><%=formatDate(lot.expiresAt)%></td><td><%=lot.status%></td><td><form method="post" action="/seller/inventory/lots/<%=lot.publicId%>/status"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="status"><option value="active">Active</option><option value="quarantined">Quarantined</option><option value="expired">Expired</option><option value="depleted">Depleted</option></select><input name="reason" maxlength="300" placeholder="Reason"><button class="outline-button" type="submit">Update</button></form></td></tr><%})%><% if(!view.lots.length){%><tr><td colspan="8"><div class="catalogue-empty">No traceable lots recorded.</div></td></tr><%}%></tbody></table></div><% if(view.queuePages?.lots){ %><div class="server-pager"><small>Showing <%=view.queuePages.lots.count%> of <%=view.queuePages.lots.total%> lots</small><% if(view.queuePages.lots.hasMore){%><a class="outline-button" href="/seller/inventory?lotsAfter=<%=encodeURIComponent(view.queuePages.lots.next)%>">Older lots</a><%}%></div><% } %></section>
        <section class="panel role-table-panel"><div class="role-panel-head"><div><h2>Recent movement ledger</h2><p>Append-only stock history.</p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Type</th><th>Quantity</th><th>Before</th><th>After</th><th>Reason</th><th>Recorded</th></tr></thead><tbody><% view.movements.forEach(item => { %><tr><td><%= item.type %></td><td><%= item.quantity > 0 ? '+' : '' %><%= item.quantity %></td><td><%= item.onHandBefore %> / <%= item.reservedBefore %></td><td><%= item.onHandAfter %> / <%= item.reservedAfter %></td><td><%= item.reason %></td><td><%= formatDate(item.createdAt) %></td></tr><% }); %><% if (!view.movements.length) { %><tr><td colspan="6"><div class="catalogue-empty">No movements recorded.</div></td></tr><% } %></tbody></table></div><% if(view.queuePages?.movements){ %><div class="server-pager"><small>Showing <%=view.queuePages.movements.count%> of <%=view.queuePages.movements.total%> movements</small><% if(view.queuePages.movements.hasMore){%><a class="outline-button" href="/seller/inventory?movementsAfter=<%=encodeURIComponent(view.queuePages.movements.next)%>">Older movements</a><%}%></div><% } %></section>
      <% } %>

      <% if (view.section === 'bulk-import') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow">Validated catalogue tools</span><h1>Bulk Product Import</h1><p>Preview all rows before a transaction writes any draft.</p></div><a class="outline-button" href="/seller/products">Back to Products</a></div>
        <section class="panel role-form-section"><div class="catalogue-import-help"><strong>Required header</strong><code>title,description,category,sku,price</code><p>Category accepts the exact category name or slug. Imports create drafts and never bypass media or moderation.</p></div><form action="/seller/products/import/preview" class="dashboard-form" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><label>CSV data<textarea class="catalogue-csv" maxlength="256000" name="csv" required rows="14"><%= view.csv %></textarea></label><button class="primary-button" type="submit">Validate Preview</button></form></section>
        <% if (view.preview) { %><section class="panel role-table-panel"><div class="role-panel-head"><div><h2>Import preview</h2><p><%= view.preview.length %> rows · <%= view.preview.filter(row => row.errors.length).length %> with errors</p></div></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Row</th><th>Title</th><th>Category</th><th>SKU</th><th>Price</th><th>Validation</th></tr></thead><tbody><% view.preview.forEach(row => { %><tr><td><%= row.row %></td><td><%= row.title %></td><td><%= row.category %></td><td><%= row.sku %></td><td><%= row.price %></td><td><span class="role-status <%= row.errors.length ? 'bad' : 'good' %>"><%= row.errors.length ? row.errors.join('; ') : 'valid' %></span></td></tr><% }); %></tbody></table></div><% if (!view.preview.some(row => row.errors.length)) { %><form action="/seller/products/import" class="catalogue-import-action" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><textarea hidden name="csv"><%= view.csv %></textarea><button class="primary-button" type="submit">Import <%= view.preview.length %> Drafts</button></form><% } else { %><form action="/seller/products/import/errors.csv" class="catalogue-import-action" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><textarea hidden name="csv"><%= view.csv %></textarea><button class="outline-button" type="submit">Download Error Report</button></form><% } %></section><% } %>
      <% } %>
    </main>
  </div>
  <script src="/dashboard.js"></script>
  <script src="/catalog-workspace.js"></script>
<script src="/image-fallback.js"></script><script src="/operations-ui.js" defer></script></body>
</html>
