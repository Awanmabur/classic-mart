<style>
    /* Common dot styling */
    .dot {
      height: 12px;
      width: 12px;
      border-radius: 50%;
      display: inline-block;
      position: relative;
    }

    /* Tooltip styling */
    .tooltip {
      display: none;
      background-color: black;
      color: white;
      text-align: center;
      border-radius: 5px;
      padding: 5px;
      position: absolute;
      z-index: 1;
      bottom: 125%; /* Position the tooltip above the dot */
      left: 50%;
      margin-left: -160px;
      width: 200px;
    }

    .tooltip::after {
      content: "";
      position: absolute;
      top: 100%; /* Bottom of the tooltip */
      left: 50%;
      margin-left: -5px;
      border-width: 5px;
      border-style: solid;
      border-color: black transparent transparent transparent;
    }

    /* Show tooltip on hover */
    .dot:hover .tooltip {
      display: block;
    }

    /* Color classes for dot */
    .green-dot {
      background-color: green;
    }

    .yellow-dot {
      background-color: yellow;
    }

    .red-dot {
      background-color: red;
    }
  </style>




