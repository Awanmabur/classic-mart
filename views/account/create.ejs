<!-- creating page starts here -->


<div id="contact">
  <div class="create">
    <span>create Product here</span>
  </div>
  <div class="row">
    <form action="/create-Item" method="POST" enctype="multipart/form-data">
    <div class="column" data-aos="zoom-in-left" data-aos-delay="180">

      <label class="contact1">Product Name</label>
      <input required="true" autocomplete="false" class="contact2" type="text" name="itemname" placeholder="Your product Name">
      <label class="contact1">Product price</label>
      <input required="true" autocomplete="false" class="contact2" type="number" min="5" name="price" placeholder="enetr your price">
      <label class="contact1">currency</label>
      <select name="currency" required>
        <option value="">Select currency</option>
        <option value="ssp">ssp</option>
        <option value="usd">usd</option>
        <option value="ugx">ugx</option>
        <option value="aud">aud</option>
        <option value="ksh">ksh</option>

      </select>

      <label class="contact1">Category</label>
      <select name="category" required>
        <option value="">Select Category</option>
        <option value="women">women</option>
        <option value="men">men</option>
        <option value="kids">kids</option>
        <option value="jewelry">jewelry</option>
        <option value="home">home</option>
        <option value="beauty">beauty</option>
        <option value="phones">phones</option>
        <option value="computers">computers</option>
        <option value="electronics">electronics</option>
        <option value="sports">sports</option>
        <option value="office">office</option>
        <option value="toy">toy</option>
        <option value="bags">bags</option>
        <option value="crafts">crafts</option>
        <option value="industrial">industrial</option>
        <option value="baby">baby</option>
        <option value="musical">musical</option>
        <option value="automotive">automotive</option>
        <option value="health">health</option>
        <option value="garden">garden</option>
        <option value="household">household</option>
        <option value="pet">pet</option>
        <option value="appliances">appliances</option>
        <option value="food">food</option>

      </select>
      <label class="contact1" for="subject">Description</label>
      <textarea required="true" autocomplete="false" id="subject" name="description" placeholder="Write something.." style="height:170px"></textarea>



    </div>
    <div class="column" data-aos="zoom-in-right" data-aos-delay="250">

      <label class="contact1">Image 1</label>
      <input class="contact2" type="file" name="image1" accept=".png, .jpg, .jpeg" required>
      <label class="contact1">Image 2</label>
      <input class="contact2" type="file" name="image2" accept=".png, .jpg, .jpeg" required>
      <label class="contact1">Image 3</label>
      <input class="contact2" type="file" name="image3" accept=".png, .jpg, .jpeg" required>
      <label class="contact1">Image 4 (optional)</label>
      <input class="contact2" type="file" name="image4" accept=".png, .jpg, .jpeg">
      <label class="contact1">Image 5 (optional)</label>
      <input class="contact2" type="file" name="image5" accept=".png, .jpg, .jpeg">
      <input type="submit" value="Submit">
      </form>
    </div>
  </div>
</div>

<!-- creating page starts end here -->
