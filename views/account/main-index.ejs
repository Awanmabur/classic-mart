<% item.reverse() %>
  <% if (item.length > 0) { %>

  <div style="margin: -20px; margin-top: 20px" class="row">

    <% item.forEach((item, index) => { %>
    <div class="column1">
        <a href="/itemmore/<%= item._id %>">
        <div class="block" data-rotate-y="180deg" data-move-z="-200px" data-move-x="-300px" data-aos-duration="1100">
          <img src="<%= cloudinary.url(item.image1_id, {type: 'fetch', fetch_format: 'auto', quality: 'auto'}) %>" alt="item Image">
        <h4 id="itemname"><%= item.itemname?.slice(0, 25) %>.... </h4>
        <table>
          <tr>
            <td><p id="InitialPrice"><%= item.currency %> <%= calculateInitialPrice(item.price) %></p></td>
            <td><h3 id="realprice"><%= item.currency %> <%= item.price %> </h3></td>
          </tr>
         </table>
        </div>
        </a>
        </div>

      <% }); %>

      </div>

      <% } else { %>
      <p class="emptyitem">No item found now, please come back later.</p>
      <% } %>
