<%-include("../partials/header") %>


<%-include("../partials/dropdown") %>


<%-include("../partials/flash") %>


  <section  id="faq">

      <div class="faq-container">
     <% users.forEach(user => { %>
        <div class="faq data-aos="fade-up" data-aos-delay="150"">
          <h3 class="faq-title">
            <a style="margin-left: -20px" href="/visit/<%= user._id %>"><i class="fa fa-2x fa-user" aria-hidden="true"></i> </a>

            <a style="margin-left: 10px" href="/visit/<%= user._id %>"><%= user.fname %> <%= user.lname %></a>

            <a class="link-item">
                <span class="number">items</span>
                <span class="text"><%= user.postCount %></span>
            </a>

            <a class="link-item">
              <span class="number">followers</span>
              <span class="text"><%= user.followers %></span>
            </a>

            <a class="link-item">
              <span class="number">likes</span>
              <span class="text"><%= user.likes %></span>
            </a>

            <a style="margin-left: 100px" class="link-item" href="/visit/<%= user._id %>">more info </a>
          </h3>

          <a href="/visit/<%= user._id %>">
            <button class="faq-toggle">
              <i class="fas fa-chevron-right"></i>
            </button>
          </a>
        </div>
     <% }) %>
      </div>

  </section>
  <%-include("../partials/footer") %>
