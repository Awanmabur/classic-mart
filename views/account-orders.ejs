<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My orders · Classic Mart</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/account.css"></head>
<body class="account-body">
<%- include('partials/account-top') %>
<%- include('partials/account-nav', { accountSection: 'orders' }) %>
<main class="account-wrap account-main">
  <% if (flash) { %><div class="account-flash <%= flash.type==='error'?'error':'' %>"><strong><%= flash.message %></strong></div><% } %>
  <div class="account-heading"><h1>My orders</h1><p>Order history, payment status, fulfilment, returns and receipts.</p></div>
  <section class="account-card">
    <div class="account-list">
      <% if (!(orders || []).length) { %><div class="account-empty">You have no orders yet. <a href="/categories">Start shopping</a>.</div><% } %>
      <% (orders || []).forEach((order) => { const first = order.items?.[0]; %>
        <article class="account-item">
          <div>
            <strong><%= first?.title || 'Classic Mart order' %></strong>
            <p>Order <%= order.publicId %> · <%= formatDate(order.createdAt) %></p>
            <small><%= order.paymentState %> payment · <%= order.fulfillmentState %> fulfilment · <%= order.deliveryMethod %></small>
            <% if (order.returnState && order.returnState !== 'none') { %><small>Return: <%= order.returnState %></small><% } %>
            <% if (order.refundState && order.refundState !== 'none') { %><small>Refund: <%= order.refundState %></small><% } %>
          </div>
          <div class="account-actions">
            <strong><%= formatMoney(order.totals?.totalMinor || 0, order.totals?.currency || user.currency) %></strong>
            <a class="account-link" href="/track-order?order=<%= encodeURIComponent(order.publicId) %>">Track</a>
            <a class="account-link" href="/orders/<%= encodeURIComponent(order.publicId) %>/receipt">Receipt</a>
            <a class="account-link" href="/account/returns">Returns &amp; support</a>
          </div>
        </article>
      <% }) %>
    </div>
    <% if (queuePage?.hasMore) { %><p><a class="account-link" href="/account/orders?after=<%= encodeURIComponent(queuePage.next) %>">Older orders</a></p><% } %>
  </section>
</main>
</body>
</html>
