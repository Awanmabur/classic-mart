<!DOCTYPE html>

<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<meta content="Create a new password for your Classic Mart account." name="description"/>
<meta content="#ff6500" name="theme-color"/>
<title>Reset Password — Classic Mart</title>
<link href="/styles.css" rel="stylesheet"/>
<link href="/storefront-pages.css" rel="stylesheet"/>
</head>
<body class="storefront-page auth-compact-page auth-standalone-page">
<a class="skip-link" href="#authContent">Skip to password reset</a>
<main class="auth-main page-shell" id="authContent">
<section aria-label="Reset your Classic Mart password" class="auth-grid recovery-grid">
<article class="auth-card auth-showcase reset-showcase">
<div>
<span class="auth-showcase-badge"><img alt="" src="/assets/icons/lock.svg"/>Secure reset</span>
<div class="auth-showcase-copy">
<h1>Create a stronger <span>new password.</span></h1>
<p>Use at least eight characters and combine letters, numbers or symbols. Avoid reusing a password from another account.</p>
<div class="password-rules">
<div><img alt="" src="/assets/icons/check.svg"/><span>At least 8 characters</span></div>
<div><img alt="" src="/assets/icons/check.svg"/><span>One uppercase and one lowercase letter</span></div>
<div><img alt="" src="/assets/icons/check.svg"/><span>At least one number</span></div>
</div>
</div>
</div>
<div class="auth-social-proof"><div aria-hidden="true" class="auth-avatars"><span>CM</span><span>✓</span></div><div><strong>Secure account access</strong><small>Your saved items and orders stay connected.</small></div></div>
</article>
<article class="auth-card auth-form-card recovery-form-card">
<div class="auth-form-head">
<span class="auth-kicker">Reset password</span>
<h2>Choose your new password.</h2>
<p id="resetIdentityText">Enter the verification code and a new password to continue.</p>
</div>
<form action="/reset-password" class="auth-form" id="resetPasswordForm" method="post">
<input name="_csrf" type="hidden" value="<%= csrfToken %>"/>
<label class="auth-field"><span>Verification code</span><span class="auth-input-wrap"><img alt="" src="/assets/icons/circle-check.svg"/><input id="resetCode" inputmode="numeric" maxlength="6" name="code" placeholder="Six-digit code" required="" type="text"/></span></label>
<label class="auth-field"><span>New password</span><span class="auth-input-wrap"><img alt="" src="/assets/icons/lock.svg"/><input autocomplete="new-password" id="resetNewPassword" maxlength="128" minlength="12" name="password" placeholder="12+ characters, mixed case and a number" required="" type="password"/><button aria-label="Show password" class="password-toggle" data-password-toggle="resetNewPassword" type="button"><img alt="" src="/assets/icons/eye.svg"/></button></span></label>
<label class="auth-field"><span>Confirm new password</span><span class="auth-input-wrap"><img alt="" src="/assets/icons/lock.svg"/><input autocomplete="new-password" id="resetConfirmPassword" maxlength="128" minlength="12" name="confirmPassword" placeholder="Repeat new password" required="" type="password"/><button aria-label="Show password" class="password-toggle" data-password-toggle="resetConfirmPassword" type="button"><img alt="" src="/assets/icons/eye.svg"/></button></span></label>
<p aria-live="polite" class="auth-message<%= pageError ? ' error' : '' %>" id="authMessage" role="status"><%= pageError || flash?.message || '' %></p>
<% if (flash?.details) { %><p class="auth-message"><%= flash.details %></p><% } %>
<button class="auth-submit" type="submit">Save New Password</button>
</form>
<p class="auth-switch">Need a new reset request? <a href="/forgot-password">Start again</a></p>
</article>
</section>
</main>
<div aria-live="polite" class="page-toast" id="pageToast" role="status"></div>
<script src="/identity.js"></script>
<script src="/image-fallback.js"></script></body>
</html>
