<!DOCTYPE html>

<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<meta content="Browse, search and filter products across Classic Mart categories." name="description"/>
<meta content="#ff6200" name="theme-color"/>
<title>Search Classic Mart — Products, brands and categories</title>
<link href="/styles.css" rel="stylesheet"/>
<link href="/storefront-pages.css" rel="stylesheet"/>
<link href="/marketplace-pages.css" rel="stylesheet"/>
</head>
<body class="catalog-body" data-page-mode="search">
<a class="skip-link" href="#catalogMain">Skip to products</a><div class="utility-bar">
<div class="container utility-inner">
<button class="utility-location text-button" data-open="locationModal" type="button">
<img alt="" aria-hidden="true" src="/assets/icons/location-dot.svg"/>
        Deliver to <strong id="deliveryLocation"><%= deliveryLocation || country?.name || "Uganda" %></strong>
</button>
<div class="shipping-note">
<img alt="" aria-hidden="true" src="/assets/icons/truck-fast.svg"/>
<strong>Delivery pricing</strong> calculated for your country at checkout
      </div>
<nav aria-label="Utility navigation" class="utility-links">
<a class="text-button" href="/signup?role=seller">Sell on Classic Mart</a>
<a class="text-button utility-text-link" href="/sellers">Seller Center</a><a class="text-button utility-text-link" href="/promoters">Promoters Center</a>
<a class="text-button" href="/track-order">Track Order</a>
<a class="text-button" href="/help">Help &amp; Support</a>
<button aria-expanded="false" class="language-button" id="languageButton" type="button">
<img alt="" aria-hidden="true" src="/assets/icons/globe.svg"/> <%= country?.locale?.split("-")[0].toUpperCase() || "EN" %> | <%= currency || country?.currency || "UGX" %>
          <img alt="" aria-hidden="true" class="tiny-icon" src="/assets/icons/chevron-down.svg"/>
</button>
</nav>
</div>
</div><header class="site-header" id="top">
<div class="container header-main">
<a aria-label="Classic Mart home" class="brand" href="/#top">
<img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/>
<small>Everything, for everyone</small>
</a>
<form class="search-bar" id="searchForm" role="search">
<label class="sr-only" for="searchCategory">Product category</label>
<select aria-label="Product category" class="category-select" id="searchCategory">
<option value="all">Loading categories…</option>
</select>
<label class="sr-only" for="searchInput">Search products</label>
<input autocomplete="off" id="searchInput" placeholder="Search for products, brands and more..." type="search"/>
<div class="search-tool-actions" aria-label="Alternative search options">
<button aria-label="Search by image" class="search-tool-button" data-image-search type="button" title="Search by image"><img alt="" aria-hidden="true" src="/assets/icons/camera.svg"/></button>
<button aria-label="Search by voice" class="search-tool-button" data-voice-search type="button" title="Search by voice"><img alt="" aria-hidden="true" src="/assets/icons/microphone.svg"/></button>
<input accept="image/jpeg,image/png,image/webp,image/avif" class="sr-only" data-image-search-input type="file"/>
</div>
<button class="search-button" type="submit">
<img alt="" aria-hidden="true" src="/assets/icons/magnifying-glass.svg"/><span>Search</span>
</button>
<div aria-label="Search suggestions" class="search-suggestions" id="searchSuggestions" role="listbox"></div>
</form>
<div class="header-actions">
<a aria-label="Open your Classic Mart profile" class="header-action header-action-link" href="/dashboard">
<span class="header-action-icon"><img alt="" aria-hidden="true" src="/assets/icons/user.svg"/></span>
<span class="header-action-copy"><small>Your account</small><strong>Profile</strong></span>
<img alt="" aria-hidden="true" class="header-chevron" src="/assets/icons/chevron-right.svg"/>
</a>
<a aria-label="Open your wishlist" class="header-action wishlist-trigger" href="/wishlist"><span class="header-action-icon"><img alt="" aria-hidden="true" src="/assets/icons/heart-regular.svg"/></span><span class="header-action-copy"><small>Saved items</small><strong>Wishlist</strong></span><b class="count-badge wishlist-count-badge" data-wishlist-count="">0</b></a><a aria-label="Open your full cart and checkout" class="header-action cart-trigger" href="/cart" id="cartTrigger">
<span class="header-action-icon"><img alt="" aria-hidden="true" src="/assets/icons/cart-shopping.svg"/></span>
<span class="header-action-copy"><small>Your basket</small><strong>Cart</strong></span>
<b class="count-badge" id="cartCount">0</b>
</a>
</div>
</div>
<div class="nav-shell">
<div class="container nav-inner">
<button aria-controls="categoryPanel" aria-expanded="false" class="browse-button" id="menuToggle" type="button">
<img alt="" aria-hidden="true" src="/assets/icons/bars.svg"/>
<span>Browse Categories</span>
<img alt="" aria-hidden="true" class="browse-chevron" src="/assets/icons/chevron-down.svg"/>
</button>
<nav aria-label="Primary navigation" class="primary-nav" id="primaryNav">
<span class="primary-nav-main">
<a class="active" href="/#top">Home</a>
<a href="/categories">Categories <span class="tiny-badge">—</span></a>
<a href="/products?view=deals">Flash Deals <span class="hot-badge">HOT</span></a>
<a href="/products?view=new">New Arrivals</a>
<a href="/products?view=brands">Top Brands</a>
<a href="/#features">Features <img alt="" aria-hidden="true" src="/assets/icons/chevron-down.svg"/></a>
<a href="/wishlist">Wishlist</a><a href="/compare">Compare</a></span>
<span aria-label="Featured marketplace links" class="primary-nav-end">
<a href="/products?view=deals">Best Deals</a>
<a class="classic-live-link" href="/products?view=fresh"><span aria-hidden="true" class="live-dot"></span>Classic Live</a>
</span>
</nav>
<button aria-label="Open search" class="mobile-search-button" id="mobileSearchButton" type="button">
<img alt="" aria-hidden="true" src="/assets/icons/magnifying-glass.svg"/>
</button>
</div>
</div>
</header>
<main class="catalog-main" id="catalogMain">
<section class="catalog-hero">
<div class="container catalog-hero-inner">
<nav aria-label="Breadcrumb" class="catalog-breadcrumb"><a href="/">Home</a><span>›</span><strong id="catalogBreadcrumb">Search Classic Mart</strong></nav>
<div class="catalog-hero-copy">
<div><span id="catalogEyebrow">Classic Mart marketplace</span><h1 id="catalogTitle">Search Classic Mart</h1><p id="catalogDescription">Find products by name, brand or category, then refine the results by price, rating and availability.</p></div>
<div class="catalog-hero-benefits"><span><img alt="" src="/assets/icons/circle-check.svg"/> Verified listings</span><span><img alt="" src="/assets/icons/rotate-left.svg"/> Easy returns</span><span><img alt="" src="/assets/icons/lock.svg"/> Secure checkout</span></div>
</div>
</div>
</section>
<section class="container category-directory" hidden="" id="categoryDirectory">
<div class="catalog-section-heading"><div><span>Explore departments</span><h2>Shop all categories</h2></div><p>Choose a department to see products, deals and popular brands in one place.</p></div>
<div class="category-directory-grid" id="categoryDirectoryGrid"></div>
<div class="category-feature-strip">
<article><img alt="" src="/assets/icons/truck-fast.svg"/><div><strong>Tracked delivery</strong><small>See delivery information before checkout</small></div></article>
<article><img alt="" src="/assets/icons/rotate-left.svg"/><div><strong>Simple returns</strong><small>Manage eligible return requests from your account</small></div></article>
<article><img alt="" src="/assets/icons/headset.svg"/><div><strong>Responsive support</strong><small>Get help before and after your order</small></div></article>
</div>
</section>
<section class="container catalog-workspace" id="catalogWorkspace">
<aside class="catalog-filter-panel" id="catalogFilterPanel">
<div class="filter-panel-head"><div><span>Refine results</span><h2>Filters</h2></div><button aria-label="Close filters" id="closeCatalogFilters" type="button"><img alt="" src="/assets/icons/xmark.svg"/></button></div>
<form id="catalogFilterForm">
<label class="catalog-field">Search within results<input id="catalogQuery" placeholder="Product or brand" type="search"/></label>
<fieldset><legend>Category</legend><div class="filter-category-list" id="filterCategoryList"></div></fieldset>
<fieldset><legend>Price range</legend><div class="price-input-grid"><label>Minimum<input id="minPrice" min="0" placeholder="0" step="1" type="number"/></label><label>Maximum<input id="maxPrice" min="0" placeholder="No maximum" step="1" type="number"/></label></div></fieldset>
<fieldset><legend>Minimum rating</legend><div class="rating-filter-list"><label><input checked="" name="rating" type="radio" value="0"/><span>Any rating</span></label><label><input name="rating" type="radio" value="4"/><span>★★★★☆ &amp; up</span></label><label><input name="rating" type="radio" value="4.5"/><span>★★★★★ 4.5+</span></label></div></fieldset>
<fieldset><legend>Availability</legend><label class="filter-check"><input id="inStockOnly" type="checkbox"/><span>In-stock products only</span></label><label class="filter-check"><input id="discountOnly" type="checkbox"/><span>Discounted products</span></label></fieldset>
<div class="filter-panel-actions"><button class="catalog-primary-button" type="submit">Apply filters</button><button class="catalog-secondary-button" id="clearCatalogFilters" type="button">Clear all</button></div>
</form>
</aside>
<div class="catalog-results-area">
<div class="catalog-toolbar">
<div><button class="mobile-filter-trigger" id="openCatalogFilters" type="button"><img alt="" src="/assets/icons/filter.svg"/> Filters</button><p id="catalogResultCount">Loading products…</p></div>
<div class="catalog-view-controls"><label>Sort by<select id="catalogSort"><option value="featured">Featured</option><option value="rating">Top rated</option><option value="popular">Most popular</option><option value="price-low">Price: low to high</option><option value="price-high">Price: high to low</option><option value="discount">Biggest discount</option></select></label><button aria-label="Grid view" class="view-mode-button active" data-view-mode="grid" type="button"><img alt="" src="/assets/icons/table-cells-large.svg"/></button><button aria-label="List view" class="view-mode-button" data-view-mode="list" type="button"><img alt="" src="/assets/icons/bars.svg"/></button></div>
</div>
<div class="active-filter-row" id="activeFilterRow"></div>
<div aria-live="polite" class="catalog-product-grid" id="catalogProductGrid"></div>
<div class="catalog-empty" hidden="" id="catalogEmpty"><span><img alt="" src="/assets/icons/magnifying-glass.svg"/></span><h2>No matching products</h2><p>Try a different search term, category, price range or rating.</p><button class="catalog-primary-button" id="emptyClearButton" type="button">Clear filters</button></div>
<nav aria-label="Product pages" class="catalog-pagination" id="catalogPagination"></nav>
</div>
</section>
</main>
<div class="catalog-filter-backdrop" hidden="" id="catalogFilterBackdrop"></div>
<div aria-live="polite" class="page-toast" id="catalogToast" role="status"></div>
<%- include("partials/product-preview-modal") %>
<section class="newsletter">
<div class="container newsletter-inner">
<div class="newsletter-message"><span><img alt="" src="/assets/icons/envelope.svg"/></span><div><strong>Stay in the Loop!</strong><small>Get exclusive deals, new arrivals and shopping tips.</small></div></div>
<form class="newsletter-form" data-newsletter-form id="newsletterForm" novalidate>
<label class="sr-only" for="newsletterEmail">Email address</label>
<input autocomplete="email" id="newsletterEmail" maxlength="254" name="email" placeholder="Enter your email address" required type="email"/>
<button type="submit">Subscribe</button>
<p aria-live="polite" class="newsletter-status" data-newsletter-status></p>
</form>
<div class="newsletter-perks"><span><img alt="" src="/assets/icons/percent.svg"/><b>Exclusive Deals</b></span><span><img alt="" src="/assets/icons/gift.svg"/><b>New Arrivals</b></span><span><img alt="" src="/assets/icons/location-dot.svg"/><b>Shopping Tips</b></span></div>
</div>
</section><footer class="site-footer">
<div class="container footer-grid">
<div class="footer-about">
<a class="brand footer-brand" href="/#top"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a>
<p>Your one-stop marketplace for products from trusted sellers, with secure checkout and customer support.</p>
<div class="socials" aria-label="Official Classic Mart social channels are not published yet"><span aria-label="Facebook channel not published" title="Official Facebook channel not published yet"><img alt="" src="/assets/icons/facebook-f.svg"/></span><span aria-label="X channel not published" title="Official X channel not published yet"><img alt="" src="/assets/icons/x-twitter.svg"/></span><span aria-label="Instagram channel not published" title="Official Instagram channel not published yet"><img alt="" src="/assets/icons/instagram.svg"/></span><span aria-label="YouTube channel not published" title="Official YouTube channel not published yet"><img alt="" src="/assets/icons/youtube.svg"/></span><span aria-label="Pinterest channel not published" title="Official Pinterest channel not published yet"><img alt="" src="/assets/icons/pinterest.svg"/></span></div>
</div>
<div><h3>Shop</h3><a href="/categories">All Categories</a><a href="/products?view=deals">Flash Deals</a><a href="/products?view=new">New Arrivals</a><a href="/products?view=brands">Top Brands</a><a class="footer-link" href="/signup?role=seller">Sell on Classic Mart</a><a href="/sellers">Browse Sellers</a><a href="/promoters">Promoters Center</a><a href="/wishlist">My Wishlist</a><a href="/dashboard">My Profile</a></div>
<div><h3>Customer Service</h3><a class="footer-link" href="/help">Help Center</a><a class="footer-link" href="/track-order">Track Order</a><a class="footer-link" href="/returns">Returns &amp; Refunds</a><a class="footer-link" href="/shipping">Shipping Info</a><a class="footer-link" href="/contact">Contact Us</a></div>
<div><h3>About Us</h3><a class="footer-link" href="/about">About Classic Mart</a><a class="footer-link" href="/careers">Careers</a><a class="footer-link" href="/press">Press &amp; News</a><a class="footer-link" href="/sellers">Seller Center</a></div>
<div><h3>Policies</h3><a class="footer-link" href="/privacy">Privacy Policy</a><a class="footer-link" href="/terms">Terms of Service</a><a class="footer-link" href="/cookies">Cookie Policy</a><a class="footer-link" href="/payments">Payment Policy</a></div>
<div class="app-download"><h3>Classic Mart App</h3><p>Install the secure Classic Mart PWA for an app-like experience using the same live marketplace data.</p><a class="app-badge" href="/app"><img alt="" src="/assets/icons/mobile-screen-button.svg"/><span>INSTALL<strong>Classic Mart</strong></span></a></div>
</div>
<div class="container footer-bottom"><span>© 2026 Classic Mart. All rights reserved.</span><span>Secure payments · Buyer protection · Trusted sellers</span></div>
</footer><script src="/cart-store.js"></script>
<script src="/catalog-page.js"></script>
<script src="/product-preview.js"></script>
<script src="/shared-shell.js"></script><script src="/image-fallback.js"></script><script src="/country-switcher.js"></script><script src="/search-tools.js"></script><script src="/newsletter.js"></script></body>
</html>
