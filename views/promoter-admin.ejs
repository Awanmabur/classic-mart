<!doctype html><html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Promoter Operations — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"></head><body><main class="catalog-workspace"><header class="catalog-topbar"><div><a class="brand" href="/dashboard"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p>Promoter operations</p></div><a class="outline-button" href="/dashboard">Dashboard</a></header><section class="catalog-page-head panel"><div><span class="eyebrow">Country control</span><h1>Promoter &amp; campaign review</h1><p>Verification and campaign activation require an explicit country-scoped operator decision.</p></div></section>
<section class="panel"><h2>Verification queue</h2><div class="table-wrap"><table><thead><tr><th>ID</th><th>Country</th><th>Status</th><th>Channels</th><th>Action</th></tr></thead><tbody><% if(!verifications.length){%><tr><td colspan="5">No promoter verification records.</td></tr><%}%><% verifications.forEach(v=>{ %><tr><td><%=v.publicId%></td><td><%=v.country%></td><td><%=v.status%></td><td><%=v.channels?.join(', ')||'—'%></td><td><% if(v.status==='submitted'){%><form method="post" action="/admin/promoters/<%=v.publicId%>/review"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="decision"><option value="approve">Approve</option><option value="reject">Reject</option></select><input name="reason" maxlength="500" placeholder="Review reason"><button type="submit">Apply</button></form><%}else{%>—<%}%></td></tr><% }) %></tbody></table></div></section>
<section class="panel"><h2>Campaign review</h2><div class="table-wrap"><table><thead><tr><th>Campaign</th><th>Status</th><th>Commission</th><th>Products</th><th>Action</th></tr></thead><tbody><% if(!campaigns.length){%><tr><td colspan="5">No campaigns.</td></tr><%}%><% campaigns.forEach(c=>{ %><tr><td><%=c.name%><br><small><%=c.publicId%> · <%=c.country%></small></td><td><%=c.status%></td><td><%=(c.commissionBps/100).toFixed(2)%>%</td><td><%=c.productPublicIds?.length||0%></td><td><% if(c.status==='submitted'){%><form method="post" action="/admin/campaigns/<%=c.publicId%>/review"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="decision"><option value="approve">Approve</option><option value="reject">Reject</option></select><input name="reason" maxlength="500" placeholder="Review reason"><button type="submit">Apply</button></form><%}else{%>—<%}%></td></tr><% }) %></tbody></table></div></section>
<div class="role-content-grid"><section class="panel"><h2>Attribution</h2><p><strong><%=touches.length%></strong> recent server-side touches.</p><% touches.slice(0,20).forEach(t=>{%><article class="catalog-row"><div><strong><%=t.publicId%></strong><small><%=t.status%> · fraud score <%=t.fraudScore||0%> · <%=t.fraudFlags?.join(', ')||'no flags'%></small></div></article><%})%></section><section class="panel"><h2>Commissions</h2><p><strong><%=commissions.length%></strong> recent item-level commission records.</p><% commissions.slice(0,20).forEach(c=>{%><article class="catalog-row"><div><strong><%=c.orderPublicId%></strong><small><%=c.amountMinor%> <%=c.currency%> · <%=c.status%><% if(c.appeal?.status&&c.appeal.status!=='none'){%> · appeal <%=c.appeal.status%><%}%></small></div><% if(c.appeal?.status==='pending'){%><form method="post" action="/admin/commissions/<%=c.publicId%>/appeal"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="decision"><option value="accept">Accept appeal</option><option value="reject">Reject appeal</option></select><input name="reason" minlength="10" maxlength="1200" required placeholder="Review decision"><button type="submit">Review</button></form><%}%></article><%})%></section></div>
</main></body></html>
