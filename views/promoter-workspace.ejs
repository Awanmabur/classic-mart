<!doctype html><html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Promoter Center — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"></head><body data-operations-ui="true"><main class="catalog-workspace">
<header class="catalog-topbar"><div><a class="brand" href="/"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p>Promoter Center</p></div><div class="catalog-actions"><a class="outline-button" href="/money">Wallet &amp; payouts</a><a class="outline-button" href="/dashboard">Dashboard</a></div></header>
<section class="catalog-page-head panel"><div><span class="eyebrow">Promoter</span><h1>Campaigns, attribution &amp; earnings</h1><p>Tracked links, approved campaign facts, transparent attribution and ledger-backed commission status.</p></div></section>
<div class="stats-grid"><article class="stat-card"><span>Verification</span><strong><%= summary.verification?.status || 'Not submitted' %></strong></article><article class="stat-card"><span>Estimated</span><strong class="workspace-money"><%=formatMoney(summary.commissionStages?.estimatedMinor||0,summary.totals?.currency||summary.commissions[0]?.currency||user.currency)%></strong><small><%=summary.commissionStages?.estimatedCount||0%> commission(s)</small></article><article class="stat-card"><span>Payable</span><strong class="workspace-money"><%=formatMoney(summary.commissionStages?.payableMinor||0,summary.totals?.currency||summary.commissions[0]?.currency||user.currency)%></strong><small><%=summary.commissionStages?.payableCount||0%> commission(s)</small></article><article class="stat-card"><span>Paid</span><strong class="workspace-money"><%=formatMoney(summary.commissionStages?.paidMinor||0,summary.totals?.currency||summary.commissions[0]?.currency||user.currency)%></strong></article></div>
<section class="panel" id="commission-lifecycle"><div class="role-panel-head"><div><h2>Commission lifecycle &amp; reconciliation</h2><p>Classic Mart records attribution and commission policy server-side when the conversion is accepted. Estimated commission becomes payable when the order/payment rules are satisfied; payout settlement then moves it to paid. Refunds and provider chargebacks reduce the same recorded commission and retain the reversal reason.</p></div><div class="catalog-actions"><a class="outline-button" href="/promoter/commissions.csv">Export commission statement</a><a class="outline-button" href="/money">Payout reconciliation</a></div></div><div class="stats-grid"><article class="stat-card"><span>Reversed / adjusted</span><strong class="workspace-money"><%=formatMoney(summary.commissionStages?.reversedMinor||0,summary.totals?.currency||summary.commissions[0]?.currency||user.currency)%></strong></article><article class="stat-card"><span>Fraud-held attribution</span><strong><%=summary.risk?.blockedTouches||0%></strong><small>Blocked touches earn no commission.</small></article><article class="stat-card"><span>Pending appeals</span><strong><%=summary.risk?.pendingAppeals||0%></strong></article><article class="stat-card"><span>Submitted payouts</span><strong><%=summary.risk?.submittedPayouts||0%></strong></article></div><% if(summary.risk?.unknownPayouts){ %><div class="risk-banner"><strong>UNKNOWN payout reconciliation required</strong><p><%=summary.risk.unknownPayouts%> payout(s) have an ambiguous provider outcome. Do not request or retry the same money; open Wallet &amp; payouts so Finance can reconcile the stable provider reference first.</p></div><% } %><p><small>The lifecycle intentionally has no separate hidden “approved” state: becoming <strong>Payable</strong> is the approval/ledger-recognition boundary. Paid means a reconciled payout has consumed that payable balance.</small></p></section>
<% if(!summary.verification || ['rejected'].includes(summary.verification.status)){ %><section class="panel"><div class="role-panel-head"><div><h2>Promoter verification</h2><p>Accept disclosure rules and submit the channels and niches you actually use.</p></div></div><form method="post" action="/promoter/verification" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Channels, comma separated<input name="channels" required placeholder="instagram, whatsapp"></label><label>Niches, comma separated<input name="niches" required placeholder="fashion, electronics"></label><button type="submit">Submit verification</button></form></section><% } %>
<section class="panel"><div class="role-panel-head"><div><h2>Campaign marketplace</h2><p>Apply first; links are only available after approval.</p></div></div><div class="table-wrap"><table><thead><tr><th>Campaign</th><th>Commission</th><th>Channels</th><th>Application</th></tr></thead><tbody><% if(!summary.campaigns.length){%><tr><td colspan="4">No active campaigns in your country.</td></tr><%}%><% summary.campaigns.forEach(c=>{ const app=c.promoterApplication; %><tr><td><strong><%=c.name%></strong><br><small><%=c.publicId%> · <%=c.visibility%></small></td><td><%=(c.commissionBps/100).toFixed(2)%>%</td><td><%=c.allowedChannels.join(', ')||'Any approved channel'%></td><td><% if(!app){%><form method="post" action="/promoter/campaigns/<%=c.publicId%>/apply"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="note" maxlength="1000" placeholder="Why this campaign fits your audience"><button type="submit">Apply</button></form><%}else{%><span class="status-chip"><%=app.status%></span><%}%></td></tr><%})%></tbody></table></div><% if(summary.queuePages?.campaigns?.hasMore){ %><p><a class="server-pager" href="/promoter?campaignsAfter=<%=encodeURIComponent(summary.queuePages.campaigns.next)%>">Older campaigns</a></p><% } %></section>
<section class="panel"><div class="role-panel-head"><div><h2>Create tracked link</h2><p>Only an approved campaign application can issue a signed server-side attribution link.</p></div></div><form method="post" action="/promoter/links" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Campaign<select name="campaignId" required><option value="">Select campaign</option><% summary.campaigns.forEach(c=>{ const app=c.promoterApplication; if(app?.status==='approved'){ %><option value="<%=c.publicId%>"><%=c.name%></option><% } }) %></select></label><label>Destination path<input name="destination" value="/" pattern="/[A-Za-z0-9/_?&=.%+\-]*" required></label><label>Channel<input name="channel" maxlength="50" placeholder="whatsapp"></label><label>Coupon code<input name="couponCode" maxlength="32"></label><label>Sub ID<input name="subId" maxlength="80"></label><label>UTM source<input name="utmSource" maxlength="80" value="classicmart-promoter"></label><label>UTM medium<input name="utmMedium" maxlength="80" value="affiliate"></label><label>UTM content<input name="utmContent" maxlength="100"></label><button type="submit">Create tracked link</button></form></section>
<section class="panel" id="classic-ai"><div class="role-panel-head"><div><h2>Classic AI campaign assistant</h2><p>Generates captions/scripts only from seller-approved campaign facts and required disclosure. It cannot invent price, stock, warranty or delivery claims.</p></div><a class="outline-button" href="/ask-classic">Ask Classic</a></div><form method="post" action="/promoter/ai/jobs" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Approved campaign<select name="campaignId" required><option value="">Select campaign</option><% summary.campaigns.forEach(c=>{ const app=c.promoterApplication; if(app?.status==='approved'){ %><option value="<%=c.publicId%>"><%=c.name%></option><% } }) %></select></label><label>Channel<input name="channel" maxlength="50" placeholder="whatsapp"></label><label>Brief<textarea name="brief" rows="3" minlength="3" maxlength="3000" required placeholder="Example: A concise launch caption for university students"></textarea></label><button type="submit">Queue AI content</button></form><div class="table-wrap"><table><thead><tr><th>Job</th><th>Status</th><th>Result</th></tr></thead><tbody><% if(!(aiJobs||[]).length){%><tr><td colspan="3">No AI promoter jobs yet.</td></tr><%}%><% (aiJobs||[]).forEach(j=>{%><tr><td><%=j.publicId%></td><td><%=j.status%></td><td><% if(j.status==='completed'){%><strong>Caption</strong><br><%=j.result?.caption||''%><br><small><%=j.result?.disclosure||''%></small><%}else if(j.status==='failed'){%><%=j.errorMessage||j.errorCode%><%}else{%>Queued for the asynchronous AI worker.<%}%></td></tr><%})%></tbody></table></div><% if(aiPage?.hasMore){ %><p><a class="server-pager" href="/promoter?aiAfter=<%=encodeURIComponent(aiPage.next)%>#classic-ai">Older AI jobs</a></p><% } %></section>
<section class="panel" id="content-kit"><div class="role-panel-head"><div><h2>Smart campaign builder</h2><p>Creates compliant copy only from seller-approved campaign facts and creates the tracked link at the same time. It does not invent price, stock or claims.</p></div></div><form method="post" action="/promoter/content-kit" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Campaign<select name="campaignId" required><option value="">Select approved campaign</option><% summary.campaigns.forEach(c=>{ const app=c.promoterApplication; if(app?.status==='approved'){ %><option value="<%=c.publicId%>"><%=c.name%></option><% } }) %></select></label><label>Destination path<input name="destination" value="/" pattern="/[A-Za-z0-9/_?&=.%+\-]*" required></label><label>Channel<input name="channel" maxlength="50" placeholder="whatsapp"></label><label>Coupon code<input name="couponCode" maxlength="32"></label><label>Sub ID<input name="subId" maxlength="80"></label><label>Content label<input name="utmContent" maxlength="100" placeholder="launch-post"></label><button type="submit">Build approved content kit</button></form><% if(contentKit){ %><article class="catalog-row"><div><strong><%=contentKit.campaignName%></strong><small>Tracked link: <a href="<%=contentKit.trackedUrl%>"><%=contentKit.trackedUrl%></a> · <%=contentKit.disclosure%></small><label>Caption<textarea readonly><%=contentKit.caption%></textarea></label><label>WhatsApp<textarea readonly><%=contentKit.whatsapp%></textarea></label><label>Poster text<textarea readonly><%=contentKit.posterText%></textarea></label><label>Hashtags<input readonly value="<%=contentKit.hashtags%>"></label><small>Posting-time suggestion: <%=contentKit.postingTimeSuggestion%></small><div class="promoter-qr" data-qr="<%=contentKit.trackedUrl%>" aria-label="QR code for tracked link"></div></div></article><% } %></section>
<section class="panel" id="messages"><div class="role-panel-head"><div><h2>Customer messages</h2><p>Direct enquiries sent from your verified public promoter profile.</p></div></div><% if(!(summary.contacts||[]).length){%><p>No promoter-profile conversations yet.</p><%}%><div class="role-workflow-grid"><% (summary.contacts||[]).forEach(thread=>{%><article><div><strong><%=thread.customerUserId?.name||'Customer'%> · <%=thread.subject%></strong><p><strong>Customer:</strong> <%=thread.message%></p><% (thread.replies||[]).forEach(reply=>{%><p><strong><%=reply.sender==='promoter'?'You':'Customer'%>:</strong> <%=reply.body%> <small>· <%=formatDate(reply.at)%></small></p><%})%><small>Status: <%=thread.status%> · Last activity <%=formatDate(thread.lastMessageAt||thread.updatedAt)%></small><% if(thread.status!=='resolved'){%><form method="post" action="/promoter/messages/<%=thread.publicId%>/reply" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><textarea name="message" minlength="2" maxlength="2000" required rows="3" placeholder="Reply to the customer"></textarea><button type="submit">Send reply</button></form><form method="post" action="/promoter/messages/<%=thread.publicId%>/resolve"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit">Mark resolved</button></form><%}%></div></article><%})%></div><% if(summary.queuePages?.contacts?.hasMore){ %><p><a class="server-pager" href="/promoter?contactsAfter=<%=encodeURIComponent(summary.queuePages.contacts.next)%>#messages">Older conversations</a></p><% } %></section>
<section class="panel"><div class="role-panel-head"><div><h2>Campaign funnel</h2><p>Full-history server-recorded clicks, conversions and net commission. Attribution blocked by fraud controls is excluded from commission.</p></div></div><div class="table-wrap"><table><thead><tr><th>Campaign</th><th>Clicks</th><th>Conversions</th><th>Conversion rate</th><th>Net commission</th></tr></thead><tbody><% if(!summary.analytics?.byCampaign?.length){%><tr><td colspan="5">No campaign attribution yet.</td></tr><%}%><% (summary.analytics?.byCampaign||[]).forEach(row=>{ %><tr><td><%=row.name||row.key%><br><small><%=row.key%></small></td><td><%=row.clicks%></td><td><%=row.conversions%></td><td><%=row.clicks?((row.conversions/row.clicks)*100).toFixed(1):'0.0'%>%</td><td class="workspace-money"><%=formatMoney(row.commissionMinor,summary.totals?.currency||summary.commissions[0]?.currency||user.currency)%></td></tr><% }) %></tbody></table></div><div class="table-wrap"><table><thead><tr><th>Channel</th><th>Clicks</th><th>Conversions</th><th>Conversion rate</th></tr></thead><tbody><% if(!summary.analytics?.byChannel?.length){%><tr><td colspan="4">No tracked traffic yet.</td></tr><%}%><% (summary.analytics?.byChannel||[]).forEach(row=>{ %><tr><td><%=row.key%></td><td><%=row.clicks%></td><td><%=row.conversions%></td><td><%=row.clicks?((row.conversions/row.clicks)*100).toFixed(1):'0.0'%>%</td></tr><% }) %></tbody></table></div><div class="table-wrap"><table><thead><tr><th>Product</th><th>Net commission</th></tr></thead><tbody><% if(!summary.analytics?.byProduct?.length){%><tr><td colspan="2">No attributed product orders yet.</td></tr><%}%><% (summary.analytics?.byProduct||[]).forEach(row=>{ %><tr><td><%=row.key%></td><td class="workspace-money"><%=formatMoney(row.commissionMinor,summary.totals?.currency||summary.commissions[0]?.currency||user.currency)%></td></tr><% }) %></tbody></table></div></section><div class="role-content-grid"><section class="panel"><div class="role-panel-head"><div><h2>Your tracked links</h2><p>Each link has a locally generated QR code; scanning still lands on the same server-side attribution route.</p></div></div><div class="table-wrap"><table><thead><tr><th>Link / QR</th><th>Channel</th><th>Coupon</th><th>Created</th></tr></thead><tbody><% if(!summary.links.length){%><tr><td colspan="4">No links yet.</td></tr><%}%><% summary.links.forEach(l=>{ %><tr><td><a href="/r/<%=l.token%>">/r/<%=l.token%></a><div class="promoter-qr" data-qr="/r/<%=l.token%>" aria-label="QR code for tracked link"></div></td><td><%=l.channel||'—'%></td><td><%=l.couponCode||'—'%></td><td><%=formatDate(l.createdAt)%></td></tr><% }) %></tbody></table></div><% if(summary.queuePages?.links?.hasMore){ %><p><a class="server-pager" href="/promoter?linksAfter=<%=encodeURIComponent(summary.queuePages.links.next)%>">Older links</a></p><% } %></section><section class="panel"><div class="role-panel-head"><div><h2>Commission history</h2><p>Gross → reversed → net → paid → outstanding, using the recorded commission entry rather than recalculating current campaign terms.</p></div><a class="outline-button" href="/promoter/commissions.csv">Export CSV</a></div><div class="table-wrap"><table><thead><tr><th>Order</th><th>Stage</th><th>Gross</th><th>Reversed</th><th>Net</th><th>Paid</th><th>Outstanding</th><th>Reconciliation / appeal</th></tr></thead><tbody><% if(!summary.commissions.length){%><tr><td colspan="8">No commissions yet.</td></tr><%}%><% summary.commissions.forEach(c=>{ const gross=Math.max(0,Number(c.amountMinor||0)); const reversed=Math.min(gross,Number(c.reversedAmountMinor||0)); const net=Math.max(0,gross-reversed); const paid=Math.min(net,Number(c.paidAmountMinor||0)); const stage=c.status==='pending'?'Estimated':(c.status==='payable'||c.status==='partially_reversed'?'Payable':(c.status==='paid'?'Paid':'Adjusted')); %><tr><td><%=c.orderPublicId%><br><small><%=c.publicId%></small></td><td><span class="status-chip"><%=stage%></span></td><td class="workspace-money"><%=formatMoney(gross,c.currency)%></td><td class="workspace-money"><%=formatMoney(reversed,c.currency)%></td><td class="workspace-money"><%=formatMoney(net,c.currency)%></td><td class="workspace-money"><%=formatMoney(paid,c.currency)%></td><td class="workspace-money"><%=formatMoney(Math.max(0,net-paid),c.currency)%></td><td><% if(c.reversalReason){%><strong>Adjustment:</strong> <%=c.reversalReason%><br><%}%><% if(['reversed','partially_reversed'].includes(c.status) && c.appeal?.status!=='pending'){%><form method="post" action="/promoter/commissions/<%=c.publicId%>/appeal"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="message" minlength="10" maxlength="1200" required placeholder="Why should this reversal be reviewed?"><button type="submit">Appeal</button></form><%}else if(c.appeal?.status&&c.appeal.status!=='none'){%><small>Appeal: <%=c.appeal.status%><% if(c.appeal.decision){%> · <%=c.appeal.decision%><%}%></small><%}else if(!c.reversalReason){%><small>No reconciliation exception.</small><%}%></td></tr><% }) %></tbody></table></div><% if(summary.queuePages?.commissions?.hasMore){ %><p><a class="server-pager" href="/promoter?commissionsAfter=<%=encodeURIComponent(summary.queuePages.commissions.next)%>">Older commissions</a></p><% } %></section></div>
</main><script src="/assets/vendor/qrcode.min.js" defer></script><script nonce="<%=cspNonce%>">window.addEventListener('DOMContentLoaded',()=>{document.querySelectorAll('.promoter-qr[data-qr]').forEach(el=>{const raw=el.dataset.qr||'';const value=raw.startsWith('http')?raw:new URL(raw,location.origin).href;if(window.QRCode)new QRCode(el,{text:value,width:112,height:112,colorDark:'#111111',colorLight:'#ffffff',correctLevel:QRCode.CorrectLevel.M});});});</script><script src="/operations-ui.js" defer></script></body></html>
