<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Messages · Classic Mart</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/account.css"></head><body class="account-body"><%-include('partials/account-top')%><%-include('partials/account-nav',{accountSection:'messages'})%><main class="account-wrap account-main"><%if(flash){%><div class="account-flash <%=flash.type==='error'?'error':''%>"><strong><%=flash.message%></strong></div><%}%><div class="account-heading"><h1>Marketplace messages</h1><p>Your direct conversations with sellers and promoters.</p></div><section class="account-card"><div class="account-list"><%if(!sellerContacts.length&&!(promoterContacts||[]).length){%><div class="account-empty">No marketplace conversations yet.</div><%}%><%sellerContacts.forEach(thread=>{%><article class="account-item"><div><strong><a href="/sellers/<%=thread.storeId?.slug||''%>"><%=thread.storeId?.name||'Seller'%></a> · <%=thread.subject%></strong><p><strong>You:</strong> <%=thread.message%></p><%(thread.replies||[]).forEach(reply=>{%><p><strong><%=reply.sender==='seller'?'Seller':'You'%>:</strong> <%=reply.body%> <small>· <%=formatDate(reply.at)%></small></p><%})%><small>Status: <%=thread.status%> · Last activity <%=formatDate(thread.lastMessageAt||thread.updatedAt)%></small><%if(thread.status!=='resolved'){%><form class="account-form" method="post" action="/account/messages/<%=thread.publicId%>/reply"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><textarea name="message" minlength="2" maxlength="2000" required rows="3" placeholder="Reply to the seller"></textarea><button class="account-button primary" type="submit">Send reply</button></form><%}%></div></article><%})%><%(promoterContacts||[]).forEach(thread=>{const promoterName=thread.promoterUserId?.roleProfile?.publicName||thread.promoterUserId?.name||'Promoter';%><article class="account-item"><div><strong><%=promoterName%> · <%=thread.subject%></strong><p><strong>You:</strong> <%=thread.message%></p><%(thread.replies||[]).forEach(reply=>{%><p><strong><%=reply.sender==='promoter'?'Promoter':'You'%>:</strong> <%=reply.body%> <small>· <%=formatDate(reply.at)%></small></p><%})%><small>Status: <%=thread.status%> · Last activity <%=formatDate(thread.lastMessageAt||thread.updatedAt)%></small><%if(thread.status!=='resolved'){%><form class="account-form" method="post" action="/account/promoter-messages/<%=thread.publicId%>/reply"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><textarea name="message" minlength="2" maxlength="2000" required rows="3" placeholder="Reply to the promoter"></textarea><button class="account-button primary" type="submit">Send reply</button></form><%}%></div></article><%})%></div><%if(queuePages?.sellerContacts?.hasMore){%><p><a class="account-link" href="/account/messages?sellerContactsAfter=<%=encodeURIComponent(queuePages.sellerContacts.next)%>">Older seller conversations</a></p><%}%><%if(queuePages?.promoterContacts?.hasMore){%><p><a class="account-link" href="/account/messages?promoterContactsAfter=<%=encodeURIComponent(queuePages.promoterContacts.next)%>">Older promoter conversations</a></p><%}%></section></main></body></html>
