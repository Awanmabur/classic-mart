<!doctype html>
<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="csrf-token" content="<%=csrfToken%>"><title><%=ticket.publicId%> Support — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"></head>
<body data-operations-ui="true"><main class="catalog-workspace" id="support-ticket-presence" data-ticket-id="<%=ticket.publicId%>"><header class="catalog-topbar"><div><a class="brand" href="/dashboard"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"></a><p>Support ticket workspace</p></div><div class="catalog-actions"><a class="outline-button" href="/operations/support">Support queue</a><a class="outline-button" href="/operations/support/ai">Support AI</a><a class="outline-button" href="/dashboard">Dashboard</a></div></header>
<section class="catalog-page-head panel"><div><span class="eyebrow"><%=ticket.queue||'general'%> · <%=ticket.country%></span><h1><%=ticket.publicId%> · <%=ticket.subject%></h1><p><%=ticket.priority%> priority · <%=ticket.status.replaceAll('_',' ')%> · SLA <%=formatDate(ticket.slaDueAt)%></p></div></section>
<% if(presence?.length){%><section class="collision" role="status"><strong>Another operator is viewing this ticket:</strong> <%=presence.map(p=>p.userId?.name||'Support operator').join(', ')%>. Coordinate before sending or changing state.</section><%}%>
<div class="support-grid"><div class="support-stack">
<section class="panel"><div class="role-panel-head"><div><h2>Conversation</h2><p>Customer replies and internal notes stay clearly separated.</p></div></div><div class="support-stack"><% (ticket.notes||[]).forEach(n=>{%><article class="support-note <%=n.internal?'internal':''%>"><strong><%=n.internal?'Internal note':'Customer timeline'%></strong><p><%=n.message%></p><small><%=n.actorUserId?.name||'Customer / system'%> · <%=formatDate(n.at)%></small></article><%})%></div><% if(ticket.evidenceDocumentIds?.length){%><p><strong>Evidence:</strong> <% ticket.evidenceDocumentIds.forEach((e,idx)=>{%><%=idx?' · ':''%><a href="/evidence/<%=e.publicId%>"><%=e.description||e.publicId%></a><%})%></p><%}%></section>
<section class="panel"><h2>Order &amp; money context</h2><% if(!order){%><p>No order is linked to this ticket.</p><%}else{%><div class="context-grid"><article class="context-card"><small>Order</small><strong><%=order.publicId%></strong><span>Payment <%=order.paymentState%> · fulfilment <%=order.fulfillmentState%></span><span>Cancel <%=order.cancellationState%> · return <%=order.returnState%> · refund <%=order.refundState%></span></article><article class="context-card"><small>Customer</small><strong><%=order.contact?.fullName||requester.name||'Customer'%></strong><span><%=order.contact?.email||requester.email||''%></span><span><%=order.contact?.phone||''%></span></article></div><h3>Payments</h3><div class="context-grid"><% payments.forEach(p=>{%><article class="context-card"><strong><%=p.publicId%></strong><small><%=p.provider%> · <%=p.status%></small><span><%=formatMoney(p.amountMinor,p.currency)%></span></article><%})%><% if(!payments.length){%><p>No payment attempts.</p><%}%></div><h3>Refunds</h3><div class="context-grid"><% refunds.forEach(r=>{%><article class="context-card"><strong><%=r.publicId%></strong><small><%=r.status%> · <%=r.reason%></small><span><%=formatMoney(r.amountMinor,r.currency)%></span></article><%})%><% if(!refunds.length){%><p>No refunds.</p><%}%></div><h3>Shipments / seller fulfilment</h3><div class="context-grid"><% shipments.forEach(s=>{%><article class="context-card"><strong><%=s.publicId%></strong><small><%=s.kind%> · <%=s.status%></small><span><%=s.mode%><% if(s.deliveredAt){%> · delivered <%=formatDate(s.deliveredAt)%><%}%></span></article><%})%><% sellerOrders.forEach(so=>{%><article class="context-card"><strong><%=so.publicId%> · <%=so.storePublicId%></strong><small><%=so.status%> · <%=so.fulfillmentStatus||''%></small></article><%})%></div><%}%></section>
<section class="panel"><h2>Assignment &amp; workflow history</h2><div class="timeline"><% (ticket.assignmentHistory||[]).forEach(h=>{%><article><strong><%=h.action%></strong><small><%=h.actorUserId?.name||'operator'%><% if(h.assignedUserId){%> → <%=h.assignedUserId?.name||'operator'%><%}%> · <%=formatDate(h.at)%></small></article><%})%><% (ticket.workflowHistory||[]).forEach(h=>{%><article><strong><%=h.action%></strong><small><%=h.fromStatus?`${h.fromStatus} → `:''%><%=h.toStatus||''%><% if(h.targetTicketPublicId){%> · <%=h.targetTicketPublicId%><%}%> · <%=formatDate(h.at)%></small><% if(h.note){%><p><%=h.note%></p><%}%></article><%})%></div></section>
</div><aside class="support-stack">
<section class="panel"><h2>Ticket controls</h2><p>Assigned: <strong><%=ticket.assignedUserId?.name||'Unassigned'%></strong></p><% const assignedId=String(ticket.assignedUserId?._id||ticket.assignedUserId||'');const actorId=String(user?._id||'');const supervisor=['country_admin','super_admin'].includes(user?.role);const owns=assignedId===actorId; %><% if(!ticket.assignedUserId&&!['resolved','closed'].includes(ticket.status)){%><form method="post" action="/operations/support/tickets/<%=ticket.publicId%>/claim"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Claim ticket</button></form><%}%><% if(ticket.assignedUserId&&!['resolved','closed'].includes(ticket.status)&&(owns||supervisor)){%><form class="catalog-form" method="post" action="/operations/support/tickets/<%=ticket.publicId%>/status"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Status<select name="status"><option value="in_progress">In progress</option><option value="waiting_customer">Waiting customer</option><option value="escalated">Escalated</option><option value="resolved">Resolved</option><option value="closed">Closed</option></select></label><label>Update<textarea name="message" minlength="3" maxlength="2000" required></textarea></label><label><input type="checkbox" name="internal" value="true"> Internal note only</label><button type="submit">Save update</button></form><form method="post" action="/operations/support/tickets/<%=ticket.publicId%>/release"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="outline-button" type="submit">Release assignment</button></form><%}%><% if(['resolved','closed'].includes(ticket.status)){%><form method="post" action="/operations/support/tickets/<%=ticket.publicId%>/reopen"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Reopen &amp; claim</button></form><%}%></section>
<% if(ticket.assignedUserId&&!['resolved','closed'].includes(ticket.status)&&(owns||supervisor)){%><section class="panel"><h2>Transfer</h2><form class="catalog-form" method="get" action="/operations/support/tickets/<%=ticket.publicId%>"><label>Find authorized operator<input name="transferQ" value="<%=transferSearch||''%>" maxlength="120" placeholder="Name, email or staff ID"></label><button class="outline-button" type="submit">Search operators</button></form><%if(transferHasMore){%><p class="muted">More than 50 operators match. Refine the search to find the exact person.</p><%}%><form class="catalog-form" method="post" action="/operations/support/tickets/<%=ticket.publicId%>/transfer"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="userPublicId" required><option value="">Authorized support operator</option><% transferCandidates.forEach(c=>{%><option value="<%=c.publicId%>"><%=c.name%> · <%=c.email||c.publicId%> · <%=c.role%></option><%})%></select><button type="submit">Transfer ticket</button></form></section><section class="panel"><h2>Saved reply</h2><form class="catalog-form" method="post" action="/operations/support/tickets/<%=ticket.publicId%>/macro"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="macroPublicId" required><option value="">Choose macro</option><% macros.forEach(m=>{%><option value="<%=m.publicId%>"><%=m.title%></option><%})%></select><select name="status"><option value="in_progress">In progress</option><option value="waiting_customer">Waiting customer</option><option value="escalated">Escalated</option><option value="resolved">Resolved</option></select><label><input type="checkbox" name="internal" value="true"> Internal only</label><button type="submit">Apply saved reply</button></form></section><%}%>
<% if(supervisor&&!['resolved','closed'].includes(ticket.status)){%><section class="panel"><h2>Merge duplicate</h2><p class="muted">The source closes but remains auditable; no history/evidence is deleted.</p><form class="catalog-form" method="post" action="/operations/support/tickets/<%=ticket.publicId%>/merge"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input name="targetPublicId" minlength="4" maxlength="120" required placeholder="Target ticket ID"><button class="outline-button" type="submit">Merge into target</button></form></section><%}%>
</aside></div></main><script src="/support-ticket-presence.js" defer></script><script src="/operations-ui.js" defer></script></body></html>
