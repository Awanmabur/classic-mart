<!doctype html><html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Seller Campaigns — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"><style>.campaign-product-picker{grid-column:1/-1;border:1px solid #d8dee8;border-radius:16px;padding:14px}.campaign-product-picker legend{font-weight:800;padding:0 6px}.campaign-product-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:8px}.campaign-product-options label{display:flex;align-items:flex-start;gap:9px;border:1px solid #e4e8ee;border-radius:14px;padding:10px;background:#fff}.campaign-product-options input{width:auto;margin-top:3px}.campaign-product-options span,.campaign-product-options strong,.campaign-product-options small{display:block}.campaign-product-options small{margin-top:3px;color:#667085;overflow-wrap:anywhere}@media(max-width:680px){.campaign-product-options{grid-template-columns:1fr}}</style></head><body><main class="catalog-workspace">
<header class="catalog-topbar"><div><a class="brand" href="/dashboard"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p>Seller campaigns</p></div><div class="catalog-actions"><a class="outline-button" href="/seller/products">Products</a><a class="outline-button" href="/dashboard">Dashboard</a></div></header>
<section class="catalog-page-head panel"><div><span class="eyebrow">Growth</span><h1>Promoter campaigns</h1><p>Create a draft from approved product facts, submit it for country review, then approve promoters for invite-only campaigns.</p></div></section>
<section class="panel"><div class="role-panel-head"><div><h2>Create campaign draft</h2><p>A seller cannot self-activate a campaign. Country review is required.</p></div></div><form method="post" action="/seller/campaigns" class="catalog-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Name<input name="name" minlength="3" maxlength="140" required></label><label>Visibility<select name="visibility"><option value="public">Public</option><option value="invite_only">Invite only</option></select></label><label>Commission (basis points)<input type="number" name="commissionBps" min="0" max="5000" value="500" required></label><label>Attribution window (days)<input type="number" name="attributionDays" min="1" max="90" value="7" required></label><label>Allowed channels, comma separated<input name="allowedChannels" placeholder="instagram, whatsapp, tiktok"></label><label>Approved factual claims, one per line<textarea name="facts" minlength="2" required></textarea></label><fieldset class="campaign-product-picker"><legend>Published products</legend><p class="workspace-help">Choose only products currently published by this store.</p><div class="campaign-product-options"><% if(!products.length){ %><p>No published products are available. Publish a product first.</p><% } %><% products.forEach(product=>{ %><label><input type="checkbox" name="productPublicIds" value="<%=product.publicId%>"> <span><strong><%=product.title%></strong><small><%=product.publicId%></small></span></label><% }) %></div></fieldset><label>Disclosure text<textarea name="disclosureText" minlength="10" maxlength="300" required>Sponsored/affiliate promotion for Classic Mart.</textarea></label><label>Starts<input type="datetime-local" name="startsAt"></label><label>Ends<input type="datetime-local" name="endsAt"></label><button type="submit">Save draft</button></form></section>
<section class="panel"><div class="role-panel-head"><div><h2>Your campaigns</h2></div></div><div class="table-wrap"><table><thead><tr><th>Campaign</th><th>Status</th><th>Commission</th><th>Products</th><th>Action</th></tr></thead><tbody><% if(!campaigns.length){%><tr><td colspan="5">No campaigns yet.</td></tr><%}%><% campaigns.forEach(c=>{%><tr><td><strong><%=c.name%></strong><br><small><%=c.publicId%> · <%=c.visibility%></small></td><td><%=c.status%><% if(c.reviewReason){%><br><small><%=c.reviewReason%></small><%}%></td><td><%=(c.commissionBps/100).toFixed(2)%>%</td><td><%=c.productPublicIds.join(', ')%></td><td><% if(['draft','rejected'].includes(c.status)){%><form method="post" action="/seller/campaigns/<%=c.publicId%>/submit"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Submit for review</button></form><%}else{%>—<%}%></td></tr><%})%></tbody></table></div><% if(queuePages?.campaigns){%><div class="server-pager"><small>Showing <%=queuePages.campaigns.count%> of <%=queuePages.campaigns.total%> campaigns</small><% if(queuePages.campaigns.hasMore){%><a class="outline-button" href="/seller/campaigns?campaignsAfter=<%=encodeURIComponent(queuePages.campaigns.next)%>">Older campaigns</a><%}%></div><%}%></section>
<section class="panel"><div class="role-panel-head"><div><h2>Promoter applications</h2><p>Public campaigns auto-approve verified promoters; invite-only applications require the seller decision below.</p></div></div><div class="table-wrap"><table><thead><tr><th>Application</th><th>Campaign</th><th>Status</th><th>Note</th><th>Action</th></tr></thead><tbody><% if(!applications.length){%><tr><td colspan="5">No applications.</td></tr><%}%><% applications.forEach(a=>{%><tr><td><%=a.publicId%></td><td><%=a.campaignPublicId%></td><td><%=a.status%></td><td><%=a.note||'—'%></td><td><% if(a.status==='pending'){%><form method="post" action="/seller/campaign-applications/<%=a.publicId%>/review"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="decision"><option value="approve">Approve</option><option value="reject">Reject</option></select><input name="reason" maxlength="500" placeholder="Optional reason"><button type="submit">Apply</button></form><%}else{%>—<%}%></td></tr><%})%></tbody></table></div><% if(queuePages?.applications){%><div class="server-pager"><small>Showing <%=queuePages.applications.count%> of <%=queuePages.applications.total%> applications</small><% if(queuePages.applications.hasMore){%><a class="outline-button" href="/seller/campaigns?applicationsAfter=<%=encodeURIComponent(queuePages.applications.next)%>">Older applications</a><%}%></div><%}%></section>
</main></body></html>
