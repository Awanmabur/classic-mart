<!doctype html><html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Classic AI Workspace — Classic Mart</title><link rel="stylesheet" href="/dashboard.css"><link rel="stylesheet" href="/dashboard-workspaces.css"><link rel="stylesheet" href="/catalog-workspace.css"><link rel="stylesheet" href="/server-ui.css"><style>.aiw-nav{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.aiw-nav a{border:1px solid #d8dee8;border-radius:999px;padding:8px 12px;text-decoration:none;color:inherit;background:#fff}.aiw-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.aiw-card{border:1px solid #e0e5ec;border-radius:16px;background:#fff;padding:14px}.aiw-form{display:grid;gap:12px}.aiw-form input,.aiw-form textarea,.aiw-form select{width:100%;box-sizing:border-box;border:1px solid #d8dee8;border-radius:12px;padding:10px 12px;background:#fff}.aiw-form button,.aiw-btn{border:0;border-radius:999px;padding:9px 14px;background:#1165df;color:#fff;font-weight:700;text-decoration:none}.aiw-outline{background:#fff;color:#1d2939;border:1px solid #d0d5dd}.aiw-result{white-space:pre-wrap;max-width:520px}.aiw-meta{color:#667085;font-size:12px}.aiw-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.aiw-actions{display:flex;gap:7px;flex-wrap:wrap}.aiw-actions form{margin:0}.aiw-warning{background:#fffaeb;border:1px solid #fedf89;border-radius:12px;padding:9px}.aiw-good{background:#ecfdf3;border:1px solid #abefc6;border-radius:12px;padding:9px}@media(max-width:900px){.aiw-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.aiw-two{grid-template-columns:1fr}}@media(max-width:560px){.aiw-grid{grid-template-columns:1fr}}</style></head><body><main class="catalog-workspace"><header class="catalog-topbar"><div><a class="brand" href="/"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a><p>Classic AI production workspace</p></div><div class="catalog-actions"><a class="outline-button" href="/dashboard">Dashboard</a><a class="outline-button" href="/ask-classic">Ask Classic</a></div></header><section class="catalog-page-head panel"><div><span class="eyebrow">Classic AI</span><h1><%= section==='seller'?'Seller AI':section==='support'?'Support AI':'AI governance & observability' %></h1><p><%= section==='seller'?'Generated catalogue facts stay pending until a seller explicitly confirms them.':section==='support'?'AI may summarize and draft replies; a human support agent must approve before anything is sent.':'Provider/model registry, evaluations, jobs, quotas, cost and quality signals. AI has no protected financial or enforcement tool.' %></p></div></section><% if(flash){%><div class="server-flash <%=flash.type%>"><strong><%=flash.message%></strong></div><%}%>
<% if(section==='seller'){ %><div class="aiw-two"><section class="panel"><h2>Queue seller AI work</h2><form method="post" action="/seller/ai/jobs" class="aiw-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Job type<select name="type" required><option value="product_draft">Product draft from notes</option><option value="category_attributes">Category & attributes</option><option value="translation">Translation</option><option value="image_quality">Image quality</option><option value="seller_assistant">Seller assistant</option></select></label><label>Product<select name="productId"><option value="">No existing product / new draft</option><% products.forEach(p=>{ %><option value="<%=p.publicId%>"><%=p.title%> · <%=p.status%></option><% }) %></select></label><label>Notes / question<textarea name="notes" rows="6" maxlength="6000" placeholder="Describe the product accurately, or ask for guidance. Do not include customer personal data."></textarea></label><label>Translation target<input name="targetLanguage" maxlength="80" placeholder="Luganda, Dinka, Swahili..."></label><button type="submit">Queue AI job</button></form></section><section class="panel"><h2>Guardrails</h2><div class="aiw-good">AI suggestions cannot publish a product, change price/stock, or bypass catalogue moderation.</div><p>Only draft or changes-requested products can receive approved generated fields. Category and attribute suggestions are validated against Classic Mart’s live category schema.</p></section></div><section class="panel"><h2>Recent seller AI jobs</h2><div class="table-wrap"><table><thead><tr><th>Job</th><th>Type</th><th>Status</th><th>Result</th><th>Human decision</th></tr></thead><tbody><% if(!jobs.length){%><tr><td colspan="5">No seller AI jobs yet.</td></tr><%}%><% jobs.forEach(j=>{ %><tr><td><%=j.publicId%><br><small><%=formatDate(j.createdAt)%></small></td><td><%=j.type.replaceAll('_',' ')%></td><td><span class="status-chip"><%=j.status%></span><br><small><%=j.provider||'—'%> <%=j.model||''%></small></td><td class="aiw-result"><%=JSON.stringify(j.result||{},null,2)%><% if(j.errorMessage){%><div class="aiw-warning"><%=j.errorMessage%></div><%}%></td><td><% if(j.status==='pending_approval'){%><div class="aiw-actions"><form method="post" action="/seller/ai/jobs/<%=j.publicId%>/approve"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Approve</button></form><form method="post" action="/seller/ai/jobs/<%=j.publicId%>/reject"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="aiw-btn aiw-outline" type="submit">Reject</button></form></div><%}else{%><%=j.approval?.status||'—'%><%}%></td></tr><%})%></tbody></table></div></section><% } %>
<% if(section==='support'){ %><div class="aiw-two"><section class="panel"><h2>Draft support reply</h2><form method="post" action="/operations/support/ai/jobs" class="aiw-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Ticket<select name="ticketId" required><option value="">Choose open ticket</option><% tickets.forEach(t=>{ %><option value="<%=t.publicId%>"><%=t.publicId%> · <%=t.subject%> · <%=t.priority%></option><% }) %></select></label><label>Instruction<textarea name="question" rows="5" maxlength="2000">Suggest a concise, factual customer reply and note any escalation need.</textarea></label><button type="submit">Queue suggestion</button></form></section><section class="panel"><h2>Human approval boundary</h2><div class="aiw-good">AI cannot refund, pay, change an order, suspend an account, or send a support message by itself.</div><p>Only the support agent who requested a draft can approve it. Approval sends the suggested reply through the normal support email/ticket path and records the human decision.</p></section></div><section class="panel"><h2>Your AI support suggestions</h2><div class="table-wrap"><table><thead><tr><th>Job</th><th>Status</th><th>Summary / reply</th><th>Decision</th></tr></thead><tbody><% if(!jobs.length){%><tr><td colspan="4">No support AI jobs yet.</td></tr><%}%><% jobs.forEach(j=>{ %><tr><td><%=j.publicId%><br><small><%=formatDate(j.createdAt)%></small></td><td><span class="status-chip"><%=j.status%></span></td><td class="aiw-result"><% if(j.result?.summary){%><strong><%=j.result.summary%></strong><br><%}%><%=j.result?.suggestedReply||j.errorMessage||'Processing…'%></td><td><% if(j.status==='pending_approval'){%><div class="aiw-actions"><form method="post" action="/operations/support/ai/jobs/<%=j.publicId%>/approve"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit">Approve &amp; send</button></form><form method="post" action="/operations/support/ai/jobs/<%=j.publicId%>/reject"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="aiw-btn aiw-outline" type="submit">Reject</button></form></div><%}else{%><%=j.approval?.status||'—'%><%}%></td></tr><%})%></tbody></table></div></section><% } %>
<% if(section==='admin'){ %><div class="aiw-grid"><article class="aiw-card"><span class="eyebrow">Provider</span><strong><%=user.role==='country_admin'?'Managed':(observability.providerConfigured?'Configured':'Not configured')%></strong><p class="aiw-meta"><%=user.role==='country_admin'?'Provider/model details are Super Admin only.':(observability.provider+' · '+(observability.chatModel||'no chat model'))%></p></article><article class="aiw-card"><span class="eyebrow">Embedding</span><strong><%=observability.embeddingModel%></strong><p class="aiw-meta">MongoDB embedding store + bounded cosine ranking</p></article><article class="aiw-card"><span class="eyebrow">Daily cost budget</span><strong><%=observability.dailyBudgetMicros%> µUSD</strong><p class="aiw-meta">Requests fail closed after budget/quota.</p></article><article class="aiw-card"><span class="eyebrow">Evaluation</span><strong><%=evaluations[0]?.status||'Not run'%></strong><p class="aiw-meta"><%=evaluations[0]?.publicId||''%></p></article></div><div class="aiw-two" style="margin-top:16px"><section class="panel"><div class="role-panel-head"><div><h2>Evaluation suite</h2><p>Runs prompt-injection and hard-filter checks. Provider-backed evaluation cases can be expanded without changing business permissions.</p></div></div><form method="post" action="/admin/ai/evaluations/run"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button class="aiw-btn" type="submit">Run AI evaluation</button></form><div class="table-wrap"><table><thead><tr><th>Run</th><th>Status</th><th>Metrics</th></tr></thead><tbody><% evaluations.forEach(e=>{ %><tr><td><%=e.publicId%></td><td><%=e.status%></td><td class="aiw-result"><%=JSON.stringify(e.metrics||{})%></td></tr><%})%></tbody></table></div></section><section class="panel"><h2>Advisory jobs</h2><form method="post" action="/admin/ai/jobs/forecast" class="aiw-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Country<input name="country" maxlength="2" value="<%=user.role==='country_admin'?user.country:'UG'%>" <%=user.role==='country_admin'?'readonly':''%>></label><button type="submit">Queue demand forecast</button></form><p class="aiw-meta">Forecasting requires sufficient paid/completed order history and returns uncertainty/assumptions. It never changes stock automatically.</p></section></div><section class="panel"><h2>24-hour AI telemetry</h2><div class="table-wrap"><table><thead><tr><th>Feature</th><th>Outcome</th><th>Requests</th><th>Avg latency</th><th>Estimated cost</th></tr></thead><tbody><% if(!observability.usage24h.length){%><tr><td colspan="5">No AI usage yet.</td></tr><%}%><% observability.usage24h.forEach(r=>{ %><tr><td><%=r._id.feature%></td><td><%=r._id.outcome%></td><td><%=r.count%></td><td><%=Math.round(r.latency||0)%> ms</td><td><%=r.cost||0%> µUSD</td></tr><%})%></tbody></table></div></section><section class="panel"><h2>Model registry</h2><p class="aiw-meta">Secrets are never stored here. API keys/endpoints stay in environment configuration.</p><div class="table-wrap"><table><thead><tr><th>Purpose</th><th>Provider/model</th><th>Enabled</th><th>Limits & cost metadata</th></tr></thead><tbody><% models.forEach(m=>{ %><tr><td><%=m.purpose%></td><td><%=m.provider%><br><strong><%=m.model%></strong></td><td><%=m.enabled?'Yes':'No'%></td><td><% if(user.role==='super_admin'){%><form method="post" action="/admin/ai/models/<%=m.publicId%>" class="aiw-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label><input type="checkbox" name="enabled" value="true" <%=m.enabled?'checked':''%>> Enabled</label><input name="priority" type="number" value="<%=m.priority%>" min="0"><input name="maxInputChars" type="number" value="<%=m.maxInputChars%>" min="1000"><input name="inputCostMicrosPerMillion" type="number" value="<%=m.inputCostMicrosPerMillion||0%>" min="0"><input name="outputCostMicrosPerMillion" type="number" value="<%=m.outputCostMicrosPerMillion||0%>" min="0"><input name="embeddingCostMicrosPerMillion" type="number" value="<%=m.embeddingCostMicrosPerMillion||0%>" min="0"><input name="reason" minlength="3" maxlength="1000" required placeholder="Reason for this high-risk AI model change"><button type="submit">Send for approval</button></form><%}else{%>Read only<%}%></td></tr><%})%></tbody></table></div></section><section class="panel"><h2>Prompt versions</h2><div class="table-wrap"><table><thead><tr><th>Key</th><th>Version</th><th>Country</th><th>Status</th><th>Schema</th></tr></thead><tbody><% prompts.forEach(p=>{ %><tr><td><%=p.key%></td><td><%=p.version%></td><td><%=p.country||'Global'%></td><td><%=p.status%></td><td><%=p.schemaKey%></td></tr><%})%></tbody></table></div></section><section class="panel"><h2>Recent AI jobs</h2><div class="table-wrap"><table><thead><tr><th>Job</th><th>Type</th><th>Country</th><th>Status</th><th>Provider/model</th><th>Result/error</th></tr></thead><tbody><% jobs.forEach(j=>{ %><tr><td><%=j.publicId%></td><td><%=j.type%></td><td><%=j.country%></td><td><%=j.status%></td><td><%=j.provider||'—'%> <%=j.model||''%></td><td class="aiw-result"><%=j.errorMessage||JSON.stringify(j.result||{})%></td></tr><%})%></tbody></table></div></section><% } %></main></body></html>
