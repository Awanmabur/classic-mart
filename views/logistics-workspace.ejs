<!doctype html>
<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= mode==='delivery'?'Delivery Partner':'Logistics Operations' %> — Classic Mart</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/storefront-pages.css">
  <style>
    main{max-width:1220px;margin:auto;padding:28px 18px}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.card{border:1px solid #e7e7e7;border-radius:22px;padding:18px;background:#fff;overflow:auto}.wide{grid-column:1/-1}.half{grid-column:span 2}table{width:100%;border-collapse:collapse;min-width:760px}th,td{text-align:left;padding:11px;border-bottom:1px solid #eee;vertical-align:top}.pill{display:inline-flex;border-radius:999px;padding:5px 9px;background:#f3f4f6}form.inline{display:flex;gap:8px;flex-wrap:wrap;align-items:center}input,select,textarea,button{border-radius:14px}input,select,textarea{border:1px solid #d8d8d8;padding:10px 12px;max-width:100%}button{border:0;padding:10px 14px;cursor:pointer}.primary{background:#111;color:#fff}.muted{color:#666}.stack{display:grid;gap:10px}.task-meta{display:grid;gap:4px;font-size:.92rem}.offline-note{display:none;border:1px solid #e5e7eb;border-radius:16px;padding:10px 12px;margin:12px 0;background:#fafafa}.offline-note[data-visible="true"]{display:block}@media(max-width:820px){.grid{grid-template-columns:1fr 1fr}.half{grid-column:1/-1}}@media(max-width:520px){.grid{grid-template-columns:1fr}.card,.half,.wide{grid-column:1/-1}table{min-width:680px}}
  </style>
</head>
<body>
<main>
  <h1><%= mode==='delivery'?'Delivery Partner':'Logistics Operations' %></h1>
  <p class="muted"><%= mode==='delivery'?'Verified assignments, custody proof, failed delivery, safe offline replay and COD collection.':'Delivery verification, shipping zones, parcel custody, executable warehouse tasks, cycle counts and COD reconciliation.' %></p>

<% if(mode==='delivery'){ %>
  <div class="offline-note" id="offline-status" role="status" aria-live="polite"></div>
  <section class="grid">
    <article class="card half">
      <h2>Your delivery profile</h2>
      <p>Status: <span class="pill"><%= profile.verificationStatus %></span> · Availability: <strong><%= profile.available?'On':'Off' %></strong></p><p><a href="/money">Open delivery earnings &amp; payouts</a></p>
      <form class="stack" action="/delivery/profile" method="post">
        <input name="_csrf" type="hidden" value="<%= csrfToken %>">
        <select name="transport" required><% ['bicycle','motorcycle','car','van','truck','other'].forEach(t=>{ %><option value="<%= t %>" <%= profile.transport===t?'selected':'' %>><%= t %></option><% }) %></select>
        <input name="vehicleLabel" maxlength="120" placeholder="Vehicle / plate" value="<%= profile.vehicleLabel||'' %>">
        <input name="serviceAreas" placeholder="Kampala, Wakiso" value="<%= (profile.serviceAreas||[]).join(', ') %>">
        <div class="inline"><button name="action" value="save">Save profile</button><button class="primary" name="action" value="submit">Submit verification</button></div>
      </form>
      <h3>Private verification evidence</h3>
      <p class="muted">Identity is required. Motorized delivery also requires a vehicle or permit image. Images are sanitized and remain private.</p>
      <form class="stack" action="/delivery/profile/evidence" method="post" enctype="multipart/form-data">
        <input name="_csrf" type="hidden" value="<%= csrfToken %>">
        <select name="documentType" required><option value="identity">Identity</option><option value="vehicle">Vehicle registration</option><option value="permit">Driving permit</option></select>
        <input name="file" type="file" accept="image/png,image/jpeg,image/webp" required>
        <input name="description" maxlength="300" placeholder="Optional document note">
        <button>Upload securely</button>
      </form>
      <div class="stack"><% (profileEvidence||[]).forEach(doc=>{ %><p><span class="pill"><%= doc.documentType %></span> <a href="/evidence/<%= doc.publicId %>" target="_blank" rel="noopener">View uploaded image</a></p><% }) %><% if(!(profileEvidence||[]).length){ %><p class="muted">No verification images uploaded yet.</p><% } %></div>
      <% if(profile.verificationStatus==='approved'){ %>
        <form class="inline" action="/delivery/availability" method="post">
          <input name="_csrf" type="hidden" value="<%= csrfToken %>">
          <input name="available" type="hidden" value="<%= profile.available?'false':'true' %>">
          <button><%= profile.available?'Go offline':'Go available' %></button>
        </form>
      <% } %>
    </article>

    <article class="card wide">
      <h2>Job offers</h2>
      <table><thead><tr><th>Shipment</th><th>Earning</th><th>Expires</th><th>Action</th></tr></thead><tbody>
        <% (offers||[]).forEach(o=>{ %><tr><td><%= o.shipmentPublicId %></td><td class="workspace-money"><%= formatMoney(o.earningMinor,o.currency) %></td><td><%= new Date(o.expiresAt).toLocaleString() %></td><td><form action="/delivery/offers/<%= o.publicId %>/accept" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><button class="primary">Accept offer</button></form></td></tr><% }) %>
        <% if(!(offers||[]).length){ %><tr><td colspan="4">No active delivery offers.</td></tr><% } %>
      </tbody></table>
    </article>

    <article class="card wide">
      <h2>Assignments</h2>
      <p class="muted">When connectivity drops, eligible assignment actions are queued on this device and replayed when the connection returns. The server still validates assignment ownership, OTP proof and allowed state transitions.</p>
      <table><thead><tr><th>Shipment</th><th>Order</th><th>Destination</th><th>Status</th><th>COD</th><th>Actions</th></tr></thead><tbody>
      <% jobs.forEach(j=>{ %><tr>
        <td><%= j.publicId %></td><td><%= j.orderPublicId %></td><td><% if(j.destination?.address){ %><strong><%= j.destination.fullName %></strong><br><%= j.destination.address %>, <%= j.destination.city %><br><small>Contact <%= j.destination.maskedPhone %></small><% if(j.destination.note){ %><br><small>Delivery note: <%= j.destination.note %></small><% } %><% if(j.destination.navigationUrl){ %><br><a href="<%= j.destination.navigationUrl %>" target="_blank" rel="noopener noreferrer">Open navigation</a><% } %><% } else { %>—<% } %></td><td><span class="pill"><%= j.status.replaceAll('_',' ') %></span></td><td><%= j.cod?.required ? formatMoney(j.cod.amountMinor,j.cod.currency) : 'No' %></td>
        <td><% if(j.deliveryUserId && String(j.deliveryUserId)===String(user._id)){ %>
          <% if(['assigned','picked_up','in_transit','rescheduled'].includes(j.status)){ const next=j.status==='assigned'?'picked_up':j.status==='picked_up'?'in_transit':'delivered'; %>
            <form class="inline" method="post" action="/delivery/jobs/<%= j.publicId %>/<%= next %>" data-offline-action data-shipment-id="<%= j.publicId %>" data-action="<%= next %>">
              <input name="_csrf" type="hidden" value="<%= csrfToken %>">
              <% if(['assigned','in_transit','rescheduled'].includes(j.status)){ %><input name="proofCode" inputmode="numeric" autocomplete="one-time-code" placeholder="OTP" required><% } %>
              <button><%= j.status==='assigned'?'Confirm pickup':j.status==='picked_up'?'Start transit':'Confirm delivery' %></button>
            </form>
          <% } %>
          <% if(['assigned','picked_up','in_transit','rescheduled'].includes(j.status)){ %>
            <details><summary>Failed attempt</summary><form class="stack" action="/delivery/jobs/<%= j.publicId %>/failed" method="post" data-offline-action data-shipment-id="<%= j.publicId %>" data-action="failed"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><input name="reason" required maxlength="300" placeholder="Failure reason"><button>Record failed attempt</button></form></details>
          <% } %>
          <% if(['failed','in_transit','rescheduled'].includes(j.status)){ %>
            <details><summary>Recovery</summary>
              <form class="stack" action="/delivery/jobs/<%= j.publicId %>/rescheduled" method="post" data-offline-action data-shipment-id="<%= j.publicId %>" data-action="rescheduled"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><input name="rescheduledFor" type="datetime-local" required><button>Reschedule</button></form>
              <form action="/delivery/jobs/<%= j.publicId %>/return_to_sender" method="post" data-offline-action data-shipment-id="<%= j.publicId %>" data-action="return_to_sender"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><button>Return to sender</button></form>
            </details>
          <% } %>
          <% if(j.status==='return_to_sender'){ %><form action="/delivery/jobs/<%= j.publicId %>/returned" method="post" data-offline-action data-shipment-id="<%= j.publicId %>" data-action="returned"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><button>Confirm returned</button></form><% } %>
        <% } %></td>
      </tr><% }) %>
      <% if(!jobs.length){ %><tr><td colspan="6">No delivery jobs are available.</td></tr><% } %>
      </tbody></table>
    </article>
  </section>
<% } else { %>
  <section class="grid">
    <article class="card"><small>Shipments</small><h2><%= jobs.length %></h2></article>
    <article class="card"><small>Delivery profiles</small><h2><%= profiles.length %></h2></article>
    <article class="card"><small>Zones</small><h2><%= zones.length %></h2></article>
    <article class="card"><small>Warehouse tasks</small><h2><%= tasks.filter(t=>t.status!=='completed').length %></h2></article>

    <% if(capabilities?.admin){ %><article class="card half"><h2>Delivery verification</h2><div class="stack"><% profiles.forEach(p=>{ const docs=deliveryEvidenceByProfile?.[p.publicId]||[]; %><div><strong><%= p.userId?.name||p.publicId %></strong> · <%= p.transport %> · <span class="pill"><%= p.verificationStatus %></span><br><small><%= p.userId?.email||'' %> · <%= p.vehicleLabel||'No vehicle label' %> · <%= (p.serviceAreas||[]).join(', ')||'No service area' %></small><div><% docs.forEach(doc=>{ %><a href="/evidence/<%= doc.publicId %>" target="_blank" rel="noopener"><span class="pill"><%= doc.documentType %></span></a> <% }) %><% if(!docs.length){ %><small>No evidence uploaded</small><% } %></div><% if(p.verificationStatus==='submitted'){ %><form action="/operations/logistics/delivery/<%= p.publicId %>/review" method="post" class="inline"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><label><input type="checkbox" name="codEnabled" value="true"> COD approved</label><button class="primary" name="decision" value="approve">Approve</button><input name="reason" maxlength="500" placeholder="Reason if rejected"><button class="outline-button" name="decision" value="reject">Reject</button></form><% } %></div><% }) %></div></article>

    <article class="card half"><h2>Create shipping zone</h2><form class="stack" action="/operations/logistics/zones" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><input name="name" placeholder="Kampala Central" required><input name="country" value="<%= user.country %>" maxlength="2" required><input name="cities" placeholder="Kampala, Wakiso"><input name="currency" value="<%= user.currency %>" maxlength="3" required><input name="standardFeeMinor" type="number" min="0" placeholder="Standard fee" required><input name="expressFeeMinor" type="number" min="0" placeholder="Express fee"><input name="standardSlaHours" type="number" min="1" value="120" placeholder="Standard SLA hours"><input name="expressSlaHours" type="number" min="1" value="48" placeholder="Express SLA hours"><button class="primary">Create zone</button></form></article><% } %>

    <% if(capabilities?.finance){ %><article class="card half"><h2>Driver/day COD reconciliation</h2><p class="muted">Reconcile the exact cash handed over by one approved delivery partner for one local business date. Every shipment is still posted separately to the immutable ledger.</p><form class="stack" action="/operations/logistics/cod-reconciliation" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><select name="deliveryProfileId" required><option value="">Delivery partner</option><% profiles.filter(p=>p.verificationStatus==='approved'&&p.codEnabled).forEach(p=>{ %><option value="<%= p.publicId %>"><%= p.userId?.name||p.publicId %> · <%= p.transport %></option><% }) %></select><input name="businessDate" type="date" required><input name="currency" maxlength="3" value="<%= user.currency %>" required><input name="declaredAmountMinor" type="number" min="0" step="1" placeholder="Cash handed over (minor units)" required><button class="primary">Reconcile driver/day</button></form></article><article class="card half"><h2>COD reconciliation runs</h2><div class="stack"><% (codRuns||[]).forEach(run=>{ %><p><strong><%= run.businessDate||'—' %> · <%= run.deliveryUserId?.name||run.deliveryUserId||'Partner' %></strong><br><small><%= run.status %> · <%= run.updated %>/<%= run.checked %> shipments · <%= formatMoney(run.expectedAmountMinor||0,run.currency||user.currency) %></small></p><% }) %><% if(!(codRuns||[]).length){ %><p class="muted">No COD batch reconciliation runs yet.</p><% } %></div></article><% } %>

    <article class="card wide"><h2>Shipments</h2><table><thead><tr><th>Shipment</th><th>Order</th><th>Status</th><th>Partner</th><th>COD</th><th>Action</th></tr></thead><tbody><% jobs.forEach(j=>{ %><tr><td><%= j.publicId %></td><td><%= j.orderPublicId %></td><td><span class="pill"><%= j.status %></span></td><td><%= j.deliveryUserId||'Unassigned' %></td><td><%= j.cod?.required?`${formatMoney(j.cod.collectedMinor,j.cod.currency)} / ${formatMoney(j.cod.amountMinor,j.cod.currency)}`:'—' %></td><td><% if(capabilities?.admin && ['ready','offered'].includes(j.status) && !j.deliveryUserId){ %><form class="inline" action="/operations/logistics/shipments/<%= j.publicId %>/offer" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><select name="deliveryProfileId" required><option value="">Delivery partner</option><% profiles.filter(p=>p.verificationStatus==='approved'&&p.available).forEach(p=>{ %><option value="<%= p.publicId %>"><%= p.publicId %> · <%= p.transport %></option><% }) %></select><input name="earningMinor" type="number" min="0" placeholder="Earning" required><input name="currency" value="<%= j.cod?.currency||user.currency %>" maxlength="3"><button>Offer</button></form><% } %><% if(capabilities?.finance && j.cod?.required && j.status==='delivered' && !j.cod.reconciledAt){ %><form action="/operations/logistics/shipments/<%= j.publicId %>/reconcile-cod" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><button>Reconcile COD</button></form><% } %></td></tr><% }) %></tbody></table></article>

    <% if(capabilities?.warehouse){ %><article class="card half">
      <h2>Create warehouse task</h2>
      <p class="muted">Tasks execute inventory or parcel changes; completing a task is not a cosmetic status toggle.</p>
      <form class="stack" action="/operations/logistics/tasks" method="post">
        <input name="_csrf" type="hidden" value="<%= csrfToken %>">
        <select name="warehousePublicId" required><option value="">Warehouse</option><% warehouses.forEach(w=>{ %><option value="<%= w.publicId %>"><%= w.name %> — <%= w.city %></option><% }) %></select>
        <select name="type"><% ['receive','put_away','pick','pack','dispatch','cycle_count','transfer','return_inspection'].forEach(t=>{ %><option value="<%= t %>"><%= t.replaceAll('_',' ') %></option><% }) %></select>
        <select name="stockPublicId"><option value="">Stock item (receive/put-away/count/transfer/return)</option><% stock.forEach(s=>{ %><option value="<%= s.publicId %>"><%= s.variantId?.sku||s.publicId %> — <%= s.warehouseId?.name||'' %> — available <%= Math.max(0,(s.onHand||0)-(s.reserved||0)-(s.damaged||0)-(s.quarantined||0)) %></option><% }) %></select>
        <input name="quantity" type="number" min="0" step="1" placeholder="Quantity">
        <input name="binCode" maxlength="80" placeholder="Bin code (put-away)">
        <select name="disposition"><option value="">Return condition (return inspection)</option><option value="good">Good — return to available stock</option><option value="damaged">Damaged — unavailable</option><option value="quarantine">Quarantine — review required</option></select>
        <select name="destinationWarehousePublicId"><option value="">Destination warehouse (transfer only)</option><% warehouses.forEach(w=>{ %><option value="<%= w.publicId %>"><%= w.name %></option><% }) %></select>
        <select name="parcelPublicId"><option value="">Parcel (pick/pack/dispatch)</option><% (parcels||[]).forEach(p=>{ %><option value="<%= p.publicId %>"><%= p.publicId %> · <%= p.storePublicId %> · <%= p.status %> · <%= (p.items||[]).reduce((n,i)=>n+(i.quantity||0),0) %> items</option><% }) %></select>
        <input name="reference" placeholder="Order / transfer / receiving reference">
        <textarea name="notes" placeholder="Task notes"></textarea>
        <button class="primary">Create task</button>
      </form>
    </article>

    <article class="card half"><h2>Cycle count</h2><form class="stack" action="/operations/logistics/cycle-count" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><select name="stockPublicId" required><option value="">Stock item</option><% stock.forEach(s=>{ %><option value="<%= s.publicId %>"><%= s.variantId?.sku||s.publicId %> — <%= s.warehouseId?.name||'' %> · on hand <%= s.onHand||0 %> · reserved <%= s.reserved||0 %> · damaged <%= s.damaged||0 %> · quarantine <%= s.quarantined||0 %></option><% }) %></select><input name="countedOnHand" type="number" min="0" required><input name="reason" value="Cycle count" maxlength="300"><button class="primary">Post count</button></form></article><% } %>

    <article class="card wide"><h2>Parcels</h2><table><thead><tr><th>Parcel</th><th>Shipment</th><th>Store</th><th>Status</th><th>Items</th></tr></thead><tbody><% (parcels||[]).forEach(p=>{ %><tr><td><%= p.publicId %></td><td><%= p.shipmentPublicId %></td><td><%= p.storePublicId %></td><td><span class="pill"><%= p.status %></span></td><td><%= (p.items||[]).map(i=>`${i.title||i.productPublicId||'Item'} × ${i.quantity||0} (picked ${i.pickedQuantity||0})`).join(', ')||'—' %></td></tr><% }) %><% if(!(parcels||[]).length){ %><tr><td colspan="5">No parcels yet.</td></tr><% } %></tbody></table></article>

    <article class="card wide"><h2>Warehouse tasks</h2><table><thead><tr><th>Task</th><th>Warehouse</th><th>Type</th><th>Status</th><th>Execution</th><th>Action</th></tr></thead><tbody><% tasks.forEach(t=>{ %><tr><td><%= t.publicId %></td><td><%= t.warehouseId?.name||'—' %></td><td><%= t.type.replaceAll('_',' ') %></td><td><span class="pill"><%= t.status %></span></td><td><div class="task-meta"><span>Qty: <%= t.quantity||0 %></span><% if(t.binCode){ %><span>Bin: <%= t.binCode %></span><% } %><% if(t.disposition){ %><span>Disposition: <%= t.disposition %></span><% } %><% if(t.reference){ %><span>Ref: <%= t.reference %></span><% } %><% if(t.error){ %><span><%= t.error %></span><% } %></div></td><td><% if(capabilities?.warehouse && t.status!=='completed'){ %><form action="/operations/logistics/tasks/<%= t.publicId %>/complete" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><% if(t.type==='return_inspection' && !t.disposition){ %><select name="disposition" required><option value="">Condition</option><option value="good">Good</option><option value="damaged">Damaged</option><option value="quarantine">Quarantine</option></select><% } %><button>Execute &amp; complete</button></form><% } %></td></tr><% }) %></tbody></table></article>
  </section>
<% } %>
</main>
<% if(mode==='delivery'){ %><script src="/delivery-offline.js" defer></script><% } %>
</body>
</html>
