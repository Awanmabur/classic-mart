<!doctype html>
<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= mode==='delivery'?'Delivery Partner':'Logistics Operations' %> — Classic Mart</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/storefront-pages.css">
  <link rel="stylesheet" href="/server-ui.css">
  <link rel="stylesheet" href="/logistics-workspace.css">
</head>
<body data-operations-ui="true">
<main class="logistics-workspace">
  <h1><%= mode==='delivery'?'Delivery Partner':'Logistics Operations' %></h1>
  <p class="muted"><%= mode==='delivery'?'Verified assignments, custody proof, failed delivery, safe offline replay and COD collection.':'Delivery verification, shipping zones, parcel custody, executable warehouse tasks, cycle counts and COD reconciliation.' %></p>

<% if(mode==='delivery'){ %>
  <div class="offline-note" id="offline-status" role="status" aria-live="polite"></div>
  <section class="grid">
    <article class="card half">
      <h2>Your delivery profile</h2>
      <p>Status: <span class="pill"><%= profile.verificationStatus %></span> · Availability: <strong><%= profile.available?'On':'Off' %></strong></p><p><a href="/money">Open delivery earnings &amp; payouts</a></p>
      <form class="stack" action="/delivery/profile" method="post">
        <input name="_csrf" type="hidden" value="<%= csrfToken %>">
        <select name="transport" required><% ['bicycle','motorcycle','car','van','truck','other'].forEach(t=>{ %><option value="<%= t %>" <%= profile.transport===t?'selected':'' %>><%= t %></option><% }) %></select>
        <input name="vehicleLabel" maxlength="120" placeholder="Vehicle / plate" value="<%= profile.vehicleLabel||'' %>">
        <input name="serviceAreas" placeholder="Kampala, Wakiso" value="<%= (profile.serviceAreas||[]).join(', ') %>">
        <div class="inline"><button name="action" value="save">Save profile</button><button class="primary" name="action" value="submit">Submit verification</button></div>
      </form>
      <h3>Private verification evidence</h3>
      <p class="muted">Identity is required. Motorized delivery also requires a vehicle or permit image. Images are sanitized and remain private.</p>
      <form class="stack" action="/delivery/profile/evidence" method="post" enctype="multipart/form-data">
        <input name="_csrf" type="hidden" value="<%= csrfToken %>">
        <select name="documentType" required><option value="identity">Identity</option><option value="vehicle">Vehicle registration</option><option value="permit">Driving permit</option></select>
        <input name="file" type="file" accept="image/png,image/jpeg,image/webp" required>
        <input name="description" maxlength="300" placeholder="Optional document note">
        <button>Upload securely</button>
      </form>
      <div class="stack"><% (profileEvidence||[]).forEach(doc=>{ %><p><span class="pill"><%= doc.documentType %></span> <a href="/evidence/<%= doc.publicId %>" target="_blank" rel="noopener">View uploaded image</a></p><% }) %><% if(!(profileEvidence||[]).length){ %><p class="muted">No verification images uploaded yet.</p><% } %></div>
      <% if(profile.verificationStatus==='approved'){ %>
        <form class="inline" action="/delivery/availability" method="post">
          <input name="_csrf" type="hidden" value="<%= csrfToken %>">
          <input name="available" type="hidden" value="<%= profile.available?'false':'true' %>">
          <button><%= profile.available?'Go offline':'Go available' %></button>
        </form>
      <% } %>
    </article>

    <article class="card wide">
      <h2>Job offers</h2>
      <table><thead><tr><th>Shipment</th><th>Earning</th><th>Expires</th><th>Action</th></tr></thead><tbody>
        <% (offers||[]).forEach(o=>{ %><tr><td><%= o.shipmentPublicId %></td><td class="workspace-money"><%= formatMoney(o.earningMinor,o.currency) %></td><td><%= new Date(o.expiresAt).toLocaleString() %></td><td><form action="/delivery/offers/<%= o.publicId %>/accept" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><button class="primary">Accept offer</button></form></td></tr><% }) %>
        <% if(!(offers||[]).length){ %><tr><td colspan="4">No active delivery offers.</td></tr><% } %>
      </tbody></table>
      <% if(queuePages?.offers){ %><div class="server-pager"><small>Showing <%=queuePages.offers.count%> of <%=queuePages.offers.total%> active offers</small><% if(queuePages.offers.hasMore){%><a class="outline-button" href="/delivery?offersAfter=<%=encodeURIComponent(queuePages.offers.next)%>">More offers</a><%}%></div><% } %>
    </article>

    <article class="card wide">
      <h2>Assignments</h2>
      <p class="muted">When connectivity drops, eligible assignment actions are queued on this device and replayed when the connection returns. The server still validates assignment ownership, OTP proof and allowed state transitions.</p>
      <table class="mobile-ops-table"><thead><tr><th>Shipment</th><th>Order</th><th>Destination</th><th>Status / SLA</th><th>COD</th><th>Actions</th></tr></thead><tbody>
      <% jobs.forEach(j=>{ %><tr>
        <td data-label="Shipment"><%= j.publicId %></td><td data-label="Order"><%= j.orderPublicId %></td><td data-label="Destination"><% if(j.destination?.address){ %><strong><%= j.destination.fullName %></strong><br><%= j.destination.address %>, <%= j.destination.city %><br><small>Contact <%= j.destination.maskedPhone %></small><% if(j.destination.note){ %><br><small>Delivery note: <%= j.destination.note %></small><% } %><% if(j.destination.navigationUrl){ %><br><a href="<%= j.destination.navigationUrl %>" target="_blank" rel="noopener noreferrer">Open navigation</a><% } %><% } else { %>—<% } %></td><td data-label="Status / SLA"><span class="pill"><%= j.status.replaceAll('_',' ') %></span><% if(j.slaDueAt){ const overdue=!['delivered','returned','cancelled'].includes(j.status)&&new Date(j.slaDueAt)<new Date(); %><br><small><%= overdue?'OVERDUE · ':'' %>due <%= formatDate(j.slaDueAt) %></small><% } %><% if((j.openExceptions||[]).length){ %><br><small><strong><%= j.openExceptions.length %> open exception(s)</strong></small><% } %></td><td data-label="COD"><%= j.cod?.required ? formatMoney(j.cod.amountMinor,j.cod.currency) : 'No' %><% if(j.cod?.required&&j.status==='delivered'){ %><br><small><%= j.cod?.handoverAt?'handover recorded':'handover pending' %></small><% } %></td>
        <td data-label="Actions"><% if(j.deliveryUserId && String(j.deliveryUserId)===String(user._id)){ %>
          <% if(!['delivered','returned','cancelled'].includes(j.status)){ %><details><summary>Proof / evidence</summary><form class="stack" action="/delivery/jobs/<%= j.publicId %>/evidence" method="post" enctype="multipart/form-data"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><select name="documentType" required><option value="delivery_photo">Delivery proof photo</option><option value="delivery_signature">Recipient signature image</option><option value="failed_attempt">Failed-attempt photo</option><option value="address_exception">Address-exception photo</option></select><input name="file" type="file" accept="image/png,image/jpeg,image/webp" required><input name="description" maxlength="300" placeholder="Evidence note"><button>Upload securely</button></form><small>Policy: photo <%= j.proofPolicy?.deliveryPhotoRequired?'required':'optional' %> · signature <%= j.proofPolicy?.signatureRequired?'required':'optional' %> · failed-attempt photo <%= j.proofPolicy?.failedAttemptPhotoRequired?'required':'optional' %>.</small></details><% } %>
          <% if((j.evidence||[]).length){ %><div><% (j.evidence||[]).slice(0,5).forEach(doc=>{ %><a href="/evidence/<%= doc.publicId %>" target="_blank" rel="noopener"><span class="pill"><%= doc.documentType.replaceAll('_',' ') %></span></a> <% }) %></div><% } %>
          <% if(['assigned','picked_up','in_transit','rescheduled'].includes(j.status)){ const next=j.status==='assigned'?'picked_up':j.status==='picked_up'?'in_transit':'delivered'; %>
            <form class="inline" method="post" action="/delivery/jobs/<%= j.publicId %>/<%= next %>" data-offline-action data-shipment-id="<%= j.publicId %>" data-action="<%= next %>">
              <input name="_csrf" type="hidden" value="<%= csrfToken %>">
              <% if(['assigned','in_transit','rescheduled'].includes(j.status)){ %><input name="proofCode" inputmode="numeric" autocomplete="one-time-code" placeholder="OTP" required><% } %>
              <button><%= j.status==='assigned'?'Confirm pickup':j.status==='picked_up'?'Start transit':'Confirm delivery' %></button>
            </form>
          <% } %>
          <% if(['assigned','picked_up','in_transit','rescheduled'].includes(j.status)){ %>
            <details><summary>Failed attempt / address exception</summary><form class="stack" action="/delivery/jobs/<%= j.publicId %>/failed" method="post" data-offline-action data-shipment-id="<%= j.publicId %>" data-action="failed"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><select name="reasonCode" required><option value="">Reason</option><option value="recipient_unavailable">Recipient unavailable</option><option value="address_not_found">Address not found</option><option value="address_incorrect">Address incorrect</option><option value="recipient_refused">Recipient refused</option><option value="unsafe_location">Unsafe location</option><option value="parcel_damaged">Parcel damaged</option><option value="vehicle_issue">Vehicle issue</option><option value="other">Other</option></select><input name="reason" required maxlength="300" placeholder="What happened?"><small>Upload failed-attempt/address evidence above where required by policy. Missing required evidence remains visible as an open exception.</small><button>Record failed attempt</button></form></details>
          <% } %>
          <% if(['failed','in_transit','rescheduled'].includes(j.status)){ %>
            <details><summary>Recovery</summary>
              <form class="stack" action="/delivery/jobs/<%= j.publicId %>/rescheduled" method="post" data-offline-action data-shipment-id="<%= j.publicId %>" data-action="rescheduled"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><input name="rescheduledFor" type="datetime-local" required><button>Reschedule</button></form>
              <form action="/delivery/jobs/<%= j.publicId %>/return_to_sender" method="post" data-offline-action data-shipment-id="<%= j.publicId %>" data-action="return_to_sender"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><button>Return to sender</button></form>
            </details>
          <% } %>
          <% if(j.status==='return_to_sender'){ %><form action="/delivery/jobs/<%= j.publicId %>/returned" method="post" data-offline-action data-shipment-id="<%= j.publicId %>" data-action="returned"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><button>Confirm returned</button></form><% } %>
          <% if(j.cod?.required&&j.status==='delivered'&&!j.cod?.reconciledAt&&(!j.cod?.handoverAt||j.cod?.mismatchExceptionPublicId)){ %><details><summary><%= j.cod?.mismatchExceptionPublicId?'Correct COD handover':'Record COD cash handover' %></summary><form class="stack" action="/delivery/jobs/<%= j.publicId %>/cod-handover" method="post" enctype="multipart/form-data"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><input name="declaredAmountMinor" type="number" min="0" step="1" value="<%= j.cod.collectedMinor||0 %>" required><input name="file" type="file" accept="image/png,image/jpeg,image/webp" required><small>Upload the signed/stamped cash handover receipt. A mismatch opens an investigation and blocks finance reconciliation.</small><button>Record handover</button></form></details><% } %>
        <% } %></td>
      </tr><% }) %>
      <% if(!jobs.length){ %><tr><td colspan="6">No delivery jobs are available.</td></tr><% } %>
      </tbody></table>
      <% if(queuePages?.jobs){ %><div class="server-pager"><small>Showing <%=queuePages.jobs.count%> of <%=queuePages.jobs.total%> assignments</small><% if(queuePages.jobs.hasMore){%><a class="outline-button" href="/delivery?jobsAfter=<%=encodeURIComponent(queuePages.jobs.next)%>">Older assignments</a><%}%></div><% } %>
    </article>
  </section>
<% } else { %>
  <section class="grid">
    <article class="card"><small>Shipments</small><h2><%= queuePages?.jobs?.total ?? jobs.length %></h2></article>
    <article class="card"><small>Delivery profiles</small><h2><%= queuePages?.profiles?.total ?? profiles.length %></h2></article>
    <article class="card"><small>Zones</small><h2><%= queuePages?.zones?.total ?? zones.length %></h2></article>
    <article class="card"><small>Warehouse tasks</small><h2><%= queuePages?.tasks?.total ?? tasks.length %></h2></article>
    <article class="card"><small>Inventory discrepancies</small><h2><%= queuePages?.discrepancies?.total ?? (discrepancies||[]).length %></h2></article>

    <article class="card wide"><h2>Warehouse scanner &amp; inventory audit</h2><div class="grid" style="grid-template-columns:repeat(2,minmax(0,1fr))"><form class="stack" action="/operations/logistics" method="get"><label>Scan parcel / stock / SKU / product barcode<input name="scanCode" value="<%= scanCode||'' %>" autocomplete="off" autofocus placeholder="Scan or type code"></label><button class="primary">Look up</button><% if(scanResult){ %><div><strong><%= scanResult.title %></strong><br><small><%= scanResult.detail %></small></div><% } %></form><form class="stack" action="/operations/logistics/inventory-audit.csv" method="get"><label>Warehouse<select name="warehousePublicId"><option value="">All authorized warehouses</option><% warehouses.forEach(w=>{ %><option value="<%= w.publicId %>"><%= w.name %></option><% }) %></select></label><label>From<input name="from" type="date"></label><label>To<input name="to" type="date"></label><button class="outline-button">Download inventory audit CSV</button></form></div><p class="muted">USB/Bluetooth barcode scanners work as keyboard input. Parcel labels use a printable Code 39 barcode. Inventory exports are country-scoped, formula-injection safe and stream the immutable movement ledger instead of truncating history.</p></article>

    <% if(capabilities?.admin){ %><article class="card half"><h2>Delivery verification</h2><div class="stack"><% profiles.forEach(p=>{ const docs=deliveryEvidenceByProfile?.[p.publicId]||[]; %><div><strong><%= p.userId?.name||p.publicId %></strong> · <%= p.transport %> · <span class="pill"><%= p.verificationStatus %></span><br><small><%= p.userId?.email||'' %> · <%= p.vehicleLabel||'No vehicle label' %> · <%= (p.serviceAreas||[]).join(', ')||'No service area' %></small><div><% docs.forEach(doc=>{ %><a href="/evidence/<%= doc.publicId %>" target="_blank" rel="noopener"><span class="pill"><%= doc.documentType %></span></a> <% }) %><% if(!docs.length){ %><small>No evidence uploaded</small><% } %></div><% if(p.verificationStatus==='submitted'){ %><form action="/operations/logistics/delivery/<%= p.publicId %>/review" method="post" class="inline"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><label><input type="checkbox" name="codEnabled" value="true"> COD approved</label><button class="primary" name="decision" value="approve">Approve</button><input name="reason" maxlength="500" placeholder="Reason if rejected"><button class="outline-button" name="decision" value="reject">Reject</button></form><% } %></div><% }) %></div><% if(queuePages?.profiles){%><div class="server-pager"><small>Showing <%=queuePages.profiles.count%> of <%=queuePages.profiles.total%> profiles</small><% if(queuePages.profiles.hasMore){%><a class="outline-button" href="/operations/logistics?profilesAfter=<%=encodeURIComponent(queuePages.profiles.next)%>">Older profiles</a><%}%></div><%}%></article>

    <article class="card half"><h2>Create shipping zone</h2><form class="stack" action="/operations/logistics/zones" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><input name="name" placeholder="Kampala Central" required><input name="country" value="<%= user.country %>" maxlength="2" required><input name="cities" placeholder="Kampala, Wakiso"><input name="currency" value="<%= user.currency %>" maxlength="3" required><input name="standardFeeMinor" type="number" min="0" placeholder="Standard fee" required><input name="expressFeeMinor" type="number" min="0" placeholder="Express fee"><input name="standardSlaHours" type="number" min="1" value="120" placeholder="Standard SLA hours"><input name="expressSlaHours" type="number" min="1" value="48" placeholder="Express SLA hours"><button class="primary">Create zone</button></form></article><% } %>

    <% if(capabilities?.finance){ %><article class="card half"><h2>Driver/day COD reconciliation</h2><p class="muted">Reconcile the exact cash handed over by one approved delivery partner for one local business date. Every shipment is still posted separately to the immutable ledger.</p><form class="stack" action="/operations/logistics/cod-reconciliation" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><select name="deliveryProfileId" required><option value="">Delivery partner</option><% profiles.filter(p=>p.verificationStatus==='approved'&&p.codEnabled).forEach(p=>{ %><option value="<%= p.publicId %>"><%= p.userId?.name||p.publicId %> · <%= p.transport %></option><% }) %></select><input name="businessDate" type="date" required><input name="currency" maxlength="3" value="<%= user.currency %>" required><input name="declaredAmountMinor" type="number" min="0" step="1" placeholder="Cash handed over (minor units)" required><button class="primary">Reconcile driver/day</button></form></article><article class="card half"><h2>COD reconciliation runs</h2><div class="stack"><% (codRuns||[]).forEach(run=>{ %><p><strong><%= run.businessDate||'—' %> · <%= run.deliveryUserId?.name||run.deliveryUserId||'Partner' %></strong><br><small><%= run.status %> · <%= run.updated %>/<%= run.checked %> shipments · <%= formatMoney(run.expectedAmountMinor||0,run.currency||user.currency) %></small></p><% }) %><% if(!(codRuns||[]).length){ %><p class="muted">No COD batch reconciliation runs yet.</p><% } %></div><% if(queuePages?.codRuns){%><div class="server-pager"><small>Showing <%=queuePages.codRuns.count%> of <%=queuePages.codRuns.total%> runs</small><% if(queuePages.codRuns.hasMore){%><a class="outline-button" href="/operations/logistics?codAfter=<%=encodeURIComponent(queuePages.codRuns.next)%>">Older runs</a><%}%></div><%}%></article><% } %>

    <article class="card wide"><h2>Delivery exceptions</h2><p class="muted">Failed attempts, address exceptions, missing evidence and COD mismatches remain explicit until an authorized supervisor resolves them. Do not resolve a COD mismatch until the recorded handover amount has been corrected.</p><table><thead><tr><th>Exception</th><th>Shipment</th><th>Type / reason</th><th>Evidence</th><th>Status</th><th>Resolution</th></tr></thead><tbody><% (exceptions||[]).forEach(ex=>{ %><tr><td><strong><%= ex.publicId %></strong><br><small><%= formatDate(ex.createdAt) %></small></td><td><%= ex.shipmentPublicId %><br><small><%= ex.deliveryUserId?.name||'Delivery partner' %></small></td><td><span class="pill"><%= ex.type.replaceAll('_',' ') %></span><br><%= ex.reasonCode.replaceAll('_',' ') %><br><small><%= ex.description %></small></td><td><% (ex.evidenceDocumentIds||[]).forEach(doc=>{ %><a href="/evidence/<%= doc.publicId %>" target="_blank" rel="noopener"><span class="pill"><%= doc.documentType.replaceAll('_',' ') %></span></a> <% }) %><% if(!(ex.evidenceDocumentIds||[]).length){ %><small><%= ex.evidenceRequired?'Required evidence pending':'No image attached' %></small><% } %></td><td><span class="pill"><%= ex.status %></span></td><td><% if(capabilities?.admin&&['open','investigating'].includes(ex.status)){ %><form class="stack" action="/operations/logistics/exceptions/<%= ex.publicId %>/resolve" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><textarea name="resolutionNote" minlength="3" maxlength="600" required placeholder="Investigation result / corrective action"></textarea><div class="admin-actions"><button name="decision" value="resolve">Resolve</button><button class="outline-button" name="decision" value="dismiss">Dismiss</button></div></form><% } else { %>—<% } %></td></tr><% }) %><% if(!(exceptions||[]).length){ %><tr><td colspan="6">No delivery exceptions in scope.</td></tr><% } %></tbody></table><% if(queuePages?.exceptions){%><div class="server-pager"><small>Showing <%=queuePages.exceptions.count%> of <%=queuePages.exceptions.total%> exceptions</small><% if(queuePages.exceptions.hasMore){%><a class="outline-button" href="/operations/logistics?exceptionsAfter=<%=encodeURIComponent(queuePages.exceptions.next)%>">Older exceptions</a><%}%></div><%}%></article>

    <article class="card wide"><h2>Shipments</h2><table><thead><tr><th>Shipment</th><th>Order</th><th>Status / SLA</th><th>Partner</th><th>COD / handover</th><th>Action</th></tr></thead><tbody><% jobs.forEach(j=>{ const overdue=j.slaDueAt&&!['delivered','returned','cancelled'].includes(j.status)&&new Date(j.slaDueAt)<new Date(); %><tr><td><%= j.publicId %></td><td><%= j.orderPublicId %></td><td><span class="pill"><%= j.status %></span><% if(j.slaDueAt){ %><br><small><%= overdue?'OVERDUE · ':'' %><%= formatDate(j.slaDueAt) %></small><% } %></td><td><%= j.deliveryUserId||'Unassigned' %></td><td><%= j.cod?.required?`${formatMoney(j.cod.collectedMinor,j.cod.currency)} / ${formatMoney(j.cod.amountMinor,j.cod.currency)}`:'—' %><% if(j.cod?.required){ %><br><small><%= j.cod?.handoverAt?'receipt-backed handover':'handover pending' %><%= j.cod?.mismatchExceptionPublicId?' · MISMATCH OPEN':'' %></small><% } %></td><td><% if(capabilities?.admin && ['ready','offered'].includes(j.status) && !j.deliveryUserId){ %><form class="inline" action="/operations/logistics/shipments/<%= j.publicId %>/offer" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><select name="deliveryProfileId" required><option value="">Delivery partner</option><% profiles.filter(p=>p.verificationStatus==='approved'&&p.available).forEach(p=>{ %><option value="<%= p.publicId %>"><%= p.publicId %> · <%= p.transport %></option><% }) %></select><input name="earningMinor" type="number" min="0" placeholder="Earning" required><input name="currency" value="<%= j.cod?.currency||user.currency %>" maxlength="3"><button>Offer</button></form><% } %><% if(capabilities?.finance && j.cod?.required && j.status==='delivered' && !j.cod.reconciledAt){ %><% if(j.cod?.handoverAt&&!j.cod?.mismatchExceptionPublicId){ %><form action="/operations/logistics/shipments/<%= j.publicId %>/reconcile-cod" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><button>Reconcile COD</button></form><% } else { %><small><%= j.cod?.mismatchExceptionPublicId?'Resolve COD mismatch first':'Await delivery-partner handover receipt' %></small><% } %><% } %></td></tr><% }) %><% if(!jobs.length){ %><tr><td colspan="6">No shipments in scope.</td></tr><% } %></tbody></table><% if(queuePages?.jobs){%><div class="server-pager"><small>Showing <%=queuePages.jobs.count%> of <%=queuePages.jobs.total%> shipments</small><% if(queuePages.jobs.hasMore){%><a class="outline-button" href="/operations/logistics?jobsAfter=<%=encodeURIComponent(queuePages.jobs.next)%>">Older shipments</a><%}%></div><%}%></article>

    <% if(capabilities?.warehouse){ %><article class="card half">
      <h2>Create warehouse task</h2>
      <p class="muted">Tasks execute inventory or parcel changes; completing a task is not a cosmetic status toggle.</p>
      <form class="stack" action="/operations/logistics/tasks" method="post">
        <input name="_csrf" type="hidden" value="<%= csrfToken %>">
        <select name="warehousePublicId" required><option value="">Warehouse</option><% warehouses.forEach(w=>{ %><option value="<%= w.publicId %>"><%= w.name %> — <%= w.city %></option><% }) %></select>
        <select name="type"><% ['receive','put_away','pick','pack','dispatch','cycle_count','transfer'].forEach(t=>{ %><option value="<%= t %>"><%= t.replaceAll('_',' ') %></option><% }) %></select>
        <select name="stockPublicId"><option value="">Stock item (receive/put-away/count/transfer/return)</option><% stock.forEach(s=>{ %><option value="<%= s.publicId %>"><%= s.variantId?.sku||s.publicId %> — <%= s.warehouseId?.name||'' %> — available <%= Math.max(0,(s.onHand||0)-(s.reserved||0)-(s.damaged||0)-(s.quarantined||0)) %></option><% }) %></select>
        <input name="quantity" type="number" min="0" step="1" placeholder="Quantity">
        <input name="binCode" maxlength="80" placeholder="Bin code (put-away)">
        <select name="destinationWarehousePublicId"><option value="">Destination warehouse (transfer only)</option><% warehouses.forEach(w=>{ %><option value="<%= w.publicId %>"><%= w.name %></option><% }) %></select>
        <select name="parcelPublicId"><option value="">Parcel (pick/pack/dispatch)</option><% (parcels||[]).forEach(p=>{ %><option value="<%= p.publicId %>"><%= p.publicId %> · <%= p.storePublicId %> · <%= p.status %> · <%= (p.items||[]).reduce((n,i)=>n+(i.quantity||0),0) %> items</option><% }) %></select>
        <input name="reference" placeholder="Order / transfer / receiving reference">
        <textarea name="notes" placeholder="Task notes"></textarea>
        <button class="primary">Create task</button>
      </form>
    </article>

    <article class="card half"><h2>Cycle count</h2><p class="muted">A count never changes sellable stock by itself. Matching counts close automatically; any variance waits for a different supervisor to review the frozen stock snapshot.</p><form class="stack" action="/operations/logistics/cycle-count" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><select name="stockPublicId" required><option value="">Stock item</option><% stock.forEach(s=>{ %><option value="<%= s.publicId %>"><%= s.variantId?.sku||s.publicId %> — <%= s.warehouseId?.name||'' %> · on hand <%= s.onHand||0 %> · reserved <%= s.reserved||0 %> · damaged <%= s.damaged||0 %> · quarantine <%= s.quarantined||0 %></option><% }) %></select><input name="countedOnHand" type="number" min="0" step="1" required><input name="reason" value="Cycle count" maxlength="300"><button class="primary">Submit count for review</button></form></article><% } %>

    <article class="card wide"><h2>Inventory discrepancies</h2><p class="muted">Cycle-count variances use four-eyes approval. Approval is refused if stock, reservations, damaged stock or quarantine changed after counting.</p><table><thead><tr><th>Discrepancy</th><th>SKU / warehouse</th><th>System → counted</th><th>Variance</th><th>Status</th><th>Review</th></tr></thead><tbody><% (discrepancies||[]).forEach(d=>{ const countedBy=String(d.countedByUserId?._id||d.countedByUserId||''); const actorId=String(user?._id||''); %><tr><td><strong><%= d.publicId %></strong><br><small><%= d.reason||'Cycle count' %> · <%= formatDate(d.countedAt||d.createdAt) %></small></td><td><%= d.variantId?.sku||d.stockItemId?.publicId||'Stock' %><br><small><%= d.warehouseId?.name||d.country %></small></td><td><%= d.expectedOnHand %> → <%= d.countedOnHand %><br><small>Reserved <%= d.reservedSnapshot %> · damaged <%= d.damagedSnapshot %> · quarantine <%= d.quarantinedSnapshot %></small></td><td><strong><%= d.variance>0?`+${d.variance}`:d.variance %></strong></td><td><span class="pill"><%= d.status.replaceAll('_',' ') %></span><% if(d.reviewedByUserId){ %><br><small>by <%= d.reviewedByUserId?.name||'reviewer' %><% if(d.reviewNote){ %> · <%= d.reviewNote %><% } %></small><% } %></td><td><% if(capabilities?.admin && d.status==='pending_review'){ %><% if(countedBy===actorId){ %><small class="muted">A different supervisor must review your count.</small><% } else { %><form class="stack" action="/operations/logistics/discrepancies/<%= d.publicId %>/review" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><input name="reviewNote" maxlength="300" placeholder="Review note / rejection reason"><div class="admin-actions"><button class="primary" name="decision" value="approve">Approve adjustment</button><button class="outline-button" name="decision" value="reject">Reject</button></div></form><% } %><% } else { %><small>—</small><% } %></td></tr><% }) %><% if(!(discrepancies||[]).length){ %><tr><td colspan="6">No cycle-count discrepancies yet.</td></tr><% } %></tbody></table><% if(queuePages?.discrepancies){%><div class="server-pager"><small>Showing <%=queuePages.discrepancies.count%> of <%=queuePages.discrepancies.total%> discrepancies</small><% if(queuePages.discrepancies.hasMore){%><a class="outline-button" href="/operations/logistics?discrepanciesAfter=<%=encodeURIComponent(queuePages.discrepancies.next)%>">Older discrepancies</a><%}%></div><%}%></article>

    <article class="card wide"><h2>Parcels</h2><table><thead><tr><th>Parcel</th><th>Shipment</th><th>Store</th><th>Status</th><th>Items</th><th>Label</th></tr></thead><tbody><% (parcels||[]).forEach(p=>{ %><tr><td><%= p.publicId %></td><td><%= p.shipmentPublicId %></td><td><%= p.storePublicId %></td><td><span class="pill"><%= p.status %></span></td><td><%= (p.items||[]).map(i=>`${i.title||i.productPublicId||'Item'} × ${i.quantity||0} (picked ${i.pickedQuantity||0})`).join(', ')||'—' %></td><td><% if(capabilities?.warehouse){ %><a class="outline-button" href="/operations/logistics/parcels/<%= p.publicId %>/label" target="_blank" rel="noopener">Print label</a><% } else { %>—<% } %></td></tr><% }) %><% if(!(parcels||[]).length){ %><tr><td colspan="6">No parcels yet.</td></tr><% } %></tbody></table><% if(queuePages?.parcels){%><div class="server-pager"><small>Showing <%=queuePages.parcels.count%> of <%=queuePages.parcels.total%> parcels</small><% if(queuePages.parcels.hasMore){%><a class="outline-button" href="/operations/logistics?parcelsAfter=<%=encodeURIComponent(queuePages.parcels.next)%>">Older parcels</a><%}%></div><%}%></article>

    <article class="card wide"><h2>Pick waves</h2><p class="muted">Batch the oldest unclaimed pick work for one warehouse into a single operator-owned wave. Wave creation claims every included task atomically; a conflict rolls the whole wave back.</p><% if(capabilities?.warehouse){ %><form class="inline" action="/operations/logistics/pick-waves" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><select name="warehousePublicId" required><option value="">Warehouse</option><% warehouses.forEach(w=>{ %><option value="<%= w.publicId %>"><%= w.name %></option><% }) %></select><input name="batchSize" type="number" min="2" max="50" value="20" aria-label="Maximum pick tasks in wave"><button class="primary">Create my pick wave</button></form><% } %><table class="mobile-ops-table"><thead><tr><th>Wave</th><th>Warehouse</th><th>Owner</th><th>Work</th><th>Status / SLA</th><th>Action</th></tr></thead><tbody><% (waves||[]).forEach(w=>{ const ownerId=String(w.assignedUserId?._id||w.assignedUserId||''); const actorId=String(user?._id||''); const supervisor=['super_admin','country_admin'].includes(user?.role); %><tr><td data-label="Wave"><strong><%= w.publicId %></strong><br><small>Started <%= formatDate(w.startedAt||w.createdAt) %></small></td><td data-label="Warehouse"><%= w.warehouseId?.name||w.country %></td><td data-label="Owner"><%= w.assignedUserId?.name||'Assigned operator' %></td><td data-label="Work"><div class="wave-summary"><span><%= w.taskCount %> tasks</span><span><%= w.totalQuantity %> units</span></div></td><td data-label="Status / SLA"><span class="pill"><%= w.status.replaceAll('_',' ') %></span><% if(w.dueAt){ const overdue=w.status==='in_progress'&&new Date(w.dueAt)<new Date(); %><br><small><%= overdue?'OVERDUE · ':'' %><%= formatDate(w.dueAt) %></small><% } %></td><td data-label="Action"><% if(w.status==='in_progress' && capabilities?.warehouse && (ownerId===actorId||supervisor)){ %><form action="/operations/logistics/pick-waves/<%= w.publicId %>/release" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><button class="outline-button" type="submit">Release unfinished</button></form><% } else { %><small>—</small><% } %></td></tr><% }) %><% if(!(waves||[]).length){ %><tr><td data-label="Pick waves" colspan="6">No pick waves yet.</td></tr><% } %></tbody></table><% if(queuePages?.waves){%><div class="server-pager"><small>Showing <%=queuePages.waves.count%> of <%=queuePages.waves.total%> waves</small><% if(queuePages.waves.hasMore){%><a class="outline-button" href="/operations/logistics?wavesAfter=<%=encodeURIComponent(queuePages.waves.next)%>">Older waves</a><%}%></div><%}%></article>

    <article class="card wide"><h2>Warehouse tasks</h2><p class="muted">Open work must be claimed atomically before execution. Only the assigned operator can complete it; supervisors can release abandoned assignments. Every new task has an SLA due time.</p><form class="inline" action="/operations/logistics" method="get"><select name="taskWarehouse"><option value="">All warehouses</option><% warehouses.forEach(w=>{ %><option value="<%= w.publicId %>" <%= taskFilters?.warehousePublicId===w.publicId?'selected':'' %>><%= w.name %></option><% }) %></select><select name="taskStatus"><option value="">All statuses</option><% ['open','in_progress','completed','cancelled'].forEach(v=>{ %><option value="<%=v%>" <%=taskFilters?.status===v?'selected':''%>><%=v.replaceAll('_',' ')%></option><% }) %></select><select name="taskType"><option value="">All task types</option><% ['receive','put_away','pick','pack','dispatch','cycle_count','transfer','return_inspection'].forEach(v=>{ %><option value="<%=v%>" <%=taskFilters?.type===v?'selected':''%>><%=v.replaceAll('_',' ')%></option><% }) %></select><label><input type="checkbox" name="taskOverdue" value="1" <%=taskFilters?.overdue?'checked':''%>> Overdue only</label><button>Filter queue</button><a class="outline-button" href="/operations/logistics">Clear</a></form><table class="mobile-ops-table"><thead><tr><th>Task</th><th>Warehouse</th><th>Type</th><th>Status / owner</th><th>Execution</th><th>Action</th></tr></thead><tbody><% tasks.forEach(t=>{ const assignedId=String(t.assignedUserId?._id||t.assignedUserId||''); const actorId=String(user?._id||''); const supervisor=['super_admin','country_admin'].includes(user?.role); const mine=assignedId&&assignedId===actorId; %><tr><td data-label="Task"><strong><%= t.publicId %></strong><% if(t.wavePublicId){ %><br><small>Wave <%= t.wavePublicId %></small><% } %></td><td data-label="Warehouse"><%= t.warehouseId?.name||'—' %></td><td data-label="Type"><%= t.type.replaceAll('_',' ') %></td><td data-label="Status / owner"><span class="pill"><%= t.status %></span><br><small><%= t.assignedUserId?.name|| (assignedId?'Assigned operator':'Unassigned') %><% if(t.claimedAt){ %> · claimed <%= formatDate(t.claimedAt) %><% } %></small></td><td data-label="Execution"><div class="task-meta"><span>Qty: <%= t.quantity||0 %></span><% if(t.binCode){ %><span>Bin: <%= t.binCode %></span><% } %><% if(t.disposition){ %><span>Disposition: <%= t.disposition %></span><% } %><% if(t.reference){ %><span>Ref: <%= t.reference %></span><% } %><% if(t.dueAt){ const overdue=!['completed','cancelled'].includes(t.status)&&new Date(t.dueAt)<new Date(); %><span><%= overdue?'OVERDUE':'Due' %>: <%= formatDate(t.dueAt) %></span><% } %></div></td><td data-label="Action"><div class="admin-actions"><% if(capabilities?.warehouse && t.status==='open'){ %><form action="/operations/logistics/tasks/<%= t.publicId %>/claim" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><button type="submit">Claim task</button></form><% } %><% if(capabilities?.warehouse && t.status==='in_progress' && (mine||supervisor)){ %><form action="/operations/logistics/tasks/<%= t.publicId %>/release" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><button class="outline-button" type="submit"><%= t.wavePublicId?'Release wave':'Release' %></button></form><% } %><% if(capabilities?.warehouse && t.status==='in_progress' && mine){ %><form action="/operations/logistics/tasks/<%= t.publicId %>/complete" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><% if(t.type==='return_inspection' && !t.disposition){ %><select name="disposition" required><option value="">Condition</option><option value="good">Good</option><option value="damaged">Damaged</option><option value="quarantine">Quarantine</option></select><% } %><button>Execute &amp; complete</button></form><% } %></div></td></tr><% }) %></tbody></table><% if(queuePages?.tasks){%><div class="server-pager"><small>Showing <%=queuePages.tasks.count%> of <%=queuePages.tasks.total%> tasks</small><% if(queuePages.tasks.hasMore){%><a class="outline-button" href="/operations/logistics?tasksAfter=<%=encodeURIComponent(queuePages.tasks.next)%>">Older tasks</a><%}%></div><%}%></article>
  </section>
<% } %>
</main>
<% if(mode==='delivery'){ %><script src="/delivery-offline.js" defer></script><% } %>
<script src="/operations-ui.js" defer></script>
</body>
</html>
