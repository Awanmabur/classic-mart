<!DOCTYPE html>

<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<meta content="Complete your Classic Mart order through Cart, Checkout and Confirm steps." name="description"/>
<meta content="#ff6500" name="theme-color"/>
<title>Cart &amp; Checkout — Classic Mart</title>
<link href="/styles.css" rel="stylesheet"/>
<link href="/storefront-pages.css" rel="stylesheet"/>
</head>
<body class="storefront-page checkout-page">
<a class="skip-link" href="#cartContent">Skip to checkout</a><div class="utility-bar">
<div class="container utility-inner">
<button class="utility-location text-button" data-open="locationModal" type="button">
<img alt="" aria-hidden="true" src="/assets/icons/location-dot.svg"/>
        Deliver to <strong id="deliveryLocation"><%= deliveryLocation || country?.name || "Uganda" %></strong>
</button>
<div class="shipping-note">
<img alt="" aria-hidden="true" src="/assets/icons/truck-fast.svg"/>
<strong>Delivery pricing</strong> calculated for your country at checkout
      </div>
<nav aria-label="Utility navigation" class="utility-links">
<a class="text-button" href="/signup?role=seller">Sell on Classic Mart</a>
<a class="text-button utility-text-link" href="/sellers">Seller Center</a><a class="text-button utility-text-link" href="/promoters">Promoters Center</a>
<a class="text-button" href="/track-order">Track Order</a>
<a class="text-button" href="/help">Help &amp; Support</a>
<button aria-expanded="false" class="language-button" id="languageButton" type="button">
<img alt="" aria-hidden="true" src="/assets/icons/globe.svg"/> <%= country?.locale?.split("-")[0].toUpperCase() || "EN" %> | <%= currency || country?.currency || "UGX" %>
          <img alt="" aria-hidden="true" class="tiny-icon" src="/assets/icons/chevron-down.svg"/>
</button>
</nav>
</div>
</div><header class="site-header" id="top">
<div class="container header-main">
<a aria-label="Classic Mart home" class="brand" href="/#top">
<img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/>
<small>Everything, for everyone</small>
</a>
<form class="search-bar" id="searchForm" role="search">
<label class="sr-only" for="searchCategory">Product category</label>
<select aria-label="Product category" class="category-select" id="searchCategory">
<option value="all">Loading categories…</option>
</select>
<label class="sr-only" for="searchInput">Search products</label>
<input autocomplete="off" id="searchInput" placeholder="Search for products, brands and more..." type="search"/>
<div class="search-tool-actions" aria-label="Alternative search options">
<button aria-label="Search by image" class="search-tool-button" data-image-search type="button" title="Search by image"><img alt="" aria-hidden="true" src="/assets/icons/camera.svg"/></button>
<button aria-label="Search by voice" class="search-tool-button" data-voice-search type="button" title="Search by voice"><img alt="" aria-hidden="true" src="/assets/icons/microphone.svg"/></button>
<input accept="image/jpeg,image/png,image/webp,image/avif" class="sr-only" data-image-search-input type="file"/>
</div>
<button class="search-button" type="submit">
<img alt="" aria-hidden="true" src="/assets/icons/magnifying-glass.svg"/><span>Search</span>
</button>
<div aria-label="Search suggestions" class="search-suggestions" id="searchSuggestions" role="listbox"></div>
</form>
<div class="header-actions">
<a aria-label="Open your Classic Mart profile" class="header-action header-action-link" href="/dashboard">
<span class="header-action-icon"><img alt="" aria-hidden="true" src="/assets/icons/user.svg"/></span>
<span class="header-action-copy"><small>Your account</small><strong>Profile</strong></span>
<img alt="" aria-hidden="true" class="header-chevron" src="/assets/icons/chevron-right.svg"/>
</a>
<a aria-label="Open your wishlist" class="header-action wishlist-trigger" href="/wishlist"><span class="header-action-icon"><img alt="" aria-hidden="true" src="/assets/icons/heart-regular.svg"/></span><span class="header-action-copy"><small>Saved items</small><strong>Wishlist</strong></span><b class="count-badge wishlist-count-badge" data-wishlist-count="">0</b></a><a aria-label="Open your full cart and checkout" class="header-action cart-trigger" href="/cart" id="cartTrigger">
<span class="header-action-icon"><img alt="" aria-hidden="true" src="/assets/icons/cart-shopping.svg"/></span>
<span class="header-action-copy"><small>Your basket</small><strong>Cart</strong></span>
<b class="count-badge" id="cartCount">0</b>
</a>
</div>
</div>
<div class="nav-shell">
<div class="container nav-inner">
<button aria-controls="categoryPanel" aria-expanded="false" class="browse-button" id="menuToggle" type="button">
<img alt="" aria-hidden="true" src="/assets/icons/bars.svg"/>
<span>Browse Categories</span>
<img alt="" aria-hidden="true" class="browse-chevron" src="/assets/icons/chevron-down.svg"/>
</button>
<nav aria-label="Primary navigation" class="primary-nav" id="primaryNav">
<span class="primary-nav-main">
<a class="active" href="/#top">Home</a>
<a href="/categories">Categories <span class="tiny-badge">—</span></a>
<a href="/products?view=deals">Flash Deals <span class="hot-badge">HOT</span></a>
<a href="/products?view=new">New Arrivals</a>
<a href="/products?view=brands">Top Brands</a>
<a href="/#features">Features <img alt="" aria-hidden="true" src="/assets/icons/chevron-down.svg"/></a>
<a href="/wishlist">Wishlist</a><a href="/compare">Compare</a></span>
<span aria-label="Featured marketplace links" class="primary-nav-end">
<a href="/products?view=deals">Best Deals</a>
<a class="classic-live-link" href="/products?view=fresh"><span aria-hidden="true" class="live-dot"></span>Classic Live</a>
</span>
</nav>
<button aria-label="Open search" class="mobile-search-button" id="mobileSearchButton" type="button">
<img alt="" aria-hidden="true" src="/assets/icons/magnifying-glass.svg"/>
</button>
</div>
</div>
</header>
<main class="checkout-main page-shell" id="cartContent">
<header class="checkout-heading">
<div>
<span>Secure order flow</span>
<h1>Complete your purchase.</h1>
</div>
<p>Review your basket, add delivery and payment details, then confirm everything before placing the order.</p>
</header>
<nav aria-label="Checkout progress" class="checkout-steps">
<button aria-current="step" class="checkout-step active" data-step-jump="1" type="button">
<b>1</b><span><strong>Cart</strong><small>Review items</small></span>
</button>
<span aria-hidden="true" class="checkout-step-line"></span>
<button class="checkout-step" data-step-jump="2" disabled="" type="button">
<b>2</b><span><strong>Checkout</strong><small>Delivery &amp; payment</small></span>
</button>
<span aria-hidden="true" class="checkout-step-line"></span>
<button class="checkout-step" data-step-jump="3" disabled="" type="button">
<b>3</b><span><strong>Confirm</strong><small>Place order</small></span>
</button>
</nav>
<section aria-labelledby="cartStepTitle" class="checkout-screen active" data-checkout-screen="1">
<div class="cart-page-grid">
<section aria-labelledby="cartStepTitle" class="cart-page-card">
<div class="cart-card-head">
<div><span class="checkout-card-kicker">Step 1 of 3</span><h2 id="cartStepTitle">Shopping Cart</h2><p id="cartPageCount">0 items in your cart</p></div>
<button class="clear-cart-button" id="clearCartButton" type="button">Clear cart</button>
</div>
<div class="cart-page-items" id="cartPageItems"></div>
<div class="cart-empty-page" hidden="" id="cartEmptyPage">
<span class="cart-empty-icon"><img alt="" src="/assets/icons/cart-shopping.svg"/></span>
<h2>Your cart is ready for something good.</h2>
<p>Explore products, compare details and add the items you want to order.</p>
<a href="/#trending">Start shopping</a>
</div>
</section>
<aside aria-labelledby="cartSummaryTitle" class="cart-page-card cart-summary-card">
<div class="cart-card-head"><div><span class="checkout-card-kicker">Order total</span><h2 id="cartSummaryTitle">Summary</h2><p>Clear costs before checkout</p></div></div>
<div class="cart-summary-body">
<div class="cart-summary-row"><span>Subtotal</span><strong data-total-subtotal="">$0.00</strong></div>
<div class="cart-summary-row"><span>Shipping</span><strong data-total-shipping="">Free</strong></div>
<div class="cart-summary-row discount-summary-row" hidden=""><span>Discount</span><strong data-total-discount="">−$0.00</strong></div>
<div class="cart-summary-row total"><span>Total</span><strong data-total-final="">$0.00</strong></div>
<form class="cart-coupon" id="couponForm">
<label for="couponInput">Have a promoter / campaign code?</label>
<div class="cart-coupon-wrap"><input autocomplete="off" id="couponInput" placeholder="Enter promoter code" type="text"/><button type="submit">Apply</button></div>
<p class="cart-coupon-status" id="couponStatus" role="status"></p>
</form>
<button class="checkout-primary-button" id="goToCheckout" type="button"><span>Continue to Checkout</span><img alt="" src="/assets/icons/chevron-right.svg"/></button>
<a class="checkout-secondary-link" href="/#trending"><img alt="" src="/assets/icons/chevron-left.svg"/>Continue shopping</a>
<div class="cart-security">
<div><span><img alt="" src="/assets/icons/lock.svg"/></span><div><strong>Secure checkout</strong><small>Protected payment and buyer support.</small></div></div>
<div><span><img alt="" src="/assets/icons/rotate-left.svg"/></span><div><strong>7 days return policy</strong><small>Simple return request from your account.</small></div></div>
<div><span><img alt="" src="/assets/icons/truck-fast.svg"/></span><div><strong>Configured shipping rates</strong><small>Shipping is calculated on the server for your country, city and fulfilment choice.</small></div></div>
</div>
</div>
</aside>
</div>
<section aria-labelledby="recommendTitle" class="cart-recommended" id="cartRecommendations">
<div class="cart-recommended-head"><div><h2 id="recommendTitle">You may also like</h2><p>Add a useful extra without leaving your cart.</p></div></div>
<div class="cart-recommended-grid" id="cartRecommendedGrid"></div>
</section>
</section>
<section aria-labelledby="checkoutStepTitle" class="checkout-screen" data-checkout-screen="2" hidden="">
<form id="checkoutDetailsForm" novalidate="">
<div class="checkout-layout">
<div class="checkout-form-stack">
<section class="checkout-panel-card">
<div class="checkout-panel-head"><span>Step 2 of 3</span><div><h2 id="checkoutStepTitle">Contact &amp; delivery</h2><p>Tell us where the order should go and how to contact you.</p></div></div>
<div class="checkout-fields-grid">
<label class="checkout-field full"><span>Full name</span><input autocomplete="name" id="checkoutName" name="name" placeholder="Your full name" required="" type="text"/></label>
<label class="checkout-field"><span>Email address</span><input autocomplete="email" id="checkoutEmail" name="email" placeholder="you@example.com" required="" type="email"/></label>
<label class="checkout-field"><span>Phone number</span><input autocomplete="tel" id="checkoutPhone" name="phone" placeholder="e.g. +256 700 000 000" required="" type="tel"/></label>
<label class="checkout-field full"><span>Street address</span><input autocomplete="street-address" id="checkoutAddress" name="address" placeholder="Building, street and area" required="" type="text"/></label>
<label class="checkout-field"><span>City / town</span><input autocomplete="address-level2" id="checkoutCity" name="city" placeholder="Kampala" required="" type="text"/></label>
<label class="checkout-field"><span>Country</span><select id="checkoutCountry" name="country" required><option value="<%=country?.name||'Uganda'%>"><%=country?.name||'Uganda'%></option></select></label>
<label class="checkout-field full"><span>Delivery note <small>(optional)</small></span><textarea id="checkoutNote" name="note" placeholder="Landmark, preferred delivery time or special instructions" rows="3"></textarea></label>
</div>
</section>
<section class="checkout-panel-card">
<div class="checkout-panel-head compact"><span>Delivery</span><div><h2>Choose a delivery method</h2><p>The final delivery estimate appears on your confirmation.</p></div></div>
<div class="checkout-choice-list">
<label class="checkout-choice active"><input checked="" name="delivery" type="radio" value="standard"/><span class="choice-icon"><img alt="" src="/assets/icons/truck-fast.svg"/></span><span><strong>Standard delivery</strong><small>Availability, fee and SLA are calculated for your city</small></span><b>Server quote</b></label>
<label class="checkout-choice"><input name="delivery" type="radio" value="express"/><span class="choice-icon"><img alt="" src="/assets/icons/bolt.svg"/></span><span><strong>Express delivery</strong><small>Only shown as available when configured for your city</small></span><b>Server quote</b></label>
<label class="checkout-choice"><input name="delivery" type="radio" value="pickup"/><span class="choice-icon"><img alt="" src="/assets/icons/store.svg"/></span><span><strong>Store pickup</strong><small>Collect from a selected Classic Mart point</small></span><b>Free</b></label>
</div>
<div class="checkout-fields-grid" id="pickupPointFields" hidden=""><label class="checkout-field full"><span>Pickup point</span><select id="checkoutPickupPoint" name="pickupPoint"><option value="">Choose a pickup point</option></select><small id="pickupPointHelp">Pickup points are loaded from Classic Mart operations.</small></label></div>
</section>
<section class="checkout-panel-card">
<div class="checkout-panel-head compact"><span>Payment</span><div><h2>Select a payment method</h2><p>Choose how you want to pay. Online payment is completed through the configured hosted provider and verified by Classic Mart before the order is marked paid.</p></div></div>
<div aria-label="Payment method" class="payment-tabs" role="radiogroup">
<label class="payment-tab active"><input checked="" name="payment" type="radio" value="card"/><img alt="" src="/assets/icons/credit-card.svg"/><span>Card</span></label>
<label class="payment-tab"><input name="payment" type="radio" value="mobile"/><img alt="" src="/assets/icons/mobile-screen-button.svg"/><span>Mobile money</span></label>
<label class="payment-tab"><input name="payment" type="radio" value="cod"/><img alt="" src="/assets/icons/basket-shopping.svg"/><span>Cash on delivery</span></label>
</div>
<div class="payment-details" data-payment-panel="card">
<div class="cash-notice"><img alt="" src="/assets/icons/lock.svg"/><div><strong>Card details are not collected here</strong><small>Card details are entered only on the hosted payment-provider page. Classic Mart verifies the provider transaction before marking the order paid.</small></div></div>
</div>
<div class="payment-details" data-payment-panel="mobile" hidden="">
<div class="cash-notice"><img alt="" src="/assets/icons/mobile-screen-button.svg"/><div><strong>Mobile Money payment follows order creation</strong><small>No wallet PIN or payment credential is stored by Classic Mart in this checkout.</small></div></div>
</div>
<div class="payment-details" data-payment-panel="cod" hidden="">
<div class="cash-notice"><img alt="" src="/assets/icons/circle-check.svg"/><div><strong>Pay when your order arrives</strong><small>COD remains subject to country, delivery-area and order eligibility checks.</small></div></div>
</div>
<label class="checkout-checkbox"><input checked="" id="billingSame" type="checkbox"/><span>Billing address is the same as the delivery address.</span></label>
</section>
</div>
<aside class="checkout-order-card">
<div class="checkout-order-head"><span>Order summary</span><strong id="checkoutItemCount">0 items</strong></div>
<div class="checkout-mini-items" id="checkoutMiniItems"></div>
<div class="checkout-order-totals">
<div><span>Subtotal</span><strong data-total-subtotal="">$0.00</strong></div>
<div><span>Shipping</span><strong data-total-shipping="">Free</strong></div>
<div class="discount-summary-row" hidden=""><span>Discount</span><strong data-total-discount="">−$0.00</strong></div>
<div class="grand"><span>Total</span><strong data-total-final="">$0.00</strong></div>
</div>
<div class="checkout-navigation vertical">
<button class="checkout-primary-button" id="goToConfirm" type="submit"><span>Review &amp; Confirm</span><img alt="" src="/assets/icons/chevron-right.svg"/></button>
<button class="checkout-back-button" data-checkout-prev="1" type="button"><img alt="" src="/assets/icons/chevron-left.svg"/>Back to Cart</button>
</div>
</aside>
</div>
</form>
</section>
<section aria-labelledby="confirmStepTitle" class="checkout-screen" data-checkout-screen="3" hidden="">
<div class="confirm-layout">
<div class="confirm-stack">
<section class="checkout-panel-card confirm-hero-card">
<span class="confirm-lock"><img alt="" src="/assets/icons/lock.svg"/></span>
<div><span>Step 3 of 3</span><h2 id="confirmStepTitle">Confirm your order.</h2><p>Check your products, delivery details and payment choice. You can go back and edit anything before placing the order.</p></div>
</section>
<section class="checkout-panel-card">
<div class="confirm-section-head"><div><span>Products</span><h3>Your items</h3></div><button data-checkout-prev="1" type="button">Edit cart</button></div>
<div class="confirm-items" id="confirmItems"></div>
</section>
<div class="confirm-info-grid">
<section class="checkout-panel-card">
<div class="confirm-section-head"><div><span>Delivery</span><h3>Shipping details</h3></div><button data-checkout-prev="2" type="button">Edit</button></div>
<div class="confirm-detail" id="confirmDelivery"></div>
</section>
<section class="checkout-panel-card">
<div class="confirm-section-head"><div><span>Payment</span><h3>Payment method</h3></div><button data-checkout-prev="2" type="button">Edit</button></div>
<div class="confirm-detail" id="confirmPayment"></div>
</section>
</div>
</div>
<aside class="checkout-order-card confirm-order-card">
<div class="checkout-order-head"><span>Final total</span><strong>Ready to place</strong></div>
<div class="checkout-order-totals">
<div><span>Subtotal</span><strong data-total-subtotal="">$0.00</strong></div>
<div><span>Shipping</span><strong data-total-shipping="">Free</strong></div>
<div class="discount-summary-row" hidden=""><span>Discount</span><strong data-total-discount="">−$0.00</strong></div>
<div class="grand"><span>Total</span><strong data-total-final="">$0.00</strong></div>
</div>
<label class="checkout-checkbox confirm-terms"><input id="confirmTerms" type="checkbox"/><span>I confirm that the order details are correct and agree to the marketplace terms.</span></label>
<p class="confirm-error" id="confirmError" role="alert"></p>
<button class="checkout-primary-button place-order-button" id="placeOrderButton" type="button"><img alt="" src="/assets/icons/lock.svg"/><span>Place Order</span></button>
<button class="checkout-back-button" data-checkout-prev="2" type="button"><img alt="" src="/assets/icons/chevron-left.svg"/>Back to Checkout</button>
<div class="confirm-security-note"><img alt="" src="/assets/icons/circle-check.svg"/><span><strong>Protected checkout</strong><small>Order creation is server-authoritative. Card or Mobile Money is never marked paid without provider verification.</small></span></div>
</aside>
</div>
</section>
</main>
<div aria-live="polite" class="page-toast" id="pageToast" role="status"></div>
<section class="newsletter">
<div class="container newsletter-inner">
<div class="newsletter-message"><span><img alt="" src="/assets/icons/envelope.svg"/></span><div><strong>Stay in the Loop!</strong><small>Get exclusive deals, new arrivals and shopping tips.</small></div></div>
<form class="newsletter-form" data-newsletter-form id="newsletterForm" novalidate>
<label class="sr-only" for="newsletterEmail">Email address</label>
<input autocomplete="email" id="newsletterEmail" maxlength="254" name="email" placeholder="Enter your email address" required type="email"/>
<button type="submit">Subscribe</button>
<p aria-live="polite" class="newsletter-status" data-newsletter-status></p>
</form>
<div class="newsletter-perks"><span><img alt="" src="/assets/icons/percent.svg"/><b>Exclusive Deals</b></span><span><img alt="" src="/assets/icons/gift.svg"/><b>New Arrivals</b></span><span><img alt="" src="/assets/icons/location-dot.svg"/><b>Shopping Tips</b></span></div>
</div>
</section><footer class="site-footer">
<div class="container footer-grid">
<div class="footer-about">
<a class="brand footer-brand" href="/#top"><img class="brand-logo" src="/assets/classic-mart-logo.png" alt="Classic Mart"/></a>
<p>Your one-stop marketplace for products from trusted sellers, with secure checkout and customer support.</p>
<div class="socials" aria-label="Official Classic Mart social channels are not published yet"><span aria-label="Facebook channel not published" title="Official Facebook channel not published yet"><img alt="" src="/assets/icons/facebook-f.svg"/></span><span aria-label="X channel not published" title="Official X channel not published yet"><img alt="" src="/assets/icons/x-twitter.svg"/></span><span aria-label="Instagram channel not published" title="Official Instagram channel not published yet"><img alt="" src="/assets/icons/instagram.svg"/></span><span aria-label="YouTube channel not published" title="Official YouTube channel not published yet"><img alt="" src="/assets/icons/youtube.svg"/></span><span aria-label="Pinterest channel not published" title="Official Pinterest channel not published yet"><img alt="" src="/assets/icons/pinterest.svg"/></span></div>
</div>
<div><h3>Shop</h3><a href="/categories">All Categories</a><a href="/products?view=deals">Flash Deals</a><a href="/products?view=new">New Arrivals</a><a href="/products?view=brands">Top Brands</a><a class="footer-link" href="/signup?role=seller">Sell on Classic Mart</a><a href="/sellers">Browse Sellers</a><a href="/promoters">Promoters Center</a><a href="/wishlist">My Wishlist</a><a href="/dashboard">My Profile</a></div>
<div><h3>Customer Service</h3><a class="footer-link" href="/help">Help Center</a><a class="footer-link" href="/track-order">Track Order</a><a class="footer-link" href="/returns">Returns &amp; Refunds</a><a class="footer-link" href="/shipping">Shipping Info</a><a class="footer-link" href="/contact">Contact Us</a></div>
<div><h3>About Us</h3><a class="footer-link" href="/about">About Classic Mart</a><a class="footer-link" href="/careers">Careers</a><a class="footer-link" href="/press">Press &amp; News</a><a class="footer-link" href="/sellers">Seller Center</a></div>
<div><h3>Policies</h3><a class="footer-link" href="/privacy">Privacy Policy</a><a class="footer-link" href="/terms">Terms of Service</a><a class="footer-link" href="/cookies">Cookie Policy</a><a class="footer-link" href="/payments">Payment Policy</a></div>
<div class="app-download"><h3>Classic Mart App</h3><p>Install the secure Classic Mart PWA for an app-like experience using the same live marketplace data.</p><a class="app-badge" href="/app"><img alt="" src="/assets/icons/mobile-screen-button.svg"/><span>INSTALL<strong>Classic Mart</strong></span></a></div>
</div>
<div class="container footer-bottom"><span>© 2026 Classic Mart. All rights reserved.</span><span>Secure payments · Buyer protection · Trusted sellers</span></div>
</footer><%- include("partials/product-preview-modal") %>
<script src="/cart-store.js"></script>
<script src="/product-preview.js"></script>
<script src="/cart-page.js"></script>
<script src="/shared-shell.js"></script><script src="/image-fallback.js"></script><script src="/country-switcher.js"></script><script src="/search-tools.js"></script><script src="/newsletter.js"></script></body>
</html>
