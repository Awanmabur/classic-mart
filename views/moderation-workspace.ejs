<!DOCTYPE html>
<html lang="en" data-low-data="<%= user?.preferences?.lowData ? 'true' : 'false' %>">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
  <meta content="#1165df" name="theme-color"/>
  <title>Moderation Workspace — Classic Mart</title>
  <link href="/dashboard.css" rel="stylesheet"/>
  <link href="/dashboard-workspaces.css" rel="stylesheet"/>
  <link href="/server-ui.css" rel="stylesheet"/>
  <link href="/catalog-workspace.css" rel="stylesheet"/>
</head>
<body data-operations-ui="true" data-workspace="<%= user.role %>">
  <svg aria-hidden="true" class="svg-sprite">
    <symbol id="i-cart" viewBox="0 0 24 24"><path d="M3 4h2l2.1 10.2a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 1.9-1.4L21 8H7"/><circle cx="10" cy="20" r="1.35"/><circle cx="18" cy="20" r="1.35"/></symbol>
    <symbol id="i-grid" viewBox="0 0 24 24"><rect x="4" y="4" width="5" height="5" rx="1"/><rect x="15" y="4" width="5" height="5" rx="1"/><rect x="4" y="15" width="5" height="5" rx="1"/><rect x="15" y="15" width="5" height="5" rx="1"/></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></symbol>
    <symbol id="i-box" viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4-8-4Z"/><path d="M4 7v10l8 4 8-4V7M12 11v10"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></symbol>
    <symbol id="i-home" viewBox="0 0 24 24"><path d="m3 11 9-8 9 8"/><path d="M5 10v11h14V10M9 21v-7h6v7"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
    <symbol id="i-logout" viewBox="0 0 24 24"><path d="M10 4H5v16h5M14 8l4 4-4 4M8 12h10"/></symbol>
  </svg>
  <div class="app-shell">
    <header class="topbar"><div class="brand-area"><button aria-label="Open navigation" class="round-icon mobile-menu" id="mobileMenuBtn"><svg><use href="#i-menu"></use></svg></button><a class="brand" href="/dashboard"><svg class="brand-cart"><use href="#i-cart"></use></svg><span class="brand-copy"><strong>Classic Mart</strong><small>Everything, for everyone</small></span></a></div><div class="server-workspace-title"><span>Trust workspace</span><strong><%= roleLabel(user.role) %></strong></div><div class="top-spacer"></div><div class="top-actions"><a class="categories-button" href="/"><svg><use href="#i-home"></use></svg><span>Marketplace</span></a><a class="profile-button" href="/account/profile"><span class="server-avatar"><%= user.name.split(/\s+/).slice(0,2).map(part => part[0]).join('').toUpperCase() %></span><span><strong>Hi, <%= user.name.split(' ')[0] %></strong><small><%= roleLabel(user.role) %></small></span></a></div></header>
    <aside class="sidebar" id="sidebar"><nav class="side-navigation"><p class="nav-section-label">Account</p><a class="side-link" href="/dashboard"><svg><use href="#i-grid"></use></svg><span>Overview</span></a><p class="nav-section-label">Moderation</p><a class="side-link <%= ['products','product-detail'].includes(view.section) ? 'active' : '' %>" href="/moderation/products"><svg><use href="#i-box"></use></svg><span>Product Queue</span></a><a class="side-link <%= ['verifications','verification-detail'].includes(view.section) ? 'active' : '' %>" href="/moderation/verifications"><svg><use href="#i-shield"></use></svg><span>Seller Verification</span></a><a class="side-link <%= view.section === 'qa' ? 'active' : '' %>" href="/moderation/qa"><svg><use href="#i-shield"></use></svg><span>QA Sampling</span></a><a class="side-link <%= view.section === 'catalogue-settings' ? 'active' : '' %>" href="/moderation/catalogue"><svg><use href="#i-grid"></use></svg><span>Catalogue Settings</span></a></nav><section class="sidebar-club-card"><span class="sidebar-crown"><svg><use href="#i-shield"></use></svg></span><h3>Server-Enforced Review</h3><p class="member-copy"><%= user.role === 'country_admin' ? `${user.country} scope` : 'Platform scope' %></p><p>Every decision records its actor, reason, time and target in the audit trail.</p></section><form action="/logout" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><button class="logout-button" type="submit"><svg><use href="#i-logout"></use></svg><span>Log Out</span></button></form></aside>
    <button aria-label="Close navigation" class="sidebar-overlay" id="sidebarOverlay"></button>
    <main class="dashboard page-host">
      <% if (flash) { %><div class="server-flash <%= flash.type %>" role="status"><strong><%= flash.message %></strong></div><% } %>
      <% if (view.section === 'products') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow">Trust and safety</span><h1>Product Moderation</h1><p>Review seller content and sanitized media before publication.</p></div></div>
        <nav aria-label="Moderation status" class="role-status-tabs"><% ['submitted','approved','changes_requested'].forEach(status => { %><a class="<%= view.status === status ? 'active' : '' %>" href="/moderation/products?status=<%= status %>"><%= status.replaceAll('_',' ') %></a><% }); %></nav>
        <section class="panel role-table-panel"><div class="role-panel-head"><div><h2>Review queue</h2><p>Oldest submissions appear first.</p></div><span class="role-status warn"><%= view.queuePage?.total ?? view.products.length %> records</span></div><form method="get" action="/moderation/products" class="catalog-form"><input type="hidden" name="status" value="<%=view.status%>"><label>Search<input name="search" value="<%=view.filters?.search||''%>" placeholder="Product or ID"></label><label>Assignment<select name="assignment"><option value="">All</option><option value="mine" <%=view.filters?.assignment==='mine'?'selected':''%>>Mine</option><option value="unassigned" <%=view.filters?.assignment==='unassigned'?'selected':''%>>Unassigned</option></select></label><label>Risk<select name="risk"><option value="">All</option><option value="restricted" <%=view.filters?.risk==='restricted'?'selected':''%>>Restricted category</option></select></label><label><input type="checkbox" name="secondReview" value="1" <%=view.filters?.secondReview?'checked':''%>> Second review</label><label><input type="checkbox" name="escalated" value="1" <%=view.filters?.escalated?'checked':''%>> Escalated</label><button type="submit">Filter</button></form><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Product</th><th>Store</th><th>Country</th><th>Category</th><th>Quality</th><th></th></tr></thead><tbody><% view.products.forEach(product => { %><tr><td><span><%= product.title %></span><small class="catalogue-table-id"><%= product.publicId %></small><small><%= product.moderation?.secondReviewRequired ? 'SECOND REVIEW · ' : '' %><%= product.moderation?.escalatedAt ? 'ESCALATED · ' : '' %><%= product.moderation?.assignedUserId?.name ? `Assigned ${product.moderation.assignedUserId.name}` : 'Unassigned' %></small></td><td><%= product.storeId?.name || 'Unavailable' %></td><td><%= product.storeId?.country || '—' %></td><td><%= product.categoryId?.name || 'Unavailable' %><%= product.categoryId?.restricted ? ' · restricted' : '' %></td><td><%= product.qualityScore %>%</td><td><a class="outline-button table-action" href="/moderation/products/<%= product.publicId %>">Review</a></td></tr><% }); %><% if (!view.products.length) { %><tr><td colspan="6"><div class="catalogue-empty">The queue is clear.</div></td></tr><% } %></tbody></table></div><% if(view.queuePage?.hasMore){%><div class="server-pager"><small>Showing <%=view.queuePage.count%> of <%=view.queuePage.total%></small><a class="outline-button" href="/moderation/products?status=<%=encodeURIComponent(view.status)%>&search=<%=encodeURIComponent(view.filters?.search||'')%>&assignment=<%=encodeURIComponent(view.filters?.assignment||'')%>&risk=<%=encodeURIComponent(view.filters?.risk||'')%>&secondReview=<%=view.filters?.secondReview?'1':'0'%>&escalated=<%=view.filters?.escalated?'1':'0'%>&after=<%=encodeURIComponent(view.queuePage.next)%>">Next product records</a></div><%}%></section>
      <% } %>
      <% if (view.section === 'product-detail') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow"><%= view.product.publicId %></span><h1><%= view.product.title %></h1><p><%= view.product.storeId?.name %> · <%= view.product.storeId?.country %> · quality <%= view.product.qualityScore %>%</p></div><a class="outline-button" href="/moderation/products">Back to Queue</a></div>
        <div class="role-content-grid catalogue-two-column"><div class="catalogue-stack"><section class="panel role-form-section"><div class="role-panel-head"><div><h2>Catalogue content</h2><p><%= view.product.categoryId?.name %><%= view.product.categoryId?.restricted ? ' · restricted category' : '' %></p></div><span class="role-status warn"><%= view.product.status.replaceAll('_',' ') %></span></div><div class="catalogue-review-content"><h3><%= view.product.title %></h3><p><%= view.product.description %></p><div><% view.product.tags.forEach(tag => { %><span><%= tag %></span><% }); %></div></div></section><section class="panel role-form-section"><div class="role-panel-head"><div><h2>Variants</h2><p>SKU, price, currency and activation state.</p></div></div><div class="catalogue-variant-list"><% view.variants.forEach(variant => { %><article><div><strong><%= variant.title %></strong><small><%= variant.sku %></small></div><span><%= formatMoney(variant.priceMinor, variant.currency) %></span><span class="role-status <%= variant.active ? 'good' : 'neutral' %>"><%= variant.active ? 'active' : 'inactive' %></span></article><% }); %></div></section><section class="panel role-form-section"><div class="role-panel-head"><div><h2>Sanitized media</h2><p>Only decoded and re-encoded raster images reach this queue.</p></div></div><div class="catalogue-media-grid"><% view.media.forEach(media => { %><figure><img alt="<%= media.altText %>" loading="lazy" src="/media/catalogue/<%= media.publicId %>?size=thumb"/><figcaption><span><%= media.altText %></span><strong class="role-status warn"><%= media.status %></strong></figcaption></figure><% }); %></div></section></div><aside class="panel role-publish-card"><h2>Moderation ownership</h2><% const productAssignedId=String(view.product.moderation?.assignedUserId?._id||view.product.moderation?.assignedUserId||''); const productAssignedToMe=productAssignedId===String(user._id); const firstReviewerId=String(view.product.moderation?.firstApprovalByUserId?._id||view.product.moderation?.firstApprovalByUserId||''); %><% if(view.product.moderation?.secondReviewRequired){%><div class="catalogue-review-note"><strong>Restricted category · second review required</strong><p>First approval: <%=view.product.moderation?.firstApprovalByUserId?.name||'Recorded reviewer'%>. A different moderator must complete approval.</p></div><%}%><% if(view.product.moderation?.escalationReason){%><div class="catalogue-review-note"><strong>Escalated</strong><p><%=view.product.moderation.escalationReason%></p></div><%}%><% if(view.product.status==='submitted'&&!productAssignedId){%><% if(firstReviewerId===String(user._id)){%><p>You recorded the first approval. A different moderator must claim this second review.</p><%}else{%><form action="/moderation/products/<%=view.product.publicId%>/claim" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"/><button class="primary-button" type="submit">Claim review</button></form><%}%><%}else if(view.product.status==='submitted'&&productAssignedToMe){%><form action="/moderation/products/<%=view.product.publicId%>/release" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"/><button class="outline-button" type="submit">Release review</button></form><form action="/moderation/products/<%=view.product.publicId%>/decision" class="dashboard-form" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"/><label>Decision<select name="decision"><option value="approve"><%=view.product.moderation?.secondReviewRequired?'Complete second approval':'Approve'%></option><option value="changes">Request changes</option><option value="reject">Reject listing</option></select></label><label>Reason template<select name="reasonTemplate"><option value="">Write a custom note</option><% moderationReasonTemplates.forEach(item=>{%><option value="<%=item.id%>"><%=item.label%></option><%})%></select></label><label>Reason or reviewer note<textarea maxlength="1000" name="reason" rows="6" placeholder="Typed text overrides the selected template."></textarea></label><button class="primary-button" type="submit">Record Decision</button></form><form action="/moderation/products/<%=view.product.publicId%>/escalate" class="dashboard-form" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"/><label>Escalation reason<textarea minlength="10" maxlength="1000" name="reason" rows="3" required></textarea></label><button class="outline-button" type="submit">Escalate</button></form><%}else if(view.product.status==='submitted'){%><p>Assigned to <strong><%=view.product.moderation?.assignedUserId?.name||'another moderator'%></strong>. Only that moderator can decide it.</p><%}else{%><div class="catalogue-review-note"><strong>Decision recorded</strong><p><%=view.product.moderation?.reason||'No additional reviewer note.'%></p></div><%}%><% if(view.product.moderation?.reviewHistory?.length){%><div class="catalogue-review-note"><strong>Decision history</strong><% view.product.moderation.reviewHistory.slice().reverse().slice(0,8).forEach(row=>{%><p><%=row.action.replaceAll('_',' ')%> · <%=row.actorUserId?.name||'operator'%> · <%=formatDate(row.at)%><%=row.reason?` · ${row.reason}`:''%></p><%})%></div><%}%></aside></div>
      <% } %>
      <% if (view.section === 'verifications') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow">KYC and KYB</span><h1>Seller Verification</h1><p>Review private seller records within your authorized country scope.</p></div></div>
        <section class="panel role-table-panel"><div class="role-panel-head"><div><h2>Verification queue</h2><p>Submitted, appealed and completed records.</p></div><span class="role-status warn"><%= view.queuePage?.total ?? view.verifications.length %> records</span></div><form method="get" action="/moderation/verifications" class="catalog-form"><label>Search<input name="search" value="<%=view.filters?.search||''%>" placeholder="Seller or ID"></label><label>Status<select name="status"><option value="">All</option><% ['submitted','appealed','approved','rejected'].forEach(v=>{%><option value="<%=v%>" <%=view.filters?.status===v?'selected':''%>><%=v%></option><%})%></select></label><label>Assignment<select name="assignment"><option value="">All</option><option value="mine" <%=view.filters?.assignment==='mine'?'selected':''%>>Mine</option><option value="unassigned" <%=view.filters?.assignment==='unassigned'?'selected':''%>>Unassigned</option></select></label><label>Risk<select name="risk"><option value="">All</option><option value="business" <%=view.filters?.risk==='business'?'selected':''%>>Business KYB</option></select></label><label><input type="checkbox" name="escalated" value="1" <%=view.filters?.escalated?'checked':''%>> Escalated</label><button type="submit">Filter</button></form><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Seller</th><th>Store</th><th>Type</th><th>Country</th><th>Status</th><th></th></tr></thead><tbody><% view.verifications.forEach(item => { %><tr><td><span><%= item.userId?.name || 'Unavailable' %></span><small class="catalogue-table-id"><%= item.publicId %></small><small><%= item.escalatedAt ? 'ESCALATED · ' : '' %><%= item.assignedUserId?.name ? `Assigned ${item.assignedUserId.name}` : 'Unassigned' %></small></td><td><%= item.storeId?.name || 'Unavailable' %></td><td><%= item.sellerType %></td><td><%= item.storeId?.country || '—' %></td><td><span class="role-status <%= item.status === 'approved' ? 'good' : item.status === 'rejected' ? 'bad' : 'warn' %>"><%= item.status %></span></td><td><a class="outline-button table-action" href="/moderation/verifications/<%= item.publicId %>">Review</a></td></tr><% }); %><% if (!view.verifications.length) { %><tr><td colspan="6"><div class="catalogue-empty">No verification records in scope.</div></td></tr><% } %></tbody></table></div><% if(view.queuePage?.hasMore){%><div class="server-pager"><small>Showing <%=view.queuePage.count%> of <%=view.queuePage.total%></small><a class="outline-button" href="/moderation/verifications?status=<%=encodeURIComponent(view.filters?.status||'')%>&search=<%=encodeURIComponent(view.filters?.search||'')%>&assignment=<%=encodeURIComponent(view.filters?.assignment||'')%>&risk=<%=encodeURIComponent(view.filters?.risk||'')%>&escalated=<%=view.filters?.escalated?'1':'0'%>&after=<%=encodeURIComponent(view.queuePage.next)%>">Next verification records</a></div><%}%></section>
      <% } %>
      <% if (view.section === 'catalogue-settings') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow">Database reference data</span><h1>Catalogue Settings</h1><p>Categories, attributes and brand requests are managed here—not in static browser files.</p></div></div>
        <div class="role-content-grid catalogue-two-column"><section class="panel role-table-panel"><div class="role-panel-head"><div><h2>Categories and attributes</h2><p><%= view.categories.length %> database-owned categories in scope.</p></div></div><div class="catalogue-settings-list"><% view.categories.forEach(category => { %><article><div><strong><%= category.name %></strong><small><%= category.countries.length ? category.countries.join(', ') : 'All countries' %> · <%= category.attributes.length %> attributes</small></div><span class="role-status <%= category.active ? 'good' : 'neutral' %>"><%= category.active ? 'active' : 'inactive' %></span><% if (view.canManageCategories && (user.role !== 'country_admin' || category.countries.includes(user.country))) { %><form action="/moderation/catalogue/categories/<%= category.publicId %>/toggle" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><button class="outline-button" type="submit"><%= category.active ? 'Deactivate' : 'Activate' %></button></form><% } %></article><% }); %></div></section><aside class="catalogue-stack"><section class="panel role-form-section"><div class="role-panel-head"><div><h2>Pending brands</h2><p>Approve exact seller-submitted brand names.</p></div></div><div class="catalogue-settings-list"><% view.brands.forEach(brand => { %><article><div><strong><%= brand.name %></strong><small><%= brand.requestedByStoreId?.name || 'Unknown store' %> · <%= brand.requestedByStoreId?.country || '—' %></small></div><form action="/moderation/catalogue/brands/<%= brand.publicId %>/decision" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><button class="outline-button" name="decision" type="submit" value="approve">Approve</button><button class="catalogue-danger-button" name="decision" type="submit" value="reject">Reject</button></form></article><% }); %><% if (!view.brands.length) { %><p class="catalogue-empty">No pending brand requests.</p><% } %></div></section><% if (view.canManageCategories) { %><section class="panel role-form-section"><div class="role-panel-head"><div><h2>Create category</h2><p>Country admins create categories only for their country.</p></div></div><form action="/moderation/catalogue/categories" class="role-form-grid" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"/><label>Category name<input maxlength="100" name="name" required/></label><label>Restriction<select name="restricted"><option value="no">Standard</option><option value="yes">Restricted</option></select></label><label class="wide">Description<textarea maxlength="500" minlength="10" name="description" required rows="4"></textarea></label><fieldset class="wide catalogue-country-field"><legend>Country scope (none means global)</legend><div><% view.countries.forEach(item => { %><label><input <%= user.role === 'country_admin' && item.code === user.country ? 'checked disabled' : '' %> name="countries" type="checkbox" value="<%= item.code %>"/><span><%= item.name %></span></label><% }); %></div></fieldset><label class="wide">Attributes, one per line<textarea maxlength="2000" name="attributes" placeholder="color|Color|text|yes&#10;weight|Weight|number|no" rows="5"></textarea></label><button class="primary-button catalogue-form-action" type="submit">Create Category</button></form></section><% } %></aside></div>
      <% } %>
      <% if (view.section === 'verification-detail') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow"><%= view.verification.publicId %></span><h1><%= view.verification.legalName %></h1><p><%= view.verification.storeId?.name %> · <%= view.verification.storeId?.country %> · <%= view.verification.sellerType %></p></div><a class="outline-button" href="/moderation/verifications">Back to Queue</a></div>
        <div class="role-content-grid catalogue-two-column"><div class="catalogue-stack"><section class="panel role-focus-panel"><div class="role-panel-head"><div><h2>Submitted details</h2><p>Sensitive values are only selected on this authorized route.</p></div><span class="role-status <%= view.verification.status === 'approved' ? 'good' : view.verification.status === 'rejected' ? 'bad' : 'warn' %>"><%= view.verification.status %></span></div><div class="server-detail-list"><p><span>Legal name</span><strong><%= view.verification.legalName %></strong></p><p><span>Registration number</span><strong><%= view.verification.registrationNumber || 'Not supplied' %></strong></p><p><span>Tax number</span><strong><%= view.verification.taxNumber || 'Not supplied' %></strong></p><p><span>Account</span><strong><%= view.verification.userId?.email %></strong></p><p><span>Submitted</span><strong><%= formatDate(view.verification.submittedAt) %></strong></p></div></section><section class="panel role-form-section"><div class="role-panel-head"><div><h2>Private documents</h2><p>These links require the same server authorization.</p></div></div><div class="catalogue-document-list"><% view.documents.forEach(document => { %><a href="/media/verification/<%= document.publicId %>" rel="noopener" target="_blank"><span><%= document.documentType %></span><strong>Open sanitized copy</strong></a><% }); %></div></section><% if (view.verification.appeal?.message) { %><section class="catalogue-review-note panel"><strong>Seller appeal</strong><p><%= view.verification.appeal.message %></p></section><% } %></div><aside class="panel role-publish-card"><h2>Verification ownership</h2><% const verificationAssignedId=String(view.verification.assignedUserId?._id||view.verification.assignedUserId||''); const verificationAssignedToMe=verificationAssignedId===String(user._id); %><% if(view.verification.escalationReason){%><div class="catalogue-review-note"><strong>Escalated</strong><p><%=view.verification.escalationReason%></p></div><%}%><% if(['submitted','appealed'].includes(view.verification.status)&&!verificationAssignedId){%><form action="/moderation/verifications/<%=view.verification.publicId%>/claim" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"/><button class="primary-button" type="submit">Claim verification</button></form><%}else if(['submitted','appealed'].includes(view.verification.status)&&verificationAssignedToMe){%><form action="/moderation/verifications/<%=view.verification.publicId%>/release" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"/><button class="outline-button" type="submit">Release verification</button></form><form action="/moderation/verifications/<%=view.verification.publicId%>/decision" class="dashboard-form" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"/><label>Decision<select name="decision"><option value="approve">Approve seller</option><option value="reject">Reject verification</option></select></label><label>Reason template<select name="reasonTemplate"><option value="">Write a custom note</option><% moderationReasonTemplates.forEach(item=>{%><option value="<%=item.id%>"><%=item.label%></option><%})%></select></label><label>Reason or reviewer note<textarea maxlength="1000" name="reason" rows="7" placeholder="Typed text overrides the selected template."></textarea></label><button class="primary-button" type="submit">Record Decision</button></form><form action="/moderation/verifications/<%=view.verification.publicId%>/escalate" class="dashboard-form" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"/><label>Escalation reason<textarea minlength="10" maxlength="1000" name="reason" rows="3" required></textarea></label><button class="outline-button" type="submit">Escalate</button></form><%}else if(['submitted','appealed'].includes(view.verification.status)){%><p>Assigned to <strong><%=view.verification.assignedUserId?.name||'another moderator'%></strong>. Only that moderator can decide it.</p><%}else{%><div class="catalogue-review-note"><strong>Review reason</strong><p><%=view.verification.reviewReason||'No additional note.'%></p></div><%}%><% if(view.verification.reviewHistory?.length){%><div class="catalogue-review-note"><strong>Decision history</strong><% view.verification.reviewHistory.slice().reverse().slice(0,8).forEach(row=>{%><p><%=row.action%> · <%=row.actorUserId?.name||'operator'%> · <%=formatDate(row.at)%><%=row.reason?` · ${row.reason}`:''%></p><%})%></div><%}%></aside></div>
      <% } %>
      <% if (view.section === 'qa') { %>
        <div class="page-heading role-page-heading"><div><span class="eyebrow">Quality assurance</span><h1>Moderation QA Sampling</h1><p>High-risk decisions and a deterministic sample of standard decisions receive an independent second-line quality review.</p></div></div>
        <nav aria-label="QA status" class="role-status-tabs"><a class="<%=view.status==='pending'?'active':''%>" href="/moderation/qa?status=pending">Pending</a><a class="<%=view.status==='completed'?'active':''%>" href="/moderation/qa?status=completed">Completed</a></nav>
        <section class="panel role-table-panel"><div class="role-panel-head"><div><h2>Independent review queue</h2><p>The original reviewer cannot review their own sampled decision.</p></div><span class="role-status warn"><%=view.queuePage?.total ?? view.samples.length%> samples</span></div><div class="role-table-wrap"><table class="role-table"><thead><tr><th>Target</th><th>Country</th><th>Risk</th><th>Decision</th><th>Original reviewer</th><th>QA outcome</th></tr></thead><tbody><% view.samples.forEach(sample=>{%><tr><td><strong><%=sample.targetType.replaceAll('_',' ')%></strong><small class="catalogue-table-id"><%=sample.targetPublicId%></small></td><td><%=sample.country%></td><td><span class="role-status <%=sample.riskLevel==='high'?'bad':'neutral'%>"><%=sample.riskLevel%></span></td><td><%=sample.decision.replaceAll('_',' ')%><% if(sample.decisionReason){%><small><%=sample.decisionReason%></small><%}%></td><td><%=sample.originalReviewerUserId?.name||'Unavailable'%></td><td><% if(sample.status==='pending' && String(sample.originalReviewerUserId?._id||sample.originalReviewerUserId)!==String(user._id)){%><form action="/moderation/qa/<%=sample.publicId%>/review" class="dashboard-form" method="post"><input name="_csrf" type="hidden" value="<%=csrfToken%>"/><select name="outcome"><option value="upheld">Upheld</option><option value="coaching">Coaching needed</option><option value="escalated">Escalate</option></select><input minlength="10" maxlength="1000" name="note" required placeholder="Independent QA note"/><button class="outline-button" type="submit">Record QA</button></form><%}else if(sample.status==='pending'){%><small>Four-eyes required — another moderator must review.</small><%}else{%><strong><%=sample.outcome%></strong><small><%=sample.qaReviewerUserId?.name||'QA reviewer'%> · <%=sample.note%></small><%}%></td></tr><%})%><% if(!view.samples.length){%><tr><td colspan="6"><div class="catalogue-empty">No QA samples in this queue.</div></td></tr><%}%></tbody></table></div><% if(view.queuePage?.hasMore){%><div class="server-pager"><small>Showing <%=view.queuePage.count%> of <%=view.queuePage.total%></small><a class="outline-button" href="/moderation/qa?status=<%=encodeURIComponent(view.status)%>&after=<%=encodeURIComponent(view.queuePage.next)%>">Next QA samples</a></div><%}%></section>
      <% } %>
    </main>
  </div>
  <script src="/dashboard.js"></script>
<script src="/image-fallback.js"></script><script src="/operations-ui.js" defer></script></body>
</html>
