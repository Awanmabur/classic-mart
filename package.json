{
  "name": "classic-mart",
  "version": "2.13.74",
  "private": true,
  "description": "Classic Mart secure MongoDB, Express and EJS marketplace",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "cleanup:legacy-infra": "node scripts/cleanup-legacy-infra.js",
    "db:verify": "node scripts/verify-mongo.js",
    "mongo:ready": "npm run db:verify",
    "db:setup": "npm run setup:external",
    "db:seed": "npm run seed:initial",
    "test": "node scripts/run-tests.js",
    "test:coverage": "node scripts/run-tests.js --coverage",
    "check": "npm run check:release-scripts && npm run check:imports && node scripts/check-project.js",
    "audit:integration": "node scripts/audit-integration.js",
    "release:check": "npm run check && npm run security:check && npm run frontend:audit && npm run functionality:audit && npm test && npm run db:verify && npm run audit:integration && npm run audit:concurrency && npm run browser:check && npm audit --audit-level=high",
    "security:check": "node scripts/security-check.js",
    "security:sbom": "node scripts/security-sbom.js",
    "load:smoke": "node scripts/load-smoke.js",
    "backup:drill": "node scripts/backup-drill.js",
    "launch:check": "node scripts/launch-check.js",
    "check:imports": "node scripts/check-imports.js",
    "check:release-scripts": "node scripts/check-release-scripts.js",
    "frontend:audit": "node scripts/audit-frontend.js",
    "functionality:audit": "node scripts/audit-functionality.js",
    "worker": "node src/worker.js",
    "pesapal:register-ipn": "node scripts/pesapal-register-ipn.js",
    "migrate:plan": "node scripts/migrate-production.js",
    "migrate:apply": "node scripts/migrate-production.js --apply",
    "release:build": "node scripts/build-release.js",
    "audit:concurrency": "node scripts/audit-concurrency.js",
    "browser:check": "playwright test",
    "browser:a11y": "playwright test tests/e2e/accessibility.spec.js",
    "browser:critical": "playwright test tests/e2e/critical-flows.spec.js",
    "browser:install": "playwright install chromium",
    "deploy:smoke": "node scripts/deploy-smoke.js",
    "admin:reset-password": "node scripts/reset-admin-password.js",
    "bootstrap:production": "node scripts/bootstrap-production.js",
    "release:production": "node scripts/build-production-release.js",
    "production:data-check": "node scripts/check-production-data.js",
    "start:production": "node scripts/run-production.js",
    "media:r2:check": "node scripts/check-r2.js",
    "setup:external": "npm run db:verify && npm run media:r2:check && npm run seed:initial",
    "release:clean-app": "node scripts/build-clean-app-release.js",
    "seed:initial": "node scripts/seed-initial-catalogue.js",
    "dev:watch": "node --watch src/server.js",
    "dashboard:preview": "node scripts/serve-exact-dashboard-preview.js",
    "test:customer:live": "node scripts/run-customer-live-tests.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "argon2": "0.45.1",
    "compression": "1.8.1",
    "connect-mongo": "6.0.0",
    "connect-redis": "10.0.0",
    "dotenv": "17.4.2",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "hpp": "0.2.3",
    "mongoose": "9.8.1",
    "multer": "2.3.0",
    "nodemailer": "9.1.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "redis": "6.1.0",
    "sharp": "0.35.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "supertest": "7.2.2"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
