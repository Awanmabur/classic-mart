{
  "name": "classic-mart",
  "version": "2.13.6",
  "private": true,
  "description": "Classic Mart secure MongoDB, Express and EJS marketplace",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run db:local && node --watch src/server.js",
    "start": "node src/server.js",
    "cleanup:legacy-infra": "node scripts/cleanup-legacy-infra.js",
    "db:verify": "node scripts/verify-mongo.js",
    "mongo:ready": "npm run db:verify",
    "db:setup": "npm run db:local && npm run db:verify && node scripts/seed.js",
    "db:seed": "npm run db:local && npm run db:verify && node scripts/seed.js",
    "test": "node --test --test-reporter=spec",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "npm run check:release-scripts && npm run check:imports && node scripts/check-project.js",
    "audit:integration": "node scripts/audit-integration.js",
    "release:check": "npm run check && npm run security:check && npm run frontend:audit && npm run functionality:audit && npm test && npm run db:verify && npm run audit:integration && npm audit --audit-level=high",
    "verify:local": "npm run db:setup && npm run release:check",
    "db:local": "node scripts/ensure-local-mongo.js",
    "db:local:stop": "node scripts/stop-local-mongo.js",
    "security:check": "node scripts/security-check.js",
    "security:sbom": "node scripts/security-sbom.js",
    "load:smoke": "node scripts/load-smoke.js",
    "backup:drill": "node scripts/backup-drill.js",
    "launch:check": "node scripts/launch-check.js",
    "check:imports": "node scripts/check-imports.js",
    "check:release-scripts": "node scripts/check-release-scripts.js",
    "reset:local": "node scripts/reset-local.js",
    "frontend:audit": "node scripts/audit-frontend.js",
    "functionality:audit": "node scripts/audit-functionality.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "argon2": "0.45.1",
    "compression": "1.8.1",
    "connect-mongo": "6.0.0",
    "connect-redis": "10.0.0",
    "dotenv": "17.4.2",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "hpp": "0.2.3",
    "mongoose": "9.8.1",
    "multer": "2.2.0",
    "nodemailer": "9.0.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "redis": "6.1.0",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "supertest": "7.2.2"
  }
}
